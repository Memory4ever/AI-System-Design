<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68Xh.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.5" class="ltx_p">where terms sharing the same color can be combined.
Recall <a href="#A3.E30" title="In Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">30</span></a> that <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msub><mi>𝝀</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})\geq 0</annotation></semantics></math>. Substituting this into the above equation and rearranging the equation, we have</p>
<table id="A3.E43" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E43X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(43)</span></td></tr>
<tr id="A3.E43Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43Xa.m2" class="ltx_Math" alttext="\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E43Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>η</mi><msub><mrow></mrow><mi>λ</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E43Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E43Xc.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.6" class="ltx_p">Note that for any <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="\delta,\theta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>,</mo><mi>θ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta,\theta&gt;0</annotation></semantics></math>, we have</p>
<table id="A3.E44" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E44X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E44X.m2" class="ltx_Math" alttext="\displaystyle\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\displaystyle\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E44X.m3" class="ltx_Math" alttext="\displaystyle=\left\|\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)+\left(\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\right)\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>𝝀</mi><mi>t</mi></msub><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup></mrow><mo>)</mo></mrow><mo>+</mo><mrow><mo>(</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|\left(\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\right)+\left(\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\right)+\left(\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\right)\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(44)</span></td></tr>
<tr id="A3.E44Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E44Xa.m2" class="ltx_Math" alttext="\displaystyle\geq(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}+(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}+(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}\quad\text{(by \lx@cref{creftype~refnum}{lem:||a+b+c||_2^2_lower_bd})}." display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>δ</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">+</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mrow></mrow><mn>2</mn></msup><mrow><mtext>(by </mtext><mtext><a href="#A2.Thmtheorem4" title="Lemma B.4. ‣ Appendix B Useful Lemmas ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">lemma</span> <span class="ltx_text ltx_ref_tag">B.4</span></a></mtext><mtext>)</mtext></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}+(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}+(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}\quad\text{(by \lx@cref{creftype~refnum}{lem:||a+b+c||_2^2_lower_bd})}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.7" class="ltx_p">Substituting <a href="#A3.E44" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">44</span></a> into the last term of the RHS of <a href="#A3.E43" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">43</span></a> to get</p>
<table id="A3.Ex69" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex69X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69Xa.m2" class="ltx_Math" alttext="\displaystyle\color[rgb]{1,0,0}{\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}+{\color[rgb]{0,0,1}\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mrow><msub><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">η</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo><mrow><msup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">⋆</mo></msup><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">+</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">η</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">λ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℋ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">max</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></msub></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msub></mrow></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow></mrow></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{1,0,0}{\displaystyle+\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}+{\color[rgb]{0,0,1}\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">λ</mi></msub><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">⋆</mo></msup><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF" rspace="0em">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msub><msup><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup><mo lspace="0em">+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}\eta_{\lambda}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69Xc.m2" class="ltx_Math" alttext="\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{\color[rgb]{1,0,0}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">λ</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000"><mrow><mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" class="ltx_font_mathcaligraphic" mathcolor="#FF0000">ℋ</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">R</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">max</mi><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">C</mi></mfrac></mstyle><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">δ</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">∥</mo><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">𝝀</mi><msup><mrow></mrow><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">⋆</mo></msup><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000">∥</mo><msup><mrow></mrow><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]{\color[rgb]{1,0,0}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}^{\star}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex69Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex69Xd.m2" class="ltx_Math" alttext="\displaystyle\color[rgb]{0,0,1}{\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}}{\color[rgb]{0,1,1}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">η</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">λ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℋ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">max</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">δ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">θ</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mo>^</mo></mover><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msup></mrow></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">(</mo><mrow><msub><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">η</mi><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">λ</mi></msub><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mrow><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">|</mo><mi style="--ltx-fg-color:#00FFFF;" class="ltx_font_mathcaligraphic" mathcolor="#00FFFF">ℋ</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">R</mi><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">max</mi><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">C</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">δ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">θ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo><mrow><msup><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">⋆</mo></msup><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo>^</mo></mover><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{0,0,1}{\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}}{\color[rgb]{0,1,1}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p1.8" class="ltx_p">where terms of the same color can be combined.
Rearranging the above equation, we have</p>
<table id="A3.E45" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E45X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45X.m2" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="6" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(45)</span></td></tr>
<tr id="A3.E45Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E45Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E45Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\eta_{\theta}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+C_{2}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E45Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45Xd.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A3.E45Xe" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E45Xe.m2" class="ltx_Math" alttext="\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mi>𝝀</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0em">−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">Define <math id="A3.SS3.p2.m1" class="ltx_Math" alttext="\Phi_{t}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\Phi_{t}</annotation></semantics></math> as the LHS of <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a>, i.e.,</p>
<table id="A3.Ex70" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex70X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex70X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{t+1}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{t+1}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70X.m3" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex70Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex70Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex70Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{t+1}-\boldsymbol{\lambda}_{t}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.2" class="ltx_p">If the following requirements are satisfied:</p>
<ol id="A3.I1" class="ltx_enumerate">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p">Multipliers of all terms of LHS of <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> are positive:</p>
<table id="A3.Ex71" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex71X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71X.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}+\beta&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}+\beta&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71Xa.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}+\beta-C&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}+\beta-C&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71Xb.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex71Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex71Xc.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p">Multipliers of all terms of RHS of <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> are positive:</p>
<table id="A3.Ex72" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex72X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72X.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72Xa.m2" class="ltx_Math" alttext="\displaystyle C_{2}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{2}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72Xb.m2" class="ltx_Math" alttext="\displaystyle\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>θ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72Xc.m2" class="ltx_Math" alttext="\displaystyle\frac{|\mathcal{H}|R_{\max}^{2}}{C}&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{|\mathcal{H}|R_{\max}^{2}}{C}&gt;0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex72Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex72Xd.m2" class="ltx_Math" alttext="\displaystyle\eta_{\theta}-C_{1}&gt;0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\eta_{\theta}-C_{1}&gt;0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A3.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A3.I1.i3.p1" class="ltx_para">
<p id="A3.I1.i3.p1.1" class="ltx_p">Define</p>
<table id="A3.Ex73" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex73X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex73X.m2" class="ltx_Math" alttext="\displaystyle\rho:=" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\rho:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73X.m3" class="ltx_Math" alttext="\displaystyle\max\left(\frac{\eta_{\theta}}{\eta_{\theta}+\beta},\frac{C_{2}}{\eta_{\theta}+\beta-C},\frac{\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})}{\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)},\right." display="inline" intent=":literal"><semantics><mrow><mi>max</mi><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mn>2</mn></msub><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow></mfrac></mstyle><mo>,</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>θ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\max\left(\frac{\eta_{\theta}}{\eta_{\theta}+\beta},\frac{C_{2}}{\eta_{\theta}+\beta-C},\frac{\eta_{\lambda}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})}{\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)},\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex73Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex73Xa.m2" class="ltx_Math" alttext="\displaystyle\left.\frac{\frac{|\mathcal{H}|R_{\max}^{2}}{C}}{\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="4.000em">OPEN</mo><mstyle displaystyle="true"><mfrac><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.\frac{\frac{|\mathcal{H}|R_{\max}^{2}}{C}}{\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I1.i3.p1.2" class="ltx_p">then <math id="A3.I1.i3.p1.m1" class="ltx_Math" alttext="\rho&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\rho&lt;1</annotation></semantics></math>.</p>
</div></li>
</ol>
<p id="A3.SS3.p2.3" class="ltx_p">Then <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> can be written as</p>
<table id="A3.Ex74" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex74X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex74X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{t+1}\leq" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{t+1}\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74X.m3" class="ltx_Math" alttext="\displaystyle\rho\Phi_{t}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]\quad\text{(by the definition of $\rho$)}" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mi mathvariant="normal">Φ</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mrow><mtext>(by the definition of </mtext><mi>ρ</mi><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho\Phi_{t}-\left(\eta_{\theta}-C_{1}\right)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]\quad\text{(by the definition of $\rho$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex74Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex74Xa.m2" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex74Xa.m3" class="ltx_Math" alttext="\displaystyle\rho\Phi_{t}\quad\text{(by $\eta-C_{1}&gt;0$ and $\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]&gt;0$)}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mtext>(by </mtext><mrow><mrow><mi>η</mi><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>&gt;</mo><mn>0</mn></mrow><mtext> and </mtext><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><mtext>)</mtext></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\rho\Phi_{t}\quad\text{(by $\eta-C_{1}&gt;0$ and $\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]&gt;0$)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p2.4" class="ltx_p">Iteratively apply the recursion, we have <math id="A3.SS3.p2.m2" class="ltx_Math" alttext="\Phi_{t}\leq\rho^{t}\Phi_{1}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mi>t</mi></msub><mo>≤</mo><mrow><msup><mi>ρ</mi><mi>t</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\Phi_{t}\leq\rho^{t}\Phi_{1}</annotation></semantics></math>, where</p>
<table id="A3.Ex75" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex75X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex75X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75X.m3" class="ltx_Math" alttext="\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo>−</mo><mi>C</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(\eta_{\theta}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(\eta_{\theta}+\beta-C)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex75Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75Xa.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex75Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex75Xb.m2" class="ltx_Math" alttext="\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>δ</mi></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub><mo>−</mo><msub><mi>𝝀</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\left(\eta_{\lambda}-|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\right)\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A3.SS3.p3" class="ltx_para">
<p id="A3.SS3.p3.1" class="ltx_p"><a href="#S3.Thmtheorem3" title="Assumption 3.3 (Full support of the reference policy). ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.3</span></a> guarantees support of the policy does not shrink along the OPD iterates, and also ensures that the KL terms <math id="A3.SS3.p3.m1" class="ltx_Math" alttext="\mathrm{KL}({\pi(y|x)}\mid{\pi_{\mathrm{ref}}(y|x)})" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}({\pi(y|x)}\mid{\pi_{\mathrm{ref}}(y|x)})</annotation></semantics></math> and <math id="A3.SS3.p3.m2" class="ltx_Math" alttext="\mathrm{KL}({\pi(y|x)}\mid{\hat{\pi}_{t}(y|x)})" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{KL}({\pi(y|x)}\mid{\hat{\pi}_{t}(y|x)})</annotation></semantics></math> are well-defined throughout iterations.
We initialize <math id="A3.SS3.p3.m3" class="ltx_Math" alttext="\pi_{0}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\pi_{0}</annotation></semantics></math> to have the same support as <math id="A3.SS3.p3.m4" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> and set <math id="A3.SS3.p3.m5" class="ltx_Math" alttext="\hat{\pi}_{0}=\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mn>0</mn></msub><mo>=</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><annotation encoding="application/x-tex">\hat{\pi}_{0}=\pi_{\mathrm{ref}}</annotation></semantics></math>. From the closed-form solution of the KL-regularized maximization in <a href="#S3.E4" title="In 2 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eqs.</span> <span class="ltx_text ltx_ref_tag">4</span></a> and <a href="#S3.E6" title="Equation 6In Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, the policy updates have the form</p>
<table id="A3.Ex76" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex76.m1" class="ltx_Math" alttext="\pi_{t}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta_{\theta}}{\eta_{\theta}+\beta}}\pi_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta_{\theta}+\beta}}\exp\left(S_{\lambda_{t-1}}(x,y)\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>S</mi><msub><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{t}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta_{\theta}}{\eta_{\theta}+\beta}}\pi_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta_{\theta}+\beta}}\exp\left(S_{\lambda_{t-1}}(x,y)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p3.2" class="ltx_p">and similarly,</p>
<table id="A3.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex77.m1" class="ltx_Math" alttext="\hat{\pi}_{t+1}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta_{\theta}}{\eta_{\theta}+\beta}}\pi_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta_{\theta}+\beta}}\exp\left(S_{\lambda_{t}}(x,y)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mfrac><mi>β</mi><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>S</mi><msub><mi>λ</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\pi}_{t+1}(y|x)\propto\hat{\pi}_{t}(y|x)^{\frac{\eta_{\theta}}{\eta_{\theta}+\beta}}\pi_{\mathrm{ref}}(y|x)^{\frac{\beta}{\eta_{\theta}+\beta}}\exp\left(S_{\lambda_{t}}(x,y)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p3.3" class="ltx_p">Since all factors on the right-hand side are strictly positive whenever <math id="A3.SS3.p3.m6" class="ltx_Math" alttext="\pi_{\mathrm{ref}}(y|x)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}(y|x)&gt;0</annotation></semantics></math>, it follows by induction that for all <math id="A3.SS3.p3.m7" class="ltx_Math" alttext="x\in\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">x\in\mathcal{X}</annotation></semantics></math> and iteration <math id="A3.SS3.p3.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>, we have</p>
<table id="A3.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex78.m1" class="ltx_math_unparsed" alttext="\mathrm{supp}(\pi_{t}(\cdot|x))=\mathrm{supp}(\hat{\pi}_{t}(\cdot|x))=\mathrm{supp}(\pi_{\mathrm{ref}}(\cdot|x))." display="block" intent=":literal"><semantics><mrow><mi>supp</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>supp</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>supp</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{supp}(\pi_{t}(\cdot|x))=\mathrm{supp}(\hat{\pi}_{t}(\cdot|x))=\mathrm{supp}(\pi_{\mathrm{ref}}(\cdot|x)).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p3.4" class="ltx_p">Therefore, <math id="A3.SS3.p3.m9" class="ltx_Math" alttext="\Phi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Phi_{1}</annotation></semantics></math> is bounded.</p>
</div>
<div id="A3.SS3.p4" class="ltx_para">
<p id="A3.SS3.p4.1" class="ltx_p">Furthermore, we have</p>
<table id="A3.Ex79" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex79X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex79X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\leq\rho^{t}\frac{\Phi_{1}}{\rho\max\left(\eta_{\theta}+\beta,\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)}" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo rspace="0em">+</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo lspace="0em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo lspace="0.0835em">≤</mo><mi>ρ</mi><msup><mrow></mrow><mi>t</mi></msup><mstyle displaystyle="true"><mfrac><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mrow><mi>ρ</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>,</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))\right]+\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}\leq\rho^{t}\frac{\Phi_{1}}{\rho\max\left(\eta_{\theta}+\beta,\eta_{\lambda}+\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\delta)\right)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.p4.2" class="ltx_p">and this shows the desired result.</p>
</div>
<section id="A3.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Hyperparameters and Constants Selection</h5>

<div id="A3.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS3.SSS0.Px1.p1.1" class="ltx_p">Our next step is to choose hyperparameters <math id="A3.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\eta_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\eta_{\theta}</annotation></semantics></math> and <math id="A3.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\eta_{\lambda}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>λ</mi></msub><annotation encoding="application/x-tex">\eta_{\lambda}</annotation></semantics></math> as well as constants <math id="A3.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="C_{1}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>1</mn></msub><annotation encoding="application/x-tex">C_{1}</annotation></semantics></math>, <math id="A3.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>, and <math id="A3.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math> to satisfy the requirements.
For simplicity, with a little abuse of notations, we denote <math id="A3.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="h=|\mathcal{H}|" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>=</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">h=|\mathcal{H}|</annotation></semantics></math> and <math id="A3.SS3.SSS0.Px1.p1.m7" class="ltx_Math" alttext="R=R_{\max}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo>=</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><annotation encoding="application/x-tex">R=R_{\max}</annotation></semantics></math> in this parameter and constants selection section.
Let</p>
<table id="A3.Ex80" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex80.m1" class="ltx_Math" alttext="\eta_{\theta}=\eta_{\lambda}=\eta=3\sqrt{h}R,\quad C_{1}=C_{2}=C=\sqrt{h}R,\quad\frac{1}{2}&lt;\delta&lt;1,\quad\frac{1}{2}&lt;\theta&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>=</mo><msub><mi>η</mi><mi>λ</mi></msub><mo>=</mo><mi>η</mi><mo>=</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><msub><mi>C</mi><mn>2</mn></msub><mo>=</mo><mi>C</mi><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><mo rspace="1.167em">,</mo><mrow><mfrac><mn>1</mn><mn>2</mn></mfrac><mo>&lt;</mo><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\eta_{\theta}=\eta_{\lambda}=\eta=3\sqrt{h}R,\quad C_{1}=C_{2}=C=\sqrt{h}R,\quad\frac{1}{2}&lt;\delta&lt;1,\quad\frac{1}{2}&lt;\theta&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS3.SSS0.Px1.p1.2" class="ltx_p">We will verify that this set of parameters satisfies the requirements.</p>
</div>
<div id="A3.SS3.SSS0.Px1.p2" class="ltx_para">
<ol id="A3.I2" class="ltx_enumerate">
<li id="A3.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A3.I2.i1.p1" class="ltx_para">
<p id="A3.I2.i1.p1.1" class="ltx_p"><span id="A3.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Verifications that multipliers of all terms of LHS of <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> are positive</span>.
(1) Since <math id="A3.I2.i1.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> and <math id="A3.I2.i1.p1.m2" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, we have <math id="A3.I2.i1.p1.m3" class="ltx_Math" alttext="\eta_{\theta}+\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}+\beta&gt;0</annotation></semantics></math>.
(2) <math id="A3.I2.i1.p1.m4" class="ltx_Math" alttext="\eta_{\theta}+\beta-C=\beta+2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo>=</mo><mrow><mi>β</mi><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}+\beta-C=\beta+2\sqrt{h}R&gt;0</annotation></semantics></math>.
(3) Since <math id="A3.I2.i1.p1.m5" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}/C=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}/C=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0</annotation></semantics></math> and <math id="A3.I2.i1.p1.m6" class="ltx_Math" alttext="\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta&lt;1</annotation></semantics></math>, we have <math id="A3.I2.i1.p1.m7" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>. Hence <math id="A3.I2.i1.p1.m8" class="ltx_Math" alttext="\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>.
(4) <math id="A3.I2.i1.p1.m9" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}\left(1/(2C_{1})+1/(2C_{2})\right)+\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-\theta)=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)+(2\sqrt{h}R-hR^{2}/(\sqrt{h}R))(1-1/\delta)(1-\theta)=\sqrt{h}R\left(2+\left(1-1/\delta\right)\left(1-\theta\right)\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>1</mn><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}\left(1/(2C_{1})+1/(2C_{2})\right)+\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-\theta)=3\sqrt{h}R-hR^{2}/(\sqrt{h}R)+(2\sqrt{h}R-hR^{2}/(\sqrt{h}R))(1-1/\delta)(1-\theta)=\sqrt{h}R\left(2+\left(1-1/\delta\right)\left(1-\theta\right)\right)</annotation></semantics></math>.
Since <math id="A3.I2.i1.p1.m10" class="ltx_Math" alttext="1/2&lt;\delta,\theta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\delta,\theta&lt;1</annotation></semantics></math>, we have <math id="A3.I2.i1.p1.m11" class="ltx_Math" alttext="-1&lt;1-1/\delta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\delta&lt;0</annotation></semantics></math> and <math id="A3.I2.i1.p1.m12" class="ltx_Math" alttext="0&lt;1-\theta&lt;1/2" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">0&lt;1-\theta&lt;1/2</annotation></semantics></math>, hence <math id="A3.I2.i1.p1.m13" class="ltx_math_unparsed" alttext="-1/2&lt;\left(1-1/\delta\right)\left(1-\theta\right)&lt;0" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>&lt;</mo><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo>)</mo></mrow><mrow><mo>(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo>)</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1/2&lt;\left(1-1/\delta\right)\left(1-\theta\right)&lt;0</annotation></semantics></math>.
Therefore, <math id="A3.I2.i1.p1.m14" class="ltx_Math" alttext="2+\left(1-1/\delta\right)\left(1-\theta\right)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo>)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">2+\left(1-1/\delta\right)\left(1-\theta\right)&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A3.I2.i2.p1" class="ltx_para">
<p id="A3.I2.i2.p1.1" class="ltx_p"><span id="A3.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Verifications that the multipliers of all terms of the RHS of <a href="#A3.E45" title="In C.3 Combining A and B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> are positive</span>.
(1) <math id="A3.I2.i2.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> by the definition of <math id="A3.I2.i2.p1.m2" class="ltx_Math" alttext="\eta_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>η</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\eta_{\theta}</annotation></semantics></math>.
(2) <math id="A3.I2.i2.p1.m3" class="ltx_Math" alttext="C_{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{2}&gt;0</annotation></semantics></math> by the definition of <math id="A3.I2.i2.p1.m4" class="ltx_Math" alttext="C_{2}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>2</mn></msub><annotation encoding="application/x-tex">C_{2}</annotation></semantics></math>.
(3) <math id="A3.I2.i2.p1.m5" class="ltx_Math" alttext="\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)=3\sqrt{h}R-(3\sqrt{h}R-hR^{2}/(\sqrt{h}R)(1-1/\delta)(1-1/\theta)=\sqrt{h}R(3-2(1-1/\delta)(1-1/\theta))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mrow><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)=3\sqrt{h}R-(3\sqrt{h}R-hR^{2}/(\sqrt{h}R)(1-1/\delta)(1-1/\theta)=\sqrt{h}R(3-2(1-1/\delta)(1-1/\theta))</annotation></semantics></math>.
Since <math id="A3.I2.i2.p1.m6" class="ltx_Math" alttext="1/2&lt;\delta,\theta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>θ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\delta,\theta&lt;1</annotation></semantics></math>, we have <math id="A3.I2.i2.p1.m7" class="ltx_Math" alttext="-1&lt;1-1/\theta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\theta&lt;0</annotation></semantics></math> and <math id="A3.I2.i2.p1.m8" class="ltx_Math" alttext="-1&lt;1-1/\delta&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>&lt;</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1&lt;1-1/\delta&lt;0</annotation></semantics></math>, hence <math id="A3.I2.i2.p1.m9" class="ltx_Math" alttext="0&lt;(1-1/\theta)(1-1/\delta)&lt;1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>&lt;</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0&lt;(1-1/\theta)(1-1/\delta)&lt;1</annotation></semantics></math>.
Therefore, we get <math id="A3.I2.i2.p1.m10" class="ltx_Math" alttext="3-2(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>3</mn><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">3-2(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math>.
(4) As <math id="A3.I2.i2.p1.m11" class="ltx_Math" alttext="hR^{2}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">hR^{2}&gt;0</annotation></semantics></math> and <math id="A3.I2.i2.p1.m12" class="ltx_Math" alttext="C=\sqrt{hR}&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo>=</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C=\sqrt{hR}&gt;0</annotation></semantics></math>, we have <math id="A3.I2.i2.p1.m13" class="ltx_Math" alttext="hR^{2}/C&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">hR^{2}/C&gt;0</annotation></semantics></math>.
(5) <math id="A3.I2.i2.p1.m14" class="ltx_Math" alttext="\eta_{\theta}-C_{1}=3\sqrt{hR}-\sqrt{h}R=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>−</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo>−</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}-C_{1}=3\sqrt{hR}-\sqrt{h}R=2\sqrt{h}R&gt;0</annotation></semantics></math>.</p>
</div></li>
<li id="A3.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A3.I2.i3.p1" class="ltx_para">
<p id="A3.I2.i3.p1.1" class="ltx_p">(1) Since <math id="A3.I2.i3.p1.m1" class="ltx_Math" alttext="\eta_{\theta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\theta}&gt;0</annotation></semantics></math> and <math id="A3.I2.i3.p1.m2" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>, we have <math id="A3.I2.i3.p1.m3" class="ltx_Math" alttext="\frac{\eta_{\theta}}{\eta_{\theta}+\beta}&lt;1" display="inline" intent=":literal"><semantics><mrow><mfrac><msub><mi>η</mi><mi>θ</mi></msub><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\frac{\eta_{\theta}}{\eta_{\theta}+\beta}&lt;1</annotation></semantics></math>.
(2) We have <math id="A3.I2.i3.p1.m4" class="ltx_Math" alttext="C_{2}/(\eta_{\theta}+\beta-C)=\sqrt{h}R/(3\sqrt{h}R-\beta-\sqrt{hR})&lt;\sqrt{h}R/(3\sqrt{h}R-\sqrt{hR})=1/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mn>2</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow><mo>−</mo><mi>C</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><mi>β</mi><mo>−</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>−</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">C_{2}/(\eta_{\theta}+\beta-C)=\sqrt{h}R/(3\sqrt{h}R-\beta-\sqrt{hR})&lt;\sqrt{h}R/(3\sqrt{h}R-\sqrt{hR})=1/2</annotation></semantics></math>, where the inequality is because <math id="A3.I2.i3.p1.m5" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math>.
(3) Since <math id="A3.I2.i3.p1.m6" class="ltx_Math" alttext="\eta_{\lambda}-hR^{2}/C=3\sqrt{hR}-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>=</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow></msqrt></mrow><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-hR^{2}/C=3\sqrt{hR}-hR^{2}/(\sqrt{h}R)=2\sqrt{h}R&gt;0</annotation></semantics></math>, <math id="A3.I2.i3.p1.m7" class="ltx_Math" alttext="(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math>, and <math id="A3.I2.i3.p1.m8" class="ltx_Math" alttext="1-\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">1-\delta&gt;0</annotation></semantics></math>, we have <math id="A3.I2.i3.p1.m9" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&gt;0</annotation></semantics></math> and <math id="A3.I2.i3.p1.m10" class="ltx_Math" alttext="\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)&gt;0</annotation></semantics></math>, hence <math id="A3.I2.i3.p1.m11" class="ltx_Math" alttext="\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&lt;\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta)&lt;\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta)</annotation></semantics></math>, and <math id="A3.I2.i3.p1.m12" class="ltx_Math" alttext="(\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta))/(\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta))&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>θ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>+</mo><mrow><mrow><mo>(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">(\eta_{\lambda}-\left(\eta_{\lambda}-hR^{2}/C\right)(1-1/\delta)(1-1/\theta))/(\eta_{\lambda}+\left(\eta_{\lambda}-hR^{2}/C\right)(1-\delta))&lt;1</annotation></semantics></math>.
(4)Plugging the parameters values into the last requirement, we have</p>
<table id="A3.Ex81" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex81X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81X.m2" class="ltx_Math" alttext="\displaystyle\frac{{hR^{2}}/{C}}{\eta_{\lambda}-hR^{2}\left({1}/{2C_{1}}+{1}/{2C_{2}}\right)+(\eta_{\lambda}-{hR^{2}}/{C})(1-1/\delta)(1-\theta)}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow><mrow><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>+</mo><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo>−</mo><mrow><mrow><mi>h</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>R</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>C</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{{hR^{2}}/{C}}{\eta_{\lambda}-hR^{2}\left({1}/{2C_{1}}+{1}/{2C_{2}}\right)+(\eta_{\lambda}-{hR^{2}}/{C})(1-1/\delta)(1-\theta)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex81Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81Xa.m2" class="ltx_Math" alttext="\displaystyle=\frac{\sqrt{h}R}{2\sqrt{h}R+2\sqrt{h}R(1-1/\delta)(1-\theta)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>h</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\sqrt{h}R}{2\sqrt{h}R+2\sqrt{h}R(1-1/\delta)(1-\theta)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex81Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex81Xb.m2" class="ltx_Math" alttext="\displaystyle=\frac{1}{2+2(1-1/\delta)(1-\theta)}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{1}{2+2(1-1/\delta)(1-\theta)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.I2.i3.p1.2" class="ltx_p">As <math id="A3.I2.i3.p1.m13" class="ltx_Math" alttext="1/2&lt;\theta,\delta&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>&lt;</mo><mi>θ</mi></mrow><mo>,</mo><mrow><mi>δ</mi><mo>&lt;</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">1/2&lt;\theta,\delta&lt;1</annotation></semantics></math>, <math id="A3.I2.i3.p1.m14" class="ltx_math_unparsed" alttext="-1/2&lt;(1-1/\delta)(1-\theta)&lt;0" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn><mo>&lt;</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">-1/2&lt;(1-1/\delta)(1-\theta)&lt;0</annotation></semantics></math>. Therefore <math id="A3.I2.i3.p1.m15" class="ltx_Math" alttext="1&lt;2+2(1-1/\delta)(1-\theta)&lt;2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>&lt;</mo><mrow><mn>2</mn><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">1&lt;2+2(1-1/\delta)(1-\theta)&lt;2</annotation></semantics></math> and <math id="A3.I2.i3.p1.m16" class="ltx_Math" alttext="{1}/{2+2(1-1/\delta)(1-\theta)}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>θ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">{1}/{2+2(1-1/\delta)(1-\theta)}&lt;1</annotation></semantics></math>.</p>
</div></li>
</ol>
</div>
<div id="A3.SS3.SSS0.Px1.p3" class="ltx_para">
<p id="A3.SS3.SSS0.Px1.p3.2" class="ltx_p">If we further set <math id="A3.SS3.SSS0.Px1.p3.m1" class="ltx_Math" alttext="\delta=\theta=\frac{3}{4}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mi>θ</mi><mo>=</mo><mfrac><mn>3</mn><mn>4</mn></mfrac></mrow><annotation encoding="application/x-tex">\delta=\theta=\frac{3}{4}</annotation></semantics></math>, then we can write <math id="A3.SS3.SSS0.Px1.p3.m2" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> and <math id="A3.SS3.SSS0.Px1.p3.m3" class="ltx_Math" alttext="\Phi_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\Phi_{1}</annotation></semantics></math> as</p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\rho=\max\left(\frac{3\sqrt{\mathcal{H}}R_{\max}}{3\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{\sqrt{\mathcal{H}}R_{\max}}{2\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{50}{63}\right)," display="block" intent=":literal"><semantics><mrow><mrow><mi>ρ</mi><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mi>β</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub></mrow><mo>+</mo><mi>β</mi></mrow></mfrac><mo>,</mo><mfrac><mn>50</mn><mn>63</mn></mfrac><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\rho=\max\left(\frac{3\sqrt{\mathcal{H}}R_{\max}}{3\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{\sqrt{\mathcal{H}}R_{\max}}{2\sqrt{\mathcal{H}}R_{\max}+\beta},\frac{50}{63}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<table id="A3.E47" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A3.E47X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E47X.m2" class="ltx_Math" alttext="\displaystyle\Phi_{1}=" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Φ</mi><mn>1</mn></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\Phi_{1}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47X.m3" class="ltx_Math" alttext="\displaystyle(3\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(2\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>3</mn><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>+</mo><mo stretchy="false">(</mo><mn>2</mn><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mn>1</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle(3\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{1}(\cdot|x))\right]+(2\sqrt{\mathcal{H}}R_{\max}+\beta)\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{KL}(\hat{\pi}_{1}(\cdot|x)\|\pi_{0}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(47)</span></td></tr>
<tr id="A3.E47Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E47Xa.m2" class="ltx_Math" alttext="\displaystyle+\frac{7}{2}\sqrt{\mathcal{H}}R_{\max}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}+\frac{11}{6}\sqrt{\mathcal{H}}R_{\max}\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>7</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>11</mn><mn>6</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi class="ltx_font_mathcaligraphic">ℋ</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mn>1</mn></msub><mo>−</mo><msub><mi>𝝀</mi><mn>0</mn></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{7}{2}\sqrt{\mathcal{H}}R_{\max}\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{1}\|_{2}^{2}+\frac{11}{6}\sqrt{\mathcal{H}}R_{\max}\|\hat{\boldsymbol{\lambda}}_{1}-\boldsymbol{\lambda}_{0}\|_{2}^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Proof of <a href="#S3.Thmtheorem5" title="Remark 3.5 (Equivalence between Distribution-Space OPD and NPG Updates). ‣ 3.2.1 OPD Updates in the Parameterized Policy Space ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">remark</span> <span class="ltx_text ltx_ref_tag">3.5</span></a></h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">In this section, we show under the tabular softmax parameterization, the updated policy <math id="A4.p1.m1" class="ltx_Math" alttext="\pi_{\theta_{+}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>θ</mi><mo>+</mo></msub></msub><annotation encoding="application/x-tex">\pi_{\theta_{+}}</annotation></semantics></math> is equivalent to <math id="A4.p1.m2" class="ltx_Math" alttext="\pi_{+}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>+</mo></msub><annotation encoding="application/x-tex">\pi_{+}</annotation></semantics></math> with <math id="A4.p1.m3" class="ltx_Math" alttext="\theta_{+}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mo>+</mo></msub><annotation encoding="application/x-tex">\theta_{+}</annotation></semantics></math> and <math id="A4.p1.m4" class="ltx_Math" alttext="\pi_{+}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>+</mo></msub><annotation encoding="application/x-tex">\pi_{+}</annotation></semantics></math> shown as follows.</p>
<table id="A4.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E48.m1" class="ltx_Math" alttext="\theta_{+}=\theta+\frac{1}{\eta_{\theta}+\beta}F(\theta)^{\dagger}\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>θ</mi><mo>+</mo></msub><mo>=</mo><mrow><mi>θ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\theta_{+}=\theta+\frac{1}{\eta_{\theta}+\beta}F(\theta)^{\dagger}\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<table id="A4.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E49.m1" class="ltx_math_unparsed" alttext="\pi_{+}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\lambda}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\theta}(\cdot|x)\right)\right]," display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>+</mo></msub><mo>=</mo><mi>arg</mi><munder><mi>max</mi><mi>π</mi></munder><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mi>S</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>θ</mi></msub><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\pi_{+}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\lambda}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\theta}(\cdot|x)\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A4.p1.2" class="ltx_p">where <math id="A4.p1.m5" class="ltx_math_unparsed" alttext="\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}S_{\lambda}(x,y)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><msub><mi>S</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}S_{\lambda}(x,y)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]</annotation></semantics></math> and <math id="A4.p1.m6" class="ltx_Math" alttext="S_{\lambda}(x,y)=\sum_{k\in\mathcal{S}}w_{k}R_{k}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mrow><msub><mi>λ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{\lambda}(x,y)=\sum_{k\in\mathcal{S}}w_{k}R_{k}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)</annotation></semantics></math>.</p>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">If we let <math id="A4.p2.m1" class="ltx_Math" alttext="\theta=\hat{\theta}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\theta=\hat{\theta}_{t}</annotation></semantics></math> and <math id="A4.p2.m2" class="ltx_Math" alttext="\lambda=\lambda_{t-1}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\lambda=\lambda_{t-1}</annotation></semantics></math>, then the above equivalence proves that the <math id="A4.p2.m3" class="ltx_Math" alttext="\pi_{\theta_{t}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">\pi_{\theta_{t}}</annotation></semantics></math> with NPG update shown in <a href="#S3.E8" title="In 2 ‣ Algorithm 3 ‣ 3.2.1 OPD Updates in the Parameterized Policy Space ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">8</span></a> and <math id="A4.p2.m4" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> with OPG update shown in <a href="#S3.E4" title="In 2 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">4</span></a> are the same under the tabular softmax parameterized distribution. Similarly, if we let <math id="A4.p2.m5" class="ltx_Math" alttext="\theta=\hat{\theta}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\theta=\hat{\theta}_{t}</annotation></semantics></math> and <math id="A4.p2.m6" class="ltx_Math" alttext="\lambda=\lambda_{t}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><msub><mi>λ</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\lambda=\lambda_{t}</annotation></semantics></math>, then we have <math id="A4.p2.m7" class="ltx_Math" alttext="\pi_{\hat{\theta}_{t+1}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></msub><annotation encoding="application/x-tex">\pi_{\hat{\theta}_{t+1}}</annotation></semantics></math> of NPG update shown in <a href="#S3.E10" title="In 4 ‣ Algorithm 3 ‣ 3.2.1 OPD Updates in the Parameterized Policy Space ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">10</span></a> and <math id="A4.p2.m8" class="ltx_Math" alttext="\hat{\pi}_{t+1}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\hat{\pi}_{t+1}</annotation></semantics></math> of OPG update shown in <a href="#S3.E6" title="In 4 ‣ Algorithm 2 ‣ 3.1 OPD in Distribution Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">6</span></a> are the same.</p>
</div>
<div id="A4.p3" class="ltx_para">
<p id="A4.p3.1" class="ltx_p">Define</p>
<table id="A4.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E50.m1" class="ltx_Math" alttext="\displaystyle V_{\lambda}^{\pi}(x)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>V</mi><mi>λ</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle V_{\lambda}^{\pi}(x)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E50.m2" class="ltx_math_unparsed" alttext="\displaystyle:=\mathbb{E}_{y\sim\pi(\cdot|x)}\Big[S_{\lambda}(x,y)-\beta\log\frac{\pi(y|x)}{\pi_{\mathrm{ref}}(y|x)}\Big]," display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">:</mo><mo lspace="0em">=</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>S</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>β</mi><mi>log</mi><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=\mathbb{E}_{y\sim\pi(\cdot|x)}\Big[S_{\lambda}(x,y)-\beta\log\frac{\pi(y|x)}{\pi_{\mathrm{ref}}(y|x)}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
<tbody id="A4.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E51.m1" class="ltx_Math" alttext="\displaystyle A_{\lambda}^{\pi}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>λ</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle A_{\lambda}^{\pi}(x,y)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E51.m2" class="ltx_Math" alttext="\displaystyle:=S_{\lambda}(x,y)-\beta\log\frac{\pi(y|x)}{\pi_{\mathrm{ref}}(y|x)}-V_{\lambda}^{\pi}(x)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><mi>π</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow><mo>−</mo><mrow><msubsup><mi>V</mi><mi>λ</mi><mi>π</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle:=S_{\lambda}(x,y)-\beta\log\frac{\pi(y|x)}{\pi_{\mathrm{ref}}(y|x)}-V_{\lambda}^{\pi}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A4.p3.2" class="ltx_p">We can rewrite <math id="A4.p3.m1" class="ltx_Math" alttext="\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)</annotation></semantics></math> as</p>
<table id="A4.E52" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E52X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E52X.m2" class="ltx_Math" alttext="\displaystyle\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E52X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\left(S_{\lambda}(x,y)-\beta\log\tfrac{\pi_{\theta}(y|x)}{\pi_{\mathrm{ref}}(y|x)}\right)\nabla_{\theta}\log\pi_{\theta}(y|x)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>(</mo><mi>S</mi><msub><mrow></mrow><mi>λ</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>log</mi><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo rspace="0.167em">)</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\left(S_{\lambda}(x,y)-\beta\log\tfrac{\pi_{\theta}(y|x)}{\pi_{\mathrm{ref}}(y|x)}\right)\nabla_{\theta}\log\pi_{\theta}(y|x)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(52)</span></td></tr>
<tr id="A4.E52Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E52Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E52Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[A_{\lambda}^{\pi_{\theta}}(x,y)\nabla_{\theta}\log\pi_{\theta}(y|x)\right]," display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>A</mi><msub><mrow></mrow><mi>λ</mi></msub><msup><mrow></mrow><msub><mi>π</mi><mi>θ</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[A_{\lambda}^{\pi_{\theta}}(x,y)\nabla_{\theta}\log\pi_{\theta}(y|x)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.3" class="ltx_p">where the first equation is because <math id="A4.p3.m2" class="ltx_math_unparsed" alttext="\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}S_{\lambda}(x,y)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><msub><mi>S</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo stretchy="false">(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}S_{\lambda}(x,y)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]</annotation></semantics></math> and <math id="A4.p3.m3" class="ltx_Math" alttext="S_{\lambda}(x,y)=\sum_{k\in\mathcal{S}}w_{k}R_{k}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mrow><msub><mi>w</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><msub><mo>∑</mo><mrow><mi>j</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi></mrow></msub><mrow><msub><mi>λ</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{\lambda}(x,y)=\sum_{k\in\mathcal{S}}w_{k}R_{k}(x,y)+\sum_{j\in\mathcal{H}}\lambda_{j}R_{j}(x,y)</annotation></semantics></math>, and the second equation is by the definition of <math id="A4.p3.m4" class="ltx_Math" alttext="A_{\lambda}^{\pi_{\theta}}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{\lambda}^{\pi_{\theta}}(x,y)</annotation></semantics></math> and <math id="A4.p3.m5" class="ltx_math_unparsed" alttext="\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}[V_{\lambda}^{\pi_{\theta}}(x)\nabla_{\theta}\log\pi_{\theta}(y|x)]=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>V</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.167em" stretchy="false">)</mo></mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi>log</mi><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{y\sim\pi_{\theta}(\cdot|x)}[V_{\lambda}^{\pi_{\theta}}(x)\nabla_{\theta}\log\pi_{\theta}(y|x)]=0</annotation></semantics></math>.
Then the partial derivation w.r.t. <math id="A4.p3.m6" class="ltx_Math" alttext="\theta_{x,y}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{x,y}</annotation></semantics></math> is</p>
<table id="A4.Ex82" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex82X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex82X.m2" class="ltx_Math" alttext="\displaystyle\frac{\partial\mathcal{L}(\pi_{\theta},\lambda)}{\partial\theta_{x,y}}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\frac{\partial\mathcal{L}(\pi_{\theta},\lambda)}{\partial\theta_{x,y}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{x^{\prime}\sim\mathcal{D},y^{\prime}\sim\pi_{\theta}(\cdot|x^{\prime})}\left[A_{\lambda}^{\pi_{\theta}}(x^{\prime},y^{\prime})\frac{\partial}{\partial\theta_{x,y}}\log\pi_{\theta}(y^{\prime}|x^{\prime})\right]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>A</mi><msub><mrow></mrow><mi>λ</mi></msub><msup><mrow></mrow><msub><mi>π</mi><mi>θ</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><msup><mrow></mrow><mo>′</mo></msup><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mstyle displaystyle="true"><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub></mrow></mfrac></mstyle><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{x^{\prime}\sim\mathcal{D},y^{\prime}\sim\pi_{\theta}(\cdot|x^{\prime})}\left[A_{\lambda}^{\pi_{\theta}}(x^{\prime},y^{\prime})\frac{\partial}{\partial\theta_{x,y}}\log\pi_{\theta}(y^{\prime}|x^{\prime})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex82Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82Xa.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{=}\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}\left[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})\left(\mathbb{I}\{y^{\prime}=y\}-\pi_{\theta}(y|x)\right)\right]\mathcal{D}(x)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>A</mi><msub><mrow></mrow><mi>λ</mi></msub><msup><mrow></mrow><msub><mi>π</mi><mi>θ</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo>(</mo><mi>𝕀</mi><mo stretchy="false">{</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>=</mo><mi>y</mi><mo stretchy="false">}</mo><mo>−</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{=}\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}\left[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})\left(\mathbb{I}\{y^{\prime}=y\}-\pi_{\theta}(y|x)\right)\right]\mathcal{D}(x)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex82Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{D}(x)\pi_{\theta}(y|x)\left(A_{\lambda}^{\pi_{\theta}}(x,y)-\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})]\right)" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo>(</mo><mi>A</mi><msub><mrow></mrow><mi>λ</mi></msub><msup><mrow></mrow><msub><mi>π</mi><mi>θ</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo stretchy="false">[</mo><mi>A</mi><msub><mrow></mrow><mi>λ</mi></msub><msup><mrow></mrow><msub><mi>π</mi><mi>θ</mi></msub></msup><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo stretchy="false">]</mo><mo>)</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{D}(x)\pi_{\theta}(y|x)\left(A_{\lambda}^{\pi_{\theta}}(x,y)-\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})]\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex82Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82Xc.m2" class="ltx_Math" alttext="\displaystyle\overset{(b)}{=}\mathcal{D}(x)\pi_{\theta}(y|x)A_{\lambda}^{\pi_{\theta}}(x,y)," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mo>=</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><mo lspace="0em" rspace="0em">​</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{=}\mathcal{D}(x)\pi_{\theta}(y|x)A_{\lambda}^{\pi_{\theta}}(x,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.4" class="ltx_p">where <math id="A4.p3.m7" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> is because</p>
<table id="A4.Ex83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex83.m1" class="ltx_math_unparsed" alttext="\frac{\partial}{\partial\theta_{x,y}}\log\pi_{\theta}(y^{\prime}|x^{\prime})=\mathbb{I}\{x^{\prime}=x\}\left(\mathbb{I}\{y^{\prime}=y\}-\pi_{\theta}(y|x)\right)," display="block" intent=":literal"><semantics><mrow><mfrac><mo>∂</mo><mrow><mo>∂</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub></mrow></mfrac><mi>log</mi><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>x</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msup><mi>x</mi><mo>′</mo></msup><mo>=</mo><mi>x</mi><mo stretchy="false">}</mo></mrow><mrow><mo>(</mo><mi>𝕀</mi><mrow><mo stretchy="false">{</mo><msup><mi>y</mi><mo>′</mo></msup><mo>=</mo><mi>y</mi><mo stretchy="false">}</mo></mrow><mo>−</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{\partial}{\partial\theta_{x,y}}\log\pi_{\theta}(y^{\prime}|x^{\prime})=\mathbb{I}\{x^{\prime}=x\}\left(\mathbb{I}\{y^{\prime}=y\}-\pi_{\theta}(y|x)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p3.5" class="ltx_p">and <math id="A4.p3.m8" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is because <math id="A4.p3.m9" class="ltx_math_unparsed" alttext="\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})]=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}_{y^{\prime}\sim\pi_{\theta}(\cdot|x)}[A_{\lambda}^{\pi_{\theta}}(x,y^{\prime})]=0</annotation></semantics></math>.</p>
</div>
<div id="A4.p4" class="ltx_para">
<p id="A4.p4.1" class="ltx_p">Let <math id="A4.p4.m1" class="ltx_Math" alttext="\mathbf{e}_{x,y}\in\mathbb{R}^{|\mathcal{X}||\mathcal{Y}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐞</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{e}_{x,y}\in\mathbb{R}^{|\mathcal{X}||\mathcal{Y}|}</annotation></semantics></math> with only the position <math id="A4.p4.m2" class="ltx_Math" alttext="\theta_{x,y}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{x,y}</annotation></semantics></math> has element <math id="A4.p4.m3" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> and all other elements are <math id="A4.p4.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, and <math id="A4.p4.m5" class="ltx_Math" alttext="\pi_{\theta,x}\in\mathbb{R}^{|\mathcal{X}||\mathcal{Y}|}" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\pi_{\theta,x}\in\mathbb{R}^{|\mathcal{X}||\mathcal{Y}|}</annotation></semantics></math> with only the positions <math id="A4.p4.m6" class="ltx_Math" alttext="\theta_{x,y}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\theta_{x,y}</annotation></semantics></math> has value <math id="A4.p4.m7" class="ltx_Math" alttext="\pi_{\theta}(y|x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi_{\theta}(y|x)</annotation></semantics></math> and all other elements are <math id="A4.p4.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>. Then we rewrite <math id="A4.p4.m9" class="ltx_Math" alttext="F(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta)</annotation></semantics></math> as</p>
<table id="A4.Ex84" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex84X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex84X.m2" class="ltx_Math" alttext="\displaystyle F(\theta)=" display="inline" intent=":literal"><semantics><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle F(\theta)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\nabla_{\theta}\log\pi_{\theta}(y|x)\nabla_{\theta}\log\pi_{\theta}(y|x)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo rspace="0.167em" stretchy="false">)</mo><mo rspace="0.167em">∇</mo><msub><mrow></mrow><mi>θ</mi></msub><mi>log</mi><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mi>y</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\nabla_{\theta}\log\pi_{\theta}(y|x)\nabla_{\theta}\log\pi_{\theta}(y|x)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex84Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\left(\mathbf{e}_{x,y}-\pi_{\theta,x}\right)\left(\mathbf{e}_{x,y}-\pi_{\theta,x}\right)^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mo>(</mo><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo>)</mo><mo>(</mo><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\left(\mathbf{e}_{x,y}-\pi_{\theta,x}\right)\left(\mathbf{e}_{x,y}-\pi_{\theta,x}\right)^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex84Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84Xb.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\mathbf{e}_{x,y}\mathbf{e}_{x,y}^{\top}-\pi_{\theta,x}\mathbf{e}_{x,y}^{\top}-\mathbf{e}_{x,y}\pi_{\theta,x}^{\top}+\pi_{\theta,x}\pi_{\theta,x}^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mi>θ</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mo>[</mo><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>−</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>−</mo><mi>𝐞</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>+</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mi>π</mi><msub><mrow></mrow><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D},y\sim\pi_{\theta}(\cdot|x)}\left[\mathbf{e}_{x,y}\mathbf{e}_{x,y}^{\top}-\pi_{\theta,x}\mathbf{e}_{x,y}^{\top}-\mathbf{e}_{x,y}\pi_{\theta,x}^{\top}+\pi_{\theta,x}\pi_{\theta,x}^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex84Xc.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84Xc.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{diag}(\pi_{\theta,x})-\pi_{\theta,x}\pi_{\theta,x}^{\top}-\pi_{\theta,x}\pi_{\theta,x}^{\top}+\pi_{\theta,x}\pi_{\theta,x}^{\top}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup></mrow><mo>−</mo><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{diag}(\pi_{\theta,x})-\pi_{\theta,x}\pi_{\theta,x}^{\top}-\pi_{\theta,x}\pi_{\theta,x}^{\top}+\pi_{\theta,x}\pi_{\theta,x}^{\top}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex84Xd.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84Xd.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{diag}(\pi_{\theta,x})-\pi_{\theta,x}\pi_{\theta,x}^{\top}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup></mrow></mrow><mo>]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\mathrm{diag}(\pi_{\theta,x})-\pi_{\theta,x}\pi_{\theta,x}^{\top}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p4.2" class="ltx_p">where the second equality uses the partial derivative of <math id="A4.p4.m10" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> of <math id="A4.p4.m11" class="ltx_Math" alttext="\log\pi_{\theta}(y|x)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\log\pi_{\theta}(y|x)</annotation></semantics></math>.</p>
</div>
<div id="A4.p5" class="ltx_para">
<p id="A4.p5.1" class="ltx_p">We now characterize the natural-gradient direction
<math id="A4.p5.m1" class="ltx_Math" alttext="\mathbf{w}=F(\theta)^{\dagger}\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>𝐰</mi><mo>=</mo><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{w}=F(\theta)^{\dagger}\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)</annotation></semantics></math>, where
<math id="A4.p5.m2" class="ltx_Math" alttext="F(\theta)^{\dagger}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><annotation encoding="application/x-tex">F(\theta)^{\dagger}</annotation></semantics></math> is the Moore–Penrose pseudoinverse of <math id="A4.p5.m3" class="ltx_Math" alttext="F(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F(\theta)</annotation></semantics></math>. In other words, <math id="A4.p5.m4" class="ltx_Math" alttext="F(\theta)\mathbf{w}=\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>=</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F(\theta)\mathbf{w}=\nabla_{\theta}\mathcal{L}(\pi_{\theta},\lambda)</annotation></semantics></math>. Let <math id="A4.p5.m5" class="ltx_Math" alttext="\bar{w}_{x}:=\pi_{\theta,x}^{\top}\mathbf{w}=\mathbb{E}_{y\sim\pi_{x}}[\mathbf{w}_{x,y}]" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mi>x</mi></msub><mo>:=</mo><mrow><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><msub><mi>π</mi><mi>x</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝐰</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{w}_{x}:=\pi_{\theta,x}^{\top}\mathbf{w}=\mathbb{E}_{y\sim\pi_{x}}[\mathbf{w}_{x,y}]</annotation></semantics></math>. Consider the <math id="A4.p5.m6" class="ltx_Math" alttext="(x,y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,y)</annotation></semantics></math>-th coordinate of the LHS, we have</p>
<table id="A4.Ex85" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex85X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex85X.m2" class="ltx_Math" alttext="\displaystyle\left[F(\theta)\mathbf{w}\right]_{x,y}=" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>[</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>]</mo></mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\left[F(\theta)\mathbf{w}\right]_{x,y}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85X.m3" class="ltx_Math" alttext="\displaystyle\mathcal{D}(x)\left[\left(\mathrm{diag}(\pi_{\theta,x})-\pi_{x}\mathbf{\pi}_{\theta,x}^{\top}\right)\mathbf{w}\right]_{y}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><mrow><mo>(</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>π</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup></mrow></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>]</mo></mrow><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{D}(x)\left[\left(\mathrm{diag}(\pi_{\theta,x})-\pi_{x}\mathbf{\pi}_{\theta,x}^{\top}\right)\mathbf{w}\right]_{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex85Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex85Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85Xa.m3" class="ltx_Math" alttext="\displaystyle\mathcal{D}(x)\left[\mathrm{diag}(\pi_{\theta,x})\mathbf{w}\right]_{y}-\left[\pi_{\theta,x}\pi_{\theta,x}^{\top}\mathbf{w}\right]_{y}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>[</mo><mrow><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>]</mo></mrow><mi>y</mi></msub></mrow><mo>−</mo><msub><mrow><mo>[</mo><mrow><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>𝐰</mi></mrow><mo>]</mo></mrow><mi>y</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{D}(x)\left[\mathrm{diag}(\pi_{\theta,x})\mathbf{w}\right]_{y}-\left[\pi_{\theta,x}\pi_{\theta,x}^{\top}\mathbf{w}\right]_{y}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex85Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex85Xb.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85Xb.m3" class="ltx_Math" alttext="\displaystyle\mathcal{D}(x)\pi_{\theta,x}(y|x)\left(\mathbf{w}_{x,y}-\bar{w}_{x}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mrow><mi>θ</mi><mo>,</mo><mi>x</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>𝐰</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>w</mi><mo>¯</mo></mover><mi>x</mi></msub></mrow><mo>)</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{D}(x)\pi_{\theta,x}(y|x)\left(\mathbf{w}_{x,y}-\bar{w}_{x}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p5.2" class="ltx_p">Comparing with <math id="A4.p5.m7" class="ltx_Math" alttext="\frac{\partial\mathcal{L}(\pi_{\theta},\lambda)}{\partial\theta_{x,y}}=\mathcal{D}(x)\pi_{\theta}(y|x)A_{\lambda}^{\pi_{\theta}}(x,y)" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mo>∂</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub></mrow></mfrac><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{\partial\mathcal{L}(\pi_{\theta},\lambda)}{\partial\theta_{x,y}}=\mathcal{D}(x)\pi_{\theta}(y|x)A_{\lambda}^{\pi_{\theta}}(x,y)</annotation></semantics></math>, we have <math id="A4.p5.m8" class="ltx_Math" alttext="\mathbf{w}_{x,y}=A_{\lambda}^{\pi_{\theta}}(x,y)+c(x)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐰</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo>=</mo><mrow><mrow><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{w}_{x,y}=A_{\lambda}^{\pi_{\theta}}(x,y)+c(x)</annotation></semantics></math>.
Plugging <math id="A4.p5.m9" class="ltx_Math" alttext="\mathbf{w}_{x,y}" display="inline" intent=":literal"><semantics><msub><mi>𝐰</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><annotation encoding="application/x-tex">\mathbf{w}_{x,y}</annotation></semantics></math> into <a href="#A4.E48" title="In Appendix D Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">48</span></a>, <math id="A4.p5.m10" class="ltx_Math" alttext="\theta_{+}=\theta+\frac{1}{\eta_{\theta}+\beta}\left(A_{\lambda}^{\pi_{\theta}}(x,y)+c(x)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>θ</mi><mo>+</mo></msub><mo>=</mo><mrow><mi>θ</mi><mo>+</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta_{+}=\theta+\frac{1}{\eta_{\theta}+\beta}\left(A_{\lambda}^{\pi_{\theta}}(x,y)+c(x)\right)</annotation></semantics></math>. The corresponding policy can be written as</p>
<table id="A4.Ex86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex86.m1" class="ltx_Math" alttext="\pi_{\theta^{+}}(y|x)=\frac{\exp(\theta^{+}_{x,y})}{\sum_{y^{\prime}\in\mathcal{Y}}\exp(\theta^{+}_{x,y^{\prime}})}=\frac{\exp(\theta_{x,y})\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y))}{\sum_{y^{\prime}\in\mathcal{Y}}\exp(\theta_{x,y^{\prime}})\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y^{\prime}))}.=\frac{\pi_{\theta}(y|x)\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y))}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\theta}(y^{\prime}|x)\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y^{\prime}))}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>π</mi><msup><mi>θ</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo>+</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mrow><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mphantom></mphantom><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi></mrow></msub><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msup><mi>y</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\theta^{+}}(y|x)=\frac{\exp(\theta^{+}_{x,y})}{\sum_{y^{\prime}\in\mathcal{Y}}\exp(\theta^{+}_{x,y^{\prime}})}=\frac{\exp(\theta_{x,y})\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y))}{\sum_{y^{\prime}\in\mathcal{Y}}\exp(\theta_{x,y^{\prime}})\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y^{\prime}))}.=\frac{\pi_{\theta}(y|x)\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y))}{\sum_{y^{\prime}\in\mathcal{Y}}\pi_{\theta}(y^{\prime}|x)\exp(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y^{\prime}))}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p5.3" class="ltx_p">That is,</p>
<table id="A4.Ex87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex87.m1" class="ltx_Math" alttext="\pi_{\theta^{+}}(y|x)\propto\pi_{\theta}(y|x)\exp\left(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y)\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>π</mi><msup><mi>θ</mi><mo>+</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{\theta^{+}}(y|x)\propto\pi_{\theta}(y|x)\exp\left(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A4.p6" class="ltx_para">
<p id="A4.p6.1" class="ltx_p">As shown in <a href="#A4.E49" title="In Appendix D Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">49</span></a></p>
<table id="A4.Ex88" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex88.m1" class="ltx_math_unparsed" alttext="\pi_{+}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\lambda}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\theta}(\cdot|x)\right)\right]." display="block" intent=":literal"><semantics><mrow><msub><mi>π</mi><mo>+</mo></msub><mo>=</mo><mi>arg</mi><munder><mi>max</mi><mi>π</mi></munder><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msub><mi>𝔼</mi><mrow><mi>y</mi><mo>∼</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><msub><mi>S</mi><mi>λ</mi></msub><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>−</mo><msub><mi>η</mi><mi>θ</mi></msub><mi>KL</mi><mrow><mo>(</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\pi_{+}=\arg\max_{\pi}\mathbb{E}_{x\sim\mathcal{D}}\left[\mathbb{E}_{y\sim\pi(\cdot|x)}\left[S_{\lambda}(x,y)\right]-\beta\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x)\right)-\eta_{\theta}\mathrm{KL}\left(\pi(\cdot|x)\|\pi_{\theta}(\cdot|x)\right)\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p6.2" class="ltx_p">Solve the maximization problem over the simplex <math id="A4.p6.m1" class="ltx_Math" alttext="\Delta(\mathcal{Y})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(\mathcal{Y})</annotation></semantics></math> yields the
softmax solution</p>
<table id="A4.Ex89" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex89X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex89X.m2" class="ltx_Math" alttext="\displaystyle\pi^{+}(y|x)\propto" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>π</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\pi^{+}(y|x)\propto</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89X.m3" class="ltx_Math" alttext="\displaystyle\exp\left(\tfrac{1}{\eta_{\theta}+\beta}\left(S_{\lambda}(x,y)+\beta\log\pi_{\mathrm{ref}}(y|x)+\eta_{\theta}\log\pi_{\theta}(y|x)\right)\right)" display="inline" intent=":literal"><semantics><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp\left(\tfrac{1}{\eta_{\theta}+\beta}\left(S_{\lambda}(x,y)+\beta\log\pi_{\mathrm{ref}}(y|x)+\eta_{\theta}\log\pi_{\theta}(y|x)\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex89Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex89Xa.m2" class="ltx_Math" alttext="\displaystyle\propto" display="inline" intent=":literal"><semantics><mo>∝</mo><annotation encoding="application/x-tex">\displaystyle\propto</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89Xa.m3" class="ltx_Math" alttext="\displaystyle\pi_{\theta}(y|x)\exp\left(\tfrac{1}{\eta_{\theta}+\beta}\left(S_{\lambda}(x,y)-\beta\log\frac{\pi_{\theta}(y|x)}{\pi_{\mathrm{ref}}(y|x)}\right)\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mrow><msub><mi>S</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{\theta}(y|x)\exp\left(\tfrac{1}{\eta_{\theta}+\beta}\left(S_{\lambda}(x,y)-\beta\log\frac{\pi_{\theta}(y|x)}{\pi_{\mathrm{ref}}(y|x)}\right)\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex89Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex89Xb.m2" class="ltx_Math" alttext="\displaystyle\propto" display="inline" intent=":literal"><semantics><mo>∝</mo><annotation encoding="application/x-tex">\displaystyle\propto</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89Xb.m3" class="ltx_Math" alttext="\displaystyle\pi_{\theta}(y|x)\exp\left(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y)\right)," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>η</mi><mi>θ</mi></msub><mo>+</mo><mi>β</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\pi_{\theta}(y|x)\exp\left(\frac{1}{\eta_{\theta}+\beta}A_{\lambda}^{\pi_{\theta}}(x,y)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.p6.3" class="ltx_p">where the last equality is by the definition of <math id="A4.p6.m2" class="ltx_Math" alttext="A_{\lambda}^{\pi_{\theta}}(x,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>λ</mi><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A_{\lambda}^{\pi_{\theta}}(x,y)</annotation></semantics></math>.</p>
</div>
<div id="A4.p7" class="ltx_para">
<p id="A4.p7.1" class="ltx_p">Comparing <math id="A4.p7.m1" class="ltx_Math" alttext="\pi_{\theta_{+}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>θ</mi><mo>+</mo></msub></msub><annotation encoding="application/x-tex">\pi_{\theta_{+}}</annotation></semantics></math> and <math id="A4.p7.m2" class="ltx_Math" alttext="\pi_{+}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mo>+</mo></msub><annotation encoding="application/x-tex">\pi_{+}</annotation></semantics></math> concludes the proof.</p>
</div>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proof of <a href="#S3.Thmtheorem10" title="Corollary 3.10. ‣ 3.2.3 Theoretical Results ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">corollary</span> <span class="ltx_text ltx_ref_tag">3.10</span></a></h2>

<div id="A5.p1" class="ltx_para">
<p id="A5.p1.1" class="ltx_p">Let <math id="A5.p1.m1" class="ltx_Math" alttext="\Pi_{\Theta}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Π</mi><mi mathvariant="normal">Θ</mi></msub><annotation encoding="application/x-tex">\Pi_{\Theta}</annotation></semantics></math> denote the class of parameterized policies that have full support on the considered action set, i.e., there exists <math id="A5.p1.m2" class="ltx_Math" alttext="p_{\min}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>min</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">p_{\min}&gt;0</annotation></semantics></math> such that
<math id="A5.p1.m3" class="ltx_Math" alttext="\pi_{\theta}(y|x)\geq p_{\min}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo lspace="0em" rspace="0em">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>p</mi><mi>min</mi></msub></mrow><annotation encoding="application/x-tex">\pi_{\theta}(y|x)\geq p_{\min}</annotation></semantics></math> for all feasible <math id="A5.p1.m4" class="ltx_Math" alttext="(x,y)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(x,y)</annotation></semantics></math>.
Also, the parameter domain <math id="A5.p1.m5" class="ltx_Math" alttext="\Theta\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Θ</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\Theta\subset\mathbb{R}^{d}</annotation></semantics></math> is closed and convex.
The Lagrangian problem is</p>
<table id="A5.Ex90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex90.m1" class="ltx_Math" alttext="\min_{\lambda\geq 0}\max_{\theta\in\Theta}\mathcal{L}(\pi_{\theta},\lambda)," display="block" intent=":literal"><semantics><mrow><mrow><munder><mi>min</mi><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><munder><mi>max</mi><mrow><mi>θ</mi><mo>∈</mo><mi mathvariant="normal">Θ</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\lambda\geq 0}\max_{\theta\in\Theta}\mathcal{L}(\pi_{\theta},\lambda),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.p1.2" class="ltx_p">where <math id="A5.p1.m6" class="ltx_math_unparsed" alttext="\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{\theta}}_{S_{\lambda}}(x)-\beta\mathrm{KL}(\pi_{\theta}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mo>[</mo><msubsup><mi>V</mi><msub><mi>S</mi><mi>λ</mi></msub><msub><mi>π</mi><mi>θ</mi></msub></msubsup><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>β</mi><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∥</mo><msub><mi>π</mi><mi>ref</mi></msub><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(\pi_{\theta},\lambda)=\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{\theta}}_{S_{\lambda}}(x)-\beta\mathrm{KL}(\pi_{\theta}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]</annotation></semantics></math>.
Under Slater’s condition in the parameterized policy space, as shown in <a href="#S3.Thmtheorem7" title="Assumption 3.7 (Slater’s condition in the parameterized policy space). ‣ 3.2.3 Theoretical Results ‣ 3.2 OPD in Parameter Space ‣ 3 Optimistic Primal–Dual Method ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Assumption</span> <span class="ltx_text ltx_ref_tag">3.7</span></a>, strong duality holds and hence an optimal saddle point <math id="A5.p1.m7" class="ltx_Math" alttext="(\pi_{\theta^{\star}},\lambda^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><msup><mi>θ</mi><mo>⋆</mo></msup></msub><mo>,</mo><msup><mi>λ</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\pi_{\theta^{\star}},\lambda^{\star})</annotation></semantics></math> exists in the parameterized policy space.</p>
</div>
<div id="A5.p2" class="ltx_para">
<p id="A5.p2.1" class="ltx_p">Without loss of generality, we denote <math id="A5.p2.m1" class="ltx_Math" alttext="\pi_{\theta_{t}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mi>θ</mi><mi>t</mi></msub></msub><annotation encoding="application/x-tex">\pi_{\theta_{t}}</annotation></semantics></math> by <math id="A5.p2.m2" class="ltx_Math" alttext="\pi_{t}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\pi_{t}</annotation></semantics></math> and <math id="A5.p2.m3" class="ltx_Math" alttext="\pi_{\hat{\theta}_{t}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><msub><mover accent="true"><mi>θ</mi><mo>^</mo></mover><mi>t</mi></msub></msub><annotation encoding="application/x-tex">\pi_{\hat{\theta}_{t}}</annotation></semantics></math> by <math id="A5.p2.m4" class="ltx_Math" alttext="\hat{\pi}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>π</mi><mo>^</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\hat{\pi}_{t}</annotation></semantics></math>. Throughout this section, we further denote the optimal policy <math id="A5.p2.m5" class="ltx_Math" alttext="\pi{\theta^{\star}}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>θ</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\pi{\theta^{\star}}</annotation></semantics></math> by <math id="A5.p2.m6" class="ltx_Math" alttext="\pi^{\star}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\pi^{\star}</annotation></semantics></math>.</p>
</div>
<div id="A5.p3" class="ltx_para">
<p id="A5.p3.1" class="ltx_p">Since <math id="A5.p3.m1" class="ltx_Math" alttext="\pi^{\star}=\mathrm{argmax}_{\pi}L(\pi,\boldsymbol{\lambda}^{\star})" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>⋆</mo></msup><mo>=</mo><mrow><msub><mi>argmax</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi^{\star}=\mathrm{argmax}_{\pi}L(\pi,\boldsymbol{\lambda}^{\star})</annotation></semantics></math>, we have <math id="A5.p3.m2" class="ltx_Math" alttext="L(\pi^{\star},\boldsymbol{\lambda}^{\star})\geq L(\pi,\boldsymbol{\lambda}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(\pi^{\star},\boldsymbol{\lambda}^{\star})\geq L(\pi,\boldsymbol{\lambda}^{\star})</annotation></semantics></math> for any <math id="A5.p3.m3" class="ltx_Math" alttext="\pi\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\pi\in\Pi</annotation></semantics></math>. Similarly, since <math id="A5.p3.m4" class="ltx_Math" alttext="\boldsymbol{\lambda}^{\star}=\mathrm{argmin}_{\lambda}L(\pi^{\star},\lambda)" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>=</mo><mrow><msub><mi>argmin</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{\lambda}^{\star}=\mathrm{argmin}_{\lambda}L(\pi^{\star},\lambda)</annotation></semantics></math>, we have <math id="A5.p3.m5" class="ltx_Math" alttext="L(\pi^{\star},\lambda)\geq L(\pi^{\star},\boldsymbol{\lambda}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">L(\pi^{\star},\lambda)\geq L(\pi^{\star},\boldsymbol{\lambda}^{\star})</annotation></semantics></math> for any <math id="A5.p3.m6" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>. Combining these two inequalities together, for any <math id="A5.p3.m7" class="ltx_Math" alttext="\pi\in\Pi" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>∈</mo><mi mathvariant="normal">Π</mi></mrow><annotation encoding="application/x-tex">\pi\in\Pi</annotation></semantics></math> and <math id="A5.p3.m8" class="ltx_Math" alttext="\lambda\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda\geq 0</annotation></semantics></math>, we have</p>
<table id="A5.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E53.m1" class="ltx_Math" alttext="L(\pi^{\star},\lambda)-L(\pi,\boldsymbol{\lambda}^{\star})=\underbrace{L(\pi^{\star},\lambda)-L(\pi^{\star},\boldsymbol{\lambda}^{\star})}_{\geq 0}+\underbrace{L(\pi^{\star},\boldsymbol{\lambda}^{\star})-L(\pi,\boldsymbol{\lambda}^{\star})}_{\geq 0}\geq 0" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="true">⏟</mo></munder><mrow><mphantom></mphantom><mo>≥</mo><mn>0</mn></mrow></munder></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">L(\pi^{\star},\lambda)-L(\pi,\boldsymbol{\lambda}^{\star})=\underbrace{L(\pi^{\star},\lambda)-L(\pi^{\star},\boldsymbol{\lambda}^{\star})}_{\geq 0}+\underbrace{L(\pi^{\star},\boldsymbol{\lambda}^{\star})-L(\pi,\boldsymbol{\lambda}^{\star})}_{\geq 0}\geq 0</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
</div>
<div id="A5.p4" class="ltx_para">
<p id="A5.p4.2" class="ltx_p">Let <math id="A5.p4.m1" class="ltx_Math" alttext="\pi=\pi_{t}" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><msub><mi>π</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\pi=\pi_{t}</annotation></semantics></math> and <math id="A5.p4.m2" class="ltx_Math" alttext="\lambda=\boldsymbol{\lambda}_{t}" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><msub><mi>𝝀</mi><mi>t</mi></msub></mrow><annotation encoding="application/x-tex">\lambda=\boldsymbol{\lambda}_{t}</annotation></semantics></math> and substituting the definition of <math id="A5.p4.m3" class="ltx_Math" alttext="L(\pi,\lambda)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(\pi,\lambda)</annotation></semantics></math> into the LHS of the above inequality, we have</p>
<table id="A5.E54" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E54X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E54X.m2" class="ltx_Math" alttext="\displaystyle L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})=" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msub><mi>𝝀</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E54X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msup><mi>π</mi><mo>⋆</mo></msup></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><mi>π</mi></msup><msub><mrow></mrow><msub><mi>S</mi><msup><mi>𝝀</mi><mo>⋆</mo></msup></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(54)</span></td></tr>
<tr id="A5.E54Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E54Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E54Xa.m3" class="ltx_Math" alttext="\displaystyle\underbrace{\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]}_{\text{A}}" display="inline" intent=":literal"><semantics><munder><munder accentunder="true"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msup><mi>π</mi><mo>⋆</mo></msup></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>A</mtext></munder><annotation encoding="application/x-tex">\displaystyle\underbrace{\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]}_{\text{A}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A5.E54Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E54Xb.m2" class="ltx_Math" alttext="\displaystyle+\underbrace{\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right])}_{\text{B}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><munder><munder accentunder="true"><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msup><mi>𝝀</mi><mo>⋆</mo></msup></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo stretchy="false">)</mo></mrow><mo stretchy="true">⏟</mo></munder><mtext>B</mtext></munder></mrow><annotation encoding="application/x-tex">\displaystyle+\underbrace{\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right])}_{\text{B}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Upper bound of term <math id="A5.SS1.m1" class="ltx_Math" alttext="\mathrm{A}" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\mathrm{A}</annotation></semantics></math></h3>

<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.2" class="ltx_p">We can rewrite term <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="\mathrm{A}" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\mathrm{A}</annotation></semantics></math> as:</p>
<table id="A5.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
