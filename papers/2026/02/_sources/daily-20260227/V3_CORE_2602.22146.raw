<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102Xd.m2" class="ltx_Math" alttext="\displaystyle\color[rgb]{0,0,1}{\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}}{\color[rgb]{0,1,1}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">(</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">η</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">λ</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mrow><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" class="ltx_font_mathcaligraphic" mathcolor="#0000FF">ℋ</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">max</mi><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF"><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">δ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">θ</mi></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">2</mn></msup></mrow></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mrow><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">(</mo><mrow><msub><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">η</mi><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">λ</mi></msub><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mrow><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">|</mo><mi style="--ltx-fg-color:#00FFFF;" class="ltx_font_mathcaligraphic" mathcolor="#00FFFF">ℋ</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">R</mi><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">max</mi><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msubsup></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">C</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">δ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">(</mo><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">θ</mi></mfrac></mstyle></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo><mrow><msup><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">⋆</mo></msup><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">^</mo></mover><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\color[rgb]{0,0,1}{\displaystyle-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\theta)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|^{2}}{\color[rgb]{0,1,1}-\left(\eta_{\lambda}-\frac{|\mathcal{H}|R_{\max}^{2}}{C}\right)(1-\frac{1}{\delta})(1-\frac{1}{\theta})\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
