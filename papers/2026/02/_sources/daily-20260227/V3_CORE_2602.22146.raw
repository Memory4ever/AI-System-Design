<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101Xd.m2" class="ltx_Math" alttext="\displaystyle+\mathbb{E}_{x\sim\mathcal{D}}\left[{\color[rgb]{0,0,1}C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))}+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">C</mi><msub><mrow></mrow><mn style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">1</mn></msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">KL</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">π</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.167em">∥</mo><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">π</mi><mo>^</mo></mover><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo rspace="0em">+</mo><mo style="--ltx-fg-color:#00FFFF;" fence="false" mathcolor="#00FFFF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#00FFFF;" class="ltx_font_mathcaligraphic" mathcolor="#00FFFF">ℋ</mi><mo style="--ltx-fg-color:#00FFFF;" fence="false" mathcolor="#00FFFF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">R</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">max</mi></msub><msup><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">(</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">C</mi><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn></msub></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">+</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF"><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn><mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">C</mi><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msub></mrow></mfrac></mstyle><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">)</mo><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">+</mo><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn></mrow></msub><mo style="--ltx-fg-color:#00FFFF;" lspace="0em" mathcolor="#00FFFF">∥</mo><msub><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msub><msup><mrow></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{x\sim\mathcal{D}}\left[{\color[rgb]{0,0,1}C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))}+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+{\color[rgb]{0,1,1}|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}</annotation></semantics></math></td>
