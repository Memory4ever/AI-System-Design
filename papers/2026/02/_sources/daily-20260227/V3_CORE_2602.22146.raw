<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
</div>
<div id="alg3.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
                Dual Actual Update:

<table id="S3.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.E11.m1" class="ltx_math_unparsed" alttext="\hat{\lambda}_{t+1}=\left[\hat{\lambda}_{t}-\frac{1}{\eta_{\lambda}}\mathbb{E}_{x\sim\mathcal{D},\,y\sim\pi_{\theta_{t}}(\cdot|x)}\left[R(x,y)\right]\right]_{+}." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><msub><mrow><mo>[</mo><msub><mover accent="true"><mi>λ</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mfrac><mn>1</mn><msub><mi>η</mi><mi>λ</mi></msub></mfrac><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo rspace="0.337em">,</mo><mi>y</mi><mo>∼</mo><mi>π</mi><msub><mrow></mrow><msub><mi>θ</mi><mi>t</mi></msub></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>]</mo></mrow><mo>+</mo></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\lambda}_{t+1}=\left[\hat{\lambda}_{t}-\frac{1}{\eta_{\lambda}}\mathbb{E}_{x\sim\mathcal{D},\,y\sim\pi_{\theta_{t}}(\cdot|x)}\left[R(x,y)\right]\right]_{+}.</annotation></semantics></math></td>
