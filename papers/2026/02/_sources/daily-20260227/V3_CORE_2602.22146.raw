<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E42Xc.m2" class="ltx_Math" alttext="\displaystyle+\mathbb{E}_{x\sim\mathcal{D}}\left[C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo rspace="0em">+</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>R</mi><msub><mrow></mrow><mi>max</mi></msub><msup><mrow></mrow><mn>2</mn></msup><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub></mrow></mfrac></mstyle><mo>)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>𝝀</mi><msub><mrow></mrow><mi>t</mi></msub><mo>−</mo><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><msup><mrow></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\displaystyle+\mathbb{E}_{x\sim\mathcal{D}}\left[C_{1}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]+|\mathcal{H}|R_{\max}^{2}\left(\frac{1}{2C_{1}}+\frac{1}{2C_{2}}\right)\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Combining <math id="A3.SS3.m1" class="ltx_Math" alttext="\mathrm{A}" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">\mathrm{A}</annotation></semantics></math> and <math id="A3.SS3.m2" class="ltx_Math" alttext="\mathrm{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\mathrm{B}</annotation></semantics></math></h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.4" class="ltx_p">Substituting <a href="#A3.E36" title="In C.1 Upper bound of term A ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">36</span></a> and <a href="#A3.E42" title="In C.2 Upper bound of term B ‣ Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">42</span></a> into the RHS of <a href="#A3.E31" title="In Appendix C Proof of ‣ Provable Last-Iterate Convergence for Multi-Objective Safe LLM Alignment via Optimistic Primal-Dual" class="ltx_ref"><span class="ltx_text ltx_ref_tag">eq.</span> <span class="ltx_text ltx_ref_tag">31</span></a>, we get</p>
<table id="A3.Ex68" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex68X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68X.m2" class="ltx_Math" alttext="\displaystyle L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>π</mi><mo>⋆</mo></msup><mo>,</mo><msub><mi>𝝀</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>π</mi><mi>t</mi></msub><mo>,</mo><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle L(\pi^{\star},\boldsymbol{\lambda}_{t})-L(\pi_{t},\boldsymbol{\lambda}^{\star})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x)){\color[rgb]{1,0,0}-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\right." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>+</mo><mi>β</mi><mo stretchy="false">)</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">−</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">θ</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">β</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">KL</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{E}_{x\sim\mathcal{D}}\left[\eta_{\theta}\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))-(\eta_{\theta}+\beta)\mathrm{KL}(\pi^{\star}(\cdot|x)\|\hat{\pi}_{t+1}(\cdot|x)){\color[rgb]{1,0,0}-(\eta_{\theta}+\beta)\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68Xb.m2" class="ltx_Math" alttext="\displaystyle\left.{\color[rgb]{0,0,1}-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))}{\color[rgb]{1,0,0}+C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\right]" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">−</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">η</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">θ</mi></msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">KL</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">π</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.167em">∥</mo><mover accent="true"><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">π</mi><mo>^</mo></mover><msub><mrow></mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">t</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#0000FF;" fence="false" mathcolor="#0000FF" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">x</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">C</mi><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">KL</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><mo>^</mo></mover><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">+</mo><mn style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">1</mn></mrow></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0.167em">∥</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">π</mi><msub><mrow></mrow><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">t</mi></msub><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">(</mo><mo style="--ltx-fg-color:#FF0000;" lspace="0em" mathcolor="#FF0000" rspace="0em">⋅</mo><mo style="--ltx-fg-color:#FF0000;" fence="false" mathcolor="#FF0000" rspace="0.167em" stretchy="false">|</mo><mi style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">x</mi><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000" stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.{\color[rgb]{0,0,1}-\eta_{\theta}\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))}{\color[rgb]{1,0,0}+C\mathrm{KL}(\hat{\pi}_{t+1}(\cdot|x)\|\pi_{t}(\cdot|x))}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex68Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex68Xc.m2" class="ltx_Math" alttext="\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left({\color[rgb]{1,0,1}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right)+\eta_{\lambda}\left(\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}{\color[rgb]{0,1,1}-\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}{-\color[rgb]{1,0,1}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>R</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mi>C</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝝀</mi><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">t</mi></msub><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝝀</mi><mo>^</mo></mover><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">t</mi></msub></mrow><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">2</mn><mn style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">2</mn></msubsup><mo>+</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><msub><mi>𝝀</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>η</mi><mi>λ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mi>t</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>𝝀</mi><mo>⋆</mo></msup><mo>−</mo><msub><mover accent="true"><mi>𝝀</mi><mo>^</mo></mover><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi></msub><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">𝝀</mi><mo>^</mo></mover><mrow><mi style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">t</mi><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">+</mo><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">1</mn></mrow></msub></mrow><mo style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn><mn style="--ltx-fg-color:#00FFFF;" mathcolor="#00FFFF">2</mn></msubsup><mo>−</mo><msubsup><mrow><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF" stretchy="false">‖</mo><mrow><msub><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝝀</mi><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">t</mi></msub><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">−</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">𝝀</mi><mo>^</mo></mover><mi style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">t</mi></msub></mrow><mo style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF" stretchy="false">‖</mo></mrow><mn style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">2</mn><mn style="--ltx-fg-color:#FF00FF;" mathcolor="#FF00FF">2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{|\mathcal{H}|R_{\max}^{2}}{C}\left({\color[rgb]{1,0,1}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}+\|\hat{\boldsymbol{\lambda}}_{t}-\boldsymbol{\lambda}_{t-1}\|_{2}^{2}\right)+\eta_{\lambda}\left(\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}-\|\boldsymbol{\lambda}^{\star}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}{\color[rgb]{0,1,1}-\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t+1}\|_{2}^{2}}{-\color[rgb]{1,0,1}\|\boldsymbol{\lambda}_{t}-\hat{\boldsymbol{\lambda}}_{t}\|_{2}^{2}}\right)</annotation></semantics></math></td>
