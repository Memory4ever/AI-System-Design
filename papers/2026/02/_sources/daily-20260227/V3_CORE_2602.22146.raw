</table>
<p id="A3.SS1.p2.11" class="ltx_p"><math id="A3.SS1.p2.m36" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> is because</p>
