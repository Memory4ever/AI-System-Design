<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Upper bound of term <math id="A5.SS2.m1" class="ltx_Math" alttext="\mathrm{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\mathrm{B}</annotation></semantics></math></h3>

<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.4" class="ltx_p">Similarly, we rewrite the term <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="\mathrm{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">\mathrm{B}</annotation></semantics></math> as</p>
<table id="A5.E60" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A5.E60X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E60X.m2" class="ltx_Math" alttext="\displaystyle\mathrm{B}=" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathrm{B}=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E60X.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right])" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo>−</mo><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msup><mi>𝝀</mi><mo>⋆</mo></msup></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>β</mi><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right]-\mathbb{E}_{x\sim\mathcal{D}}\left[V^{\pi_{t}}_{S_{\boldsymbol{\lambda}^{\star}}}(x)-\beta\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right])</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(60)</span></td></tr>
<tr id="A5.E60Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E60Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E60Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t}}(x)-V_{S_{\boldsymbol{\lambda}^{\star}}}^{\pi_{t}}(x)\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msubsup><mi>V</mi><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mi>V</mi><msub><mi>S</mi><msup><mi>𝝀</mi><mo>⋆</mo></msup></msub><msub><mi>π</mi><mi>t</mi></msub></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[V_{S_{\boldsymbol{\lambda}_{t}}}^{\pi_{t}}(x)-V_{S_{\boldsymbol{\lambda}^{\star}}}^{\pi_{t}}(x)\right]</annotation></semantics></math></td>
