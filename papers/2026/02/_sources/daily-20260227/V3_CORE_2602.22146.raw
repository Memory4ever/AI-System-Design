<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101Xf.m2" class="ltx_Math" alttext="\displaystyle\left.-\left(\eta_{\theta}-C_{1}\right)\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mo>(</mo><mi>η</mi><msub><mrow></mrow><mi>θ</mi></msub><mo>−</mo><mi>C</mi><msub><mrow></mrow><mn>1</mn></msub><mo>)</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>+</mo><mi>C</mi><msub><mrow></mrow><mn>2</mn></msub><mi>KL</mi><mo stretchy="false">(</mo><mover accent="true"><mi>π</mi><mo>^</mo></mover><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left.-\left(\eta_{\theta}-C_{1}\right)\mathrm{KL}(\pi_{t}(\cdot|x)\|\hat{\pi}_{t}(\cdot|x))+C_{2}\mathrm{KL}(\hat{\pi}_{t}(\cdot|x)\|\pi_{t-1}(\cdot|x))\right]</annotation></semantics></math></td>
