<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.E32Xa.m2" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.E32Xa.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)\right)-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>x</mi><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo>[</mo><mo>(</mo><mi>V</mi><msup><mrow></mrow><msup><mi>π</mi><mo>⋆</mo></msup></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><msup><mrow></mrow><msub><mi>π</mi><mi>t</mi></msub></msup><msub><mrow></mrow><msub><mi>S</mi><msub><mi>𝝀</mi><mi>t</mi></msub></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>)</mo><mo>−</mo><mi>β</mi><mo>(</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msup><mrow></mrow><mo>⋆</mo></msup><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>KL</mi><mo stretchy="false">(</mo><mi>π</mi><msub><mrow></mrow><mi>t</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo lspace="0em" rspace="0.167em">∥</mo><mi>π</mi><msub><mrow></mrow><mi>ref</mi></msub><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>)</mo><mo>]</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{x\sim\mathcal{D}}\left[\left(V^{\pi^{\star}}_{S_{\boldsymbol{\lambda}_{t}}}(x)-V^{\pi_{t}}_{S_{\boldsymbol{\lambda}_{t}}}(x)\right)-\beta\left(\mathrm{KL}(\pi^{\star}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))-\mathrm{KL}(\pi_{t}(\cdot|x)\|\pi_{\mathrm{ref}}(\cdot|x))\right)\right]</annotation></semantics></math></td>
