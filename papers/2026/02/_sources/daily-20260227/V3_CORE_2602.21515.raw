<th id="S6.T2.8.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Q4B</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T2.8.2" class="ltx_tr">
<th id="S6.T2.8.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.2.1.1" class="ltx_text" style="font-size:90%;">SRPO</span></th>
