<td id="S6.T2.8.4.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.4.4.1" class="ltx_text" style="font-size:90%;">+14.49%</span></td>
