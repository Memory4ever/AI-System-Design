<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A4.F8.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A4.F8.sf1.4" class="ltx_text" style="font-size:90%;">Hanabi <math id="A4.F8.sf1.m2" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>-player.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A4.F8.sf2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2602.21515v1/drop_hanabi_4.svg" id="A4.F8.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:224/236;" width="224" height="236"></object>
