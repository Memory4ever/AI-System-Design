<td id="S6.T2.8.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.4.2.1" class="ltx_text" style="font-size:90%;">+7.14%</span></td>
