<td id="S6.T2.8.3.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.3.2.1" class="ltx_text" style="font-size:90%;">0.378</span></td>
