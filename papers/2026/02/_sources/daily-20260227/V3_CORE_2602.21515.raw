<td id="S6.T2.8.3.5" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.3.5.1" class="ltx_text" style="font-size:90%;">0.901</span></td></tr>
