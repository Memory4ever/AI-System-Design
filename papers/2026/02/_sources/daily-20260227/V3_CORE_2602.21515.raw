<th id="S6.T2.8.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S6.T2.8.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Q0.5B</span></th>
