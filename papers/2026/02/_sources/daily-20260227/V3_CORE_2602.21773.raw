<th id="Sx6.T2.1.1.2.7" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:1.7pt;padding-right:1.7pt;">FA <math id="Sx6.T2.m8" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="Sx6.T2.1.1.2.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:1.7pt;padding-right:1.7pt;"><math id="Sx6.T2.m9" class="ltx_Math" alttext="\triangle_{gap}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">△</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi></mrow></msub><annotation encoding="application/x-tex">\triangle_{gap}</annotation></semantics></math> <math id="Sx6.T2.m10" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
<th id="Sx6.T2.1.1.2.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:1.7pt;padding-right:1.7pt;">WGA <math id="Sx6.T2.m11" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th>
