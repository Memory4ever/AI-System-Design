<td id="S4.F4.fig2.1.3.2" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S4.F4.fig2.1.3.2.1" class="ltx_text" style="font-size:90%;">41.0</span></td>
<td id="S4.F4.fig2.1.3.3" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S4.F4.fig2.1.3.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">+6.2</span></td></tr>
