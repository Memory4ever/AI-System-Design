<div id="A5.p67" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.p67.pic1" class="ltx_picture" height="408.32" overflow="visible" version="1.1" viewBox="0 0 653.15 408.32" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,408.32) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#1F77B4;" fill="#1F77B4" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.94 L 0 406.38 C 0 407.45 0.87 408.32 1.94 408.32 L 651.21 408.32 C 652.28 408.32 653.15 407.45 653.15 406.38 L 653.15 1.94 C 653.15 0.87 652.28 0 651.21 0 L 1.94 0 C 0.87 0 0 0.87 0 1.94 Z"></path></g><g style="--ltx-fill-color:#F4F8FB;" fill="#F4F8FB" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 1.94 L 0.55 406.38 C 0.55 407.15 1.17 407.77 1.94 407.77 L 651.21 407.77 C 651.98 407.77 652.6 407.15 652.6 406.38 L 652.6 1.94 C 652.6 1.17 651.98 0.55 651.21 0.55 L 1.94 0.55 C 1.17 0.55 0.55 1.17 0.55 1.94 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 375.43)"><foreignObject style="--ltx-fo-width:49.72em;--ltx-fo-height:1.83em;--ltx-fo-depth:26.58em;font-size:10pt;" height="393.04" overflow="visible" transform="matrix(1 0 0 -1 0 25.25)" width="687.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A5.p67.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:49.72em;">
<span id="A5.p67.pic1.1.1" class="ltx_p"><span id="A5.p67.pic1.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">Now, let’s create a script to reproduce the issue mentioned in the PR description:
<br class="ltx_break"><span id="A5.p67.pic1.1.1.1.1" class="ltx_text ltx_font_typewriter">str_replace_editor create /testbed/reproduce_issue.py --file_text ’#!/usr/bin/env python3
<br class="ltx_break">from sympy import symbols, Eq, rf, S, Float, nsolve
<br class="ltx_break">import inspect
<br class="ltx_break"># Define the variable
<br class="ltx_break">x = symbols(’"’"’x’"’"’)
<br class="ltx_break"># Create the equation from the PR description
<br class="ltx_break">eqn = Eq(rf(18, x), 77 + S(1)/3)
<br class="ltx_break"># Print the equation
<br class="ltx_break">print("Original equation:", eqn)
<br class="ltx_break"># Lambdify the expression with mpmath module
<br class="ltx_break">f = lambda x: eval(inspect.getsource(lambda y: (rf(18, y) - (77 + S(1)/3)).evalf())[10:-2])
<br class="ltx_break">print("
<br class="ltx_break">textbackslashnLambda function source:")
<br class="ltx_break">print(inspect.getsource(f))
<br class="ltx_break"># Test with nsolve
<br class="ltx_break">x0 = nsolve(eqn, Float(’"’"’1.5’"’"’, 64), prec=64)
<br class="ltx_break">print("
<br class="ltx_break">textbackslashnSolution x0:", x0)
<br class="ltx_break">print("rf(18, x0).evalf(64):", rf(18, x0).evalf(64))
<br class="ltx_break">print("Expected: 
<br class="ltx_break">textasciitilde77.3333333333333")’</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
