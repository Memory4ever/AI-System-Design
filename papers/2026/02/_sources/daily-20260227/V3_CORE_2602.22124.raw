<span id="A5.p20.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:48.67em;">
<span id="A5.p20.pic1.1.1" class="ltx_p"><span id="A5.p20.pic1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">class MpmathPrinter(PythonCodePrinter):
<br class="ltx_break">"""
<br class="ltx_break">Lambda printer for mpmath which maintains precision for floats
<br class="ltx_break">"""
<br class="ltx_break">printmethod = "_mpmathcode"
<br class="ltx_break"><span id="A5.p20.pic1.1.1.1.1" class="ltx_text ltx_font_italic">[Additional output omitted for brevity.]</span>
</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
