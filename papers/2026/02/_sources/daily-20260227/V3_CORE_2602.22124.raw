<div id="A5.p8" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.p8.pic1" class="ltx_picture" height="110.06" overflow="visible" version="1.1" viewBox="0 0 653.15 110.06" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,110.06) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CC650B;" fill="#CC650B" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.94 L 0 108.13 C 0 109.2 0.87 110.06 1.94 110.06 L 651.21 110.06 C 652.28 110.06 653.15 109.2 653.15 108.13 L 653.15 1.94 C 653.15 0.87 652.28 0 651.21 0 L 1.94 0 C 0.87 0 0 0.87 0 1.94 Z"></path></g><g style="--ltx-fill-color:#FFFAF5;" fill="#FFFAF5" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 1.94 L 0.55 108.13 C 0.55 108.89 1.17 109.51 1.94 109.51 L 651.21 109.51 C 651.98 109.51 652.6 108.89 652.6 108.13 L 652.6 1.94 C 652.6 1.17 651.98 0.55 651.21 0.55 L 1.94 0.55 C 1.17 0.55 0.55 1.17 0.55 1.94 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 10.75)"><foreignObject style="--ltx-fo-width:48.67em;--ltx-fo-height:6.63em;--ltx-fo-depth:0.23em;font-size:10pt;" height="94.78" overflow="visible" transform="matrix(1 0 0 -1 0 91.67)" width="673.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A5.p8.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:48.67em;">
<span id="A5.p8.pic1.1.1" class="ltx_p"><span id="A5.p8.pic1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">Here’s the result of running ‘cat -n‘ on /testbed/sympy/utilities/lambdify.py:
<br class="ltx_break">350 array([[ 1., 2.],
<br class="ltx_break">351 [ 3., 4.]], dtype=float32)
<br class="ltx_break">352 
<br class="ltx_break">353 """
