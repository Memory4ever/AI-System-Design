<div id="A5.p70" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A5.p70.pic1" class="ltx_picture" height="126.74" overflow="visible" version="1.1" viewBox="0 0 653.15 126.74" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,126.74) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#CC650B;" fill="#CC650B" fill-opacity="1.0"><path style="stroke:none" d="M 0 1.94 L 0 124.8 C 0 125.87 0.87 126.74 1.94 126.74 L 651.21 126.74 C 652.28 126.74 653.15 125.87 653.15 124.8 L 653.15 1.94 C 653.15 0.87 652.28 0 651.21 0 L 1.94 0 C 0.87 0 0 0.87 0 1.94 Z"></path></g><g style="--ltx-fill-color:#FFFAF5;" fill="#FFFAF5" fill-opacity="1.0"><path style="stroke:none" d="M 0.55 1.94 L 0.55 124.8 C 0.55 125.56 1.17 126.18 1.94 126.18 L 651.21 126.18 C 651.98 126.18 652.6 125.56 652.6 124.8 L 652.6 1.94 C 652.6 1.17 651.98 0.55 651.21 0.55 L 1.94 0.55 C 1.17 0.55 0.55 1.17 0.55 1.94 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 8.43 10.75)"><foreignObject style="--ltx-fo-width:48.67em;--ltx-fo-height:7.83em;--ltx-fo-depth:0.23em;font-size:10pt;" height="111.46" overflow="visible" transform="matrix(1 0 0 -1 0 108.34)" width="673.46"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A5.p70.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:48.67em;">
<span id="A5.p70.pic1.1.1" class="ltx_p"><span id="A5.p70.pic1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">/testbed/sympy/solvers/diophantine.py:3188: SyntaxWarning: "is" with a literal. Did you mean "=="?
<br class="ltx_break">if feasible is 1: # it’s prime and k == 2
<br class="ltx_break">Original equation: Eq(RisingFactorial(18, x), 232/3)
<br class="ltx_break">Lambda function source:
<br class="ltx_break">f = lambda x: eval(inspect.getsource(lambda y: (rf(18, y) - (77 + S(1)/3)).evalf())[10:-2])
