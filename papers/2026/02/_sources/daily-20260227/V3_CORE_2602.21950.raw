<tr id="S4.T2.2.1.20" class="ltx_tr">
<td id="S4.T2.2.1.20.1" class="ltx_td ltx_align_left ltx_border_r" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.2.1.20.1.1" class="ltx_text ltx_font_smallcaps">DeepSeek-VL2 (3B)</span></td>
