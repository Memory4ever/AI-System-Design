<tr id="S4.T6.2.1.3" class="ltx_tr">
<td id="S4.T6.2.1.3.1" class="ltx_td ltx_align_left" style="padding:0.75pt 4.5pt;"><span id="S4.T6.2.1.3.1.1" class="ltx_text ltx_font_smallcaps">Lingshu</span></td>
<td id="S4.T6.2.1.3.2" class="ltx_td ltx_align_center" style="padding:0.75pt 4.5pt;">36.93</td>
<td id="S4.T6.2.1.3.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#ECFFEC;padding:0.75pt 4.5pt;"><span id="S4.T6.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#ECFFEC;">38.44 (+1.51 pp)</span></td></tr>
