<td id="S4.T4.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#A6FFA6;padding:0.75pt 4.5pt;"><span id="S4.T4.2.1.3.3.1" class="ltx_text" style="--ltx-bg-color:#A6FFA6;">43.97 (+7.04 pp)</span></td>
