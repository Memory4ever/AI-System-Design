</div>
<div id="lstnumberx15" class="ltx_listingline">
</div>
<div id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Output</span><span id="lstnumberx16.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx16.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">format</span>
</div>
<div id="lstnumberx17" class="ltx_listingline"><span id="lstnumberx17.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Return</span><span id="lstnumberx17.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">only</span><span id="lstnumberx17.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">valid</span><span id="lstnumberx17.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">JSON</span><span id="lstnumberx17.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.9" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx17.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx17.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">prose</span><span id="lstnumberx17.13" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx17.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">no</span><span id="lstnumberx17.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">markdown</span><span id="lstnumberx17.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">code</span><span id="lstnumberx17.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx17.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">blocks</span><span id="lstnumberx17.22" class="ltx_text ltx_font_typewriter">).</span>
</div>
<div id="lstnumberx18" class="ltx_listingline">
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Required</span><span id="lstnumberx19.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx19.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">keys</span>
</div>
<div id="lstnumberx20" class="ltx_listingline"><span id="lstnumberx20.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx20.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.3" class="ltx_text ltx_font_typewriter">"</span><span id="lstnumberx20.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Case</span><span id="lstnumberx20.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ID</span><span id="lstnumberx20.7" class="ltx_text ltx_font_typewriter">":</span><span id="lstnumberx20.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx20.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">string</span>
