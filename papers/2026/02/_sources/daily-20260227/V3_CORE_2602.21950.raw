<td id="A2.T12.2.1.8.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:1pt 8.0pt;">0.98</td>
<td id="A2.T12.2.1.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:1pt 8.0pt;">0.95</td>
<td id="A2.T12.2.1.8.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:1pt 8.0pt;">0.93</td></tr>
