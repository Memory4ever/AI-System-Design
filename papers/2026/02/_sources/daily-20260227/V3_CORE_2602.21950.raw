<td id="S4.T2.2.1.19.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#EDEDED;padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.2.1.19.6.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">25.93</span></td>
<td id="S4.T2.2.1.19.7" class="ltx_td ltx_align_center ltx_border_r" style="padding-left:8.0pt;padding-right:8.0pt;">14</td>
