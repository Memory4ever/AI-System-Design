<td id="S4.T4.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 4.5pt;">38.69</td>
<td id="S4.T4.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 4.5pt;">36.93</td>
<td id="S4.T4.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.75pt 4.5pt;">33.92</td></tr>
<tr id="S4.T4.2.1.3" class="ltx_tr">
<td id="S4.T4.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.75pt 4.5pt;"><span id="S4.T4.2.1.3.1.1" class="ltx_text ltx_font_smallcaps">Remove-Text</span></td>
