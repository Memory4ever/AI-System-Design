<td id="S2.T1.3.1.2.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Overall</span></td>
