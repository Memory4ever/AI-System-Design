<td id="S3.T2.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.2.1" class="ltx_text" style="font-size:90%;">Base</span></td>
<td id="S3.T2.3.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.3.1" class="ltx_text" style="font-size:90%;">Woodpecker</span></td>
<td id="S3.T2.3.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.4.1" class="ltx_text" style="font-size:90%;">ViperGPT</span></td>
