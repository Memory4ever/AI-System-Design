<span id="S2.T1.3.1.2.6.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">ObjRet.</span></span>
</span></span><span id="S2.T1.3.1.2.6.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.7.1" class="ltx_text"></span><span id="S2.T1.3.1.2.7.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.7.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.7.3.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.3.1.2.7.3.1.1" class="ltx_tr">
<span id="S2.T1.3.1.2.7.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">OCR</span></span>
</span></span><span id="S2.T1.3.1.2.7.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.8.1" class="ltx_text"></span><span id="S2.T1.3.1.2.8.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.8.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.8.3.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.3.1.2.8.3.1.1" class="ltx_tr">
<span id="S2.T1.3.1.2.8.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Persp.</span></span>
</span></span><span id="S2.T1.3.1.2.8.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.9.1" class="ltx_text"></span><span id="S2.T1.3.1.2.9.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.9.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.9.3.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.3.1.2.9.3.1.1" class="ltx_tr">
<span id="S2.T1.3.1.2.9.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Order.</span></span>
</span></span><span id="S2.T1.3.1.2.9.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.10.1" class="ltx_text"></span><span id="S2.T1.3.1.2.10.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.10.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.10.3.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.3.1.2.10.3.1.1" class="ltx_tr">
