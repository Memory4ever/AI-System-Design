</span></span><span id="S2.T1.3.1.2.5.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.6.1" class="ltx_text"></span><span id="S2.T1.3.1.2.6.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.6.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.6.3.1" class="ltx_tabular ltx_align_middle">
