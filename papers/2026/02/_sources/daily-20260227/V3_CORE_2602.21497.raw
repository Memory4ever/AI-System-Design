</span></span><span id="S2.T1.3.1.2.3.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.4.1" class="ltx_text"></span><span id="S2.T1.3.1.2.4.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.4.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.4.3.1" class="ltx_tabular ltx_align_middle">
<span id="S2.T1.3.1.2.4.3.1.1" class="ltx_tr">
<span id="S2.T1.3.1.2.4.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Mater.</span></span>
</span></span><span id="S2.T1.3.1.2.4.4" class="ltx_text"></span></td>
<td id="S2.T1.3.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S2.T1.3.1.2.5.1" class="ltx_text"></span><span id="S2.T1.3.1.2.5.2" class="ltx_text" style="font-size:90%;"> </span><span id="S2.T1.3.1.2.5.3" class="ltx_text" style="font-size:90%;">
<span id="S2.T1.3.1.2.5.3.1" class="ltx_tabular ltx_align_middle">
