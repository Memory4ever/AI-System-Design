<td id="S2.T1.3.1.1.2" class="ltx_td ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;"></td>
<td id="S2.T1.3.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="5"><span id="S2.T1.3.1.1.3.1" class="ltx_text" style="font-size:90%;">Perception</span></td>
<td id="S2.T1.3.1.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="5"><span id="S2.T1.3.1.1.4.1" class="ltx_text" style="font-size:90%;">Reasoning</span></td></tr>
<tr id="S2.T1.3.1.2" class="ltx_tr">
