<td id="S3.T2.3.1.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.7.1" class="ltx_text" style="font-size:90%;">Self-cons.</span></td>
<td id="S3.T2.3.1.1.8" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.8.1" class="ltx_text" style="font-size:90%;">Diverse</span></td>
<td id="S3.T2.3.1.1.9" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.1.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ECRD</span></td></tr>
<tr id="S3.T2.3.1.2" class="ltx_tr">
<td id="S3.T2.3.1.2.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Overall</span></td>
<td id="S3.T2.3.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.2.2.1" class="ltx_text" style="font-size:90%;">37.0</span></td>
<td id="S3.T2.3.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.2.3.1" class="ltx_text" style="font-size:90%;">36.3</span></td>
<td id="S3.T2.3.1.2.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.2.4.1" class="ltx_text" style="font-size:90%;">38.3</span></td>
<td id="S3.T2.3.1.2.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:3.2pt;padding-right:3.2pt;"><span id="S3.T2.3.1.2.5.1" class="ltx_text" style="font-size:90%;">40.5</span></td>
