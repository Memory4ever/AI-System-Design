                      <span id="algx2.l20.2" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="algx2.l20.m1" class="ltx_Math" alttext="\bm{S}_{h}\coloneqq\frac{1}{\sqrt{d}}\,\overline{\bm{Q}}_{h}\,\overline{\bm{K}}_{h}^{\top}\in\mathbb{R}^{PN\times PN}" display="inline" intent=":literal"><semantics><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≔</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msqrt></mfrac><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑲</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊤</mo></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{S}_{h}\coloneqq\frac{1}{\sqrt{d}}\,\overline{\bm{Q}}_{h}\,\overline{\bm{K}}_{h}^{\top}\in\mathbb{R}^{PN\times PN}</annotation></semantics></math><span id="algx2.l20.3" class="ltx_text" style="--ltx-fg-color:#000000;">
