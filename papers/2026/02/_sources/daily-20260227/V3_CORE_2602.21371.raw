                      <span id="algx2.l21.2" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><math id="algx2.l21.m1" class="ltx_Math" alttext="\overline{\bm{P}}_{h}\coloneqq\mathrm{softmax}(\bm{S}_{h})\,\overline{\bm{V}}_{h}\in\mathbb{R}^{PN\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑷</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≔</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">softmax</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑺</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\overline{\bm{P}}_{h}\coloneqq\mathrm{softmax}(\bm{S}_{h})\,\overline{\bm{V}}_{h}\in\mathbb{R}^{PN\times d}</annotation></semantics></math><span id="algx2.l21.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
