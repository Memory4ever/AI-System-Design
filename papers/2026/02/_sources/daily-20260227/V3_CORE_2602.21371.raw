<td id="S5.T2.9.1.5.9" class="ltx_td ltx_align_center" style="--ltx-bg-color:#CCFFCC;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.5.9.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#CCFFCC;">+<span id="S5.T2.9.1.5.9.1.1" class="ltx_text ltx_font_medium">0.4</span></span></td>
<td id="S5.T2.9.1.5.10" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.5.10.1" class="ltx_text" style="font-size:80%;">16.0%</span></td>
<td id="S5.T2.9.1.5.11" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFB8B8;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.5.11.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFB8B8;">–<span id="S5.T2.9.1.5.11.1.1" class="ltx_text ltx_font_medium">1.2</span></span></td>
<td id="S5.T2.9.1.5.12" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.5.12.1" class="ltx_text" style="font-size:80%;">4.0</span></td></tr>
<tr id="S5.T2.9.1.6" class="ltx_tr">
<th id="S5.T2.9.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Diff Transformer</span></th>
<td id="S5.T2.9.1.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.2.1" class="ltx_text" style="font-size:80%;">5.46%</span></td>
<td id="S5.T2.9.1.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFD1D1;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFD1D1;">–<span id="S5.T2.9.1.6.3.1.1" class="ltx_text ltx_font_medium">0.15</span></span></td>
<td id="S5.T2.9.1.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.4.1" class="ltx_text" style="font-size:80%;">5.61%</span></td>
<td id="S5.T2.9.1.6.5" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#F2F2F2;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.5.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F2F2F2;">–</span></td>
<td id="S5.T2.9.1.6.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.6.1" class="ltx_text" style="font-size:80%;">–</span></td>
<td id="S5.T2.9.1.6.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.7.1" class="ltx_text" style="font-size:80%;">–</span></td>
<td id="S5.T2.9.1.6.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.8.1" class="ltx_text ltx_font_bold" style="font-size:80%;">25.0%</span></td>
<td id="S5.T2.9.1.6.9" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#ADFFAD;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.9.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#ADFFAD;">+<span id="S5.T2.9.1.6.9.1.1" class="ltx_text ltx_font_medium">1.6</span></span></td>
<td id="S5.T2.9.1.6.10" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.10.1" class="ltx_text" style="font-size:80%;">15.4%</span></td>
<td id="S5.T2.9.1.6.11" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFA6A6;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.11.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFA6A6;">–<span id="S5.T2.9.1.6.11.1.1" class="ltx_text ltx_font_medium">1.8</span></span></td>
<td id="S5.T2.9.1.6.12" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T2.9.1.6.12.1" class="ltx_text" style="font-size:80%;">3.5</span></td></tr>
