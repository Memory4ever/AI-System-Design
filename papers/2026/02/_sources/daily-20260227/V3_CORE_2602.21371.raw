<th id="S5.T1.7.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#F0F0FF;">IHA (Ours)</span></th>
<th id="S5.T1.7.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#F0F0FF;">34.3%</span></th>
<th id="S5.T1.7.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#59FF59;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#59FF59;">+<span id="S5.T1.7.1.2.3.1.1" class="ltx_text ltx_font_medium">4.8</span></span></th>
<th id="S5.T1.7.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#F0F0FF;">54.2%</span></th>
<th id="S5.T1.7.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#4DFF4D;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#4DFF4D;">+<span id="S5.T1.7.1.2.5.1.1" class="ltx_text ltx_font_medium">5.8</span></span></th>
<th id="S5.T1.7.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#F0F0FF;">10.0%</span></th>
<th id="S5.T1.7.1.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#B3FFB3;padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T1.7.1.2.7.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#B3FFB3;">+<span id="S5.T1.7.1.2.7.1.1" class="ltx_text ltx_font_medium">1.2</span></span></th>
