                      <math id="algx1.l11.m1" class="ltx_Math" alttext="\overline{\bm{Q}},\overline{\bm{K}},\overline{\bm{V}}\leftarrow\texttt{merge\_pseudo}(\widetilde{\bm{Q}},\widetilde{\bm{K}},\widetilde{\bm{V}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo stretchy="true">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑲</mi><mo stretchy="true">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">merge_pseudo</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑲</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\overline{\bm{Q}},\overline{\bm{K}},\overline{\bm{V}}\leftarrow\texttt{merge\_pseudo}(\widetilde{\bm{Q}},\widetilde{\bm{K}},\widetilde{\bm{V}})</annotation></semantics></math><span id="algx1.l11.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algx1.l11.4" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="algx1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="algx1.l11.m3" class="ltx_Math" alttext="\to[H,NP,d]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">[</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\to[H,NP,d]</annotation></semantics></math>
</span>
</span>
<span id="algx1.l12" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                        
                        
                      <span id="algx1.l12.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">// Step 4: Standard scaled dot-product attention per head</span><span id="algx1.l12.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx1.l13" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                        
                        
                      <math id="algx1.l13.m1" class="ltx_Math" alttext="\overline{\bm{O}}_{h}\leftarrow\mathrm{softmax}\left(\frac{1}{\sqrt{d}}\overline{\bm{Q}}_{h}\overline{\bm{K}}_{h}^{\top}\right)\overline{\bm{V}}_{h},\quad\forall h" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">softmax</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">(</mo><mrow><mfrac style="--ltx-fg-color:#000000;" mathcolor="#000000"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn><msqrt style="--ltx-fg-color:#000000;" mathcolor="#000000"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑲</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊤</mo></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></msub></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="1.167em">,</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.167em">∀</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi></mrow></mrow><annotation encoding="application/x-tex">\overline{\bm{O}}_{h}\leftarrow\mathrm{softmax}\left(\frac{1}{\sqrt{d}}\overline{\bm{Q}}_{h}\overline{\bm{K}}_{h}^{\top}\right)\overline{\bm{V}}_{h},\quad\forall h</annotation></semantics></math><span id="algx1.l13.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span><span id="algx1.l13.4" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="algx1.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="algx1.l13.m3" class="ltx_Math" alttext="\overline{\bm{O}}\in\mathbb{R}^{H\times NP\times d}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi></mrow><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\overline{\bm{O}}\in\mathbb{R}^{H\times NP\times d}</annotation></semantics></math>
</span>
</span>
<span id="algx1.l14" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
                        
                        
                      <span id="algx1.l14.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">// Step 5: Unmerge and collapse pseudo-heads</span><span id="algx1.l14.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx1.l15" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
                        
                        
                      <math id="algx1.l15.m1" class="ltx_Math" alttext="\bm{P}\leftarrow\texttt{reshape}(\overline{\bm{O}},\texttt{[H,N,P,d]})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑷</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">reshape</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="true">¯</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">[H,N,P,d]</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{P}\leftarrow\texttt{reshape}(\overline{\bm{O}},\texttt{[H,N,P,d]})</annotation></semantics></math><span id="algx1.l15.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algx1.l15.4" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="algx1.l15.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Reshape to <math id="algx1.l15.m3" class="ltx_Math" alttext="(H,N,P,d)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,N,P,d)</annotation></semantics></math>
</span>
</span>
<span id="algx1.l16" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
                        
                        
                      <math id="algx1.l16.m1" class="ltx_math_unparsed" alttext="\bm{O}\leftarrow\texttt{einsum}(\texttt{`hp,hnpd}\to\texttt{hnd'},\bm{R},\bm{P})" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">einsum</mtext><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">‘hp,hnpd</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">→</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">hnd’</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑹</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑷</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\bm{O}\leftarrow\texttt{einsum}(\texttt{`hp,hnpd}\to\texttt{hnd'},\bm{R},\bm{P})</annotation></semantics></math><span id="algx1.l16.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algx1.l16.4" class="ltx_text" style="--ltx-fg-color:#000000;float:right;"><math id="algx1.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Collapse: <math id="algx1.l16.m3" class="ltx_Math" alttext="(H,N,d)" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(H,N,d)</annotation></semantics></math>
</span>
</span>
<span id="algx1.l17" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
                        
                        
                      <span id="algx1.l17.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">// Step 6: Concatenate heads and project output</span><span id="algx1.l17.4" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx1.l18" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
                        
                        
                      <math id="algx1.l18.m1" class="ltx_Math" alttext="\widetilde{\bm{X}}\leftarrow\texttt{reshape}(\bm{O},\texttt{[N,D]})\cdot\bm{W}_{O}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">←</mo><mrow><mrow><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">reshape</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mtext style="--ltx-fg-color:#000000;" class="ltx_mathvariant_monospace" mathcolor="#000000">[N,D]</mtext><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.222em">⋅</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">O</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\bm{X}}\leftarrow\texttt{reshape}(\bm{O},\texttt{[N,D]})\cdot\bm{W}_{O}</annotation></semantics></math><span id="algx1.l18.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx1.l19" class="ltx_listingline">
                        <span class="ltx_tag ltx_tag_listingline"><span id="algx1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
                        
                        
                      <span id="algx1.l19.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">return</span><span id="algx1.l19.4" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="algx1.l19.m1" class="ltx_Math" alttext="\widetilde{\bm{X}}" display="inline" intent=":literal"><semantics><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{\bm{X}}</annotation></semantics></math><span id="algx1.l19.5" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S4.p3" class="ltx_para">
<p id="S4.p3.1" class="ltx_p">In <a href="#S4" title="4 Interleaved-Head Attention (IHA) ‣ Interleaved Head Attention" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Sec. 4</span></a>, Step 2 constructs, for each head <math id="S4.p3.m1" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> and token index <math id="S4.p3.m2" class="ltx_Math" alttext="n\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">n\in[N]</annotation></semantics></math>, <math id="S4.p3.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> pseudo-head tokens by taking learned linear combinations of the <math id="S4.p3.m4" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> original heads’ query, key and value projections. Step 3 interleaves them by replacing each original token with <math id="S4.p3.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> consecutive virtual tokens, so the sequence becomes <math id="S4.p3.m6" class="ltx_Math" alttext="(1,1),(1,2),\ldots,(1,P),(2,1),\ldots,(N,P)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo>,</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">(1,1),(1,2),\ldots,(1,P),(2,1),\ldots,(N,P)</annotation></semantics></math> where <math id="S4.p3.m7" class="ltx_Math" alttext="(n,p)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,p)</annotation></semantics></math> denotes the <math id="S4.p3.m8" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-th pseudo-head token at position <math id="S4.p3.m9" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>. Step 4 then runs standard scaled dot-product attention once on this length-<math id="S4.p3.m10" class="ltx_Math" alttext="NP" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">NP</annotation></semantics></math> sequence. This lets different pseudo-head tokens attend differently (including to different pseudo-head tokens at the same original position), yielding up to <math id="S4.p3.m11" class="ltx_Math" alttext="P^{2}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mn>2</mn></msup><annotation encoding="application/x-tex">P^{2}</annotation></semantics></math> attention patterns per head (and <math id="S4.p3.m12" class="ltx_Math" alttext="HP^{2}" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>P</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">HP^{2}</annotation></semantics></math> overall) without custom kernels. Interleaving is useful with RoPE because RoPE depends on the position index: giving each <math id="S4.p3.m13" class="ltx_Math" alttext="(n,p)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>n</mi><mo>,</mo><mi>p</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n,p)</annotation></semantics></math> its own virtual position assigns each pseudo-head token a distinct RoPE phase, and variable-length inference is handled by generating RoPE for length <math id="S4.p3.m14" class="ltx_Math" alttext="NP" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">NP</annotation></semantics></math>. The procedure is also compatible with FlashAttention <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Dao et al., 2022</a>)</cite>, since Step 4 is standard attention. For the theoretical analysis, <a href="#S4" title="4 Interleaved-Head Attention (IHA) ‣ Interleaved Head Attention" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Sec. 4</span></a> gives an equivalent, more algebraic formulation of IHA that omits interleaving and the output projection. Since our proofs do not use positional encodings (e.g., RoPE), interleaving is unnecessary, and dropping the projection cleanly isolates the core pseudo-head mixing and attention computation.</p>
</div>
<div id="S4.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.p4.pic1" class="ltx_picture" height="798.57" overflow="visible" version="1.1" viewBox="0 0 653.15 798.57" width="653.15"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,798.57) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FFE8ED;" fill="#FFE8ED" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 792.67 C 0 795.93 2.64 798.57 5.91 798.57 L 647.24 798.57 C 650.51 798.57 653.15 795.93 653.15 792.67 L 653.15 5.91 C 653.15 2.64 650.51 0 647.24 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFE8ED;" fill="#FFE8ED" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 792.67 C 1.97 794.84 3.73 796.61 5.91 796.61 L 647.24 796.61 C 649.42 796.61 651.18 794.84 651.18 792.67 L 651.18 5.91 C 651.18 3.73 649.42 1.97 647.24 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:44.07em;--ltx-fo-height:55.47em;--ltx-fo-depth:0.25em;font-size:10pt;" height="771.02" overflow="visible" transform="matrix(1 0 0 -1 0 767.57)" width="609.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.p4.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:44.07em;">
<span id="S4.p4.pic1.1.1" class="ltx_p"><span id="S4.p4.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Definition 3.<span id="S4.p4.pic1.1.1.1.1" class="ltx_text ltx_font_medium"> </span>Interleaved Head Attention</span></span>
<span id="S4.p4.pic1.1.2" class="ltx_listing ltx_listing">
<span id="algx2.l1" class="ltx_listingline">
                        
                        
                      <math id="algx2.l1.m1" class="ltx_Math" alttext="\bm{X}\in\mathbb{R}^{N\times D}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{X}\in\mathbb{R}^{N\times D}</annotation></semantics></math><span id="algx2.l1.2" class="ltx_text" style="--ltx-fg-color:#000000;">, heads </span><math id="algx2.l1.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="algx2.l1.3" class="ltx_text" style="--ltx-fg-color:#000000;">, pseudos </span><math id="algx2.l1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math><span id="algx2.l1.4" class="ltx_text" style="--ltx-fg-color:#000000;">, per-head dim </span><math id="algx2.l1.m4" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math><span id="algx2.l1.5" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l2" class="ltx_listingline">
                        
                        
                      <math id="algx2.l2.m1" class="ltx_Math" alttext="\bm{W}_{Q}^{(m)},\bm{W}_{K}^{(m)},\bm{W}_{V}^{(m)}\in\mathbb{R}^{D\times d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{W}_{Q}^{(m)},\bm{W}_{K}^{(m)},\bm{W}_{V}^{(m)}\in\mathbb{R}^{D\times d}</annotation></semantics></math><span id="algx2.l2.2" class="ltx_text" style="--ltx-fg-color:#000000;"> for </span><math id="algx2.l2.m2" class="ltx_Math" alttext="m=1,\ldots,H" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">…</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></mrow><annotation encoding="application/x-tex">m=1,\ldots,H</annotation></semantics></math><span id="algx2.l2.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l3" class="ltx_listingline">
                        
                        
                      <math id="algx2.l3.m1" class="ltx_Math" alttext="\alpha^{Q},\alpha^{K},\alpha^{V}\in\mathbb{R}^{H\times H\times P}" display="inline" intent=":literal"><semantics><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></msup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\alpha^{Q},\alpha^{K},\alpha^{V}\in\mathbb{R}^{H\times H\times P}</annotation></semantics></math><span id="algx2.l3.2" class="ltx_text" style="--ltx-fg-color:#000000;"> and </span><math id="algx2.l3.m2" class="ltx_Math" alttext="\bm{R}\in\mathbb{R}^{H\times HP}" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑹</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\bm{R}\in\mathbb{R}^{H\times HP}</annotation></semantics></math><span id="algx2.l3.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l4" class="ltx_listingline">
                        
                        
                      <span id="algx2.l4.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Pseudo-head mixing across heads</span><span id="algx2.l4.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l5" class="ltx_listingline">
                        
                        
                      <span id="algx2.l5.2" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">for</span><span id="algx2.l5.3" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="algx2.l5.m1" class="ltx_Math" alttext="h=1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">h=1</annotation></semantics></math><span id="algx2.l5.4" class="ltx_text" style="--ltx-fg-color:#000000;"> to </span><math id="algx2.l5.m2" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math><span id="algx2.l5.5" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algx2.l5.6" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span><span id="algx2.l5.7" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l6" class="ltx_listingline">
                        
                        
                      <span id="algx2.l6.2" class="ltx_text" style="--ltx-fg-color:#000000;">  </span><span id="algx2.l6.3" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">for</span><span id="algx2.l6.4" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><math id="algx2.l6.m1" class="ltx_Math" alttext="j=1" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><annotation encoding="application/x-tex">j=1</annotation></semantics></math><span id="algx2.l6.5" class="ltx_text" style="--ltx-fg-color:#000000;"> to </span><math id="algx2.l6.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math><span id="algx2.l6.6" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="algx2.l6.7" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">do</span><span id="algx2.l6.8" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l7" class="ltx_listingline">
                        
                        
                      <span id="algx2.l7.2" class="ltx_text" style="--ltx-fg-color:#000000;">   </span><math id="algx2.l7.m1" class="ltx_Math" alttext="\widetilde{\bm{Q}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{Q}_{m,h,j}\,\bm{X}\bm{W}_{Q}^{(m)}\in\mathbb{R}^{N\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑸</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≔</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msubsup><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">Q</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{\bm{Q}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{Q}_{m,h,j}\,\bm{X}\bm{W}_{Q}^{(m)}\in\mathbb{R}^{N\times d}</annotation></semantics></math><span id="algx2.l7.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l8" class="ltx_listingline">
                        
                        
                      <span id="algx2.l8.2" class="ltx_text" style="--ltx-fg-color:#000000;">   </span><math id="algx2.l8.m1" class="ltx_Math" alttext="\widetilde{\bm{K}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{K}_{m,h,j}\,\bm{X}\bm{W}_{K}^{(m)}\in\mathbb{R}^{N\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑲</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≔</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msubsup><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">K</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{\bm{K}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{K}_{m,h,j}\,\bm{X}\bm{W}_{K}^{(m)}\in\mathbb{R}^{N\times d}</annotation></semantics></math><span id="algx2.l8.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
</span>
<span id="algx2.l9" class="ltx_listingline">
                        
                        
                      <span id="algx2.l9.2" class="ltx_text" style="--ltx-fg-color:#000000;">   </span><math id="algx2.l9.m1" class="ltx_Math" alttext="\widetilde{\bm{V}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{V}_{m,h,j}\,\bm{X}\bm{W}_{V}^{(m)}\in\mathbb{R}^{N\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑽</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">~</mo></mover><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.111em">≔</mo><mrow><msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∑</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">=</mo><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">1</mn></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">H</mi></msubsup><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">α</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">h</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">j</mi></mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑿</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">𝑾</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">∈</mo><msup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ℝ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><mo style="--ltx-fg-color:#000000;" lspace="0.222em" mathcolor="#000000" rspace="0.222em">×</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\widetilde{\bm{V}}_{h,j}\coloneqq\sum_{m=1}^{H}\alpha^{V}_{m,h,j}\,\bm{X}\bm{W}_{V}^{(m)}\in\mathbb{R}^{N\times d}</annotation></semantics></math><span id="algx2.l9.3" class="ltx_text" style="--ltx-fg-color:#000000;">
</span>
