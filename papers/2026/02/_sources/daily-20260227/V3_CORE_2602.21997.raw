<div id="alg1.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
                <span id="alg1.l8.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l8.m1" class="ltx_Math" alttext="new\_uncov=[~]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo>=</mo><mrow><mo rspace="0.330em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">new\_uncov=[~]</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">then</span>



</div>
