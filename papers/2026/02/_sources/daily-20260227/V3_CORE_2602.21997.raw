<th id="S4.T1.3.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.1.1" class="ltx_text" style="font-size:90%;">cookiecutter</span></th>
<th id="S4.T1.3.11.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.2.1" class="ltx_text" style="font-size:90%;">b445123</span></th>
<th id="S4.T1.3.11.3" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.3.1" class="ltx_text" style="font-size:90%;">Utility</span></th>
<td id="S4.T1.3.11.4" class="ltx_td ltx_align_right ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.4.1" class="ltx_text" style="font-size:90%;">10</span></td>
<td id="S4.T1.3.11.5" class="ltx_td ltx_align_right ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.5.1" class="ltx_text" style="font-size:90%;">52</span></td>
<td id="S4.T1.3.11.6" class="ltx_td ltx_align_right ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.6.1" class="ltx_text" style="font-size:90%;">172</span></td>
<td id="S4.T1.3.11.7" class="ltx_td ltx_align_right ltx_border_b" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T1.3.11.7.1" class="ltx_text" style="font-size:90%;">101</span></td>
