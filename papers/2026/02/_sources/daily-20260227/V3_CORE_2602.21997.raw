                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
                
                
               <math id="alg2.l0a.m1" class="ltx_Math" alttext="new\_target" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">new\_target</annotation></semantics></math>

</div>
<div id="alg2.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
                
                
               <math id="alg2.l1.m1" class="ltx_Math" alttext="preserve\leftarrow uncov" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo stretchy="false">←</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow></mrow><annotation encoding="application/x-tex">preserve\leftarrow uncov</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
               <math id="alg2.l2.m1" class="ltx_Math" alttext="cfg\leftarrow construct\_CFG(target)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo stretchy="false">←</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">cfg\leftarrow construct\_CFG(target)</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
                
                
               <span id="alg2.l3.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg2.l3.m1" class="ltx_Math" alttext="line" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">line</annotation></semantics></math> in <math id="alg2.l3.m2" class="ltx_Math" alttext="uncov" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">uncov</annotation></semantics></math> <span id="alg2.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
                
                
                <math id="alg2.l4.m1" class="ltx_Math" alttext="necessities\leftarrow bidirect\_BFS(line,cfg)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">←</mo><mrow><mi>b</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">necessities\leftarrow bidirect\_BFS(line,cfg)</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
                
                
                <math id="alg2.l5.m1" class="ltx_Math" alttext="preserve.add(necessities)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">preserve.add(necessities)</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
                
                
               <span id="alg2.l6.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l6.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
                
                
               <math id="alg2.l7.m1" class="ltx_Math" alttext="new\_target\leftarrow fix(preserve,target)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">←</mo><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><mo>,</mo><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">new\_target\leftarrow fix(preserve,target)</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
               <span id="alg2.l8.3" class="ltx_text ltx_font_bold">return</span>  <math id="alg2.l8.m1" class="ltx_Math" alttext="new\_target" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">new\_target</annotation></semantics></math>

</div>
</div>
</figure>
<div id="S3.SS2.SSS2.p3" class="ltx_para">
<p id="S3.SS2.SSS2.p3.1" class="ltx_p">The overall process of code elimination can be represented as Algorithm. <a href="#alg2" title="Algorithm 2 ‣ 3.2.2. Code Elimination. ‣ 3.2. Step II: Iterative Test Generation with Covered Code Elimination ‣ 3. Methodology ‣ Enhancing LLM-Based Test Generation by Eliminating Covered Code" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.
The algorithm takes as input the set of uncovered lines (<math id="S3.SS2.SSS2.p3.m1" class="ltx_Math" alttext="uncov" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">uncov</annotation></semantics></math>) and the original target unit (<math id="S3.SS2.SSS2.p3.m2" class="ltx_Math" alttext="target" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">target</annotation></semantics></math>), and returns a refined target unit <math id="S3.SS2.SSS2.p3.m3" class="ltx_Math" alttext="new\_target" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><annotation encoding="application/x-tex">new\_target</annotation></semantics></math> with irrelevant code eliminated.
In Line 1, all uncovered lines are initially added to the set <math id="S3.SS2.SSS2.p3.m4" class="ltx_Math" alttext="preserve" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">preserve</annotation></semantics></math>, which indicates the lines that must be preserved.
In line 2, the algorithm uses the function <math id="S3.SS2.SSS2.p3.m5" class="ltx_Math" alttext="construct\_CFG(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>F</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">construct\_CFG(\cdot)</annotation></semantics></math> to construct a fine-grained CFG of the original target method.
Lines 3-6 iterate over each uncovered line.
For each such line, bidirectional BFS is performed on the CFG to identify all its necessary lines that are required for execution.
These necessary lines are then added to the <math id="S3.SS2.SSS2.p3.m6" class="ltx_Math" alttext="preserve" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">preserve</annotation></semantics></math> set.
In Line 7, the function <math id="S3.SS2.SSS2.p3.m7" class="ltx_Math" alttext="fix(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">fix(\cdot)</annotation></semantics></math> is invoked to reconstruct the new target unit by retaining only the lines in <math id="S3.SS2.SSS2.p3.m8" class="ltx_Math" alttext="preserve" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">preserve</annotation></semantics></math> set.</p>
</div>
<div id="S3.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_font_smallcaps ltx_title_theorem">Proposition 3.1 (Behavior Preservation).</h6>
<div id="S3.Thmtheorem1.p1" class="ltx_para">
<p id="S3.Thmtheorem1.p1.1" class="ltx_p"><span id="S3.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S3.Thmtheorem1.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> be the original target unit, <math id="S3.Thmtheorem1.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> the set of uncovered lines, and <math id="S3.Thmtheorem1.p1.m3" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> the
program produced by Algorithm 1. Assume that
(1) the fine-grained CFG soundly captures all execution paths of <math id="S3.Thmtheorem1.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>;
(2) all data dependencies of lines in <math id="S3.Thmtheorem1.p1.m5" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi>U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math> lie on execution paths leading to them; and
(3) the reconstruction step performs only semantics-preserving local rewrites.
Then, for any input on which <math id="S3.Thmtheorem1.p1.m6" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> reaches a line <math id="S3.Thmtheorem1.p1.m7" class="ltx_Math" alttext="l\in U" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">l\in U</annotation></semantics></math>, the transformed program <math id="S3.Thmtheorem1.p1.m8" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math>
reaches the corresponding line and observes the <em id="S3.Thmtheorem1.p1.1.1.1" class="ltx_emph ltx_font_upright">same values for all variables used at <math id="S3.Thmtheorem1.p1.m9" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math></em> as in <math id="S3.Thmtheorem1.p1.m10" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="S3.SS2.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="S3.SS2.SSS2.p4" class="ltx_para">
<p id="S3.SS2.SSS2.p4.1" class="ltx_p"><span id="S3.SS2.SSS2.p4.1.1" class="ltx_text">In algorithm <a href="#alg2" title="Algorithm 2 ‣ 3.2.2. Code Elimination. ‣ 3.2. Step II: Iterative Test Generation with Covered Code Elimination ‣ 3. Methodology ‣ Enhancing LLM-Based Test Generation by Eliminating Covered Code" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, bidirectional BFS on the fine-grained CFG collects all necessary statements that may occur on any execution path including each <math id="S3.SS2.SSS2.p4.m1" class="ltx_Math" alttext="l\in U" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>∈</mo><mi>U</mi></mrow><annotation encoding="application/x-tex">l\in U</annotation></semantics></math>.
By Assumption (2), all statements that define or influence variables used at <math id="S3.SS2.SSS2.p4.m2" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> appear on such paths and are therefore preserved.
Statements not in the preserved set never occur on paths including <math id="S3.SS2.SSS2.p4.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
So removing them cannot affect variable values at <math id="S3.SS2.SSS2.p4.m4" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
The reconstruction step applies only semantics-preserving structural rewrites, ensuring that preserved statements execute in the same order and with the same effects.
Thus, for any execution of <math id="S3.SS2.SSS2.p4.m5" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> that includes an uncovered line <math id="S3.SS2.SSS2.p4.m6" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>, <math id="S3.SS2.SSS2.p4.m7" class="ltx_Math" alttext="P^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>P</mi><mo>′</mo></msup><annotation encoding="application/x-tex">P^{\prime}</annotation></semantics></math> executes the same sequence of preserved statements in the same order, resulting in identical valuations of all variables used in <math id="S3.SS2.SSS2.p4.m8" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="S3.SS2.SSS2.p5" class="ltx_para">
<p id="S3.SS2.SSS2.p5.1" class="ltx_p">In practice, code elimination may not perfectly maintain syntactic correctness or program logic.
Nevertheless, the essential information for test generation remains preserved in the new code &amp; dependencies slice.
Furthermore, all LLM-generated tests are evaluated on the original source file, and each elimination round is applied to the original target unit, preventing error accumulation.</p>
</div>
<div id="S3.SS2.SSS2.p6" class="ltx_para">
<p id="S3.SS2.SSS2.p6.1" class="ltx_p">After completing the process of code elimination, we obtain a smaller temporary slice &amp; dependencies file and apply it to the LLM-based tests generation without the elimination component.
This cycle repeats until the iteration limit in the LLM-based tests generation without the elimination component is reached, and the coverage rate remains unchanged.
During this iterative process, each execution of the code elimination not only reduces the token count of the code under test, but also enhances the prompt efficiency by narrowing the analysis scope for the LLM.
This focused context allows the LLM to focus on the relevant logic of the uncovered lines, thereby improving its overall performance.</p>
</div>
</section>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Experiments</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we first present the setup of the experiment and then detail the results and analysis of the experiment.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Experiment Setup</h3>

<section id="S4.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.1.1. </span>Benchmarks.</h4>

<div id="S4.SS1.SSS1.p1" class="ltx_para">
<p id="S4.SS1.SSS1.p1.1" class="ltx_p">We construct our dataset following established practices in prior influential work, including both search-based methods <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Lukasczyk and Fraser, 2022</a>)</cite> and LLM-based approaches <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib12" title="" class="ltx_ref">Lemieux et al., 2023</a>; <a href="#bib.bib13" title="" class="ltx_ref">Yang et al., 2024</a>)</cite>.
Our dataset is built under three criteria.
First, we include projects used in Pynguin <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Lukasczyk and Fraser, 2022</a>)</cite> and TELPA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Yang et al., 2024</a>)</cite>, as they serve as part of our baselines.
Second, we select projects from diverse domains with high GitHub star counts to ensure practical relevance.
Third, each project must contain 1–40 complex methods, defined as methods with cyclomatic complexity above 10 and more than 50 lines of code; these methods constitute our target units.
These criteria ensure that our dataset is both high-quality and representative, while maintaining a balance between diversity and computational budget.
The corresponding statistics are presented in Table. <a href="#S4.T1" title="Table 1 ‣ 4.1.1. Benchmarks. ‣ 4.1. Experiment Setup ‣ 4. Experiments ‣ Enhancing LLM-Based Test Generation by Eliminating Covered Code" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.
Each row is an open-source project.
The "Revision" column indicates the specific version of the project used in our evaluation.
The "Domain" column represents the application area of the open-source project.
"#MUTs" denotes the number of methods under test in each project.</p>
</div>
