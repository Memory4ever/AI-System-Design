<td id="S4.T4.3.7.4" class="ltx_td ltx_align_right ltx_border_b ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T4.3.7.4.1" class="ltx_text" style="font-size:90%;">16.22%</span></td>
