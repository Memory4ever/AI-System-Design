<figure id="A3.F19.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21854v1/caption_foil_Coreference_Resolution_umap.svg" id="A3.F19.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/362;" width="476" height="362"></object>
