<figure id="A3.F14.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21854v1/multiple_choice_qa_Object_Counting_umap.svg" id="A3.F14.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/362;" width="476" height="362"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(c) </span>UMAP Visualization</figcaption>
