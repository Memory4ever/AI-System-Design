<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(d) </span>PCA Projection</figcaption>
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A3.F11.sf5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2602.21854v1/caption_foil_Attribute_Recognition_tsne.png" id="A3.F11.sf5.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/353;" width="476" height="353" alt="Refer to caption">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">(e) </span>t-SNE Visualization</figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
