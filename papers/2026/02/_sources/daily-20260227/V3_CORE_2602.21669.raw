<td id="A1.T4.2.8.2" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Full</td>
<td id="A1.T4.2.8.3" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Full</td>
<td id="A1.T4.2.8.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;">Full</td>
<td id="A1.T4.2.8.5" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">LoRA</td>
<td id="A1.T4.2.8.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;">LoRA</td>
<td id="A1.T4.2.8.7" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">LoRA</td>
<td id="A1.T4.2.8.8" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">LoRA</td>
<td id="A1.T4.2.8.9" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">LoRA</td></tr>
