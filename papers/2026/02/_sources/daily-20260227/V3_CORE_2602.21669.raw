<th id="A1.T4.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r" style="padding:1pt 3.0pt;">LR Scheduler</th>
<td id="A1.T4.2.7.2" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.3" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.5" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.7" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.8" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td>
<td id="A1.T4.2.7.9" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;">Cosine</td></tr>
