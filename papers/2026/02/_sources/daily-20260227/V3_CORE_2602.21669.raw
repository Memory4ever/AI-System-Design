<td id="A4.T6.2.1.4" class="ltx_td ltx_align_center ltx_border_tt">Vicuna</td>
<td id="A4.T6.2.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">S-NI</td>
<td id="A4.T6.2.1.6" class="ltx_td ltx_align_center ltx_border_tt">Avg.</td></tr>
<tr id="A4.T6.2.2" class="ltx_tr">
<th id="A4.T6.2.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" colspan="6"><span id="A4.T6.2.2.1.1" class="ltx_text ltx_font_bold">Qwen-1.5-1.8B</span> <math id="A4.T6.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> <span id="A4.T6.2.2.1.2" class="ltx_text ltx_font_bold">GPT2-120M</span></th></tr>
