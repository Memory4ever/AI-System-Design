                  <span id="lstnumberx38.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">bash</span><span id="lstnumberx38.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx38.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">./</span><span id="lstnumberx38.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">bin</span><span id="lstnumberx38.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">/</span><span id="lstnumberx38.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">run_figure_13</span><span id="lstnumberx38.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx38.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">sh</span>
