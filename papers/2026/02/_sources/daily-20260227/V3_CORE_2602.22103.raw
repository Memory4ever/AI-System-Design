<span id="S5.T5.2.1.1.1.2.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:4.9pt;height:31.5pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:31.5pt;transform:translate(-13.3pt,-13.3pt) rotate(-90deg) ;">
