mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\left\{\begin{array}[]{ll}1-\varepsilon_{\text{low}},&amp;w_{t}&lt;1-\varepsilon_{\text{low}},\\
\operatorname{sg}(w_{t}),&amp;\text{otherwise}.\end{array}\right.</annotation></semantics></math></span></span>
</span></span><span id="S1.T1.3.1.1.1.1.1.1.7.4.3" class="ltx_text"></span></span>
<span id="S1.T1.3.1.1.1.1.1.1.7.5" class="ltx_td ltx_align_center"><span id="S1.T1.3.1.1.1.1.1.1.7.5.1" class="ltx_text"></span> <span id="S1.T1.3.1.1.1.1.1.1.7.5.2" class="ltx_text">
