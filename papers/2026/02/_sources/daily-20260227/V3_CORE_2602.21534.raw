<span id="S1.T1.3.1.1.1.1.1.1.4.2" class="ltx_td ltx_align_center"><span id="S1.T1.3.1.1.1.1.1.1.4.2.1" class="ltx_text"></span> <span id="S1.T1.3.1.1.1.1.1.1.4.2.2" class="ltx_text">
<span id="S1.T1.3.1.1.1.1.1.1.4.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S1.T1.3.1.1.1.1.1.1.4.2.2.1.1" class="ltx_tr">
<span id="S1.T1.3.1.1.1.1.1.1.4.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m11" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{G}\sum_{i=1}^{G}\frac{1}{T_{i}}\sum_{t=0}^{T_{i}-1}" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79"><mn style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">1</mn><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">G</mi></mfrac></mstyle><mstyle displaystyle="true"><mo style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">i</mi><mo style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">=</mo><mn style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">1</mn></mrow></msub><msup><mrow></mrow><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">G</mi></msup><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79"><mn style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">1</mn><msub><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">T</mi><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">i</mi></msub></mfrac></mstyle><mstyle displaystyle="true"><mo style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79" movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">t</mi><mo style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">=</mo><mn style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">0</mn></mrow></msub><msup><mrow></mrow><mrow><msub><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">T</mi><mi style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">i</mi></msub><mo style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">−</mo><mn style="--ltx-fg-color:#D24D79;" mathcolor="#D24D79">1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{G}\sum_{i=1}^{G}\frac{1}{T_{i}}\sum_{t=0}^{T_{i}-1}</annotation></semantics></math><span id="S1.T1.3.1.1.1.1.1.1.4.2.2.1.1.1.1" class="ltx_text" style="--ltx-fg-color:#D24D79;">
<math id="S1.T1.m12" class="ltx_Math" alttext="\min\!\big(w_{t}\,A_{i},\mathrm{clip}(w_{t},1\!\pm\!\varepsilon)A_{i}\big)" display="inline" intent=":literal"><semantics><mrow><mpadded style="width:1.653em;" width="1.653em"><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">min</mi></mpadded><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">clip</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi></msub><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">±</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">ε</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi></msub></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\min\!\big(w_{t}\,A_{i},\mathrm{clip}(w_{t},1\!\pm\!\varepsilon)A_{i}\big)</annotation></semantics></math></span></span></span>
</span></span><span id="S1.T1.3.1.1.1.1.1.1.4.2.3" class="ltx_text"></span></span>
