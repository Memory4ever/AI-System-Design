<td id="S3.T3.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">75.32</span></td>
<td id="S3.T3.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">57.71</span></td>
<td id="S3.T3.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">5.51</span></td>
<td id="S3.T3.3.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.8.1" class="ltx_text" style="--ltx-fg-color:#000000;">83.90</span></td>
<td id="S3.T3.3.1.3.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.9.1" class="ltx_text" style="--ltx-fg-color:#000000;">49.96</span></td>
<td id="S3.T3.3.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.10.1" class="ltx_text" style="--ltx-fg-color:#000000;">30.78</span></td>
<td id="S3.T3.3.1.3.11" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T3.3.1.3.11.1" class="ltx_text" style="--ltx-fg-color:#000000;">46.16 (48.08)</span></td></tr>
