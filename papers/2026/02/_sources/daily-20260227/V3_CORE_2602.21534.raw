<span id="S1.T1.3.1.1.1.1.1.1.7.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m31" class="ltx_Math" alttext="\left\{\begin{array}[]{ll}1+\varepsilon_{\text{high}},&amp;w_{t}&gt;1+\varepsilon_{\text{high}},\\
\operatorname{sg}(w_{t}),&amp;\text{otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">+</mo><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">ε</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">high</mtext></msub></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">w</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">t</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">&gt;</mo><mrow><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">+</mo><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">ε</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">high</mtext></msub></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">sg</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">w</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">t</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">otherwise</mtext><mo style="--ltx-fg-color:#6F2DA8;" lspace="0em" mathcolor="#6F2DA8">.