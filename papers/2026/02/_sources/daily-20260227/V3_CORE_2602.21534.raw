<span id="S1.T1.3.1.1.1.1.1.1.7.6" class="ltx_td ltx_align_center"><math id="S1.T1.m32" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span>
<span id="S1.T1.3.1.1.1.1.1.1.8" class="ltx_tr">
<span id="S1.T1.3.1.1.1.1.1.1.8.1" class="ltx_td ltx_align_left"><a href="#A1.SS2.SSS4" title="A.2.4 GSPO ‣ A.2 Importance Sampling Clipping ‣ Appendix A More Details on Research Dimension ‣ ARLArena: A Unified Framework for Stable Agentic Reinforcement Learning" class="ltx_ref">GSPO</a></span>
<span id="S1.T1.3.1.1.1.1.1.1.8.2" class="ltx_td ltx_align_center"><span id="S1.T1.3.1.1.1.1.1.1.8.2.1" class="ltx_text"></span> <span id="S1.T1.3.1.1.1.1.1.1.8.2.2" class="ltx_text">
<span id="S1.T1.3.1.1.1.1.1.1.8.2.2.1" class="ltx_tabular ltx_align_middle">
<span id="S1.T1.3.1.1.1.1.1.1.8.2.2.1.1" class="ltx_tr">
<span id="S1.T1.3.1.1.1.1.1.1.8.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m33" class="ltx_Math" alttext="\begin{aligned} \frac{1}{\sum_{i=1}^{G}T_{i}}\sum_{i=1}^{G}\sum_{t=0}^{T_{i}-1}\min\!\big(s_{i}\,A_{i},\;\mathrm{clip}(s_{i},1\!\pm\!\varepsilon)A_{i}\big)\\
s_{i}=\exp\!\Big(\frac{1}{|T_{i}|}\sum_{t=0}^{|T_{i}|-1}\log\frac{\pi_{\theta}(y_{t}\mid x,y_{&lt;t})}{\pi_{\theta_{\texttt{old}}}(y_{t}\mid x,y_{&lt;t})}\Big)\end{aligned}" display="inline" intent=":literal"><semantics><mtable rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></msubsup><msub><mi>T</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mpadded style="width:1.653em;" width="1.653em"><mi>min</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>s</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo rspace="0.447em">,</mo><mrow><mrow><mi>clip</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>i</mi></msub><mo mathsize="1.200em">,</mo><mrow><mo>±</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>i</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><msub><mi>s</mi><mi>i</mi></msub><mo>=</mo><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi>T</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mi>π</mi><msub><mi>θ</mi><mtext class="ltx_mathvariant_monospace">old</mtext></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mi>t</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>x</mi><mo>,</mo><msub><mi>y</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{aligned} \frac{1}{\sum_{i=1}^{G}T_{i}}\sum_{i=1}^{G}\sum_{t=0}^{T_{i}-1}\min\!\big(s_{i}\,A_{i},\;\mathrm{clip}(s_{i},1\!\pm\!\varepsilon)A_{i}\big)\\
s_{i}=\exp\!\Big(\frac{1}{|T_{i}|}\sum_{t=0}^{|T_{i}|-1}\log\frac{\pi_{\theta}(y_{t}\mid x,y_{&lt;t})}{\pi_{\theta_{\texttt{old}}}(y_{t}\mid x,y_{&lt;t})}\Big)\end{aligned}</annotation></semantics></math></span></span>
</span></span><span id="S1.T1.3.1.1.1.1.1.1.8.2.3" class="ltx_text"></span></span>
<span id="S1.T1.3.1.1.1.1.1.1.8.3" class="ltx_td ltx_align_center"><span id="S1.T1.3.1.1.1.1.1.1.8.3.1" class="ltx_text"></span> <span id="S1.T1.3.1.1.1.1.1.1.8.3.2" class="ltx_text">
<span id="S1.T1.3.1.1.1.1.1.1.8.3.2.1" class="ltx_tabular ltx_align_middle">
