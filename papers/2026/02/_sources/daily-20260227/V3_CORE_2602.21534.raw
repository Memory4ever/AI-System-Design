<span id="S1.T1.3.1.1.1.1.1.1.6.4" class="ltx_td ltx_align_center"><math id="S1.T1.m25" class="ltx_Math" alttext="\displaystyle\sigma(\tau_{\tiny\text{neg}}(w_{t}-1))\cdot\frac{4}{\tau_{\tiny\text{neg}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">σ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">τ</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" mathsize="0.710em">neg</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">w</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">t</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">−</mo><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8"><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">4</mn><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">τ</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" mathsize="0.710em">neg</mtext></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sigma(\tau_{\tiny\text{neg}}(w_{t}-1))\cdot\frac{4}{\tau_{\tiny\text{neg}}}</annotation></semantics></math></span>
<span id="S1.T1.3.1.1.1.1.1.1.6.5" class="ltx_td ltx_align_center"><math id="S1.T1.m26" class="ltx_Math" alttext="\displaystyle\sigma(\tau_{\tiny\text{pos}}(w_{t}-1))\cdot\frac{4}{\tau_{\tiny\text{pos}}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">σ</mi><mo>⁡</mo><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">τ</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" mathsize="0.710em">pos</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">(</mo><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">w</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">t</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">−</mo><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8"><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">4</mn><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">τ</mi><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8" mathsize="0.710em">pos</mtext></msub></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\sigma(\tau_{\tiny\text{pos}}(w_{t}-1))\cdot\frac{4}{\tau_{\tiny\text{pos}}}</annotation></semantics></math></span>
