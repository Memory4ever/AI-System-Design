<span id="S1.T1.3.1.1.1.1.1.1.9.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m38" class="ltx_math_unparsed" alttext="\displaystyle\frac{1}{\sum_{i=1}^{G}T_{i}}\sum_{i=1}^{G}\sum_{t=0}^{T_{i}-1}\min\!\big(w_{t}\,A^{{}^{\prime}}_{i,k},\;\mathrm{clip}(w_{t},1\!\pm\!\varepsilon)A^{{}^{\prime}}_{i,k}\big)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></msubsup><msub><mi>T</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow><msub><mi>T</mi><mi>i</mi></msub><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mpadded style="width:1.653em;" width="1.653em"><mi>min</mi></mpadded><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>w</mi><mi>t</mi></msub><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><msup><mrow></mrow><mo>′</mo></msup></msubsup><mo rspace="0.447em">,</mo><mi>clip</mi><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>t</mi></msub><mpadded style="width:0.108em;" width="0.108em"><mo>,</mo></mpadded><mo rspace="0.052em">±</mo><mi>ε</mi><mo stretchy="false">)</mo></mrow><msubsup><mi>A</mi><mrow><mi>i</mi><mo>,</mo><mi>k</mi></mrow><msup><mrow></mrow><mo>′</mo></msup></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{\sum_{i=1}^{G}T_{i}}\sum_{i=1}^{G}\sum_{t=0}^{T_{i}-1}\min\!\big(w_{t}\,A^{{}^{\prime}}_{i,k},\;\mathrm{clip}(w_{t},1\!\pm\!\varepsilon)A^{{}^{\prime}}_{i,k}\big)</annotation></semantics></math></span></span>
