<td id="S4.T5.3.5.4" class="ltx_td ltx_align_center"><span id="S4.T5.3.5.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">24.22</span></td>
<td id="S4.T5.3.5.5" class="ltx_td ltx_align_center"><span id="S4.T5.3.5.5.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">75.00</span></td>
