<span id="S1.T1.3.1.1.1.1.1.1.8.3.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m34" class="ltx_Math" alttext="\frac{\displaystyle r_{i}-\mathrm{mean}(r_{i})}{\displaystyle\mathrm{std}(r_{i})}" display="inline" intent=":literal"><semantics><mfrac><mrow><msub><mi>r</mi><mi mathsize="1.400em">i</mi></msub><mo>−</mo><mrow><mi>mean</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi mathsize="1.400em">i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mi>std</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi mathsize="1.400em">i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><annotation encoding="application/x-tex">\frac{\displaystyle r_{i}-\mathrm{mean}(r_{i})}{\displaystyle\mathrm{std}(r_{i})}</annotation></semantics></math></span></span>
</span></span><span id="S1.T1.3.1.1.1.1.1.1.8.3.3" class="ltx_text"></span></span>
