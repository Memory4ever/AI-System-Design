<span id="S1.T1.3.1.1.1.1.1.1.8.5.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S1.T1.m36" class="ltx_Math" alttext="\left\{\begin{array}[]{ll}1+\varepsilon,&amp;s_{i}&gt;1+\varepsilon,\\
s_{i},&amp;\text{otherwise}.\end{array}\right." display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">+</mo><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">ε</mi></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">s</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">i</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">&gt;</mo><mrow><mn style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">1</mn><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">+</mo><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">ε</mi></mrow></mrow><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">s</mi><mi style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">i</mi></msub><mo style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext style="--ltx-fg-color:#6F2DA8;" mathcolor="#6F2DA8">otherwise</mtext><mo style="--ltx-fg-color:#6F2DA8;" lspace="0em" mathcolor="#6F2DA8">.</mo></mrow></mtd></mtr></mtable><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\left\{\begin{array}[]{ll}1+\varepsilon,&amp;s_{i}&gt;1+\varepsilon,\\
s_{i},&amp;\text{otherwise}.\end{array}\right.</annotation></semantics></math></span></span>
</span></span><span id="S1.T1.3.1.1.1.1.1.1.8.5.3" class="ltx_text"></span></span>
<span id="S1.T1.3.1.1.1.1.1.1.8.6" class="ltx_td ltx_align_center"><math id="S1.T1.m37" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></span>
<span id="S1.T1.3.1.1.1.1.1.1.9" class="ltx_tr">
<span id="S1.T1.3.1.1.1.1.1.1.9.1" class="ltx_td ltx_align_left"><a href="#A1.SS3.SSS1" title="A.3.1 Group-in-Group Policy Optimization (GiGPO) ‣ A.3 Advantage Design ‣ Appendix A More Details on Research Dimension ‣ ARLArena: A Unified Framework for Stable Agentic Reinforcement Learning" class="ltx_ref">GIGPO</a></span>
<span id="S1.T1.3.1.1.1.1.1.1.9.2" class="ltx_td ltx_align_center"><span id="S1.T1.3.1.1.1.1.1.1.9.2.1" class="ltx_text"></span> <span id="S1.T1.3.1.1.1.1.1.1.9.2.2" class="ltx_text">
