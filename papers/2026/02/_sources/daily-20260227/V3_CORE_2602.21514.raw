<td id="S4.T1.13.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-1.7pt 2.6pt;"><span id="S4.T1.13.5.2.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#28A028;">➚</span></td>
