<td id="S4.T2.4.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.4.4.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#28A028;">✓</span></td>
<td id="S4.T2.4.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.4.5.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#28A028;">✓</span></td>
<td id="S4.T2.4.4.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.4.6.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#D62728;">✗</span></td>
