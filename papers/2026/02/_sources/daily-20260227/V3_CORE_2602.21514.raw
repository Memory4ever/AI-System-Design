<td id="S4.T2.4.2.8" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.2.8.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">PageSearch</span></td></tr>
<tr id="S4.T2.4.3" class="ltx_tr">
<td id="S4.T2.4.3.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.3.1.1" class="ltx_text" style="font-size:90%;">DiskANN <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Subramanya et al., 2019</a>)</cite></span></td>
