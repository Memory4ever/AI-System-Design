<td id="S4.T2.4.4.1" class="ltx_td ltx_align_left ltx_border_l ltx_border_r ltx_border_t" style="padding:-1.4pt 4.6pt;"><span id="S4.T2.4.4.1.1" class="ltx_text" style="font-size:90%;">Starling <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib26" title="" class="ltx_ref">Wang et al., 2024</a>)</cite>/DiskANN++ <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib69" title="" class="ltx_ref">Ni et al., 2023</a>)</cite></span></td>
