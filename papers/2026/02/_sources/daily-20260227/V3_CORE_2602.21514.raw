<td id="S7.T7.4.10.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r" style="padding:-1.7pt 1.4pt;"><span id="S7.T7.4.10.6.1" class="ltx_text" style="font-size:80%;">826</span></td>
