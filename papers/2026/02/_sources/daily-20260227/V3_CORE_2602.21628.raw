<th id="S4.T4.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="S4.T4.m4" class="ltx_Math" alttext="w=10" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>=</mo><mn>10</mn></mrow><annotation encoding="application/x-tex">w=10</annotation></semantics></math></th>
<td id="S4.T4.5.2.2" class="ltx_td ltx_align_center ltx_border_t">55.57</td>
<td id="S4.T4.5.2.3" class="ltx_td ltx_align_center ltx_border_t">60.8</td>
