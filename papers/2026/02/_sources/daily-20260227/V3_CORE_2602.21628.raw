<td id="A4.T6.5.8.6" class="ltx_td ltx_align_center"><span id="A4.T6.5.8.6.1" class="ltx_text" style="font-size:90%;">91.7</span></td></tr>
<tr id="A4.T6.5.9" class="ltx_tr">
