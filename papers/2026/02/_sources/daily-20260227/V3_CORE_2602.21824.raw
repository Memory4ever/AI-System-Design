<td id="S4.T2.3.1.3.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">7.60</span></td>
<td id="S4.T2.3.1.3.5" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.3.5.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">61.51</span></td>
<td id="S4.T2.3.1.3.6" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.3.6.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">7.49</span></td>
<td id="S4.T2.3.1.3.7" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.3.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ECECEC;">63.16</span></td>
<td id="S4.T2.3.1.3.8" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.3.8.1" class="ltx_text" style="--ltx-bg-color:#ECECEC;">7.52</span></td></tr>
<tr id="S4.T2.3.1.4" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="S4.T2.3.1.4.1" class="ltx_td ltx_align_left"><span id="S4.T2.3.1.4.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">DocVQA</span></td>
