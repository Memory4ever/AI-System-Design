<figure id="Pt0.A11.F24.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21824v1/doclaynet4k_alpha=1.0_CLS_distribution.svg" id="Pt0.A11.F24.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:357/213;" width="357" height="213"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Pt0.A11.F24.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="Pt0.A11.F24.sf3.4" class="ltx_text" style="font-size:90%;">DocLayNet-CLS <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib43" title="" class="ltx_ref">44</a>]</cite></span></figcaption>
