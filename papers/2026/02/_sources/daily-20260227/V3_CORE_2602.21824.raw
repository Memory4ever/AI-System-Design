<figure id="Pt0.A11.F27.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2602.21824v1/sroie_alpha=1.0_distribution_comparison.svg" id="Pt0.A11.F27.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:268/190;" width="268" height="190"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Pt0.A11.F27.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="Pt0.A11.F27.sf2.4" class="ltx_text" style="font-size:90%;">SROIE <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib28" title="" class="ltx_ref">29</a>]</cite></span></figcaption>
