<td id="S4.T2.3.1.1.4" class="ltx_td ltx_align_center" colspan="2"><math id="S4.T2.m2" class="ltx_Math" alttext="\alpha=0.75" display="inline" intent=":literal"><semantics><mrow><mi>𝜶</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mn class="ltx_mathvariant_bold" mathvariant="bold">0.75</mn></mrow><annotation encoding="application/x-tex">\alpha=0.75</annotation></semantics></math></td>
<td id="S4.T2.3.1.1.5" class="ltx_td ltx_align_center" colspan="2"><math id="S4.T2.m3" class="ltx_Math" alttext="\alpha=1.00" display="inline" intent=":literal"><semantics><mrow><mi>𝜶</mi><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mn class="ltx_mathvariant_bold" mathvariant="bold">1.00</mn></mrow><annotation encoding="application/x-tex">\alpha=1.00</annotation></semantics></math></td></tr>
