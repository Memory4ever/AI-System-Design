<td id="S4.T2.3.1.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.2.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFFFFF;">LFID (<math id="S4.T2.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
<td id="S4.T2.3.1.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.2.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFFFFF;">Score (<math id="S4.T2.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</span></td>
<td id="S4.T2.3.1.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S4.T2.3.1.2.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#FFFFFF;">LFID (<math id="S4.T2.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</span></td>
