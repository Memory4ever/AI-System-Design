<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="Pt0.A11.F27.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="Pt0.A11.F27.sf1.4" class="ltx_text" style="font-size:90%;">FUNSD <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">30</a>]</cite></span></figcaption>
