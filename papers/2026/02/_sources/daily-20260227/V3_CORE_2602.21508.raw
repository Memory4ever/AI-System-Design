<th id="S3.T2.7.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S3.T2.7.1.4.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">AIGC Distortion (<math id="S3.T2.m6" class="ltx_Math" alttext="s_{atk}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">s</mi><mrow><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">k</mi></mrow></msub><annotation encoding="application/x-tex">s_{atk}</annotation></semantics></math>)</span></th>
<td id="S3.T2.7.1.4.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T2.m7" class="ltx_Math" style="--ltx-bg-color:#E6E6E6;" alttext="\mathbf{+0.027}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-bg-color:#E6E6E6;" mathbackground="#E6E6E6">+</mo><mn style="--ltx-bg-color:#E6E6E6;" class="ltx_mathvariant_bold" mathbackground="#E6E6E6" mathvariant="bold">0.027</mn></mrow><annotation encoding="application/x-tex">\mathbf{+0.027}</annotation></semantics></math></td>
<td id="S3.T2.7.1.4.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.7.1.4.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Gradient</span></td>
<td id="S3.T2.7.1.4.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S3.T2.7.1.4.4.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FF0000;--ltx-bg-color:#E6E6E6;">Maximizes Error</span></td></tr>
