</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
               <math id="alg1.l21.m1" class="ltx_Math" alttext="\mathcal{L}_{img}\leftarrow\text{MSE}(x,x_{wm})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>MSE</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><msub><mi>x</mi><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{img}\leftarrow\text{MSE}(x,x_{wm})</annotation></semantics></math> {Image Fidelity Loss}

</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
               <math id="alg1.l22.m1" class="ltx_Math" alttext="\mathcal{L}_{total}\leftarrow\mathcal{L}_{img}+\mathcal{L}_{rec}+\beta\mathcal{L}_{KL}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{total}\leftarrow\mathcal{L}_{img}+\mathcal{L}_{rec}+\beta\mathcal{L}_{KL}</annotation></semantics></math> {Total Objective (Eq. 9)}

</div>
<div id="alg1.l23" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l23.1" class="ltx_text" style="font-size:80%;">23:</span></span>
              
              
               <span id="alg1.l23.3" class="ltx_text ltx_font_italic"># 7. Optimization</span>

</div>
