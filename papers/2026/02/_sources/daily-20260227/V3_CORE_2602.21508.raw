<th id="S3.T2.7.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">N/A</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S3.T2.7.1.3" class="ltx_tr">
<th id="S3.T2.7.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Watermark Signal (<math id="S3.T2.m4" class="ltx_Math" alttext="\delta" display="inline" intent=":literal"><semantics><mi>δ</mi><annotation encoding="application/x-tex">\delta</annotation></semantics></math>)</th>
<td id="S3.T2.7.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T2.m5" class="ltx_Math" alttext="-0.063" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.063</mn></mrow><annotation encoding="application/x-tex">-0.063</annotation></semantics></math></td>
<td id="S3.T2.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t">Anti-Gradient</td>
