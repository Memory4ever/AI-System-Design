<th id="S3.T2.7.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S3.T2.7.1.1.1.1" class="ltx_text ltx_font_bold">Vector Component</span></th>
<th id="S3.T2.7.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.7.1.1.2.1" class="ltx_text ltx_font_bold">Projection Value</span></th>
<th id="S3.T2.7.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.7.1.1.3.1" class="ltx_text ltx_font_bold">Direction</span></th>
<th id="S3.T2.7.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S3.T2.7.1.1.4.1" class="ltx_text ltx_font_bold">Effect on Decoding</span></th></tr>
<tr id="S3.T2.7.1.2" class="ltx_tr">
<th id="S3.T2.7.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_t">Gradient Direction (<math id="S3.T2.m3" class="ltx_Math" alttext="\nabla_{x}\mathcal{L}" display="inline" intent=":literal"><semantics><mrow><msub><mo>∇</mo><mi>x</mi></msub><mi class="ltx_font_mathcaligraphic">ℒ</mi></mrow><annotation encoding="application/x-tex">\nabla_{x}\mathcal{L}</annotation></semantics></math>)</th>
<th id="S3.T2.7.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">N/A</th>
