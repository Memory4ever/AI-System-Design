<td id="S4.T4.24.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.24.3.9.1" class="ltx_text" style="font-size:90%;">91.88</span></td></tr>
<tr id="S4.T4.24.4" class="ltx_tr">
<td id="S4.T4.24.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.24.4.1.1" class="ltx_text" style="font-size:90%;">Ours (Vision)</span></td>
