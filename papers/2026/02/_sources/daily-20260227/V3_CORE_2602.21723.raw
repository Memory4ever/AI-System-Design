<td id="S4.T4.24.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T4.24.3.7.1" class="ltx_text" style="font-size:90%;">84.89</span></td>
