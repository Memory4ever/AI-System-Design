<td id="S5.T2.4.5.12" class="ltx_td ltx_align_center">0.71</td>
<td id="S5.T2.4.5.13" class="ltx_td ltx_align_center">0.65</td></tr>
<tr id="S5.T2.4.6" class="ltx_tr">
<th id="S5.T2.4.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_r"><span id="S5.T2.4.6.1.1" class="ltx_text ltx_font_bold">Ours (GPT-4o)</span></th>
<td id="S5.T2.4.6.2" class="ltx_td ltx_align_center ltx_border_b"><span id="S5.T2.4.6.2.1" class="ltx_text ltx_font_bold">0.95</span></td>
