<tr id="S4.T1.2.10" class="ltx_tr">
<td id="S4.T1.2.10.1" class="ltx_td ltx_align_center">Ours</td>
<td id="S4.T1.2.10.2" class="ltx_td ltx_align_center"><span id="S4.T1.2.10.2.1" class="ltx_text ltx_font_bold">195.00</span></td>
