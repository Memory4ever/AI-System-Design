<div id="A1.T8.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:418.4pt;height:59.6pt;vertical-align:-27.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-52.3pt,7.4pt) scale(0.8,0.8) ;">
