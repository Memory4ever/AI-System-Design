<td id="A1.T9.2.1.4.3" class="ltx_td ltx_align_center"><span id="A1.T9.2.1.4.3.1" class="ltx_text ltx_font_bold">39.3</span></td>
<td id="A1.T9.2.1.4.4" class="ltx_td ltx_align_center"><span id="A1.T9.2.1.4.4.1" class="ltx_text ltx_font_bold">35.2</span></td>
