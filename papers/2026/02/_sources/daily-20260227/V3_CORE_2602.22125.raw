<li class="ltx_tocentry ltx_tocentry_section"><a href="#S6" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">6 </span>Conclusion</span></a></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">7 </span>Limitations</span></a></li>
<li class="ltx_tocentry ltx_tocentry_bibliography"><a href="#bib" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title">References</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A1" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">A </span>Dataset Details</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A2" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">B </span>Translation</span></a></li>
<li class="ltx_tocentry ltx_tocentry_appendix"><a href="#A3" title="In IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">C </span>Grounding</span></a></li>
