<td id="S5.T2.2.1.21.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">57.5</td>
<td id="S5.T2.2.1.21.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">56.9</td>
