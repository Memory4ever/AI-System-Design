<ol class="ltx_toclist ltx_toclist_appendix">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS1" title="In Appendix D Human Verification ‣ IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.1 </span><span class="ltx_text ltx_font_smallcaps">IndicIFEval-Trans</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#A4.SS2" title="In Appendix D Human Verification ‣ IndicIFEval: A Benchmark for Verifiable Instruction-Following Evaluation in 14 Indic Languages" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">D.2 </span><span class="ltx_text ltx_font_smallcaps">IndicIFEval-Ground</span></span></a></li>
