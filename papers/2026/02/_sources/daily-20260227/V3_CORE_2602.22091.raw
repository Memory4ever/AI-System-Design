<th id="S2.T1.13.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding:0.7pt 5.0pt;"><span id="S2.T1.13.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Input</span></th>
