<td id="S4.T1.7.5.8" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#FFF5EB;padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T1.7.5.8.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FFF5EB;">–</span></td>
<td id="S4.T1.7.5.9" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#FBF0F4;padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T1.7.5.9.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#FBF0F4;">–</span></td></tr>
<tr id="S4.T1.7.6" class="ltx_tr">
<th id="S4.T1.7.6.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T1.7.6.1.1" class="ltx_text" style="font-size:70%;--ltx-fg-color:#6666FF;">LFG</span></th>
