<td id="S4.T1.7.5.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="--ltx-bg-color:#F0F0FF;padding-left:1.5pt;padding-right:1.5pt;"><span id="S4.T1.7.5.6.1" class="ltx_text" style="font-size:70%;--ltx-bg-color:#F0F0FF;">–</span></td>
