<td id="S5.F3.3.1.3" class="ltx_td ltx_align_center"><span id="S5.F3.3.1.3.1" class="ltx_text ltx_font_bold">LFG Depth (3 Frames)</span></td>
<td id="S5.F3.3.1.4" class="ltx_td ltx_align_center"><span id="S5.F3.3.1.4.1" class="ltx_text ltx_font_bold"><math id="S5.F3.m1" class="ltx_Math" alttext="\pi^{3}" display="inline" intent=":literal"><semantics><msup><mi>π</mi><mn>3</mn></msup><annotation encoding="application/x-tex">\pi^{3}</annotation></semantics></math> Depth (All Frames)</span></td></tr>
<tr id="S5.F3.3.2" class="ltx_tr">
<th id="S5.F3.3.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-bottom: 4.0pt;">
<div id="S5.F3.3.2.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:77.7pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:77.7pt;transform:translate(-35.4pt,-35.4pt) rotate(-90deg) ;">
<p id="S5.F3.3.2.1.1.1" class="ltx_p"><span id="S5.F3.3.2.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#0000FF;">Frame 1</span></p>
</span></div></th>
