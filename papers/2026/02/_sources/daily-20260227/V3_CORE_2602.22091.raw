<td id="S2.T1.13.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.0pt;"><span id="S2.T1.13.2.3.1" class="ltx_text" style="font-size:90%;">61.5</span></td>
<td id="S2.T1.13.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.0pt;"><span id="S2.T1.13.2.4.1" class="ltx_text" style="font-size:90%;">65.6</span></td>
<td id="S2.T1.13.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.0pt;"><span id="S2.T1.13.2.5.1" class="ltx_text" style="font-size:90%;">74.6</span></td></tr>
<tr id="S2.T1.13.3" class="ltx_tr">
<th id="S2.T1.13.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.7pt 5.0pt;"><span id="S2.T1.13.3.1.1" class="ltx_text" style="font-size:90%;">PPGeo<sup id="S2.T1.13.3.1.1.1" class="ltx_sup">∗</sup></span></th>
