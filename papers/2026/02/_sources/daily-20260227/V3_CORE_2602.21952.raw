<td id="S4.T7.7.5.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.85pt 2.7pt;"><span id="S4.T7.7.5.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">1.57</span></td>
