<th id="S3.T1.6.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">3s</th>
<th id="S3.T1.6.1.3.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S3.T1.6.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Avg.</span></th>
<th id="S3.T1.6.1.3.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1s</th>
<th id="S3.T1.6.1.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">2s</th>
<th id="S3.T1.6.1.3.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">3s</th>
<th id="S3.T1.6.1.3.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S3.T1.6.1.3.8.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Avg.</span></th>
<th id="S3.T1.6.1.3.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1s</th>
<th id="S3.T1.6.1.3.10" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">2s</th>
<th id="S3.T1.6.1.3.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">3s</th>
<th id="S3.T1.6.1.3.12" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="--ltx-bg-color:#E6E6E6;"><span id="S3.T1.6.1.3.12.1" class="ltx_text" style="--ltx-bg-color:#E6E6E6;">Avg.</span></th>
<th id="S3.T1.6.1.3.13" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1s</th>
