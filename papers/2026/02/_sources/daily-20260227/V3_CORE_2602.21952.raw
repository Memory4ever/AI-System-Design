<th id="S3.T1.6.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="4"><span id="S3.T1.6.1.2.4.1" class="ltx_text ltx_font_bold">Collision (%)</span> <math id="S3.T1.m6" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></th></tr>
<tr id="S3.T1.6.1.3" class="ltx_tr">
<th id="S3.T1.6.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">1s</th>
