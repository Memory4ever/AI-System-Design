<td id="S3.T3.6.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S3.T3.6.1.1.1.1" class="ltx_text ltx_font_bold">Version</span></td>
<td id="S3.T3.6.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S3.T3.6.1.1.2.1" class="ltx_text ltx_font_bold">Prompt</span></td>
