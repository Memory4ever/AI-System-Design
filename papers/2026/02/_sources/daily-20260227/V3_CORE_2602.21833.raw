<td id="S3.T3.6.1.1.7" class="ltx_td ltx_align_right ltx_border_tt"><span id="S3.T3.6.1.1.7.1" class="ltx_text ltx_font_bold">Empty Lines</span></td>
<td id="S3.T3.6.1.1.8" class="ltx_td ltx_align_right ltx_border_tt"><span id="S3.T3.6.1.1.8.1" class="ltx_text ltx_font_bold">Methods</span></td></tr>
<tr id="S3.T3.6.1.2" class="ltx_tr">
<td id="S3.T3.6.1.2.1" class="ltx_td ltx_align_left ltx_border_t">0</td>
<td id="S3.T3.6.1.2.2" class="ltx_td ltx_align_left ltx_border_t">—</td>
<td id="S3.T3.6.1.2.3" class="ltx_td ltx_align_right ltx_border_t">95</td>
<td id="S3.T3.6.1.2.4" class="ltx_td ltx_align_right ltx_border_t">41</td>
<td id="S3.T3.6.1.2.5" class="ltx_td ltx_align_right ltx_border_t">35</td>
<td id="S3.T3.6.1.2.6" class="ltx_td ltx_align_right ltx_border_t">3</td>
<td id="S3.T3.6.1.2.7" class="ltx_td ltx_align_right ltx_border_t">19</td>
<td id="S3.T3.6.1.2.8" class="ltx_td ltx_align_right ltx_border_t">2</td></tr>
<tr id="S3.T3.6.1.3" class="ltx_tr">
<td id="S3.T3.6.1.3.1" class="ltx_td ltx_align_left">1</td>
<td id="S3.T3.6.1.3.2" class="ltx_td ltx_align_left">Prompt<sub id="S3.T3.6.1.3.2.1" class="ltx_sub">General</sub></td>
<td id="S3.T3.6.1.3.3" class="ltx_td ltx_align_right">82</td>
<td id="S3.T3.6.1.3.4" class="ltx_td ltx_align_right">42</td>
<td id="S3.T3.6.1.3.5" class="ltx_td ltx_align_right">27</td>
