<span id="S3.T2.2.1.3.1" class="ltx_inline-block ltx_align_top" style="width:284.5pt;">
<span id="S3.T2.2.1.3.1.1" class="ltx_p">Exact Prompt Wording</span>
</span></td></tr>
<tr id="S3.T2.2.2" class="ltx_tr">
<td id="S3.T2.2.2.1" class="ltx_td ltx_align_left ltx_border_t">Prompt<sub id="S3.T2.2.2.1.1" class="ltx_sub">General</sub></td>
<td id="S3.T2.2.2.2" class="ltx_td ltx_align_left ltx_border_t">Unguided</td>
