<td id="S6.T7.5.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S6.T7.5.1.4.2.1" class="ltx_text ltx_font_bold">0.507</span></td>
