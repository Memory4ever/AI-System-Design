<td id="S6.T5.5.1.9.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.05</td></tr>
<tr id="S6.T5.5.1.10" class="ltx_tr">
<th id="S6.T5.5.1.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;">Global Batch Size</th>
<td id="S6.T5.5.1.10.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">32</td></tr>
<tr id="S6.T5.5.1.11" class="ltx_tr">
<th id="S6.T5.5.1.11.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-top:0.5pt;padding-bottom:0.5pt;">KL Coefficient (<math id="S6.T5.m4" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>)</th>
<td id="S6.T5.5.1.11.2" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.01</td></tr>
