<p id="A9.p1.5" class="ltx_p"><span id="A9.p1.5.1" class="ltx_text ltx_font_italic">learning rate: 1e-4, Batch size: 128, epoch: 1</span> 
<br class="ltx_break"><span id="A9.p1.5.2" class="ltx_text ltx_font_bold">EM:</span> 21.6%, <span id="A9.p1.5.3" class="ltx_text ltx_font_bold">Recall:</span> 26.3%</p>
<div id="A9.p1.6" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,PHxjaGFubmVsfD5hbmFseXNpczx8bWVzc2FnZXw+TmVlZCBhbnN3ZXI6IHthbnN3ZXJ9Ljx8ZW5kfD48fHN0YXJ0fD5hc3Npc3RhbnQ8fGNoYW5uZWx8PmZpbmFsPHxtZXNzYWdlfD5UaGUgYW5zd2VyIGlzIDxhbnN3ZXI+e2Fuc3dlcn08L2Fuc3dlcj4u" download="">⬇</a></div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx22.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">channel</span><span id="lstnumberx22.3" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx22.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">analysis</span><span id="lstnumberx22.5" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx22.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">message</span><span id="lstnumberx22.7" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx22.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Need</span><span id="lstnumberx22.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.11" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx22.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.13" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx22.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.15" class="ltx_text ltx_font_typewriter">}.&lt;|</span><span id="lstnumberx22.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">end</span><span id="lstnumberx22.17" class="ltx_text ltx_font_typewriter">|&gt;&lt;|</span><span id="lstnumberx22.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">start</span><span id="lstnumberx22.19" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx22.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">assistant</span><span id="lstnumberx22.21" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx22.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">channel</span><span id="lstnumberx22.23" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx22.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">final</span><span id="lstnumberx22.25" class="ltx_text ltx_font_typewriter">&lt;|</span><span id="lstnumberx22.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">message</span><span id="lstnumberx22.27" class="ltx_text ltx_font_typewriter">|&gt;</span><span id="lstnumberx22.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx22.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx22.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx22.34" class="ltx_text ltx_font_typewriter">&lt;</span><span id="lstnumberx22.35" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.36" class="ltx_text ltx_font_typewriter">&gt;{</span><span id="lstnumberx22.37" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.38" class="ltx_text ltx_font_typewriter">}&lt;/</span><span id="lstnumberx22.39" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx22.40" class="ltx_text ltx_font_typewriter">&gt;.</span>
</div>
</div>
<p id="A9.p1.7" class="ltx_p"><span id="A9.p1.7.1" class="ltx_text ltx_font_italic">learning rate: 2e-5, Batch size: 512, epoch: 5</span> 
<br class="ltx_break"><span id="A9.p1.7.2" class="ltx_text ltx_font_bold">EM:</span> 20.7%, <span id="A9.p1.7.3" class="ltx_text ltx_font_bold">Recall:</span> 25.2% 
<br class="ltx_break"><span id="A9.p1.7.4" class="ltx_text ltx_font_italic">Note: We report Recall instead of Ex-Recall here because the SFT-trained model outputs only a single answer in the <span id="A9.p1.7.4.1" class="ltx_text ltx_font_typewriter">&lt;answer&gt;...&lt;/answer&gt;</span> tags.</span></p>
</div>
</section>
