<div id="A4.p1" class="ltx_para">
<div id="A4.p1.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">You</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx1.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">given</span><span id="lstnumberx1.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">an</span><span id="lstnumberx1.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx1.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx1.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter">may</span><span id="lstnumberx1.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter">contain</span><span id="lstnumberx1.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter">one</span><span id="lstnumberx1.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx1.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">multiple</span><span id="lstnumberx1.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">possibilities</span><span id="lstnumberx1.24" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx2.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">only</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">contains</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">one</span><span id="lstnumberx2.10" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">just</span><span id="lstnumberx2.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">output</span><span id="lstnumberx2.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx2.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">as</span><span id="lstnumberx2.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx2.21" class="ltx_text ltx_font_typewriter">.</span><span id="lstnumberx2.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Otherwise</span><span id="lstnumberx2.24" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.25" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter">choose</span><span id="lstnumberx2.27" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.29" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx2.31" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter">that</span><span id="lstnumberx2.33" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx2.35" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.36" class="ltx_text ltx_lst_identifier ltx_font_typewriter">stated</span><span id="lstnumberx2.37" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.38" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx2.39" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.40" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx2.41" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter">most</span><span id="lstnumberx2.43" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter">confidence</span><span id="lstnumberx2.45" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx2.46" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.47" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx2.48" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.49" class="ltx_text ltx_lst_identifier ltx_font_typewriter">there</span><span id="lstnumberx2.50" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.51" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx2.52" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.53" class="ltx_text ltx_lst_identifier ltx_font_typewriter">multiple</span><span id="lstnumberx2.54" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx2.55" class="ltx_text ltx_lst_identifier ltx_font_typewriter">options</span><span id="lstnumberx2.56" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">DO</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">NOT</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">correct</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx3.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx3.10" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">even</span><span id="lstnumberx3.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx3.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">you</span><span id="lstnumberx3.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">think</span><span id="lstnumberx3.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">it</span><span id="lstnumberx3.21" class="ltx_text ltx_font_typewriter">’</span><span id="lstnumberx3.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">s</span><span id="lstnumberx3.23" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter">incorrect</span><span id="lstnumberx3.25" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx4" class="ltx_listingline">
</div>
<div id="lstnumberx5" class="ltx_listingline"><span id="lstnumberx5.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Examples</span><span id="lstnumberx5.2" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">A</span><span id="lstnumberx6.2" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx6.3" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">While</span><span id="lstnumberx6.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Leif</span><span id="lstnumberx6.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Erikson</span><span id="lstnumberx6.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reached</span><span id="lstnumberx6.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">North</span><span id="lstnumberx6.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">America</span><span id="lstnumberx6.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">earlier</span><span id="lstnumberx6.17" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx6.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.19" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Christopher</span><span id="lstnumberx6.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Columbus</span><span id="lstnumberx6.22" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx6.24" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter">usually</span><span id="lstnumberx6.26" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx6.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter">cited</span><span id="lstnumberx6.28" class="ltx_text ltx_font_typewriter">.</span>
