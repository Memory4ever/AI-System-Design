<th id="S5.T2.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S5.T2.2.1.1.2.1" class="ltx_text ltx_font_bold">Temp.</span></th>
<th id="S5.T2.2.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S5.T2.2.1.1.3.1" class="ltx_text ltx_font_bold">Prompt</span></th>
<th id="S5.T2.2.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.4.1" class="ltx_text ltx_font_bold">MMLU-Pro Acc.</span></th>
