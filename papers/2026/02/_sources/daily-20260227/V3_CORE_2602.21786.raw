<th id="S5.T2.2.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.7.1" class="ltx_text ltx_font_bold">GPQA Null Rate</span></th>
<th id="S5.T2.2.1.1.8" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.8.1" class="ltx_text ltx_font_bold">GPQA Null-Corr.</span></th>
<th id="S5.T2.2.1.1.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T2.2.1.1.9.1" class="ltx_text ltx_font_bold">GPQA Tokens</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T2.2.1.2" class="ltx_tr">
<th id="S5.T2.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base</th>
<th id="S5.T2.2.1.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Locked</th>
<th id="S5.T2.2.1.2.3" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Base</th>
<td id="S5.T2.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">55.66%</td>
<td id="S5.T2.2.1.2.5" class="ltx_td ltx_align_center ltx_border_t">1,742</td>
<td id="S5.T2.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t">43.03%</td>
<td id="S5.T2.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">30.91%</td>
<td id="S5.T2.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t">50.76%</td>
<td id="S5.T2.2.1.2.9" class="ltx_td ltx_align_center ltx_border_t">5,875</td></tr>
<tr id="S5.T2.2.1.3" class="ltx_tr">
<th id="S5.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Base</th>
<th id="S5.T2.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">Locked</th>
<th id="S5.T2.2.1.3.3" class="ltx_td ltx_align_left ltx_th ltx_th_row">Custom</th>
<td id="S5.T2.2.1.3.4" class="ltx_td ltx_align_center">58.24%</td>
<td id="S5.T2.2.1.3.5" class="ltx_td ltx_align_center">1,595</td>
<td id="S5.T2.2.1.3.6" class="ltx_td ltx_align_center">45.05%</td>
<td id="S5.T2.2.1.3.7" class="ltx_td ltx_align_center">24.44%</td>
<td id="S5.T2.2.1.3.8" class="ltx_td ltx_align_center">51.16%</td>
<td id="S5.T2.2.1.3.9" class="ltx_td ltx_align_center">5,539</td></tr>
