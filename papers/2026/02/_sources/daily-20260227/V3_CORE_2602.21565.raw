<td id="S5.T2.5.1.13.2" class="ltx_td ltx_align_right ltx_border_bb">0.241</td>
<td id="S5.T2.5.1.13.3" class="ltx_td ltx_align_right ltx_border_bb">0.390</td>
<td id="S5.T2.5.1.13.4" class="ltx_td ltx_align_right ltx_border_bb"><span id="S5.T2.5.1.13.4.1" class="ltx_text ltx_font_bold">0.070</span></td></tr>
</tbody>
</table>
</span></div>
</figure>
