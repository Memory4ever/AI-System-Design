<tr id="S6.T5.5.1.3" class="ltx_tr">
<th id="S6.T5.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" rowspan="6"><span id="S6.T5.5.1.3.1.1" class="ltx_text">
<span id="S6.T5.5.1.3.1.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:6.9pt;height:56.1pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="width:56.1pt;transform:translate(-24.6pt,-24.6pt) rotate(-90deg) ;">
