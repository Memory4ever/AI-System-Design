<td id="S3.T2.5.4.6" class="ltx_td ltx_align_center">73</td></tr>
<tr id="S3.T2.5.5" class="ltx_tr">
<td id="S3.T2.5.5.1" class="ltx_td ltx_align_left">Two Robots Stack Cube</td>
<td id="S3.T2.5.5.2" class="ltx_td ltx_align_center"><span id="S3.T2.5.5.2.1" class="ltx_text ltx_font_bold">44</span></td>
