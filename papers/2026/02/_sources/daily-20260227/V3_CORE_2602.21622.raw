<td id="S3.T1.5.8.9" class="ltx_td ltx_align_center"><span id="S3.T1.5.8.9.1" class="ltx_text ltx_font_bold">42</span></td></tr>
<tr id="S3.T1.5.9" class="ltx_tr">
