<th id="S3.T1.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S3.T1.5.1.1.2.1" class="ltx_text ltx_font_bold">Vanilla Agent</span></th>
<th id="S3.T1.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S3.T1.5.1.1.3.1" class="ltx_text ltx_font_bold">Instance-level Mem</span></th>
