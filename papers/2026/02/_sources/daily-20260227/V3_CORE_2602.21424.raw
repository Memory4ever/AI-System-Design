<th id="A2.T2.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="A2.T2.5.1.2.1" class="ltx_text ltx_font_bold">Final Behavioural Distance <math id="A2.T2.m6" class="ltx_Math" alttext="d(\pi)" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">d(\pi)</annotation></semantics></math></span></th>
