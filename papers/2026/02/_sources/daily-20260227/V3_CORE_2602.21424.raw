<td id="A2.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A2.T3.m11" class="ltx_Math" alttext="1.350\pm 0.171" display="inline" intent=":literal"><semantics><mrow><mn>1.350</mn><mo>±</mo><mn>0.171</mn></mrow><annotation encoding="application/x-tex">1.350\pm 0.171</annotation></semantics></math></td>
