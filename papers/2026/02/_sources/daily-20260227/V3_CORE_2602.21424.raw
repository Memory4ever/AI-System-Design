<td id="A2.T2.5.4.2" class="ltx_td ltx_align_center"><math id="A2.T2.m15" class="ltx_Math" alttext="1.853\pm 0.039" display="inline" intent=":literal"><semantics><mrow><mn>1.853</mn><mo>±</mo><mn>0.039</mn></mrow><annotation encoding="application/x-tex">1.853\pm 0.039</annotation></semantics></math></td>
<td id="A2.T2.5.4.3" class="ltx_td ltx_align_center"><math id="A2.T2.m16" class="ltx_Math" alttext="2.582\pm 0.153" display="inline" intent=":literal"><semantics><mrow><mn>2.582</mn><mo>±</mo><mn>0.153</mn></mrow><annotation encoding="application/x-tex">2.582\pm 0.153</annotation></semantics></math></td></tr>
