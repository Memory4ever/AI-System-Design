<span id="S4.T3.5.12.4.1.1" class="ltx_p ltx_align_right"><span id="S4.T3.5.12.4.1.1.1" class="ltx_text" style="font-size:80%;">3.54x</span></span>
</span></td>
<td id="S4.T3.5.12.5" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;">
<span id="S4.T3.5.12.5.1" class="ltx_inline-block ltx_align_top" style="--ltx-bg-color:#F2F2F2;">
<span id="S4.T3.5.12.5.1.1" class="ltx_p ltx_align_right"><span id="S4.T3.5.12.5.1.1.1" class="ltx_text" style="font-size:80%;">3.06x</span></span>
</span></td>
<td id="S4.T3.5.12.6" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;">
