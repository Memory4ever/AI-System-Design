</span></td></tr>
<tr id="S4.T3.5.12" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="S4.T3.5.12.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T3.5.12.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F2F2F2;">GLM-5</span></td>
<td id="S4.T3.5.12.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:2.5pt;padding-right:2.5pt;">
