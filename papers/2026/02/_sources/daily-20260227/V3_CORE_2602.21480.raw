<td id="A5.T5.5.2.4" class="ltx_td ltx_align_center ltx_border_t">0.6507 <math id="A5.T5.m4" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.5318</td>
