<th id="A5.T5.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A5.T5.5.1.4.1" class="ltx_text ltx_font_bold">VES</span></th>
<th id="A5.T5.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A5.T5.5.1.5.1" class="ltx_text ltx_font_bold">VES*</span></th>
<th id="A5.T5.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A5.T5.5.1.6.1" class="ltx_text ltx_font_bold">VCES</span></th>
