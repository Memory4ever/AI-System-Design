plication/x-tex">\scriptstyle\hat{e}_{\ell,Val}+T</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 207.21 246.64)"><foreignObject style="--ltx-fo-width:2.11em;--ltx-fo-height:0.53em;--ltx-fo-depth:0.2em;font-size:10pt;" height="10.21" overflow="visible" transform="matrix(1 0 0 -1 0 7.39)" width="29.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m3" class="ltx_Math" alttext="\scriptstyle e^{\star}_{\ell,Val}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.700em">e</mi><mrow><mi mathsize="0.710em" mathvariant="normal">ℓ</mi><mo mathsize="0.710em">,</mo><mrow><mi mathsize="0.710em">V</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.710em">l</mi></mrow></mrow><mo mathsize="0.710em">⋆</mo></msubsup><annotation encoding="application/x-tex">\scriptstyle e^{\star}_{\ell,Val}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 272.35 247.42)"><foreignObject style="--ltx-fo-width:0.63em;--ltx-fo-height:0.48em;--ltx-fo-depth:0em;font-size:10pt;" height="6.62" overflow="visible" transform="matrix(1 0 0 -1 0 6.62)" width="8.66"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m4" class="ltx_Math" alttext="\scriptstyle E" display="inline" intent=":literal"><semantics><mi mathsize="0.700em">E</mi><annotation encoding="application/x-tex">\scriptstyle E</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -23.92 307.67)"><foreignObject style="--ltx-fo-wi