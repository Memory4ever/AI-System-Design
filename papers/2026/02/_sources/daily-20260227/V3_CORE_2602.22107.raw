41 L 4.57 219.39 L 4.33 263.5 L 3.9 296.02 L 3.47 328.54 L 2.89 346.81 L 2.29 346.81 L 1.68 346.81 L 1.1 328.54 L 0.67 296.02 L 0.24 263.5 L 0 219.39 L 0 173.41 L 0 127.42 L 0.24 83.31 L 0.67 50.79 L 1.1 18.27 L 1.68 0 L 2.29 0 L 2.29 0"></path></g><g></g><path style="fill:none" d="M 38.87 392.59"></path><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.9" stroke="#999999" stroke-width="0.4pt"><path d="M 109.56 401.65 L 44.55 401.65 C 41.49 401.65 39.01 399.17 39.01 396.11 L 39.01 398.26 C 39.01 395.21 41.49 392.73 44.55 392.73 L 109.56 392.73 C 112.62 392.73 115.09 395.21 115.09 398.26 L 115.09 396.11 C 115.09 399.17 112.62 401.65 109.56 401.65 Z M 39.01 392.73"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.9" stroke="#000000" stroke-width="0.4pt" transform="matrix(0.5 0.0 0.0 0.5 40.39 395.46)"><foreignObject style="--ltx-fo-width:10.6em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="146.64"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.1" class="ltx_text" style="--ltx-fg-color:#000000;">early-stopping selection </span></span></span></foreignObject></g><g></g><path style="fill:none" d="M 217.23 315.88"></path><g style="--ltx-stroke-color:#999999;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.9" stroke="#999999" stroke-width="0.4pt"><path d="M 211.55 315.74 L 129.26 315.74 C 126.21 315.74 123.73 313.26 123.73 310.21 L 123.73 312.36 C 123.73 309.3 126.21 306.83 129.26 306.83 L 211.55 306.83 C 214.61 306.83 217.09 309.3 217.09 312.36 L 217.09 310.21 C 217.09 313.26 214.61 315.74 211.55 315.74 Z M 123.73 306.83"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="0.9" stroke="#000000" stroke-width="0.4pt" transform="matrix(0.5 0.0 0.0 0.5 125.11 309.55)"><foreignObject style="--ltx-fo-width:13.09em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="181.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.2" class="ltx_text" style="--ltx-fg-color:#000000;">post-hoc checkpoint selection </span></span></span></foreignObject></g><g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 84.6 276.8 L 120.55 276.8"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(1.0 0.0 0.0 1.0 120.55 276.8)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g></g><g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000"><path style="fill:none" d="M 121.19 276.8 L 85.24 276.8"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="round" stroke-width="0.32pt" transform="matrix(-1.0 0.0 0.0 -1.0 85.24 276.8)"><path style="fill:none" d="M -1.66 2.21 C -1.52 1.38 0 0.14 0.42 0 C 0 -0.14 -1.52 -1.38 -1.66 -2.21"></path></g></g><g></g><path style="fill:none" d="M 102.9 273"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 89.13 265.75)"><foreignObject style="--ltx-fo-width:3.95em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="54.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m8" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math><span id="S3.F2.pic1.3" class="ltx_text" style="--ltx-fg-color:#000000;"> epochs</span></span></span></foreignObject></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 117.6 221.51)"><foreignObject style="--ltx-fo-width:3.49em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="48.34"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m9" class="ltx_Math" alttext="\displaystyle\text{epoch}\ e" display="inline" intent=":literal"><semantics><mrow><mtext>epoch</mtext><mo lspace="0.500em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">\displaystyle\text{epoch}\ e</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -36.88 350.92)"><foreignObject style="--ltx-fo-width:3.76em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="51.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m10" class="ltx_Math" alttext="\displaystyle\ell({Val},e)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ell({Val},e)</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.8" stroke="#CCCCCC" stroke-opacity="1"><path d="M 180.46 460.71 h 90.55 v 23.52 h -90.55 Z"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.8" stroke="#CCCCCC" stroke-opacity="1" transform="matrix(1.0 0.0 0.0 1.0 184.61 472.47)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 17.98)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.99)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.6pt" transform="matrix(1 0 0 -1 0 0) translate(0.42,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.45 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -4.15)"><foreignObject style="--ltx-fo-width:3.76em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="51.98"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F2.pic1.m11" class="ltx_Math" alttext="\ell(Val,e)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(Val,e)</annotation></semantics></math></span></span></foreignObject></g></g></g></g></g></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F2.5" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S3.F2.6" class="ltx_text" style="font-size:90%;">An example comparing <em id="S3.F2.6.1" class="ltx_emph ltx_font_italic">early stopping with patience <math id="S3.F2.m6" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> and <em id="S3.F2.6.2" class="ltx_emph ltx_font_italic">post-hoc checkpoint selection</em> on the validation loss <math id="S3.F2.m7" class="ltx_Math" alttext="\ell(\mathrm{Val},e)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>Val</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(\mathrm{Val},e)</annotation></semantics></math>. The orange dashed line marks the performance value returned by early stopping (best-so-far at <math id="S3.F2.m8" class="ltx_Math" alttext="\hat{e}_{\ell,\mathrm{Val}}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>e</mi><mo mathsize="1.110em">^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>Val</mi></mrow></msub><annotation encoding="application/x-tex">\hat{e}_{\ell,\mathrm{Val}}</annotation></semantics></math>, with training halted at <math id="S3.F2.m9" class="ltx_Math" alttext="\hat{e}_{\ell,\mathrm{Val}}+T" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>e</mi><mo mathsize="1.110em">^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>Val</mi></mrow></msub><mo>+</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\hat{e}_{\ell,\mathrm{Val}}+T</annotation></semantics></math>), whereas the blue dashed line marks the best validation performance value <math id="S3.F2.m10" class="ltx_Math" alttext="e^{\star}_{\ell,\mathrm{Val}}" display="inline" intent=":literal"><semantics><msubsup><mi>e</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>Val</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">e^{\star}_{\ell,\mathrm{Val}}</annotation></semantics></math> identified retrospectively. It is evident that the early-stopped checkpoint need not be the best-performing model: it corresponds to a local minimum reached before halting, whereas post-hoc checkpoint selection identifies the global minimum over all epochs.</span></figcaption>
</figure>
<div id="S3.SS2.p3" class="ltx_para">
<p id="S3.SS2.p3.1" class="ltx_p">Note that when <math id="S3.SS2.p3.m1" class="ltx_Math" alttext="T=E" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mi>E</mi></mrow><annotation encoding="application/x-tex">T=E</annotation></semantics></math>, i.e., when the patience parameter equals the total number of epochs,
<em id="S3.SS2.p3.1.1" class="ltx_emph ltx_font_italic">early stopping with patience <math id="S3.SS2.p3.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em> results in no early termination and is therefore equivalent to post-hoc checkpoint selection.</p>
</div>
</section>
<section id="S3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.3 </span>Statistical Comparison of Model Selection Criteria</h3>

<div id="S3.SS3.p1" class="ltx_para">
<p id="S3.SS3.p1.1" class="ltx_p">To assess the effect of different model selection criteria on generalization performance, we performed a systematic evaluation comparing the test accuracy <math id="S3.SS3.p1.m1" class="ltx_Math" alttext="A_{test}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">A_{test}</annotation></semantics></math> of models selected in both early stopping and post-hoc protocols, against the best achievable test accuracy observed throughout training. Our empirical analysis focused on supervised classification tasks, where models were trained using the CE loss and evaluated in terms of accuracy.</p>
</div>
<div id="S3.SS3.p2" class="ltx_para">
<p id="S3.SS3.p2.1" class="ltx_p">Our goal was to quantify the extent to which accuracy obtained by validation-based selection, using either the minimum validation loss <math id="S3.SS3.p2.m1" class="ltx_Math" alttext="L^{\star}_{Val}" display="inline" intent=":literal"><semantics><msubsup><mi>L</mi><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">L^{\star}_{Val}</annotation></semantics></math> or the maximum validation accuracy <math id="S3.SS3.p2.m2" class="ltx_Math" alttext="A^{\star}_{Val}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">A^{\star}_{Val}</annotation></semantics></math>, deviated from the test-optimal accuracy <math id="S3.SS3.p2.m3" class="ltx_Math" alttext="A^{\star}_{Test}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">A^{\star}_{Test}</annotation></semantics></math>, defined as the model instance that attained the highest test accuracy <math id="S3.SS3.p2.m4" class="ltx_Math" alttext="A_{Test}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">A_{Test}</annotation></semantics></math> across all training epochs.</p>
</div>
<div id="S3.SS3.p3" class="ltx_para">
<p id="S3.SS3.p3.1" class="ltx_p">In other words, we want to check how much <math id="S3.SS3.p3.m1" class="ltx_Math" alttext="A^{\star}_{Test}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">A^{\star}_{Test}</annotation></semantics></math> differs from <math id="S3.SS3.p3.m2" class="ltx_Math" alttext="\mathcal{a}({Test},e^{\star}_{\ell,Val})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msubsup><mi>e</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}({Test},e^{\star}_{\ell,Val})</annotation></semantics></math> and <math id="S3.SS3.p3.m3" class="ltx_Math" alttext="\mathcal{a}({Test},e^{\star}_{\mathcal{a},Val})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msubsup><mi>e</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo>⋆</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}({Test},e^{\star}_{\mathcal{a},Val})</annotation></semantics></math>, and similarly, <math id="S3.SS3.p3.m4" class="ltx_Math" alttext="\mathcal{a}({Test},\hat{e}_{\ell,Val})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}({Test},\hat{e}_{\ell,Val})</annotation></semantics></math> and <math id="S3.SS3.p3.m5" class="ltx_Math" alttext="\mathcal{a}({Test},\hat{e}_{\mathcal{a},Val})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}({Test},\hat{e}_{\mathcal{a},Val})</annotation></semantics></math> (see Figure <a href="#S4.F3" title="Figure 3 ‣ 4.4 Training and Evaluation Protocol ‣ 4 Experimental assessment ‣ Don’t stop me now: Rethinking Validation Criteria for Model Parameter Selection" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> for a visual summary).</p>
</div>
</section>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4 </span>Experimental assessment</h2>

<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1 </span>Datasets</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">Experiments were conducted on multiple benchmark datasets retrieved from the UCI Machine Learning Repository <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Asuncion et al., 2007</a>)</cite>.
The list of the datasets involved in this work is shown in Table <a href="#S4.T1" title="Table 1 ‣ 4.1 Datasets ‣ 4 Experimental assessment ‣ Don’t stop me now: Rethinking Validation Criteria for Model Parameter Selection" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p">All datasets were preprocessed using a unified and dataset-agnostic pipeline in order to ensure comparability across experiments.
Specifically, categorical and binary features were transformed via one-hot encoding, while numerical features were kept in their original form. No dataset-specific feature engineering or optimization was performed. We emphasize that the goal of this preprocessing was not to optimize performance on the individual datasets to reach new state-of-the-art results, but rather to provide a simple and reproducible input representation suitable for large-scale comparative analysis.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">Moreover, in the analysis of the results, we explicitly account for differences in dataset complexity by ordering datasets according to increasing linear separability between classes, as estimated by the generalized discrimination value (GDV) <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib47" title="" class="ltx_ref">Schilling et al., 2021</a>)</cite>. This allows us to assess how model selection behavior varies with dataset simplicity.</p>
</div>
<figure id="S4.T1" class="ltx_table">
<div id="S4.T1.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:497.9pt;height:227.7pt;vertical-align:-112.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-106.7pt,48.8pt) scale(0.7,0.7) ;">
<table id="S4.T1.3.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S4.T1.3.1.1" class="ltx_tr">
<th id="S4.T1.3.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.3.1.1.1.1" class="ltx_text ltx_font_bold">Name</span></th>
<th id="S4.T1.3.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.3.1.1.2.1" class="ltx_text ltx_font_bold">Instances</span></th>
<th id="S4.T1.3.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_tt"><span id="S4.T1.3.1.1.3.1" class="ltx_text ltx_font_bold">N. classes</span></th>
