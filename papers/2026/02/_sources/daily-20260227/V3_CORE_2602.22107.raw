t="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="5.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.1" class="ltx_text" style="--ltx-fg-color:#000000;">(<math id="S3.F1.pic1.m9" class="ltx_Math" alttext="e^{\star}_{\mathcal{a},D},\ A_{D}^{\star})" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" fence="true" mathcolor="#000000" rspace="0em">OPEN</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">𝒶</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋆</mo></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.667em">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">A</mi><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">D</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋆</mo></msubsup></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">e^{\star}_{\mathcal{a},D},\ A_{D}^{\star})</annotation></semantics></math></span></span></span></foreignObject></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 120.64 43.62)"><foreignObject style="--ltx-fo-width:2.8em;--ltx-fo-height:0.49em;--ltx-fo-depth:0.14em;font-size:10pt;" height="8.61" overflow="visible" transform="matrix(1 0 0 -1 0 6.73)" width="38.8"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m10" class="ltx_Math" alttext="\scriptsize\text{epoch}\ e" display="inline" intent=":literal"><semantics><mrow><mtext mathsize="0.700em">epoch</mtext><mo lspace="0.410em" rspace="0em">​</mo><mi mathsize="0.700em">e</mi></mrow><annotation encoding="application/x-tex">\scriptsize\text{epoch}\ e</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.0 1.0 -1.0 0.0 -35.16 180.73)"><foreignObject style="--ltx-fo-width:2.34em;--ltx-fo-height:0.68em;--ltx-fo-depth:0em;font-size:10pt;" height="9.46" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="32.33"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.2" class="ltx_text">Score</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.8" stroke="#CCCCCC" stroke-opacity="1"><path d="M 13.49 260.46 h 80.68 v 41.51 h -80.68 Z"></path></g><g style="--ltx-stroke-color:#CCCCCC;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="0.8" stroke="#CCCCCC" stroke-opacity="1" transform="matrix(1.0 0.0 0.0 1.0 17.65 272.23)"><g class="ltx_tikzmatrix" transform="matrix(1 0 0 -1 0 35.97)"><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 8.99)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.6pt" transform="matrix(1 0 0 -1 0 0) translate(0.42,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.45 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -4.15)"><foreignObject style="--ltx-fo-width:2.96em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="40.96"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m11" class="ltx_Math" alttext="\ell(D,e)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(D,e)</annotation></semantics></math></span></span></foreignObject></g></g><g class="ltx_tikzmatrix_row" transform="matrix(1 0 0 1 0 26.98)"><g style="--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke-width="0.6pt" transform="matrix(1 0 0 -1 0 0) translate(0.42,0)"><path style="fill:none" d="M 0 0 L 11.81 0 L 23.62 0"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_tikzmatrix_col ltx_nopad_l ltx_nopad_r" fill="#000000" stroke="#000000" transform="matrix(1 0 0 -1 24.45 0) translate(-0.28,0) matrix(1.0 0.0 0.0 1.0 3.04 -4.15)"><foreignObject style="--ltx-fo-width:3.04em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="42.11"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m12" class="ltx_Math" alttext="\mathcal{a}(D,e)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}(D,e)</annotation></semantics></math></span></span></foreignObject></g></g></g></g></g></g></g></svg></span><span class="ltx_inline-block"><svg id="S3.F1.pic2" class="ltx_picture ltx_centering" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"></g></svg></span>
</div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F1.4" class="ltx_text" style="font-size:90%;">Figure 1</span>: </span><span id="S3.F1.5" class="ltx_text" style="font-size:90%;">An example of loss <math id="S3.F1.m9" class="ltx_Math" alttext="\ell(D,e)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell(D,e)</annotation></semantics></math> and accuracy <math id="S3.F1.m10" class="ltx_Math" alttext="\mathcal{a}(D,e)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{a}(D,e)</annotation></semantics></math> across <math id="S3.F1.m11" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> epochs on a dataset <math id="S3.F1.m12" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>. Vertical dashed lines mark the epochs achieving the validation-loss minimum <math id="S3.F1.m13" class="ltx_Math" alttext="e^{\star}_{\ell,D}" display="inline" intent=":literal"><semantics><msubsup><mi>e</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mi>D</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">e^{\star}_{\ell,D}</annotation></semantics></math> and the validation-accuracy maximum <math id="S3.F1.m14" class="ltx_Math" alttext="e^{\star}_{\mathcal{a},D}" display="inline" intent=":literal"><semantics><msubsup><mi>e</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>,</mo><mi>D</mi></mrow><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">e^{\star}_{\mathcal{a},D}</annotation></semantics></math>; horizontal dotted lines indicate the corresponding values <math id="S3.F1.m15" class="ltx_Math" alttext="L_{D}^{\star}=\min_{e}\ell(D,e)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>L</mi><mi>D</mi><mo>⋆</mo></msubsup><mo>=</mo><mrow><msub><mi>min</mi><mi>e</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">L_{D}^{\star}=\min_{e}\ell(D,e)</annotation></semantics></math> (blue) and <math id="S3.F1.m16" class="ltx_Math" alttext="A_{D}^{\star}=\max_{e}\mathcal{a}(D,e)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>A</mi><mi>D</mi><mo>⋆</mo></msubsup><mo>=</mo><mrow><msub><mi>max</mi><mi>e</mi></msub><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒶</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">A_{D}^{\star}=\max_{e}\mathcal{a}(D,e)</annotation></semantics></math> (orange).</span></figcaption>
</figure>
</section>
<section id="S3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">3.2 </span>Post-hoc Checkpoint Selection versus Early Stopping</h3>

<div id="S3.SS2.p1" class="ltx_para">
<p id="S3.SS2.p1.1" class="ltx_p">We can distinguish between two validation-driven protocols that are often not clearly distinguished in the literature: (i) during training, a validation-based criterion is monitored and, once it fails, training is halted and the best checkpoint seen so far is retained. This is usually known as <span id="S3.SS2.p1.1.1" class="ltx_text ltx_font_italic">early stopping</span>; (ii) training proceeds for a fixed number of epochs, after which the checkpoint with the best validation score among all saved models is selected. Here we refer to this as <span id="S3.SS2.p1.1.2" class="ltx_text ltx_font_italic">post-hoc checkpoint selection</span>.
Within an early stopping protocol, training is terminated according to a predefined empirical criterion. A commonly adopted strategy is <em id="S3.SS2.p1.1.3" class="ltx_emph ltx_font_italic">early stopping with patience <math id="S3.SS2.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></em>, whereby training halts at the first epoch such that no improvement in the validation loss has been observed for <math id="S3.SS2.p1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> consecutive epochs.
Formally, this condition is expressed as</p>
<table id="S3.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S3.Ex6.m1" class="ltx_Math" alttext="\exists\hat{e}_{\ell,Val}:\forall h\in\{1,2,\dots,T\},\quad\ell({Val},\hat{e}_{\ell,Val}+h)\geq\ell({Val},\hat{e}_{\ell,Val})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo rspace="0.167em">∃</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>h</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><mrow><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub><mo>+</mo><mi>h</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\exists\hat{e}_{\ell,Val}:\forall h\in\{1,2,\dots,T\},\quad\ell({Val},\hat{e}_{\ell,Val}+h)\geq\ell({Val},\hat{e}_{\ell,Val}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S3.SS2.p1.2" class="ltx_p">The selected model corresponds to the model with loss <math id="S3.SS2.p1.m3" class="ltx_Math" alttext="\hat{L}_{Val}=\ell(Val,\hat{e}_{\ell,Val})" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>L</mi><mo>^</mo></mover><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><mo>=</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><msub><mover accent="true"><mi>e</mi><mo>^</mo></mover><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{L}_{Val}=\ell(Val,\hat{e}_{\ell,Val})</annotation></semantics></math>.</p>
</div>
<div id="S3.SS2.p2" class="ltx_para">
<p id="S3.SS2.p2.1" class="ltx_p">Instead, in <em id="S3.SS2.p2.1.1" class="ltx_emph ltx_font_italic">post-hoc checkpoint selection</em> the training proceeds for all the fixed <math id="S3.SS2.p2.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> epochs and the model is selected retrospectively as the one at iteration <math id="S3.SS2.p2.m2" class="ltx_Math" alttext="e^{\star}_{\ell,{Val}}=\arg\min\limits_{1\leq e\leq E}\ell(Val,e)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>e</mi><mrow><mi mathvariant="normal">ℓ</mi><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></mrow><mo>⋆</mo></msubsup><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>min</mi><mrow><mn>1</mn><mo>≤</mo><mi>e</mi><mo>≤</mo><mi>E</mi></mrow></munder><mo lspace="0.167em">⁡</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">e^{\star}_{\ell,{Val}}=\arg\min\limits_{1\leq e\leq E}\ell(Val,e)</annotation></semantics></math>. Figure  <a href="#S3.F2" title="Figure 2 ‣ 3.2 Post-hoc Checkpoint Selection versus Early Stopping ‣ 3 Method ‣ Don’t stop me now: Rethinking Validation Criteria for Model Parameter Selection" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> depicts both procedures, i.e., post-hoc checkpoint selection and early stopping—highlighting.</p>
</div>
