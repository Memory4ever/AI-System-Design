66 -2.21"></path></g></g><g></g><path style="fill:none" d="M 107.47 122.14"></path><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(0.5 0.0 0.0 0.5 65.98 126.56)"><foreignObject style="--ltx-fo-width:5.64em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.29em;font-size:10pt;" height="14.34" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="78.1"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m4" class="ltx_Math" alttext="(e^{\star}_{\ell,Val},\ L^{\star}_{Val}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" stretchy="false">(</mo><mrow><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000" mathvariant="normal">ℓ</mi><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">,</mo><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></mrow></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋆</mo></msubsup><mo style="--ltx-fg-color:#000000;" mathcolor="#000000" rspace="0.667em">,</mo><msubsup><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">L</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">V</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi></mrow><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋆</mo></msubsup></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><annotation encoding="application/x-tex">(e^{\star}_{\ell,Val},\ L^{\star}_{Val}</annotation></semantics></math></span></span></foreignObject></g><g></g