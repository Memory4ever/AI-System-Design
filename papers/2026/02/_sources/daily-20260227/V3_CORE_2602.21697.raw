<td id="S7.T3.2.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.2.1.2.1" class="ltx_text ltx_font_bold">Accuracy (%)</span></td>
<td id="S7.T3.2.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T3.2.1.3.1" class="ltx_text ltx_font_bold">Precision (%)</span></td>
