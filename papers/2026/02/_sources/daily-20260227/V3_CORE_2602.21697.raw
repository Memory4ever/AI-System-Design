</span></span></td>
<td id="S7.T5.4.1.1.5" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S7.T5.4.1.1.5.1" class="ltx_text" style="font-size:90%;">
<span id="S7.T5.4.1.1.5.1.1" class="ltx_tabular ltx_align_middle">
<span id="S7.T5.4.1.1.5.1.1.1" class="ltx_tr">
<span id="S7.T5.4.1.1.5.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S7.T5.4.1.1.5.1.1.1.1.1" class="ltx_text ltx_font_bold">Rec.</span></span></span>
<span id="S7.T5.4.1.1.5.1.1.2" class="ltx_tr">
<span id="S7.T5.4.1.1.5.1.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S7.T5.4.1.1.5.1.1.2.1.1" class="ltx_text ltx_font_bold">(%)</span></span></span>
</span></span></td>
<td id="S7.T5.4.1.1.6" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S7.T5.4.1.1.6.1" class="ltx_text" style="font-size:90%;">
<span id="S7.T5.4.1.1.6.1.1" class="ltx_tabular ltx_align_middle">
<span id="S7.T5.4.1.1.6.1.1.1" class="ltx_tr">
<span id="S7.T5.4.1.1.6.1.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><math id="S7.T5.m1" class="ltx_Math" alttext="\text{F}_{0.5}" display="inline" intent=":literal"><semantics><msub><mtext class="ltx_mathvariant_bold">F</mtext><mn>0.5</mn></msub><annotation encoding="application/x-tex">\text{F}_{0.5}</annotation></semantics></math></span></span>
