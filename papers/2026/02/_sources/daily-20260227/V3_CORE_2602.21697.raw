<td id="S7.T5.4.1.1.2" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S7.T5.4.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Config</span></td>
<td id="S7.T5.4.1.1.3" class="ltx_td ltx_align_center ltx_border_t" colspan="4"><span id="S7.T5.4.1.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Flow categories (%)</span></td>
