<figure id="S3.T6" class="ltx_table">
<div id="S3.T6.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:397.5pt;height:52.4pt;vertical-align:-24.1pt;"><span class="ltx_transformed_inner" style="transform:translate(-34.9pt,4.6pt) scale(0.850688593824135,0.850688593824135) ;">
