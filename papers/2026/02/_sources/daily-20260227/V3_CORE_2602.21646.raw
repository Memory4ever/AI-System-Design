<tr id="S3.T3.2.1.21" class="ltx_tr">
<th id="S3.T3.2.1.21.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding:1pt 3.0pt;">SMT-9B</th>
<td id="S3.T3.2.1.21.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.0pt;"><span id="S3.T3.2.1.21.2.1" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">47.0</span>/<span id="S3.T3.2.1.21.2.2" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">88.6</span></td>
<td id="S3.T3.2.1.21.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.0pt;"><span id="S3.T3.2.1.21.3.1" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">41.8</span>/<span id="S3.T3.2.1.21.3.2" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">88.1</span></td>
