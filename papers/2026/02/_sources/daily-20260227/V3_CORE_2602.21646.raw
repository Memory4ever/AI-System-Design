<td id="S3.T3.2.1.5.9" class="ltx_td ltx_align_center" style="padding:1pt 3.0pt;"><span id="S3.T3.2.1.5.9.1" class="ltx_text ltx_ulem_uline">35.9</span> / 89.1</td></tr>
