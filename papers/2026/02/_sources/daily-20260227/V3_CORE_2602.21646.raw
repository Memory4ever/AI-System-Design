<td id="S3.T3.2.1.21.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:1pt 3.0pt;"><span id="S3.T3.2.1.21.8.1" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">41.4</span> / <span id="S3.T3.2.1.21.8.2" class="ltx_text" style="--ltx-bg-color:#E3EDF6;">91.7</span></td>
