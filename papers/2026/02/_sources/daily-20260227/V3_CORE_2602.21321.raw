<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex51.m2" class="ltx_Math" alttext="\displaystyle\ \frac{4\beta^{2}q_{\max}}{\alpha q_{\min}^{2}\gamma}\|(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\|^{2}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}\gamma}\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{4\beta^{2}q_{\max}}{\alpha q_{\min}^{2}\gamma}\|(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\|^{2}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}\gamma}\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex52.m1" class="ltx_Math" alttext="\displaystyle~~~~+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle~~~~+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.2" class="ltx_p"><span id="A5.SS1.p4.2.1" class="ltx_text">where <math id="A5.SS1.p4.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> holds if the learning rate <math id="A5.SS1.p4.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> is sufficiently small such that <math id="A5.SS1.p4.m3" class="ltx_Math" alttext="\alpha\leq\frac{2q_{\max}}{3q_{\min}\gamma L}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha\leq\frac{2q_{\max}}{3q_{\min}\gamma L}</annotation></semantics></math>; <math id="A5.SS1.p4.m4" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is because and <math id="A5.SS1.p4.m5" class="ltx_Math" alttext="\beta\leq\frac{\gamma}{2q_{\max}},\alpha\leq\frac{q_{\max}}{q_{\min}^{2}\gamma L}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>β</mi><mo>≤</mo><mfrac><mi>γ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mrow><mo>,</mo><mrow><mi>α</mi><mo>≤</mo><mfrac><msub><mi>q</mi><mi>max</mi></msub><mrow><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mrow></mrow><annotation encoding="application/x-tex">\beta\leq\frac{\gamma}{2q_{\max}},\alpha\leq\frac{q_{\max}}{q_{\min}^{2}\gamma L}</annotation></semantics></math>; and <math id="A5.SS1.p4.m6" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> comes from the fact that the analog update is Lipschitz continuous (see Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (( , , Lemma 2)). ‣ Appendix A Notations and Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>).</span></p>
</div>
<div id="A5.SS1.p5" class="ltx_para ltx_noindent">
<p id="A5.SS1.p5.1" class="ltx_p"><span id="A5.SS1.p5.1.1" class="ltx_text">By inequality (<a href="#A5.E60" title="Equation 60 ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>), the two terms related to <math id="A5.SS1.p5.m1" class="ltx_Math" alttext="\left\|Q_{k+1}-Q_{k}\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left\|Q_{k+1}-Q_{k}\right\|^{2}</annotation></semantics></math> in the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of (<a href="#A5.E51" title="Equation 51 ‣ Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) is bounded by</span></p>
<table id="A5.EGx68" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E62"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E62.m1" class="ltx_Math" alttext="\displaystyle\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+L\gamma^{2}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+L\gamma^{2}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E62.m2" class="ltx_Math" alttext="\displaystyle\frac{3q_{\max}\gamma}{\alpha q_{\min}^{2}}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{3q_{\max}\gamma}{\alpha q_{\min}^{2}}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p5.2" class="ltx_p"><span id="A5.SS1.p5.2.1" class="ltx_text">where the last inequality holds when choosing stepsize <math id="A5.SS1.p5.m2" class="ltx_Math" alttext="\alpha\leq\frac{q_{\max}}{q_{\min}^{2}\gamma L}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mfrac><msub><mi>q</mi><mi>max</mi></msub><mrow><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha\leq\frac{q_{\max}}{q_{\min}^{2}\gamma L}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p6" class="ltx_para ltx_noindent">
<p id="A5.SS1.p6.1" class="ltx_p"><span id="A5.SS1.p6.1.1" class="ltx_text">With all the inequalities and lemmas above, we are ready to prove the main conclusion in Theorem <a href="#S3.Thmtheorem7" title="Theorem 3.7 (Convergence of Algorithm ). ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.7</span></a> now.
Define a Lyapunov function by</span></p>
<table id="A5.EGx69" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E63.m1" class="ltx_Math" alttext="\displaystyle V_{k}:=" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>k</mi></msub><mo>:=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle V_{k}:=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E63.m2" class="ltx_Math" alttext="\displaystyle\ f(\bar{W}_{k})-f^{*}+C_{1}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}+C_{2}(\varphi(P_{k})-\varphi^{*})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>φ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ f(\bar{W}_{k})-f^{*}+C_{1}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}+C_{2}(\varphi(P_{k})-\varphi^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p6.2" class="ltx_p"><span id="A5.SS1.p6.2.1" class="ltx_text">By Lemmas <a href="#A5.Thmtheorem1" title="Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a> and <a href="#A5.Thmtheorem2" title="Lemma E.2 (Descent lemma of upper-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>, we show that <math id="A5.SS1.p6.m1" class="ltx_Math" alttext="V_{k}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>k</mi></msub><annotation encoding="application/x-tex">V_{k}</annotation></semantics></math> has sufficient descent in expectation</span></p>
<table id="A5.EGx70" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E64.m2" class="ltx_math_unparsed" alttext="\displaystyle\ {\mathbb{E}}_{\xi_{k},b_{k},b_{k}^{\prime}]}[V_{k+1}]={\mathbb{E}}_{\xi_{k},b_{k},b_{k}^{\prime}}\left[f(\bar{W}_{k+1})-f^{*}+C_{1}\|P^{*}(W_{k+1},Q_{k+1})-Q_{k+1}\|^{2}+C_{2}(\varphi(P_{k+1})-\varphi^{*})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><mi>ξ</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>b</mi><msub><mrow></mrow><mi>k</mi></msub><mo>,</mo><mi>b</mi><msub><mrow></mrow><mi>k</mi></msub><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">]</mo></mrow></msub><mrow><mo stretchy="false">[</mo><msub><mi>V</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub><mo>,</mo><msubsup><mi>b</mi><mi>k</mi><mo>′</mo></msubsup></mrow></msub><mrow><mo>[</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>+</mo><msub><mi>C</mi><mn>1</mn></msub><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><msup><mo lspace="0em" rspace="0em">∥</mo><mn>2</mn></msup><mo lspace="0em">+</mo><msub><mi>C</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mi>φ</mi><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msup><mi>φ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow></mrow><annotation