<p id="A5.SS3.p3.2" class="ltx_p"><span id="A5.SS3.p3.2.1" class="ltx_text">where <math id="A5.SS3.p3.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> leverages <math id="A5.SS3.p3.m2" class="ltx_Math" alttext="2\left\langle U,V\right\rangle=\|U\|^{2}-\|V\|^{2}-\|U-V\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mo>⟩</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mi>V</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>U</mi><mo>−</mo><mi>V</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">2\left\langle U,V\right\rangle=\|U\|^{2}-\|V\|^{2}-\|U-V\|^{2}</annotation></semantics></math> for any <math id="A5.SS3.p3.m3" class="ltx_Math" alttext="U,V\in{\mathbb{R}}^{D}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">U,V\in{\mathbb{R}}^{D}</annotation></semantics></math>, <math id="A5.SS3.p3.m4" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> is achieved by</span></p>
