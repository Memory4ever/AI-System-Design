<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex131.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})-\bigl((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\bigr)\Bigr\|^{2}_{M_{w}(W_{k})^{\dagger}}." display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><msubsup><mo lspace="0em" mathsize="1.600em" rspace="0.0835em">∥</mo><mrow><msub><mi>M</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\quad-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})-\bigl((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\bigr)\Bigr\|^{2}_{M_{w}(W_{k})^{\dagger}}.</annotation></semantics></math></td>
