m" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\beta}{2}\|(P^{*}(W_{k},Q_{k})-Q_{k})\odot\sqrt{F_{w}(W_{k})}\|^{2}+\frac{\beta}{2}\left\||P^{*}(W_{k},Q_{k})-Q_{k}|\odot\frac{G_{w}(W_{k})}{\sqrt{F_{w}(W_{k})}}\right\|^{2}</annotation></semantics></math></td>
