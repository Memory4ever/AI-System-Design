><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><mi>k</mi></msub><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{1}{2\alpha}\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|\frac{P_{k+1}-P_{k}}{\sqrt{F_{p}(P_{k})}}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot\sqrt{F_{p}(P_{k})}-\frac{b_{k}}{\sqrt{F_{p}(P_{k})}}\right\|^{2}\right]</annotation></semantics></math></td>
