<td id="S3.T1.2.13.3" class="ltx_td ltx_align_center ltx_border_b" style="padding:0.25pt 3.5pt;"><span id="S3.T1.2.13.3.1" class="ltx_text ltx_font_bold">91.76<math id="S3.T1.m68" class="ltx_Math" alttext="\pm 0.4" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.4</mn></mrow><annotation encoding="application/x-tex">\pm 0.4</annotation></semantics></math></span></td>
