<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex116.m1" class="ltx_Math" alttext="\displaystyle=-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
