<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex62.m1" class="ltx_Math" alttext="\displaystyle\ +(3+C_{2})\alpha^{2}Lq_{\max}^{2}\sigma^{2}-\left(\frac{\beta q_{\min}^{2}}{2\gamma q_{\max}}C_{1}-\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right)\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +(3+C_{2})\alpha^{2}Lq_{\max}^{2}\sigma^{2}-\left(\frac{\beta q_{\min}^{2}}{2\gamma q_{\max}}C_{1}-\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right)\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex63.m1" class="ltx_Math" alttext="\displaystyle\ -\left(\frac{\beta}{2\gamma q_{\max}}C_{1}-\frac{4\beta^{2}q_{\max}}{\alpha q_{\min}^{2}}\right)\left\|(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\right\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\left(\frac{\beta}{2\gamma q_{\max}}C_{1}-\frac{4\beta^{2}q_{\max}}{\alpha q_{\min}^{2}}\right)\left\|(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\right\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex64.m1" class="ltx_Math" alttext="\displaystyle\ +\left(\frac{3\beta q_{\max}^{3}}{\gamma q_{\min}^{2}}C_{1}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +\left(\frac{3\beta q_{\max}^{3}}{\gamma q_{\min}^{2}}C_{1}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex65.m1" class="ltx_Math" alttext="\displaystyle\ -\left(\frac{1}{2\alpha q_{\max}}-3\gamma^{2}L-C_{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\left(\frac{1}{2\alpha q_{\max}}-3\gamma^{2}L-C_{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p7" class="ltx_para ltx_noindent">
<p id="A5.SS1.p7.1" class="ltx_p">The first inequality holds for:</p>
<table id="A5.EGx71" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex66.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex66.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{\xi_{k}}\left[\|-\eta(P_{k+1}-Q_{k})\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mo>−</mo><mrow><mi>η</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{\xi_{k}}\left[\|-\eta(P_{k+1}-Q_{k})\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E65.m1" class="ltx_Math" alttext="\displaystyle\leq 2\eta^{2}\mathbb{E}_{\xi_{k}}\left[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}+\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>+</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\eta^{2}\mathbb{E}_{\xi_{k}}\left[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}+\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p7.2" class="ltx_p">and the learning rate <math id="A5.SS1.p7.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is sufficiently small such that <math id="A5.SS1.p7.m2" class="ltx_Math" alttext="\frac{2\beta^{2}}{\gamma^{2}}\leq\frac{\beta q_{\max}^{3}}{\gamma q_{\min}^{2}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup></mrow><msup><mi>γ</mi><mn>2</mn></msup></mfrac><mo>≤</mo><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\frac{2\beta^{2}}{\gamma^{2}}\leq\frac{\beta q_{\max}^{3}}{\gamma q_{\min}^{2}}</annotation></semantics></math>.
Let <math id="A5.SS1.p7.m3" class="ltx_Math" alttext="C_{1}=\frac{10\beta\gamma q_{\max}^{2}}{\alpha q_{\min}^{2}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mn>1</mn></msub><mo>=</mo><mfrac><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">C_{1}=\frac{10\beta\gamma q_{\max}^{2}}{\alpha q_{\min}^{2}}</annotation></semantics></math>, which leads to the positive coefficient in front of <math id="A5.SS1.p7.m4" class="ltx_Math" alttext="\left\|P^{*}(W_{k},Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})|\odot G_{w}(W_{k})\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left\|P^{*}(W_{k},Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})|\odot G_{w}(W_{k})\right\|^{2}</annotation></semantics></math>. Let <math id="A5.SS1.p7.m5" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> large enough, which leads to the positive coefficient in front of <math id="A5.SS1.p7.m6" class="ltx_Math" alttext="\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]</annotation></semantics></math>.</p>
<table id="A5.EGx72" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E66"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E66.m1" class="ltx_Math" alttext="\displaystyle{\mathbb{E}}_{\xi_{k},b_{k}}[V_{k+1}]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>V</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle{\mathbb{E}}_{\xi_{k},b_{k}}[V_{k+1}]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E66.m2" class="ltx_Math" alttext="\displaystyle\ V_{k}-\left(\frac{\alpha q_{\min}^{2}}{8q_{\max}}-\frac{C_{2}\alpha q_{\max}^{2}}{2C_{\star}}\right)\|\nabla f(\bar{W}_{k})\|^{2}-\left(\frac{\alpha C_{2}C_{\star}}{2}-\frac{\alpha\sigma^{2}}{2q_{\min}}\right)\|G_{p}(P_{k})\|^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>V</mi><mi>k</mi></msub><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⋆</mo></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mo>⋆</mo></msub></mrow><mn>2</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ V_{k}-\left(\frac{\alpha q_{\min}^{2}}{8q_{\max}}-\frac{C_{2}\alpha q_{\max}^{2}}{2C_{\star}}\right)\|\nabla f(\bar{W}_{k})\|^{2}-\left(\frac{\alpha C_{2}C_{\star}}{2}-\frac{\alpha\sigma^{2}}{2q_{\min}}\right)\|G_{p}(P_{k})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
<tbody id="A5.Ex67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex67.m1" class="ltx_Math" alttext="\displaystyle\ +\left(\frac{30\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>5</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>4</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +\left(\frac{30\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex68.m1" class="ltx_Math" alttext="\displaystyle\ -\left(\frac{\beta q_{\min}^{2}}{2\gamma q_{\max}}C_{1}-\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right)\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}+(3+C_{2})\alpha^{2}Lq_{\max}^{2}\sigma^{2}+{\Theta}(\Delta w_{\min})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mn>1</mn></msub></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>3</mn><mo>+</mo><msub><mi>C</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\left(\frac{\beta q_{\min}^{2}}{2\gamma q_{\max}}C_{1}-\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right)\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}+(3+C_{2})\alpha^{2}Lq_{\max}^{2}\sigma^{2}+{\Theta}(\Delta w_{\min}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p7.3" class="ltx_p">Now we bound the term <math id="A5.SS1.p7.m7" class="ltx_Math" alttext="\left\|\nabla f(\bar{W}_{k})\right\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\left\|\nabla f(\bar{W}_{k})\right\|^{2}</annotation></semantics></math> in (<a href="#A5.E66" title="Equation 66 ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">66</span></a>) by <math id="A5.SS1.p7.m8" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-PL condition (which is implied by Assumption <a href="#S3.Thmtheorem3" title="Assumption 3.3 (𝜇-SC condition). ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>)</p>
<table id="A5.EGx73" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E67.m1" class="ltx_Math" alttext="\displaystyle\frac{\alpha q_{\min}^{2}}{8q_{\max}}\left\|\nabla f(\bar{W}_{k})\right\|^{2}\geq" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≥</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\alpha q_{\min}^{2}}{8q_{\max}}\left\|\nabla f(\bar{W}_{k})\right\|^{2}\geq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E67.m2" class="ltx_Math" alttext="\displaystyle\ \frac{\alpha\mu q_{\min}^{2}}{4q_{\max}}(f(\bar{W}_{k})-f^{*})." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{\alpha\mu q_{\min}^{2}}{4q_{\max}}(f(\bar{W}_{k})-f^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p7.4" class="ltx_p">Notice that the <math id="A5.SS1.p7.m9" class="ltx_Math" alttext="\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}</annotation></semantics></math> appears in the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of (<a href="#A5.E66" title="Equation 66 ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">66</span></a>) above, we also need the following lemma to bound it.</p>
</div>
<div id="A5.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A5.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma E.4</span></span><span id="A5.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Quadratic growth, Theorem 2, <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib2" title="" class="ltx_ref">Karimi et al. (2016)</a></cite>)<span id="A5.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A5.Thmtheorem4.p1" class="ltx_para">
<p id="A5.Thmtheorem4.p1.1" class="ltx_p"><span id="A5.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S3.Thmtheorem3" title="Assumption 3.3 (𝜇-SC condition). ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.3</span></a>, defining the optimal solution as <math id="A5.Thmtheorem4.p1.m1" class="ltx_Math" alttext="W^{*}:=\operatornamewithlimits{arg\,min}_{W}f(W)" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo>:=</mo><mrow><mrow><munder><mrow><mi>arg</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>min</mi></mrow><mi>W</mi></munder><mo>⁡</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{*}:=\operatornamewithlimits{arg\,min}_{W}f(W)</annotation></semantics></math>, it holds that</span></p>
<table id="A5.EGx74" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E68"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E68.m1" class="ltx_Math" alttext="\displaystyle\frac{2}{\mu}(f(W)-f^{*})\geq\|W-W^{*}\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>μ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>W</mi><mo>−</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{\mu}(f(W)-f^{*})\geq\|W-W^{*}\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.p8" class="ltx_para ltx_noindent">
<p id="A5.SS1.p8.1" class="ltx_p"><span id="A5.SS1.p8.1.1" class="ltx_text">Replacing <math id="A5.SS1.p8.m1" class="ltx_Math" alttext="W" display="inline" intent=":literal"><semantics><mi>W</mi><annotation encoding="application/x-tex">W</annotation></semantics></math> in (<a href="#A5.E68" title="Equation 68 ‣ Lemma E.4 (Quadratic growth, Theorem 2, ( ) ). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a>) with <math id="A5.SS1.p8.m2" class="ltx_Math" alttext="W_{k}+\gamma(P_{k+1}-Q_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{k}+\gamma(P_{k+1}-Q_{k})</annotation></semantics></math>, we bound the term <math id="A5.SS1.p8.m3" class="ltx_Math" alttext="\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}</annotation></semantics></math> in (<a href="#A5.E53" title="Equation 53 ‣ Lemma E.2 (Descent lemma of upper-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a>) by</span></p>
<table id="A5.EGx75" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E69.m1" class="ltx_Math" alttext="\displaystyle\frac{2}{\mu}(f(W_{k}+\gamma(P_{k+1}-Q_{k}))-f^{*})\geq\|W_{k}+\gamma P_{k+1}-\gamma Q_{k}-W^{*}\|^{2}=\gamma^{2}\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>μ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>−</mo><msup><mi>W</mi><mo>∗</mo></msup></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{2}{\mu}(f(W_{k}+\gamma(P_{k+1}-Q_{k}))-f^{*})\geq\|W_{k}+\gamma P_{k+1}-\gamma Q_{k}-W^{*}\|^{2}=\gamma^{2}\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS1.p9" class="ltx_para ltx_noindent">
<p id="A5.SS1.p9.1" class="ltx_p">By inequality (<a href="#A5.E52" title="Equation 52 ‣ Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>) in Lemma <a href="#A5.Thmtheorem1" title="Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a> and (<a href="#A5.E69" title="Equation 69 ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">69</span></a>), we bound the <math id="A5.SS1.p9.m1" class="ltx_Math" alttext="\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><annotation encoding="application/x-tex">\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}</annotation></semantics></math> by</p>
<table id="A5.EGx76" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E70.m2" class="ltx_Math" alttext="\displaystyle\ \left(\frac{30\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>5</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>4</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \left(\frac{30\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{4\beta^{2}q_{\max}^{3}}{\alpha q_{\min}^{2}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
<tbody id="A5.Ex69"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex69.m1" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex69.m2" class="ltx_Math" alttext="\displaystyle\ \left(\frac{34\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>34</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>5</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>4</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \left(\frac{34\beta^{2}q_{\max}^{5}}{\alpha q_{\min}^{4}}+\frac{6q_{\max}\gamma^{2}\eta^{2}}{\alpha q_{\min}^{2}}\right){\mathbb{E}}_{\xi_{k},b_{k}}[\|P_{k+1}-P^{*}(W_{k},Q_{k})\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex70.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex70.m2" class="ltx_Math" alttext="\displaystyle\ \left(\frac{68\beta^{2}q_{\max}^{5}}{\alpha\gamma^{2}\mu q_{\min}^{4}}+\frac{12q_{\max}\eta^{2}}{\alpha q_{\min}^{2}\mu}\right){\mathbb{E}}_{\xi_{k},b_{k}}[f(W_{k}+\gamma(P_{k+1}-Q_{k}))-f^{*}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>68</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>5</mn></msubsup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>4</mn></msubsup></mrow></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>η</mi><mn>2</mn></msup></mrow><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>min</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \left(\frac{68\beta^{2}q_{\max}^{5}}{\alpha\gamma^{2}\mu q_{\min}^{4}}+\frac{12q_{\max}\eta^{2}}{\alpha q_{\min}^{2}\mu}\right){\mathbb{E}}_{\xi_{k},b_{k}}[f(W_{k}+\gamma(P_{k+1}-Q_{k}))-f^{*}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
