<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex126.m2" class="ltx_math_unparsed" alttext="\displaystyle\ -\frac{\beta}{2q_{\max}}\sum_{d\in[D]}\left([P^{*}(W_{k},Q_{k})-Q_{k}]_{d}^{2}\left([F_{w}(W_{k})]_{d}^{2}-[G_{w}(W_{k})]^{2}_{d}\right)\right)=\ -\frac{\beta}{2q_{\max}}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}_{M_{w}(W_{k})}." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><msubsup><mrow><mo stretchy="false">[</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup><mrow><mo>(</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">[</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup><mo>)</mo></mrow><mo>)</mo></mrow><mo>=</mo><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0.167em">∥</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><msubsup><mo lspace="0em" rspace="0.0835em">∥</mo><mrow><msub><mi>M</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup><mo lspace="0.0835em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\beta}{2q_{\max}}\sum_{d\in[D]}\left([P^{*}(W_{k},Q_{k})-Q_{k}]_{d}^{2}\left([F_{w}(W_{k})]_{d}^{2}-[G_{w}(W_{k})]^{2}_{d}\right)\right)=\ -\frac{\beta}{2q_{\max}}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}_{M_{w}(W_{k})}.</annotation></semantics></math></td>
