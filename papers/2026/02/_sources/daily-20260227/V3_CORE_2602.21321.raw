<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.5pt;">75.19<math id="S3.T1.m1" class="ltx_Math" alttext="\pm 1.0" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">\pm 1.0</annotation></semantics></math></td>
<td id="S3.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.5pt;">72.62<math id="S3.T1.m2" class="ltx_Math" alttext="\pm 0.9" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\pm 0.9</annotation></semantics></math></td>
