<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex132.m1" class="ltx_Math" alttext="\displaystyle\leq\ \frac{\beta}{2\gamma q_{\max}}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}_{M_{w}(W_{k})}+\frac{2\beta q_{\max}^{3}}{\gamma}\left\|P_{k+1}-P^{*}(W_{k},Q_{k})\right\|^{2}_{M_{w}(W_{k})^{\dagger}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo rspace="0.778em">≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>3</mn></msubsup></mrow><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mrow><msub><mi>M</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\ \frac{\beta}{2\gamma q_{\max}}\|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}_{M_{w}(W_{k})}+\frac{2\beta q_{\max}^{3}}{\gamma}\left\|P_{k+1}-P^{*}(W_{k},Q_{k})\right\|^{2}_{M_{w}(W_{k})^{\dagger}}.</annotation></semantics></math></td>
