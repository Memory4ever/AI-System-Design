<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex125.m2" class="ltx_math_unparsed" alttext="\displaystyle\ -\frac{\beta}{2}\sum_{d\in[D]}\left([P^{*}(W_{k},Q_{k})-Q_{k}]_{d}^{2}\left(\frac{[F_{w}(W_{k})]^{2}_{d}-[G_{w}(W_{k})]^{2}_{d}}{[F_{w}(W_{k})]_{d}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>D</mi><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><msubsup><mrow><mo stretchy="false">[</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>F</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup><mo>−</mo><msubsup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>G</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi><mn>2</mn></msubsup></mrow><msub><mrow><mo stretchy="false">[</mo><mrow><msub><mi>F</mi><mi>w</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\beta}{2}\sum_{d\in[D]}\left([P^{*}(W_{k},Q_{k})-Q_{k}]_{d}^{2}\left(\frac{[F_{w}(W_{k})]^{2}_{d}-[G_{w}(W_{k})]^{2}_{d}}{[F_{w}(W_{k})]_{d}}\right)\right)</annotation></semantics></math></td>
