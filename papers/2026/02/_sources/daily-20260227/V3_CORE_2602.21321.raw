<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex89.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex89.m2" class="ltx_Math" alttext="\displaystyle\ -\frac{\alpha}{2}\|\nabla f(\bar{W}_{k})\odot\sqrt{F_{p}(P_{k})}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\alpha}{2}\|\nabla f(\bar{W}_{k})\odot\sqrt{F_{p}(P_{k})}\|^{2}</annotation></semantics></math></td>
