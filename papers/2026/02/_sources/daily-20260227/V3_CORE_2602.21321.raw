<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex98.m2" class="ltx_Math" alttext="\displaystyle\ -\frac{\alpha}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}\leq 0." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\alpha}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}\leq 0.</annotation></semantics></math></td>
