<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E78.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\alpha}{2}\mathbb{E}_{\xi_{k},b_{k}}\left[\left\||\nabla f(\bar{W}_{k};\xi_{k})|\odot\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}-\frac{b_{k}}{\alpha\sqrt{F_{p}(P_{k})}}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mi>α</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>b</mi><mi>k</mi></msub><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mrow></mfrac></mstyle></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\alpha}{2}\mathbb{E}_{\xi_{k},b_{k}}\left[\left\||\nabla f(\bar{W}_{k};\xi_{k})|\odot\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}-\frac{b_{k}}{\alpha\sqrt{F_{p}(P_{k})}}\right\|^{2}\right]</annotation></semantics></math></td>
