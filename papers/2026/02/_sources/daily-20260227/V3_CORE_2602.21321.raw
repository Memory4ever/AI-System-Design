<td id="S3.T1.2.13.5" class="ltx_td ltx_align_center ltx_border_b" style="padding:0.25pt 3.5pt;"><span id="S3.T1.2.13.5.1" class="ltx_text ltx_font_bold">91.54<math id="S3.T1.m70" class="ltx_Math" alttext="\pm 1.5" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>1.5</mn></mrow><annotation encoding="application/x-tex">\pm 1.5</annotation></semantics></math></span></td>
