<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex117.m1" class="ltx_math_unparsed" alttext="\displaystyle\quad-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mi>γ</mi></mfrac></mstyle><mrow><mo stretchy="false">⟨</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex118"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex118.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k}))\rangle." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k}))\rangle.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.3" class="ltx_p"><span id="A5.SS3.p2.3.1" class="ltx_text">where the first equality holds because <math id="A5.SS3.p2.m5" class="ltx_Math" alttext="\mathbb{E}[b_{k}^{\prime}]=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msubsup><mi>b</mi><mi>k</mi><mo>′</mo></msubsup><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}[b_{k}^{\prime}]=0</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p"><span id="A5.SS3.p3.1.1" class="ltx_text">The first term in the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of (<a href="#A5.E90" title="Equation 90 ‣ Lemma . ‣ E.3 Proof of Lemma : Descent of sequence 𝑊_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">90</span></a>) is bounded by</span></p>
<table id="A5.EGx96" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E91.m2" class="ltx_Math" alttext="\displaystyle\ -\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\rangle" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k})\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
<tbody id="A5.Ex119"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
