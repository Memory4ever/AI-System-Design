</table>
<p id="A5.SS3.p3.3" class="ltx_p"><span id="A5.SS3.p3.3.1" class="ltx_text">The second term in the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of (<a href="#A5.E90" title="Equation 90 ‣ Lemma . ‣ E.3 Proof of Lemma : Descent of sequence 𝑊_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">90</span></a>) follows the Lipschitz continuity of analog update (see Lemma <a href="#A1.Thmtheorem2" title="Lemma A.2 (( , , Lemma 2)). ‣ Appendix A Notations and Preliminaries" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>)</span></p>
<table id="A5.EGx98" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E93.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>β</mi></mrow><mi>γ</mi></mfrac></mstyle><mrow><mo stretchy="false">⟨</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo>,</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{2\beta}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
<tbody id="A5.Ex127"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex127.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad-((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k}))\rangle" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">(</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi>P</mi><mo>∗</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub><mo fence="false" stretchy="false">|</mo><mo lspace="0em" rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad-((P^{*}(W_{k},Q_{k})-Q_{k})\odot F_{w}(W_{k})-|P^{*}(W_{k},Q_{k})-Q_{k}|\odot G_{w}(W_{k}))\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex128"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
