frac{P_{k+1}-P_{k}}{\sqrt{F_{p}(P_{k})}}+\alpha\nabla f(\bar{W}_{k};\xi_{k})\odot\sqrt{F_{p}(P_{k})}-\frac{b_{k}}{\sqrt{F_{p}(P_{k})}}\right\|^{2}\right]</annotation></semantics></math></td>
