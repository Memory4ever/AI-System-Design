"0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \left(\frac{68\beta^{2}q_{\max}^{5}}{\alpha\gamma^{2}\mu q_{\min}^{4}}+\frac{12q_{\max}\eta^{2}}{\alpha q_{\min}^{2}\mu}\right)\left(f(\bar{W}_{k})-f^{*}+\frac{\alpha\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|_{\infty}^{2}+\alpha^{2}Lq_{\max}^{2}\sigma^{2}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)\right)</annotation></semantics></math></td>
