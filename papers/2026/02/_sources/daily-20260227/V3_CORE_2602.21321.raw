<p id="A5.SS2.p5.2" class="ltx_p"><span id="A5.SS2.p5.2.1" class="ltx_text">Plugging (<a href="#A5.E76" title="Equation 76 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">76</span></a>) to (<a href="#A5.E80" title="Equation 80 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">80</span></a>) into (<a href="#A5.E75" title="Equation 75 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">75</span></a>), we bound the term (a) by</span></p>
<table id="A5.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E81.m1" class="ltx_Math" alttext="\displaystyle\gamma\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),P_{k+1}-P_{k}\right\rangle]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\gamma\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),P_{k+1}-P_{k}\right\rangle]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E81.m2" class="ltx_Math" alttext="\displaystyle\ -\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
<tbody id="A5.Ex99"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex99.m1" class="ltx_Math" alttext="\displaystyle\ -\frac{\gamma}{2\alpha q_{\max}}\mathbb{E}_{\xi_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\frac{\gamma}{2\alpha q_{\max}}\mathbb{E}_{\xi_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p6" class="ltx_para ltx_noindent">
<p id="A5.SS2.p6.1" class="ltx_p"><span id="A5.SS2.p6.1.1" class="ltx_text ltx_font_bold">Bound of the third term (b).</span> By Young’s inequality, we have</p>
<table id="A5.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E82.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi_{k}}[\left\langle\nabla f(\bar{W}_{k}),W_{k+1}-W_{k}\right\rangle]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi_{k}}[\left\langle\nabla f(\bar{W}_{k}),W_{k+1}-W_{k}\right\rangle]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E82.m2" class="ltx_Math" alttext="\displaystyle\ \frac{\alpha\gamma}{4q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{q_{\max}}{\alpha\gamma}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mi>max</mi></msub><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{\alpha\gamma}{4q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{q_{\max}}{\alpha\gamma}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p7" class="ltx_para ltx_noindent">
<p id="A5.SS2.p7.1" class="ltx_p"><span id="A5.SS2.p7.1.1" class="ltx_text ltx_font_bold">Bound of the fourth term (c).</span> Repeatedly applying inequality <math id="A5.SS2.p7.m1" class="ltx_Math" alttext="\|U+V\|^{2}\leq 2\|U\|^{2}+2\|V\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mi>U</mi><mo>+</mo><mi>V</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>U</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mi>V</mi><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\|U+V\|^{2}\leq 2\|U\|^{2}+2\|V\|^{2}</annotation></semantics></math> for any <math id="A5.SS2.p7.m2" class="ltx_Math" alttext="U,V\in{\mathbb{R}}^{D}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>U</mi><mo>,</mo><mi>V</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">U,V\in{\mathbb{R}}^{D}</annotation></semantics></math>, we have</p>
<table id="A5.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E83.m2" class="ltx_Math" alttext="\displaystyle\ \frac{L}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|\bar{W}_{k+1}-\bar{W}_{k}\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><mfrac><mi>L</mi><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{L}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|\bar{W}_{k+1}-\bar{W}_{k}\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
<tbody id="A5.Ex100"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex100.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex100.m2" class="ltx_Math" alttext="\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|P_{k+1}-P_{k}\|^{2}]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|P_{k+1}-P_{k}\|^{2}]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex101"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex101.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex101.m2" class="ltx_Math" alttext="\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+3\gamma^{2}L\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+3\gamma^{2}L\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex102"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex102.m1" class="ltx_Math" alttext="\displaystyle\ +3\alpha^{2}L\gamma^{2}\mathbb{E}_{\xi_{k}}\left[\left\|(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +3\alpha^{2}L\gamma^{2}\mathbb{E}_{\xi_{k}}\left[\left\|(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex103"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex103.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex103.m2" class="ltx_Math" alttext="\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+3\gamma^{2}L\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]+3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]+3\gamma^{2}L\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]+3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex104"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex104.m1" class="ltx_Math" alttext="\displaystyle+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]+{\Theta}\left(3\gamma^{2}L\alpha\Delta w_{\min}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}]+{\Theta}\left(3\gamma^{2}L\alpha\Delta w_{\min}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.2" class="ltx_p">where the last inequality comes from Assumption <a href="#S3.Thmtheorem4" title="Assumption 3.4. ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.4</span></a> and the bounded variance assumption (Assumption <a href="#S3.Thmtheorem2" title="Assumption 3.2 (Unbiasness and bounded variance). ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>)</p>
<table id="A5.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E84.m2" class="ltx_Math" alttext="\displaystyle\ 3\alpha^{2}\gamma^{2}L\mathbb{E}_{\xi_{k}}\left[\left\|(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ 3\alpha^{2}\gamma^{2}L\mathbb{E}_{\xi_{k}}\left[\left\|(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
<tbody id="A5.Ex105"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex105.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex105.m2" class="ltx_Math" alttext="\displaystyle\ 3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\mathbb{E}_{\xi_{k}}\left[\left\|\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k})\right\|^{2}\right]\leq 3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ 3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\mathbb{E}_{\xi_{k}}\left[\left\|\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k})\right\|^{2}\right]\leq 3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p7.3" class="ltx_p"><span id="A5.SS2.p7.3.1" class="ltx_text ltx_font_bold">Bound of the fifth term (d).</span> By Young’s inequality, we have</p>
<table id="A5.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E85.m1" class="ltx_Math" alttext="\displaystyle-\gamma\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),Q_{k+1}-Q_{k}\right\rangle]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle-\gamma\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),Q_{k+1}-Q_{k}\right\rangle]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E85.m2" class="ltx_Math" alttext="\displaystyle\ \frac{\alpha\gamma}{8q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{\alpha\gamma}{8q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p8" class="ltx_para ltx_noindent">
<p id="A5.SS2.p8.1" class="ltx_p"><span id="A5.SS2.p8.1.1" class="ltx_text ltx_font_bold">Combination of the upper bound <math id="A5.SS2.p8.m1" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math>, <math id="A5.SS2.p8.m2" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math>, <math id="A5.SS2.p8.m3" class="ltx_Math" alttext="(c)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(c)</annotation></semantics></math> and <math id="A5.SS2.p8.m4" class="ltx_Math" alttext="(d)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>d</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(d)</annotation></semantics></math>.</span> Plugging (<a href="#A5.E81" title="Equation 81 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">81</span></a>), (<a href="#A5.E82" title="Equation 82 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">82</span></a>), (<a href="#A5.E83" title="Equation 83 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">83</span></a>) into (<a href="#A5.E74" title="Equation 74 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">74</span></a>) and letting <math id="A5.SS2.p8.m5" class="ltx_Math" alttext="\alpha\leq\frac{1}{2\gamma Lq_{\max}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha\leq\frac{1}{2\gamma Lq_{\max}}</annotation></semantics></math>,</p>
<table id="A5.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex106"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex106.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi_{k},b_{k}}[f(\bar{W}_{k+1})]\leq" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi_{k},b_{k}}[f(\bar{W}_{k+1})]\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex106.m2" class="ltx_Math" alttext="\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{8q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{8q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E86.m1" class="ltx_Math" alttext="\displaystyle\ +\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mi>α</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ +\frac{2q_{\max}\gamma}{\alpha}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+\frac{3\gamma^{2}L}{2}\mathbb{E}_{\xi_{k}}\left[\|Q_{k+1}-Q_{k}\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
<tbody id="A5.Ex108"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex108.m1" class="ltx_Math" alttext="\displaystyle\ -\left(\frac{\gamma}{2\alpha q_{\max}}-3\gamma^{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ -\left(\frac{\gamma}{2\alpha q_{\max}}-3\gamma^{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex109"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex109.m1" class="ltx_Math" alttext="\displaystyle\ +3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}+\frac{q_{\max}}{\alpha\gamma}~\mathbb{E}_{\xi_{k}}\left[\|W_{k+1}-W_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+\frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>q</mi><mi>max</mi></msub><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow></mfrac></mstyle><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo>†</mo></msup></mrow><mn>2</mn></msubsup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><msub><mi>ξ</mi><mi>k</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ +3\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}+\frac{q_{\max}}{\alpha\gamma}~\mathbb{E}_{\xi_{k}}\left[\|W_{k+1}-W_{k}\|^{2}_{M_{p}(P_{k})^{\dagger}}\right]+\frac{3L}{2}\mathbb{E}_{\xi_{k}}[\|W_{k+1}-W_{k}\|^{2}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS2.p9" class="ltx_para">
<p id="A5.SS2.p9.1" class="ltx_p"><span id="A5.SS2.p9.1.1" class="ltx_text">Now the proof of (<a href="#A5.E51" title="Equation 51 ‣ Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) is completed.
Leveraging the <math id="A5.SS2.p9.m1" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>-smooth assumption (Assumption <a href="#S3.Thmtheorem1" title="Assumption 3.1 (𝐿-smoothness). ‣ 3.1 Basic Design ‣ 3 Dynamic SP Tracking Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a>), we have</span></p>
<table id="A5.EGx92" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E87.m2" class="ltx_Math" alttext="\displaystyle\ \mathbb{E}_{\xi_{k},b_{k}}[f(W_{k}+\gamma(P_{k+1}-Q_{k}))]=f(\bar{W}_{k})+\gamma{\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),P_{k+1}-P_{k}\right\rangle]}+{\frac{L\gamma^{2}}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|P_{k+1}-P_{k}\|^{2}]}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ \mathbb{E}_{\xi_{k},b_{k}}[f(W_{k}+\gamma(P_{k+1}-Q_{k}))]=f(\bar{W}_{k})+\gamma{\mathbb{E}_{\xi_{k},b_{k}}[\left\langle\nabla f(\bar{W}_{k}),P_{k+1}-P_{k}\right\rangle]}+{\frac{L\gamma^{2}}{2}\mathbb{E}_{\xi_{k},b_{k}}[\|P_{k+1}-P_{k}\|^{2}]}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p9.2" class="ltx_p"><span id="A5.SS2.p9.2.1" class="ltx_text">Plugging (<a href="#A5.E81" title="Equation 81 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">81</span></a>) and (<a href="#A5.E83" title="Equation 83 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">83</span></a>) into (<a href="#A5.E87" title="Equation 87 ‣ Lemma . ‣ E.2 Proof of Lemma : Descent of sequence 𝑊̄_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">87</span></a>), we have</span></p>
<table id="A5.EGx93" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E88.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}_{\xi_{k},b_{k}}[f(W_{k}+\gamma P_{k+1}-\gamma Q_{k})]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}_{\xi_{k},b_{k}}[f(W_{k}+\gamma P_{k+1}-\gamma Q_{k})]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
<tbody id="A5.Ex110"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex110.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex110.m2" class="ltx_Math" alttext="\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex111"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex111.m1" class="ltx_Math" alttext="\displaystyle\ -\left(\frac{\gamma}{2\alpha q_{\max}}-\gamma^{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]+\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>−</mo><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo>−</mo><mrow><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>)</mo></mrow><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝔼</mi><mrow><msub><mi>ξ</mi><mi>k</mi></msub><mo>,</mo><msub><mi>b</mi><mi>k</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo>‖</mo><mrow><mrow><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>P</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mi>α</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo>,</mo><msub><mi>ξ</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>p</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><msub><mi>b</mi><mi>k</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\ -\left(\frac{\gamma}{2\alpha q_{\max}}-\gamma^{2}L\right)~\mathbb{E}_{\xi_{k},b_{k}}\left[\left\|P_{k+1}-P_{k}+\alpha(\nabla f(\bar{W}_{k};\xi_{k})-\nabla f(\bar{W}_{k}))\odot F_{p}(P_{k})-b_{k}\right\|^{2}\right]+\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex112"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex112.m1" class="ltx_Math" alttext="\displaystyle\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex112.m2" class="ltx_Math" alttext="\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>f</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>W</mi><mo>¯</mo></mover><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mrow><msub><mi>M</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mn>2</mn></msubsup></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>α</mi><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>G</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><msqrt><mrow><msub><mi>F</mi><mi>p</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></msqrt></mfrac></mstyle><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><msup><mi>α</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>γ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>q</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mi mathvariant="normal">Θ</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>min</mi></msub></mrow><msub><mi>q</mi><mi>min</mi></msub></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ f(\bar{W}_{k})-\frac{\alpha\gamma}{2q_{\max}}\|\nabla f(\bar{W}_{k})\|^{2}_{M_{p}(P_{k})}+\frac{\alpha\gamma\sigma^{2}}{2}\left\|\frac{G_{p}(P_{k})}{\sqrt{F_{p}(P_{k})}}\right\|^{2}_{\infty}+\alpha^{2}\gamma^{2}Lq_{\max}^{2}\sigma^{2}+{\Theta}\left(\frac{\gamma\Delta w_{\min}}{q_{\min}}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p9.3" class="ltx_p"><span id="A5.SS2.p9.3.1" class="ltx_text">where the second inequality holds by <math id="A5.SS2.p9.m2" class="ltx_Math" alttext="\alpha\leq\frac{1}{2\gamma Lq_{\max}}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>q</mi><mi>max</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\alpha\leq\frac{1}{2\gamma Lq_{\max}}</annotation></semantics></math>. Now the proof of (<a href="#A5.E52" title="Equation 52 ‣ Lemma E.1 (Descent lemma of lower-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>) is completed.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS3" class="ltx_subsection">
<h4 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Proof of Lemma <a href="#A5.Thmtheorem2" title="Lemma E.2 (Descent lemma of upper-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>: Descent of sequence <math id="A5.SS3.m1" class="ltx_Math" alttext="W_{k}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mi>k</mi></msub><annotation encoding="application/x-tex">W_{k}</annotation></semantics></math></h4>

<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.1" class="ltx_p">See <a href="#A5.Thmtheorem2" title="Lemma E.2 (Descent lemma of upper-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a></p>
</div>
<div id="A5.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Lemma <a href="#A5.Thmtheorem2" title="Lemma E.2 (Descent lemma of upper-level problem). ‣ Theorem . ‣ E.1 Main proof ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.2</span></a>.</h6>
<div id="A5.SS3.p2" class="ltx_para ltx_noindent">
<p id="A5.SS3.p2.1" class="ltx_p"><span id="A5.SS3.p2.1.1" class="ltx_text">Recall the definition <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="P^{*}(W,Q)-Q=(W^{*}-W)/\gamma" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>W</mi><mo>,</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>Q</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>W</mi><mo>∗</mo></msup><mo>−</mo><mi>W</mi></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mi>γ</mi></mrow></mrow><annotation encoding="application/x-tex">P^{*}(W,Q)-Q=(W^{*}-W)/\gamma</annotation></semantics></math>, it holds that</span></p>
<table id="A5.EGx94" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E89.m2" class="ltx_Math" alttext="\displaystyle\ \|P^{*}(W_{k+1},Q_{k+1})-Q_{k+1}\|^{2}=\frac{1}{\gamma^{2}}\|W_{k+1}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k+1})\|^{2}\leq\frac{1}{\gamma^{2}}\|W_{k+1}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k})\|^{2}" display="inline" intent=":literal"><semantics><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msub><mi>Proj</mi><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><mrow><msub><mi>Proj</mi><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \|P^{*}(W_{k+1},Q_{k+1})-Q_{k+1}\|^{2}=\frac{1}{\gamma^{2}}\|W_{k+1}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k+1})\|^{2}\leq\frac{1}{\gamma^{2}}\|W_{k+1}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k})\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
<tbody id="A5.Ex113"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex113.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex113.m2" class="ltx_Math" alttext="\displaystyle\ \frac{1}{\gamma^{2}}\|W_{k}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k})\|^{2}+\frac{2}{\gamma^{2}}\left\langle W_{k}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k}),W_{k+1}-W_{k}\right\rangle+\frac{1}{\gamma^{2}}\|W_{k+1}-W_{k}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>−</mo><mrow><msub><mi>Proj</mi><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><msub><mi>W</mi><mi>k</mi></msub><mo>−</mo><mrow><msub><mi>Proj</mi><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \frac{1}{\gamma^{2}}\|W_{k}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k})\|^{2}+\frac{2}{\gamma^{2}}\left\langle W_{k}-\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k}),W_{k+1}-W_{k}\right\rangle+\frac{1}{\gamma^{2}}\|W_{k+1}-W_{k}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex114"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex114.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex114.m2" class="ltx_Math" alttext="\displaystyle\ \|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}-\frac{2}{\gamma}\left\langle P^{*}(W_{k},Q_{k})-Q_{k},W_{k+1}-W_{k}\right\rangle+\frac{1}{\gamma^{2}}\|W_{k+1}-W_{k}\|^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><msup><mrow><mo stretchy="false">‖</mo><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow></mrow><mo>⟩</mo></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mi>γ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\ \|P^{*}(W_{k},Q_{k})-Q_{k}\|^{2}-\frac{2}{\gamma}\left\langle P^{*}(W_{k},Q_{k})-Q_{k},W_{k+1}-W_{k}\right\rangle+\frac{1}{\gamma^{2}}\|W_{k+1}-W_{k}\|^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS3.p2.2" class="ltx_p"><span id="A5.SS3.p2.2.1" class="ltx_text">where the first inequality comes from the fact that <math id="A5.SS3.p2.m2" class="ltx_Math" alttext="\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k+1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Proj</mi><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Proj}_{{\mathcal{W}}^{*}}(W_{k+1})</annotation></semantics></math> is the closest point to <math id="A5.SS3.p2.m3" class="ltx_Math" alttext="W_{k+1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">W_{k+1}</annotation></semantics></math> in <math id="A5.SS3.p2.m4" class="ltx_Math" alttext="{\mathcal{W}}^{*}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒲</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">{\mathcal{W}}^{*}</annotation></semantics></math>.
We bound the second term in the <abbr title="" class="ltx_glossaryref ltx_missing">RHS</abbr> of (<a href="#A5.E89" title="Equation 89 ‣ Lemma . ‣ E.3 Proof of Lemma : Descent of sequence 𝑊_𝑘 ‣ Appendix E Proof of Theorem : Convergence of Algorithm" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>) by</span></p>
<table id="A5.EGx95" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E90.m2" class="ltx_Math" alttext="\displaystyle\quad-\mathbb{E}_{b^{\prime}_{k}}\left[\frac{2}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},W_{k+1}-W_{k}\rangle\right]" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><msubsup><mi>b</mi><mi>k</mi><mo>′</mo></msubsup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><msub><mi>W</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>W</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\quad-\mathbb{E}_{b^{\prime}_{k}}\left[\frac{2}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},W_{k+1}-W_{k}\rangle\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
<tbody id="A5.Ex115"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex115.m1" class="ltx_Math" alttext="\displaystyle=-\frac{2}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},\beta(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-\beta|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})\rangle" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>γ</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo>,</mo><msub><mi>Q</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo>,</mo><mrow><mrow><mrow><mrow><mi>β</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>F</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>P</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>Q</mi><mi>k</mi></msub></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow></mrow><mo rspace="0.222em">⊙</mo><msub><mi>G</mi><mi>w</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=-\frac{2}{\gamma}\langle P^{*}(W_{k},Q_{k})-Q_{k},\beta(P_{k+1}-Q_{k})\odot F_{w}(W_{k})-\beta|P_{k+1}-Q_{k}|\odot G_{w}(W_{k})\rangle</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
