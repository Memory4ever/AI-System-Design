<th id="S1.T1.3.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="S1.T1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Items</span></th>
