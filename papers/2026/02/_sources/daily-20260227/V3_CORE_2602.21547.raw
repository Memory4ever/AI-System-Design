          <math id="algorithm5.m15" class="ltx_Math" alttext="\textsf{src}(s)\leftarrow\arg\max_{e\in\mathcal{M}(s)}\mathrm{TSI}(q)" display="inline" intent=":literal"><semantics><mrow><mrow><mtext class="ltx_mathvariant_sans-serif">src</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><mrow><mi>e</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℳ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi>TSI</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>q</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\textsf{src}(s)\leftarrow\arg\max_{e\in\mathcal{M}(s)}\mathrm{TSI}(q)</annotation></semantics></math>
</div>
