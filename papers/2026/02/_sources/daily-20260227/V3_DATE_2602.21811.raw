{"data":{"id":"10.48550/arxiv.2602.21811","type":"dois","attributes":{"doi":"10.48550/arxiv.2602.21811","prefix":"10.48550","suffix":"arxiv.2602.21811","identifiers":[{"identifier":"2602.21811","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2602.21811"}],"creators":[{"name":"Liu, Qingtao","nameType":"Personal","givenName":"Qingtao","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Zhengnan","nameType":"Personal","givenName":"Zhengnan","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Cui, Yu","nameType":"Personal","givenName":"Yu","familyName":"Cui","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Haoming","nameType":"Personal","givenName":"Haoming","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Gaofeng","nameType":"Personal","givenName":"Gaofeng","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Shao, Lin","nameType":"Personal","givenName":"Lin","familyName":"Shao","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Jiming","nameType":"Personal","givenName":"Jiming","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Qi","nameType":"Personal","givenName":"Qi","familyName":"Ye","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DexRepNet++: Learning Dexterous Robotic Manipulation with Geometric and Spatial Hand-Object Representations"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-02-25T11:38:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-02-26T01:46:16Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-02","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/tro.2026.3651669","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Robotic dexterous manipulation is a challenging problem due to high degrees of freedom (DoFs) and complex contacts of multi-fingered robotic hands. Many existing deep reinforcement learning (DRL) based methods aim at improving sample efficiency in high-dimensional output action spaces. However, existing works often overlook the role of representations in achieving generalization of a manipulation policy in the complex input space during the hand-object interaction. In this paper, we propose DexRep, a novel hand-object interaction representation to capture object surface features and spatial relations between hands and objects for dexterous manipulation skill learning. Based on DexRep, policies are learned for three dexterous manipulation tasks, i.e. grasping, in-hand reorientation, bimanual handover, and extensive experiments are conducted to verify the effectiveness. In simulation, for grasping, the policy learned with 40 objects achieves a success rate of 87.9% on more than 5000 unseen objects of diverse categories, significantly surpassing existing work trained with thousands of objects; for the in-hand reorientation and handover tasks, the policies also boost the success rates and other metrics of existing hand-object representations by 20% to 40%. The grasp policies with DexRep are deployed to the real world under multi-camera and single-camera setups and demonstrate a small sim-to-real gap.","descriptionType":"Abstract"},{"description":"Accepted by IEEE Transactions on Robotics (T-RO), 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2602.21811","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-02-26T03:06:45.000Z","registered":"2026-02-26T03:06:46.000Z","published":"2026","updated":"2026-02-26T03:06:46.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2602.21811","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1109/tro.2026.3651669","type":"dois"}]}}}}