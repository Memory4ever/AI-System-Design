<th id="S4.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_rr ltx_border_t"><span id="S4.T1.2.7.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-fg-color:#8C564B;">Random</span>-150M</th>
<td id="S4.T1.2.7.2" class="ltx_td ltx_align_right ltx_border_r ltx_border_t">150M</td>
