<td id="S4.T1.2.5.3" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S4.T1.m11" class="ltx_Math" alttext="7.59" display="inline" intent=":literal"><semantics><mn>7.59</mn><annotation encoding="application/x-tex">7.59</annotation></semantics></math></td>
<td id="S4.T1.2.5.4" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S4.T1.m12" class="ltx_Math" alttext="7.60" display="inline" intent=":literal"><semantics><mn>7.60</mn><annotation encoding="application/x-tex">7.60</annotation></semantics></math></td></tr>
