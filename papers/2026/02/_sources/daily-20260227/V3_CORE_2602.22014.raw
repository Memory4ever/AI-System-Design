="M 0 0 L 0 -4.86"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 101.44 54.26)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="6.92"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m1" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math></span></span></foreignObject></g><g></g><g><clipPath id="pgfcp3"><path d="M 79.89 72.9 h 1013.42 v 325.35 h -1013.42 Z"></path></clipPath></g><g clip-path="url(#pgfcp3)"><g style="--ltx-stroke-color:#B0B0B0;" stroke="#B0B0B0" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="rect" stroke-linejoin="round" stroke-width="0.803pt"><path style="fill:none" d="M 252.42 72.9 L 252.42 398.25"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="butt" stroke-linejoin="round" stroke-width="0.803pt" transform="matrix(1.0 0.0 0.0 1.0 252.42 72.9)"><path d="M 0 0 L 0 -4.86"></path></g><g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 238.59 54.26)"><foreignObject style="--ltx-fo-width:2em;--ltx-fo-height:0.64em;--ltx-fo-depth:0em;font-size:10pt;" height="8.92" overflow="visible" transform="matrix(1 0 0 -1 0 8.92)" width="27.67"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S3.F1.pic1.m2" class="ltx_Math" alttext="5000" display="inline" intent=":literal"><semantics><mn>5000</mn><annotation encoding="application/x-tex">5000</annotation></semantics></math></span></span></foreignObject></g><g></