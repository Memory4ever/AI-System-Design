<th id="S4.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_rr"><span id="S4.T1.2.8.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-fg-color:#0072B2;">Diverse</span>-150M</th>
<td id="S4.T1.2.8.2" class="ltx_td ltx_align_right ltx_border_r">147M</td>
