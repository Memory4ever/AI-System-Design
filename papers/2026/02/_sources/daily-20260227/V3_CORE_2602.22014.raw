<td id="S4.T1.2.7.4" class="ltx_td ltx_align_right ltx_border_r ltx_border_t"><math id="S4.T1.m16" class="ltx_Math" alttext="7.61" display="inline" intent=":literal"><semantics><mn>7.61</mn><annotation encoding="application/x-tex">7.61</annotation></semantics></math></td></tr>
