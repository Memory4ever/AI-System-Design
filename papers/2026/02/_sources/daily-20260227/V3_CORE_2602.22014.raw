<td id="S5.T4.2.6.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T4.2.6.4.1" class="ltx_text ltx_font_bold">61.7<math id="S5.T4.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.2</span></td></tr>
<tr id="S5.T4.2.7" class="ltx_tr">
<th id="S5.T4.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T4.2.7.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-fg-color:#8C564B;">Random</span>-150M</th>
<th id="S5.T4.2.7.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_rr ltx_border_t">483h</th>
<td id="S5.T4.2.7.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">80.2<math id="S5.T4.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.2</td>
<td id="S5.T4.2.7.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">51.9<math id="S5.T4.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.4</td></tr>
<tr id="S5.T4.2.8" class="ltx_tr">
<th id="S5.T4.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_l ltx_border_r"><span id="S5.T4.2.8.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-fg-color:#0072B2;">Diverse</span>-150M</th>
<th id="S5.T4.2.8.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_rr">483h</th>
<td id="S5.T4.2.8.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T4.2.8.3.1" class="ltx_text ltx_font_bold">84.3<math id="S5.T4.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.5</span></td>
<td id="S5.T4.2.8.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T4.2.8.4.1" class="ltx_text ltx_underline ltx_font_bold">61.5<math id="S5.T4.m14" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.4</span></td></tr>
<tr id="S5.T4.2.9" class="ltx_tr">
<th id="S5.T4.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_b ltx_border_l ltx_border_r ltx_border_t"><span id="S5.T4.2.9.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-fg-color:#FFA500;">Baseline</span>-100M</th>
<th id="S5.T4.2.9.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_b ltx_border_rr ltx_border_t">483h</th>
<td id="S5.T4.2.9.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t">77.8<math id="S5.T4.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.2</td>
<td id="S5.T4.2.9.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t">50.4<math id="S5.T4.m16" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.7</td></tr>
