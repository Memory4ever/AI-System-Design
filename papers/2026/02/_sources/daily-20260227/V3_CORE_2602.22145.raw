<td id="S5.T3.5.4.2" class="ltx_td ltx_align_right"><span id="S5.T3.5.4.2.1" class="ltx_text" style="font-size:90%;">260</span></td>
<td id="S5.T3.5.4.3" class="ltx_td ltx_align_right"><span id="S5.T3.5.4.3.1" class="ltx_text" style="font-size:90%;">1,300</span></td>
<td id="S5.T3.5.4.4" class="ltx_td ltx_align_right"><span id="S5.T3.5.4.4.1" class="ltx_text" style="font-size:90%;">482</span></td>
<td id="S5.T3.5.4.5" class="ltx_td ltx_align_right"><span id="S5.T3.5.4.5.1" class="ltx_text" style="font-size:90%;">37.1%</span></td></tr>
