<td id="S5.T3.5.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T3.5.2.2.1" class="ltx_text" style="font-size:90%;">198</span></td>
<td id="S5.T3.5.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T3.5.2.3.1" class="ltx_text" style="font-size:90%;">990</span></td>
<td id="S5.T3.5.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T3.5.2.4.1" class="ltx_text" style="font-size:90%;">708</span></td>
<td id="S5.T3.5.2.5" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T3.5.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">71.5%</span></td></tr>
