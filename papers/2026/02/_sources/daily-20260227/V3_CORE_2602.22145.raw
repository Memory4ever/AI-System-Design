<td id="S5.T3.5.3.2" class="ltx_td ltx_align_right"><span id="S5.T3.5.3.2.1" class="ltx_text" style="font-size:90%;">166</span></td>
<td id="S5.T3.5.3.3" class="ltx_td ltx_align_right"><span id="S5.T3.5.3.3.1" class="ltx_text" style="font-size:90%;">830</span></td>
<td id="S5.T3.5.3.4" class="ltx_td ltx_align_right"><span id="S5.T3.5.3.4.1" class="ltx_text" style="font-size:90%;">467</span></td>
<td id="S5.T3.5.3.5" class="ltx_td ltx_align_right"><span id="S5.T3.5.3.5.1" class="ltx_text" style="font-size:90%;">56.3%</span></td></tr>
