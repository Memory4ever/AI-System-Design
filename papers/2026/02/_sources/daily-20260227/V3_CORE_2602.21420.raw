<th id="S5.T3.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.2.1" class="ltx_text ltx_font_bold">@1</span></th>
<th id="S5.T3.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.3.1" class="ltx_text ltx_font_bold">@2</span></th>
<th id="S5.T3.5.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.4.1" class="ltx_text ltx_font_bold">@4</span></th>
<th id="S5.T3.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.5.1" class="ltx_text ltx_font_bold">@8</span></th>
<th id="S5.T3.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.6.1" class="ltx_text ltx_font_bold">@16</span></th>
<th id="S5.T3.5.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T3.5.1.7.1" class="ltx_text ltx_font_bold">@32</span></th></tr>
</thead>
<tbody class="ltx_tbody">
