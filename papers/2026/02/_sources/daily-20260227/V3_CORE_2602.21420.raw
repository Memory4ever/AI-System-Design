<td id="S5.T3.5.3.4" class="ltx_td ltx_align_center">83.9</td>
<td id="S5.T3.5.3.5" class="ltx_td ltx_align_center">87.6</td>
<td id="S5.T3.5.3.6" class="ltx_td ltx_align_center">91.2</td>
<td id="S5.T3.5.3.7" class="ltx_td ltx_align_center">93.1</td></tr>
<tr id="S5.T3.5.4" class="ltx_tr">
