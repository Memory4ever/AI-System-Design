<td id="S5.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t">83.2</td>
<td id="S5.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_t">86.2</td>
<td id="S5.T3.5.2.6" class="ltx_td ltx_align_center ltx_border_t">89.7</td>
<td id="S5.T3.5.2.7" class="ltx_td ltx_align_center ltx_border_t">91.3</td></tr>
<tr id="S5.T3.5.3" class="ltx_tr">
<th id="S5.T3.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ACE-ReLU</th>
<td id="S5.T3.5.3.2" class="ltx_td ltx_align_center">73.2</td>
