              <math id="alg1.l3.m1" class="ltx_Math" alttext="\bm{q}\leftarrow{M}(\bm{x},\text{prompt})" display="inline" intent=":literal"><semantics><mrow><mi>𝒒</mi><mo stretchy="false">←</mo><mrow><mi>M</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒙</mi><mo>,</mo><mtext>prompt</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bm{q}\leftarrow{M}(\bm{x},\text{prompt})</annotation></semantics></math>

