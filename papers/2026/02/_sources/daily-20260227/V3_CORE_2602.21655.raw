               Append <math id="alg1.l5.m1" class="ltx_Math" alttext="\bm{q}" display="inline" intent=":literal"><semantics><mi>𝒒</mi><annotation encoding="application/x-tex">\bm{q}</annotation></semantics></math> to <math id="alg1.l5.m2" class="ltx_Math" alttext="\mathcal{Q}_{\text{list}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mtext>list</mtext></msub><annotation encoding="application/x-tex">\mathcal{Q}_{\text{list}}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
