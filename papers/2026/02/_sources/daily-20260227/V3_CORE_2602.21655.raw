<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <span id="alg1.l4.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l4.m1" class="ltx_Math" alttext="\bm{q}" display="inline" intent=":literal"><semantics><mi>𝒒</mi><annotation encoding="application/x-tex">\bm{q}</annotation></semantics></math> is valid and related to image <math id="alg1.l4.m2" class="ltx_Math" alttext="\bm{x}" display="inline" intent=":literal"><semantics><mi>𝒙</mi><annotation encoding="application/x-tex">\bm{x}</annotation></semantics></math> <span id="alg1.l4.4" class="ltx_text ltx_font_bold">then</span>



