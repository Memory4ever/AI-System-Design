<th id="S4.F2.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 4.0pt;">Best-of-<math id="S4.F2.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></th>
<td id="S4.F2.3.5.2" class="ltx_td ltx_align_center" style="padding:0.5pt 4.0pt;">65.3</td></tr>
<tr id="S4.F2.3.6" class="ltx_tr">
<th id="S4.F2.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.5pt 4.0pt;">GEPA</th>
