<td id="A5.T14.2.4.1" class="ltx_td ltx_align_left"><span id="A5.T14.2.4.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">FCI vs NOTEARS</span></td>
<td id="A5.T14.2.4.2" class="ltx_td ltx_align_center"><span id="A5.T14.2.4.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">+0.127</span></td>
<td id="A5.T14.2.4.3" class="ltx_td ltx_align_center"><span id="A5.T14.2.4.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">1.000</span></td>
<td id="A5.T14.2.4.4" class="ltx_td ltx_align_center"><span id="A5.T14.2.4.4.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.489</span></td>
<td id="A5.T14.2.4.5" class="ltx_td ltx_align_center"><span id="A5.T14.2.4.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">No</span></td></tr>
<tr id="A5.T14.2.5" class="ltx_tr">
<td id="A5.T14.2.5.1" class="ltx_td ltx_align_left">FCI vs PC</td>
<td id="A5.T14.2.5.2" class="ltx_td ltx_align_center">-0.002</td>
<td id="A5.T14.2.5.3" class="ltx_td ltx_align_center">1.000</td>
