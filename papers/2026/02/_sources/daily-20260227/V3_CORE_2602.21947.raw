<td id="S4.T6.2.2.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">13.5%</td>
<td id="S4.T6.2.2.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.0%</td></tr>
