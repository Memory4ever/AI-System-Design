<span id="A3.T10.4.1.2.2.2.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A3.T10.m1" class="ltx_Math" alttext="-23.2\%" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mrow><mn>23.2</mn><mo>%</mo></mrow></mrow><annotation encoding="application/x-tex">-23.2\%</annotation></semantics></math></span></span>
