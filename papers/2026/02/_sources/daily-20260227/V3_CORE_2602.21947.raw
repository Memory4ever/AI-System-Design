<span id="A3.T10.4.1.2.2.3.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A3.T10.4.1.2.2.3.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">21.9%</span></span>
