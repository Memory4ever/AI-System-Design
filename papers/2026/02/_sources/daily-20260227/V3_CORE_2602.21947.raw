<td id="A5.T14.2.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T14.2.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Mean Difference</span></td>
<td id="A5.T14.2.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T14.2.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Corrected p-value</span></td>
<td id="A5.T14.2.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T14.2.1.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Cohen’s d</span></td>
<td id="A5.T14.2.1.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A5.T14.2.1.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Significant</span></td></tr>
<tr id="A5.T14.2.2" class="ltx_tr" style="--ltx-bg-color:#F2F2F2;">
<td id="A5.T14.2.2.1" class="ltx_td ltx_align_left"><span id="A5.T14.2.2.1.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">FCI vs LiNGAM</span></td>
<td id="A5.T14.2.2.2" class="ltx_td ltx_align_center"><span id="A5.T14.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">+0.125</span></td>
<td id="A5.T14.2.2.3" class="ltx_td ltx_align_center"><span id="A5.T14.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">0.013</span></td>
