<td id="A5.T14.2.2.5" class="ltx_td ltx_align_center"><span id="A5.T14.2.2.5.1" class="ltx_text" style="--ltx-bg-color:#F2F2F2;">Yes</span></td></tr>
<tr id="A5.T14.2.3" class="ltx_tr">
<td id="A5.T14.2.3.1" class="ltx_td ltx_align_left">LiNGAM vs PC</td>
<td id="A5.T14.2.3.2" class="ltx_td ltx_align_center">-0.126</td>
