<td id="S4.T6.2.1.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T6.2.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Precision</span></td>
<td id="S4.T6.2.1.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T6.2.1.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6E6;">Recall</span></td>
