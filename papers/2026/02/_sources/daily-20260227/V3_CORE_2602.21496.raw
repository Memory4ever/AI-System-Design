<td id="S4.T1.18.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="5"><span id="S4.T1.18.1.1.2.1" class="ltx_text ltx_font_bold">Privacy Metrics</span></td>
<td id="S4.T1.18.1.1.3" class="ltx_td ltx_align_center ltx_border_tt" colspan="3"><span id="S4.T1.18.1.1.3.1" class="ltx_text ltx_font_bold">Toxicity Score</span> <math id="S4.T1.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
