<th id="S5.T2.12.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2"><span id="S5.T2.12.1.1.2.1" class="ltx_text ltx_font_bold">Reasoning Mode</span></th>
<th id="S5.T2.12.1.1.3" class="ltx_td ltx_th ltx_th_column ltx_border_tt"></th>
