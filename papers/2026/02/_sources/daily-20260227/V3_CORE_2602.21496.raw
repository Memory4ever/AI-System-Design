<td id="S5.T2.12.1.4.6" class="ltx_td ltx_align_center"><span id="S5.T2.12.1.4.6.1" class="ltx_text ltx_font_bold">5.02</span></td></tr>
<tr id="S5.T2.12.1.5" class="ltx_tr">
