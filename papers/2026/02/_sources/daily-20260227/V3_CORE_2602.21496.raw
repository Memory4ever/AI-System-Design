<th id="S5.T2.12.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Utility <math id="S5.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th></tr>
