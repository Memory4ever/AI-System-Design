<td id="S5.T4.14.2.4" class="ltx_td ltx_align_center ltx_border_t">91.92%</td>
<td id="S5.T4.14.2.5" class="ltx_td ltx_align_center ltx_border_t">77.27%</td></tr>
<tr id="S5.T4.14.3" class="ltx_tr">
<th id="S5.T4.14.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S5.T4.14.3.1.1" class="ltx_text ltx_font_smallcaps">SemSIEdit</span></th>
<td id="S5.T4.14.3.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">99.50%</td>
