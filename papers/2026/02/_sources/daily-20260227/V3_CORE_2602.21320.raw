<tr id="S4.T2.2.1.3" class="ltx_tr">
<th id="S4.T2.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">Qwen2.5-1.5B-Instruct</th>
<th id="S4.T2.2.1.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">–</th>
<td id="S4.T2.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">35.96</td>
<td id="S4.T2.2.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">47.27</td>
<td id="S4.T2.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">17.61</td>
<td id="S4.T2.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">10.13</td>
<td id="S4.T2.2.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.75pt;padding-bottom:0.75pt;">4.29</td>
