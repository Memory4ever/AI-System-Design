<td id="A3.T4.2.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T4.2.1.2.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#B48C1E;">Generator</span></td>
<td id="A3.T4.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A3.T4.2.1.3.1" class="ltx_text ltx_font_typewriter ltx_font_bold" style="--ltx-fg-color:#28468C;">Solver</span></td></tr>
