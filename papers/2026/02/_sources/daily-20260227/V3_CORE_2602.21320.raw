<td id="A3.T4.2.5.3" class="ltx_td ltx_align_center"><math id="A3.T4.m2" class="ltx_Math" alttext="1\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-6}</annotation></semantics></math></td></tr>
<tr id="A3.T4.2.6" class="ltx_tr">
<th id="A3.T4.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Weight Decay</th>
<td id="A3.T4.2.6.2" class="ltx_td ltx_align_center"><math id="A3.T4.m3" class="ltx_Math" alttext="1\times 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-2}</annotation></semantics></math></td>
<td id="A3.T4.2.6.3" class="ltx_td ltx_align_center"><math id="A3.T4.m4" class="ltx_Math" alttext="1\times 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-2}</annotation></semantics></math></td></tr>
<tr id="A3.T4.2.7" class="ltx_tr">
<th id="A3.T4.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">KL Penalty Coefficient (<math id="A3.T4.m5" class="ltx_Math" alttext="\lambda_{\mathrm{KL}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mi>KL</mi></msub><annotation encoding="application/x-tex">\lambda_{\mathrm{KL}}</annotation></semantics></math>)</th>
<td id="A3.T4.2.7.2" class="ltx_td ltx_align_center"><math id="A3.T4.m6" class="ltx_Math" alttext="1\times 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-2}</annotation></semantics></math></td>
<td id="A3.T4.2.7.3" class="ltx_td ltx_align_center"><math id="A3.T4.m7" class="ltx_Math" alttext="1\times 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-2}</annotation></semantics></math></td></tr>
