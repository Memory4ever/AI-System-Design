</tbody>
</table>
</div>
<div id="p2" class="ltx_para">
<p id="p2.1" class="ltx_p ltx_align_center"><a href="https://github.com/emrecanacikgoz/Tool-R0" title="" class="ltx_ref ltx_href">
<span class="ltx_text" style="position:relative; bottom:-0.2pt;"><img src="2602.21320v1/sections/figures/github-logo.png" class="ltx_graphics ltx_img_square" style="aspect-ratio:19/19;" width="19" height="19" alt="[Uncaptioned image]"></span>
