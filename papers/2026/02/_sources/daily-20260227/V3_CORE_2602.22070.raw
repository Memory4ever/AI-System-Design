x1.91" class="ltx_text ltx_lst_identifier ltx_font_typewriter">rating</span><span id="lstnumberx1.92" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.93" class="ltx_text ltx_lst_identifier ltx_font_typewriter">for</span><span id="lstnumberx1.94" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.95" class="ltx_text ltx_lst_identifier ltx_font_typewriter">each</span><span id="lstnumberx1.96" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.97" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx1.98" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.99" class="ltx_text ltx_lst_identifier ltx_font_typewriter">the</span><span id="lstnumberx1.100" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.101" class="ltx_text ltx_lst_identifier ltx_font_typewriter">agents</span><span id="lstnumberx1.102" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.103" class="ltx_text ltx_lst_identifier ltx_font_typewriter">from</span><span id="lstnumberx1.104" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.105" class="ltx_text ltx_font_typewriter">1</span><span id="lstnumberx1.106" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.107" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.108" class="ltx_text ltx_lst_identifier ltx_font_typewriter">would</span><span id="lstnumberx1.109" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.110" class="ltx_text ltx_lst_identifier ltx_font_typewriter">not</span><span id="lstnumberx1.111" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.112" class="ltx_text ltx_lst_identifier ltx_font_typewriter">trust</span><span id="lstnumberx1.113" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.114" class="ltx_text ltx_lst_identifier ltx_font_typewriter">agent</span><span id="lstnumberx1.115" class="ltx_text ltx_font_typewriter">)</span><span id="lstnumberx1.116" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.117" class="ltx_text ltx_lst_identifier ltx_font_typewriter">to</span><span id="lstnumberx1.118" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.119" class="ltx_text ltx_font_typewriter">100</span><span id="lstnumberx1.120" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.121" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx1.122" class="ltx_text ltx_lst_identifier ltx_font_typewriter">would</span><span id="lstnumberx1.123" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.124" class="ltx_text ltx_lst_identifier ltx_font_typewriter">definitely</span><span id="lstnumberx1.125" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.126" class="ltx_text ltx_lst_identifier ltx_font_typewriter">trust</span><span id="lstnumberx1.127" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.128" class="ltx_text ltx_lst_identifier ltx_font_typewriter">agent</span><span id="lstnumberx1.129" class="ltx_text ltx_font_typewriter">).</span><span id="lstnumberx1.130" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.131" class="ltx_text ltx_lst_identifier ltx_font_typewriter">The</span><span id="lstnumberx1.132" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.133" class="ltx_text ltx_lst_identifier ltx_font_typewriter">tasks</span><span id="lstnumberx1.134" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx1.135" class="ltx_text ltx_lst_identifier ltx_font_typewriter">are</span><span id="lstnumberx1.136" class="ltx_text ltx_font_typewriter">:</span>
