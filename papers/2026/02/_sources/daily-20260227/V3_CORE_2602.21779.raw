<td id="S1.T1.5.1.9.5" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.9.5.1" class="ltx_text" style="font-size:80%;">1</span></td>
<td id="S1.T1.5.1.9.6" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.9.6.1" class="ltx_text" style="font-size:80%;">-</span></td></tr>
