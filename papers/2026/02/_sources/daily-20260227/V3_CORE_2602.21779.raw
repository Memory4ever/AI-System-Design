<td id="S8.T10.5.1.11.2" class="ltx_td ltx_align_center"><math id="S8.T10.m8" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="S8.T10.5.1.12" class="ltx_tr">
<th id="S8.T10.5.1.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Total GPUs Used</th>
<td id="S8.T10.5.1.12.2" class="ltx_td ltx_align_center"><math id="S8.T10.m9" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math></td></tr>
<tr id="S8.T10.5.1.13" class="ltx_tr">
<th id="S8.T10.5.1.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Learning Rate (LR)</th>
<td id="S8.T10.5.1.13.2" class="ltx_td ltx_align_center"><math id="S8.T10.m10" class="ltx_Math" alttext="1\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="S8.T10.5.1.14" class="ltx_tr">
<th id="S8.T10.5.1.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">LR Scheduler</th>
