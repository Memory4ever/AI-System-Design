<td id="S1.T1.5.1.7.4" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.7.4.1" class="ltx_text" style="font-size:80%;">A</span></td>
<td id="S1.T1.5.1.7.5" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.7.5.1" class="ltx_text" style="font-size:80%;">2</span></td>
<td id="S1.T1.5.1.7.6" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.7.6.1" class="ltx_text" style="font-size:80%;">-</span></td></tr>
<tr id="S1.T1.5.1.8" class="ltx_tr">
