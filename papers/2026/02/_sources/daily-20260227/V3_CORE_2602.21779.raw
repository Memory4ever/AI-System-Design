<tr id="S1.T1.5.1.9" class="ltx_tr">
<td id="S1.T1.5.1.9.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.9.1.1" class="ltx_text" style="font-size:80%;">GenVideo </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.1.9.1.2" class="ltx_text" style="font-size:80%;">[</span><a href="#bib.bib36" title="" class="ltx_ref">4</a><span id="S1.T1.5.1.9.1.3" class="ltx_text" style="font-size:80%;">]</span></cite></td>
<td id="S1.T1.5.1.9.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.9.2.1" class="ltx_text" style="font-size:80%;">-</span></td>
<td id="S1.T1.5.1.9.3" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S1.T1.5.1.9.3.1" class="ltx_text" style="font-size:80%;">2,294,594</span></td>
