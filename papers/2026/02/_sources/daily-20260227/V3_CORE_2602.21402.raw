<th id="S3.T1.8.3.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.8.3.6.1" class="ltx_text" style="font-size:70%;">-</span></th>
