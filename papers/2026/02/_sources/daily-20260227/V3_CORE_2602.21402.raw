<td id="S5.T2.8.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.8.3.3.1" class="ltx_text" style="font-size:80%;">46.6%</span></td>
<td id="S5.T2.8.3.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S5.T2.8.3.4.1" class="ltx_text" style="font-size:80%;">4.2%</span></td></tr>
