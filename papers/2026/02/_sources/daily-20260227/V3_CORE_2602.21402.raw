</thead>
<tbody class="ltx_tbody">
<tr id="S3.T1.8.4" class="ltx_tr">
<th id="S3.T1.8.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.8.4.1.1" class="ltx_text" style="font-size:70%;">Text-based editing <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib33" title="" class="ltx_ref">19</a>]</cite></span></th>
<td id="S3.T1.8.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="S3.T1.8.4.2.1" class="ltx_text" style="font-size:70%;">7.5</span></td>
