        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.18757">pdf</a>, <a href="https://arxiv.org/ps/2602.18757">ps</a>, <a href="https://arxiv.org/format/2602.18757">other</a>]&nbsp;</span>
