      <a href="/search/?searchtype=author&amp;query=An%2C+J">Jisu An</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kimm%2C+S+M">Soo Min Kimm</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+J">Jaejoon Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Pahk%2C+J">Jinu Pahk</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Kim%2C+B">Byungju Kim</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lee%2C+J">Junseok Lee</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Baek%2C+N">Namheon Baek</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ha%2C+S">Sungwan Ha</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Baek%2C+H">Hojun Baek</a>, 
      
