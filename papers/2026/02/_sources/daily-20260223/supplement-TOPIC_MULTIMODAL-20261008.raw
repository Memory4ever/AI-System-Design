        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.18869">pdf</a>, <a href="https://arxiv.org/ps/2602.18869">ps</a>, <a href="https://arxiv.org/format/2602.18869">other</a>]&nbsp;</span>
