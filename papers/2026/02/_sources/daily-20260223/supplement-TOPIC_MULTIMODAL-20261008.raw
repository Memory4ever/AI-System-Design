        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.18955">pdf</a>, <a href="https://arxiv.org/ps/2602.18955">ps</a>, <a href="https://arxiv.org/format/2602.18955">other</a>]&nbsp;</span>
