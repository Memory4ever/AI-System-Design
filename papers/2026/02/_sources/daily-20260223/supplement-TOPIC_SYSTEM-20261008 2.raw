        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.20191">pdf</a>, <a href="https://arxiv.org/ps/2602.20191">ps</a>, <a href="https://arxiv.org/format/2602.20191">other</a>]&nbsp;</span>
