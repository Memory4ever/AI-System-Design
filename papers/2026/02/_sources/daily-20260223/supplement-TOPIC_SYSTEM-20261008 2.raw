        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.19044">pdf</a>, <a href="https://arxiv.org/ps/2602.19044">ps</a>, <a href="https://arxiv.org/format/2602.19044">other</a>]&nbsp;</span>
