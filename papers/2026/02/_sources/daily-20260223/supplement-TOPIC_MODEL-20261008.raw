        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.18952">pdf</a>, <a href="https://arxiv.org/ps/2602.18952">ps</a>, <a href="https://arxiv.org/format/2602.18952">other</a>]&nbsp;</span>
