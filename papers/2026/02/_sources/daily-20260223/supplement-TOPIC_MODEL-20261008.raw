        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.18913">pdf</a>, <a href="https://arxiv.org/ps/2602.18913">ps</a>, <a href="https://arxiv.org/format/2602.18913">other</a>]&nbsp;</span>
      </p>
      <div class="tags is-inline-block">
