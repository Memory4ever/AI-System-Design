    <p class="title is-5 mathjax">
      
        MagicAgent: Towards Generalized Agent Planning
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Ren%2C+X">Xuhui Ren</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dong%2C+S">Shaokang Dong</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yang%2C+C">Chen Yang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Gao%2C+Q">Qing Gao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Zhao%2C+Y">Yunbin Zhao</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Liu%2C+Y">Yongsheng Liu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Geng%2C+X">Xinwei Geng</a>, 
      
