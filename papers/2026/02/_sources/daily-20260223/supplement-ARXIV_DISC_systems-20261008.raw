      <a href="/search/?searchtype=author&amp;query=Zhang%2C+J">Jiajun Zhang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Wang%2C+G">Guangting Wang</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Lyu%2C+J">Jing Lyu</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Yuan%2C+C">Chun Yuan</a>, 
      
