    <p class="title is-5 mathjax">
      
        DREAM: Deep Research Evaluation with Agentic Metrics
      
    </p>
    <p class="authors">
      <span class="has-text-black-bis has-text-weight-semibold">Authors:</span>
      
      <a href="/search/?searchtype=author&amp;query=Avraham%2C+E+B">Elad Ben Avraham</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Li%2C+C">Changhao Li</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Dorfman%2C+R">Ron Dorfman</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Ganz%2C+R">Roy Ganz</a>, 
      
      <a href="/search/?searchtype=author&amp;query=Nuriel%2C+O">Oren Nuriel</a>, 
      
