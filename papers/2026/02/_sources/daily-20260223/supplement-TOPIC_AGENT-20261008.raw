          <div class="is-inline-block" style="margin-left: 0.5rem">
            <div class="tags has-addons">
              <span class="tag is-dark is-size-7">doi</span>
              <span class="tag is-light is-size-7"><a class="" href="https://doi.org/10.1145/3776574.3831126">10.1145/3776574.3831126 <i class="fa fa-external-link" aria-hidden="true"></i></a></span>
