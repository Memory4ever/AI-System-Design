  <li class="arxiv-result">
    <div class="is-marginless">
      <p class="list-title is-inline-block"><a href="https://arxiv.org/abs/2602.19016">arXiv:2602.19016</a>
        <span>&nbsp;[<a href="https://arxiv.org/pdf/2602.19016">pdf</a>, <a href="https://arxiv.org/ps/2602.19016">ps</a>, <a href="https://arxiv.org/format/2602.19016">other</a>]&nbsp;</span>
