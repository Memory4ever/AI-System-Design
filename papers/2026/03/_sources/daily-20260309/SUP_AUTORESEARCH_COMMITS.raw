  {
    "sha": "09ebea439db47bf08f925fc1654dc30415a58c64",
    "node_id": "C_kwDORgZXs9oAKDA5ZWJlYTQzOWRiNDdiZjA4ZjkyNWZjMTY1NGRjMzA0MTVhNThjNjQ",
    "commit": {
      "author": {
        "name": "Hugh Brown",
        "email": "hughdbrown@yahoo.com",
        "date": "2026-03-11T03:34:40Z"
      },
      "committer": {
        "name": "Hugh Brown",
        "email": "hughdbrown@yahoo.com",
        "date": "2026-03-11T03:34:40Z"
      },
      "message": "Guard against infinite loop when no training shards exist, fix README typo\n\nAdd assertion after filtering val_path from parquet_paths for the \"train\"\nsplit so an empty list fails fast instead of spinning in a silent infinite\nloop. Also remove stray article \"a\" in README (\"a three files\" → \"three\nfiles\").\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>",
      "tree": {
