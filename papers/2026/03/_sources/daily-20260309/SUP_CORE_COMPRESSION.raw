<figure id="A5.T2" class="ltx_figure ltx_figure_panel ltx_align_center ltx_align_middle" style="width:165.6pt;">
<table id="A5.T2.1" class="ltx_tabular ltx_centering ltx_figure_panel ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A5.T2.1.1" class="ltx_tr">
<th id="A5.T2.1.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt" colspan="2"><span id="A5.T2.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Training</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T2.1.2" class="ltx_tr">
<th id="A5.T2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A5.T2.1.2.1.1" class="ltx_text" style="font-size:90%;">Video</span></th>
<td id="A5.T2.1.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="A5.T2.1.2.2.1" class="ltx_text" style="font-size:90%;">Beauty from </span><cite class="ltx_cite ltx_citemacro_citep"><span id="A5.T2.1.2.2.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib48" title="" class="ltx_ref">Mercat et al., 2020</a><span id="A5.T2.1.2.2.4" class="ltx_text" style="font-size:90%;">)</span></cite></td></tr>
<tr id="A5.T2.1.3" class="ltx_tr">
<th id="A5.T2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A5.T2.1.3.1.1" class="ltx_text" style="font-size:90%;">Resolution</span></th>
<td id="A5.T2.1.3.2" class="ltx_td ltx_align_left"><span id="A5.T2.1.3.2.1" class="ltx_text" style="font-size:90%;">Cropped and resized to 832x480x81</span></td></tr>
