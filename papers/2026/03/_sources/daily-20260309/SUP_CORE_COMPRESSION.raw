<td id="A5.T1.1.8.2" class="ltx_td ltx_align_left"><math id="A5.SS1.m3" class="ltx_Math" alttext="2^{15}" display="inline" intent=":literal"><semantics><msup><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">15</mn></msup><annotation encoding="application/x-tex">2^{15}</annotation></semantics></math><span id="A5.T1.1.8.2.1" class="ltx_text" style="font-size:90%;"> / </span><math id="A5.SS1.m4" class="ltx_Math" alttext="2^{16}" display="inline" intent=":literal"><semantics><msup><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">16</mn></msup><annotation encoding="application/x-tex">2^{16}</annotation></semantics></math><span id="A5.T1.1.8.2.2" class="ltx_text" style="font-size:90%;"> / </span><math id="A5.SS1.m5" class="ltx_Math" alttext="2^{17}" display="inline" intent=":literal"><semantics><msup><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">17</mn></msup><annotation encoding="application/x-tex">2^{17}</annotation></semantics></math><span id="A5.T1.1.8.2.3" class="ltx_text" style="font-size:90%;"> / </span><math id="A5.SS1.m6" class="ltx_Math" alttext="2^{18}" display="inline" intent=":literal"><semantics><msup><mn mathsize="0.900em">2</mn><mn mathsize="0.900em">18</mn></msup><annotation encoding="application/x-tex">2^{18}</annotation></semantics></math></td></tr>
