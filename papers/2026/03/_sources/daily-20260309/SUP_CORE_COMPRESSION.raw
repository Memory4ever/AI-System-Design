time grids <math id="alg1.l0.m3" class="ltx_Math" alttext="0=t_{0}&lt;\cdots&lt;t_{N}=1" display="inline" intent=":literal"><semantics><mrow><mn>0</mn><mo>=</mo><msub><mi>t</mi><mn>0</mn></msub><mo rspace="0.1389em">&lt;</mo><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mo lspace="0.1389em">&lt;</mo><msub><mi>t</mi><mi>N</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">0=t_{0}&lt;\cdots&lt;t_{N}=1</annotation></semantics></math>; number of candidates <math id="alg1.l0.m4" class="ltx_Math" alttext="M" display="inline" intent=":literal"><semantics><mi>M</mi><annotation encoding="application/x-tex">M</annotation></semantics></math>; shared PRNG.

