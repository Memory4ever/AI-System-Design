<td id="S3.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m1" class="ltx_Math" alttext="0.33" display="inline" intent=":literal"><semantics><mn>0.33</mn><annotation encoding="application/x-tex">0.33</annotation></semantics></math></td>
<td id="S3.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="S3.T1.m2" class="ltx_Math" alttext="0.33" display="inline" intent=":literal"><semantics><mn>0.33</mn><annotation encoding="application/x-tex">0.33</annotation></semantics></math></td></tr>
