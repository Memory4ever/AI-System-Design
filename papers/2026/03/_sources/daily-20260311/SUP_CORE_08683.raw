<td id="S4.T1.2.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.2.1.7.1" class="ltx_text ltx_font_bold">Standard</span></td>
<td id="S4.T1.2.1.8" class="ltx_td ltx_align_center ltx_border_rr ltx_border_tt"><span id="S4.T1.2.1.8.1" class="ltx_text ltx_font_bold">Trilobyte</span></td>
<td id="S4.T1.2.1.9" class="ltx_td ltx_align_center ltx_border_tt"><span id="S4.T1.2.1.9.1" class="ltx_text ltx_font_bold">Transfer</span></td></tr>
<tr id="S4.T1.2.2" class="ltx_tr">
<td id="S4.T1.2.2.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="3"><span id="S4.T1.2.2.1.1" class="ltx_text">8</span></td>
<td id="S4.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t">16000 / 1</td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_left ltx_border_t">Speech</td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_left ltx_border_r ltx_border_t">SC09</td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t">0.95</td>
