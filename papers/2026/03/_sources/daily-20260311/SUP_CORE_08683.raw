<td id="S4.T1.2.2.7" class="ltx_td ltx_align_center ltx_border_t">2.08</td>
<td id="S4.T1.2.2.8" class="ltx_td ltx_align_center ltx_border_rr ltx_border_t">2.08</td>
<td id="S4.T1.2.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T1.2.2.9.1" class="ltx_text ltx_font_bold">2.88</span></td></tr>
<tr id="S4.T1.2.3" class="ltx_tr">
<td id="S4.T1.2.3.1" class="ltx_td ltx_align_center">16000 / 1</td>
<td id="S4.T1.2.3.2" class="ltx_td ltx_align_left">Music</td>
<td id="S4.T1.2.3.3" class="ltx_td ltx_align_left ltx_border_r">Beethoven</td>
<td id="S4.T1.2.3.4" class="ltx_td ltx_align_center">1.69</td>
