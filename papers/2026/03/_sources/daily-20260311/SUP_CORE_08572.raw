<tr id="S4.T3.5.1.4" class="ltx_tr">
<td id="S4.T3.5.1.4.1" class="ltx_td ltx_nopad_r ltx_align_left">w/o VLM</td>
<td id="S4.T3.5.1.4.2" class="ltx_td ltx_align_center"><math id="S4.T3.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="S4.T3.5.1.4.3" class="ltx_td ltx_align_center">NULL</td>
<td id="S4.T3.5.1.4.4" class="ltx_td ltx_align_center">NULL</td></tr>
<tr id="S4.T3.5.1.5" class="ltx_tr">
