<tr id="S5.T2.8.1.8" class="ltx_tr" style="--ltx-bg-color:#E6E6E6;">
<th id="S5.T2.8.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:1pt;padding-bottom:1pt;"><span id="S5.T2.8.1.8.1.1" class="ltx_text ltx_font_italic" style="--ltx-bg-color:#E6E6E6;">32B/72B Models</span></th>
