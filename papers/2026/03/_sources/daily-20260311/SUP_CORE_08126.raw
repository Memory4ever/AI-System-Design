<td id="S4.T3.5.1.7.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.5.1.7.4.1" class="ltx_text ltx_font_bold">0.52</span></td>
<td id="S4.T3.5.1.7.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T3.5.1.7.5.1" class="ltx_text ltx_font_bold">98.97</span></td></tr>
