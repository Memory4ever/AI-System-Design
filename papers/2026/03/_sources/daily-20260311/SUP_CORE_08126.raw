<td id="S4.T5.5.1.5.2" class="ltx_td ltx_align_center"><span id="S4.T5.5.1.5.2.1" class="ltx_text ltx_font_bold">0.97</span></td>
<td id="S4.T5.5.1.5.3" class="ltx_td ltx_align_center"><span id="S4.T5.5.1.5.3.1" class="ltx_text ltx_font_bold">0.52</span></td>
<td id="S4.T5.5.1.5.4" class="ltx_td ltx_align_center"><span id="S4.T5.5.1.5.4.1" class="ltx_text ltx_font_bold">98.97</span></td></tr>
