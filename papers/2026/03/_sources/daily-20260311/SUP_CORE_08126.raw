<tr id="S4.T4.5.1.2" class="ltx_tr">
<th id="S4.T4.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">DCF</th>
<td id="S4.T4.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">1.28</td>
<td id="S4.T4.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">0.85</td>
<td id="S4.T4.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">97.73</td></tr>
