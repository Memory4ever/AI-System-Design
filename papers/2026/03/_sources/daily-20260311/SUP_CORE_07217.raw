<th id="S11.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt" colspan="3"><span id="S11.T6.2.1.2.1" class="ltx_text ltx_font_bold">+PFC only</span></th></tr>
