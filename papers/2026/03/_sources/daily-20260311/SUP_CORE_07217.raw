<th id="S2.T1.2.1.1.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt">Mathematical role</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S2.T1.2.1.2" class="ltx_tr">
<td id="S2.T1.2.1.2.1" class="ltx_td ltx_align_left ltx_border_t">Sensory cortex</td>
<td id="S2.T1.2.1.2.2" class="ltx_td ltx_align_left ltx_border_t">Input encoding</td>
