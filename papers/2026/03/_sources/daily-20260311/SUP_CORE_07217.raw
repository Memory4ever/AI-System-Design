<td id="S2.T1.2.1.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><math id="S2.T1.m4" class="ltx_Math" alttext="Z_{t}\in\mathbb{R}^{n\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mi>t</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z_{t}\in\mathbb{R}^{n\times d}</annotation></semantics></math></td></tr>
