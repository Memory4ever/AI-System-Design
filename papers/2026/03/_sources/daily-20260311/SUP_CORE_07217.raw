<td id="S2.T1.2.1.6.4" class="ltx_td ltx_nopad_r ltx_align_left"><math id="S2.T1.m14" class="ltx_Math" alttext="s\,A_{b}^{\top}A_{b}V_{\bar{b}}W_{\bar{b}b}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>A</mi><mi>b</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>A</mi><mi>b</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>V</mi><mover accent="true"><mi>b</mi><mo>¯</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mover accent="true"><mi>b</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mi>b</mi></mrow></msub></mrow><annotation encoding="application/x-tex">s\,A_{b}^{\top}A_{b}V_{\bar{b}}W_{\bar{b}b}</annotation></semantics></math></td></tr>
<tr id="S2.T1.2.1.7" class="ltx_tr">
