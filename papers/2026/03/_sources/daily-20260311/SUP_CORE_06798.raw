<span id="S1.T1.2.14.1.1" class="ltx_inline-block ltx_align_middle" style="width:487.8pt;">
<span id="S1.T1.2.14.1.1.1" class="ltx_p ltx_align_left"><span id="S1.T1.2.14.1.1.1.1" class="ltx_text ltx_font_bold">Optimality Guarantees</span></span>
</span></td>
<td id="S1.T1.2.14.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="padding-top:-3.5pt;padding-bottom:-3.5pt;">
