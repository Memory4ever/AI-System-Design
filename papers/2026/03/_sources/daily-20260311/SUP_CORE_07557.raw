<td id="S5.T5.2.1.6.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S5.T5.2.1.6.3.1" class="ltx_text ltx_font_bold" style="font-size:50%;">16</span></td>
