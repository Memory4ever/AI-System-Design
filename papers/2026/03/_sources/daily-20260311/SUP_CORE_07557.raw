<td id="A2.T11.2.1.4.3" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding-top:0.65pt;padding-bottom:0.65pt;">
<span id="A2.T11.2.1.4.3.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
<span id="A2.T11.2.1.4.3.1.1" class="ltx_p ltx_align_left"><span id="A2.T11.2.1.4.3.1.1.1" class="ltx_text" style="font-size:80%;">chrome_fill_or_select, chrome_bookmark_add, publish_content, post_comment_to_feed, reply_comment_in_feed, send_message</span></span>
</span></td></tr>
<tr id="A2.T11.2.1.5" class="ltx_tr">
<td id="A2.T11.2.1.5.1" class="ltx_td ltx_align_left ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.65pt;padding-bottom:0.65pt;"><span id="A2.T11.2.1.5.1.1" class="ltx_text" style="font-size:80%;">Data Management &amp; Analysis</span></td>
<td id="A2.T11.2.1.5.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_b ltx_border_r ltx_border_t" style="padding-top:0.65pt;padding-bottom:0.65pt;">
<span id="A2.T11.2.1.5.2.1" class="ltx_inline-block ltx_align_top" style="width:170.7pt;">
