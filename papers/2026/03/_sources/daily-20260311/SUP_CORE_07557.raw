<td id="A1.T9.2.1.4.1" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="A1.T9.m5" class="ltx_Math" alttext="Input(Type_{B})\in elem(Return(Type_{A}))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>B</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Input(Type_{B})\in elem(Return(Type_{A}))</annotation></semantics></math></td>
<td id="A1.T9.2.1.4.2" class="ltx_td ltx_align_center" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="A1.T9.m6" class="ltx_Math" alttext="Input(\text{str})\in elem(Return(\text{List}[\text{str}]))" display="inline" intent=":literal"><semantics><mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>str</mtext><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mtext>List</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mtext>str</mtext><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Input(\text{str})\in elem(Return(\text{List}[\text{str}]))</annotation></semantics></math></td></tr>
<tr id="A1.T9.2.1.5" class="ltx_tr">
<td id="A1.T9.2.1.5.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;">Type Conversion</td>
<td id="A1.T9.2.1.5.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="A1.T9.m7" class="ltx_Math" alttext="Return(Type_{A})\rightarrow Input(Type_{B})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>A</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>e</mi><mi>B</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Return(Type_{A})\rightarrow Input(Type_{B})</annotation></semantics></math></td>
<td id="A1.T9.2.1.5.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_t" style="padding-top:1.5pt;padding-bottom:1.5pt;"><math id="A1.T9.m8" class="ltx_Math" alttext="Return(\text{str(JSON)})\rightarrow Input(\text{dict})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>str(JSON)</mtext><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>dict</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Return(\text{str(JSON)})\rightarrow Input(\text{dict})</annotation></semantics></math></td></tr>
</table>
</span></div>
</figure>
<div id="A1.SS1.p1" class="ltx_para">
<p id="A1.SS1.p1.1" class="ltx_p">Table<a href="#A1.T9" title="Table 9 ‣ Appendix A.1. Compatible Func Pair Extraction ‣ Appendix Appendix A Details of AgentRaft ‣ AgentRaft: Automated Detection of Data Over-Exposure in LLM Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a> presents the judgment rules for type dependencies between function return values and inputs, including three core relationship types (type equivalence, type subset, and type conversion), along with corresponding judgment methods and specific examples to clarify the application scenarios of each rule.</p>
</div>
</section>
<section id="A1.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">Appendix A.2. </span>Algorithm of <span id="A1.SS2.2" class="ltx_text ltx_font_italic">AgentRaft</span></h3>

<div id="A1.SS2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.p1.1" class="ltx_p"><span id="A1.SS2.p1.1.1" class="ltx_text ltx_font_bold">Taint Propagation Algorithm Notations.</span> To formalize the LA-DTP algorithm, we define a set of core variables and symbols. We denote <math id="A1.SS2.p1.m1" class="ltx_Math" alttext="Trace" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow><annotation encoding="application/x-tex">Trace</annotation></semantics></math> as the sequential log of tool invocations that captures function names, input arguments, and return values for each execution step. <math id="A1.SS2.p1.m2" class="ltx_Math" alttext="D_{total}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">D_{total}</annotation></semantics></math> represents the complete, unfiltered dataset retrieved by a source function, while <math id="A1.SS2.p1.m3" class="ltx_Math" alttext="D_{int}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">D_{int}</annotation></semantics></math> is the fine-grained subset explicitly authorized by the user for transmission. The algorithm maintains a dynamic Taint Table <math id="A1.SS2.p1.m4" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> to track security labels (i.e., <span id="A1.SS2.p1.1.2" class="ltx_text ltx_font_italic">target</span> or <span id="A1.SS2.p1.1.3" class="ltx_text ltx_font_italic">clean</span>) for each data field throughout the execution. To capture semantic-level data flow, we introduce the semantic dependency function <math id="A1.SS2.p1.m5" class="ltx_Math" alttext="\Phi(a,f)" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Φ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Phi(a,f)</annotation></semantics></math>, which determines whether a field <math id="A1.SS2.p1.m6" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> is semantically derived from or associated with a previously observed field <math id="A1.SS2.p1.m7" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>. Furthermore, <math id="A1.SS2.p1.m8" class="ltx_Math" alttext="D_{nec}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">D_{nec}</annotation></semantics></math> denotes the minimum required data fields necessary to fulfill the operational goals of a specific sink function. Finally, the over-exposure set <math id="A1.SS2.p1.m9" class="ltx_Math" alttext="D_{OE}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>O</mi><mo lspace="0em" rspace="0em">​</mo><mi>E</mi></mrow></msub><annotation encoding="application/x-tex">D_{OE}</annotation></semantics></math> is defined as the collection of sensitive data fields that are neither intended by the user (<math id="A1.SS2.p1.m10" class="ltx_Math" alttext="D_{int}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">D_{int}</annotation></semantics></math>) nor required for functional necessity (<math id="A1.SS2.p1.m11" class="ltx_Math" alttext="D_{nec}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><annotation encoding="application/x-tex">D_{nec}</annotation></semantics></math>).</p>
</div>
<div id="A1.SS2.p2" class="ltx_para">
<p id="A1.SS2.p2.1" class="ltx_p"><a href="#alg1" title="In Appendix A.2. Algorithm of AgentRaft ‣ Appendix Appendix A Details of AgentRaft ‣ AgentRaft: Automated Detection of Data Over-Exposure in LLM Agents" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Algorithm</span> <span class="ltx_text ltx_ref_tag">1</span></a> is designed for dynamic tracking of the data flow in the execution process of LLM Agent. It implements accurate preprocess identification of Data Over-Exposure (DOE) by differentiating over-exposed candidates from user-intended data and functionally necessary data in the flow. The over-exposure candidates that identified by the algorithm will sent to <span id="A1.SS2.p2.1.1" class="ltx_text ltx_font_italic">Over-Exposure Judge</span> module.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption" style="font-size:80%;"><span class="ltx_tag ltx_tag_float"><span id="alg1.5" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> LLM Agent Dynamic Taint Propagation (LA-DTP)</figcaption>
<div id="alg1.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            <math id="alg1.l1.m1" class="ltx_Math" alttext="Trace,D_{total},D_{int},Regs" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">D</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">D</mi><mrow><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow></mrow><annotation encoding="application/x-tex">Trace,D_{total},D_{int},Regs</annotation></semantics></math><span id="alg1.l1.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <math id="alg1.l2.m1" class="ltx_Math" alttext="D_{OE}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">D</mi><mrow><mi mathsize="0.800em">O</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">E</mi></mrow></msub><annotation encoding="application/x-tex">D_{OE}</annotation></semantics></math><span id="alg1.l2.3" class="ltx_text" style="font-size:80%;">
</span>
</div>
