<th id="A5.T5.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="A5.T5.2.1.2.1" class="ltx_text ltx_font_bold">Macro F1</span></th>
<th id="A5.T5.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="A5.T5.2.1.3.1" class="ltx_text ltx_font_bold">Std. Error</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A5.T5.2.2" class="ltx_tr">
<th id="A5.T5.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Original</th>
<td id="A5.T5.2.2.2" class="ltx_td ltx_align_right ltx_border_t">78.4</td>
<td id="A5.T5.2.2.3" class="ltx_td ltx_align_right ltx_border_t">1.3</td></tr>
<tr id="A5.T5.2.3" class="ltx_tr">
<th id="A5.T5.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Across-category</th>
<td id="A5.T5.2.3.2" class="ltx_td ltx_align_right">50.0</td>
<td id="A5.T5.2.3.3" class="ltx_td ltx_align_right">0.6</td></tr>
<tr id="A5.T5.2.4" class="ltx_tr">
<th id="A5.T5.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Within-category</th>
