            Initialize <math id="alg1.l2.m1" class="ltx_Math" alttext="R\leftarrow[\mathrm{mask}]\times L_{R}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">[</mo><mi>mask</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow><mo rspace="0.222em">×</mo><msub><mi>L</mi><mi>R</mi></msub></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow[\mathrm{mask}]\times L_{R}</annotation></semantics></math>

