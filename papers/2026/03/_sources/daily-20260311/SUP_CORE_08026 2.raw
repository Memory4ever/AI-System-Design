</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
              <math id="alg1.l20.m1" class="ltx_Math" alttext="(\text{decoded\_tokens},\text{decoded\_positions})\leftarrow\mathrm{process\_logit}(x)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mtext>decoded_tokens</mtext><mo>,</mo><mtext>decoded_positions</mtext><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mi>process</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>logit</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(\text{decoded\_tokens},\text{decoded\_positions})\leftarrow\mathrm{process\_logit}(x)</annotation></semantics></math>

</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
              
              <math id="alg1.l21.m1" class="ltx_Math" alttext="R[\text{decoded\_positions}]\leftarrow\text{decoded\_tokens}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mtext>decoded_positions</mtext><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mtext>decoded_tokens</mtext></mrow><annotation encoding="application/x-tex">R[\text{decoded\_positions}]\leftarrow\text{decoded\_tokens}</annotation></semantics></math>

</div>
<div id="alg1.l22" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l22.1" class="ltx_text" style="font-size:80%;">22:</span></span>
              
              
            <span id="alg1.l22.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l22.4" class="ltx_text ltx_font_bold">for</span>
</div>
</div>
</figure>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Full Step</h3>

<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">FullStep follows the standard transformer forward pass but adds activation caching algorithm, which takes all tokens including prompt <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and response <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> as an input.
Unlike KV caching in AR models, FullStep additionally caches the attention context and FFN output, as depicted in Algorithm <a href="#alg2" title="Algorithm 2 ‣ C.2 Full Step ‣ Appendix C Core Algorithm of DyLLM ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>. Those caches <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="\mathbf{K_{cache},V_{cache},C_{cache}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>𝐜𝐚𝐜𝐡𝐞</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mi>𝐜𝐚𝐜𝐡𝐞</mi></msub><mo>,</mo><msub><mi>𝐂</mi><mi>𝐜𝐚𝐜𝐡𝐞</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{K_{cache},V_{cache},C_{cache}}</annotation></semantics></math>, and <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="\mathbf{FFN\_OUT_{cache}}" display="inline" intent=":literal"><semantics><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>𝐜𝐚𝐜𝐡𝐞</mi></msub></mrow><annotation encoding="application/x-tex">\mathbf{FFN\_OUT_{cache}}</annotation></semantics></math> are reused at the SparseStep.</p>
</div>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.4" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> <span id="alg2.5" class="ltx_text ltx_font_smallcaps">FullStep</span></figcaption>
<div id="alg2.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Token ids <math id="alg2.l1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> of length <math id="alg2.l1.m2" class="ltx_Math" alttext="L_{P}+L_{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>P</mi></msub><mo>+</mo><msub><mi>L</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">L_{P}+L_{R}</annotation></semantics></math>; caches <math id="alg2.l1.m3" class="ltx_Math" alttext="\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐂</mi><mi>cache</mi></msub><mo>,</mo><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>cache</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <math id="alg2.l2.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathrm{Embedding}(x)" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mi>Embedding</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathrm{Embedding}(x)</annotation></semantics></math>

</div>
<div id="alg2.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg2.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l3.m1" class="ltx_Math" alttext="l=1" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">l=1</annotation></semantics></math> <span id="alg2.l3.4" class="ltx_text ltx_font_bold">to</span> <math id="alg2.l3.m2" class="ltx_Math" alttext="n_{\mathrm{layer}}" display="inline" intent=":literal"><semantics><msub><mi>n</mi><mi>layer</mi></msub><annotation encoding="application/x-tex">n_{\mathrm{layer}}</annotation></semantics></math> <span id="alg2.l3.5" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg2.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <math id="alg2.l4.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mi>LayerNorm</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathbf{x})</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <math id="alg2.l5.m1" class="ltx_Math" alttext="\mathbf{Q},\mathbf{K},\mathbf{V}\leftarrow\mathrm{Q\_Proj}(\mathbf{x}),\mathrm{K\_Proj}(\mathbf{x}),\mathrm{V\_Proj}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>,</mo><mi>𝐊</mi><mo>,</mo><mrow><mi>𝐕</mi><mo stretchy="false">←</mo><mrow><mi>Q</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>Proj</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>Proj</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>V</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>Proj</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{Q},\mathbf{K},\mathbf{V}\leftarrow\mathrm{Q\_Proj}(\mathbf{x}),\mathrm{K\_Proj}(\mathbf{x}),\mathrm{V\_Proj}(\mathbf{x})</annotation></semantics></math> <math id="alg2.l5.m2" class="ltx_math_unparsed" alttext="\quad{\color[rgb]{0,0,1}//\ [L_{P}+L_{R},d_{hidden}]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0em">/</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.722em">/</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">P</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">h</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi></mrow></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\quad{\color[rgb]{0,0,1}//\ [L_{P}+L_{R},d_{hidden}]}</annotation></semantics></math>

</div>
<div id="alg2.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <math id="alg2.l6.m1" class="ltx_Math" alttext="\mathbf{C}\leftarrow\mathrm{Attention}(\mathbf{Q},\mathbf{K},\mathbf{V})" display="inline" intent=":literal"><semantics><mrow><mi>𝐂</mi><mo stretchy="false">←</mo><mrow><mi>Attention</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐐</mi><mo>,</mo><mi>𝐊</mi><mo>,</mo><mi>𝐕</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{C}\leftarrow\mathrm{Attention}(\mathbf{Q},\mathbf{K},\mathbf{V})</annotation></semantics></math>

</div>
<div id="alg2.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <math id="alg2.l7.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathrm{Out\_Proj}(\mathbf{C}))" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mi>LayerNorm</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>Out</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>Proj</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathrm{Out\_Proj}(\mathbf{C}))</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
              <math id="alg2.l8.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathrm{FFN}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mi>FFN</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathrm{FFN}(\mathbf{x})</annotation></semantics></math>

</div>
<div id="alg2.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <math id="alg2.l9.m1" class="ltx_Math" alttext="\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}\leftarrow\mathbf{K},\mathbf{V},\mathbf{C},\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐂</mi><mi>cache</mi></msub><mo>,</mo><mrow><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>cache</mi></msub></mrow><mo stretchy="false">←</mo><mi>𝐊</mi></mrow><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐂</mi><mo>,</mo><mi>𝐱</mi></mrow><annotation encoding="application/x-tex">\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}\leftarrow\mathbf{K},\mathbf{V},\mathbf{C},\mathbf{x}</annotation></semantics></math>

</div>
<div id="alg2.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="alg2.l10.3" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l10.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
            <math id="alg2.l11.m1" class="ltx_Math" alttext="\mathrm{logits}\leftarrow\mathrm{LMHead}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>logits</mi><mo stretchy="false">←</mo><mrow><mi>LMHead</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{logits}\leftarrow\mathrm{LMHead}(\mathbf{x})</annotation></semantics></math>

</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg2.l12.3" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l12.m1" class="ltx_Math" alttext="\mathrm{logits}" display="inline" intent=":literal"><semantics><mi>logits</mi><annotation encoding="application/x-tex">\mathrm{logits}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Sparse Step</h3>

<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">The core efficiency of DyLLM stems from SparseStep.
Algorithm <a href="#alg3" title="Algorithm 3 ‣ C.3 Sparse Step ‣ Appendix C Core Algorithm of DyLLM ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a> enables partial updates on the <em id="A3.SS3.p1.1.1" class="ltx_emph ltx_font_italic">salient tokens</em> which undergo substantial drift of attention context.
SparseStep processes the full sequence or only response tokens, reusing activation caches computed at the previous steps.
It projects the hidden states <math id="A3.SS3.p1.m1" class="ltx_Math" alttext="\mathbf{x}" display="inline" intent=":literal"><semantics><mi>𝐱</mi><annotation encoding="application/x-tex">\mathbf{x}</annotation></semantics></math> into <math id="A3.SS3.p1.m2" class="ltx_Math" alttext="\mathbf{K,V}" display="inline" intent=":literal"><semantics><mrow><mi>𝐊</mi><mo>,</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\mathbf{K,V}</annotation></semantics></math> for the tokens at <math id="A3.SS3.p1.m3" class="ltx_Math" alttext="\mathrm{idx_{sal}}" display="inline" intent=":literal"><semantics><msub><mi>idx</mi><mi>sal</mi></msub><annotation encoding="application/x-tex">\mathrm{idx_{sal}}</annotation></semantics></math> and merges the result with KV cache of non-salient tokens, thereby generating new <math id="A3.SS3.p1.m4" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> and <math id="A3.SS3.p1.m5" class="ltx_Math" alttext="V" display="inline" intent=":literal"><semantics><mi>V</mi><annotation encoding="application/x-tex">V</annotation></semantics></math>.</p>
</div>
<figure id="alg3" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg3.4" class="ltx_text ltx_font_bold">Algorithm 3</span> </span> <span id="alg3.5" class="ltx_text ltx_font_smallcaps">SparseStep</span></figcaption>
<div id="alg3.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg3.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Token ids <math id="alg3.l1.m1" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> of length <math id="alg3.l1.m2" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>; caches <math id="alg3.l1.m3" class="ltx_Math" alttext="\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐂</mi><mi>cache</mi></msub><mo>,</mo><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>cache</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}</annotation></semantics></math>;
salient index set <math id="alg3.l1.m4" class="ltx_Math" alttext="\mathrm{idx}_{\mathrm{sal}}" display="inline" intent=":literal"><semantics><msub><mi>idx</mi><mi>sal</mi></msub><annotation encoding="application/x-tex">\mathrm{idx}_{\mathrm{sal}}</annotation></semantics></math>; cosine threshold <math id="alg3.l1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>

</div>
<div id="alg3.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
