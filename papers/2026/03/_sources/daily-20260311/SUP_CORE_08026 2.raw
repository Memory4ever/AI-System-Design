              <math id="alg3.l13.m1" class="ltx_Math" alttext="\mathrm{idx}_{\mathrm{sal}}\leftarrow\mathrm{Where}\!\left(\mathrm{CosSim}(\mathbf{C},\mathbf{C}_{\mathrm{cache}})&lt;\tau\right)" display="inline" intent=":literal"><semantics><mrow><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="false">←</mo><mrow><mpadded style="width:2.900em;" width="2.900em"><mi>Where</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mi>CosSim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo>,</mo><msub><mi>𝐂</mi><mi>cache</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mi>τ</mi></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{idx}_{\mathrm{sal}}\leftarrow\mathrm{Where}\!\left(\mathrm{CosSim}(\mathbf{C},\mathbf{C}_{\mathrm{cache}})&lt;\tau\right)</annotation></semantics></math>

</div>
<div id="alg3.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
              <math id="alg3.l14.m1" class="ltx_Math" alttext="\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathrm{OutProj}(\mathbf{C}))" display="inline" intent=":literal"><semantics><mrow><mi>𝐱</mi><mo stretchy="false">←</mo><mrow><mi>LayerNorm</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>OutProj</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐂</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}\leftarrow\mathrm{LayerNorm}(\mathrm{OutProj}(\mathbf{C}))</annotation></semantics></math>

</div>
<div id="alg3.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
              <math id="alg3.l15.m1" class="ltx_Math" alttext="\mathbf{x}[\mathrm{idx}_{\mathrm{sal}}]\leftarrow\mathrm{FFN}\!\left(\mathbf{x}[\mathrm{idx}_{\mathrm{sal}}]\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mpadded style="width:2.306em;" width="2.306em"><mi>FFN</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mi>𝐱</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}[\mathrm{idx}_{\mathrm{sal}}]\leftarrow\mathrm{FFN}\!\left(\mathbf{x}[\mathrm{idx}_{\mathrm{sal}}]\right)</annotation></semantics></math>

</div>
<div id="alg3.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
              <math id="alg3.l16.m1" class="ltx_Math" alttext="\mathbf{x}[\overline{\mathrm{idx}_{\mathrm{sal}}}]\leftarrow\mathbf{FFN\_OUT}_{\mathrm{cache}}[\overline{\mathrm{idx}_{\mathrm{sal}}}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐱</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="true">¯</mo></mover><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>cache</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mover accent="true"><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="true">¯</mo></mover><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{x}[\overline{\mathrm{idx}_{\mathrm{sal}}}]\leftarrow\mathbf{FFN\_OUT}_{\mathrm{cache}}[\overline{\mathrm{idx}_{\mathrm{sal}}}]</annotation></semantics></math>

</div>
<div id="alg3.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
              <math id="alg3.l17.m1" class="ltx_Math" alttext="\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}\leftarrow\mathbf{K},\mathbf{V},\mathbf{C},\mathbf{x}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐊</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐕</mi><mi>cache</mi></msub><mo>,</mo><msub><mi>𝐂</mi><mi>cache</mi></msub><mo>,</mo><mrow><mrow><mi>𝐅𝐅𝐍</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐎𝐔𝐓</mi><mi>cache</mi></msub></mrow><mo stretchy="false">←</mo><mi>𝐊</mi></mrow><mo>,</mo><mi>𝐕</mi><mo>,</mo><mi>𝐂</mi><mo>,</mo><mi>𝐱</mi></mrow><annotation encoding="application/x-tex">\mathbf{K}_{\mathrm{cache}},\mathbf{V}_{\mathrm{cache}},\mathbf{C}_{\mathrm{cache}},\mathbf{FFN\_OUT}_{\mathrm{cache}}\leftarrow\mathbf{K},\mathbf{V},\mathbf{C},\mathbf{x}</annotation></semantics></math>

</div>
<div id="alg3.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
            <span id="alg3.l18.3" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l18.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
            <math id="alg3.l19.m1" class="ltx_Math" alttext="\mathrm{logits}\leftarrow\mathrm{LMHead}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><mi>logits</mi><mo stretchy="false">←</mo><mrow><mi>LMHead</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{logits}\leftarrow\mathrm{LMHead}(\mathbf{x})</annotation></semantics></math>

</div>
<div id="alg3.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
              
            <span id="alg3.l20.3" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l20.m1" class="ltx_Math" alttext="(\mathrm{logits},\mathrm{idx}_{\mathrm{sal}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>logits</mi><mo>,</mo><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathrm{logits},\mathrm{idx}_{\mathrm{sal}})</annotation></semantics></math>

</div>
</div>
</figure>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Approximate Attention</h3>

<div id="A3.SS4.p1" class="ltx_para">
<p id="A3.SS4.p1.1" class="ltx_p">Algorithm <a href="#alg4" title="Algorithm 4 ‣ C.4 Approximate Attention ‣ Appendix C Core Algorithm of DyLLM ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> computes the residual update for the attention context.
As an input, query <math id="A3.SS4.p1.m1" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math> can be given as only <math id="A3.SS4.p1.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> or concatenated <math id="A3.SS4.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="A3.SS4.p1.m4" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> depending on whether it is response-only step or not, whereas key <math id="A3.SS4.p1.m5" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math> has length of <math id="A3.SS4.p1.m6" class="ltx_Math" alttext="L_{P}+L_{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>L</mi><mi>P</mi></msub><mo>+</mo><msub><mi>L</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">L_{P}+L_{R}</annotation></semantics></math>.
Attention score <math id="A3.SS4.p1.m7" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> is computed by multiplying <math id="A3.SS4.p1.m8" class="ltx_Math" alttext="\mathbf{Q}" display="inline" intent=":literal"><semantics><mi>𝐐</mi><annotation encoding="application/x-tex">\mathbf{Q}</annotation></semantics></math> and <math id="A3.SS4.p1.m9" class="ltx_Math" alttext="\mathbf{K}" display="inline" intent=":literal"><semantics><mi>𝐊</mi><annotation encoding="application/x-tex">\mathbf{K}</annotation></semantics></math> and applying softmax operation to the result.
Approximate attention derives the delta of attention context <math id="A3.SS4.p1.m10" class="ltx_Math" alttext="\Delta\mathbf{C}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐂</mi></mrow><annotation encoding="application/x-tex">\Delta\mathbf{C}</annotation></semantics></math> by multiplying only selected columns of <math id="A3.SS4.p1.m11" class="ltx_Math" alttext="\mathbf{A}" display="inline" intent=":literal"><semantics><mi>𝐀</mi><annotation encoding="application/x-tex">\mathbf{A}</annotation></semantics></math> and selected rows of <math id="A3.SS4.p1.m12" class="ltx_Math" alttext="\Delta\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><annotation encoding="application/x-tex">\Delta\mathbf{V}</annotation></semantics></math>, which are indiced by given salient token indices <math id="A3.SS4.p1.m13" class="ltx_Math" alttext="\mathrm{idx_{sal}}" display="inline" intent=":literal"><semantics><msub><mi>idx</mi><mi>sal</mi></msub><annotation encoding="application/x-tex">\mathrm{idx_{sal}}</annotation></semantics></math>.</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.4" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> <span id="alg4.5" class="ltx_text ltx_font_smallcaps">ApproximateAttention</span></figcaption>
<div id="alg4.6" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Query <math id="alg4.l1.m1" class="ltx_Math" alttext="\mathbf{Q}\in\mathbb{R}^{L\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐐</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>L</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{Q}\in\mathbb{R}^{L\times d}</annotation></semantics></math>; keys <math id="alg4.l1.m2" class="ltx_Math" alttext="\mathbf{K}\in\mathbb{R}^{(L_{P}+L_{R})\times d}" display="inline" intent=":literal"><semantics><mrow><mi>𝐊</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>L</mi><mi>P</mi></msub><mo>+</mo><msub><mi>L</mi><mi>R</mi></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{K}\in\mathbb{R}^{(L_{P}+L_{R})\times d}</annotation></semantics></math>;
value delta <math id="alg4.l1.m3" class="ltx_Math" alttext="\Delta\mathbf{V}\in\mathbb{R}^{|\mathrm{idx}_{\mathrm{sal}}|\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><msub><mi>idx</mi><mi>sal</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\Delta\mathbf{V}\in\mathbb{R}^{|\mathrm{idx}_{\mathrm{sal}}|\times d}</annotation></semantics></math>; salient index set <math id="alg4.l1.m4" class="ltx_Math" alttext="\mathrm{idx}_{\mathrm{sal}}" display="inline" intent=":literal"><semantics><msub><mi>idx</mi><mi>sal</mi></msub><annotation encoding="application/x-tex">\mathrm{idx}_{\mathrm{sal}}</annotation></semantics></math>

</div>
<div id="alg4.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            <math id="alg4.l2.m1" class="ltx_Math" alttext="\mathbf{S}\leftarrow\mathbf{Q}\mathbf{K}^{\top}" display="inline" intent=":literal"><semantics><mrow><mi>𝐒</mi><mo stretchy="false">←</mo><msup><mi>𝐐𝐊</mi><mo>⊤</mo></msup></mrow><annotation encoding="application/x-tex">\mathbf{S}\leftarrow\mathbf{Q}\mathbf{K}^{\top}</annotation></semantics></math> <math id="alg4.l2.m2" class="ltx_math_unparsed" alttext="\quad{\color[rgb]{0,0,1}//\ [L,L_{P}+L_{R}]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0em">/</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.722em">/</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">P</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\quad{\color[rgb]{0,0,1}//\ [L,L_{P}+L_{R}]}</annotation></semantics></math>

</div>
<div id="alg4.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <math id="alg4.l3.m1" class="ltx_Math" alttext="\mathbf{A}\leftarrow\mathrm{Softmax}(\mathbf{S})" display="inline" intent=":literal"><semantics><mrow><mi>𝐀</mi><mo stretchy="false">←</mo><mrow><mi>Softmax</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐒</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}\leftarrow\mathrm{Softmax}(\mathbf{S})</annotation></semantics></math> <math id="alg4.l3.m2" class="ltx_math_unparsed" alttext="\quad{\color[rgb]{0,0,1}//\ [L,L_{P}+L_{R}]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0em">/</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.722em">/</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">P</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">+</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">R</mi></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\quad{\color[rgb]{0,0,1}//\ [L,L_{P}+L_{R}]}</annotation></semantics></math>

</div>
<div id="alg4.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
            <math id="alg4.l4.m1" class="ltx_math_unparsed" alttext="\mathbf{A}_{\mathrm{sal}}\leftarrow\mathbf{A}[:,\mathrm{idx}_{\mathrm{sal}}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐀</mi><mi>sal</mi></msub><mo stretchy="false">←</mo><mi>𝐀</mi><mrow><mo stretchy="false">[</mo><mo rspace="0em">:</mo><mo>,</mo><msub><mi>idx</mi><mi>sal</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{A}_{\mathrm{sal}}\leftarrow\mathbf{A}[:,\mathrm{idx}_{\mathrm{sal}}]</annotation></semantics></math> <math id="alg4.l4.m2" class="ltx_math_unparsed" alttext="\quad{\color[rgb]{0,0,1}//\ [L,Len(\mathrm{idx}_{sal})]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0em">/</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.722em">/</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">e</mi><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">(</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">idx</mi><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">a</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">l</mi></mrow></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">)</mo></mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\quad{\color[rgb]{0,0,1}//\ [L,Len(\mathrm{idx}_{sal})]}</annotation></semantics></math>

</div>
<div id="alg4.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
            <math id="alg4.l5.m1" class="ltx_Math" alttext="\Delta\mathbf{C}\leftarrow\mathbf{A}_{\mathrm{sal}}\,\Delta\mathbf{V}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐂</mi></mrow><mo stretchy="false">←</mo><mrow><msub><mi>𝐀</mi><mi>sal</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐕</mi></mrow></mrow><annotation encoding="application/x-tex">\Delta\mathbf{C}\leftarrow\mathbf{A}_{\mathrm{sal}}\,\Delta\mathbf{V}</annotation></semantics></math> <math id="alg4.l5.m2" class="ltx_math_unparsed" alttext="\quad{\color[rgb]{0,0,1}//\ [L,d_{hidden}]}" display="inline" intent=":literal"><semantics><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" rspace="0em">/</mo><mo style="--ltx-fg-color:#0000FF;" lspace="0em" mathcolor="#0000FF" rspace="0.722em">/</mo><mrow><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">[</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">L</mi><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">,</mo><msub><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mrow><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">h</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">d</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF">n</mi></mrow></msub><mo style="--ltx-fg-color:#0000FF;" mathcolor="#0000FF" stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\quad{\color[rgb]{0,0,1}//\ [L,d_{hidden}]}</annotation></semantics></math>

</div>
<div id="alg4.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg4.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <span id="alg4.l6.3" class="ltx_text ltx_font_bold">return</span> <math id="alg4.l6.m1" class="ltx_Math" alttext="\Delta\mathbf{C}" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>𝐂</mi></mrow><annotation encoding="application/x-tex">\Delta\mathbf{C}</annotation></semantics></math>

</div>
</div>
</figure>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Extended Ablation Study</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">This section details additional results not shown in the main paper.</p>
</div>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Impact of <math id="A4.SS1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> on accuracy </h3>

<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">Extended from <a href="#S4.F5" title="In 4.2.3 Threshold 𝜏 ‣ 4.2 Main Results ‣ 4 Evaluation ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">5</span></a>, <a href="#A4.F9" title="In D.1 Impact of 𝜏 on accuracy ‣ Appendix D Extended Ablation Study ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">9</span></a> illustrates the accuracy on MATH and MMLU-pro benchmarks with differing threshold values <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> to examine the impact of the threshold on generation quality.
We evaluated <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="\tau\in\{0.98,0.985,0.99,0.995\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.98</mn><mo>,</mo><mn>0.985</mn><mo>,</mo><mn>0.99</mn><mo>,</mo><mn>0.995</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0.98,0.985,0.99,0.995\}</annotation></semantics></math> for LLaDA, and <math id="A4.SS1.p1.m3" class="ltx_Math" alttext="\tau\in\{0.985,0.99,0.995,0.9975\}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0.985</mn><mo>,</mo><mn>0.99</mn><mo>,</mo><mn>0.995</mn><mo>,</mo><mn>0.9975</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\tau\in\{0.985,0.99,0.995,0.9975\}</annotation></semantics></math> for Dream.
Since lowering <math id="A4.SS1.p1.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> results in selecting fewer salient tokens-thereby bypassing more computations and relying more heavily on cached results-we anticipate that a drastic decrease in <math id="A4.SS1.p1.m5" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> will eventually degrade accuracy, consistent with the trend observed in <a href="#S4.SS2.SSS3" title="4.2.3 Threshold 𝜏 ‣ 4.2 Main Results ‣ 4 Evaluation ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">4.2.3</span></a>.</p>
</div>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.1" class="ltx_p">At a finer granularity, increasing <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> does not guarantee better generation quality, as it may add additional tokens irrelevant to the context.
This result supports the results that caching frameworks <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib10" title="" class="ltx_ref">Ma et al. (2025)</a>; <a href="#bib.bib7" title="" class="ltx_ref">Wu et al. (2026)</a>; <a href="#bib.bib9" title="" class="ltx_ref">Liu et al. (2025)</a></cite>, including DyLLM, show better response quality than the original models in some configurations.</p>
</div>
<figure id="A4.F9" class="ltx_figure">
<p id="A4.F9.3" class="ltx_p ltx_align_center ltx_align_center"><span id="A4.F9.3.1" class="ltx_text"><img src="2603.08026v1/ablation_math_mmlu.png" id="A4.F9.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:286/219;" width="286" height="219" alt="Refer to caption"></span></p>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A4.F9.4" class="ltx_text" style="font-size:90%;">Figure 9</span>: </span><span id="A4.F9.5" class="ltx_text" style="font-size:90%;">
Accuracy and threshold results varying <math id="A4.F9.m2" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> across MATH and MMLU-pro benchmark.
</span></figcaption>
</figure>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Average <math id="A4.SS2.m1" class="ltx_Math" alttext="L_{sal}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi></mrow></msub><annotation encoding="application/x-tex">L_{sal}</annotation></semantics></math> per layer on various benchmarks</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p"><a href="#A4.F10" title="In D.2 Average 𝐿_{𝑠⁢𝑎⁢𝑙} per layer on various benchmarks ‣ Appendix D Extended Ablation Study ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">10</span></a> illustrates extended results from <a href="#S4.F7" title="In 4.2.4 Scalability with Increasing 𝑛_𝑢 ‣ 4.2 Main Results ‣ 4 Evaluation ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figure</span> <span class="ltx_text ltx_ref_tag">7</span></a>; the average number of salient tokens per layer across the MBPP, MATH, and MMLU-pro benchmarks.
Notably, the initial layers exhibit a markedly lower number of salient tokens.</p>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p">This trend aligns with the dynamics identified in Elastic-Cache <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib8" title="" class="ltx_ref">Nguyen-Tri et al. (2026)</a></cite>, where shallow layers are relatively more stable, exhibiting small differences between steps, whereas deeper layers continue to evolve as the effect of the updated tokens propagates to other tokens throughout the step.
While Elastic-Cache computes the entire tokens from a certain layer, we consistently select the tokens flexibly to effectively maintain a low average number of computed tokens without compromising model accuracy.</p>
</div>
<figure id="A4.F10" class="ltx_figure">
<p id="A4.F10.3" class="ltx_p ltx_align_center"><span id="A4.F10.3.1" class="ltx_text"><img src="2603.08026v1/appendix_numsal.png" id="A4.F10.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:429/222;" width="429" height="222" alt="Refer to caption"></span></p>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A4.F10.4" class="ltx_text" style="font-size:90%;">Figure 10</span>: </span><span id="A4.F10.5" class="ltx_text" style="font-size:90%;">
The average number of salient tokens per layer across MBPP, MATH, and MMLU-Pro.
A similar trend with GSM8k is observed.
</span></figcaption>
</figure>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Semi-AR v.s. Non Semi-AR accuracy comparison</h3>

<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p"><a href="#A4.T3" title="In D.3 Semi-AR v.s. Non Semi-AR accuracy comparison ‣ Appendix D Extended Ablation Study ‣ DyLLM: Efficient Diffusion LLM Inference via Saliency-based Token Selection and Partial Attention" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Table</span> <span class="ltx_text ltx_ref_tag">3</span></a> shows the effect of Semi-AR decoding on the original LLaDA and Dream implementation with GSM8K 5-shot benchmark.
The block size <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> was set to 32.
Semi-AR decoding does not change computations, but offers huge improvements on accuracy.</p>
</div>
<figure id="A4.T3" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A4.T3.3" class="ltx_text" style="font-size:90%;">Table 3</span>: </span><span id="A4.T3.4" class="ltx_text" style="font-size:90%;">Impact of Semi-AR decoding on accuracy score</span></figcaption>
