yle="--ltx-fill-color:#E7F5FC;" fill="#E7F5FC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.15 L 0 7.34 C 0 9.63 1.86 11.49 4.15 11.49 L 34.94 11.49 C 37.23 11.49 39.09 9.63 39.09 7.34 L 39.09 4.15 C 39.09 1.86 37.23 0 34.94 0 L 4.15 0 C 1.86 0 0 1.86 0 4.15 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 1.38 2.77)"><foreignObject style="--ltx-fo-width:2.5em;--ltx-fo-height:0.41em;--ltx-fo-depth:0em;font-size:10.5pt;" height="5.96" overflow="visible" transform="matrix(1 0 0 -1 0 5.96)" width="36.32"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.I1.ix7.p1.pic6.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">cause</span></span></span></foreignObject></g></g></svg></span>, <span class="ltx_inline-block"><svg id="A3.I1.ix7.p1.pic7" class="ltx_picture" height="13.99" overflow="visible" style="vertical-align:-2.77px" version="1.1" viewBox="0 0 46.35 13.99" width="46.35"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;" fill="#808080" stroke="#808080" stroke-width="0.4pt" transform="translate(0,13.99) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#6EA6C0;" fill="#6EA6C0" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.15 L 0 9.84 C 0 12.13 1.86 13.99 4.15 13.99 L 42.2 13.99 C 44.5 13.99 46.35 12.13 46.35 9.84 L 46.35 4.15 C 46.35 1.86 44.5 0 42.2 0 L 4.15 0 C 1.86 0 0 1.86 0 4.15 Z"></path></g><g style="--ltx-fill-color:#E7F5FC;" fill="#E7F5FC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.15 L 0 9.84 C 0 12.13 1.86 13.99 4.15 13.99 L 42.2 13.99 C 44.5 13.99 46.35 12.13 46.35 9.84 L 46.35 4.15 C 46.35 1.86 44.5 0 42.2 0 L 4.15 0 C 1.86 0 0 1.86 0 4.15 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 1.38 2.77)"><foreignObject style="--ltx-fo-width:3em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.5pt;" height="8.46" overflow="visible" transform="matrix(1 0 0 -1 0 8.46)" width="43.59"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.I1.ix7.p1.pic7.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">result</span></span></span></foreignObject></g></g></svg></span>)</span></p>
</div></li>
<li id="A3.I1.ix8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">#521</span> 
<div id="A3.I1.ix8.p1" class="ltx_para">
<p id="A3.I1.ix8.p1.1" class="ltx_p"><span id="A3.I1.ix8.p1.1.1" class="ltx_text ltx_font_bold">context discrimination</span>: distinguishing benign from harmful intent. 
<br class="ltx_break"><span id="A3.I1.ix8.p1.1.2" class="ltx_text" style="--ltx-fg-color:#808080;">(top tokens: <span class="ltx_inline-block"><svg id="A3.I1.ix8.p1.pic1" class="ltx_picture" height="13.19" overflow="visible" style="vertical-align:-2.77px" version="1.1" viewBox="0 0 53.62 13.19" width="53.62"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;" fill="#808080" stroke="#808080" stroke-width="0.4pt" transform="translate(0,13.19) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#6EA6C0;" fill="#6EA6C0" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.15 L 0 9.04 C 0 11.34 1.86 13.19 4.15 13.19 L 49.47 13.19 C 51.76 13.19 53.62 11.34 53.62 9.04 L 53.62 4.15 C 53.62 1.86 51.76 0 49.47 0 L 4.15 0 C 1.86 0 0 1.86 0 4.15 Z"></path></g><g style="--ltx-fill-color:#E7F5FC;" fill="#E7F5FC" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.15 L 0 9.04 C 0 11.34 1.86 13.19 4.15 13.19 L 49.47 13.19 C 51.76 13.19 53.62 11.34 53.62 9.04 L 53.62 4.15 C 53.62 1.86 51.76 0 49.47 0 L 4.15 0 C 1.86 0 0 1.86 0 4.15 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 1.38 2.77)"><foreignObject style="--ltx-fo-width:3.5em;--ltx-fo-height:0.53em;--ltx-fo-depth:0em;font-size:10.5pt;" height="7.66" overflow="visible" transform="matrix(1 0 0 -1 0 7.66)" width="50.85"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A3.I1.ix8.p1.pic1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">context</span></span></span></foreignObject></g></g></svg></span>, <span class="ltx_inline-block"><svg id="A3.I1.ix8.p1.pic2" class="ltx_picture" height="13.99" overflow="visible" style="vertical-align:-2.77px" version="1.1" viewBox="0 0 68.15 13.99" width="68.15"><g style="--ltx-stroke-color:#808080;--ltx-fill-color:#808080;" fill="#808080" stroke="#808080" stroke-width="0.4pt" transform="translate(0,13.99) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#6EA6C0;" fill="#6EA6C0" fill-opacity="1.0"><