<td id="S5.T5.6.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.6.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Layer-wise</span></td>
<td id="S5.T5.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.6.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Layer-wise</span></td>
<td id="S5.T5.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.6.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Expert-wise</span></td></tr>
