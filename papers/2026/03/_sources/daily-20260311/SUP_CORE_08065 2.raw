<td id="S3.T2.6.1.3.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.8.1" class="ltx_text ltx_font_bold">Wiki2<math id="S3.T2.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.9" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.3.9.1" class="ltx_text ltx_font_bold">Mean Acc<math id="S3.T2.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.10.1" class="ltx_text ltx_font_bold">Wiki2<math id="S3.T2.m9" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.11" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.3.11.1" class="ltx_text ltx_font_bold">Mean Acc<math id="S3.T2.m10" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.12.1" class="ltx_text ltx_font_bold">Wiki2<math id="S3.T2.m11" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.13" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.13.1" class="ltx_text ltx_font_bold">Mean Acc<math id="S3.T2.m12" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="S3.T2.6.1.4" class="ltx_tr">
<td id="S3.T2.6.1.4.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.4.1.1" class="ltx_text ltx_font_bold">Original (Dense)</span></td>
<td id="S3.T2.6.1.4.2" class="ltx_td ltx_align_center ltx_border_t">12.62</td>
<td id="S3.T2.6.1.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">65.96</td>
<td id="S3.T2.6.1.4.4" class="ltx_td ltx_align_center ltx_border_t">12.62</td>
<td id="S3.T2.6.1.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">65.96</td>
