<td id="S5.T6.6.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T6.6.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">LaMini</span></td>
<td id="S5.T6.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.1.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">C4</span></td>
<td id="S5.T6.6.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.1.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">LaMini</span></td></tr>
<tr id="S5.T6.6.1.3" class="ltx_tr">
