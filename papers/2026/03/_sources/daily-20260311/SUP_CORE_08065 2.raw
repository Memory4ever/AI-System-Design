<td id="S5.T6.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.1.3.4.1" class="ltx_text" style="font-size:90%;">+0.21</span></td>
<td id="S5.T6.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.6.1.3.5.1" class="ltx_text" style="font-size:90%;">+0.11</span></td></tr>
