<td id="S3.T2.6.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.2.1" class="ltx_text ltx_font_bold">20%</span></td>
<td id="S3.T2.6.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.3.1" class="ltx_text ltx_font_bold">50%</span></td>
<td id="S3.T2.6.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.4.1" class="ltx_text ltx_font_bold">20%</span></td>
<td id="S3.T2.6.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.5.1" class="ltx_text ltx_font_bold">50%</span></td>
<td id="S3.T2.6.1.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.6.1" class="ltx_text ltx_font_bold">20%</span></td>
<td id="S3.T2.6.1.2.7" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="S3.T2.6.1.2.7.1" class="ltx_text ltx_font_bold">50%</span></td></tr>
<tr id="S3.T2.6.1.3" class="ltx_tr">
<td id="S3.T2.6.1.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.3.1.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="S3.T2.6.1.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.2.1" class="ltx_text ltx_font_bold">Wiki2<math id="S3.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.3.3.1" class="ltx_text ltx_font_bold">Mean Acc<math id="S3.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T2.6.1.3.4.1" class="ltx_text ltx_font_bold">Wiki2<math id="S3.T2.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S3.T2.6.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S3.T2.6.1.3.5.1" class="ltx_text ltx_font_bold">Mean Acc<math id="S3.T2.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
