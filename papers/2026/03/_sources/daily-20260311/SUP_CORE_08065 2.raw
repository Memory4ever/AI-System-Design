<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Algorithm</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Deterministic Differentiable Pruning: Structured Pruning via Mask-Only Optimization</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <span id="alg1.l1.3" class="ltx_text ltx_font_bold">Input:</span> target keep ratio <math id="alg1.l1.m1" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>; total iterations <math id="alg1.l1.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math>; number of heads <math id="alg1.l1.m3" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math>; MLP width <math id="alg1.l1.m4" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>; number of layers <math id="alg1.l1.m5" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math>; prunable module types <math id="alg1.l1.m6" class="ltx_Math" alttext="\mathcal{N}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒩</mi><annotation encoding="application/x-tex">\mathcal{N}</annotation></semantics></math> (dense: <math id="alg1.l1.m7" class="ltx_Math" alttext="\{\text{attn},\text{mlp}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mtext>attn</mtext><mo>,</mo><mtext>mlp</mtext><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\text{attn},\text{mlp}\}</annotation></semantics></math>; MoE: <math id="alg1.l1.m8" class="ltx_Math" alttext="\{\text{expert}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mtext>expert</mtext><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\text{expert}\}</annotation></semantics></math>); distillation weight <math id="alg1.l1.m9" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           <span id="alg1.l2.3" class="ltx_text ltx_font_bold">Initialize:</span> for each <math id="alg1.l2.m1" class="ltx_Math" alttext="\tau\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathcal{N}</annotation></semantics></math>, initialize mask parameters <math id="alg1.l2.m2" class="ltx_Math" alttext="\boldsymbol{z}^{\tau}\leftarrow\mathbf{1}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒛</mi><mi>τ</mi></msup><mo stretchy="false">←</mo><mn>𝟏</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{z}^{\tau}\leftarrow\mathbf{1}</annotation></semantics></math> and multipliers <math id="alg1.l2.m3" class="ltx_Math" alttext="\lambda_{1}^{\tau}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mn>1</mn><mi>τ</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{1}^{\tau}\leftarrow 0</annotation></semantics></math>, <math id="alg1.l2.m4" class="ltx_Math" alttext="\lambda_{2}^{\tau}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mn>2</mn><mi>τ</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{2}^{\tau}\leftarrow 0</annotation></semantics></math>, <math id="alg1.l2.m5" class="ltx_Math" alttext="\lambda_{3}^{\tau}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mn>3</mn><mi>τ</mi></msubsup><mo stretchy="false">←</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{3}^{\tau}\leftarrow 0</annotation></semantics></math>.

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           <span id="alg1.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="t=1,2,\ldots,T" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=1,2,\ldots,T</annotation></semantics></math> <span id="alg1.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
            Compute progress <math id="alg1.l4.m1" class="ltx_Math" alttext="p_{t}\leftarrow t/T" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><mi>t</mi><mo>/</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">p_{t}\leftarrow t/T</annotation></semantics></math> and update mapping sharpness <math id="alg1.l4.m2" class="ltx_Math" alttext="\mu_{t}\leftarrow\mu_{0}-(\mu_{0}-\mu_{T})\sqrt{p_{t}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>μ</mi><mn>0</mn></msub><mo>−</mo><msub><mi>μ</mi><mi>T</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>p</mi><mi>t</mi></msub></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{t}\leftarrow\mu_{0}-(\mu_{0}-\mu_{T})\sqrt{p_{t}}</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
            <span id="alg1.l5.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l5.m1" class="ltx_Math" alttext="\tau\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathcal{N}</annotation></semantics></math> <span id="alg1.l5.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
             Compute forward masks <math id="alg1.l6.m1" class="ltx_Math" alttext="\boldsymbol{m}^{\tau}\leftarrow\mathrm{ReLU}(\boldsymbol{z}^{\tau})" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝒎</mi><mi>τ</mi></msup><mo stretchy="false">←</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>τ</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}^{\tau}\leftarrow\mathrm{ReLU}(\boldsymbol{z}^{\tau})</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
             Compute retention scores <math id="alg1.l7.m1" class="ltx_Math" alttext="\boldsymbol{s}^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>𝒔</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{s}^{\tau}</annotation></semantics></math> from <math id="alg1.l7.m2" class="ltx_Math" alttext="\boldsymbol{z}^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\tau}</annotation></semantics></math> <span id="alg1.l7.3" class="ltx_text" style="float:right;">(Eq. (<a href="#S3.E12" title="Equation 12 ‣ 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>))
</span>
</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
             Compute <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathcal{L}^{\tau}_{\text{sparsity}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>sparsity</mtext><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{L}^{\tau}_{\text{sparsity}}</annotation></semantics></math> and <math id="alg1.l8.m2" class="ltx_Math" alttext="\mathcal{L}^{\tau}_{\text{bin}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>bin</mtext><mi>τ</mi></msubsup><annotation encoding="application/x-tex">\mathcal{L}^{\tau}_{\text{bin}}</annotation></semantics></math> <span id="alg1.l8.3" class="ltx_text" style="float:right;">(Eqs. (<a href="#S3.E13" title="Equation 13 ‣ 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), (<a href="#S3.E15" title="Equation 15 ‣ 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>))
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
            <span id="alg1.l9.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l9.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l10" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
            
            
            Forward dense teacher and masked student to obtain output distributions <math id="alg1.l10.m1" class="ltx_Math" alttext="P_{t}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>t</mi></msub><annotation encoding="application/x-tex">P_{t}</annotation></semantics></math> and <math id="alg1.l10.m2" class="ltx_Math" alttext="P_{s}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>s</mi></msub><annotation encoding="application/x-tex">P_{s}</annotation></semantics></math> respectively, compute <math id="alg1.l10.m3" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{kl}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>kl</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{kl}}</annotation></semantics></math> <span id="alg1.l10.3" class="ltx_text" style="float:right;">(Eq. (<a href="#S3.E17" title="Equation 17 ‣ Distillation. ‣ 3.3 Extensions ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>))
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
            
            
            Form <math id="alg1.l11.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{total}}=\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m})+\eta\mathcal{L}_{\mathrm{kl}}(\theta,\boldsymbol{m})+\mathcal{L}_{\mathrm{sparsity}}(\boldsymbol{s})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{s})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>total</mtext></msub><mo>=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ce</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>𝒎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>η</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>kl</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>𝒎</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>sparsity</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒔</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{total}}=\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m})+\eta\mathcal{L}_{\mathrm{kl}}(\theta,\boldsymbol{m})+\mathcal{L}_{\mathrm{sparsity}}(\boldsymbol{s})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{s})</annotation></semantics></math>

</div>
<div id="alg1.l12" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
            
            
            <span id="alg1.l12.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l12.m1" class="ltx_Math" alttext="\tau\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathcal{N}</annotation></semantics></math> <span id="alg1.l12.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
            
            
             Update <math id="alg1.l13.m1" class="ltx_Math" alttext="\boldsymbol{z}^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\tau}</annotation></semantics></math> by gradient descent on <math id="alg1.l13.m2" class="ltx_Math" alttext="\mathcal{L}_{\text{total}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>total</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{total}}</annotation></semantics></math>.

</div>
<div id="alg1.l14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
            
            
             Update <math id="alg1.l14.m1" class="ltx_Math" alttext="\lambda_{1}^{\tau},\lambda_{2}^{\tau},\lambda_{3}^{\tau}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>λ</mi><mn>1</mn><mi>τ</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>2</mn><mi>τ</mi></msubsup><mo>,</mo><msubsup><mi>λ</mi><mn>3</mn><mi>τ</mi></msubsup></mrow><annotation encoding="application/x-tex">\lambda_{1}^{\tau},\lambda_{2}^{\tau},\lambda_{3}^{\tau}</annotation></semantics></math> by gradient ascent.

</div>
<div id="alg1.l15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
            
            
            <span id="alg1.l15.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l15.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
            
            
           <span id="alg1.l16.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l16.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
            
            
           <span id="alg1.l17.3" class="ltx_text ltx_font_bold">Pruning:</span> remove components whose corresponding mask value is 0 in <math id="alg1.l17.m1" class="ltx_Math" alttext="\boldsymbol{m}^{\tau}" display="inline" intent=":literal"><semantics><msup><mi>𝒎</mi><mi>τ</mi></msup><annotation encoding="application/x-tex">\boldsymbol{m}^{\tau}</annotation></semantics></math> and merge nonzero mask values into model weights for each <math id="alg1.l17.m2" class="ltx_Math" alttext="\tau\in\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mi>τ</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\tau\in\mathcal{N}</annotation></semantics></math>, yielding the final pruned model.

</div>
</div>
</figure>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Theoretical Discussion</h2>

<div id="A2.p1" class="ltx_para">
<p id="A2.p1.1" class="ltx_p">This section provides formal justification for the theoretical claims discussed in <a href="#S3" title="3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Section</span> <span class="ltx_text ltx_ref_tag">3</span></a>.
We study <em id="A2.p1.1.1" class="ltx_emph ltx_font_italic">Deterministic Differentiable Pruning (DDP)</em> by (i) relating its relaxed keep budget constraint to the discrete <math id="A2.p1.m1" class="ltx_Math" alttext="\ell_{0}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>0</mn></msub><annotation encoding="application/x-tex">\ell_{0}</annotation></semantics></math> active-set constraint, (ii) characterizing the effect of the binarization regularizer, and (iii) establishing a standard KKT-type convergence guarantee for deterministic augmented Lagrangian optimization on the (STE-induced) constrained surrogate. These ingredients are then combined to justify recovery of the exact hard <math id="A2.p1.m2" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-budget in the annealed limit.</p>
</div>
<section id="A2.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Discrete <math id="A2.SS0.SSS0.Px1.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-budget formulation.</h5>

<div id="A2.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS0.SSS0.Px1.p1.1" class="ltx_p">DDP parameterizes structured masks by logits <math id="A2.SS0.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\boldsymbol{z}\in\mathbb{R}^{K}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{z}\in\mathbb{R}^{K}</annotation></semantics></math> and applies a ReLU gate in the forward pass,
<math id="A2.SS0.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})</annotation></semantics></math>.
Under this parameterization, enforcing an exact keep budget is equivalent to constraining the number of positive logits.
We therefore define the discrete hard budget problem as</p>
<table id="A2.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E20.m1" class="ltx_math_unparsed" alttext="\min_{\boldsymbol{z}}\;J(\boldsymbol{z})\quad\text{s.t.}\quad\sum_{k=1}^{K}\mathbb{I}[z_{k}&gt;0]=P," display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mi>𝒛</mi></munder><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mtext>s.t.</mtext><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>P</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\boldsymbol{z}}\;J(\boldsymbol{z})\quad\text{s.t.}\quad\sum_{k=1}^{K}\mathbb{I}[z_{k}&gt;0]=P,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(20)</span></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px1.p1.2" class="ltx_p">where <math id="A2.SS0.SSS0.Px1.p1.m3" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is the target number of active components. In terms of the keep ratio <math id="A2.SS0.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>, we set <math id="A2.SS0.SSS0.Px1.p1.m5" class="ltx_Math" alttext="P=[\rho K]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">P=[\rho K]</annotation></semantics></math>
(or <math id="A2.SS0.SSS0.Px1.p1.m6" class="ltx_Math" alttext="P=\rho K" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow><annotation encoding="application/x-tex">P=\rho K</annotation></semantics></math> when <math id="A2.SS0.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\rho K" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\rho K</annotation></semantics></math> is an integer). Throughout, <math id="A2.SS0.SSS0.Px1.p1.m8" class="ltx_Math" alttext="J(z)" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(z)</annotation></semantics></math> can be any <em id="A2.SS0.SSS0.Px1.p1.2.1" class="ltx_emph ltx_font_italic">deterministic</em> training objective; for example,</p>
<table id="A2.Ex2" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex2.m1" class="ltx_Math" alttext="J(\boldsymbol{z})\;=\;\mathcal{L}_{\mathrm{ce}}\big(\theta,\boldsymbol{m}(\boldsymbol{z})\big)\;+\;\eta\,\mathcal{L}_{\mathrm{kl}}\big(\theta,\boldsymbol{m}(\boldsymbol{z})\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">=</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ce</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>𝒎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em">)</mo></mrow></mrow><mo rspace="0.502em">+</mo><mrow><mi>η</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>kl</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>𝒎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z})\;=\;\mathcal{L}_{\mathrm{ce}}\big(\theta,\boldsymbol{m}(\boldsymbol{z})\big)\;+\;\eta\,\mathcal{L}_{\mathrm{kl}}\big(\theta,\boldsymbol{m}(\boldsymbol{z})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px1.p1.3" class="ltx_p">with an optional distillation term <math id="A2.SS0.SSS0.Px1.p1.m9" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{kl}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>kl</mi></msub><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{kl}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS0.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Relaxed keep budget.</h5>

<div id="A2.SS0.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS0.SSS0.Px2.p1.1" class="ltx_p">To obtain a differentiable surrogate for the discrete active-set count, DDP uses the deterministic surrogate mapping
<math id="A2.SS0.SSS0.Px2.p1.m1" class="ltx_Math" alttext="s_{k}=\phi(z_{k};\mu)\in[0,1]" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mi>k</mi></msub><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s_{k}=\phi(z_{k};\mu)\in[0,1]</annotation></semantics></math> (cf. <a href="#S3.E12" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a>) and defines the relaxed keep budget</p>
<table id="A2.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E21.m1" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})=\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c_{\mu}(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>P</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})=\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c_{\mu}(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(21)</span></td></tr></tbody>
</table>
<p id="A2.SS0.SSS0.Px2.p1.2" class="ltx_p">We emphasize that <math id="A2.SS0.SSS0.Px2.p1.m2" class="ltx_Math" alttext="S_{\mu}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>μ</mi></msub><annotation encoding="application/x-tex">S_{\mu}</annotation></semantics></math> is used only for enforcing the budget constraint (via an augmented Lagrangian), while the forward mask is
<math id="A2.SS0.SSS0.Px2.p1.m3" class="ltx_Math" alttext="\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝒎</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>A basic property of the deterministic surrogate mapping</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">We start with a lightweight fact about <math id="A2.SS1.p1.m1" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> that underlies the hard budget recovery argument:
as <math id="A2.SS1.p1.m2" class="ltx_Math" alttext="\mu\downarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu\downarrow 0</annotation></semantics></math>, the relaxed keep budget <math id="A2.SS1.p1.m3" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})</annotation></semantics></math> approaches the discrete count <math id="A2.SS1.p1.m4" class="ltx_math_unparsed" alttext="\sum_{k}\mathbb{I}[z_{k}&gt;0]" display="inline" intent=":literal"><semantics><mrow><msub><mo>∑</mo><mi>k</mi></msub><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sum_{k}\mathbb{I}[z_{k}&gt;0]</annotation></semantics></math> whenever
the logits are separated from the ReLU threshold by a margin.</p>
</div>
<div id="A2.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma B.1</span></span><span id="A2.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Margin-separated relaxation approaches the discrete count)<span id="A2.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem1.p1" class="ltx_para">
<p id="A2.Thmtheorem1.p1.1" class="ltx_p"><span id="A2.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Assume <math id="A2.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> is nondecreasing in <math id="A2.Thmtheorem1.p1.m2" class="ltx_Math" alttext="z" display="inline" intent=":literal"><semantics><mi>z</mi><annotation encoding="application/x-tex">z</annotation></semantics></math> for each <math id="A2.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and satisfies pointwise convergence
<math id="A2.Thmtheorem1.p1.m4" class="ltx_math_unparsed" alttext="\phi(z;\mu)\to\mathbb{I}[z&gt;0]" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>;</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">→</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>z</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(z;\mu)\to\mathbb{I}[z&gt;0]</annotation></semantics></math> as <math id="A2.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\mu\downarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu\downarrow 0</annotation></semantics></math> for all <math id="A2.Thmtheorem1.p1.m6" class="ltx_Math" alttext="z\neq 0" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">z\neq 0</annotation></semantics></math> (as induced by <a href="#S3.E12" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a>).
Fix <math id="A2.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> and define the active set <math id="A2.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\mathcal{A}(\boldsymbol{z})=\{k:z_{k}&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}(\boldsymbol{z})=\{k:z_{k}&gt;0\}</annotation></semantics></math>.
Then there exists <math id="A2.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\bar{\mu}(\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\mu}(\delta)&gt;0</annotation></semantics></math> such that for all <math id="A2.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\mu\in(0,\bar{\mu}(\delta))" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu\in(0,\bar{\mu}(\delta))</annotation></semantics></math> and all <math id="A2.Thmtheorem1.p1.m11" class="ltx_Math" alttext="\boldsymbol{z}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">\boldsymbol{z}</annotation></semantics></math> obeying the margin condition</span></p>
<table id="A2.Ex3" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex3.m1" class="ltx_Math" alttext="z_{k}\geq\delta\ \ \text{for }k\in\mathcal{A}(\boldsymbol{z}),\qquad z_{k}\leq-\delta\ \ \text{for }k\notin\mathcal{A}(\boldsymbol{z})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>≥</mo><mi>δ</mi></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>z</mi><mi>k</mi></msub><mo>≤</mo><mrow><mo>−</mo><mi>δ</mi></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">z_{k}\geq\delta\ \ \text{for }k\in\mathcal{A}(\boldsymbol{z}),\qquad z_{k}\leq-\delta\ \ \text{for }k\notin\mathcal{A}(\boldsymbol{z}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem1.p1.2" class="ltx_p"><span id="A2.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">we have</span></p>
<table id="A2.Ex4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex4.m1" class="ltx_Math" alttext="\big|S_{\mu}(\boldsymbol{z})-|\mathcal{A}(\boldsymbol{z})|\big|\;\leq\;\tfrac{1}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" rspace="0.280em" stretchy="true">|</mo></mrow><mo rspace="0.558em">≤</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big|S_{\mu}(\boldsymbol{z})-|\mathcal{A}(\boldsymbol{z})|\big|\;\leq\;\tfrac{1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem1.p1.3" class="ltx_p"><span id="A2.Thmtheorem1.p1.3.1" class="ltx_text ltx_font_italic">In particular, since both <math id="A2.Thmtheorem1.p1.m12" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})</annotation></semantics></math> and <math id="A2.Thmtheorem1.p1.m13" class="ltx_Math" alttext="|\mathcal{A}(\boldsymbol{z})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{A}(\boldsymbol{z})|</annotation></semantics></math> are integers whenever <math id="A2.Thmtheorem1.p1.m14" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})=P" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})=P</annotation></semantics></math>, this implies
<math id="A2.Thmtheorem1.p1.m15" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})=P\Rightarrow|\mathcal{A}(\boldsymbol{z})|=P" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>P</mi><mo stretchy="false">⇒</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})=P\Rightarrow|\mathcal{A}(\boldsymbol{z})|=P</annotation></semantics></math> for sufficiently small <math id="A2.Thmtheorem1.p1.m16" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> under the margin condition.</span></p>
</div>
</div>
<div id="A2.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS1.p2" class="ltx_para">
<p id="A2.SS1.p2.1" class="ltx_p"><span id="A2.SS1.p2.1.1" class="ltx_text">By pointwise convergence, for the fixed <math id="A2.SS1.p2.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math> there exists <math id="A2.SS1.p2.m2" class="ltx_Math" alttext="\bar{\mu}(\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\mu}(\delta)&gt;0</annotation></semantics></math> such that for all <math id="A2.SS1.p2.m3" class="ltx_Math" alttext="\mu\in(0,\bar{\mu}(\delta))" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu\in(0,\bar{\mu}(\delta))</annotation></semantics></math>,</span></p>
<table id="A2.Ex5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex5.m1" class="ltx_Math" alttext="\phi(\delta;\mu)\geq 1-\frac{1}{4K},\qquad\phi(-\delta;\mu)\leq\frac{1}{4K}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(\delta;\mu)\geq 1-\frac{1}{4K},\qquad\phi(-\delta;\mu)\leq\frac{1}{4K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p2.2" class="ltx_p"><span id="A2.SS1.p2.2.1" class="ltx_text">By monotonicity, for <math id="A2.SS1.p2.m4" class="ltx_Math" alttext="k\in\mathcal{A}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\in\mathcal{A}(\boldsymbol{z})</annotation></semantics></math> we have <math id="A2.SS1.p2.m5" class="ltx_Math" alttext="\phi(z_{k};\mu)\geq\phi(\delta;\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(z_{k};\mu)\geq\phi(\delta;\mu)</annotation></semantics></math>, and for <math id="A2.SS1.p2.m6" class="ltx_Math" alttext="k\notin\mathcal{A}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">k\notin\mathcal{A}(\boldsymbol{z})</annotation></semantics></math> we have
<math id="A2.SS1.p2.m7" class="ltx_Math" alttext="\phi(z_{k};\mu)\leq\phi(-\delta;\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(z_{k};\mu)\leq\phi(-\delta;\mu)</annotation></semantics></math>. Summing yields</span></p>
<table id="A2.Ex6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex6.m1" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})=\sum_{k\in\mathcal{A}(\boldsymbol{z})}\phi(z_{k};\mu)+\sum_{k\notin\mathcal{A}(\boldsymbol{z})}\phi(z_{k};\mu)\in\Big[|\mathcal{A}(\boldsymbol{z})|\Big(1-\tfrac{1}{4K}\Big),\ |\mathcal{A}(\boldsymbol{z})|+\tfrac{K-|\mathcal{A}(\boldsymbol{z})|}{4K}\Big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∉</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>∈</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mstyle displaystyle="false"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>+</mo><mstyle displaystyle="false"><mfrac><mrow><mi>K</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mstyle></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})=\sum_{k\in\mathcal{A}(\boldsymbol{z})}\phi(z_{k};\mu)+\sum_{k\notin\mathcal{A}(\boldsymbol{z})}\phi(z_{k};\mu)\in\Big[|\mathcal{A}(\boldsymbol{z})|\Big(1-\tfrac{1}{4K}\Big),\ |\mathcal{A}(\boldsymbol{z})|+\tfrac{K-|\mathcal{A}(\boldsymbol{z})|}{4K}\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS1.p2.3" class="ltx_p"><span id="A2.SS1.p2.3.1" class="ltx_text">hence <math id="A2.SS1.p2.m8" class="ltx_Math" alttext="\big|S_{\mu}(\boldsymbol{z})-|\mathcal{A}(\boldsymbol{z})|\big|\leq\tfrac{1}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\big|S_{\mu}(\boldsymbol{z})-|\mathcal{A}(\boldsymbol{z})|\big|\leq\tfrac{1}{2}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>Binarization loss</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">We next analyze the role of the binarization loss, which encourages the relaxed scores
<math id="A2.SS2.p1.m1" class="ltx_Math" alttext="\boldsymbol{s}=\phi(\boldsymbol{z};\mu)" display="inline" intent=":literal"><semantics><mrow><mi>𝒔</mi><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{s}=\phi(\boldsymbol{z};\mu)</annotation></semantics></math> to commit to <math id="A2.SS2.p1.m2" class="ltx_Math" alttext="\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,1\}</annotation></semantics></math> under the keep-budget constraint.</p>
</div>
<div id="A2.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem2.2" class="ltx_text ltx_font_bold">Proposition B.2</span></span><span id="A2.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Binarization regularizer drives <math id="A2.Thmtheorem2.m1" class="ltx_Math" alttext="\boldsymbol{s}" display="inline" intent=":literal"><semantics><mi>𝒔</mi><annotation encoding="application/x-tex">\boldsymbol{s}</annotation></semantics></math> toward <math id="A2.Thmtheorem2.m2" class="ltx_Math" alttext="\{0,1\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{0,1\}</annotation></semantics></math>)<span id="A2.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem2.p1" class="ltx_para">
<p id="A2.Thmtheorem2.p1.1" class="ltx_p"><span id="A2.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Fix <math id="A2.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and recall the relaxed keep budget
<math id="A2.Thmtheorem2.p1.m2" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})=\sum_{k=1}^{K}\phi(z_{k};\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})=\sum_{k=1}^{K}\phi(z_{k};\mu)</annotation></semantics></math> and constraint
<math id="A2.Thmtheorem2.p1.m3" class="ltx_Math" alttext="c_{\mu}(\boldsymbol{z})=S_{\mu}(\boldsymbol{z})-T" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>T</mi></mrow></mrow><annotation encoding="application/x-tex">c_{\mu}(\boldsymbol{z})=S_{\mu}(\boldsymbol{z})-T</annotation></semantics></math>.
Define</span></p>
<table id="A2.Ex7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex7.m1" class="ltx_Math" alttext="B(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{k}(1-s_{k}),\qquad s_{k}=\phi(z_{k};\mu)\in[0,1]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><msub><mi>s</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>s</mi><mi>k</mi></msub><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{k}(1-s_{k}),\qquad s_{k}=\phi(z_{k};\mu)\in[0,1],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p1.2" class="ltx_p"><span id="A2.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">and the (scaled) binarization loss</span></p>
<table id="A2.Ex8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex8.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B(\boldsymbol{z})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B(\boldsymbol{z}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p1.3" class="ltx_p"><span id="A2.Thmtheorem2.p1.3.1" class="ltx_text ltx_font_italic">Consider the constrained problem</span></p>
<table id="A2.E22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E22.m1" class="ltx_Math" alttext="\min_{\boldsymbol{z}}\;J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\quad\text{s.t.}\quad c_{\mu}(\boldsymbol{z})=0," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mi>min</mi><mi>𝒛</mi></munder><mo lspace="0.447em">⁡</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">s.t.</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\boldsymbol{z}}\;J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\quad\text{s.t.}\quad c_{\mu}(\boldsymbol{z})=0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(22)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p1.4" class="ltx_p"><span id="A2.Thmtheorem2.p1.4.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem2.p1.m4" class="ltx_Math" alttext="J(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z})</annotation></semantics></math> is any deterministic objective and
<math id="A2.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})</annotation></semantics></math> is the forward gate.</span></p>
</div>
<div id="A2.Thmtheorem2.p2" class="ltx_para">
<p id="A2.Thmtheorem2.p2.1" class="ltx_p"><span id="A2.Thmtheorem2.p2.1.1" class="ltx_text ltx_font_italic">Assume: (i) <math id="A2.Thmtheorem2.p2.m1" class="ltx_Math" alttext="J" display="inline" intent=":literal"><semantics><mi>J</mi><annotation encoding="application/x-tex">J</annotation></semantics></math> is bounded below on the feasible set <math id="A2.Thmtheorem2.p2.m2" class="ltx_Math" alttext="\{\boldsymbol{z}:c_{\mu}(\boldsymbol{z})=0\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi>𝐳</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}:c_{\mu}(\boldsymbol{z})=0\}</annotation></semantics></math> by <math id="A2.Thmtheorem2.p2.m3" class="ltx_Math" alttext="J_{\inf}" display="inline" intent=":literal"><semantics><msub><mi>J</mi><mo>inf</mo></msub><annotation encoding="application/x-tex">J_{\inf}</annotation></semantics></math>; and
(ii) there exists a <em id="A2.Thmtheorem2.p2.1.1.1" class="ltx_emph ltx_font_upright">binary feasible</em> point <math id="A2.Thmtheorem2.p2.m4" class="ltx_Math" alttext="\boldsymbol{z}^{\mathrm{bin}}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mi>bin</mi></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\mathrm{bin}}</annotation></semantics></math> such that
<math id="A2.Thmtheorem2.p2.m5" class="ltx_Math" alttext="c_{\mu}(\boldsymbol{z}^{\mathrm{bin}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c_{\mu}(\boldsymbol{z}^{\mathrm{bin}})=0</annotation></semantics></math> and <math id="A2.Thmtheorem2.p2.m6" class="ltx_Math" alttext="\boldsymbol{s}(\boldsymbol{z}^{\mathrm{bin}})\in\{0,1\}^{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{s}(\boldsymbol{z}^{\mathrm{bin}})\in\{0,1\}^{K}</annotation></semantics></math>
(hence <math id="A2.Thmtheorem2.p2.m7" class="ltx_Math" alttext="B(\boldsymbol{z}^{\mathrm{bin}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B(\boldsymbol{z}^{\mathrm{bin}})=0</annotation></semantics></math> and <math id="A2.Thmtheorem2.p2.m8" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{\mathrm{bin}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{\mathrm{bin}})=0</annotation></semantics></math>).</span></p>
</div>
<div id="A2.Thmtheorem2.p3" class="ltx_para">
<p id="A2.Thmtheorem2.p3.1" class="ltx_p"><span id="A2.Thmtheorem2.p3.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem2.p3.m1" class="ltx_Math" alttext="\boldsymbol{z}_{\lambda_{3}}" display="inline" intent=":literal"><semantics><msub><mi>𝐳</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><annotation encoding="application/x-tex">\boldsymbol{z}_{\lambda_{3}}</annotation></semantics></math> be any global minimizer of (<a href="#A2.E22" title="Equation 22 ‣ Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>). Then</span></p>
<table id="A2.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E23.m1" class="ltx_Math" alttext="B(\boldsymbol{z}_{\lambda_{3}})\leq\frac{J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf}}{\lambda_{3}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>J</mi><mo>inf</mo></msub></mrow><msub><mi>λ</mi><mn>3</mn></msub></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">B(\boldsymbol{z}_{\lambda_{3}})\leq\frac{J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf}}{\lambda_{3}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p3.2" class="ltx_p"><span id="A2.Thmtheorem2.p3.2.1" class="ltx_text ltx_font_italic">and the average distance of <math id="A2.Thmtheorem2.p3.m2" class="ltx_Math" alttext="\boldsymbol{s}" display="inline" intent=":literal"><semantics><mi>𝐬</mi><annotation encoding="application/x-tex">\boldsymbol{s}</annotation></semantics></math> to the binary set is bounded by</span></p>
<table id="A2.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E24.m1" class="ltx_Math" alttext="\frac{1}{K}\sum_{k=1}^{K}\min\{s_{k},\,1-s_{k}\}\;\leq\;2\,B(\boldsymbol{z}_{\lambda_{3}})\;\leq\;\frac{2\big(J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf}\big)}{\lambda_{3}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>s</mi><mi>k</mi></msub><mo>,</mo><mrow><mn> 1</mn><mo>−</mo><msub><mi>s</mi><mi>k</mi></msub></mrow></mrow><mo rspace="0.280em" stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mn> 2</mn><mo lspace="0.170em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.558em">≤</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>J</mi><mo>inf</mo></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msub><mi>λ</mi><mn>3</mn></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{K}\sum_{k=1}^{K}\min\{s_{k},\,1-s_{k}\}\;\leq\;2\,B(\boldsymbol{z}_{\lambda_{3}})\;\leq\;\frac{2\big(J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf}\big)}{\lambda_{3}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem2.p3.3" class="ltx_p"><span id="A2.Thmtheorem2.p3.3.1" class="ltx_text ltx_font_italic">Consequently, as <math id="A2.Thmtheorem2.p3.m3" class="ltx_Math" alttext="\lambda_{3}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lambda_{3}\to\infty</annotation></semantics></math>, any sequence of minimizers <math id="A2.Thmtheorem2.p3.m4" class="ltx_Math" alttext="\{\boldsymbol{z}_{\lambda_{3}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝐳</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{\lambda_{3}}\}</annotation></semantics></math> satisfies
<math id="A2.Thmtheorem2.p3.m5" class="ltx_Math" alttext="B(\boldsymbol{z}_{\lambda_{3}})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐳</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B(\boldsymbol{z}_{\lambda_{3}})\to 0</annotation></semantics></math>, and the relaxed scores <math id="A2.Thmtheorem2.p3.m6" class="ltx_Math" alttext="\boldsymbol{s}" display="inline" intent=":literal"><semantics><mi>𝐬</mi><annotation encoding="application/x-tex">\boldsymbol{s}</annotation></semantics></math> become (on average) arbitrarily close to <math id="A2.Thmtheorem2.p3.m7" class="ltx_Math" alttext="\{0,1\}^{K}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>K</mi></msup><annotation encoding="application/x-tex">\{0,1\}^{K}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS2.p2" class="ltx_para">
<p id="A2.SS2.p2.1" class="ltx_p"><span id="A2.SS2.p2.1.1" class="ltx_text">Let <math id="A2.SS2.p2.m1" class="ltx_Math" alttext="\boldsymbol{z}_{\lambda_{3}}" display="inline" intent=":literal"><semantics><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><annotation encoding="application/x-tex">\boldsymbol{z}_{\lambda_{3}}</annotation></semantics></math> be a global minimizer of (<a href="#A2.E22" title="Equation 22 ‣ Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), and let <math id="A2.SS2.p2.m2" class="ltx_Math" alttext="\boldsymbol{z}^{\mathrm{bin}}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mi>bin</mi></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\mathrm{bin}}</annotation></semantics></math> be the binary feasible point.
Since both are feasible and <math id="A2.SS2.p2.m3" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{\mathrm{bin}})=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{\mathrm{bin}})=0</annotation></semantics></math>, optimality implies</span></p>
<table id="A2.Ex9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex9.m1" class="ltx_Math" alttext="J(\boldsymbol{z}_{\lambda_{3}})+\lambda_{3}B(\boldsymbol{z}_{\lambda_{3}})\;\leq\;J(\boldsymbol{z}^{\mathrm{bin}})+\lambda_{3}B(\boldsymbol{z}^{\mathrm{bin}})=J(\boldsymbol{z}^{\mathrm{bin}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo rspace="0.280em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.558em">≤</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z}_{\lambda_{3}})+\lambda_{3}B(\boldsymbol{z}_{\lambda_{3}})\;\leq\;J(\boldsymbol{z}^{\mathrm{bin}})+\lambda_{3}B(\boldsymbol{z}^{\mathrm{bin}})=J(\boldsymbol{z}^{\mathrm{bin}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.2" class="ltx_p"><span id="A2.SS2.p2.2.1" class="ltx_text">Rearranging gives</span></p>
<table id="A2.Ex10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex10.m1" class="ltx_Math" alttext="\lambda_{3}B(\boldsymbol{z}_{\lambda_{3}})\leq J(\boldsymbol{z}^{\mathrm{bin}})-J(\boldsymbol{z}_{\lambda_{3}})\leq J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mi>bin</mi></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>J</mi><mo>inf</mo></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\lambda_{3}B(\boldsymbol{z}_{\lambda_{3}})\leq J(\boldsymbol{z}^{\mathrm{bin}})-J(\boldsymbol{z}_{\lambda_{3}})\leq J(\boldsymbol{z}^{\mathrm{bin}})-J_{\inf},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p2.3" class="ltx_p"><span id="A2.SS2.p2.3.1" class="ltx_text">where the last inequality uses <math id="A2.SS2.p2.m4" class="ltx_Math" alttext="J(\boldsymbol{z}_{\lambda_{3}})\geq J_{\inf}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><msub><mi>J</mi><mo>inf</mo></msub></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z}_{\lambda_{3}})\geq J_{\inf}</annotation></semantics></math> on the feasible set. Dividing by <math id="A2.SS2.p2.m5" class="ltx_Math" alttext="\lambda_{3}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\lambda_{3}</annotation></semantics></math> yields
(<a href="#A2.E23" title="Equation 23 ‣ Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).</span></p>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p"><span id="A2.SS2.p3.1.1" class="ltx_text">For (<a href="#A2.E24" title="Equation 24 ‣ Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>), note that for any <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="s\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">s\in[0,1]</annotation></semantics></math>,</span></p>
<table id="A2.Ex11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex11.m1" class="ltx_Math" alttext="\min\{s,1-s\}\leq 2s(1-s)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><mi>s</mi><mo>,</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>s</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min\{s,1-s\}\leq 2s(1-s).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.2" class="ltx_p"><span id="A2.SS2.p3.2.1" class="ltx_text">Applying this elementwise and averaging gives</span></p>
<table id="A2.Ex12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex12.m1" class="ltx_Math" alttext="\frac{1}{K}\sum_{k=1}^{K}\min\{s_{k},1-s_{k}\}\leq\frac{1}{K}\sum_{k=1}^{K}2s_{k}(1-s_{k})=2B(\boldsymbol{z}_{\lambda_{3}})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi>s</mi><mi>k</mi></msub><mo>,</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>s</mi><mi>k</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>s</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>s</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>λ</mi><mn>3</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\frac{1}{K}\sum_{k=1}^{K}\min\{s_{k},1-s_{k}\}\leq\frac{1}{K}\sum_{k=1}^{K}2s_{k}(1-s_{k})=2B(\boldsymbol{z}_{\lambda_{3}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS2.p3.3" class="ltx_p"><span id="A2.SS2.p3.3.1" class="ltx_text">and the final bound follows from (<a href="#A2.E23" title="Equation 23 ‣ Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>).
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Convergence of deterministic augmented Lagrangian optimization</h3>

<div id="A2.SS3.p1" class="ltx_para">
<p id="A2.SS3.p1.1" class="ltx_p">For any fixed <math id="A2.SS3.p1.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math>, the equality-constrained surrogate induced by the deterministic mapping <math id="A2.SS3.p1.m2" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> can be optimized
with an inexact augmented Lagrangian / method-of-multipliers scheme.
The following theorem states a standard KKT accumulation-point guarantee for the deterministic iterates, under an STE-surrogate interpretation.</p>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Theorem B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Deterministic inexact ALM yields KKT accumulation points (STE surrogate))<span id="A2.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p"><span id="A2.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Fix an annealing level <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and a binarization weight <math id="A2.Thmtheorem3.p1.m2" class="ltx_Math" alttext="\lambda_{3}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{3}\geq 0</annotation></semantics></math>, and define the relaxed keep budget</span></p>
<table id="A2.Ex13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex13.m1" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})\triangleq\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≜</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>P</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})\triangleq\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p1.2" class="ltx_p"><span id="A2.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> is the deterministic surrogate mapping in <a href="#S3.E12" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a> and <math id="A2.Thmtheorem3.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> is the target number of active components.
Let the forward gate be <math id="A2.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})</annotation></semantics></math> as in <a href="#S3.E11" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">11</span></a>. Define the relaxed-score vector
<math id="A2.Thmtheorem3.p1.m6" class="ltx_Math" alttext="\boldsymbol{s}(\boldsymbol{z})\in[0,1]^{K}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐬</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{s}(\boldsymbol{z})\in[0,1]^{K}</annotation></semantics></math> by <math id="A2.Thmtheorem3.p1.m7" class="ltx_Math" alttext="s_{k}(\boldsymbol{z})=\phi(z_{k};\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{k}(\boldsymbol{z})=\phi(z_{k};\mu)</annotation></semantics></math>, and</span></p>
<table id="A2.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex14.m1" class="ltx_Math" alttext="B(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{k}(\boldsymbol{z})\bigl(1-s_{k}(\boldsymbol{z})\bigr),\qquad\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B(\boldsymbol{z})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>B</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><msub><mi>s</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>s</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{k}(\boldsymbol{z})\bigl(1-s_{k}(\boldsymbol{z})\bigr),\qquad\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B(\boldsymbol{z}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p1.3" class="ltx_p"><span id="A2.Thmtheorem3.p1.3.1" class="ltx_text ltx_font_italic">Let</span></p>
<table id="A2.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex15.m1" class="ltx_Math" alttext="F(\boldsymbol{z})\triangleq J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F(\boldsymbol{z})\triangleq J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p1.4" class="ltx_p"><span id="A2.Thmtheorem3.p1.4.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem3.p1.m8" class="ltx_Math" alttext="J(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z})</annotation></semantics></math> can be any deterministic training loss (e.g., <math id="A2.Thmtheorem3.p1.m9" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m}(\boldsymbol{z}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ce</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m}(\boldsymbol{z}))</annotation></semantics></math> plus optional distillation terms).
Consider the equality-constrained STE-induced surrogate problem</span></p>
<table id="A2.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E25.m1" class="ltx_Math" alttext="\min_{\boldsymbol{z}}\;F(\boldsymbol{z})\quad\text{s.t.}\quad c(\boldsymbol{z})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>min</mi><mi>𝒛</mi></munder><mo lspace="0.447em">⁡</mo><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">s.t.</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{\boldsymbol{z}}\;F(\boldsymbol{z})\quad\text{s.t.}\quad c(\boldsymbol{z})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem3.p2" class="ltx_para">
<p id="A2.Thmtheorem3.p2.1" class="ltx_p"><span id="A2.Thmtheorem3.p2.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem3.p2.m1" class="ltx_Math" alttext="\{\boldsymbol{z}_{t},\nu_{t},\gamma_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>t</mi></msub><mo>,</mo><msub><mi>γ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{t},\nu_{t},\gamma_{t}\}</annotation></semantics></math> be generated by an inexact method-of-multipliers (augmented Lagrangian) scheme applied to</span></p>
<table id="A2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex16.m1" class="ltx_Math" alttext="\mathcal{L}_{\gamma_{t}}(\boldsymbol{z},\nu)\triangleq F(\boldsymbol{z})+\nu\,c(\boldsymbol{z})+\frac{\gamma_{t}}{2}\,c(\boldsymbol{z})^{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mi>γ</mi><mi>t</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><mi>F</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ν</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mn>2</mn></mfrac><mo lspace="0.170em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\gamma_{t}}(\boldsymbol{z},\nu)\triangleq F(\boldsymbol{z})+\nu\,c(\boldsymbol{z})+\frac{\gamma_{t}}{2}\,c(\boldsymbol{z})^{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p2.2" class="ltx_p"><span id="A2.Thmtheorem3.p2.2.1" class="ltx_text ltx_font_italic">i.e., each outer iteration performs (possibly inexact) descent steps on <math id="A2.Thmtheorem3.p2.m2" class="ltx_Math" alttext="\boldsymbol{z}" display="inline" intent=":literal"><semantics><mi>𝐳</mi><annotation encoding="application/x-tex">\boldsymbol{z}</annotation></semantics></math> and then updates</span></p>
<table id="A2.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex17.m1" class="ltx_Math" alttext="\nu_{t+1}=\nu_{t}+\gamma_{t}\,c(\boldsymbol{z}_{t})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>ν</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>=</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>+</mo><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\nu_{t+1}=\nu_{t}+\gamma_{t}\,c(\boldsymbol{z}_{t}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem3.p2.3" class="ltx_p"><span id="A2.Thmtheorem3.p2.3.1" class="ltx_text ltx_font_italic">with <math id="A2.Thmtheorem3.p2.m3" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math> nondecreasing (and increased when feasibility stalls).</span></p>
</div>
<div id="A2.Thmtheorem3.p3" class="ltx_para">
<p id="A2.Thmtheorem3.p3.1" class="ltx_p"><span id="A2.Thmtheorem3.p3.1.1" class="ltx_text ltx_font_italic">Assume:</span></p>
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A1)</span> 
<div id="A2.I1.ix1.p1" class="ltx_para">
<p id="A2.I1.ix1.p1.1" class="ltx_p"><span id="A2.I1.ix1.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I1.ix1.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">STE-surrogate regularity</span><span id="A2.I1.ix1.p1.1.3" class="ltx_text ltx_font_italic">) </span><math id="A2.I1.ix1.p1.m1" class="ltx_Math" alttext="F" display="inline" intent=":literal"><semantics><mi>F</mi><annotation encoding="application/x-tex">F</annotation></semantics></math><span id="A2.I1.ix1.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="A2.I1.ix1.p1.m2" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math><span id="A2.I1.ix1.p1.1.5" class="ltx_text ltx_font_italic"> are continuously differentiable on a neighborhood containing all iterates,
where </span><math id="A2.I1.ix1.p1.m3" class="ltx_Math" alttext="\nabla F" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\nabla F</annotation></semantics></math><span id="A2.I1.ix1.p1.1.6" class="ltx_text ltx_font_italic"> and </span><math id="A2.I1.ix1.p1.m4" class="ltx_Math" alttext="\nabla c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\nabla c</annotation></semantics></math><span id="A2.I1.ix1.p1.1.7" class="ltx_text ltx_font_italic"> are interpreted as the gradients induced by the chosen STE for </span><math id="A2.I1.ix1.p1.m5" class="ltx_Math" alttext="\mathrm{ReLU}/\mathrm{Clamp}" display="inline" intent=":literal"><semantics><mrow><mi>ReLU</mi><mo>/</mo><mi>Clamp</mi></mrow><annotation encoding="application/x-tex">\mathrm{ReLU}/\mathrm{Clamp}</annotation></semantics></math><span id="A2.I1.ix1.p1.1.8" class="ltx_text ltx_font_italic">.</span></p>
</div></li>
<li id="A2.I1.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A2)</span> 
<div id="A2.I1.ix2.p1" class="ltx_para">
<p id="A2.I1.ix2.p1.1" class="ltx_p"><span id="A2.I1.ix2.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I1.ix2.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">Constraint nondegeneracy on iterates</span><span id="A2.I1.ix2.p1.1.3" class="ltx_text ltx_font_italic">) There exists </span><math id="A2.I1.ix2.p1.m1" class="ltx_Math" alttext="\underline{\gamma}&gt;0" display="inline" intent=":literal"><semantics><mrow><munder accentunder="true"><mi>γ</mi><mo stretchy="true">¯</mo></munder><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\underline{\gamma}&gt;0</annotation></semantics></math><span id="A2.I1.ix2.p1.1.4" class="ltx_text ltx_font_italic"> such that
</span><math id="A2.I1.ix2.p1.m2" class="ltx_Math" alttext="\|\nabla c(\boldsymbol{z}_{t})\|\geq\underline{\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≥</mo><munder accentunder="true"><mi>γ</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">\|\nabla c(\boldsymbol{z}_{t})\|\geq\underline{\gamma}</annotation></semantics></math><span id="A2.I1.ix2.p1.1.5" class="ltx_text ltx_font_italic"> for all sufficiently large </span><math id="A2.I1.ix2.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="A2.I1.ix2.p1.1.6" class="ltx_text ltx_font_italic">.
(In particular, this implies LICQ at feasible limit points.)</span></p>
</div></li>
<li id="A2.I1.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A3)</span> 
<div id="A2.I1.ix3.p1" class="ltx_para">
<p id="A2.I1.ix3.p1.1" class="ltx_p"><span id="A2.I1.ix3.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I1.ix3.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">Inexact primal stationarity</span><span id="A2.I1.ix3.p1.1.3" class="ltx_text ltx_font_italic">) The inexact primal update satisfies</span></p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\bigl\|\nabla_{\boldsymbol{z}}\mathcal{L}_{\gamma_{t}}(\boldsymbol{z}_{t},\nu_{t})\bigr\|\leq\varepsilon_{t},\qquad\text{with }\varepsilon_{t}\to 0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>𝒛</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mi>γ</mi><mi>t</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mo>≤</mo><msub><mi>ε</mi><mi>t</mi></msub></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mtext class="ltx_mathvariant_italic">with </mtext><mo lspace="0em" rspace="0em">​</mo><msub><mi>ε</mi><mi>t</mi></msub></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bigl\|\nabla_{\boldsymbol{z}}\mathcal{L}_{\gamma_{t}}(\boldsymbol{z}_{t},\nu_{t})\bigr\|\leq\varepsilon_{t},\qquad\text{with }\varepsilon_{t}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I1.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A4)</span> 
<div id="A2.I1.ix4.p1" class="ltx_para">
<p id="A2.I1.ix4.p1.1" class="ltx_p"><span id="A2.I1.ix4.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I1.ix4.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">Bounded iterates and penalty growth</span><span id="A2.I1.ix4.p1.1.3" class="ltx_text ltx_font_italic">) The iterates </span><math id="A2.I1.ix4.p1.m1" class="ltx_Math" alttext="\{\boldsymbol{z}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{t}\}</annotation></semantics></math><span id="A2.I1.ix4.p1.1.4" class="ltx_text ltx_font_italic"> remain in a compact set, </span><math id="A2.I1.ix4.p1.m2" class="ltx_Math" alttext="\{\gamma_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>γ</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\gamma_{t}\}</annotation></semantics></math><span id="A2.I1.ix4.p1.1.5" class="ltx_text ltx_font_italic"> is nondecreasing,
and </span><math id="A2.I1.ix4.p1.m3" class="ltx_Math" alttext="\gamma_{t}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\gamma_{t}</annotation></semantics></math><span id="A2.I1.ix4.p1.1.6" class="ltx_text ltx_font_italic"> is increased without bound if feasibility stalls (i.e., if </span><math id="A2.I1.ix4.p1.m4" class="ltx_Math" alttext="|c(\boldsymbol{z}_{t})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|c(\boldsymbol{z}_{t})|</annotation></semantics></math><span id="A2.I1.ix4.p1.1.7" class="ltx_text ltx_font_italic"> does not decrease sufficiently).</span></p>
</div></li>
</ul>
</div>
<div id="A2.Thmtheorem3.p4" class="ltx_para">
<p id="A2.Thmtheorem3.p4.1" class="ltx_p"><span id="A2.Thmtheorem3.p4.1.1" class="ltx_text ltx_font_italic">Then any accumulation point <math id="A2.Thmtheorem3.p4.m1" class="ltx_Math" alttext="\boldsymbol{z}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝐳</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\star}</annotation></semantics></math> of <math id="A2.Thmtheorem3.p4.m2" class="ltx_Math" alttext="\{\boldsymbol{z}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝐳</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{t}\}</annotation></semantics></math> is feasible (<math id="A2.Thmtheorem3.p4.m3" class="ltx_Math" alttext="c(\boldsymbol{z}^{\star})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}^{\star})=0</annotation></semantics></math>), and there exists
<math id="A2.Thmtheorem3.p4.m4" class="ltx_Math" alttext="\nu^{\star}" display="inline" intent=":literal"><semantics><msup><mi>ν</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\nu^{\star}</annotation></semantics></math> such that <math id="A2.Thmtheorem3.p4.m5" class="ltx_Math" alttext="(\boldsymbol{z}^{\star},\nu^{\star})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>𝐳</mi><mo>⋆</mo></msup><mo>,</mo><msup><mi>ν</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\boldsymbol{z}^{\star},\nu^{\star})</annotation></semantics></math> satisfies the first-order KKT conditions of (<a href="#A2.E25" title="Equation 25 ‣ Theorem B.3 (Deterministic inexact ALM yields KKT accumulation points (STE surrogate)). ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>):</span></p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_math_unparsed" alttext="\nabla F(\boldsymbol{z}^{\star})+\nu^{\star}\nabla c(\boldsymbol{z}^{\star})=0,\qquad c(\boldsymbol{z}^{\star})=0." display="block" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>ν</mi><mo>⋆</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo rspace="2.167em">,</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\nabla F(\boldsymbol{z}^{\star})+\nu^{\star}\nabla c(\boldsymbol{z}^{\star})=0,\qquad c(\boldsymbol{z}^{\star})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A2.SS3.p2" class="ltx_para">
<p id="A2.SS3.p2.1" class="ltx_p"><span id="A2.SS3.p2.1.1" class="ltx_text">Fix <math id="A2.SS3.p2.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and <math id="A2.SS3.p2.m2" class="ltx_Math" alttext="\lambda_{3}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\lambda_{3}\geq 0</annotation></semantics></math>, and write <math id="A2.SS3.p2.m3" class="ltx_Math" alttext="c(\boldsymbol{z})=S_{\mu}(\boldsymbol{z})-P" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>P</mi></mrow></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z})=S_{\mu}(\boldsymbol{z})-P</annotation></semantics></math>.
Define the effective multiplier</span></p>
<table id="A2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\tilde{\nu}_{t}\triangleq\nu_{t}+\gamma_{t}\,c(\boldsymbol{z}_{t})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo>≜</mo><mrow><msub><mi>ν</mi><mi>t</mi></msub><mo>+</mo><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\nu}_{t}\triangleq\nu_{t}+\gamma_{t}\,c(\boldsymbol{z}_{t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.p2.2" class="ltx_p"><span id="A2.SS3.p2.2.1" class="ltx_text">By the multiplier update, <math id="A2.SS3.p2.m4" class="ltx_Math" alttext="\tilde{\nu}_{t}=\nu_{t+1}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo>=</mo><msub><mi>ν</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\nu}_{t}=\nu_{t+1}</annotation></semantics></math>.
The inexact primal condition (A3) expands as</span></p>
<table id="A2.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E26.m1" class="ltx_math_unparsed" alttext="\Bigl\|\nabla F(\boldsymbol{z}_{t})+\tilde{\nu}_{t}\,\nabla c(\boldsymbol{z}_{t})\Bigr\|=\bigl\|\nabla_{\boldsymbol{z}}\mathcal{L}_{\gamma_{t}}(\boldsymbol{z}_{t},\nu_{t})\bigr\|\leq\varepsilon_{t}." display="block" intent=":literal"><semantics><mrow><mo mathsize="1.600em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.600em" rspace="0.0835em">∥</mo><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msub><mo rspace="0.167em">∇</mo><mi>𝒛</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><msub><mi>γ</mi><mi>t</mi></msub></msub><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo>,</mo><msub><mi>ν</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><msub><mi>ε</mi><mi>t</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Bigl\|\nabla F(\boldsymbol{z}_{t})+\tilde{\nu}_{t}\,\nabla c(\boldsymbol{z}_{t})\Bigr\|=\bigl\|\nabla_{\boldsymbol{z}}\mathcal{L}_{\gamma_{t}}(\boldsymbol{z}_{t},\nu_{t})\bigr\|\leq\varepsilon_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
</div>
<section id="A2.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 1: Boundedness of gradients and <math id="A2.SS3.SSS0.Px1.m1" class="ltx_Math" alttext="\tilde{\nu}_{t}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><annotation encoding="application/x-tex">\tilde{\nu}_{t}</annotation></semantics></math>.</h5>

<div id="A2.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A2.SS3.SSS0.Px1.p1.1" class="ltx_p">By (A4), <math id="A2.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\{\boldsymbol{z}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{t}\}</annotation></semantics></math> lies in some compact set <math id="A2.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math>.
By (A1), <math id="A2.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\nabla F" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\nabla F</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\nabla c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\nabla c</annotation></semantics></math> are continuous on <math id="A2.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\mathcal{Z}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒵</mi><annotation encoding="application/x-tex">\mathcal{Z}</annotation></semantics></math> and thus bounded:
there exists <math id="A2.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="G&lt;\infty" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>&lt;</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">G&lt;\infty</annotation></semantics></math> such that <math id="A2.SS3.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\|\nabla F(\boldsymbol{z})\|\leq G" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≤</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">\|\nabla F(\boldsymbol{z})\|\leq G</annotation></semantics></math> for all <math id="A2.SS3.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\boldsymbol{z}\in\mathcal{Z}" display="inline" intent=":literal"><semantics><mrow><mi>𝒛</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒵</mi></mrow><annotation encoding="application/x-tex">\boldsymbol{z}\in\mathcal{Z}</annotation></semantics></math>.
Combining (<a href="#A2.E26" title="Equation 26 ‣ Proof. ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>) with the triangle inequality yields</p>
<table id="A2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex21.m1" class="ltx_Math" alttext="|\tilde{\nu}_{t}|\,\|\nabla c(\boldsymbol{z}_{t})\|\leq\|\nabla F(\boldsymbol{z}_{t})\|+\varepsilon_{t}\leq G+\varepsilon_{t}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>+</mo><msub><mi>ε</mi><mi>t</mi></msub></mrow><mo>≤</mo><mrow><mi>G</mi><mo>+</mo><msub><mi>ε</mi><mi>t</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|\tilde{\nu}_{t}|\,\|\nabla c(\boldsymbol{z}_{t})\|\leq\|\nabla F(\boldsymbol{z}_{t})\|+\varepsilon_{t}\leq G+\varepsilon_{t}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px1.p1.2" class="ltx_p">Using (A2), for all sufficiently large <math id="A2.SS3.SSS0.Px1.p1.m9" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> we have <math id="A2.SS3.SSS0.Px1.p1.m10" class="ltx_Math" alttext="\|\nabla c(\boldsymbol{z}_{t})\|\geq\underline{\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mo>≥</mo><munder accentunder="true"><mi>γ</mi><mo stretchy="true">¯</mo></munder></mrow><annotation encoding="application/x-tex">\|\nabla c(\boldsymbol{z}_{t})\|\geq\underline{\gamma}</annotation></semantics></math>, hence</p>
<table id="A2.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E27.m1" class="ltx_Math" alttext="|\tilde{\nu}_{t}|\leq\frac{G+\varepsilon_{t}}{\underline{\gamma}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">|</mo></mrow><mo>≤</mo><mfrac><mrow><mi>G</mi><mo>+</mo><msub><mi>ε</mi><mi>t</mi></msub></mrow><munder accentunder="true"><mi>γ</mi><mo stretchy="true">¯</mo></munder></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">|\tilde{\nu}_{t}|\leq\frac{G+\varepsilon_{t}}{\underline{\gamma}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px1.p1.3" class="ltx_p">so <math id="A2.SS3.SSS0.Px1.p1.m11" class="ltx_Math" alttext="\{\tilde{\nu}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{\nu}_{t}\}</annotation></semantics></math> (equivalently <math id="A2.SS3.SSS0.Px1.p1.m12" class="ltx_Math" alttext="\{\nu_{t+1}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>ν</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\nu_{t+1}\}</annotation></semantics></math>) is bounded for all large <math id="A2.SS3.SSS0.Px1.p1.m13" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 2: Feasibility of accumulation points.</h5>

<div id="A2.SS3.SSS0.Px2.p1" class="ltx_para">
<p id="A2.SS3.SSS0.Px2.p1.1" class="ltx_p">Let <math id="A2.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\boldsymbol{z}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\star}</annotation></semantics></math> be any accumulation point of <math id="A2.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\{\boldsymbol{z}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\boldsymbol{z}_{t}\}</annotation></semantics></math>, and suppose for contradiction that
<math id="A2.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="c(\boldsymbol{z}^{\star})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}^{\star})\neq 0</annotation></semantics></math>.
Then there exists a subsequence <math id="A2.SS3.SSS0.Px2.p1.m4" class="ltx_Math" alttext="t_{j}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>j</mi></msub><annotation encoding="application/x-tex">t_{j}</annotation></semantics></math> such that <math id="A2.SS3.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\boldsymbol{z}_{t_{j}}\to\boldsymbol{z}^{\star}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">→</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{z}_{t_{j}}\to\boldsymbol{z}^{\star}</annotation></semantics></math>, and by continuity of <math id="A2.SS3.SSS0.Px2.p1.m6" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>,
<math id="A2.SS3.SSS0.Px2.p1.m7" class="ltx_Math" alttext="|c(\boldsymbol{z}_{t_{j}})|\to|c(\boldsymbol{z}^{\star})|&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo stretchy="false">→</mo><mrow><mo stretchy="false">|</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">|c(\boldsymbol{z}_{t_{j}})|\to|c(\boldsymbol{z}^{\star})|&gt;0</annotation></semantics></math>, i.e., <math id="A2.SS3.SSS0.Px2.p1.m8" class="ltx_Math" alttext="|c(\boldsymbol{z}_{t_{j}})|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|c(\boldsymbol{z}_{t_{j}})|</annotation></semantics></math> is bounded away from <math id="A2.SS3.SSS0.Px2.p1.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> for large <math id="A2.SS3.SSS0.Px2.p1.m10" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>.
Under (A4), persistent nonvanishing constraint violation triggers <math id="A2.SS3.SSS0.Px2.p1.m11" class="ltx_Math" alttext="\gamma_{t_{j}}\to\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\gamma_{t_{j}}\to\infty</annotation></semantics></math> along such a subsequence.
But then</p>
<table id="A2.Ex22" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex22.m1" class="ltx_Math" alttext="\tilde{\nu}_{t_{j}}=\nu_{t_{j}}+\gamma_{t_{j}}c(\boldsymbol{z}_{t_{j}})=\nu_{t_{j}+1}" display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><msub><mi>t</mi><mi>j</mi></msub></msub><mo>=</mo><mrow><msub><mi>ν</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo>+</mo><mrow><msub><mi>γ</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><msub><mi>ν</mi><mrow><msub><mi>t</mi><mi>j</mi></msub><mo>+</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\tilde{\nu}_{t_{j}}=\nu_{t_{j}}+\gamma_{t_{j}}c(\boldsymbol{z}_{t_{j}})=\nu_{t_{j}+1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px2.p1.2" class="ltx_p">must diverge in magnitude because <math id="A2.SS3.SSS0.Px2.p1.m12" class="ltx_Math" alttext="\gamma_{t_{j}}|c(\boldsymbol{z}_{t_{j}})|\to\infty" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>γ</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\gamma_{t_{j}}|c(\boldsymbol{z}_{t_{j}})|\to\infty</annotation></semantics></math>, contradicting the boundedness of <math id="A2.SS3.SSS0.Px2.p1.m13" class="ltx_Math" alttext="\{\tilde{\nu}_{t}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><mi>t</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\tilde{\nu}_{t}\}</annotation></semantics></math>
from (<a href="#A2.E27" title="Equation 27 ‣ Step 1: Boundedness of gradients and 𝜈̃_𝑡. ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>). Therefore, every accumulation point must satisfy <math id="A2.SS3.SSS0.Px2.p1.m14" class="ltx_Math" alttext="c(\boldsymbol{z}^{\star})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}^{\star})=0</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS3.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Step 3: KKT stationarity at accumulation points.</h5>

<div id="A2.SS3.SSS0.Px3.p1" class="ltx_para">
<p id="A2.SS3.SSS0.Px3.p1.1" class="ltx_p">Take a convergent subsequence <math id="A2.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\boldsymbol{z}_{t_{j}}\to\boldsymbol{z}^{\star}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">→</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{z}_{t_{j}}\to\boldsymbol{z}^{\star}</annotation></semantics></math>. By Step 2, <math id="A2.SS3.SSS0.Px3.p1.m2" class="ltx_Math" alttext="c(\boldsymbol{z}^{\star})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}^{\star})=0</annotation></semantics></math>.
By Step 1, <math id="A2.SS3.SSS0.Px3.p1.m3" class="ltx_Math" alttext="\{\nu_{t_{j}+1}\}=\{\tilde{\nu}_{t_{j}}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>ν</mi><mrow><msub><mi>t</mi><mi>j</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">}</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>ν</mi><mo>~</mo></mover><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\{\nu_{t_{j}+1}\}=\{\tilde{\nu}_{t_{j}}\}</annotation></semantics></math> is bounded and hence admits a convergent sub-subsequence; relabel so that
<math id="A2.SS3.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\nu_{t_{j}+1}\to\nu^{\star}" display="inline" intent=":literal"><semantics><mrow><msub><mi>ν</mi><mrow><msub><mi>t</mi><mi>j</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">→</mo><msup><mi>ν</mi><mo>⋆</mo></msup></mrow><annotation encoding="application/x-tex">\nu_{t_{j}+1}\to\nu^{\star}</annotation></semantics></math>.
From (<a href="#A2.E26" title="Equation 26 ‣ Proof. ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>),</p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_math_unparsed" alttext="\Bigl\|\nabla F(\boldsymbol{z}_{t_{j}})+\nu_{t_{j}+1}\nabla c(\boldsymbol{z}_{t_{j}})\Bigr\|\leq\varepsilon_{t_{j}}\to 0." display="block" intent=":literal"><semantics><mrow><mo mathsize="1.600em" rspace="0.167em">∥</mo><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>ν</mi><mrow><msub><mi>t</mi><mi>j</mi></msub><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" mathsize="1.600em" rspace="0.0835em">∥</mo><mo lspace="0.0835em">≤</mo><msub><mi>ε</mi><msub><mi>t</mi><mi>j</mi></msub></msub><mo stretchy="false">→</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Bigl\|\nabla F(\boldsymbol{z}_{t_{j}})+\nu_{t_{j}+1}\nabla c(\boldsymbol{z}_{t_{j}})\Bigr\|\leq\varepsilon_{t_{j}}\to 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS0.Px3.p1.2" class="ltx_p">Using continuity of <math id="A2.SS3.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\nabla F" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi></mrow><annotation encoding="application/x-tex">\nabla F</annotation></semantics></math> and <math id="A2.SS3.SSS0.Px3.p1.m6" class="ltx_Math" alttext="\nabla c" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>c</mi></mrow><annotation encoding="application/x-tex">\nabla c</annotation></semantics></math> (A1), letting <math id="A2.SS3.SSS0.Px3.p1.m7" class="ltx_Math" alttext="j\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">j\to\infty</annotation></semantics></math> yields
<math id="A2.SS3.SSS0.Px3.p1.m8" class="ltx_math_unparsed" alttext="\nabla F(\boldsymbol{z}^{\star})+\nu^{\star}\nabla c(\boldsymbol{z}^{\star})=0" display="inline" intent=":literal"><semantics><mrow><mo rspace="0.167em">∇</mo><mi>F</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>ν</mi><mo>⋆</mo></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><mi>c</mi><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla F(\boldsymbol{z}^{\star})+\nu^{\star}\nabla c(\boldsymbol{z}^{\star})=0</annotation></semantics></math>.
Together with feasibility <math id="A2.SS3.SSS0.Px3.p1.m9" class="ltx_Math" alttext="c(\boldsymbol{z}^{\star})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}^{\star})=0</annotation></semantics></math>, this is exactly the first-order KKT condition for (<a href="#A2.E25" title="Equation 25 ‣ Theorem B.3 (Deterministic inexact ALM yields KKT accumulation points (STE surrogate)). ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>).
∎</p>
</div>
<div id="A2.SS3.SSS0.Px3.p2" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS0.Px3.p2.1" class="ltx_p"><span id="A2.SS3.SSS0.Px3.p2.1.1" class="ltx_text ltx_font_bold">Remark (iterates need not be feasible).</span>
The primal iterates <math id="A2.SS3.SSS0.Px3.p2.m1" class="ltx_Math" alttext="\boldsymbol{z}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝒛</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\boldsymbol{z}_{t}</annotation></semantics></math> produced by the (inexact) descent steps generally do <em id="A2.SS3.SSS0.Px3.p2.1.2" class="ltx_emph ltx_font_italic">not</em> satisfy <math id="A2.SS3.SSS0.Px3.p2.m2" class="ltx_Math" alttext="c(\boldsymbol{z}_{t})=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>c</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒛</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">c(\boldsymbol{z}_{t})=0</annotation></semantics></math>.
Instead, the augmented penalty term <math id="A2.SS3.SSS0.Px3.p2.m3" class="ltx_Math" alttext="\frac{\gamma_{t}}{2}c(\boldsymbol{z})^{2}" display="inline" intent=":literal"><semantics><mrow><mfrac><msub><mi>γ</mi><mi>t</mi></msub><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">\frac{\gamma_{t}}{2}c(\boldsymbol{z})^{2}</annotation></semantics></math> and multiplier update drive feasibility over outer iterations,
and the theorem guarantees feasibility only at accumulation points.</p>
</div>
</section>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Final theorem</h3>

<div id="A2.SS4.p1" class="ltx_para">
<p id="A2.SS4.p1.1" class="ltx_p">We now combine Lemma <a href="#A2.Thmtheorem1" title="Lemma B.1 (Margin-separated relaxation approaches the discrete count). ‣ B.1 A basic property of the deterministic surrogate mapping ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a> (relaxed budget approaches the discrete count under a margin),
Proposition <a href="#A2.Thmtheorem2" title="Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> (binarization drives <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="\boldsymbol{s}" display="inline" intent=":literal"><semantics><mi>𝒔</mi><annotation encoding="application/x-tex">\boldsymbol{s}</annotation></semantics></math> toward <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="\{0,1\}^{K}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mi>K</mi></msup><annotation encoding="application/x-tex">\{0,1\}^{K}</annotation></semantics></math>),
and Theorem <a href="#A2.Thmtheorem3" title="Theorem B.3 (Deterministic inexact ALM yields KKT accumulation points (STE surrogate)). ‣ B.3 Convergence of deterministic augmented Lagrangian optimization ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a> (deterministic ALM admits KKT accumulation points at each fixed <math id="A2.SS4.p1.m3" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>),
to justify that staged DDP recovers the <em id="A2.SS4.p1.1.1" class="ltx_emph ltx_font_italic">exact</em> hard <math id="A2.SS4.p1.m4" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-budget for sufficiently small annealing levels.</p>
</div>
<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Theorem B.4</span></span><span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(DDP recovers the exact hard <math id="A2.Thmtheorem4.m1" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math>-budget in the annealed limit)<span id="A2.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐦</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ReLU</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}(\boldsymbol{z})=\mathrm{ReLU}(\boldsymbol{z})</annotation></semantics></math> and define the discrete hard-budget problem</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_math_unparsed" alttext="\min_{\boldsymbol{z}}\;J(\boldsymbol{z})\quad\text{s.t.}\quad\sum_{k=1}^{K}\mathbb{I}[z_{k}&gt;0]=P," display="block" intent=":literal"><semantics><mrow><munder><mi>min</mi><mi>𝒛</mi></munder><mi>J</mi><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mtext class="ltx_mathvariant_italic">s.t.</mtext><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>z</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>P</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\min_{\boldsymbol{z}}\;J(\boldsymbol{z})\quad\text{s.t.}\quad\sum_{k=1}^{K}\mathbb{I}[z_{k}&gt;0]=P,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A2.Thmtheorem4.p1.2" class="ltx_p"><span id="A2.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem4.p1.m2" class="ltx_Math" alttext="J(\boldsymbol{z})" display="inline" intent=":literal"><semantics><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">J(\boldsymbol{z})</annotation></semantics></math> is any deterministic training objective (e.g., <math id="A2.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m}(\boldsymbol{z}))" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>ce</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mrow><mi>𝐦</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{ce}}(\theta,\boldsymbol{m}(\boldsymbol{z}))</annotation></semantics></math>
plus optional distillation terms) and <math id="A2.Thmtheorem4.p1.m4" class="ltx_Math" alttext="P=[\rho K]" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>ρ</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">P=[\rho K]</annotation></semantics></math>.</span></p>
</div>
<div id="A2.Thmtheorem4.p2" class="ltx_para">
<p id="A2.Thmtheorem4.p2.1" class="ltx_p"><span id="A2.Thmtheorem4.p2.1.1" class="ltx_text ltx_font_italic">For each <math id="A2.Thmtheorem4.p2.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math>, define the relaxed keep budget and constraint</span></p>
<table id="A2.Ex24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex24.m1" class="ltx_Math" alttext="S_{\mu}(\boldsymbol{z})\triangleq\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c_{\mu}(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≜</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><msub><mi>S</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>P</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\mu}(\boldsymbol{z})\triangleq\sum_{k=1}^{K}\phi(z_{k};\mu),\qquad c_{\mu}(\boldsymbol{z})\triangleq S_{\mu}(\boldsymbol{z})-P,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem4.p2.2" class="ltx_p"><span id="A2.Thmtheorem4.p2.2.1" class="ltx_text ltx_font_italic">where <math id="A2.Thmtheorem4.p2.m2" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> is the deterministic surrogate mapping in <a href="#S3.E12" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a>. Define the relaxed-score vector
<math id="A2.Thmtheorem4.p2.m3" class="ltx_Math" alttext="\boldsymbol{s}_{\mu}(\boldsymbol{z})\in[0,1]^{K}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐬</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{s}_{\mu}(\boldsymbol{z})\in[0,1]^{K}</annotation></semantics></math> by <math id="A2.Thmtheorem4.p2.m4" class="ltx_Math" alttext="s_{\mu,k}(\boldsymbol{z})=\phi(z_{k};\mu)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>s</mi><mrow><mi>μ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐳</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>k</mi></msub><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">s_{\mu,k}(\boldsymbol{z})=\phi(z_{k};\mu)</annotation></semantics></math>, and the (unscaled) binarization measure</span></p>
<table id="A2.Ex25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex25.m1" class="ltx_Math" alttext="B_{\mu}(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{\mu,k}(\boldsymbol{z})\bigl(1-s_{\mu,k}(\boldsymbol{z})\bigr),\qquad\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B_{\mu}(\boldsymbol{z})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>B</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mfrac><mn>1</mn><mi>K</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mrow><msub><mi>s</mi><mrow><mi>μ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>s</mi><mrow><mi>μ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><msub><mi>λ</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>B</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{\mu}(\boldsymbol{z})\triangleq\frac{1}{K}\sum_{k=1}^{K}s_{\mu,k}(\boldsymbol{z})\bigl(1-s_{\mu,k}(\boldsymbol{z})\bigr),\qquad\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\triangleq\lambda_{3}\,B_{\mu}(\boldsymbol{z}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem4.p2.3" class="ltx_p"><span id="A2.Thmtheorem4.p2.3.1" class="ltx_text ltx_font_italic">Consider the relaxed constrained surrogate at annealing level <math id="A2.Thmtheorem4.p2.m5" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>:</span></p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\min_{\boldsymbol{z}}\;F_{\mu,\lambda_{3}}(\boldsymbol{z})\triangleq J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\quad\text{s.t.}\quad c_{\mu}(\boldsymbol{z})=0." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><munder><mi>min</mi><mi>𝒛</mi></munder><mo lspace="0.447em">⁡</mo><msub><mi>F</mi><mrow><mi>μ</mi><mo>,</mo><msub><mi>λ</mi><mn>3</mn></msub></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mspace style="width:1em;" width="1em"></mspace><mtext class="ltx_mathvariant_italic">s.t.</mtext><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><msub><mi>c</mi><mi>μ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\min_{\boldsymbol{z}}\;F_{\mu,\lambda_{3}}(\boldsymbol{z})\triangleq J(\boldsymbol{z})+\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z})\quad\text{s.t.}\quad c_{\mu}(\boldsymbol{z})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem4.p3" class="ltx_para">
<p id="A2.Thmtheorem4.p3.1" class="ltx_p"><span id="A2.Thmtheorem4.p3.1.1" class="ltx_text ltx_font_italic">Run <span id="A2.Thmtheorem4.p3.1.1.1" class="ltx_text ltx_font_smallcaps">DDP</span> in outer rounds <math id="A2.Thmtheorem4.p3.m1" class="ltx_Math" alttext="r=1,2,\dots" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><annotation encoding="application/x-tex">r=1,2,\dots</annotation></semantics></math> with <math id="A2.Thmtheorem4.p3.m2" class="ltx_Math" alttext="\mu_{r}\downarrow 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>r</mi></msub><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu_{r}\downarrow 0</annotation></semantics></math> and <math id="A2.Thmtheorem4.p3.m3" class="ltx_Math" alttext="\lambda_{3,r}\uparrow\infty" display="inline" intent=":literal"><semantics><mrow><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub><mo stretchy="false">↑</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">\lambda_{3,r}\uparrow\infty</annotation></semantics></math>.
At round <math id="A2.Thmtheorem4.p3.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, apply an inexact method-of-multipliers (augmented Lagrangian) scheme (with STE-induced gradients for
<math id="A2.Thmtheorem4.p3.m5" class="ltx_Math" alttext="\mathrm{ReLU}/\mathrm{Clamp}" display="inline" intent=":literal"><semantics><mrow><mi>ReLU</mi><mo>/</mo><mi>Clamp</mi></mrow><annotation encoding="application/x-tex">\mathrm{ReLU}/\mathrm{Clamp}</annotation></semantics></math>) to (<a href="#A2.E29" title="Equation 29 ‣ Theorem B.4 (DDP recovers the exact hard 𝑃-budget in the annealed limit). ‣ B.4 Final theorem ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) using</span></p>
<table id="A2.Ex26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex26.m1" class="ltx_Math" alttext="\mathcal{L}_{\gamma}(\boldsymbol{z},\nu)=F_{\mu_{r},\lambda_{3,r}}(\boldsymbol{z})+\nu\,c_{\mu_{r}}(\boldsymbol{z})+\frac{\gamma}{2}c_{\mu_{r}}(\boldsymbol{z})^{2},\qquad\nu\leftarrow\nu+\gamma\,c_{\mu_{r}}(\boldsymbol{z})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>γ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo>,</mo><mi>ν</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>F</mi><mrow><msub><mi>μ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>ν</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mfrac><mi>γ</mi><mn>2</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mi>ν</mi><mo stretchy="false">←</mo><mrow><mi>ν</mi><mo>+</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝒛</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\gamma}(\boldsymbol{z},\nu)=F_{\mu_{r},\lambda_{3,r}}(\boldsymbol{z})+\nu\,c_{\mu_{r}}(\boldsymbol{z})+\frac{\gamma}{2}c_{\mu_{r}}(\boldsymbol{z})^{2},\qquad\nu\leftarrow\nu+\gamma\,c_{\mu_{r}}(\boldsymbol{z}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.Thmtheorem4.p4" class="ltx_para">
<p id="A2.Thmtheorem4.p4.1" class="ltx_p"><span id="A2.Thmtheorem4.p4.1.1" class="ltx_text ltx_font_italic">Assume the following hold for each round <math id="A2.Thmtheorem4.p4.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>:</span></p>
</div>
<div id="A2.Thmtheorem4.p5" class="ltx_para">
<ul id="A2.I2" class="ltx_itemize">
<li id="A2.I2.ix1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A1)</span> 
<div id="A2.I2.ix1.p1" class="ltx_para">
<p id="A2.I2.ix1.p1.1" class="ltx_p"><span id="A2.I2.ix1.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I2.ix1.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">Regularity of the STE surrogate</span><span id="A2.I2.ix1.p1.1.3" class="ltx_text ltx_font_italic">)
Under the STE-induced surrogate interpretation, </span><math id="A2.I2.ix1.p1.m1" class="ltx_Math" alttext="F_{\mu_{r},\lambda_{3,r}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mrow><msub><mi>μ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow></msub><annotation encoding="application/x-tex">F_{\mu_{r},\lambda_{3,r}}</annotation></semantics></math><span id="A2.I2.ix1.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="A2.I2.ix1.p1.m2" class="ltx_Math" alttext="c_{\mu_{r}}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><annotation encoding="application/x-tex">c_{\mu_{r}}</annotation></semantics></math><span id="A2.I2.ix1.p1.1.5" class="ltx_text ltx_font_italic"> are </span><math id="A2.I2.ix1.p1.m3" class="ltx_Math" alttext="C^{1}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mn>1</mn></msup><annotation encoding="application/x-tex">C^{1}</annotation></semantics></math><span id="A2.I2.ix1.p1.1.6" class="ltx_text ltx_font_italic"> on a neighborhood containing the iterates,
and </span><math id="A2.I2.ix1.p1.m4" class="ltx_Math" alttext="\nabla c_{\mu_{r}}(\boldsymbol{z}^{\star})\neq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo rspace="0.167em">∇</mo><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≠</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla c_{\mu_{r}}(\boldsymbol{z}^{\star})\neq 0</annotation></semantics></math><span id="A2.I2.ix1.p1.1.7" class="ltx_text ltx_font_italic"> at any feasible accumulation point </span><math id="A2.I2.ix1.p1.m5" class="ltx_Math" alttext="\boldsymbol{z}^{\star}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mo>⋆</mo></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{\star}</annotation></semantics></math><span id="A2.I2.ix1.p1.1.8" class="ltx_text ltx_font_italic"> (LICQ-type nondegeneracy).</span></p>
</div></li>
<li id="A2.I2.ix2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A2)</span> 
<div id="A2.I2.ix2.p1" class="ltx_para">
<p id="A2.I2.ix2.p1.1" class="ltx_p"><span id="A2.I2.ix2.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I2.ix2.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">KKT accumulation point at round <math id="A2.I2.ix2.p1.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi mathvariant="normal">r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math></span><span id="A2.I2.ix2.p1.1.3" class="ltx_text ltx_font_italic">)
The round-</span><math id="A2.I2.ix2.p1.m2" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math><span id="A2.I2.ix2.p1.1.4" class="ltx_text ltx_font_italic"> iterates remain bounded and admit an accumulation point </span><math id="A2.I2.ix2.p1.m3" class="ltx_Math" alttext="\boldsymbol{z}^{(r)}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{(r)}</annotation></semantics></math><span id="A2.I2.ix2.p1.1.5" class="ltx_text ltx_font_italic"> such that</span></p>
<table id="A2.Ex27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex27.m1" class="ltx_math_unparsed" alttext="c_{\mu_{r}}(\boldsymbol{z}^{(r)})=0,\qquad\exists\,\nu^{(r)}:\ \nabla F_{\mu_{r},\lambda_{3,r}}(\boldsymbol{z}^{(r)})+\nu^{(r)}\nabla c_{\mu_{r}}(\boldsymbol{z}^{(r)})=0." display="block" intent=":literal"><semantics><mrow><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo rspace="2.167em">,</mo><mo rspace="0.337em">∃</mo><msup><mi>ν</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.278em" rspace="0.778em">:</mo><mo rspace="0.167em">∇</mo><msub><mi>F</mi><mrow><msub><mi>μ</mi><mi>r</mi></msub><mo>,</mo><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><msup><mi>ν</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.167em" rspace="0.167em">∇</mo><msub><mi>c</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>=</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">c_{\mu_{r}}(\boldsymbol{z}^{(r)})=0,\qquad\exists\,\nu^{(r)}:\ \nabla F_{\mu_{r},\lambda_{3,r}}(\boldsymbol{z}^{(r)})+\nu^{(r)}\nabla c_{\mu_{r}}(\boldsymbol{z}^{(r)})=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
<li id="A2.I2.ix3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A3)</span> 
<div id="A2.I2.ix3.p1" class="ltx_para">
<p id="A2.I2.ix3.p1.1" class="ltx_p"><span id="A2.I2.ix3.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I2.ix3.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">Binarization</span><span id="A2.I2.ix3.p1.1.3" class="ltx_text ltx_font_italic">)
</span><math id="A2.I2.ix3.p1.m1" class="ltx_Math" alttext="B_{\mu_{r}}(\boldsymbol{z}^{(r)})\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">B_{\mu_{r}}(\boldsymbol{z}^{(r)})\to 0</annotation></semantics></math><span id="A2.I2.ix3.p1.1.4" class="ltx_text ltx_font_italic"> as </span><math id="A2.I2.ix3.p1.m2" class="ltx_Math" alttext="r\to\infty" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow><annotation encoding="application/x-tex">r\to\infty</annotation></semantics></math><span id="A2.I2.ix3.p1.1.5" class="ltx_text ltx_font_italic">
(equivalently, </span><math id="A2.I2.ix3.p1.m3" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{(r)})/\lambda_{3,r}\to 0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>bin</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub></mrow><mo stretchy="false">→</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{bin}}(\boldsymbol{z}^{(r)})/\lambda_{3,r}\to 0</annotation></semantics></math><span id="A2.I2.ix3.p1.1.6" class="ltx_text ltx_font_italic">), e.g., as ensured by Proposition </span><a href="#A2.Thmtheorem2" title="Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref ltx_font_italic"><span class="ltx_text ltx_ref_tag">B.2</span></a><span id="A2.I2.ix3.p1.1.7" class="ltx_text ltx_font_italic">
under its conditions.</span></p>
</div></li>
<li id="A2.I2.ix4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">(A4)</span> 
<div id="A2.I2.ix4.p1" class="ltx_para">
<p id="A2.I2.ix4.p1.1" class="ltx_p"><span id="A2.I2.ix4.p1.1.1" class="ltx_text ltx_font_italic">(</span><span id="A2.I2.ix4.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">ReLU-stable margin</span><span id="A2.I2.ix4.p1.1.3" class="ltx_text ltx_font_italic">)
There exists </span><math id="A2.I2.ix4.p1.m1" class="ltx_Math" alttext="\delta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta&gt;0</annotation></semantics></math><span id="A2.I2.ix4.p1.1.4" class="ltx_text ltx_font_italic"> and </span><math id="A2.I2.ix4.p1.m2" class="ltx_Math" alttext="r_{0}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>0</mn></msub><annotation encoding="application/x-tex">r_{0}</annotation></semantics></math><span id="A2.I2.ix4.p1.1.5" class="ltx_text ltx_font_italic"> such that for all </span><math id="A2.I2.ix4.p1.m3" class="ltx_Math" alttext="r\geq r_{0}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><msub><mi>r</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">r\geq r_{0}</annotation></semantics></math><span id="A2.I2.ix4.p1.1.6" class="ltx_text ltx_font_italic">,</span></p>
<table id="A2.Ex28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex28.m1" class="ltx_Math" alttext="z^{(r)}_{k}\geq\delta\ \text{for }k\in\mathcal{A}^{(r)}\triangleq\{k:z^{(r)}_{k}&gt;0\},\qquad z^{(r)}_{k}\leq-\delta\ \text{for }k\notin\mathcal{A}^{(r)}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><mrow><mi>δ</mi><mo lspace="0.500em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo>≜</mo><mrow><mo stretchy="false">{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><mrow><mo>−</mo><mrow><mi>δ</mi><mo lspace="0.500em" rspace="0em">​</mo><mtext class="ltx_mathvariant_italic">for </mtext><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><mo>∉</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">z^{(r)}_{k}\geq\delta\ \text{for }k\in\mathcal{A}^{(r)}\triangleq\{k:z^{(r)}_{k}&gt;0\},\qquad z^{(r)}_{k}\leq-\delta\ \text{for }k\notin\mathcal{A}^{(r)}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
<div id="A2.Thmtheorem4.p6" class="ltx_para">
<p id="A2.Thmtheorem4.p6.1" class="ltx_p"><span id="A2.Thmtheorem4.p6.1.1" class="ltx_text ltx_font_italic">Then there exists <math id="A2.Thmtheorem4.p6.m1" class="ltx_Math" alttext="r_{1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>1</mn></msub><annotation encoding="application/x-tex">r_{1}</annotation></semantics></math> such that for all <math id="A2.Thmtheorem4.p6.m2" class="ltx_Math" alttext="r\geq r_{1}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r\geq r_{1}</annotation></semantics></math>, the discrete mask
<math id="A2.Thmtheorem4.p6.m3" class="ltx_Math" alttext="\boldsymbol{b}^{(r)}\in\{0,1\}^{K}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝐛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">}</mo></mrow><mi>K</mi></msup></mrow><annotation encoding="application/x-tex">\boldsymbol{b}^{(r)}\in\{0,1\}^{K}</annotation></semantics></math> induced by the forward gate,</span></p>
<table id="A2.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex29.m1" class="ltx_math_unparsed" alttext="b^{(r)}_{k}\triangleq\mathbb{I}[m_{k}(z^{(r)}_{k})&gt;0]=\mathbb{I}[z^{(r)}_{k}&gt;0]," display="block" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≜</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msub><mi>m</mi><mi>k</mi></msub><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">b^{(r)}_{k}\triangleq\mathbb{I}[m_{k}(z^{(r)}_{k})&gt;0]=\mathbb{I}[z^{(r)}_{k}&gt;0],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem4.p6.2" class="ltx_p"><span id="A2.Thmtheorem4.p6.2.1" class="ltx_text ltx_font_italic">satisfies the <em id="A2.Thmtheorem4.p6.2.1.1" class="ltx_emph ltx_font_upright">exact</em> hard budget:</span></p>
<table id="A2.Ex30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex30.m1" class="ltx_Math" alttext="\sum_{k=1}^{K}b^{(r)}_{k}=P." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><msubsup><mi>b</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mi>P</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}b^{(r)}_{k}=P.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof of Theorem <a href="#A2.Thmtheorem4" title="Theorem B.4 (DDP recovers the exact hard 𝑃-budget in the annealed limit). ‣ B.4 Final theorem ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>.</h6>
<div id="A2.SS4.p2" class="ltx_para">
<p id="A2.SS4.p2.1" class="ltx_p"><span id="A2.SS4.p2.1.1" class="ltx_text">Fix any round <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>. By (A2), <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="\boldsymbol{z}^{(r)}" display="inline" intent=":literal"><semantics><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\boldsymbol{z}^{(r)}</annotation></semantics></math> is feasible for the relaxed constraint, hence
<math id="A2.SS4.p2.m3" class="ltx_Math" alttext="S_{\mu_{r}}(\boldsymbol{z}^{(r)})=P" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">S_{\mu_{r}}(\boldsymbol{z}^{(r)})=P</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.p3" class="ltx_para">
<p id="A2.SS4.p3.1" class="ltx_p"><span id="A2.SS4.p3.1.1" class="ltx_text">Let <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="\mathcal{A}^{(r)}=\{k:z^{(r)}_{k}&gt;0\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>k</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}^{(r)}=\{k:z^{(r)}_{k}&gt;0\}</annotation></semantics></math>, so the hard-budget count equals
<math id="A2.SS4.p3.m2" class="ltx_math_unparsed" alttext="\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]=|\mathcal{A}^{(r)}|" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo fence="false" stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]=|\mathcal{A}^{(r)}|</annotation></semantics></math>.
By the margin condition (A4), <math id="A2.SS4.p3.m3" class="ltx_Math" alttext="z^{(r)}_{k}\geq\delta" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≥</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">z^{(r)}_{k}\geq\delta</annotation></semantics></math> for <math id="A2.SS4.p3.m4" class="ltx_Math" alttext="k\in\mathcal{A}^{(r)}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">k\in\mathcal{A}^{(r)}</annotation></semantics></math> and <math id="A2.SS4.p3.m5" class="ltx_Math" alttext="z^{(r)}_{k}\leq-\delta" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>≤</mo><mrow><mo>−</mo><mi>δ</mi></mrow></mrow><annotation encoding="application/x-tex">z^{(r)}_{k}\leq-\delta</annotation></semantics></math> otherwise.
Since <math id="A2.SS4.p3.m6" class="ltx_Math" alttext="\phi(\cdot;\mu)" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu)</annotation></semantics></math> is monotone and converges pointwise to <math id="A2.SS4.p3.m7" class="ltx_math_unparsed" alttext="\mathbb{I}[z&gt;0]" display="inline" intent=":literal"><semantics><mrow><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><mi>z</mi><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{I}[z&gt;0]</annotation></semantics></math> as <math id="A2.SS4.p3.m8" class="ltx_Math" alttext="\mu\downarrow 0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo stretchy="false">↓</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu\downarrow 0</annotation></semantics></math> (by the construction in <a href="#S3.E12" title="In 3.1 Deterministic Differentiable Pruning ‣ 3 Method ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Equation</span> <span class="ltx_text ltx_ref_tag">12</span></a>),
there exists <math id="A2.SS4.p3.m9" class="ltx_Math" alttext="\bar{\mu}(\delta)&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\bar{\mu}(\delta)&gt;0</annotation></semantics></math> such that for all <math id="A2.SS4.p3.m10" class="ltx_Math" alttext="\mu\in(0,\bar{\mu}(\delta))" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mu\in(0,\bar{\mu}(\delta))</annotation></semantics></math>,</span></p>
<table id="A2.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex31.m1" class="ltx_Math" alttext="\phi(\delta;\mu)\geq 1-\frac{1}{4K},\qquad\phi(-\delta;\mu)\leq\frac{1}{4K}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mo>−</mo><mi>δ</mi></mrow><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\phi(\delta;\mu)\geq 1-\frac{1}{4K},\qquad\phi(-\delta;\mu)\leq\frac{1}{4K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.2" class="ltx_p"><span id="A2.SS4.p3.2.1" class="ltx_text">Choose <math id="A2.SS4.p3.m11" class="ltx_Math" alttext="r_{1}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mn>1</mn></msub><annotation encoding="application/x-tex">r_{1}</annotation></semantics></math> such that <math id="A2.SS4.p3.m12" class="ltx_Math" alttext="\mu_{r}&lt;\bar{\mu}(\delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>r</mi></msub><mo>&lt;</mo><mrow><mover accent="true"><mi>μ</mi><mo>¯</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mu_{r}&lt;\bar{\mu}(\delta)</annotation></semantics></math> for all <math id="A2.SS4.p3.m13" class="ltx_Math" alttext="r\geq r_{1}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>≥</mo><msub><mi>r</mi><mn>1</mn></msub></mrow><annotation encoding="application/x-tex">r\geq r_{1}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.p4" class="ltx_para">
<p id="A2.SS4.p4.1" class="ltx_p"><span id="A2.SS4.p4.1.1" class="ltx_text">For such <math id="A2.SS4.p4.m1" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>, using monotonicity of <math id="A2.SS4.p4.m2" class="ltx_Math" alttext="\phi(\cdot;\mu_{r})" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>,</mo><msub><mi>μ</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\phi(\cdot;\mu_{r})</annotation></semantics></math>,</span></p>
<table id="A2.Ex32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\sum_{k\in\mathcal{A}^{(r)}}\phi(z^{(r)}_{k};\mu_{r})\geq|\mathcal{A}^{(r)}|\Big(1-\frac{1}{4K}\Big),\qquad\sum_{k\notin\mathcal{A}^{(r)}}\phi(z^{(r)}_{k};\mu_{r})\leq(K-|\mathcal{A}^{(r)}|)\frac{1}{4K}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup></mrow></munder><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>μ</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mphantom></mphantom></mrow><mo fence="false">|</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo fence="false">|</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo rspace="2.000em">,</mo><mrow><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>∉</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup></mrow></munder><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>μ</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>−</mo><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">|</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mfrac></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sum_{k\in\mathcal{A}^{(r)}}\phi(z^{(r)}_{k};\mu_{r})\geq|\mathcal{A}^{(r)}|\Big(1-\frac{1}{4K}\Big),\qquad\sum_{k\notin\mathcal{A}^{(r)}}\phi(z^{(r)}_{k};\mu_{r})\leq(K-|\mathcal{A}^{(r)}|)\frac{1}{4K}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p4.2" class="ltx_p"><span id="A2.SS4.p4.2.1" class="ltx_text">Hence</span></p>
<table id="A2.Ex33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex33.m1" class="ltx_math_unparsed" alttext="\Big|S_{\mu_{r}}(\boldsymbol{z}^{(r)})-|\mathcal{A}^{(r)}|\Big|=\Big|\sum_{k=1}^{K}\phi(z^{(r)}_{k};\mu_{r})-\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]\Big|\leq\frac{1}{2}." display="block" intent=":literal"><semantics><mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" rspace="0.167em" stretchy="true">|</mo><msub><mi>S</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo rspace="0em">−</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em" rspace="0em">=</mo><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mi>ϕ</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>;</mo><msub><mi>μ</mi><mi>r</mi></msub><mo stretchy="false">)</mo></mrow><mo rspace="0.055em">−</mo><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></munderover><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo fence="false" maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mo lspace="0.167em">≤</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Big|S_{\mu_{r}}(\boldsymbol{z}^{(r)})-|\mathcal{A}^{(r)}|\Big|=\Big|\sum_{k=1}^{K}\phi(z^{(r)}_{k};\mu_{r})-\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]\Big|\leq\frac{1}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p4.3" class="ltx_p"><span id="A2.SS4.p4.3.1" class="ltx_text">But <math id="A2.SS4.p4.m3" class="ltx_Math" alttext="S_{\mu_{r}}(\boldsymbol{z}^{(r)})=P" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">S_{\mu_{r}}(\boldsymbol{z}^{(r)})=P</annotation></semantics></math> and <math id="A2.SS4.p4.m4" class="ltx_Math" alttext="|\mathcal{A}^{(r)}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{A}^{(r)}|</annotation></semantics></math> are integers, so the only possibility is
<math id="A2.SS4.p4.m5" class="ltx_Math" alttext="|\mathcal{A}^{(r)}|=P" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msup><mi class="ltx_font_mathcaligraphic">𝒜</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">|\mathcal{A}^{(r)}|=P</annotation></semantics></math>, i.e., <math id="A2.SS4.p4.m6" class="ltx_math_unparsed" alttext="\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]=P" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>K</mi></msubsup><mi>𝕀</mi><mrow><mo stretchy="false">[</mo><msubsup><mi>z</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>&gt;</mo><mn>0</mn><mo stretchy="false">]</mo></mrow><mo>=</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{K}\mathbb{I}[z^{(r)}_{k}&gt;0]=P</annotation></semantics></math>.
Finally, (A3) (e.g., Proposition <a href="#A2.Thmtheorem2" title="Proposition B.2 (Binarization regularizer drives 𝒔 toward {0,1}). ‣ B.2 Binarization loss ‣ Appendix B Theoretical Discussion ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>) provides a sufficient condition under which increasing <math id="A2.SS4.p4.m7" class="ltx_Math" alttext="\lambda_{3,r}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mrow><mn>3</mn><mo>,</mo><mi>r</mi></mrow></msub><annotation encoding="application/x-tex">\lambda_{3,r}</annotation></semantics></math>
drives the <em id="A2.SS4.p4.3.1.1" class="ltx_emph ltx_font_italic">unscaled</em> binarization measure <math id="A2.SS4.p4.m8" class="ltx_Math" alttext="B_{\mu_{r}}(\boldsymbol{z}^{(r)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><msub><mi>μ</mi><mi>r</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>𝒛</mi><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{\mu_{r}}(\boldsymbol{z}^{(r)})</annotation></semantics></math> toward <math id="A2.SS4.p4.m9" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, which empirically promotes the margin separation (A4)
by discouraging fractional relaxed scores.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Additional Implementation Details</h2>

<div id="A3.p1" class="ltx_para">
<p id="A3.p1.1" class="ltx_p">In this section, we report the hyperparameters used in our experiments. Unless otherwise noted, we optimize mask parameters with AdamW (<math id="A3.p1.m1" class="ltx_Math" alttext="\beta_{1}{=}0.9" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>1</mn></msub><mo>=</mo><mn>0.9</mn></mrow><annotation encoding="application/x-tex">\beta_{1}{=}0.9</annotation></semantics></math>, <math id="A3.p1.m2" class="ltx_Math" alttext="\beta_{2}{=}0.999" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mn>2</mn></msub><mo>=</mo><mn>0.999</mn></mrow><annotation encoding="application/x-tex">\beta_{2}{=}0.999</annotation></semantics></math>) using a batch size of 16, 1,000 training steps, and a context length of 2,048. We use <math id="A3.p1.m3" class="ltx_Math" alttext="\mu_{T}=0.05" display="inline" intent=":literal"><semantics><mrow><msub><mi>μ</mi><mi>T</mi></msub><mo>=</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">\mu_{T}=0.05</annotation></semantics></math> and apply a linear warmup stage followed by a cosine decay schedule for the learning rate. We search for the distillation coefficient <math id="A3.p1.m4" class="ltx_Math" alttext="\eta" display="inline" intent=":literal"><semantics><mi>η</mi><annotation encoding="application/x-tex">\eta</annotation></semantics></math> and use <math id="A3.p1.m5" class="ltx_Math" alttext="\eta{=}2" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>=</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\eta{=}2</annotation></semantics></math> for all models in the main results. We select a learning rate of <math id="A3.p1.m6" class="ltx_Math" alttext="2\times 10^{-2}" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2\times 10^{-2}</annotation></semantics></math> for all latent variable <math id="A3.p1.m7" class="ltx_Math" alttext="\boldsymbol{z}" display="inline" intent=":literal"><semantics><mi>𝒛</mi><annotation encoding="application/x-tex">\boldsymbol{z}</annotation></semantics></math> as well as <math id="A3.p1.m8" class="ltx_Math" alttext="\lambda_{1}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\lambda_{1}</annotation></semantics></math> and <math id="A3.p1.m9" class="ltx_Math" alttext="\lambda_{3}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\lambda_{3}</annotation></semantics></math>; for <math id="A3.p1.m10" class="ltx_Math" alttext="\lambda_{2}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\lambda_{2}</annotation></semantics></math> we select a learning rate of <math id="A3.p1.m11" class="ltx_Math" alttext="8\times 10^{-1}" display="inline" intent=":literal"><semantics><mrow><mn>8</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>1</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8\times 10^{-1}</annotation></semantics></math>.</p>
</div>
<div id="A3.p2" class="ltx_para">
<p id="A3.p2.1" class="ltx_p">For the <span id="A3.p2.1.1" class="ltx_text ltx_font_typewriter">vLLM</span> speedup experiments, we follow the default settings in the official repository and evaluate our pruned models on 1,000 real prompts sampled from ShareGPT. We use the default scheduler and measure end-to-end wall-clock latency/throughput on same GPU for both dense and pruned models.</p>
</div>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Full Results</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">This section provides detailed results supporting the main text and additional pruning results on other model families, including dense Qwen3 models (<a href="#A4.T9" title="In Appendix D Full Results ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Tables</span> <span class="ltx_text ltx_ref_tag">9</span></a>, <a href="#A4.T11" title="Table 11 ‣ Appendix D Full Results ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a> and <a href="#A4.T10" title="Table 10 ‣ Appendix D Full Results ‣ Deterministic Differentiable Structured Pruning for Large Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>). Across the Qwen3 dense series, we observe a clear scaling trend: pruning is consistently less lossy for larger models. For example, at 20% pruning, Qwen3-32B only drops slightly in average zero-shot accuracy (72.12<math id="A4.p1.m1" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>71.09), while Qwen3-4B degrades more noticeably (65.38<math id="A4.p1.m2" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math>62.99). At 50% pruning, the gap widens further (32B: 66.48 vs. 4B: 47.63), suggesting substantially higher redundancy and robustness at larger scale.</p>
</div>
<figure id="A4.T9" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="A4.T9.4" class="ltx_text" style="font-size:90%;">Table 9</span>: </span><span id="A4.T9.5" class="ltx_text" style="font-size:90%;">Detailed performance of pruned dense LLMs under different pruning methods. All pruning baseline methods are evaluated after fine-tuning. <span id="A4.T9.5.1" class="ltx_text ltx_font_bold">Bold</span> indicates the best performance at the same pruning ratio.</span></figcaption>
<div id="A4.T9.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:341.6pt;height:198.6pt;vertical-align:-97.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-112.9pt,65.7pt) scale(0.602047229193467,0.602047229193467) ;">
<table id="A4.T9.6.1" class="ltx_tabular ltx_align_middle">
<tr id="A4.T9.6.1.1" class="ltx_tr">
<td id="A4.T9.6.1.1.1" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T9.6.1.1.1.1" class="ltx_text ltx_font_bold">Ratio</span></td>
<td id="A4.T9.6.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A4.T9.6.1.1.2.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="A4.T9.6.1.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A4.T9.6.1.1.3.1" class="ltx_text ltx_font_bold">Wiki2</span></td>
<td id="A4.T9.6.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T9.6.1.1.4.1" class="ltx_text ltx_font_bold">BoolQ</span></td>
<td id="A4.T9.6.1.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T9.6.1.1.5.1" class="ltx_text ltx_font_bold">PIQA</span></td>
<td id="A4.T9.6.1.1.6" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T9.6.1.1.6.1" class="ltx_text ltx_font_bold">HellaSwag</span></td>
<td id="A4.T9.6.1.1.7" class="ltx_td ltx_align_center ltx_border_tt"><span id="A4.T9.6.1.1.7.1" class="ltx_text ltx_font_bold">WinoGrande</span></td>
