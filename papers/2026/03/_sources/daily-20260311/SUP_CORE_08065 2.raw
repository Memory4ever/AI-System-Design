<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S5.F3.sf1.4" class="ltx_text" style="font-size:90%;">DeepSeekMoE-16B at 20% sparsity.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
