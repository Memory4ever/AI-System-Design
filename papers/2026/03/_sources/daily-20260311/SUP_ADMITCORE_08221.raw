<section id="S7.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S7.SS5.6" class="ltx_text">VII-E</span> </span><span id="S7.SS5.7" class="ltx_text ltx_font_italic">Experiment 4: Multi-Turn Budget Management</span></h3>

<figure id="S7.F4" class="ltx_figure"><object type="image/svg+xml" data="2603.08221v1/budget_management.svg" id="S7.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:219/155;" width="219" height="155"></object>
