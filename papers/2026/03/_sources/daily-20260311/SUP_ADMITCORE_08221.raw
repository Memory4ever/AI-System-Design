<li class="ltx_tocentry ltx_tocentry_section"><a href="#S7" title="In SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VII </span><span class="ltx_text ltx_font_smallcaps">Experimental Evaluation</span></span></a>
<ol class="ltx_toclist ltx_toclist_section">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS1" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-A</span> </span><span class="ltx_text ltx_font_italic">Experimental Setup</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS2" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-B</span> </span><span class="ltx_text ltx_font_italic">Experiment 1: Split Architecture Comparison</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS3" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-C</span> </span><span class="ltx_text ltx_font_italic">Experiment 2: Context-Aware vs Static Sanitization</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS4" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-D</span> </span><span class="ltx_text ltx_font_italic">Experiment 3: Privacy-Utility Tradeoff</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS5" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-E</span> </span><span class="ltx_text ltx_font_italic">Experiment 4: Multi-Turn Budget Management</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS6" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-F</span> </span><span class="ltx_text ltx_font_italic">Experiment 5: Adversarial Evaluation</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S7.SS7" title="In VII Experimental Evaluation ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VII-G</span> </span><span class="ltx_text ltx_font_italic">Experiment 6: End-to-End Task Performance</span></span></a></li>
</ol></li>
<li class="ltx_tocentry ltx_tocentry_section"><a href="#S8" title="In SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref">VIII </span><span class="ltx_text ltx_font_smallcaps">Discussion</span></span></a>
<ol class="ltx_toclist ltx_toclist_section">
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS1" title="In VIII Discussion ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-A</span> </span><span class="ltx_text ltx_font_italic">Deployment Considerations</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS2" title="In VIII Discussion ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-B</span> </span><span class="ltx_text ltx_font_italic">Limitations</span></span></a></li>
<li class="ltx_tocentry ltx_tocentry_subsection"><a href="#S8.SS3" title="In VIII Discussion ‣ SplitAgent: A Privacy-Preserving Distributed Architecture for Enterprise-Cloud Agent Collaboration" class="ltx_ref"><span class="ltx_text ltx_ref_title"><span class="ltx_tag ltx_tag_ref"><span class="ltx_text">VIII-C</span> </span><span class="ltx_text ltx_font_italic">Future Work</span></span></a></li>
</ol></li>
