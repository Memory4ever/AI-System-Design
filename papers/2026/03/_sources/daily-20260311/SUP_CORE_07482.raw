<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E19.m2" class="ltx_Math" alttext="\displaystyle=X_{E}^{(l-1)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msubsup><mi>X</mi><mi>E</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\displaystyle=X_{E}^{(l-1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(19)</span></td></tr></tbody>
