<td id="S5.T7.6.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T7.6.1.3.2.1" class="ltx_text" style="font-size:80%;">–</span></td>
