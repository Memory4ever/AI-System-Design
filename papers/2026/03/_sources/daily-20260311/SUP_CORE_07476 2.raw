<td id="S4.T5.5.1.6.4" class="ltx_td ltx_align_center ltx_border_t">DiT</td>
<td id="S4.T5.5.1.6.5" class="ltx_td ltx_align_center ltx_border_t">Minimax</td></tr>
<tr id="S4.T5.5.1.7" class="ltx_tr">
<td id="S4.T5.5.1.7.1" class="ltx_td ltx_align_center"><math id="S4.T5.m15" class="ltx_Math" alttext="46.8\!\pm\!0.2" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.2</mn></mrow><annotation encoding="application/x-tex">46.8\!\pm\!0.2</annotation></semantics></math></td>
<td id="S4.T5.5.1.7.2" class="ltx_td ltx_align_center"><math id="S4.T5.m16" class="ltx_Math" alttext="56.5\!\pm\!0.1" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.1</mn></mrow><annotation encoding="application/x-tex">56.5\!\pm\!0.1</annotation></semantics></math></td>
