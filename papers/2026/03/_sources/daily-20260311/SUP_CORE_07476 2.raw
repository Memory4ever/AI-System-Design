<td id="S5.T7.6.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.2pt 4.0pt;"><math id="S5.T7.m4" class="ltx_Math" alttext="47.7\!\pm\!0.5" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.5</mn></mrow><annotation encoding="application/x-tex">47.7\!\pm\!0.5</annotation></semantics></math></td>
<td id="S5.T7.6.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.2pt 4.0pt;"><math id="S5.T7.m5" class="ltx_Math" alttext="56.3\!\pm\!0.7" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">0.7</mn></mrow><annotation encoding="application/x-tex">56.3\!\pm\!0.7</annotation></semantics></math></td>
<td id="S5.T7.6.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.2pt 4.0pt;"><math id="S5.T7.m6" class="ltx_Math" alttext="67.8\!\pm\!1.0" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em">±</mo><mn mathsize="0.800em">1.0</mn></mrow><annotation encoding="application/x-tex">67.8\!\pm\!1.0</annotation></semantics></math></td></tr>
