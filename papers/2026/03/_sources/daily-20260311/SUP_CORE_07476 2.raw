<td id="S5.T7.6.1.4.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T7.6.1.4.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">D<sup id="S5.T7.6.1.4.1.1.1" class="ltx_sup">4</sup>M+EVLF</span></td>
<td id="S5.T7.6.1.4.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding:0.2pt 4.0pt;"><span id="S5.T7.6.1.4.2.1" class="ltx_text"></span><span id="S5.T7.6.1.4.2.2" class="ltx_text" style="font-size:80%;"> </span><span id="S5.T7.6.1.4.2.3" class="ltx_text" style="font-size:80%;">
