<td id="S4.T5.5.1.7.4" class="ltx_td ltx_align_center"><math id="S4.T5.m18" class="ltx_Math" alttext="58.6\!\pm\!0.3" display="inline" intent=":literal"><semantics><mrow><mo>±</mo><mn>0.3</mn></mrow><annotation encoding="application/x-tex">58.6\!\pm\!0.3</annotation></semantics></math></td></tr>
