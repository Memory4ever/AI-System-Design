<td id="S4.T5.5.1.4.4" class="ltx_td ltx_align_center"><span id="S4.T5.5.1.4.4.1" class="ltx_text ltx_font_bold">MGD<sup id="S4.T5.5.1.4.4.1.1" class="ltx_sup">3</sup>+EVLF</span></td></tr>
