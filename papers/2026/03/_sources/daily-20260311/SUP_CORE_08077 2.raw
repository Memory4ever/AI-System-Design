<span id="A1.p2.p40.1" class="ltx_p">Example:</span>
</span></span></span><span id="A1.p2.1.41" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:345.0pt;"><span id="A1.p2.1.41.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:345.0pt;">
<span id="A1.p2.p41" class="ltx_para ltx_noindent">
<span id="A1.p2.p41.1" class="ltx_p">Query: "Labrador breed"</span>
</span></span></span><span id="A1.p2.1.42" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:345.0pt;"><span id="A1.p2.1.42.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:345.0pt;">
