<td id="S4.T2.2.6.1" class="ltx_td ltx_align_left">gpt-oss:120b</td>
<td id="S4.T2.2.6.2" class="ltx_td ltx_align_left">OpenAI</td>
<td id="S4.T2.2.6.3" class="ltx_td ltx_nopad_r ltx_align_center">Yes</td></tr>
