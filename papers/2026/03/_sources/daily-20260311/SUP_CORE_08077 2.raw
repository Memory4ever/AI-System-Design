<td id="S5.T3.2.8.6" class="ltx_td ltx_nopad_r ltx_align_center" style="padding:0.5pt 3.0pt;"><span id="S5.T3.2.8.6.1" class="ltx_text ltx_font_bold">0.35</span></td></tr>
<tr id="S5.T3.2.9" class="ltx_tr">
<td id="S5.T3.2.9.1" class="ltx_td ltx_align_left ltx_align_top" style="padding:0.5pt 3.0pt;">
<span id="S5.T3.2.9.1.1" class="ltx_inline-block ltx_align_top" style="width:62.1pt;">
<span id="S5.T3.2.9.1.1.1" class="ltx_p ltx_align_left"><span id="S5.T3.2.9.1.1.1.1" class="ltx_text ltx_font_bold">example of monotonic function</span></span>
</span></td>
