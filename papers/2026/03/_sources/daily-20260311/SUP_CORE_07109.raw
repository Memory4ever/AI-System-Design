<span id="A2.T2.6.1.1.1" class="ltx_inline-block ltx_align_top" style="width:56.9pt;">
<span id="A2.T2.6.1.1.1.1" class="ltx_p"><span id="A2.T2.6.1.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Property</span></span>
</span></th>
