<th id="S2.F1.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 3.0pt;">
<span id="S2.F1.3.1.2.1" class="ltx_inline-block ltx_align_top">
<span id="S2.F1.3.1.2.1.1" class="ltx_p"><span id="S2.F1.3.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Questions (and Mod.)</span></span>
</span></th>
<th id="S2.F1.3.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.45pt 3.0pt;">
<span id="S2.F1.3.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="S2.F1.3.1.3.1.1" class="ltx_p"><span id="S2.F1.3.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Answers (shorter version)</span></span>
</span></th></tr>
