<td id="S4.T1.2.1.13.8" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T1.2.1.13.8.1" class="ltx_text ltx_font_bold">77.7%</span></td>
<td id="S4.T1.2.1.13.9" class="ltx_td ltx_align_center ltx_border_b">74.0%</td>
