<td id="A1.F4.2.1.1.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><object type="image/svg+xml" data="2603.08100v1/entropy_33.svg" id="A1.F4.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:181/136;" width="181" height="136"></object></td>
<td id="A1.F4.2.1.1.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center"><object type="image/svg+xml" data="2603.08100v1/entropy_34.svg" id="A1.F4.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:181/136;" width="181" height="136"></object></td></tr>
