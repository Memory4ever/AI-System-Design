<td id="S4.T3.2.1.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1.5%</td>
<td id="S4.T3.2.1.6.5" class="ltx_td ltx_align_center ltx_border_t">79.1%</td></tr>
<tr id="S4.T3.2.1.7" class="ltx_tr">
<th id="S4.T3.2.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r">SAViT <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib37" title="" class="ltx_ref">Zheng et al., 2022</a>)</cite></th>
<td id="S4.T3.2.1.7.2" class="ltx_td ltx_align_center ltx_border_r">10.3%</td>
<td id="S4.T3.2.1.7.3" class="ltx_td ltx_align_center ltx_border_r">70.9%</td>
<td id="S4.T3.2.1.7.4" class="ltx_td ltx_align_center ltx_border_r">2.1%</td>
<td id="S4.T3.2.1.7.5" class="ltx_td ltx_align_center">79.3%</td></tr>
