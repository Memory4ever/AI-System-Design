<td id="S4.T3.1.1.2.2" class="ltx_td ltx_align_left ltx_border_t">NavGPT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">32</a>]</cite></td>
<td id="S4.T3.1.1.2.3" class="ltx_td ltx_align_center ltx_border_t">10</td></tr>
<tr id="S4.T3.1.1.3" class="ltx_tr">
<td id="S4.T3.1.1.3.1" class="ltx_td ltx_align_left">MapGPT <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">6</a>]</cite></td>
