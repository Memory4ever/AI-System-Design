{"data":{"id":"10.48550/arxiv.2603.07079","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.07079","prefix":"10.48550","suffix":"arxiv.2603.07079","identifiers":[{"identifier":"2603.07079","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.07079"}],"creators":[{"name":"Jin, Woogyeol","nameType":"Personal","givenName":"Woogyeol","familyName":"Jin","affiliation":[],"nameIdentifiers":[]},{"name":"Min, Taywon","nameType":"Personal","givenName":"Taywon","familyName":"Min","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Yongjin","nameType":"Personal","givenName":"Yongjin","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Dennis","nameType":"Personal","givenName":"Dennis","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Yi","nameType":"Personal","givenName":"Yi","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Kadhe, Swanand Ravindra","nameType":"Personal","givenName":"Swanand Ravindra","familyName":"Kadhe","affiliation":[],"nameIdentifiers":[]},{"name":"Baracaldo, Nathalie","nameType":"Personal","givenName":"Nathalie","familyName":"Baracaldo","affiliation":[],"nameIdentifiers":[]},{"name":"Lee, Kimin","nameType":"Personal","givenName":"Kimin","familyName":"Lee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Entropy-Aware On-Policy Distillation of Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-07T07:26:18Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-10T00:33:36Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-22T17:34:18Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-25T01:03:28Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-12T19:40:20Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:08:03Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"On-policy distillation is a promising approach for transferring knowledge between language models, where a student learns from dense token-level signals along its own trajectories. This framework typically uses reverse KL divergence, encouraging the student to match the teacher's high-confidence predictions. However, we show that the mode-seeking property of reverse KL reduces generation diversity and yields unstable learning signals when the teacher distribution has high entropy. To address this, we introduce Entropy-Aware On-Policy Distillation. Our key idea is augmenting the standard reverse KL objective with forward KL when teacher entropy is high, capturing the full range of plausible outputs while retaining precise imitation elsewhere. It balances mode-seeking precision with mode-covering robustness without sacrificing on-policy training efficiency. Experiments show that our method maintains generation diversity (sustained token-level entropy) and improves student-teacher alignment (lower forward KL on high-entropy tokens). Across six math reasoning benchmarks, this yields Pass@8 accuracy gains of +1.37 for Qwen3-0.6B-Base, +2.39 for Qwen3-1.7B-Base, and +5.05 for Qwen3-4B-Base compared to baseline on-policy distillation methods. These results demonstrate that accounting for teacher uncertainty is essential for maintaining diversity and achieving effective knowledge transfer.","descriptionType":"Abstract"},{"description":"18 pages, 11 figures, ICML 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.07079","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-10T03:59:11.000Z","registered":"2026-03-10T03:59:12.000Z","published":"2026","updated":"2026-06-16T04:13:34.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.07079","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}