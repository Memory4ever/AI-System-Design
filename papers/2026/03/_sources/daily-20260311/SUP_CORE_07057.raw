<td id="A2.T6.3.1.9.5" class="ltx_td ltx_align_center">1.94×</td>
<td id="A2.T6.3.1.9.6" class="ltx_td ltx_align_center">2.39</td>
<td id="A2.T6.3.1.9.7" class="ltx_td ltx_align_center">4.55</td>
<td id="A2.T6.3.1.9.8" class="ltx_td ltx_align_center">240.75</td>
<td id="A2.T6.3.1.9.9" class="ltx_td ltx_align_center">0.81</td>
<td id="A2.T6.3.1.9.10" class="ltx_td ltx_align_center">0.58</td></tr>
<tr id="A2.T6.3.1.10" class="ltx_tr">
<td id="A2.T6.3.1.10.1" class="ltx_td ltx_align_center"><span id="A2.T6.3.1.10.1.1" class="ltx_text ltx_font_bold">SODA</span> (<math id="A2.T6.m7" class="ltx_Math" alttext="N_{s}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>s</mi></msub><annotation encoding="application/x-tex">N_{s}</annotation></semantics></math>=18)</td>
