              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
                   <math id="alg2.l13.m1" class="ltx_Math" alttext="prev[t][i+1]\leftarrow(t,n)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">prev[t][i+1]\leftarrow(t,n)</annotation></semantics></math>

</div>
<div id="alg2.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
             Backtracking: <math id="alg2.l14.m1" class="ltx_Math" alttext="\mathcal{A}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}\leftarrow\{\}</annotation></semantics></math>, <math id="alg2.l14.m2" class="ltx_Math" alttext="\mathcal{I}\leftarrow\{\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}\leftarrow\{\}</annotation></semantics></math>, <math id="alg2.l14.m3" class="ltx_Math" alttext="t\leftarrow 1,i\leftarrow N_{s}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo stretchy="false">←</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>i</mi><mo stretchy="false">←</mo><msub><mi>N</mi><mi>s</mi></msub></mrow></mrow><annotation encoding="application/x-tex">t\leftarrow 1,i\leftarrow N_{s}</annotation></semantics></math>

</div>
<div id="alg2.l15" class="ltx_listingline">
