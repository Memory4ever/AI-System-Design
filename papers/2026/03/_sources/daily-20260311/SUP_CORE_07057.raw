<td id="A2.T6.3.1.10.10" class="ltx_td ltx_align_center">0.58</td></tr>
<tr id="A2.T6.3.1.11" class="ltx_tr">
<td id="A2.T6.3.1.11.1" class="ltx_td ltx_align_center ltx_border_b"><span id="A2.T6.3.1.11.1.1" class="ltx_text ltx_font_bold">SODA</span> (<math id="A2.T6.m8" class="ltx_Math" alttext="N_{s}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>s</mi></msub><annotation encoding="application/x-tex">N_{s}</annotation></semantics></math>=12)</td>
