<td id="A2.T6.3.1.8.9" class="ltx_td ltx_align_center">0.82</td>
<td id="A2.T6.3.1.8.10" class="ltx_td ltx_align_center">0.59</td></tr>
<tr id="A2.T6.3.1.9" class="ltx_tr">
<td id="A2.T6.3.1.9.1" class="ltx_td ltx_align_center"><span id="A2.T6.3.1.9.1.1" class="ltx_text ltx_font_bold">SODA</span> (<math id="A2.T6.m6" class="ltx_Math" alttext="N_{s}" display="inline" intent=":literal"><semantics><msub><mi>N</mi><mi>s</mi></msub><annotation encoding="application/x-tex">N_{s}</annotation></semantics></math>=25)</td>
<td id="A2.T6.3.1.9.2" class="ltx_td ltx_align_center">DDIM</td>
