<td id="S5.T9.6.5.4" class="ltx_td ltx_align_center" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.5.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFF5CC;">97.4</span></td>
<td id="S5.T9.6.5.5" class="ltx_td ltx_align_center" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.5.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFF5CC;">95.6</span></td></tr>
<tr id="S5.T9.6.6" class="ltx_tr" style="--ltx-bg-color:#EFEFEF;">
<td id="S5.T9.6.6.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.1pt;padding-right:8.1pt;" colspan="5"><span id="S5.T9.6.6.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;">Shared or Separated Variation Tokens</span></td></tr>
<tr id="S5.T9.6.7" class="ltx_tr">
<td id="S5.T9.6.7.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.7.1.1" class="ltx_text" style="font-size:80%;">Shared</span></td>
<td id="S5.T9.6.7.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.7.2.1" class="ltx_text" style="font-size:80%;">96.8</span></td>
<td id="S5.T9.6.7.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.7.3.1" class="ltx_text" style="font-size:80%;">98.6</span></td>
