<td id="S5.T9.6.8.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.1pt;padding-right:8.1pt;"><span id="S5.T9.6.8.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFF5CC;">99.4</span></td>
