<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">V </span><span id="S5.2" class="ltx_text ltx_font_smallcaps">Experiments</span></h2>

<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection"><span id="S5.SS1.6" class="ltx_text">V-A</span> </span><span id="S5.SS1.7" class="ltx_text ltx_font_italic">Experimental Setup</span></h3>

<figure id="S5.T1" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="S5.T1.4" class="ltx_text" style="font-size:90%;">TABLE I</span>: </span><span id="S5.T1.5" class="ltx_text ltx_font_bold" style="font-size:90%;">Simulation Experimental Results on the LIBERO Benchmark.<span id="S5.T1.5.1" class="ltx_text ltx_font_medium"> Comparison of task success rates (SR) and their ranks (RK). “†” indicates our reproduced results. Bold indicates the highest score.</span></span></figcaption>
<table id="S5.T1.6" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S5.T1.6.1" class="ltx_tr">
<td id="S5.T1.6.1.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;"><span id="S5.T1.6.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Method</span></td>
<td id="S5.T1.6.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S5.T1.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Spatial</span></td>
<td id="S5.T1.6.1.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S5.T1.6.1.3.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Object</span></td>
<td id="S5.T1.6.1.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S5.T1.6.1.4.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Goal</span></td>
<td id="S5.T1.6.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S5.T1.6.1.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Long</span></td>
<td id="S5.T1.6.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2"><span id="S5.T1.6.1.6.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Average</span></td></tr>
<tr id="S5.T1.6.2" class="ltx_tr">
