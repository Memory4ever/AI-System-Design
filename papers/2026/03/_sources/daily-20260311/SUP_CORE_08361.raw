<td id="S5.T3.6.3.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;" colspan="14"><span id="S5.T3.6.3.1.1" class="ltx_text ltx_font_italic" style="font-size:70%;">Galaxea R1 Lite platform</span></td></tr>
<tr id="S5.T3.6.4" class="ltx_tr">
<td id="S5.T3.6.4.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T3.6.4.1.1" class="ltx_text" style="font-size:80%;">OpenVLA† <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib52" title="" class="ltx_ref">52</a>]</cite></span></td>
<td id="S5.T3.6.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T3.6.4.2.1" class="ltx_text" style="font-size:80%;">15/25</span></td>
<td id="S5.T3.6.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S5.T3.6.4.3.1" class="ltx_text" style="font-size:80%;">13/25</span></td>
