<td id="S5.T4.9.7.2" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.T4.9.7.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#FFF5CC;">0.105 s</span></td>
