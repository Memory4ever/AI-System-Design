~0~&amp;~1~&amp;~\cdots~&amp;~1~&amp;~0~\end{matrix}$}\right]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="1.730em">𝐌</mi><mo mathsize="1.730em">=</mo><mrow><mo>[</mo><mpadded style="width:71.5pt;height:32.9pt;vertical-align:-13.4pt;" depth="13.4pt" height="19.5pt" width="71.5pt"><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd><mn mathsize="1.730em">1</mn></mtd><mtd><mn mathsize="1.730em">0</mn></mtd><mtd><mo mathsize="1.730em">⋯</mo></mtd><mtd><mn mathsize="1.730em">0</mn></mtd><mtd><mn mathsize="1.730em">1</mn></mtd></mtr><mtr><mtd><mi mathsize="1.730em" mathvariant="normal">⋮</mi></mtd><mtd></mtd><mtd><mi mathsize="1.730em" mathvariant="normal">⋱</mi></mtd><mtd></mtd><mtd><mi mathsize="1.730em" mathvariant="normal">⋮</mi></mtd></mtr><mtr><mtd><mn mathsize="1.730em">0</mn></mtd><mtd><mn mathsize="1.730em">1</mn></mtd><mtd><mo mathsize="1.730em">⋯</mo></mtd><mtd><mn mathsize="1.730em">1</mn></mtd><mtd><mn mathsize="1.730em">0</mn></mtd></mtr></mtable></mpadded><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbf{M}=\left[\scalebox{0.7}{$\begin{matrix}~1~&amp;~0~&amp;~\cdots~&amp;~0~&amp;~1~\\
~\vdots~&amp;~~&amp;~\ddots~&amp;~~&amp;~\vdots~\\
~0~&amp;~1~&amp;~\cdots~&amp;~1~&amp;~0~\end{matrix}$}\right]</annotation></semantics></math></span></span></foreignObject></g></g></svg></span></span></p>
</span></div>
</div>
      
</div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure">Figure 2. </span>An overview of the <span id="S3.F2.7" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever framework. <span id="S3.F2.8" class="ltx_text ltx_font_bold">(1)</span> Pre-training: A query-conditioned GFM is trained as a cross-domain retriever. <span id="S3.F2.9" class="ltx_text ltx_font_bold">(2)</span> Fine-tuning: A label-free IB-optimized selector identifies minimal sufficient query-specific subgraphs. <span id="S3.F2.10" class="ltx_text ltx_font_bold">(3)</span> Inferring: Retrieved subgraphs are transformed into path-aware in-context prompts to guide multi-hop reasoning. Click “<math id="S3.F2.m2" class="ltx_Math" alttext="\blacktriangleright" display="inline" intent=":literal"><semantics><mo>▶</mo><annotation encoding="application/x-tex">\blacktriangleright</annotation></semantics></math>” to navigate.</figcaption>
</figure>
</section>
<section id="S4" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">4. </span>Proposed Framework: <span id="S4.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever</h2>

<div id="S4.p1" class="ltx_para">
<p id="S4.p1.1" class="ltx_p">In this section, we introduce the proposed <span id="S4.p1.1.1" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever.</p>
</div>
<section id="S4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.1. </span>Generalized GFM as Cross-domain Retriever</h3>

<div id="S4.SS1.p1" class="ltx_para">
<p id="S4.SS1.p1.1" class="ltx_p">To address cross-domain retrieval under data-scarce and cold-start scenarios, we establish a GFM-based retriever that is capable of generalizing across different knowledge domains by learning a unified yet discriminative representation space across multi-domain KGs and supports consistent retrieval.</p>
</div>
<div id="S4.SS1.p2" class="ltx_para">
<p id="S4.SS1.p2.1" class="ltx_p"><span id="S4.SS1.p2.1.1" class="ltx_text ltx_font_bold">Query-dependent GFM Message-Passing.</span>
Different from traditional GNN message-passing, which aggregates independently of task <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib24" title="" class="ltx_ref">Kipf and Welling, 2017</a>)</cite>, the GFM retriever employs a query-dependent message-passing mechanism that dynamically adapts to input queries <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>.
Given a query <math id="S4.SS1.p2.m1" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>, the GFM retriever <math id="S4.SS1.p2.m2" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math> first initialize entity (<math id="S4.SS1.p2.m3" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>) and relation (<math id="S4.SS1.p2.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>) embeddings for all <math id="S4.SS1.p2.m5" class="ltx_Math" alttext="e\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">e\in\mathcal{V}</annotation></semantics></math>, <math id="S4.SS1.p2.m6" class="ltx_Math" alttext="r\in\mathcal{R}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi></mrow><annotation encoding="application/x-tex">r\in\mathcal{R}</annotation></semantics></math>:</p>
<table id="S4.E1" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(1)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E1.m1" class="ltx_Math" alttext="\mathbf{Z}_{e}^{(0)}=\begin{cases}\mathbf{q},&amp;e\in\{\mathcal{V}\mid\mathbf{q}\},\\
\textbf{0},&amp;\text{otherwise},\end{cases}~\text{and}~~\mathbf{Z}_{r}^{(0)}=\textsc{TextEmb}(r)," display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐙</mi><mi>e</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mi>𝐪</mi><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>e</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mtext class="ltx_mathvariant_bold">0</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mtext>otherwise</mtext><mo>,</mo></mrow></mtd></mtr></mtable></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.660em" rspace="0em">​</mo><msubsup><mi>𝐙</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo>=</mo><mrow><mtext class="ltx_font_smallcaps">TextEmb</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{e}^{(0)}=\begin{cases}\mathbf{q},&amp;e\in\{\mathcal{V}\mid\mathbf{q}\},\\
\textbf{0},&amp;\text{otherwise},\end{cases}~\text{and}~~\mathbf{Z}_{r}^{(0)}=\textsc{TextEmb}(r),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p2.2" class="ltx_p">where <math id="S4.SS1.p2.m7" class="ltx_Math" alttext="\mathbf{Z}_{e}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>e</mi></msub><annotation encoding="application/x-tex">\mathbf{Z}_{e}</annotation></semantics></math> and <math id="S4.SS1.p2.m8" class="ltx_Math" alttext="\mathbf{Z}_{r}" display="inline" intent=":literal"><semantics><msub><mi>𝐙</mi><mi>r</mi></msub><annotation encoding="application/x-tex">\mathbf{Z}_{r}</annotation></semantics></math> denote the embeddings of entities and relations, respectively, and <math id="S4.SS1.p2.m9" class="ltx_Math" alttext="e\in\{\mathcal{V}\mid\mathbf{q}\}" display="inline" intent=":literal"><semantics><mrow><mi>e</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>𝐪</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">e\in\{\mathcal{V}\mid\mathbf{q}\}</annotation></semantics></math> indicates the set of entities mentioned in the query <math id="S4.SS1.p2.m10" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>. This initialization assigns higher activation to query-relevant entities, providing a contextualized starting point for subsequent propagation.
The message passing at the <math id="S4.SS1.p2.m11" class="ltx_Math" alttext="(l+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(l+1)</annotation></semantics></math>-th layer then proceeds through relation-aware triple encoding, entity-wise aggregation, and representation update.</p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E2"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(2)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E2.m1" class="ltx_Math" alttext="\displaystyle\mathbf{m}_{v}^{(l+1)}=\textsc{Msg}\big(\mathbf{Z}_{v}^{(l)},g^{(l+1)}(\mathbf{Z}_{r}^{(l)}),\mathbf{Z}_{u}^{(l)}\big),~(u,r,v)\in\mathcal{E}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>𝐦</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mtext class="ltx_font_smallcaps">Msg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>𝐙</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><msup><mi>g</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐙</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><msubsup><mi>𝐙</mi><mi>u</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{m}_{v}^{(l+1)}=\textsc{Msg}\big(\mathbf{Z}_{v}^{(l)},g^{(l+1)}(\mathbf{Z}_{r}^{(l)}),\mathbf{Z}_{u}^{(l)}\big),~(u,r,v)\in\mathcal{E},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="S4.E3"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(3)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E3.m1" class="ltx_Math" alttext="\displaystyle\mathbf{Z}_{v}^{(l+1)}=\textsc{Update}\big(\mathbf{Z}_{v}^{(l)},\textsc{Agg}(\{\mathbf{m}_{u}^{(l+1)}\mid u\in\mathcal{N}(v)\})\big)," display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>𝐙</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mtext class="ltx_font_smallcaps">Update</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msubsup><mi>𝐙</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><mtext class="ltx_font_smallcaps">Agg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>𝐦</mi><mi>u</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>u</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbf{Z}_{v}^{(l+1)}=\textsc{Update}\big(\mathbf{Z}_{v}^{(l)},\textsc{Agg}(\{\mathbf{m}_{u}^{(l+1)}\mid u\in\mathcal{N}(v)\})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p2.3" class="ltx_p">where the message <math id="S4.SS1.p2.m12" class="ltx_Math" alttext="\mathbf{m}" display="inline" intent=":literal"><semantics><mi>𝐦</mi><annotation encoding="application/x-tex">\mathbf{m}</annotation></semantics></math> captures triple-level interactions between the neighboring entities and relations. Specifically, <math id="S4.SS1.p2.m13" class="ltx_Math" alttext="\textsc{Msg}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Msg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Msg}(\cdot)</annotation></semantics></math>, the projection function <math id="S4.SS1.p2.m14" class="ltx_Math" alttext="g(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\cdot)</annotation></semantics></math>, <math id="S4.SS1.p2.m15" class="ltx_Math" alttext="\textsc{Update}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Update</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Update}(\cdot)</annotation></semantics></math>, and <math id="S4.SS1.p2.m16" class="ltx_Math" alttext="\textsc{Agg}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">Agg</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Agg}(\cdot)</annotation></semantics></math> are learnable components of the GFM <math id="S4.SS1.p2.m17" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math> and are jointly pre-trained over the indexed multi-domain knowledge graphs.</p>
</div>
<div id="S4.SS1.p3" class="ltx_para">
<p id="S4.SS1.p3.1" class="ltx_p">Query-dependent GNNs are theoretically capable of multi-hop reasoning, but they assume the semantic consistency of the KG <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib76" title="" class="ltx_ref">Yasunaga et al., 2021</a>; <a href="#bib.bib75" title="" class="ltx_ref">Huang et al., 2023</a>)</cite>. Nevertheless, as the knowledge graph <math id="S4.SS1.p3.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> in our setting is indexed from the multi-domain documents with varying semantic distributions, it potentially breaks the assumption. We next bridge this alignment gap by deriving from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib77" title="" class="ltx_ref">Qiu et al. (2024)</a></cite>.</p>
</div>
<div id="S4.Thmtheorem1" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_font_smallcaps ltx_title_theorem">Proposition 4.1 (<span id="S4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Multi-domain logical expressivity of query-conditioned GFM</span>).</h6>
<div id="S4.Thmtheorem1.p1" class="ltx_para">
<p id="S4.Thmtheorem1.p1.1" class="ltx_p"><span id="S4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem1.p1.m1" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> be a knowledge graph indexed from multiple domains. <math id="S4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\{\operatorname{Dom}_{d}(e)\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msub><mi>Dom</mi><mi>d</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\operatorname{Dom}_{d}(e)\}</annotation></semantics></math> denotes unary predicates indicate domain attributes of entity <math id="S4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>. For a query <math id="S4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="q" display="inline" intent=":literal"><semantics><mi>q</mi><annotation encoding="application/x-tex">q</annotation></semantics></math>, the query-conditioned GFM can learn a rule <math id="S4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\textnormal{{R}}(\textnormal{$\mathbf{q}$},e)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_sans-serif">R</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{{R}}(\textnormal{$\mathbf{q}$},e)</annotation></semantics></math> if and only if <math id="S4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="\textnormal{{R}}(\textnormal{$\mathbf{q}$},e)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_sans-serif">R</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textnormal{{R}}(\textnormal{$\mathbf{q}$},e)</annotation></semantics></math> is a formula in graded modal logic over <math id="S4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> with constant <math id="S4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>, i.e., <math id="S4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\exists^{\geqslant N}e^{\prime}(\textnormal{{R}}(e^{\prime},e)\wedge\operatorname{Dom}_{d}(e^{\prime})\wedge\psi(e^{\prime}))" display="inline" intent=":literal"><semantics><mrow><msup><mo>∃</mo><mrow><mphantom></mphantom><mo>⩾</mo><mi>N</mi></mrow></msup><mrow><msup><mi>e</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mtext class="ltx_mathvariant_sans-serif">R</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mo>′</mo></msup><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><msub><mi>Dom</mi><mi>d</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>∧</mo><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\exists^{\geqslant N}e^{\prime}(\textnormal{{R}}(e^{\prime},e)\wedge\operatorname{Dom}_{d}(e^{\prime})\wedge\psi(e^{\prime}))</annotation></semantics></math>, where <math id="S4.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\psi(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>ψ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\psi(\cdot)</annotation></semantics></math> a subformula.  <a href="#A3.SS1" title="C.1. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref ltx_font_upright">[<math class="ltx_Math" alttext="\rhd" display="inline" intent=":literal"><semantics><mi mathvariant="normal">⊳</mi><annotation encoding="application/x-tex">\rhd</annotation></semantics></math>Proof]</a></span></p>
</div>
</div>
<div id="S4.SS1.p4" class="ltx_para">
<p id="S4.SS1.p4.1" class="ltx_p">In plain terms, Proposition <a href="#S4.Thmtheorem1" title="Proposition 4.1 (Multi-domain logical expressivity of query-conditioned GFM). ‣ 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> shows that a query-conditioned GFM over a multi-domain knowledge graph can represent exactly those query-entity relations definable by graded modal logic, with the query <span id="S4.SS1.p4.1.1" class="ltx_text ltx_markedasmath ltx_font_sansserif">q</span> acting as a constant. This captures the multi-hop relational and domain-aware reasoning required for complex queries.</p>
</div>
<div id="S4.SS1.p5" class="ltx_para">
<p id="S4.SS1.p5.1" class="ltx_p"><span id="S4.SS1.p5.1.1" class="ltx_text ltx_font_bold">Prototype-driven Multi-Domain Pre-training.</span>
An ideal GFM should exhibit homogenization across tasks and emergence of transferable knowledge <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib74" title="" class="ltx_ref">Liu et al., 2025</a>)</cite>, enabling it as a cross-domain retriever under distribution shifts. To achieve this, we pre-train <math id="S4.SS1.p5.m1" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math> with KG completion task.
For each masked triple <math id="S4.SS1.p5.m2" class="ltx_Math" alttext="(e,r,?)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>?</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e,r,?)</annotation></semantics></math> or <math id="S4.SS1.p5.m3" class="ltx_Math" alttext="(?,r,e)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>?</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(?,r,e)</annotation></semantics></math> randomly sampled from <math id="S4.SS1.p5.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math> over domains, <math id="S4.SS1.p5.m5" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math> receives a pseudo-query <math id="S4.SS1.p5.m6" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> constructed from the known elements and predicts the missing entity with relevance score <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>:</p>
<table id="S4.E4" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(4)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E4.m1" class="ltx_Math" alttext="\mathbb{P}_{\mathbf{q}}(e)=\sigma\big(\textsc{MLP}(\mathbf{Z}^{(L)}_{e})\big)\in\mathbb{R}^{|\mathcal{V}|\times 1}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mtext class="ltx_font_smallcaps">MLP</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐙</mi><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mn>1</mn></mrow></msup></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathbf{q}}(e)=\sigma\big(\textsc{MLP}(\mathbf{Z}^{(L)}_{e})\big)\in\mathbb{R}^{|\mathcal{V}|\times 1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.2" class="ltx_p">which yields a binary cross-entropy (BCE) loss:</p>
<table id="S4.E5" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(5)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E5.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{BCE}}=-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{+}|}\sum_{e\in\mathcal{V}_{\mathbf{q}}^{+}}\log\mathbb{P}_{\mathbf{q}}(e)-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{-}|}\sum_{e\in\mathcal{V}_{\mathbf{q}}^{-}}\log(1-\mathbb{P}_{\mathbf{q}}(e))," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>e</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup></mrow></munder><mi>log</mi><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>−</mo></msubsup><mo stretchy="false">|</mo></mrow></mfrac><munder><mo movablelimits="false">∑</mo><mrow><mi>e</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>−</mo></msubsup></mrow></munder><mi>log</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>−</mo><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{BCE}}=-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{+}|}\sum_{e\in\mathcal{V}_{\mathbf{q}}^{+}}\log\mathbb{P}_{\mathbf{q}}(e)-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{-}|}\sum_{e\in\mathcal{V}_{\mathbf{q}}^{-}}\log(1-\mathbb{P}_{\mathbf{q}}(e)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.3" class="ltx_p">where <math id="S4.SS1.p5.m7" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}^{+}</annotation></semantics></math> denotes the set of entities relevant to the query <math id="S4.SS1.p5.m8" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>, and <math id="S4.SS1.p5.m9" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}^{-}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>−</mo></msubsup><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}^{-}</annotation></semantics></math> denotes the remaining entities. To further alleviate the vanishing-gradient issue caused by the sparsity of positive entities, we additionally incorporate a ranking loss to enforce a margin between positive and negative entities <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib82" title="" class="ltx_ref">Bai et al., 2023</a>; <a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>:</p>
<table id="S4.E6" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(6)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E6.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{rank}}=-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{+}|}\sum\nolimits_{e\in\mathcal{V}_{\mathbf{q}}^{+}}\frac{\mathbb{P}_{\mathbf{q}}(e)}{\sum_{e^{\prime}\in\mathcal{V}_{\mathbf{q}}^{-}}}\mathbb{P}_{\mathbf{q}}(e^{\prime})." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub><mo rspace="0em">=</mo><mo lspace="0em">−</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup><mo stretchy="false">|</mo></mrow></mfrac><msub><mo>∑</mo><mrow><mi>e</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup></mrow></msub><mfrac><mrow><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><msub><mo>∑</mo><mrow><msup><mi>e</mi><mo>′</mo></msup><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>−</mo></msubsup></mrow></msub></mfrac><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mrow><mo stretchy="false">(</mo><msup><mi>e</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{rank}}=-\frac{1}{|\mathcal{V}_{\mathbf{q}}^{+}|}\sum\nolimits_{e\in\mathcal{V}_{\mathbf{q}}^{+}}\frac{\mathbb{P}_{\mathbf{q}}(e)}{\sum_{e^{\prime}\in\mathcal{V}_{\mathbf{q}}^{-}}}\mathbb{P}_{\mathbf{q}}(e^{\prime}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.4" class="ltx_p">To improve cross-domain semantic consistency, we introduce a lightweight prototype-based contrastive continuous pre-training mechanism. For each pre-training domain <math id="S4.SS1.p5.m10" class="ltx_Math" alttext="d\in\{\mathcal{D}\}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">d\in\{\mathcal{D}\}</annotation></semantics></math>, we uniformly sample a subset of query-entity pairs <math id="S4.SS1.p5.m11" class="ltx_Math" alttext="(\mathbf{q}i,e_{i})\in\mathcal{Q}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>𝐪</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi></mrow><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(\mathbf{q}i,e_{i})\in\mathcal{Q}_{d}</annotation></semantics></math>, and define the semantic prototype <math id="S4.SS1.p5.m12" class="ltx_Math" alttext="\mathbf{c}_{d}" display="inline" intent=":literal"><semantics><msub><mi>𝐜</mi><mi>d</mi></msub><annotation encoding="application/x-tex">\mathbf{c}_{d}</annotation></semantics></math> of domain <math id="S4.SS1.p5.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math> as the mean embedding of the corresponding entities <math id="S4.SS1.p5.m14" class="ltx_Math" alttext="\{e_{i}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{e_{i}\}</annotation></semantics></math>.
The prototype-driven objective is:</p>
<table id="S4.E7" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(7)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{proto}}=\sum_{(\mathbf{q}_{i},e_{i},d^{+})\in\bigcup_{d}\{\mathcal{Q}_{d}\}}\log\frac{\exp\big(\mathrm{sim}(\mathbf{Z}_{e_{i}}^{(L)},\mathbf{c}_{d^{+}})/\tau\big)}{\sum_{d\in\mathcal{D}}\exp\big(\mathrm{sim}(\mathbf{Z}_{e_{i}}^{(L)},\mathbf{c}_{d})/\tau\big)}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>proto</mtext></msub><mo rspace="0.111em">=</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>i</mi></msub><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub><mo>,</mo><msup><mi>d</mi><mo>+</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>d</mi></msub></mstyle><mrow><mo stretchy="false">{</mo><msub><mi class="ltx_font_mathcaligraphic">𝒬</mi><mi>d</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow></munder><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐙</mi><msub><mi>e</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>𝐜</mi><msup><mi>d</mi><mo>+</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mrow><mi>d</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐙</mi><msub><mi>e</mi><mi>i</mi></msub><mrow><mo stretchy="false">(</mo><mi>L</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>𝐜</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{proto}}=\sum_{(\mathbf{q}_{i},e_{i},d^{+})\in\bigcup_{d}\{\mathcal{Q}_{d}\}}\log\frac{\exp\big(\mathrm{sim}(\mathbf{Z}_{e_{i}}^{(L)},\mathbf{c}_{d^{+}})/\tau\big)}{\sum_{d\in\mathcal{D}}\exp\big(\mathrm{sim}(\mathbf{Z}_{e_{i}}^{(L)},\mathbf{c}_{d})/\tau\big)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p5.5" class="ltx_p">where <math id="S4.SS1.p5.m15" class="ltx_Math" alttext="\{\mathbf{c}_{d}\}_{d\in\{\mathcal{D}\}}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>𝐜</mi><mi>d</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>d</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">}</mo></mrow></mrow></msub><annotation encoding="application/x-tex">\{\mathbf{c}_{d}\}_{d\in\{\mathcal{D}\}}</annotation></semantics></math> denote the prototypes of all domains, <math id="S4.SS1.p5.m16" class="ltx_Math" alttext="\mathbf{c}_{d^{+}}" display="inline" intent=":literal"><semantics><msub><mi>𝐜</mi><msup><mi>d</mi><mo>+</mo></msup></msub><annotation encoding="application/x-tex">\mathbf{c}_{d^{+}}</annotation></semantics></math> corresponds to the ground-truth domain of <math id="S4.SS1.p5.m17" class="ltx_Math" alttext="(\mathbf{q}_{i},e_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐪</mi><mi>i</mi></msub><mo>,</mo><msub><mi>e</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{q}_{i},e_{i})</annotation></semantics></math>, and <math id="S4.SS1.p5.m18" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is a temperature hyperparameter. This loss encourages retrieved entity representations to align with their corresponding domain prototypes while remaining separated from unrelated domain centers. The optimization is performed over a small sampled subset, ensuring efficiency during continuous pre-training.</p>
</div>
<div id="S4.SS1.p6" class="ltx_para">
<p id="S4.SS1.p6.1" class="ltx_p"><span id="S4.SS1.p6.1.1" class="ltx_text ltx_font_bold">Regularization via Information Gain.</span>
While <math id="S4.SS1.p6.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{proto}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>proto</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{proto}}</annotation></semantics></math> encourages semantic discriminability across domains, it does not explicitly distinguish informative semantic alignment from spurious correlations or random perturbations. To further emphasize domain-relevant information, we introduce an information gain-based regularizer <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib84" title="" class="ltx_ref">Kent, 1983</a>; <a href="#bib.bib83" title="" class="ltx_ref">Zhang et al., 2022b</a>)</cite>.
Given the predicted distribution <math id="S4.SS1.p6.m2" class="ltx_Math" alttext="\mathbb{P}_{\mathbf{q}}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathbf{q}}(e)</annotation></semantics></math>, the Information Gain Contrast (IGC) regularizer is defined as:</p>
<table id="S4.E8" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(8)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E8.m1" class="ltx_math_unparsed" alttext="\mathcal{L}_{\text{IGC}}=\operatorname{KL}(\mathbb{P}_{\mathbf{q}}(e)~\|~\mathbb{P}_{\text{proto}}(e))-\operatorname{KL}(\mathbb{P}_{\mathbf{q}}(e)~\|~\mathbb{P}_{\text{rand}}(e))," display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IGC</mtext></msub><mo>=</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo rspace="0.052em" stretchy="false">)</mo></mrow><mo rspace="0.497em">∥</mo><msub><mi>ℙ</mi><mtext>proto</mtext></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>KL</mi><mrow><mo stretchy="false">(</mo><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo rspace="0.052em" stretchy="false">)</mo></mrow><mo rspace="0.497em">∥</mo><msub><mi>ℙ</mi><mtext>rand</mtext></msub><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{IGC}}=\operatorname{KL}(\mathbb{P}_{\mathbf{q}}(e)~\|~\mathbb{P}_{\text{proto}}(e))-\operatorname{KL}(\mathbb{P}_{\mathbf{q}}(e)~\|~\mathbb{P}_{\text{rand}}(e)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p6.2" class="ltx_p">where <math id="S4.SS1.p6.m3" class="ltx_Math" alttext="\operatorname{KL}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>KL</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{KL}(\cdot)</annotation></semantics></math> denotes the Kullback-Leibler divergence.
<math id="S4.SS1.p6.m4" class="ltx_Math" alttext="\mathbb{P}_{\text{proto}}(e)\propto\exp(\operatorname{sim}(\mathbf{Z}_{e},\mathbf{c}_{d^{+}}))" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mtext>proto</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∝</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐙</mi><mi>e</mi></msub><mo>,</mo><msub><mi>𝐜</mi><msup><mi>d</mi><mo>+</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\text{proto}}(e)\propto\exp(\operatorname{sim}(\mathbf{Z}_{e},\mathbf{c}_{d^{+}}))</annotation></semantics></math> is a prototype-induced distribution reflecting domain-consistent semantics, while <math id="S4.SS1.p6.m5" class="ltx_Math" alttext="\mathbb{P}_{\text{rand}}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mtext>rand</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\text{rand}}(e)</annotation></semantics></math> is a randomized reference distribution constructed by shuffling domain prototypes.
By explicitly contrasting structured semantic alignment against randomness, <math id="S4.SS1.p6.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{IGC}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IGC</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{IGC}}</annotation></semantics></math> encourages <math id="S4.SS1.p6.m7" class="ltx_Math" alttext="\mathbb{P}_{\mathbf{q}}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathbf{q}}(e)</annotation></semantics></math> to assign higher confidence to entities grounded in domain-relevant semantics, thereby strengthening cross-domain consistency.</p>
</div>
<div id="S4.SS1.p7" class="ltx_para">
<p id="S4.SS1.p7.1" class="ltx_p"><span id="S4.SS1.p7.1.1" class="ltx_text ltx_font_bold">Overall Pre-training Objective.</span>
The full pre-training loss combines retrieval supervision with semantic regularization:</p>
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(9)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{pre}}=\underbrace{\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}}_{\text{Phase I}}+\underbrace{\alpha_{2}\mathcal{L}_{\text{proto}}+\alpha_{3}\mathcal{L}_{\text{IGC}}}_{\text{Phase II}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>pre</mtext></msub><mo>=</mo><mrow><munder><munder accentunder="true"><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Phase I</mtext></munder><mo>+</mo><munder><munder accentunder="true"><mrow><mrow><msub><mi>α</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>proto</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>α</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IGC</mtext></msub></mrow></mrow><mo stretchy="true">⏟</mo></munder><mtext>Phase II</mtext></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{pre}}=\underbrace{\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}}_{\text{Phase I}}+\underbrace{\alpha_{2}\mathcal{L}_{\text{proto}}+\alpha_{3}\mathcal{L}_{\text{IGC}}}_{\text{Phase II}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS1.p7.2" class="ltx_p">where <math id="S4.SS1.p7.m1" class="ltx_Math" alttext="\alpha_{1}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\alpha_{1}</annotation></semantics></math> is the trade-off hyper-parameter, <math id="S4.SS1.p7.m2" class="ltx_Math" alttext="\alpha_{2}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\alpha_{2}</annotation></semantics></math> and <math id="S4.SS1.p7.m3" class="ltx_Math" alttext="\alpha_{3}" display="inline" intent=":literal"><semantics><msub><mi>α</mi><mn>3</mn></msub><annotation encoding="application/x-tex">\alpha_{3}</annotation></semantics></math> are the Lagrange multipliers.
Regarding the diversity of objective terms, we propose a two-phase pre-training strategy to enhance the stability.
During Phase I, we pre-train <math id="S4.SS1.p7.m4" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math> for a fixed number of epochs with <math id="S4.SS1.p7.m5" class="ltx_Math" alttext="\mathcal{L}_{\text{BCE}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{BCE}}</annotation></semantics></math> and <math id="S4.SS1.p7.m6" class="ltx_Math" alttext="\mathcal{L}_{\text{rank}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{rank}}</annotation></semantics></math> on KG completion task over mixed-domain triples to establish its general retrieval capability.
During Phase II, we apply continuous pre-training mechanism with <math id="S4.SS1.p7.m7" class="ltx_Math" alttext="\mathcal{L}_{\text{proto}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>proto</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{proto}}</annotation></semantics></math> and <math id="S4.SS1.p7.m8" class="ltx_Math" alttext="\mathcal{L}_{\text{IGC}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IGC</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{IGC}}</annotation></semantics></math> on a subset for the fine-grained semantic alignment. This staged training scheme stabilizes optimization and avoids conflicts among heterogeneous loss signals introduced by prototype-level regularization.
We will specify details in Appendix <a href="#A2.SS1" title="B.1. Computational Complexity of the Pre-training Stage ‣ Appendix B Algorithm and Complexity Analysis ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.1</span></a>.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2. </span>Label-free IB Optimized Subgraph Selector</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">While the pre-trained retriever <math id="S4.SS2.p1.m1" class="ltx_Math" alttext="f_{\bm{\theta}}^{\star}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}^{\star}(\cdot)</annotation></semantics></math> can identify relevant entities across domains, directly reasoning over the full graph is computationally expensive and offers limited structural interpretability.
Instead of returning a ranked list of entities, we learn a query-conditioned subgraph selector that identifies a minimal yet sufficient <math id="S4.SS2.p1.m2" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math> for reasoning.</p>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p"><span id="S4.SS2.p2.1.1" class="ltx_text ltx_font_bold">Query-conditioned Subgraph Selection.</span>
To efficiently adapt the pre-trained retriever <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="f_{\bm{\theta}}^{\star}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}^{\star}(\cdot)</annotation></semantics></math> to query-specific subgraph selection, we adopt a parameter-efficient fine-tuning (PEFT) strategy that freezes the backbone GFM parameters and introduces lightweight, query-conditioned adaptations for subgraph selection.
Given query <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> on the knowledge graph <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>, we derive a shared query prompt <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="\mathbf{p}=\operatorname{MLP}(\mathbf{q})" display="inline" intent=":literal"><semantics><mrow><mi>𝐩</mi><mo>=</mo><mrow><mi>MLP</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathbf{p}=\operatorname{MLP}(\mathbf{q})</annotation></semantics></math>, which is broadcast to construct query-conditioned entity embedding:</p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(10)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="\widetilde{\mathbf{Z}}_{e}=\big[\mathbf{Z}_{e}^{\star}~\|~\mathbf{W}_{1}\mathbf{p}~\|~\mathbf{W}_{2}\mathbf{q}\big]," display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>𝐙</mi><mo>~</mo></mover><mi>e</mi></msub><mo>=</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><msubsup><mi>𝐙</mi><mi>e</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0.330em" stretchy="false">‖</mo><mrow><msub><mi>𝐖</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐩</mi></mrow><mo lspace="0.330em" stretchy="false">‖</mo></mrow><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>𝐖</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>𝐪</mi></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{\mathbf{Z}}_{e}=\big[\mathbf{Z}_{e}^{\star}~\|~\mathbf{W}_{1}\mathbf{p}~\|~\mathbf{W}_{2}\mathbf{q}\big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p2.2" class="ltx_p">where <math id="S4.SS2.p2.m5" class="ltx_Math" alttext="\mathbf{Z}_{e}^{\star}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐙</mi><mi>e</mi><mo>⋆</mo></msubsup><annotation encoding="application/x-tex">\mathbf{Z}_{e}^{\star}</annotation></semantics></math> is the initialized and then freezed entity embedding from <math id="S4.SS2.p2.m6" class="ltx_Math" alttext="f_{\bm{\theta}}^{\star}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}^{\star}(\cdot)</annotation></semantics></math>. <math id="S4.SS2.p2.m7" class="ltx_Math" alttext="\mathbf{W}_{1}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\mathbf{W}_{1}</annotation></semantics></math>, <math id="S4.SS2.p2.m8" class="ltx_Math" alttext="\mathbf{W}_{2}" display="inline" intent=":literal"><semantics><msub><mi>𝐖</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\mathbf{W}_{2}</annotation></semantics></math> are learnable weights. <math id="S4.SS2.p2.m9" class="ltx_Math" alttext="\|" display="inline" intent=":literal"><semantics><mo>∥</mo><annotation encoding="application/x-tex">\|</annotation></semantics></math> denotes the concatenation.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">To enable differentiable and optimizable subgraph sampling during fine-tuning, we employ the Gumbel-Sigmoid relaxation to approximate binary selection gates. Specifically, for each entity <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>, the selection probability <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="S_{e}(\mathbf{q})\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S_{e}(\mathbf{q})\in[0,1]</annotation></semantics></math> is sampled as:</p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(11)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_math_unparsed" alttext="S_{e}(\mathbf{q})=\left[1+\exp\left(-\sigma\big(\big(\operatorname{MLP}(\widetilde{\mathbf{Z}}_{e})\big)+g_{e}\big)/\tau\right)\right]^{-1}," display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>e</mi></msub><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mrow><mo>[</mo><mn>1</mn><mo>+</mo><mi>exp</mi><mrow><mo>(</mo><mo lspace="0em">−</mo><mi>σ</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>MLP</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>𝐙</mi><mo>~</mo></mover><mi>e</mi></msub><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><msub><mi>g</mi><mi>e</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>/</mo><mi>τ</mi><mo>)</mo></mrow><mo>]</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{e}(\mathbf{q})=\left[1+\exp\left(-\sigma\big(\big(\operatorname{MLP}(\widetilde{\mathbf{Z}}_{e})\big)+g_{e}\big)/\tau\right)\right]^{-1},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p3.2" class="ltx_p">where the variable <math id="S4.SS2.p3.m3" class="ltx_Math" alttext="g_{e}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>e</mi></msub><annotation encoding="application/x-tex">g_{e}</annotation></semantics></math> is sampled from the standard Gumbel distribution, and <math id="S4.SS2.p3.m4" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is the temperature parameter.
This formulation provides a continuous and differentiable surrogate for discrete node selection, enabling stochastic yet trainable subgraph sampling within an end-to-end optimization framework.
Given a threshold <math id="S4.SS2.p3.m5" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>, the query-specific subgraph <math id="S4.SS2.p3.m6" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math> is instantiated with entity set <math id="S4.SS2.p3.m7" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}=\{e\in\mathcal{V}^{T}\mid S_{e}(\mathbf{q})&gt;\epsilon\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mi>e</mi><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>T</mi></msup></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mi>ϵ</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}=\{e\in\mathcal{V}^{T}\mid S_{e}(\mathbf{q})&gt;\epsilon\}</annotation></semantics></math>, from which the corresponding relation set <math id="S4.SS2.p3.m8" class="ltx_Math" alttext="\mathcal{R}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{R}_{\mathbf{q}}</annotation></semantics></math> and edge set <math id="S4.SS2.p3.m9" class="ltx_Math" alttext="\mathcal{E}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathbf{q}}</annotation></semantics></math> are induced accordingly.
Importantly, the use of Gumbel-Sigmoid ensures that gradients can propagate through the selection process, making the subgraph construction fully differentiable and amenable to optimization under the downstream objectives. We next discuss its optimization.</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<p id="S4.SS2.p4.1" class="ltx_p"><span id="S4.SS2.p4.1.1" class="ltx_text ltx_font_bold">Label-free Information Bottleneck.</span>
We formulate the selector from an information-theoretic perspective. The Information Bottleneck (IB) principle <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib85" title="" class="ltx_ref">Tishby et al., 2000</a>; <a href="#bib.bib86" title="" class="ltx_ref">Tishby and Zaslavsky, 2015</a>)</cite> provides an ideal way to optimize the subgraph selector that compresses full KG (<span id="S4.SS2.p4.1.2" class="ltx_text ltx_font_italic">minimal</span>) while preserving the query-relevant subgraph (<span id="S4.SS2.p4.1.3" class="ltx_text ltx_font_italic">sufficient</span>):</p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(12)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{IB}}=-I(y;\mathcal{G}_{\mathbf{q}})+\beta I(\mathcal{G};\mathcal{G}_{\mathbf{q}})," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IB</mtext></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{IB}}=-I(y;\mathcal{G}_{\mathbf{q}})+\beta I(\mathcal{G};\mathcal{G}_{\mathbf{q}}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p4.2" class="ltx_p">where <math id="S4.SS2.p4.m1" class="ltx_Math" alttext="I(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I(\cdot)</annotation></semantics></math> is mutual information, and <math id="S4.SS2.p4.m2" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> is Lagrange multiplier for trading off between compressing (the first term) and preserving (the second term). Minimizing <math id="S4.SS2.p4.m3" class="ltx_Math" alttext="\mathcal{L}_{\text{IB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{IB}}</annotation></semantics></math> encourages the selector to find a minimal yet sufficient “coreset” in <math id="S4.SS2.p4.m4" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">However, as generating the answer <math id="S4.SS2.p5.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> is non-differentiable, directly optimizing Eq. (<a href="#S4.E12" title="In 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>) is intractable, which causes the major challenge in finding <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math>.
To address this dilemma, we establish a surrogate objective for label-free IB optimization by replacing the label <math id="S4.SS2.p5.m3" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> with the query itself:</p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(13)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{LIB}}=-I(\mathbf{q};\mathcal{G}_{\mathbf{q}})+\beta I(\mathcal{G};\mathcal{G}_{\mathbf{q}})." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><mo>=</mo><mrow><mrow><mo>−</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{LIB}}=-I(\mathbf{q};\mathcal{G}_{\mathbf{q}})+\beta I(\mathcal{G};\mathcal{G}_{\mathbf{q}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p5.2" class="ltx_p">We next show <math id="S4.SS2.p5.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{LIB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{LIB}}</annotation></semantics></math> is a faithful proxy of <math id="S4.SS2.p5.m5" class="ltx_Math" alttext="\mathcal{L}_{\text{IB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{IB}}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_font_smallcaps ltx_title_theorem">Proposition 4.2 (<span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Error Bound of <math id="S4.Thmtheorem2.m1" class="ltx_Math" alttext="\mathcal{L}_{\textnormal{LIB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\textnormal{LIB}}</annotation></semantics></math> Approximation</span>).</h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p"><span id="S4.Thmtheorem2.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math> be the subgraph, <math id="S4.Thmtheorem2.p1.m2" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> the ground-truth answer, and <math id="S4.Thmtheorem2.p1.m3" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> the query. Assume the Markov property <math id="S4.Thmtheorem2.p1.m4" class="ltx_math_unparsed" alttext="\langle y\leftrightarrow\mathbf{q}\leftrightarrow\mathcal{G}_{\mathbf{q}}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mi>y</mi><mo stretchy="false">↔</mo><mi>𝐪</mi><mo stretchy="false">↔</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle y\leftrightarrow\mathbf{q}\leftrightarrow\mathcal{G}_{\mathbf{q}}\rangle</annotation></semantics></math> exists, the approximation error of <math id="S4.Thmtheorem2.p1.m5" class="ltx_Math" alttext="\mathcal{L}_{\textnormal{IB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>IB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\textnormal{IB}}</annotation></semantics></math> by <math id="S4.Thmtheorem2.p1.m6" class="ltx_Math" alttext="\mathcal{L}_{\textnormal{LIB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\textnormal{LIB}}</annotation></semantics></math> is upper-bounded by the conditional entropy of <math id="S4.Thmtheorem2.p1.m7" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> given <math id="S4.Thmtheorem2.p1.m8" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>:</span></p>
<table id="S4.E14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(14)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E14.m1" class="ltx_Math" alttext="\left|I(y;\mathcal{G}_{\mathbf{q}})-I(\mathbf{q};\mathcal{G}_{\mathbf{q}})\right|\leqslant H(\mathbf{q}\mid y)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>⩽</mo><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|I(y;\mathcal{G}_{\mathbf{q}})-I(\mathbf{q};\mathcal{G}_{\mathbf{q}})\right|\leqslant H(\mathbf{q}\mid y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem2.p1.2" class="ltx_p"><span id="S4.Thmtheorem2.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem2.p1.m9" class="ltx_Math" alttext="H(\mathbf{q}\mid y)" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">H(\mathbf{q}\mid y)</annotation></semantics></math> is a data-dependent constant. <a href="#A3.SS2" title="C.2. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref ltx_font_upright">[<math class="ltx_Math" alttext="\rhd" display="inline" intent=":literal"><semantics><mi mathvariant="normal">⊳</mi><annotation encoding="application/x-tex">\rhd</annotation></semantics></math>Proof]</a></span></p>
</div>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">Proposition <a href="#S4.Thmtheorem2" title='Proposition 4.2 (Error Bound of ℒ_"LIB" Approximation). ‣ 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG' class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a> declares that the approximation error is upper-bounded by the conditional entropy of the true label <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> given the query <math id="S4.SS2.p6.m2" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>. Once the data distribution is given and fixed, the approximation gap remains controllable within a constant bound by the informativeness of the query, which provides a guarantee that the quality of approximation is theoretically controlled by the informativeness of the query.
Since Eq. (<a href="#S4.E13" title="In 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>) provides a theoretical form of fine-tuning objective, both mutual information terms are computationally infeasible. We next demonstrate their tractable derivations.</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_font_smallcaps ltx_title_theorem">Proposition 4.3 (<span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Lower Bound of <math id="S4.Thmtheorem3.m1" class="ltx_Math" alttext="I(\mathbf{q};\mathcal{G}_{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">q</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I(\mathbf{q};\mathcal{G}_{\mathbf{q}})</annotation></semantics></math></span>).</h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p"><span id="S4.Thmtheorem3.p1.1.1" class="ltx_text ltx_font_italic">Denote the average-pooled subgraph representation as <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="\mathbf{G}_{\mathbf{q}}=\sum_{e\in\mathcal{V}_{\mathbf{q}}}S_{e}(\mathbf{q})\cdot\widetilde{\mathbf{Z}}_{e}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝐆</mi><mi>𝐪</mi></msub><mo rspace="0.111em">=</mo><mrow><mrow><msub><mo>∑</mo><mrow><mi>e</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi></msub></mrow></msub><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>𝐙</mi><mo>~</mo></mover><mi>e</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\mathbf{G}_{\mathbf{q}}=\sum_{e\in\mathcal{V}_{\mathbf{q}}}S_{e}(\mathbf{q})\cdot\widetilde{\mathbf{Z}}_{e}</annotation></semantics></math>. Deriving from <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib87" title="" class="ltx_ref">Alemi et al. (2017)</a></cite>, the lower bound is:</span></p>
<table id="S4.E15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(15)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E15.m1" class="ltx_Math" alttext="I(\mathbf{q};\mathcal{G}_{\mathbf{q}})\geqslant-\mathcal{L}_{\textnormal{NCE}}=\log\frac{\exp\big(\operatorname{sim}(\mathbf{G}_{\mathbf{q}},\mathbf{q})/\tau\big)}{\sum_{\mathbf{q}^{\prime}\in\mathcal{B}}\exp\big(\operatorname{sim}(\mathbf{G}_{\mathbf{q}^{\prime}},\mathbf{q}^{\prime})/\tau\big)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⩾</mo><mrow><mo>−</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>NCE</mtext></msub></mrow><mo>=</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐆</mi><mi>𝐪</mi></msub><mo>,</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mrow><msub><mo>∑</mo><mrow><msup><mi>𝐪</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℬ</mi></mrow></msub><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>sim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝐆</mi><msup><mi>𝐪</mi><mo>′</mo></msup></msub><mo>,</mo><msup><mi>𝐪</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>τ</mi></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">I(\mathbf{q};\mathcal{G}_{\mathbf{q}})\geqslant-\mathcal{L}_{\textnormal{NCE}}=\log\frac{\exp\big(\operatorname{sim}(\mathbf{G}_{\mathbf{q}},\mathbf{q})/\tau\big)}{\sum_{\mathbf{q}^{\prime}\in\mathcal{B}}\exp\big(\operatorname{sim}(\mathbf{G}_{\mathbf{q}^{\prime}},\mathbf{q}^{\prime})/\tau\big)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem3.p1.2" class="ltx_p"><span id="S4.Thmtheorem3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="(\mathbf{G}_{\mathbf{q}^{\prime}},\mathbf{q}^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>𝐆</mi><msup><mi>𝐪</mi><mo>′</mo></msup></msub><mo>,</mo><msup><mi>𝐪</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathbf{G}_{\mathbf{q}^{\prime}},\mathbf{q}^{\prime})</annotation></semantics></math> is the negative sample pair. <a href="#A3.SS3" title="C.3. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref ltx_font_upright">[<math class="ltx_Math" alttext="\rhd" display="inline" intent=":literal"><semantics><mi mathvariant="normal">⊳</mi><annotation encoding="application/x-tex">\rhd</annotation></semantics></math>Proof]</a></span></p>
</div>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_proposition">
<h6 class="ltx_title ltx_runin ltx_font_smallcaps ltx_title_theorem">Proposition 4.4 (<span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Upper Bound of <math id="S4.Thmtheorem4.m1" class="ltx_Math" alttext="I(\mathcal{G};\mathcal{G}_{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi mathvariant="normal">q</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">I(\mathcal{G};\mathcal{G}_{\mathbf{q}})</annotation></semantics></math></span>).</h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p"><span id="S4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Denote the subgraph size and connectivity penalizers as:</span></p>
<table id="S4.E16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(16)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E16.m1" class="ltx_Math" alttext="\mathcal{L}_{\textnormal{size}}=\sum\nolimits_{e\in\mathcal{V}}S_{e}(\mathbf{q}),\;\;\mathcal{L}_{\textnormal{con}}=\operatorname{Tr}\big(\mathbf{S}_{e}(\mathbf{q})^{\top}\mathbf{L}\mathbf{S}_{e}(\mathbf{q})\big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>size</mtext></msub><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>e</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></msub><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.727em">,</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>con</mtext></msub><mo>=</mo><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>𝐒</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝐋𝐒</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\textnormal{size}}=\sum\nolimits_{e\in\mathcal{V}}S_{e}(\mathbf{q}),\;\;\mathcal{L}_{\textnormal{con}}=\operatorname{Tr}\big(\mathbf{S}_{e}(\mathbf{q})^{\top}\mathbf{L}\mathbf{S}_{e}(\mathbf{q})\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem4.p1.2" class="ltx_p"><span id="S4.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="S_{e}(\mathbf{q})\in[\textnormal{0},\textnormal{1}]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mtext>0</mtext><mo>,</mo><mtext>1</mtext></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S_{e}(\mathbf{q})\in[\textnormal{0},\textnormal{1}]</annotation></semantics></math> is entity selection probability, <math id="S4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\mathbf{S}_{e}(\mathbf{q})\in\mathbb{R}^{|\mathcal{V}|}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝐒</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{S}_{e}(\mathbf{q})\in\mathbb{R}^{|\mathcal{V}|}</annotation></semantics></math> is the soft selection vector, <math id="S4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="\mathbf{L}" display="inline" intent=":literal"><semantics><mi>𝐋</mi><annotation encoding="application/x-tex">\mathbf{L}</annotation></semantics></math> is the normalized graph Laplacian, and <math id="S4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="\operatorname{Tr}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>Tr</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Tr}(\cdot)</annotation></semantics></math> calculates the trace of a matrix.
The upper bound is:</span></p>
<table id="S4.E17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(17)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E17.m1" class="ltx_Math" alttext="I(\mathcal{G};\mathcal{G}_{\mathbf{q}})\leqslant\beta_{\textnormal{1}}\mathcal{L}_{\textnormal{size}}+\beta_{\textnormal{2}}\mathcal{L}_{\textnormal{con}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>I</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>⩽</mo><mrow><mrow><msub><mi>β</mi><mtext>1</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>size</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mtext>2</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>con</mtext></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">I(\mathcal{G};\mathcal{G}_{\mathbf{q}})\leqslant\beta_{\textnormal{1}}\mathcal{L}_{\textnormal{size}}+\beta_{\textnormal{2}}\mathcal{L}_{\textnormal{con}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.Thmtheorem4.p1.3" class="ltx_p"><span id="S4.Thmtheorem4.p1.3.1" class="ltx_text ltx_font_italic">where <math id="S4.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\beta_{\textnormal{1}}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mtext>1</mtext></msub><annotation encoding="application/x-tex">\beta_{\textnormal{1}}</annotation></semantics></math> and <math id="S4.Thmtheorem4.p1.m6" class="ltx_Math" alttext="\beta_{\textnormal{2}}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mtext>2</mtext></msub><annotation encoding="application/x-tex">\beta_{\textnormal{2}}</annotation></semantics></math> are hyper-parameters. <a href="#A3.SS4" title="C.4. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref ltx_font_upright">[<math class="ltx_Math" alttext="\rhd" display="inline" intent=":literal"><semantics><mi mathvariant="normal">⊳</mi><annotation encoding="application/x-tex">\rhd</annotation></semantics></math>Proof]</a></span></p>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p">Proposition <a href="#S4.Thmtheorem3" title="Proposition 4.3 (Lower Bound of 𝐼(q,𝒢_q)). ‣ 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a> and Proposition <a href="#S4.Thmtheorem4" title="Proposition 4.4 (Upper Bound of 𝐼(𝒢,𝒢_q)). ‣ 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.4</span></a> provide a principled method for approximating <math id="S4.SS2.p7.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{LIB}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{LIB}}</annotation></semantics></math> using tractable optimization objectives, while deriving such bounds under label-free settings is non-trivial. By establishing this connection, we ensure both theoretical soundness and practical guidance for subgraph identification in multi-domain knowledge graph retrieval.</p>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p"><span id="S4.SS2.p8.1.1" class="ltx_text ltx_font_bold">Overall Fine-tuning Objective.</span>
Following the pre-training stage, we fine-tune the GFM retriever on a supervised document retrieval task, where each query <math id="S4.SS2.p8.m1" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math> is associated with a labeled target entity set <math id="S4.SS2.p8.m2" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}^{+}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi><mo>+</mo></msubsup><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}^{+}</annotation></semantics></math>. While standard retrieval objectives encourage accurate ranking with respect to labeled entities, they do not explicitly constrain the structural properties of the retrieved subgraphs. To address this limitation, we incorporate subgraph-level regularization into the fine-tuning objective, resulting in the following:</p>
<table id="S4.E18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(18)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E18.m1" class="ltx_Math" alttext="\mathcal{L}_{\text{ftn}}=\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}+\left\lceil\mathcal{L}_{\text{LIB}}\right\rceil," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>ftn</mtext></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub></mrow><mo>+</mo><mrow><mo>⌈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><mo>⌉</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{ftn}}=\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}+\left\lceil\mathcal{L}_{\text{LIB}}\right\rceil,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS2.p8.2" class="ltx_p">where <math id="S4.SS2.p8.m3" class="ltx_Math" alttext="\mathcal{L}_{\text{BCE}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{BCE}}</annotation></semantics></math> and <math id="S4.SS2.p8.m4" class="ltx_Math" alttext="\mathcal{L}_{\text{rank}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub><annotation encoding="application/x-tex">\mathcal{L}_{\text{rank}}</annotation></semantics></math> provide complementary supervision for entity-level relevance and relative ordering. The additional term <math id="S4.SS2.p8.m5" class="ltx_Math" alttext="\lceil\mathcal{L}_{\text{LIB}}\rceil" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⌈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><mo stretchy="false">⌉</mo></mrow><annotation encoding="application/x-tex">\lceil\mathcal{L}_{\text{LIB}}\rceil</annotation></semantics></math> acts as a structural regularizer that promotes the query-dependent minimal and sufficient subgraphs.
<math id="S4.SS2.p8.m6" class="ltx_Math" alttext="\lceil\mathcal{L}_{\text{LIB}}\rceil" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⌈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><mo stretchy="false">⌉</mo></mrow><annotation encoding="application/x-tex">\lceil\mathcal{L}_{\text{LIB}}\rceil</annotation></semantics></math> is constructed by substituting the RHS of Eq. (<a href="#S4.E15" title="In Proposition 4.3 (Lower Bound of 𝐼(q,𝒢_q)). ‣ 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) and Eq. (<a href="#S4.E17" title="In Proposition 4.4 (Upper Bound of 𝐼(𝒢,𝒢_q)). ‣ 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>) into Eq. (<a href="#S4.E13" title="In 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>):</p>
<table id="S4.E19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(19)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E19.m1" class="ltx_Math" alttext="\left\lceil\mathcal{L}_{\text{LIB}}\right\rceil=\mathcal{L}_{\text{NCE}}+\beta_{\textnormal{1}}\mathcal{L}_{\textnormal{size}}+\beta_{\textnormal{2}}\mathcal{L}_{\textnormal{con}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>⌈</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>LIB</mtext></msub><mo>⌉</mo></mrow><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>NCE</mtext></msub><mo>+</mo><mrow><msub><mi>β</mi><mtext>1</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>size</mtext></msub></mrow><mo>+</mo><mrow><msub><mi>β</mi><mtext>2</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>con</mtext></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lceil\mathcal{L}_{\text{LIB}}\right\rceil=\mathcal{L}_{\text{NCE}}+\beta_{\textnormal{1}}\mathcal{L}_{\textnormal{size}}+\beta_{\textnormal{2}}\mathcal{L}_{\textnormal{con}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="S4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.3. </span>Relation Paths Induced In-context Prompter</h3>

<div id="S4.SS3.p1" class="ltx_para">
<p id="S4.SS3.p1.1" class="ltx_p">Existing methods mainly retrieve relevant documents while leaving relations implicit. To expose key reasoning paths encoded in <math id="S4.SS3.p1.m1" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math>, we treat the retrieved subgraph not only as an entity “coreset” but also as a structured reasoning scaffold for generation.</p>
</div>
<div id="S4.SS3.p2" class="ltx_para">
<p id="S4.SS3.p2.1" class="ltx_p"><span id="S4.SS3.p2.1.1" class="ltx_text ltx_font_bold">Entity-to-Document Mapping.</span>
Following inverted index paradigm <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>, we construct a binary mapping matrix <math id="S4.SS3.p2.m1" class="ltx_Math" alttext="\mathbf{M}\in\{0,1\}^{|\mathcal{E}_{\mathbf{q}}|\times|\mathcal{C}_{\mathbf{q}}|}" display="inline" intent=":literal"><semantics><mrow><mi>𝐌</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐪</mi></msub><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>𝐪</mi></msub><mo stretchy="false">|</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">\mathbf{M}\in\{0,1\}^{|\mathcal{E}_{\mathbf{q}}|\times|\mathcal{C}_{\mathbf{q}}|}</annotation></semantics></math>, where <math id="S4.SS3.p2.m2" class="ltx_Math" alttext="\mathcal{C}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\mathbf{q}}</annotation></semantics></math> denotes the set of supporting document chunks. An entry <math id="S4.SS3.p2.m3" class="ltx_Math" alttext="\mathbf{M}[e,c]=1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>e</mi><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\mathbf{M}[e,c]=1</annotation></semantics></math> indicates that entity <math id="S4.SS3.p2.m4" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> appears in document chunk <math id="S4.SS3.p2.m5" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>.
At inference time, rather than relying on heuristic top-<math id="S4.SS3.p2.m6" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> entity selection, we restrict retrieval to the subgraph entities <math id="S4.SS3.p2.m7" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}</annotation></semantics></math> and assign each entity a composite importance weight defined as:</p>
<table id="S4.E20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(20)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E20.m1" class="ltx_Math" alttext="w_{e}=S_{e}(\mathbf{q})\cdot\frac{1}{\sum_{c}\mathbf{M}[e,c]}\cdot\left|\phi_{\text{path}}(e)\right|," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>w</mi><mi>e</mi></msub><mo>=</mo><mrow><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mrow><msub><mo>∑</mo><mi>c</mi></msub><mrow><mi>𝐌</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>e</mi><mo>,</mo><mi>c</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><msub><mi>ϕ</mi><mtext>path</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">w_{e}=S_{e}(\mathbf{q})\cdot\frac{1}{\sum_{c}\mathbf{M}[e,c]}\cdot\left|\phi_{\text{path}}(e)\right|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p2.2" class="ltx_p">where <math id="S4.SS3.p2.m8" class="ltx_Math" alttext="S_{e}(\mathbf{q})" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>e</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">S_{e}(\mathbf{q})</annotation></semantics></math> denotes the soft selection probability introduced in Eq. (<a href="#S4.E11" title="In 4.2. Label-free IB Optimized Subgraph Selector ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">11</span></a>), and <math id="S4.SS3.p2.m9" class="ltx_Math" alttext="|\phi_{\text{path}}(e)|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><msub><mi>ϕ</mi><mtext>path</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\phi_{\text{path}}(e)|</annotation></semantics></math> represents the number of shortest reasoning paths that involve entity <math id="S4.SS3.p2.m10" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math>. This weighting scheme emphasizes entities that are both highly relevant to the query and structurally central within the reasoning subgraph.
Document relevance is subsequently computed by aggregating entity weights through the mapping matrix, given by <math id="S4.SS3.p2.m11" class="ltx_Math" alttext="R_{c}=\mathbf{M}^{\top}w_{e}" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>c</mi></msub><mo>=</mo><mrow><msup><mi>𝐌</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><mi>e</mi></msub></mrow></mrow><annotation encoding="application/x-tex">R_{c}=\mathbf{M}^{\top}w_{e}</annotation></semantics></math>, and the top-<math id="S4.SS3.p2.m12" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> documents are selected accordingly.</p>
</div>
<div id="S4.SS3.p3" class="ltx_para">
<p id="S4.SS3.p3.1" class="ltx_p"><span id="S4.SS3.p3.1.1" class="ltx_text ltx_font_bold">Reasoning Path Extraction.</span>
Enumerating all possible paths in a dense subgraph is computationally infeasible due to exponential growth in the number of candidate paths. To explicitly expose interpretable relational structures, we extract a compact set of reasoning paths <math id="S4.SS3.p3.m1" class="ltx_Math" alttext="\Pi_{\mathbf{q}}=\{\pi_{1},\ldots,\pi_{l}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Π</mi><mi>𝐪</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>π</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>π</mi><mi>l</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\Pi_{\mathbf{q}}=\{\pi_{1},\ldots,\pi_{l}\}</annotation></semantics></math> from the query-specific subgraph <math id="S4.SS3.p3.m2" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}</annotation></semantics></math> using an <math id="S4.SS3.p3.m3" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>-hop truncated depth-first search (DFS). Each extracted path takes the form <math id="S4.SS3.p3.m4" class="ltx_Math" alttext="\pi=(e_{0}\xrightarrow{r_{1}}e_{1}\xrightarrow{r_{2}}\cdots\xrightarrow{r_{k}}e_{k})" display="inline" intent=":literal"><semantics><mrow><mi>π</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>e</mi><mn>0</mn></msub><mover accent="true"><mo>→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">1</mn></msub></mover><msub><mi>e</mi><mn>1</mn></msub><mover accent="true"><mo rspace="0.1389em">→</mo><msub><mi mathsize="0.700em">r</mi><mn mathsize="0.710em">2</mn></msub></mover><mo lspace="0.1389em" rspace="0.1389em">⋯</mo><mover accent="true"><mo lspace="0.1389em">→</mo><msub><mi mathsize="0.700em">r</mi><mi mathsize="0.710em">k</mi></msub></mover><msub><mi>e</mi><mi>k</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\pi=(e_{0}\xrightarrow{r_{1}}e_{1}\xrightarrow{r_{2}}\cdots\xrightarrow{r_{k}}e_{k})</annotation></semantics></math> with <math id="S4.SS3.p3.m5" class="ltx_Math" alttext="k\leqslant l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>⩽</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k\leqslant l</annotation></semantics></math>.
To quantify the relevance of each reasoning path with respect to relation awareness, we define the following scoring function:</p>
<table id="S4.E21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_left"><span class="ltx_tag ltx_tag_equation ltx_align_left">(21)</span></td>
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E21.m1" class="ltx_Math" alttext="S_{r}(\pi)=\sum_{i=0}^{k}S_{e_{i}}(\mathbf{q})+\sum_{j=1}^{k}\omega(r_{j})," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>S</mi><mi>r</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>0</mn></mrow><mi>k</mi></munderover><mrow><msub><mi>S</mi><msub><mi>e</mi><mi>i</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>k</mi></munderover><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{r}(\pi)=\sum_{i=0}^{k}S_{e_{i}}(\mathbf{q})+\sum_{j=1}^{k}\omega(r_{j}),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S4.SS3.p3.2" class="ltx_p">where <math id="S4.SS3.p3.m6" class="ltx_Math" alttext="\omega(r_{j})" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\omega(r_{j})</annotation></semantics></math> penalizes long-range dependencies via relation depth. This scoring favors paths traversing high-confidence nodes via semantically concise relations.</p>
</div>
<div id="S4.SS3.p4" class="ltx_para">
<p id="S4.SS3.p4.1" class="ltx_p"><span id="S4.SS3.p4.1.1" class="ltx_text ltx_font_bold">In-context Prompter Construction.</span>
To prevent the subgraph from degenerating into an unordered set of documents and entities in the answer generation, we construct an in-context prompter for explicit path-aware LLM reasoning:</p>
</div>
<div id="S4.SS3.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.SS3.p5.pic1" class="ltx_picture" height="194.47" overflow="visible" version="1.1" viewBox="0 0 477.38 194.47" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,194.47) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.91 L 0 189.57 C 0 192.28 2.2 194.47 4.91 194.47 L 472.47 194.47 C 475.18 194.47 477.38 192.28 477.38 189.57 L 477.38 4.91 C 477.38 2.2 475.18 0 472.47 0 L 4.91 0 C 2.2 0 0 2.2 0 4.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.97 4.91 L 0.97 177.39 L 476.41 177.39 L 476.41 4.91 C 476.41 2.73 474.65 0.97 472.47 0.97 L 4.91 0.97 C 2.73 0.97 0.97 2.73 0.97 4.91 Z"></path></g><g style="--ltx-stroke-color:#000000;" fill-opacity="1.0" stroke="#000000" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 72.48 177.39 L 72.48 0.97"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 6.5 181.13)"><foreignObject style="--ltx-fo-width:29.18em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="403.77"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="S4.SS3.p5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:29.18em;">
<span id="S4.SS3.p5.pic1.1.1" class="ltx_p"><span id="S4.SS3.p5.pic1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">Schema    Value</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 6.5 170.47)"><foreignObject style="--ltx-fo-width:33.56em;--ltx-fo-height:0em;--ltx-fo-depth:12.85em;font-size:10pt;" height="177.81" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="464.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.SS3.p5.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_top" style="width:33.56em;">
<span id="S4.SS3.p5.pic1.p1" class="ltx_para ltx_noindent">
<span id="S4.SS3.p5.pic1.p1.1" class="ltx_p"><span id="S4.SS3.p5.pic1.p1.1.1" class="ltx_text" style="position:relative; bottom:-5.0pt;">
<span id="S4.SS3.p5.pic1.p1.1.1.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:42.7pt;">
<span id="S4.SS3.p5.pic1.p1.1.1.1.1" class="ltx_p"><span id="S4.SS3.p5.pic1.p1.1.1.1.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">&lt;system&gt;
<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">&lt;doc&gt;
<br class="ltx_break">&lt;path&gt;
<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">
<br class="ltx_break">&lt;query&gt;<span id="S4.SS3.p5.pic1.p1.1.1.1.1.1.1" class="ltx_text ltx_font_serif">
<span id="S4.SS3.p5.pic1.p1.1.1.1.1.1.1.1" class="ltx_text" style="font-size:111%;">
</span></span></span></span>
</span></span><span id="S4.SS3.p5.pic1.p1.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> </span><span id="S4.SS3.p5.pic1.p1.1.3" class="ltx_text" style="position:relative; bottom:-6.3pt;">
<span id="S4.SS3.p5.pic1.p1.1.3.1" class="ltx_inline-block ltx_minipage ltx_align_top" style="width:282.9pt;">
<span id="S4.SS3.p5.pic1.p1.1.3.1.1" class="ltx_p"><span id="S4.SS3.p5.pic1.p1.1.3.1.1.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">As an advanced reading comprehension assistant, your task is to analyze text passages and corresponding questions meticulously. Your responses start after …
<br class="ltx_break">Document: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.1" class="ltx_verbatim ltx_font_typewriter">{title} \n {content} \n</code>
<br class="ltx_break">Reasoning Path <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.2" class="ltx_verbatim ltx_font_typewriter">{path_id}</code> (score: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.3" class="ltx_verbatim ltx_font_typewriter">{path_score}</code>):<code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.4" class="ltx_verbatim ltx_font_typewriter"> \n</code>
<br class="ltx_break"><code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.5" class="ltx_verbatim ltx_font_typewriter">    </code>Entity <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.6" class="ltx_verbatim ltx_font_typewriter">{entity}</code> (type: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.7" class="ltx_verbatim ltx_font_typewriter">{entity_type}</code>):<code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.8" class="ltx_verbatim ltx_font_typewriter"> \n</code>
<br class="ltx_break"><code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.9" class="ltx_verbatim ltx_font_typewriter">        ---</code> (relation: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.10" class="ltx_verbatim ltx_font_typewriter">{relation}</code>) <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.11" class="ltx_verbatim ltx_font_typewriter">---&gt; \n</code>
<br class="ltx_break"><code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.12" class="ltx_verbatim ltx_font_typewriter">    </code>Entity <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.13" class="ltx_verbatim ltx_font_typewriter">{entity}</code> (type: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.14" class="ltx_verbatim ltx_font_typewriter">{entity_type}</code>):<code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.15" class="ltx_verbatim ltx_font_typewriter"> \n</code>
<br class="ltx_break"><code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.16" class="ltx_verbatim ltx_font_typewriter">        ---</code> (relation: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.17" class="ltx_verbatim ltx_font_typewriter">{relation}</code>) <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.18" class="ltx_verbatim ltx_font_typewriter">---&gt; \n</code>
<br class="ltx_break"><code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.19" class="ltx_verbatim ltx_font_typewriter">    </code>Entity <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.20" class="ltx_verbatim ltx_font_typewriter">{entity}</code> (type: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.21" class="ltx_verbatim ltx_font_typewriter">{entity_type}</code>):<code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.22" class="ltx_verbatim ltx_font_typewriter"> \n</code>
<br class="ltx_break">Question: <code id="S4.SS3.p5.pic1.p1.1.3.1.1.1.23" class="ltx_verbatim ltx_font_typewriter">{query} \n</code>
<span id="S4.SS3.p5.pic1.p1.1.3.1.1.1.24" class="ltx_text"></span></span></span>
</span></span></span>
</span></span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="S4.SS3.p6" class="ltx_para">
<p id="S4.SS3.p6.1" class="ltx_p">We provide the detailed in-context prompter configurations and case studies in Appendix <a href="#A4.SS3" title="D.3. Experimental Setting Details ‣ Appendix D Experiment Details ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a>.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
</section>
<section id="S5" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">5. </span>Experiments</h2>

<div id="S5.p1" class="ltx_para">
<p id="S5.p1.1" class="ltx_p">In this section, we conduct extensive experiments to evaluate <span id="S5.p1.1.1" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever<span id="footnote1" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">1</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">1</sup>
            <span class="ltx_tag ltx_tag_note">1</span>
            
            
            
          Codes will be made public after the paper is formally published.</span></span></span> on the following research questions (<span id="S5.p1.1.2" class="ltx_text ltx_font_bold ltx_font_italic">RQ<span id="S5.p1.1.2.1" class="ltx_text ltx_font_medium">s</span></span>):</p>
<ul id="S5.I1" class="ltx_itemize ltx_leftmargin_flush">
<li id="S5.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i1.p1" class="ltx_para">
<p id="S5.I1.i1.p1.1" class="ltx_p"><span id="S5.I1.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ1:</span> Can <span id="S5.I1.i1.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever improve retrieval performance?</p>
</div></li>
<li id="S5.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i2.p1" class="ltx_para">
<p id="S5.I1.i2.p1.1" class="ltx_p"><span id="S5.I1.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ2:</span> How does <span id="S5.I1.i2.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever perform in QA task?</p>
</div></li>
<li id="S5.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i3.p1" class="ltx_para">
<p id="S5.I1.i3.p1.1" class="ltx_p"><span id="S5.I1.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ3:</span> Can <span id="S5.I1.i3.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever generalize across different domains?</p>
</div></li>
<li id="S5.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i4.p1" class="ltx_para">
<p id="S5.I1.i4.p1.1" class="ltx_p"><span id="S5.I1.i4.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ4:</span> Is <span id="S5.I1.i4.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever more time-efficient and effective?</p>
</div></li>
<li id="S5.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i5.p1" class="ltx_para">
<p id="S5.I1.i5.p1.1" class="ltx_p"><span id="S5.I1.i5.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ5:</span> How do the subgraphs support multi-hop QA reasoning?</p>
</div></li>
<li id="S5.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I1.i6.p1" class="ltx_para">
<p id="S5.I1.i6.p1.1" class="ltx_p"><span id="S5.I1.i6.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">RQ6:</span> How does each component and hyper-parameter affect the overall performance of <span id="S5.I1.i6.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever?</p>
</div></li>
</ul>
</div>
<section id="S5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.1. </span>Experiment Settings</h3>

<div id="S5.SS1.p1" class="ltx_para">
<p id="S5.SS1.p1.1" class="ltx_p">We introduce the brief experiment settings of datasets, baselines, and metrics. Detailed settings are provided in Appendix <a href="#A4" title="Appendix D Experiment Details ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D</span></a>.</p>
</div>
<div id="S5.SS1.p2" class="ltx_para">
<p id="S5.SS1.p2.1" class="ltx_p"><span id="S5.SS1.p2.1.1" class="ltx_text ltx_font_bold">Datasets.</span>
Main experiments are conducted on the <span id="S5.SS1.p2.1.2" class="ltx_text ltx_font_bold">three</span> representative multi-hop question answering benchmarks: <span id="S5.SS1.p2.1.3" class="ltx_text ltx_font_typewriter">HotpotQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib90" title="" class="ltx_ref">Yang et al., 2018b</a>)</cite>, <span id="S5.SS1.p2.1.4" class="ltx_text ltx_font_typewriter">MuSiQue</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib91" title="" class="ltx_ref">Trivedi et al., 2022</a>)</cite>, and <span id="S5.SS1.p2.1.5" class="ltx_text ltx_font_typewriter">2WikiMultiHopQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib92" title="" class="ltx_ref">Ho et al., 2020</a>)</cite>, which are widely adopted to assess multi-hop retrieving and reasoning capabilities, covering diverse domains and complex inference patterns.
To further evaluate the generalizability of <span id="S5.SS1.p2.1.6" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever across different domains, we further incorporate <span id="S5.SS1.p2.1.7" class="ltx_text ltx_font_bold">seven</span> benchmarks, including <span id="S5.SS1.p2.1.8" class="ltx_text ltx_font_typewriter">PubMedQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib110" title="" class="ltx_ref">Jin et al., 2019</a>)</cite>, <span id="S5.SS1.p2.1.9" class="ltx_text ltx_font_typewriter">DelucionQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib111" title="" class="ltx_ref">Sadat et al., 2023</a>)</cite>, <span id="S5.SS1.p2.1.10" class="ltx_text ltx_font_typewriter">TechQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib112" title="" class="ltx_ref">Castelli et al., 2020</a>)</cite>, <span id="S5.SS1.p2.1.11" class="ltx_text ltx_font_typewriter">ExpertQA</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib113" title="" class="ltx_ref">Malaviya et al., 2024</a>)</cite>, <span id="S5.SS1.p2.1.12" class="ltx_text ltx_font_typewriter">EManual</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib114" title="" class="ltx_ref">Nandy et al., 2021</a>)</cite>, <span id="S5.SS1.p2.1.13" class="ltx_text ltx_font_typewriter">MS Marco</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib115" title="" class="ltx_ref">Nguyen et al., 2016</a>)</cite>, and <span id="S5.SS1.p2.1.14" class="ltx_text ltx_font_typewriter">HAGRID</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib116" title="" class="ltx_ref">Kamalloo et al., 2023</a>)</cite>.
Statistics in Table <a href="#A4.T1" title="Table D.1 ‣ C.4. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a> and Table <a href="#A4.T2" title="Table D.2 ‣ C.4. Proof of Proposition ‣ Appendix C Proofs ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>.</p>
</div>
<div id="S5.SS1.p3" class="ltx_para">
<p id="S5.SS1.p3.1" class="ltx_p"><span id="S5.SS1.p3.1.1" class="ltx_text ltx_font_bold">Baselines.</span>
We compare <span id="S5.SS1.p3.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever against <span id="S5.SS1.p3.1.3" class="ltx_text ltx_font_bold">18</span> state-of-the-art baselines (and their combinations), categorized into <span id="S5.SS1.p3.1.4" class="ltx_text ltx_font_bold">four</span> groups:</p>
<ul id="S5.I2" class="ltx_itemize ltx_leftmargin_flush">
<li id="S5.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i1.p1" class="ltx_para">
<p id="S5.I2.i1.p1.1" class="ltx_p"><span id="S5.I2.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Base LLM:</span> <span id="S5.I2.i1.p1.1.2" class="ltx_text ltx_font_typewriter">GPT-4o-mini</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib93" title="" class="ltx_ref">Hurst et al., 2024</a>)</cite>.</p>
</div></li>
<li id="S5.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i2.p1" class="ltx_para">
<p id="S5.I2.i2.p1.1" class="ltx_p"><span id="S5.I2.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Single-step RAGs:</span> including <span id="S5.I2.i2.p1.1.2" class="ltx_text ltx_font_typewriter">BM25</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib94" title="" class="ltx_ref">Robertson and Walker, 1994</a>)</cite>, <span id="S5.I2.i2.p1.1.3" class="ltx_text ltx_font_typewriter">Contriever</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib95" title="" class="ltx_ref">Izacard et al., 2022</a>)</cite>, <span id="S5.I2.i2.p1.1.4" class="ltx_text ltx_font_typewriter">GTR</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib96" title="" class="ltx_ref">Ni et al., 2022</a>)</cite>, <span id="S5.I2.i2.p1.1.5" class="ltx_text ltx_font_typewriter">ColBERTv2</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib97" title="" class="ltx_ref">Santhanam et al., 2022</a>)</cite>, <span id="S5.I2.i2.p1.1.6" class="ltx_text ltx_font_typewriter">RAPTOR</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib98" title="" class="ltx_ref">Sarthi et al., 2024</a>)</cite>, and <span id="S5.I2.i2.p1.1.7" class="ltx_text ltx_font_typewriter">Proposition</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib99" title="" class="ltx_ref">Chen et al., 2024</a>)</cite>.</p>
</div></li>
<li id="S5.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i3.p1" class="ltx_para">
<p id="S5.I2.i3.p1.1" class="ltx_p"><span id="S5.I2.i3.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Graph-enhanced RAGs:</span> including <span id="S5.I2.i3.p1.1.2" class="ltx_text ltx_font_typewriter">GraphRAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib100" title="" class="ltx_ref">Edge et al., 2024</a>)</cite>, <span id="S5.I2.i3.p1.1.3" class="ltx_text ltx_font_typewriter">G-Retriever</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib101" title="" class="ltx_ref">He et al., 2024</a>)</cite>, <span id="S5.I2.i3.p1.1.4" class="ltx_text ltx_font_typewriter">LightRAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib102" title="" class="ltx_ref">Guo et al., 2024</a>)</cite>, <span id="S5.I2.i3.p1.1.5" class="ltx_text ltx_font_typewriter">HippoRAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib103" title="" class="ltx_ref">Gutiérrez et al., 2024</a>)</cite>, <span id="S5.I2.i3.p1.1.6" class="ltx_text ltx_font_typewriter">HippoRAG</span> <span id="S5.I2.i3.p1.1.7" class="ltx_text ltx_font_typewriter">2</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib104" title="" class="ltx_ref">Gutiérrez et al., 2025</a>)</cite>, <span id="S5.I2.i3.p1.1.8" class="ltx_text ltx_font_typewriter">SubgraphRAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib62" title="" class="ltx_ref">Li et al., 2025b</a>)</cite>, <span id="S5.I2.i3.p1.1.9" class="ltx_text ltx_font_typewriter">PropRAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib105" title="" class="ltx_ref">Wang and Han, 2025</a>)</cite>, and the most relevant <span id="S5.I2.i3.p1.1.10" class="ltx_text ltx_font_typewriter">GFM-RAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>.</p>
</div></li>
<li id="S5.I2.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S5.I2.i4.p1" class="ltx_para">
<p id="S5.I2.i4.p1.1" class="ltx_p"><span id="S5.I2.i4.p1.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Multi-step RAGs:</span> <span id="S5.I2.i4.p1.1.2" class="ltx_text ltx_font_typewriter">IRCoT</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib108" title="" class="ltx_ref">Trivedi et al., 2023</a>)</cite>, <span id="S5.I2.i4.p1.1.3" class="ltx_text ltx_font_typewriter">FLARE</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib107" title="" class="ltx_ref">Jiang et al., 2023</a>)</cite>, <span id="S5.I2.i4.p1.1.4" class="ltx_text ltx_font_typewriter">Adaptive-RAG</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib106" title="" class="ltx_ref">Jeong et al., 2024</a>)</cite>.</p>
</div></li>
</ul>
<p id="S5.SS1.p3.2" class="ltx_p">Notably, <span id="S5.SS1.p3.2.1" class="ltx_text ltx_font_typewriter">IRCoT</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib108" title="" class="ltx_ref">Trivedi et al., 2023</a>)</cite> serves as a general multi-step reasoning wrapper that can be combined with non-iterative retrievers, enabling single-step RAG and graph-based methods to perform multi-hop reasoning via interleaved retrieval and generation. We make a thorough comparison for all baselines and <span id="S5.SS1.p3.2.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever in Table <a href="#A4.T1a" title="Table D.1 ‣ D.2. Baseline Details ‣ Appendix D Experiment Details ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>.</p>
</div>
<div id="S5.SS1.p4" class="ltx_para">
<p id="S5.SS1.p4.1" class="ltx_p"><span id="S5.SS1.p4.1.1" class="ltx_text ltx_font_bold">Metrics.</span>
To assess the retrieval quality, we report Recall@2 and Recall@5 for both the retrieved entities and documents (R@2/5<math id="S5.SS1.p4.m1" class="ltx_Math" alttext="{}_{\textsf{E}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">E</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{E}}</annotation></semantics></math>, R@2/5<math id="S5.SS1.p4.m2" class="ltx_Math" alttext="{}_{\textsf{D}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">D</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{D}}</annotation></semantics></math>).
In addition, we report Mean Reciprocal Rank (MRR) in selected retrieval experiments to further reflect ranking quality.
For end-to-end QA, we adopt standard metrics, including Exact Match (EM), F1 score, Precision (P), and Recall (R) in main experiments, which thoroughly analyze the answer coverage and correctness <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib103" title="" class="ltx_ref">Gutiérrez et al., 2024</a>)</cite>. We additionally report ROUGE-L in some cases to assess semantic overlap between generated answers and references.</p>
</div>
<div id="S5.SS1.p5" class="ltx_para">
<p id="S5.SS1.p5.1" class="ltx_p"><span id="S5.SS1.p5.1.1" class="ltx_text ltx_font_bold">Implementation Details.</span>
The retriever backbone is a 6-layer query-conditioned GNN with a hidden dimension of 512, initialized using <span id="S5.SS1.p5.1.2" class="ltx_text ltx_font_typewriter">all-mpnet-v2</span> sentence encoder <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib109" title="" class="ltx_ref">SBERT, 2021</a>)</cite>. Pre-training is conducted on a large-scale corpus of 700K documents, from which 60 domain-specific knowledge graphs comprising over 14M triples are constructed <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Luo et al., 2025</a>)</cite>. The model is trained on 8 NVIDIA A100 GPUs (80GB) with a batch size of 4. Additional hyper-parameters and implementation details are reported in Appendix <a href="#A5.SS1" title="E.1. Implementation Details of Gfm-Retriever ‣ Appendix E Implementation Details ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">E.1</span></a>.</p>
</div>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2. </span><span id="S5.SS2.2" class="ltx_text ltx_font_italic">RQ1:</span> Entity Retrieval Performance</h3>

<div id="S5.SS2.p1" class="ltx_para">
<p id="S5.SS2.p1.1" class="ltx_p">We evaluate entity-level and document-level retrieval performance on standard multi-hop QA benchmarks.</p>
</div>
<div id="S5.SS2.p2" class="ltx_para">
<p id="S5.SS2.p2.1" class="ltx_p"><span id="S5.SS2.p2.1.1" class="ltx_text ltx_font_bold">Results.</span>
As shown in Table <a href="#S5.T1" title="Table 1 ‣ 5.4. RQ3: Cross-domain Generalizability ‣ 5. Experiments ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, <span id="S5.SS2.p2.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever consistently outperforms all baselines across most metrics, achieving the highest average rank. It ranks first on R@2<math id="S5.SS2.p2.m1" class="ltx_Math" alttext="{}_{\textsf{E}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">E</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{E}}</annotation></semantics></math> and R@5<math id="S5.SS2.p2.m2" class="ltx_Math" alttext="{}_{\textsf{E}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">E</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{E}}</annotation></semantics></math> scores, which validate the effectiveness of the subgraph selector in extracting the compact yet informative entity sets, and reveal the cross-domain generalizability that the GFM retriever provides. In contrast, dense retrievers such as <span id="S5.SS2.p2.1.3" class="ltx_text ltx_font_typewriter">Contriever</span> and <span id="S5.SS2.p2.1.4" class="ltx_text ltx_font_typewriter">GTR</span> ignore the inter-entity structure, while graph-based methods like <span id="S5.SS2.p2.1.5" class="ltx_text ltx_font_typewriter">GraphRAG</span> and <span id="S5.SS2.p2.1.6" class="ltx_text ltx_font_typewriter">G-Retriever</span> tend to over-select irrelevant neighbors. <span id="S5.SS2.p2.1.7" class="ltx_text ltx_font_typewriter">SubgraphRAG</span> and <span id="S5.SS2.p2.1.8" class="ltx_text ltx_font_typewriter">GFM-RAG</span> leverage graph structure but lack query-specific filtering. <span id="S5.SS2.p2.1.9" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever improves the aforementioned drawbacks by jointly modeling semantic relevance and structural minimality.</p>
</div>
</section>
<section id="S5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.3. </span><span id="S5.SS3.2" class="ltx_text ltx_font_italic">RQ2:</span> Question Answering Performance</h3>

<div id="S5.SS3.p1" class="ltx_para">
<p id="S5.SS3.p1.1" class="ltx_p">We evaluate the end-to-end multi-hop QA by feeding the retrieved evidence into the same base LLM.</p>
</div>
<div id="S5.SS3.p2" class="ltx_para">
<p id="S5.SS3.p2.1" class="ltx_p"><span id="S5.SS3.p2.1.1" class="ltx_text ltx_font_bold">Results.</span>
As shown in Table <a href="#S5.T2" title="Table 2 ‣ 5.4. RQ3: Cross-domain Generalizability ‣ 5. Experiments ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, our <span id="S5.SS3.p2.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever already shows strong single-step QA capability, outperforming most single-step baselines and surpassing several multi-step methods, which indicates retrieving a minimal yet sufficient subgraph provides informative evidence for multi-hop answering even without iterative retrieval. When augmented with <span id="S5.SS3.p2.1.3" class="ltx_text ltx_font_typewriter">IRCoT</span>, <span id="S5.SS3.p2.1.4" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever achieves the best overall performance with consistent gains across datasets and metrics, suggesting that multi-step reasoning benefits substantially from structured evidence. The comparison between the <span id="S5.SS3.p2.1.5" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever and <span id="S5.SS3.p2.1.6" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever+<span id="S5.SS3.p2.1.7" class="ltx_text ltx_font_typewriter">IRCoT</span> further reveals that subgraph complements iterative reasoning: it provides a compact reasoning scaffold, while <span id="S5.SS3.p2.1.8" class="ltx_text ltx_font_typewriter">IRCoT</span> refines evidence selection step by step, leading to higher answer coverage (Recall) without sacrificing correctness (Precision). Overall, the results confirm that our subgraph-centric retrieval is effective as a standalone single-step QA method and serves as a strong substrate for multi-step reasoning frameworks.</p>
</div>
</section>
<section id="S5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.4. </span><span id="S5.SS4.2" class="ltx_text ltx_font_italic">RQ3:</span> Cross-domain Generalizability</h3>

<div id="S5.SS4.p1" class="ltx_para">
<p id="S5.SS4.p1.1" class="ltx_p">We evaluate cross-domain generalization on <span id="S5.SS4.p1.1.1" class="ltx_text ltx_font_bold">seven</span> QA datasets spanning biomedical, customer support, and general knowledge domains, all disjoint from pre-training. <span id="S5.SS4.p1.1.2" class="ltx_text ltx_font_smallcaps">Gfm</span>-Retriever is compared with <span id="S5.SS4.p1.1.3" class="ltx_text ltx_font_bold">three</span> strong baselines identified in <span id="S5.SS4.p1.1.4" class="ltx_text ltx_font_bold ltx_font_italic">RQ1</span> and <span id="S5.SS4.p1.1.5" class="ltx_text ltx_font_bold ltx_font_italic">RQ2</span>. We report retrieval performance in R@5<math id="S5.SS4.p1.m1" class="ltx_Math" alttext="{}_{\textsf{D}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">D</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{D}}</annotation></semantics></math> on all datasets and QA performance in ROUGE-L on three datasets that support answer generation, under a zero-shot setting without domain-specific fine-tuning.</p>
</div>
<figure id="S5.T1" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 1. </span>Results of retrieval performance. We report Recall (%) at top-2 and top-5 for both entity-level (R@2<math id="S5.T1.m5" class="ltx_Math" alttext="{}_{\textsf{E}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">E</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{E}}</annotation></semantics></math>, R@5<math id="S5.T1.m6" class="ltx_Math" alttext="{}_{\textsf{E}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">E</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{E}}</annotation></semantics></math>) and document-level (R@2<math id="S5.T1.m7" class="ltx_Math" alttext="{}_{\textsf{D}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">D</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{D}}</annotation></semantics></math>, R@5<math id="S5.T1.m8" class="ltx_Math" alttext="{}_{\textsf{D}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_sans-serif">D</mtext></msub><annotation encoding="application/x-tex">{}_{\textsf{D}}</annotation></semantics></math>). Best results are in <span id="S5.T1.4" class="ltx_text ltx_font_bold">bold</span> and runner-ups are <span id="S5.T1.5" class="ltx_text ltx_underline">underlined</span>. The darker the cell, the better.</figcaption>
<div id="S5.T1.6" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:100.8pt;vertical-align:-49.5pt;"><span class="ltx_transformed_inner" style="transform:translate(-304.8pt,89.0pt) scale(0.361400540261353,0.361400540261353) ;">
<table id="S5.T1.6.1" class="ltx_tabular ltx_align_middle">
