<td id="A4.T2.2.1.11.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">1,975</td>
<td id="A4.T2.2.1.11.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">23,484</td>
