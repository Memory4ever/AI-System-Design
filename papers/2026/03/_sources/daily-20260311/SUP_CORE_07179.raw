</div>
<div id="algorithm1.4.13" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.13.1" class="ltx_text ltx_font_bold">10</span></span>
          Predict entity relevance <math id="algorithm1.m22" class="ltx_Math" alttext="\mathbb{P}_{\mathbf{q}}(e)\leftarrow" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ℙ</mi><mi>𝐪</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbb{P}_{\mathbf{q}}(e)\leftarrow</annotation></semantics></math> Eq. (<a href="#S4.E4" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>);
</div>
<div id="algorithm1.4.14" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.14.1" class="ltx_text ltx_font_bold">11</span></span>
          Loss: <math id="algorithm1.m23" class="ltx_Math" alttext="\mathcal{L}_{\text{BCE}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{BCE}}\leftarrow</annotation></semantics></math> Eq. (<a href="#S4.E5" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>), <math id="algorithm1.m24" class="ltx_Math" alttext="\mathcal{L}_{\text{rank}}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{rank}}\leftarrow</annotation></semantics></math> Eq. (<a href="#S4.E6" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>);
</div>
<div id="algorithm1.4.15" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.15.1" class="ltx_text ltx_font_bold">12</span></span>
          <math id="algorithm1.m25" class="ltx_Math" alttext="\mathcal{L}_{\text{Phase I}}=\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>Phase I</mtext></msub><mo>=</mo><mrow><mrow><msub><mi>α</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>BCE</mtext></msub></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mn>1</mn></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mtext>rank</mtext></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\text{Phase I}}=\alpha_{1}\mathcal{L}_{\text{BCE}}+(1-\alpha_{1})\mathcal{L}_{\text{rank}}</annotation></semantics></math> (Eq. (<a href="#S4.E9" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>));
</div>
