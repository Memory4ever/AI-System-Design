<td id="A4.T2.2.1.10.7" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;">63,995</td></tr>
<tr id="A4.T2.2.1.11" class="ltx_tr">
<td id="A4.T2.2.1.11.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A4.T2.2.1.11.1.1" class="ltx_text ltx_font_typewriter">HAGRID</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib116" title="" class="ltx_ref">Kamalloo et al., 2023</a>)</cite></td>
<td id="A4.T2.2.1.11.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:5.0pt;padding-right:5.0pt;">General Knowledge</td>
