          <span id="algorithm1.4.6.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.6.3" class="ltx_emph ltx_font_italic">each triple <math id="algorithm1.m13" class="ltx_Math" alttext="(e,r,?)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>e</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi mathvariant="normal">?</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(e,r,?)</annotation></semantics></math> or <math id="algorithm1.m14" class="ltx_Math" alttext="(?,r,e)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">?</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>e</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(?,r,e)</annotation></semantics></math> sampled from <math id="algorithm1.m15" class="ltx_Math" alttext="\mathcal{G}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒢</mi><annotation encoding="application/x-tex">\mathcal{G}</annotation></semantics></math></em> <span id="algorithm1.4.6.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.7" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.7.1" class="ltx_text ltx_font_bold">4</span></span>
