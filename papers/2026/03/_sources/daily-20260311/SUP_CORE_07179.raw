<span id="S5.T2.6.1.22.11.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:3.8pt;height:4.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-0.6pt,0.8pt) scale(0.8,0.8) ;">
