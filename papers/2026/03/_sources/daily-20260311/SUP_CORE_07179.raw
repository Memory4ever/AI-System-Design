<span id="S5.T2.6.1.22.13.1.1" class="ltx_inline-block ltx_transformed_outer" style="width:4.3pt;height:4.8pt;vertical-align:-0.0pt;"><span class="ltx_transformed_inner" style="transform:translate(-0.7pt,0.8pt) scale(0.8,0.8) ;">
