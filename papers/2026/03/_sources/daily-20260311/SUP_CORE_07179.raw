<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Notations</h2>

<div id="A1.p1" class="ltx_para ltx_minipage" style="width:345.0pt;">
<div id="A1.p1.1" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:293.3pt;height:332.5pt;vertical-align:-164.8pt;"><span class="ltx_transformed_inner" style="transform:translate(-104.1pt,118.0pt) scale(0.584761046028531,0.584761046028531) ;">
<table id="A1.p1.1.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.p1.1.1.1" class="ltx_tr">
<td id="A1.p1.1.1.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.p1.1.1.1.1.1" class="ltx_text ltx_font_bold">Notations</span></td>
<td id="A1.p1.1.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="A1.p1.1.1.1.2.1" class="ltx_text ltx_font_bold">Descriptions</span></td></tr>
<tr id="A1.p1.1.1.2" class="ltx_tr">
<td id="A1.p1.1.1.2.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="A1.p1.1.1.2.1.1" class="ltx_text ltx_font_italic">Knowledge Graph and Corpus</span></td></tr>
<tr id="A1.p1.1.1.3" class="ltx_tr">
<td id="A1.p1.1.1.3.1" class="ltx_td ltx_align_left"><math id="A1.m1" class="ltx_Math" alttext="\mathcal{G}=(\mathcal{V},\mathcal{R},\mathcal{E})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℛ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}=(\mathcal{V},\mathcal{R},\mathcal{E})</annotation></semantics></math></td>
<td id="A1.p1.1.1.3.2" class="ltx_td ltx_align_left">Knowledge graph with entity set <math id="A1.m2" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math>, relation set <math id="A1.m3" class="ltx_Math" alttext="\mathcal{R}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℛ</mi><annotation encoding="application/x-tex">\mathcal{R}</annotation></semantics></math>, and triple set <math id="A1.m4" class="ltx_Math" alttext="\mathcal{E}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℰ</mi><annotation encoding="application/x-tex">\mathcal{E}</annotation></semantics></math>.</td></tr>
<tr id="A1.p1.1.1.4" class="ltx_tr">
<td id="A1.p1.1.1.4.1" class="ltx_td ltx_align_left"><math id="A1.m5" class="ltx_Math" alttext="(u,r,v)\in\mathcal{E}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>r</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℰ</mi></mrow><annotation encoding="application/x-tex">(u,r,v)\in\mathcal{E}</annotation></semantics></math></td>
<td id="A1.p1.1.1.4.2" class="ltx_td ltx_align_left">Relational triple from entity <math id="A1.m6" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> to <math id="A1.m7" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> via relation <math id="A1.m8" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math>.</td></tr>
<tr id="A1.p1.1.1.5" class="ltx_tr">
<td id="A1.p1.1.1.5.1" class="ltx_td ltx_align_left"><math id="A1.m9" class="ltx_Math" alttext="\{\mathcal{D}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\mathcal{D}\}</annotation></semantics></math>, <math id="A1.m10" class="ltx_Math" alttext="d\in{\mathcal{D}}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">d\in{\mathcal{D}}</annotation></semantics></math></td>
<td id="A1.p1.1.1.5.2" class="ltx_td ltx_align_left">Set of knowledge domains and a domain identifier.</td></tr>
<tr id="A1.p1.1.1.6" class="ltx_tr">
<td id="A1.p1.1.1.6.1" class="ltx_td ltx_align_left"><math id="A1.m11" class="ltx_Math" alttext="\operatorname{Dom}_{d}(e)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Dom</mi><mi>d</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\operatorname{Dom}_{d}(e)</annotation></semantics></math></td>
<td id="A1.p1.1.1.6.2" class="ltx_td ltx_align_left">Predicate indicating entity <math id="A1.m12" class="ltx_Math" alttext="e" display="inline" intent=":literal"><semantics><mi>e</mi><annotation encoding="application/x-tex">e</annotation></semantics></math> belongs to domain <math id="A1.m13" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math>.</td></tr>
<tr id="A1.p1.1.1.7" class="ltx_tr">
<td id="A1.p1.1.1.7.1" class="ltx_td ltx_align_left"><math id="A1.m14" class="ltx_Math" alttext="\mathcal{C}=\{c_{i}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}=\{c_{i}\}</annotation></semantics></math></td>
<td id="A1.p1.1.1.7.2" class="ltx_td ltx_align_left">Corpus of document chunks.</td></tr>
<tr id="A1.p1.1.1.8" class="ltx_tr">
<td id="A1.p1.1.1.8.1" class="ltx_td ltx_align_left"><math id="A1.m15" class="ltx_Math" alttext="\phi(c_{i}),\ \phi^{-1}(e)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.667em">,</mo><mrow><msup><mi>ϕ</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>e</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\phi(c_{i}),\ \phi^{-1}(e)</annotation></semantics></math></td>
<td id="A1.p1.1.1.8.2" class="ltx_td ltx_align_left">Mapping between document chunks and mentioned entities.</td></tr>
<tr id="A1.p1.1.1.9" class="ltx_tr">
<td id="A1.p1.1.1.9.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="A1.p1.1.1.9.1.1" class="ltx_text ltx_font_italic">Query, Answer, and RAG Interface</span></td></tr>
<tr id="A1.p1.1.1.10" class="ltx_tr">
<td id="A1.p1.1.1.10.1" class="ltx_td ltx_align_left"><math id="A1.m16" class="ltx_Math" alttext="\mathbf{q}" display="inline" intent=":literal"><semantics><mi>𝐪</mi><annotation encoding="application/x-tex">\mathbf{q}</annotation></semantics></math>, <math id="A1.m17" class="ltx_Math" alttext="{\mathcal{V}\mid\mathbf{q}}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo fence="false">|</mo><mi>𝐪</mi></mrow><annotation encoding="application/x-tex">{\mathcal{V}\mid\mathbf{q}}</annotation></semantics></math></td>
<td id="A1.p1.1.1.10.2" class="ltx_td ltx_align_left">Input query, and entities explicitly mentioned in the query.</td></tr>
<tr id="A1.p1.1.1.11" class="ltx_tr">
<td id="A1.p1.1.1.11.1" class="ltx_td ltx_align_left"><math id="A1.m18" class="ltx_Math" alttext="\mathrm{LLM}(\mathbf{q},\mathcal{G}_{\mathbf{q}},\mathcal{C}_{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><mi>LLM</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐪</mi><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{LLM}(\mathbf{q},\mathcal{G}_{\mathbf{q}},\mathcal{C}_{\mathbf{q}})</annotation></semantics></math>, <math id="A1.m19" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math></td>
<td id="A1.p1.1.1.11.2" class="ltx_td ltx_align_left">The answer generator, and the generated answer.</td></tr>
<tr id="A1.p1.1.1.12" class="ltx_tr">
<td id="A1.p1.1.1.12.1" class="ltx_td ltx_align_left"><math id="A1.m20" class="ltx_Math" alttext="\mathcal{C}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{C}_{\mathbf{q}}</annotation></semantics></math></td>
<td id="A1.p1.1.1.12.2" class="ltx_td ltx_align_left">Supporting documents induced by retrieved entities.</td></tr>
<tr id="A1.p1.1.1.13" class="ltx_tr">
<td id="A1.p1.1.1.13.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="A1.p1.1.1.13.1.1" class="ltx_text ltx_font_italic">Subgraph Retrieval</span></td></tr>
<tr id="A1.p1.1.1.14" class="ltx_tr">
<td id="A1.p1.1.1.14.1" class="ltx_td ltx_align_left"><math id="A1.m21" class="ltx_Math" alttext="\mathcal{G}_{\mathbf{q}}=(\mathcal{V}_{\mathbf{q}},\mathcal{R}_{\mathbf{q}},\mathcal{E}_{\mathbf{q}})" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mi>𝐪</mi></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>𝐪</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐪</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{\mathbf{q}}=(\mathcal{V}_{\mathbf{q}},\mathcal{R}_{\mathbf{q}},\mathcal{E}_{\mathbf{q}})</annotation></semantics></math></td>
<td id="A1.p1.1.1.14.2" class="ltx_td ltx_align_left">Query-specific retrieved subgraph.</td></tr>
<tr id="A1.p1.1.1.15" class="ltx_tr">
<td id="A1.p1.1.1.15.1" class="ltx_td ltx_align_left"><math id="A1.m22" class="ltx_Math" alttext="\mathcal{V}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{V}_{\mathbf{q}}</annotation></semantics></math>, <math id="A1.m23" class="ltx_Math" alttext="\mathcal{R}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℛ</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{R}_{\mathbf{q}}</annotation></semantics></math>, <math id="A1.m24" class="ltx_Math" alttext="\mathcal{E}_{\mathbf{q}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>𝐪</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathbf{q}}</annotation></semantics></math></td>
<td id="A1.p1.1.1.15.2" class="ltx_td ltx_align_left">Entity, relation, and edge sets of the retrieved subgraph.</td></tr>
<tr id="A1.p1.1.1.16" class="ltx_tr">
<td id="A1.p1.1.1.16.1" class="ltx_td ltx_align_left ltx_border_t" colspan="2"><span id="A1.p1.1.1.16.1.1" class="ltx_text ltx_font_italic">Graph Foundation Model (GFM)</span></td></tr>
<tr id="A1.p1.1.1.17" class="ltx_tr">
<td id="A1.p1.1.1.17.1" class="ltx_td ltx_align_left"><math id="A1.m25" class="ltx_Math" alttext="f_{\bm{\theta}}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>𝜽</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}(\cdot)</annotation></semantics></math>, <math id="A1.m26" class="ltx_Math" alttext="f_{\bm{\theta}}^{\star}(\cdot)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>f</mi><mi>𝜽</mi><mo>⋆</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\bm{\theta}}^{\star}(\cdot)</annotation></semantics></math>, <math id="A1.m27" class="ltx_Math" alttext="\bm{\theta}" display="inline" intent=":literal"><semantics><mi>𝜽</mi><annotation encoding="application/x-tex">\bm{\theta}</annotation></semantics></math></td>
<td id="A1.p1.1.1.17.2" class="ltx_td ltx_align_left">The graph foundation model and its pre-trained variant with parameters.</td></tr>
<tr id="A1.p1.1.1.18" class="ltx_tr">
<td id="A1.p1.1.1.18.1" class="ltx_td ltx_align_left"><math id="A1.m28" class="ltx_Math" alttext="\mathbf{Z}_{e}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐙</mi><mi>e</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{Z}_{e}^{(l)}</annotation></semantics></math>, <math id="A1.m29" class="ltx_Math" alttext="\mathbf{Z}_{r}^{(l)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐙</mi><mi>r</mi><mrow><mo stretchy="false">(</mo><mi>l</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{Z}_{r}^{(l)}</annotation></semantics></math></td>
<td id="A1.p1.1.1.18.2" class="ltx_td ltx_align_left">Entity and relation embeddings at the GFM layer <math id="A1.m30" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.</td></tr>
<tr id="A1.p1.1.1.19" class="ltx_tr">
<td id="A1.p1.1.1.19.1" class="ltx_td ltx_align_left"><math id="A1.m31" class="ltx_Math" alttext="\mathcal{N}(v)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(v)</annotation></semantics></math>, <math id="A1.m32" class="ltx_Math" alttext="\mathbf{m}_{v}^{(l+1)}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐦</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathbf{m}_{v}^{(l+1)}</annotation></semantics></math></td>
<td id="A1.p1.1.1.19.2" class="ltx_td ltx_align_left">Neighborhood of entity <math id="A1.m33" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> and aggregated message.</td></tr>
