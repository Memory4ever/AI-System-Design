          <span id="algorithm1.4.9.2" class="ltx_text ltx_font_bold">for</span> <em id="algorithm1.4.9.3" class="ltx_emph ltx_font_italic"><math id="algorithm1.m18" class="ltx_Math" alttext="l=0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l=0</annotation></semantics></math> to <math id="algorithm1.m19" class="ltx_Math" alttext="L-1" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">L-1</annotation></semantics></math></em> <span id="algorithm1.4.9.4" class="ltx_text ltx_font_bold">do</span>
</div>
<div id="algorithm1.4.10" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.10.1" class="ltx_text ltx_font_bold">7</span></span>
          Message passing: <math id="algorithm1.m20" class="ltx_Math" alttext="\mathbf{m}_{v}^{(l+1)}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐦</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{m}_{v}^{(l+1)}\leftarrow</annotation></semantics></math> Eq. (<a href="#S4.E2" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>);
</div>
<div id="algorithm1.4.11" class="ltx_listingline"> <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span>  <span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span> 
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm1.4.11.1" class="ltx_text ltx_font_bold">8</span></span>
          Entity update: <math id="algorithm1.m21" class="ltx_Math" alttext="\mathbf{Z}_{v}^{(l+1)}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>𝐙</mi><mi>v</mi><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\mathbf{Z}_{v}^{(l+1)}\leftarrow</annotation></semantics></math> Eq. (<a href="#S4.E3" title="In 4.1. Generalized GFM as Cross-domain Retriever ‣ 4. Proposed Framework: Gfm-Retriever ‣ Retrieving Minimal and Sufficient Reasoning Subgraphswith Graph Foundation Models for Path-aware GraphRAG" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a>);
