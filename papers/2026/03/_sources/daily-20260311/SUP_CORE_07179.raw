</span></span></span></span>
<span id="A4.SS3.pic1.p107.13" class="ltx_p" style="width:294.2pt;"><span id="A4.SS3.pic1.p107.13.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:90%;width:294.2pt;--ltx-fg-color:#000000;"><span id="A4.SS3.pic1.p107.13.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:294.2pt;">
