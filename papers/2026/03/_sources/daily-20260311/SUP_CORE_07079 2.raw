<td id="S5.T4.7.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T4.7.1.1.2.1" class="ltx_text ltx_font_bold">Metric</span></td>
<td id="S5.T4.7.1.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T4.7.1.1.3.1" class="ltx_text ltx_font_bold">Entropy</span></td>
<td id="S5.T4.7.1.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T4.7.1.1.4.1" class="ltx_text ltx_font_bold">Advantage</span></td>
<td id="S5.T4.7.1.1.5" class="ltx_td ltx_align_center ltx_border_tt" rowspan="2"><span id="S5.T4.7.1.1.5.1" class="ltx_text"><span id="S5.T4.7.1.1.5.1.1" class="ltx_text ltx_font_bold">EOPD</span></span></td></tr>
<tr id="S5.T4.7.1.2" class="ltx_tr">
