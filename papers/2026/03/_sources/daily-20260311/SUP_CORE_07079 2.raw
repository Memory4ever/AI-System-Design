<td id="S5.T4.7.1.2.2" class="ltx_td ltx_align_center"><span id="S5.T4.7.1.2.2.1" class="ltx_text ltx_font_bold">Shaping</span></td></tr>
<tr id="S5.T4.7.1.3" class="ltx_tr">
<td id="S5.T4.7.1.3.1" class="ltx_td ltx_align_center ltx_border_t" rowspan="2"><span id="S5.T4.7.1.3.1.1" class="ltx_text">MATH500</span></td>
<td id="S5.T4.7.1.3.2" class="ltx_td ltx_align_center ltx_border_t">Avg@8</td>
<td id="S5.T4.7.1.3.3" class="ltx_td ltx_align_center ltx_border_t">66.87</td>
<td id="S5.T4.7.1.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.7.1.3.4.1" class="ltx_text ltx_underline">67.90</span></td>
<td id="S5.T4.7.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#E6E6FF;"><span id="S5.T4.7.1.3.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E6E6FF;">68.73</span></td></tr>
<tr id="S5.T4.7.1.4" class="ltx_tr">
<td id="S5.T4.7.1.4.1" class="ltx_td ltx_align_center">Pass@8</td>
<td id="S5.T4.7.1.4.2" class="ltx_td ltx_align_center"><span id="S5.T4.7.1.4.2.1" class="ltx_text ltx_underline">86.00</span></td>
<td id="S5.T4.7.1.4.3" class="ltx_td ltx_align_center">85.20</td>
