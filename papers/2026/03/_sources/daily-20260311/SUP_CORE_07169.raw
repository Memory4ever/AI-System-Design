<span id="A3.T7.5.38.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.38.4.1.1" class="ltx_p ltx_align_left">Given two matrices <math id="A3.T7.m415" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="A3.T7.m416" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, copy <math id="A3.T7.m417" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> into <math id="A3.T7.m418" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>, where matrix <math id="A3.T7.m419" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and <math id="A3.T7.m420" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> has the same shape of <math id="A3.T7.m421" class="ltx_Math" alttext="(M,N)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>M</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M,N)</annotation></semantics></math>.</span>
</span></td>
<td id="A3.T7.5.38.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.38.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.38.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m422" class="ltx_Math" alttext="M=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>8</mn></msup><mo>,</mo><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}</annotation></semantics></math>
