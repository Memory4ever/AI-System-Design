<br class="ltx_break"><span id="S4.T2.5.3.2.1.1.2" class="ltx_text">DRAM.Th</span> &lt; 30% and 
<br class="ltx_break"><span id="S4.T2.5.3.2.1.1.3" class="ltx_text">Memory.Th</span> &lt; 30 %</span>
</span></td>
