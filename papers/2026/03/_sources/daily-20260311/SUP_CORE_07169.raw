<tr id="A3.T7.5.2" class="ltx_tr">
<td id="A3.T7.5.2.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.2.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.2.1.1.1" class="ltx_p ltx_align_center">1</span>
</span></td>
<td id="A3.T7.5.2.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.2.2.1.1" class="ltx_p ltx_align_center">Dense Linear Algebra</span>
</span></td>
<td id="A3.T7.5.2.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.2.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.2.3.1.1" class="ltx_p ltx_align_center">Dot Product</span>
</span></td>
<td id="A3.T7.5.2.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.2.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.2.4.1.1" class="ltx_p ltx_align_left">For two vectors <math id="A3.T7.m2" class="ltx_Math" alttext="{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">{X}</annotation></semantics></math> and <math id="A3.T7.m3" class="ltx_Math" alttext="{Y}" display="inline" intent=":literal"><semantics><mi>Y</mi><annotation encoding="application/x-tex">{Y}</annotation></semantics></math>, both of length <math id="A3.T7.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, compute their dot product <math id="A3.T7.m5" class="ltx_Math" alttext="\text{dot\_product}({X},{Y})" display="inline" intent=":literal"><semantics><mrow><mtext>dot_product</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\text{dot\_product}({X},{Y})</annotation></semantics></math>:
<math id="A3.T7.m6" class="ltx_Math" alttext="\text{dot\_product}({X},{Y})=\sum_{i=1}^{N}{X}[i]\cdot{Y}[i]" display="inline" intent=":literal"><semantics><mrow><mrow><mtext>dot_product</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">=</mo><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mi>X</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo rspace="0.055em" stretchy="false">]</mo></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>Y</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{dot\_product}({X},{Y})=\sum_{i=1}^{N}{X}[i]\cdot{Y}[i]</annotation></semantics></math></span>
</span></td>
<td id="A3.T7.5.2.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.2.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.2.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m7" class="ltx_Math" alttext="N=\{2^{16},2^{17},2^{18},2^{19},2^{20}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>16</mn></msup><mo>,</mo><msup><mn>2</mn><mn>17</mn></msup><mo>,</mo><msup><mn>2</mn><mn>18</mn></msup><mo>,</mo><msup><mn>2</mn><mn>19</mn></msup><mo>,</mo><msup><mn>2</mn><mn>20</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{16},2^{17},2^{18},2^{19},2^{20}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m8" class="ltx_Math" alttext="T(N)=O(N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.3" class="ltx_tr">
<td id="A3.T7.5.3.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.3.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.3.1.1.1" class="ltx_p ltx_align_center">2</span>
</span></td>
<td id="A3.T7.5.3.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.3.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.3.2.1.1" class="ltx_p ltx_align_center">Dense Linear Algebra</span>
</span></td>
<td id="A3.T7.5.3.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.3.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.3.3.1.1" class="ltx_p ltx_align_center">Vector Add</span>
</span></td>
<td id="A3.T7.5.3.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.3.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.3.4.1.1" class="ltx_p ltx_align_left">Add two vectors <math id="A3.T7.m9" class="ltx_Math" alttext="{A}" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">{A}</annotation></semantics></math> and <math id="A3.T7.m10" class="ltx_Math" alttext="{B}" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">{B}</annotation></semantics></math> of length <math id="A3.T7.m11" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> into vector <math id="A3.T7.m12" class="ltx_Math" alttext="{C}" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">{C}</annotation></semantics></math>.</span>
</span></td>
<td id="A3.T7.5.3.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.3.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.3.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m13" class="ltx_Math" alttext="N=\{2^{10},2^{12},2^{14},2^{16},2^{18}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup><mo>,</mo><msup><mn>2</mn><mn>18</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{10},2^{12},2^{14},2^{16},2^{18}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m14" class="ltx_Math" alttext="T(N)=O(N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.4" class="ltx_tr">
<td id="A3.T7.5.4.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
