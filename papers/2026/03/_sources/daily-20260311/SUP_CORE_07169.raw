<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> CUDAMaster Pipeline</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
              
              
             Number of iterations <math id="alg1.l0.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math>, max debug rounds <math id="alg1.l0.m2" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>, original kernel code <math id="alg1.l0.m3" class="ltx_Math" alttext="C_{0}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mn>0</mn></msub><annotation encoding="application/x-tex">C_{0}</annotation></semantics></math>, original execution script <math id="alg1.l0.m4" class="ltx_Math" alttext="S_{0}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mn>0</mn></msub><annotation encoding="application/x-tex">S_{0}</annotation></semantics></math>

</div>
<div id="alg1.l0a" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
              
              
             Best code <math id="alg1.l0a.m1" class="ltx_Math" alttext="C^{*}" display="inline" intent=":literal"><semantics><msup><mi>C</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">C^{*}</annotation></semantics></math>, best execution script <math id="alg1.l0a.m2" class="ltx_Math" alttext="S^{*}" display="inline" intent=":literal"><semantics><msup><mi>S</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">S^{*}</annotation></semantics></math>

</div>
<div id="alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
             Record profile <math id="alg1.l1.m1" class="ltx_Math" alttext="\pi_{0}\leftarrow\text{ExecuteAndFilter}(C_{0},S_{0})" display="inline" intent=":literal"><semantics><mrow><msub><mi>π</mi><mn>0</mn></msub><mo stretchy="false">←</mo><mrow><mtext>ExecuteAndFilter</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mn>0</mn></msub><mo>,</mo><msub><mi>S</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\pi_{0}\leftarrow\text{ExecuteAndFilter}(C_{0},S_{0})</annotation></semantics></math>

</div>
<div id="alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
             Initialize <math id="alg1.l2.m1" class="ltx_Math" alttext="C^{*}\leftarrow C_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>C</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msub><mi>C</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">C^{*}\leftarrow C_{0}</annotation></semantics></math>, <math id="alg1.l2.m2" class="ltx_Math" alttext="S^{*}\leftarrow S_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>S</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msub><mi>S</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">S^{*}\leftarrow S_{0}</annotation></semantics></math>, <math id="alg1.l2.m3" class="ltx_Math" alttext="P^{*}\leftarrow 1.0" display="inline" intent=":literal"><semantics><mrow><msup><mi>P</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><mn>1.0</mn></mrow><annotation encoding="application/x-tex">P^{*}\leftarrow 1.0</annotation></semantics></math>, <math id="alg1.l2.m4" class="ltx_Math" alttext="\pi^{*}\leftarrow\pi_{0}" display="inline" intent=":literal"><semantics><mrow><msup><mi>π</mi><mo>∗</mo></msup><mo stretchy="false">←</mo><msub><mi>π</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\pi^{*}\leftarrow\pi_{0}</annotation></semantics></math>, scheme <math id="alg1.l2.m5" class="ltx_Math" alttext="\leftarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">←</mo><annotation encoding="application/x-tex">\leftarrow</annotation></semantics></math> "Baseline"

</div>
<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
             <span id="alg1.l3.3" class="ltx_text ltx_font_bold">for</span> <math id="alg1.l3.m1" class="ltx_Math" alttext="i=1" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">i=1</annotation></semantics></math> to <math id="alg1.l3.m2" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> <span id="alg1.l3.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <math id="alg1.l4.m1" class="ltx_Math" alttext="\text{scheme}\leftarrow\text{PlannerAgent}(C^{*},\pi^{*},\text{scheme})" display="inline" intent=":literal"><semantics><mrow><mtext>scheme</mtext><mo stretchy="false">←</mo><mrow><mtext>PlannerAgent</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>C</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>π</mi><mo>∗</mo></msup><mo>,</mo><mtext>scheme</mtext><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{scheme}\leftarrow\text{PlannerAgent}(C^{*},\pi^{*},\text{scheme})</annotation></semantics></math>

</div>
<div id="alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <math id="alg1.l5.m1" class="ltx_Math" alttext="C_{i}\leftarrow\text{CoderAgent}(\text{scheme},C^{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>CoderAgent</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>scheme</mtext><mo>,</mo><msup><mi>C</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{i}\leftarrow\text{CoderAgent}(\text{scheme},C^{*})</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
              <math id="alg1.l6.m1" class="ltx_Math" alttext="S_{i}\leftarrow\text{CompilerAgent}(\text{scheme},C_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">←</mo><mrow><mtext>CompilerAgent</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mtext>scheme</mtext><mo>,</mo><msub><mi>C</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S_{i}\leftarrow\text{CompilerAgent}(\text{scheme},C_{i})</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
