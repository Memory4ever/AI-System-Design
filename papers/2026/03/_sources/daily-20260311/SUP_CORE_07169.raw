<span id="A3.T7.5.43.4.1.1" class="ltx_p ltx_align_left">Given an 2d input signal and an 2d kernel, compute the output signal using 2D convolution.</span>
</span></td>
<td id="A3.T7.5.43.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.43.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.43.5.1.1" class="ltx_p ltx_align_left"><span id="A3.T7.5.43.5.1.1.1" class="ltx_text ltx_font_italic">input_size</span> = <math id="A3.T7.m456" class="ltx_Math" alttext="\{[2^{8},2^{8}],[2^{10},2^{10}],[2^{12},2^{12}]\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>2</mn><mn>8</mn></msup><mo>,</mo><msup><mn>2</mn><mn>8</mn></msup></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>10</mn></msup></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{[2^{8},2^{8}],[2^{10},2^{10}],[2^{12},2^{12}]\}</annotation></semantics></math> 
<br class="ltx_break"><span id="A3.T7.5.43.5.1.1.2" class="ltx_text ltx_font_italic">kernel_size</span> = <math id="A3.T7.m457" class="ltx_Math" alttext="\{[8,8],[16,16],[32,32]\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">[</mo><mrow><mn>8</mn><mo>,</mo><mn>8</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><mn>16</mn><mo>,</mo><mn>16</mn></mrow><mo stretchy="false">]</mo></mrow><mo>,</mo><mrow><mo stretchy="false">[</mo><mrow><mn>32</mn><mo>,</mo><mn>32</mn></mrow><mo stretchy="false">]</mo></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{[8,8],[16,16],[32,32]\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m458" class="ltx_Math" alttext="T(input\_size\_x,input\_size\_y," display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">CLOSE</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">T(input\_size\_x,input\_size\_y,</annotation></semantics></math>
<br class="ltx_break"><math id="A3.T7.m459" class="ltx_Math" alttext="kernel\_size\_x,kernel\_size\_y)=O(input\_size\_x\times input\_size\_y\times kernel\_size\_x\times kernel\_size\_y)" display="inline" intent=":literal"><semantics><mrow><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><mi>k</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mrow><mrow><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>i</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>k</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>z</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>_</mi><mo lspace="0em" rspace="0em">​</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">kernel\_size\_x,kernel\_size\_y)=O(input\_size\_x\times input\_size\_y\times kernel\_size\_x\times kernel\_size\_y)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.44" class="ltx_tr">
<td id="A3.T7.5.44.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.44.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.44.1.1.1" class="ltx_p ltx_align_center">43</span>
</span></td>
<td id="A3.T7.5.44.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.44.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.44.2.1.1" class="ltx_p ltx_align_center">Stencil Computation</span>
</span></td>
<td id="A3.T7.5.44.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.44.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.44.3.1.1" class="ltx_p ltx_align_center">2D Stencil</span>
</span></td>
<td id="A3.T7.5.44.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.44.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.44.4.1.1" class="ltx_p ltx_align_left">Given an input <math id="A3.T7.m460" class="ltx_Math" alttext="u_{\textit{old}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><annotation encoding="application/x-tex">u_{\textit{old}}</annotation></semantics></math> of shape <math id="A3.T7.m461" class="ltx_Math" alttext="[n_{x},n_{y}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>n</mi><mi>x</mi></msub><mo>,</mo><msub><mi>n</mi><mi>y</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[n_{x},n_{y}]</annotation></semantics></math>,calculate the 2d 5-point stencil of <math id="A3.T7.m462" class="ltx_Math" alttext="u_{\textit{old}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><annotation encoding="application/x-tex">u_{\textit{old}}</annotation></semantics></math> and store the result in <math id="A3.T7.m463" class="ltx_Math" alttext="u_{\textit{new}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><annotation encoding="application/x-tex">u_{\textit{new}}</annotation></semantics></math>:
For interior points (<math id="A3.T7.m464" class="ltx_Math" alttext="i\in[1,n_{x}-2]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[1,n_{x}-2]</annotation></semantics></math>, <math id="A3.T7.m465" class="ltx_Math" alttext="j\in[1,n_{y}-2]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[1,n_{y}-2]</annotation></semantics></math>):
<math id="A3.T7.m466" class="ltx_Math" alttext="u_{\textit{new}}[i,j]=u_{\textit{old}}[i,j]+r\ (u_{\textit{old}}[i-1,j]+u_{\textit{old}}[i+1,j]+u_{\textit{old}}[i,j-1]+u_{\textit{old}}[i,j+1]-4\ u_{\textit{old}}[i,j])" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo lspace="0.500em">⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0.500em" rspace="0em">​</mo><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\textit{new}}[i,j]=u_{\textit{old}}[i,j]+r\ (u_{\textit{old}}[i-1,j]+u_{\textit{old}}[i+1,j]+u_{\textit{old}}[i,j-1]+u_{\textit{old}}[i,j+1]-4\ u_{\textit{old}}[i,j])</annotation></semantics></math>
For boundary points <math id="A3.T7.m467" class="ltx_Math" alttext="(i\in\{0,n_{x}-1\},j\in\{0,n_{y}-1\})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(i\in\{0,n_{x}-1\},j\in\{0,n_{y}-1\})</annotation></semantics></math>:
<math id="A3.T7.m468" class="ltx_Math" alttext="u_{\textit{new}}[i,j]=u_{\textit{old}}[i,j]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\textit{new}}[i,j]=u_{\textit{old}}[i,j]</annotation></semantics></math></span>
</span></td>
<td id="A3.T7.5.44.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.44.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.44.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m469" class="ltx_Math" alttext="n_{x}=\{2^{10},2^{12},2^{14}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">n_{x}=\{2^{10},2^{12},2^{14}\}</annotation></semantics></math> 
<br class="ltx_break"><math id="A3.T7.m470" class="ltx_Math" alttext="n_{y}=\{2^{10},2^{12},2^{14}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">n_{y}=\{2^{10},2^{12},2^{14}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m471" class="ltx_Math" alttext="T(n_{x},n_{y})=O(n_{x}n_{y})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>x</mi></msub><mo>,</mo><msub><mi>n</mi><mi>y</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>y</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(n_{x},n_{y})=O(n_{x}n_{y})</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.45" class="ltx_tr">
<td id="A3.T7.5.45.1" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A3.T7.5.45.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.45.1.1.1" class="ltx_p ltx_align_center">44</span>
</span></td>
<td id="A3.T7.5.45.2" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A3.T7.5.45.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.45.2.1.1" class="ltx_p ltx_align_center">Stencil Computation</span>
</span></td>
<td id="A3.T7.5.45.3" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A3.T7.5.45.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.45.3.1.1" class="ltx_p ltx_align_center">3D Stencil</span>
</span></td>
<td id="A3.T7.5.45.4" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A3.T7.5.45.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.45.4.1.1" class="ltx_p ltx_align_left">Given an input <math id="A3.T7.m472" class="ltx_Math" alttext="u_{\textit{old}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><annotation encoding="application/x-tex">u_{\textit{old}}</annotation></semantics></math> of shape <math id="A3.T7.m473" class="ltx_Math" alttext="[n_{x},n_{y},n_{z}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>,</mo><msub><mi>n</mi><mi>y</mi></msub><mo>,</mo><msub><mi>n</mi><mi>z</mi></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[n_{x},n_{y},n_{z}]</annotation></semantics></math>, calculate the 3D 7-point stencil of <math id="A3.T7.m474" class="ltx_Math" alttext="u_{\textit{old}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><annotation encoding="application/x-tex">u_{\textit{old}}</annotation></semantics></math> and store the result in <math id="A3.T7.m475" class="ltx_Math" alttext="u_{\textit{new}}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><annotation encoding="application/x-tex">u_{\textit{new}}</annotation></semantics></math>:
For interior points (<math id="A3.T7.m476" class="ltx_Math" alttext="i\in[1,n_{x}-2]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[1,n_{x}-2]</annotation></semantics></math>, <math id="A3.T7.m477" class="ltx_Math" alttext="j\in[1,n_{y}-2]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[1,n_{y}-2]</annotation></semantics></math>, <math id="A3.T7.m478" class="ltx_Math" alttext="k\in[1,n_{z}-2]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><msub><mi>n</mi><mi>z</mi></msub><mo>−</mo><mn>2</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[1,n_{z}-2]</annotation></semantics></math>):
<math id="A3.T7.m479" class="ltx_Math" alttext="u_{\textit{new}}[i,j,k]=u_{\textit{old}}[i,j,k]+r\times(u_{\textit{old}}[i-1,j,k]+u_{\textit{old}}[i+1,j,k]+u_{\textit{old}}[i,j-1,k]+u_{\textit{old}}[i,j+1,k]+u_{\textit{old}}[i,j,k-1]+u_{\textit{old}}[i,j,k+1]-6.0\times u_{\textit{old}}[i,j,k])" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><mi>r</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mn>6.0</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\textit{new}}[i,j,k]=u_{\textit{old}}[i,j,k]+r\times(u_{\textit{old}}[i-1,j,k]+u_{\textit{old}}[i+1,j,k]+u_{\textit{old}}[i,j-1,k]+u_{\textit{old}}[i,j+1,k]+u_{\textit{old}}[i,j,k-1]+u_{\textit{old}}[i,j,k+1]-6.0\times u_{\textit{old}}[i,j,k])</annotation></semantics></math>
For boundary points (where <math id="A3.T7.m480" class="ltx_Math" alttext="i\in{0,n_{x}-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">i\in{0,n_{x}-1}</annotation></semantics></math> OR <math id="A3.T7.m481" class="ltx_Math" alttext="j\in{0,n_{y}-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>∈</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">j\in{0,n_{y}-1}</annotation></semantics></math> OR <math id="A3.T7.m482" class="ltx_Math" alttext="k\in{0,n_{z}-1}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>∈</mo><mn>0</mn></mrow><mo>,</mo><mrow><msub><mi>n</mi><mi>z</mi></msub><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k\in{0,n_{z}-1}</annotation></semantics></math>):
<math id="A3.T7.m483" class="ltx_Math" alttext="u_{\textit{new}}[i,j,k]=u_{\textit{old}}[i,j,k]" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">new</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>u</mi><mtext class="ltx_mathvariant_italic">old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mi>k</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u_{\textit{new}}[i,j,k]=u_{\textit{old}}[i,j,k]</annotation></semantics></math></span>
</span></td>
<td id="A3.T7.5.45.5" class="ltx_td ltx_align_left ltx_align_middle">
<span id="A3.T7.5.45.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.45.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m484" class="ltx_Math" alttext="n_{x}=\{2^{6},2^{7},2^{8}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>x</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mn>2</mn><mn>6</mn></msup><mo>,</mo><msup><mn>2</mn><mn>7</mn></msup><mo>,</mo><msup><mn>2</mn><mn>8</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">n_{x}=\{2^{6},2^{7},2^{8}\}</annotation></semantics></math> 
<br class="ltx_break"><math id="A3.T7.m485" class="ltx_Math" alttext="n_{y}=\{2^{6},2^{7},2^{8}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>y</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mn>2</mn><mn>6</mn></msup><mo>,</mo><msup><mn>2</mn><mn>7</mn></msup><mo>,</mo><msup><mn>2</mn><mn>8</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">n_{y}=\{2^{6},2^{7},2^{8}\}</annotation></semantics></math> 
<br class="ltx_break"><math id="A3.T7.m486" class="ltx_Math" alttext="n_{z}=\{2^{6},2^{7},2^{8}\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>n</mi><mi>z</mi></msub><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mn>2</mn><mn>6</mn></msup><mo>,</mo><msup><mn>2</mn><mn>7</mn></msup><mo>,</mo><msup><mn>2</mn><mn>8</mn></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">n_{z}=\{2^{6},2^{7},2^{8}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m487" class="ltx_Math" alttext="T(n_{x},n_{y},n_{z})=O(n_{x}n_{y}n_{z})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>n</mi><mi>x</mi></msub><mo>,</mo><msub><mi>n</mi><mi>y</mi></msub><mo>,</mo><msub><mi>n</mi><mi>z</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mi>z</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(n_{x},n_{y},n_{z})=O(n_{x}n_{y}n_{z})</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.46" class="ltx_tr">
<td id="A3.T7.5.46.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.46.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.46.1.1.1" class="ltx_p ltx_align_center">45</span>
</span></td>
<td id="A3.T7.5.46.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.46.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.46.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.46.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.46.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.46.3.1.1" class="ltx_p ltx_align_center">Sorting</span>
</span></td>
<td id="A3.T7.5.46.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.46.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.46.4.1.1" class="ltx_p ltx_align_left">Sort an input array of length <math id="A3.T7.m488" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> in ascending order. The naive implementation is merge sort. You are free to choose any sorting algorithm.</span>
</span></td>
<td id="A3.T7.5.46.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.46.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.46.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m489" class="ltx_Math" alttext="N=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>8</mn></msup><mo>,</mo><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m490" class="ltx_Math" alttext="T(N)=O(N\log N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N\log N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.47" class="ltx_tr">
<td id="A3.T7.5.47.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.47.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.47.1.1.1" class="ltx_p ltx_align_center">46</span>
</span></td>
<td id="A3.T7.5.47.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.47.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.47.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.47.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.47.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.47.3.1.1" class="ltx_p ltx_align_center">Top K</span>
</span></td>
<td id="A3.T7.5.47.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.47.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.47.4.1.1" class="ltx_p ltx_align_left">Given a vector <math id="A3.T7.m491" class="ltx_Math" alttext="{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">{X}</annotation></semantics></math> of length <math id="A3.T7.m492" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, calculate the top <math id="A3.T7.m493" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> of <math id="A3.T7.m494" class="ltx_Math" alttext="{X}" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">{X}</annotation></semantics></math> and their indices, which means finding the <math id="A3.T7.m495" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> largest elements in the sequence and their indices. The naive implementation is merge sort. You are free to choose any sorting algorithm ensuring values in descending order and index in ascending order.</span>
</span></td>
<td id="A3.T7.5.47.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.47.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.47.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m496" class="ltx_Math" alttext="N=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>8</mn></msup><mo>,</mo><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{8},2^{10},2^{12},2^{14},2^{16}\}</annotation></semantics></math> 
<br class="ltx_break"><math id="A3.T7.m497" class="ltx_Math" alttext="k=\{32,64,128\}" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mn>32</mn><mo>,</mo><mn>64</mn><mo>,</mo><mn>128</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">k=\{32,64,128\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m498" class="ltx_Math" alttext="T(N)=O(N\log N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N\log N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.48" class="ltx_tr">
<td id="A3.T7.5.48.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.48.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.48.1.1.1" class="ltx_p ltx_align_center">47</span>
</span></td>
<td id="A3.T7.5.48.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.48.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.48.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.48.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.48.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.48.3.1.1" class="ltx_p ltx_align_center">Simpson Int</span>
</span></td>
<td id="A3.T7.5.48.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.48.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.48.4.1.1" class="ltx_p ltx_align_left">Calculate the definite integral using the Simpson method, with <math id="A3.T7.m499" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> sample points <math id="A3.T7.m500" class="ltx_Math" alttext="y_{\textit{samples}}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mtext class="ltx_mathvariant_italic">samples</mtext></msub><annotation encoding="application/x-tex">y_{\textit{samples}}</annotation></semantics></math> and upper and lower limits of integration <math id="A3.T7.m501" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> and <math id="A3.T7.m502" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> respectively:</span>
<span id="A3.T7.5.48.4.1.2" class="ltx_p ltx_align_left"><math id="A3.T7.m503" class="ltx_math_unparsed" alttext="\int_{a}^{b}f(x)dx\approx\frac{h}{3}[y_{0}+y_{N-1}+" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∫</mo><mi>a</mi><mi>b</mi></msubsup><mi>f</mi><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow><mi>d</mi><mi>x</mi><mo>≈</mo><mfrac><mi>h</mi><mn>3</mn></mfrac><mrow><mo stretchy="false">[</mo><msub><mi>y</mi><mn>0</mn></msub><mo>+</mo><msub><mi>y</mi><mrow><mi>N</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>+</mo></mrow></mrow><annotation encoding="application/x-tex">\int_{a}^{b}f(x)dx\approx\frac{h}{3}[y_{0}+y_{N-1}+</annotation></semantics></math> <math id="A3.T7.m504" class="ltx_math_unparsed" alttext="4\sum_{i=1,3,5,\ldots}^{N-2}y_{i}+2\sum_{i=2,4,6,\ldots}^{N-3}y_{i}]" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><msubsup><mo>∑</mo><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>3</mn><mo>,</mo><mn>5</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>2</mn></mrow></msubsup><msub><mi>y</mi><mi>i</mi></msub><mo>+</mo><mn>2</mn><msubsup><mo>∑</mo><mrow><mrow><mi>i</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mn>4</mn><mo>,</mo><mn>6</mn><mo>,</mo><mi mathvariant="normal">…</mi></mrow><mrow><mi>N</mi><mo>−</mo><mn>3</mn></mrow></msubsup><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">4\sum_{i=1,3,5,\ldots}^{N-2}y_{i}+2\sum_{i=2,4,6,\ldots}^{N-3}y_{i}]</annotation></semantics></math></span>
</span></td>
<td id="A3.T7.5.48.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.48.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.48.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m505" class="ltx_Math" alttext="N=\{2^{14},2^{16},2^{18},2^{20},2^{22}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup><mo>,</mo><msup><mn>2</mn><mn>18</mn></msup><mo>,</mo><msup><mn>2</mn><mn>20</mn></msup><mo>,</mo><msup><mn>2</mn><mn>22</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{14},2^{16},2^{18},2^{20},2^{22}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m506" class="ltx_Math" alttext="T(N)=O(N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.49" class="ltx_tr">
<td id="A3.T7.5.49.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.49.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.49.1.1.1" class="ltx_p ltx_align_center">48</span>
</span></td>
<td id="A3.T7.5.49.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.49.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.49.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.49.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.49.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.49.3.1.1" class="ltx_p ltx_align_center">Monte Carlo Int</span>
</span></td>
<td id="A3.T7.5.49.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.49.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.49.4.1.1" class="ltx_p ltx_align_left">Calculate the definite integral using the Monte Carlo method, with <math id="A3.T7.m507" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> sample points <math id="A3.T7.m508" class="ltx_Math" alttext="y_{\textit{samples}}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><mtext class="ltx_mathvariant_italic">samples</mtext></msub><annotation encoding="application/x-tex">y_{\textit{samples}}</annotation></semantics></math> and upper and lower limits of integration <math id="A3.T7.m509" class="ltx_Math" alttext="b" display="inline" intent=":literal"><semantics><mi>b</mi><annotation encoding="application/x-tex">b</annotation></semantics></math> and <math id="A3.T7.m510" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math> respectively:</span>
<span id="A3.T7.5.49.4.1.2" class="ltx_p ltx_align_left"><math id="A3.T7.m511" class="ltx_Math" alttext="\int_{a}^{b}f(x)dx\approx\frac{b-a}{N}\sum_{i=1}^{N}y_{i}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∫</mo><mi>a</mi><mi>b</mi></msubsup><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>x</mi></mrow></mrow></mrow><mo>≈</mo><mrow><mfrac><mrow><mi>b</mi><mo>−</mo><mi>a</mi></mrow><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><msub><mi>y</mi><mi>i</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\int_{a}^{b}f(x)dx\approx\frac{b-a}{N}\sum_{i=1}^{N}y_{i}</annotation></semantics></math></span>
</span></td>
<td id="A3.T7.5.49.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.49.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.49.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m512" class="ltx_Math" alttext="N=\{2^{14},2^{16},2^{18},2^{20},2^{22}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup><mo>,</mo><msup><mn>2</mn><mn>18</mn></msup><mo>,</mo><msup><mn>2</mn><mn>20</mn></msup><mo>,</mo><msup><mn>2</mn><mn>22</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{14},2^{16},2^{18},2^{20},2^{22}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m513" class="ltx_Math" alttext="T(N)=O(N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.50" class="ltx_tr">
<td id="A3.T7.5.50.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.50.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.50.1.1.1" class="ltx_p ltx_align_center">49</span>
</span></td>
<td id="A3.T7.5.50.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.50.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.50.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.50.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.50.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.50.3.1.1" class="ltx_p ltx_align_center">FFT</span>
</span></td>
<td id="A3.T7.5.50.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.50.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.50.4.1.1" class="ltx_p ltx_align_left">Given a complex number array of length <math id="A3.T7.m514" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, calculate the FFT of the array. The input and output are separated into real and imaginary parts.</span>
</span></td>
<td id="A3.T7.5.50.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t">
<span id="A3.T7.5.50.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.50.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m515" class="ltx_Math" alttext="N=\{2^{10},2^{11},2^{12},2^{13},2^{14}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>11</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>13</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{10},2^{11},2^{12},2^{13},2^{14}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m516" class="ltx_Math" alttext="T(N)=O(N\log N)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>N</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>N</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N\log N)</annotation></semantics></math></span>
</span></td></tr>
<tr id="A3.T7.5.51" class="ltx_tr">
<td id="A3.T7.5.51.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="A3.T7.5.51.1.1" class="ltx_inline-block ltx_align_middle" style="width:14.2pt;">
<span id="A3.T7.5.51.1.1.1" class="ltx_p ltx_align_center">50</span>
</span></td>
<td id="A3.T7.5.51.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="A3.T7.5.51.2.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.51.2.1.1" class="ltx_p ltx_align_center">Math &amp; Algorithm</span>
</span></td>
<td id="A3.T7.5.51.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="A3.T7.5.51.3.1" class="ltx_inline-block ltx_align_middle" style="width:42.7pt;">
<span id="A3.T7.5.51.3.1.1" class="ltx_p ltx_align_center">Prefix Sum</span>
</span></td>
<td id="A3.T7.5.51.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="A3.T7.5.51.4.1" class="ltx_inline-block ltx_align_middle" style="width:184.9pt;">
<span id="A3.T7.5.51.4.1.1" class="ltx_p ltx_align_left">Given a sequence of length <math id="A3.T7.m517" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, calculate the prefix sum of the sequence on each index and write into an output sequence. The naive implementation computes each output element independently by summing all elements from the beginning of the input sequence up to the current index.</span>
</span></td>
<td id="A3.T7.5.51.5" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb ltx_border_t">
<span id="A3.T7.5.51.5.1" class="ltx_inline-block ltx_align_middle" style="width:142.3pt;">
<span id="A3.T7.5.51.5.1.1" class="ltx_p ltx_align_left"><math id="A3.T7.m518" class="ltx_Math" alttext="N=\{2^{10},2^{12},2^{14},2^{16},2^{18}\}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>,</mo><msup><mn>2</mn><mn>12</mn></msup><mo>,</mo><msup><mn>2</mn><mn>14</mn></msup><mo>,</mo><msup><mn>2</mn><mn>16</mn></msup><mo>,</mo><msup><mn>2</mn><mn>18</mn></msup></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">N=\{2^{10},2^{12},2^{14},2^{16},2^{18}\}</annotation></semantics></math>

<br class="ltx_break"><math id="A3.T7.m519" class="ltx_Math" alttext="T(N)=O(N^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mi>T</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>O</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>N</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">T(N)=O(N^{2})</annotation></semantics></math></span>
</span></td></tr>
