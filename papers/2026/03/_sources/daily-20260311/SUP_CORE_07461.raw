="M 10.72 0 L 3.35 2.73 L 5.28 0 L 3.35 -2.73 Z"></path></g></g><g style="--ltx-stroke-color:#000000;" stroke="#000000" stroke-width="1.0pt"><path style="fill:none" d="M 220.88 -350.67 L 251.3 -370.95 C 253.84 -372.64 258.38 -374.02 261.44 -374.02 L 296.95 -374.02"></path><g style="--ltx-fill-color:#000000;" fill="#000000" stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 293.33 -374.02)"><path d="M 8.53 0 L 2.23 2.34 L 3.97 0 L 2.23 -2.34 Z"></path></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 247.87 -364.04)"><foreignObject style="--ltx-fo-width:1.58em;--ltx-fo-height:0.46em;--ltx-fo-depth:0.1em;font-size:7.36pt;" height="5.74" overflow="visible" transform="matrix(1 0 0 -1 0 4.7)" width="16.06"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S2.F1.pic1.m14" class="ltx_Math" alttext="\Delta\mathbf{x}_{e}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.500em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.500em">𝐱</mi><mi mathsize="0.500em">e</mi></msub></mrow><annotation encoding="application/x-tex">\Delta\mathbf{x}_{e}</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#CC6600;--ltx-fill-color:#FFF2E6;" fill="#FFF2E6" stroke="#CC6600" stroke-width="0.8pt"><path d="M 102.73 -409.45 L 54.75 -409.45 C 51.69 -409.45 49.21 -411.93 49.21 -414.98 L 49.21 -435.41 C 49.21 -438.47 51.69 -440.95 54.75 -440.95 L 102.73 -440.95 C 105.79 -440.95 108.27 -438.47 108.27 -435.41 L 108.27 -414.98 C 108.27 -411.93 105.79 -409.45 102.73 -409.45 Z M 49.21 -440.95"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.8pt" transform="matrix(1.0 0.0 0.0 1.0 67.56 -430.3)"><foreignObject style="--ltx-fo-width:1.62em;--ltx-fo-heigh