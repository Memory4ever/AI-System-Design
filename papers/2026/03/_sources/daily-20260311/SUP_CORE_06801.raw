<td id="A6.T4.12.1.3.5" class="ltx_td ltx_align_center"><span id="A6.T4.12.1.3.5.1" class="ltx_text" style="font-size:90%;">60.99</span></td>
<td id="A6.T4.12.1.3.6" class="ltx_td ltx_align_center"><span id="A6.T4.12.1.3.6.1" class="ltx_text" style="font-size:90%;">56.45</span></td>
