<td id="S5.T2.5.1.6.5" class="ltx_td ltx_align_center"><span id="S5.T2.5.1.6.5.1" class="ltx_text ltx_underline">39.51</span></td>
<td id="S5.T2.5.1.6.6" class="ltx_td ltx_align_center"><span id="S5.T2.5.1.6.6.1" class="ltx_text ltx_underline">24.19</span></td>
<td id="S5.T2.5.1.6.7" class="ltx_td ltx_align_center ltx_border_r">39.66</td>
