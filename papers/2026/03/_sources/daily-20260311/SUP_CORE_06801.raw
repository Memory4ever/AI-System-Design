<th id="S7.T3.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S7.T3.6.1.5.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="--ltx-bg-color:#E8F2FF;">AceMAD</span><span id="S7.T3.6.1.5.1.2" class="ltx_text" style="--ltx-bg-color:#E8F2FF;"> (Different Thinking System)</span></th>
