<tr id="S5.T2.5.1.6" class="ltx_tr">
<th id="S5.T2.5.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T2.5.1.6.1.1" class="ltx_text ltx_font_italic">Centralized MAD</span></th>
