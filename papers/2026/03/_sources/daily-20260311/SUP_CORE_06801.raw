<th id="A7.T5.12.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A7.T5.12.1.7.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;--ltx-bg-color:#E8F2FF;">AceMAD</span><span id="A7.T5.12.1.7.1.2" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E8F2FF;"> (T=3)</span></th>
<td id="A7.T5.12.1.7.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A7.T5.12.1.7.2.1" class="ltx_text ltx_underline" style="font-size:90%;--ltx-bg-color:#E8F2FF;">36.77</span></td>
<td id="A7.T5.12.1.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A7.T5.12.1.7.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#E8F2FF;">29.68</span></td>
<td id="A7.T5.12.1.7.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A7.T5.12.1.7.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#E8F2FF;">22.76</span></td>
<td id="A7.T5.12.1.7.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="A7.T5.12.1.7.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#E8F2FF;">29.74</span></td></tr>
