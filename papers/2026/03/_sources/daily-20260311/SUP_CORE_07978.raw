Digital environment <math id="alg2.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>; Environment State <math id="alg2.m2" class="ltx_Math" alttext="S_{i}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>i</mi></msub><annotation encoding="application/x-tex">S_{i}</annotation></semantics></math>; Exploration Plans <math id="alg2.m3" class="ltx_Math" alttext="\Pi" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Π</mi><annotation encoding="application/x-tex">\Pi</annotation></semantics></math>; Action Sequence <math id="alg2.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math>;
