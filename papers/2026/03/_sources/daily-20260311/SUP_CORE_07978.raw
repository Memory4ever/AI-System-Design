<div id="alg2.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
                <span id="alg2.l11.3" class="ltx_text ltx_font_bold">for</span> each <math id="alg2.l11.m1" class="ltx_Math" alttext="\Pi^{new}\in P(E,S_{i+1},\Pi,\alpha\oplus\alpha^{\prime})" display="inline" intent=":literal"><semantics><mrow><msup><mi mathvariant="normal">Π</mi><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>w</mi></mrow></msup><mo>∈</mo><mrow><mi>P</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>E</mi><mo>,</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>,</mo><mi mathvariant="normal">Π</mi><mo>,</mo><mrow><mi>α</mi><mo>⊕</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Pi^{new}\in P(E,S_{i+1},\Pi,\alpha\oplus\alpha^{\prime})</annotation></semantics></math> <span id="alg2.l11.4" class="ltx_text ltx_font_bold">do</span>

</div>
