                <math id="alg2.l10.m1" class="ltx_Math" alttext="\mathcal{K}\leftarrow\mathcal{K}\cup\{(\Pi,\ \alpha\oplus\alpha^{\prime})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo stretchy="false">←</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒦</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Π</mi><mo>,</mo><mrow><mi>α</mi><mo>⊕</mo><msup><mi>α</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{K}\leftarrow\mathcal{K}\cup\{(\Pi,\ \alpha\oplus\alpha^{\prime})\}</annotation></semantics></math>

