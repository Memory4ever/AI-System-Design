</span></td>
<td id="S4.T3.2.8.10" class="ltx_td ltx_align_left ltx_border_bb ltx_border_r">
<span id="S4.T3.2.8.10.1" class="ltx_inline-block ltx_align_top" style="--ltx-bg-color:#EBFFFF;">
<span id="S4.T3.2.8.10.1.1" class="ltx_p ltx_align_center"><span id="S4.T3.2.8.10.1.1.1" class="ltx_text ltx_font_bold">4.89%</span></span>
</span></td>
<td id="S4.T3.2.8.11" class="ltx_td ltx_align_left ltx_border_bb">
