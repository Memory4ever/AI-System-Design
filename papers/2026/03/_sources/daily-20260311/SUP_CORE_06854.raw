<table id="S6.T3.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S6.T3.2.1" class="ltx_tr">
<th id="S6.T3.2.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="S6.T3.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">Qwen2-Audio</th>
<th id="S6.T3.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="2">R1-AQA</th></tr>
<tr id="S6.T3.2.2" class="ltx_tr">
<th id="S6.T3.2.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row">K</th>
