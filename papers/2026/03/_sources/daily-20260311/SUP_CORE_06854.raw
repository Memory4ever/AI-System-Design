<td id="S6.T3.2.3.3" class="ltx_td ltx_align_center ltx_border_t">+7.2%</td>
<td id="S6.T3.2.3.4" class="ltx_td ltx_align_center ltx_border_t">+1.0%</td>
<td id="S6.T3.2.3.5" class="ltx_td ltx_align_center ltx_border_t">+4.7%</td></tr>
<tr id="S6.T3.2.4" class="ltx_tr">
<th id="S6.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">20</th>
<td id="S6.T3.2.4.2" class="ltx_td ltx_align_center">+2.2%</td>
<td id="S6.T3.2.4.3" class="ltx_td ltx_align_center">+8.0%</td>
<td id="S6.T3.2.4.4" class="ltx_td ltx_align_center">+2.0%</td>
<td id="S6.T3.2.4.5" class="ltx_td ltx_align_center">+4.9%</td></tr>
