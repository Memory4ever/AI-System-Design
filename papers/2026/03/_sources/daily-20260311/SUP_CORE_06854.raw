<th id="S6.T3.2.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Specialists</th>
<th id="S6.T3.2.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Random</th>
<th id="S6.T3.2.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Specialists</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S6.T3.2.3" class="ltx_tr">
