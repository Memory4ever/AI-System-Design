<tr id="S4.T1.4.1.5" class="ltx_tr">
<td id="S4.T1.4.1.5.1" class="ltx_td ltx_align_left ltx_border_r">TCN</td>
<td id="S4.T1.4.1.5.2" class="ltx_td ltx_align_center">38.6 <math id="S4.T1.m32" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.5</td>
