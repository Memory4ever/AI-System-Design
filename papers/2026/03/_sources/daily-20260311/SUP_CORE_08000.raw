<tr id="S4.T1.6.1.11" class="ltx_tr" style="--ltx-bg-color:#E8F0FE;">
<td id="S4.T1.6.1.11.1" class="ltx_td ltx_align_center ltx_border_t" colspan="11"><span id="S4.T1.6.1.11.1.1" class="ltx_text ltx_font_bold">DeepSeek-R1-Distill-Qwen-7B</span></td></tr>
