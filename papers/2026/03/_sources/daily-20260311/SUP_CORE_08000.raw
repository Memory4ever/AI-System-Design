<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Details of Token-Wise GRPO Algorithm</h3>

<div id="A1.SS3.p1" class="ltx_para">
<p id="A1.SS3.p1.1" class="ltx_p">Here we provide a complete version of token-wise GRPO objective:</p>
<table id="A1.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A1.Ex1"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A1.Ex1.m1" class="ltx_Math" alttext="\displaystyle\mathcal{J}_{\text{GRPO}}(\theta)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒥</mi><mtext>GRPO</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{J}_{\text{GRPO}}(\theta)</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.Ex1.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E}_{q\sim P\left(Q\right),\left\{o_{i}\right\}_{i=1}^{G}\sim\pi_{\text{old}}\left(\cdot|q\right)}\Bigg\{\frac{1}{\sum_{i=1}^{G}\lvert o_{i}\rvert}\sum_{i=1}^{G}\sum_{t=1}^{\lvert o_{i}\rvert}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mrow><mi>q</mi><mo>∼</mo><mi>P</mi><mo>(</mo><mi>Q</mi><mo>)</mo><mo>,</mo><mo>{</mo><mi>o</mi><msub><mrow></mrow><mi>i</mi></msub><mo>}</mo><msub><mrow></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>G</mi></msup><mo>∼</mo><mi>π</mi><msub><mrow></mrow><mtext>old</mtext></msub><mo>(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>q</mi><mo>)</mo></mrow></msub><mrow><mo stretchy="false">{</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></msubsup><mrow><mo lspace="0em" stretchy="false">|</mo><msub><mi>o</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></mrow></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>G</mi></munderover></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mrow><mo stretchy="false">|</mo><msub><mi>o</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow></munderover></mstyle></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{q\sim P\left(Q\right),\left\{o_{i}\right\}_{i=1}^{G}\sim\pi_{\text{old}}\left(\cdot|q\right)}\Bigg\{\frac{1}{\sum_{i=1}^{G}\lvert o_{i}\rvert}\sum_{i=1}^{G}\sum_{t=1}^{\lvert o_{i}\rvert}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A1.E24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A1.E24.m1" class="ltx_math_unparsed" alttext="\displaystyle\left[\min\left(r_{i,t}\left(\theta\right)\hat{A}_{i,t},\operatorname{clip}\left(r_{i,t}\left(\theta\right),1-\epsilon,1+\epsilon\right)\hat{A}_{i,t}\right)-\beta\mathbb{D}_{\text{KL}}\left(\pi_{\theta}\left(o_{i,t}\right)||\pi_{\text{old}}\left(o_{i,t}\right)\right)\right]\Bigg\}," display="inline" intent=":literal"><semantics><mrow><mrow><mo>[</mo><mi>min</mi><mrow><mo>(</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo>(</mo><mi>θ</mi><mo>)</mo></mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>,</mo><mi>clip</mi><mrow><mo>(</mo><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mrow><mo>(</mo><mi>θ</mi><mo>)</mo></mrow><mo>,</mo><mn>1</mn><mo>−</mo><mi>ϵ</mi><mo>,</mo><mn>1</mn><mo>+</mo><mi>ϵ</mi><mo>)</mo></mrow><msub><mover accent="true"><mi>A</mi><mo>^</mo></mover><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>−</mo><mi>β</mi><msub><mi>𝔻</mi><mtext>KL</mtext></msub><mrow><mo>(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>π</mi><mtext>old</mtext></msub><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>)</mo></mrow><mo>]</mo></mrow><mo stretchy="false">}</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left[\min\left(r_{i,t}\left(\theta\right)\hat{A}_{i,t},\operatorname{clip}\left(r_{i,t}\left(\theta\right),1-\epsilon,1+\epsilon\right)\hat{A}_{i,t}\right)-\beta\mathbb{D}_{\text{KL}}\left(\pi_{\theta}\left(o_{i,t}\right)||\pi_{\text{old}}\left(o_{i,t}\right)\right)\right]\Bigg\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A1.SS3.p1.2" class="ltx_p">where</p>
<table id="A1.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E25.m1" class="ltx_Math" alttext="r_{i,t}\left(\theta\right)=\frac{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\text{old}}\left(o_{i,t}|q,o_{i,&lt;t}\right)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>r</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mi>θ</mi><mo>)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>π</mi><mtext>old</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">r_{i,t}\left(\theta\right)=\frac{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\text{old}}\left(o_{i,t}|q,o_{i,&lt;t}\right)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<table id="A1.E26" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A1.E26.m1" class="ltx_math_unparsed" alttext="\mathbb{D}_{\text{KL}}\left(\pi_{\theta}\left(o_{i,t}\right)||\pi_{\text{old}}\left(o_{i,t}\right)\right)=\frac{\pi_{\text{ref}}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}-\log\frac{\pi_{\text{ref}}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}-1." display="block" intent=":literal"><semantics><mrow><msub><mi>𝔻</mi><mtext>KL</mtext></msub><mrow><mo>(</mo><msub><mi>π</mi><mi>θ</mi></msub><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>π</mi><mtext>old</mtext></msub><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo>)</mo></mrow><mo>)</mo></mrow><mo>=</mo><mfrac><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mfrac><mo>−</mo><mi>log</mi><mfrac><mrow><msub><mi>π</mi><mtext>ref</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow><mrow><msub><mi>π</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>o</mi><mrow><mi>i</mi><mo>,</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">|</mo><mrow><mi>q</mi><mo>,</mo><msub><mi>o</mi><mrow><mrow><mi>i</mi><mo>,</mo><mphantom></mphantom></mrow><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo>)</mo></mrow></mrow></mfrac><mo>−</mo><mn>1</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{D}_{\text{KL}}\left(\pi_{\theta}\left(o_{i,t}\right)||\pi_{\text{old}}\left(o_{i,t}\right)\right)=\frac{\pi_{\text{ref}}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}-\log\frac{\pi_{\text{ref}}\left(o_{i,t}|q,o_{i,&lt;t}\right)}{\pi_{\theta}\left(o_{i,t}|q,o_{i,&lt;t}\right)}-1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(26)</span></td></tr></tbody>
</table>
</div>
<div id="A1.SS3.p2" class="ltx_para">
<p id="A1.SS3.p2.1" class="ltx_p">Considering training efficiency, <math id="A1.SS3.p2.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> can be set to 0 to reduce the overhead of computing <math id="A1.SS3.p2.m2" class="ltx_Math" alttext="\pi_{\text{old}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mtext>old</mtext></msub><annotation encoding="application/x-tex">\pi_{\text{old}}</annotation></semantics></math>.</p>
</div>
</section>
</section>
<section id="A2" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix B </span>Evalation Details</h2>

<section id="A2.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.1 </span>Prompt</h3>

<div id="A2.SS1.p1" class="ltx_para">
<p id="A2.SS1.p1.1" class="ltx_p">For both training and evluation, we use the following prompt:</p>
</div>
<div id="A2.SS1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS1.p2.pic1" class="ltx_picture" height="79.99" overflow="visible" version="1.1" viewBox="0 0 477.38 79.99" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,79.99) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#179299;" fill="#179299" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 74.08 C 0 77.34 2.64 79.99 5.91 79.99 L 471.47 79.99 C 474.73 79.99 477.38 77.34 477.38 74.08 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#E8F4F5;" fill="#E8F4F5" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 56.03 L 475.41 56.03 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 64.63)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS1.p2.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A2.SS1.p2.pic1.1.1" class="ltx_p"><span id="A2.SS1.p2.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#EFF1F5;">Prompt</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 17.24)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:1.95em;--ltx-fo-depth:0.25em;font-size:10pt;" height="30.44" overflow="visible" transform="matrix(1 0 0 -1 0 26.98)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A2.SS1.p2.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A2.SS1.p2.pic1.2.1" class="ltx_p"><span id="A2.SS1.p2.pic1.2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">{question}
<br class="ltx_break">Please reason step by step, and put your final answer within \boxed{}.</span></span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
</section>
<section id="A2.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.2 </span>AE Score</h3>

<div id="A2.SS2.p1" class="ltx_para">
<p id="A2.SS2.p1.1" class="ltx_p">The AE score is defined as</p>
</div>
<div id="A2.SS2.p2" class="ltx_para">
<table id="A2.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E27.m1" class="ltx_Math" alttext="\text{AE}=\begin{cases}-\phi\cdot\Delta\text{Len.}+\eta\cdot\Delta\text{Acc.}&amp;\text{if }\Delta\text{Acc.}\geqslant 0,\\
-\phi\cdot\Delta\text{Len.}+\theta\cdot\Delta\text{Acc.},&amp;\text{if }\Delta\text{Acc.}&lt;0,\end{cases}" display="block" intent=":literal"><semantics><mrow><mtext>AE</mtext><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi mathvariant="normal">Δ</mi><mtext>Len.</mtext><mo>+</mo><mi>η</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi mathvariant="normal">Δ</mi><mtext>Acc.</mtext></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>Acc.</mtext></mrow><mo>⩾</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mo>−</mo><mi>ϕ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi mathvariant="normal">Δ</mi><mtext>Len.</mtext><mo>+</mo><mi>θ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi mathvariant="normal">Δ</mi><mtext>Acc.</mtext><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>Acc.</mtext></mrow><mo>&lt;</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\text{AE}=\begin{cases}-\phi\cdot\Delta\text{Len.}+\eta\cdot\Delta\text{Acc.}&amp;\text{if }\Delta\text{Acc.}\geqslant 0,\\
-\phi\cdot\Delta\text{Len.}+\theta\cdot\Delta\text{Acc.},&amp;\text{if }\Delta\text{Acc.}&lt;0,\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
</div>
<div id="A2.SS2.p3" class="ltx_para">
<p id="A2.SS2.p3.1" class="ltx_p">where <math id="A2.SS2.p3.m1" class="ltx_Math" alttext="\phi,\eta,\theta" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>,</mo><mi>η</mi><mo>,</mo><mi>θ</mi></mrow><annotation encoding="application/x-tex">\phi,\eta,\theta</annotation></semantics></math> are all positive hyperparameters. To penalize performance degradation, generally <math id="A2.SS2.p3.m2" class="ltx_Math" alttext="\theta&gt;\eta" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>&gt;</mo><mi>η</mi></mrow><annotation encoding="application/x-tex">\theta&gt;\eta</annotation></semantics></math>. We follow the default setting in DeepScaleR, <em id="A2.SS2.p3.1.1" class="ltx_emph ltx_font_italic">i.e.</em>, <math id="A2.SS2.p3.m3" class="ltx_Math" alttext="\phi=1,\eta=3,\theta=5" display="inline" intent=":literal"><semantics><mrow><mrow><mi>ϕ</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mrow><mi>η</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mrow><mi>θ</mi><mo>=</mo><mn>5</mn></mrow></mrow><annotation encoding="application/x-tex">\phi=1,\eta=3,\theta=5</annotation></semantics></math>.</p>
</div>
</section>
<section id="A2.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.3 </span>Baselines</h3>

<div id="A2.SS3.p1" class="ltx_para">
<ul id="A2.I1" class="ltx_itemize">
<li id="A2.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i1.p1" class="ltx_para">
<p id="A2.I1.i1.p1.1" class="ltx_p"><span id="A2.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Base Model:</span> We evaluate the performance of the original models without RL finetuning.</p>
</div></li>
<li id="A2.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i2.p1" class="ltx_para">
<p id="A2.I1.i2.p1.1" class="ltx_p"><span id="A2.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Truncated Think <math id="A2.I1.i2.p1.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math>k:</span> This means setting a maximum thinking length for the base model’s CoT. When the chain of thought reaches the maximum length, directly output the <code id="A2.I1.i2.p1.1.2" class="ltx_verbatim ltx_font_typewriter">&lt;/think&gt;</code> token to end thinking and produce the final answer. We test this method to evaluate the performance of simple efficient reasoning approaches without training.</p>
</div></li>
<li id="A2.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i3.p1" class="ltx_para">
<p id="A2.I1.i3.p1.1" class="ltx_p"><span id="A2.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">ThinkPrune-4k:</span> ThinkPrune is an GRPO-based efficient reasoning method which adopts length-pruning strategy in the reward design. We choose the model with the highest accuracy in ThinkPrune series.</p>
</div></li>
<li id="A2.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i4.p1" class="ltx_para">
<p id="A2.I1.i4.p1.1" class="ltx_p"><span id="A2.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">ShorterBetter:</span> Differing from the naive length reward where trajectories within a group are independent, ShorterBetter designs two different non-monotonic reward functions for the cases of all answers being wrong and at least one correct answer existing. This approach can greatly compress the chain-of-thought length.</p>
</div></li>
<li id="A2.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I1.i5.p1" class="ltx_para">
<p id="A2.I1.i5.p1.1" class="ltx_p"><span id="A2.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">LASER-DE-4096:</span> This method comes from the LASER series. LASER designs a difficulty-aware reward, assigning different reward functions to different difficulty levels. We select LASER-DE-4096 as the baseline in this series of models because it strikes a good balance between performance and efficiency.</p>
</div></li>
</ul>
</div>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Ablation Study Settings</h3>

<div id="A2.SS4.p1" class="ltx_para">
<ul id="A2.I2" class="ltx_itemize">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i1.p1" class="ltx_para">
<p id="A2.I2.i1.p1.1" class="ltx_p"><span id="A2.I2.i1.p1.1.1" class="ltx_text ltx_font_bold">Fixed Coefficient.</span> Do not use dynamic coefficient, directly setting <math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="\lambda=0.001" display="inline" intent=":literal"><semantics><mrow><mi>λ</mi><mo>=</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">\lambda=0.001</annotation></semantics></math>. The overall reward is <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="r_{i}=r_{i}^{\text{acc}}+\lambda r_{i}^{\text{len}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>i</mi></msub><mo>=</mo><mrow><msubsup><mi>r</mi><mi>i</mi><mtext>acc</mtext></msubsup><mo>+</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>i</mi><mtext>len</mtext></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">r_{i}=r_{i}^{\text{acc}}+\lambda r_{i}^{\text{len}}</annotation></semantics></math></p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para">
<p id="A2.I2.i2.p1.1" class="ltx_p"><span id="A2.I2.i2.p1.1.1" class="ltx_text ltx_font_bold">Symmetric.</span> We have analyze that directly pushing all output length approaching optimal length can also reduce the length, so here we directly set the length reward as:</p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="r_{i}^{\text{len}}=\begin{cases}0,&amp;\text{if }r_{i}^{\text{acc}}=0,\\
-\lvert l_{i}-l^{\text{opt}}\rvert,&amp;\text{if }r_{i}^{\text{acc}}=1,\\
\end{cases}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>i</mi><mtext>len</mtext></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>i</mi><mtext>acc</mtext></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><mo stretchy="false">|</mo><mrow><msub><mi>l</mi><mi>i</mi></msub><mo>−</mo><msup><mi>l</mi><mtext>opt</mtext></msup></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>i</mi><mtext>acc</mtext></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">r_{i}^{\text{len}}=\begin{cases}0,&amp;\text{if }r_{i}^{\text{acc}}=0,\\
-\lvert l_{i}-l^{\text{opt}}\rvert,&amp;\text{if }r_{i}^{\text{acc}}=1,\\
\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
</div></li>
<li id="A2.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i3.p1" class="ltx_para">
<p id="A2.I2.i3.p1.1" class="ltx_p"><span id="A2.I2.i3.p1.1.1" class="ltx_text ltx_font_bold">Linear.</span> A simple length reward setting, which is</p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="r_{i}^{\text{len}}=\begin{cases}0,&amp;\text{if }r_{i}^{\text{acc}}=0,\\
l_{i}-\min(\mathcal{L})&amp;\text{if }r_{i}^{\text{acc}}=1,\\
\end{cases}" display="block" intent=":literal"><semantics><mrow><msubsup><mi>r</mi><mi>i</mi><mtext>len</mtext></msubsup><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>i</mi><mtext>acc</mtext></msubsup></mrow><mo>=</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><msub><mi>l</mi><mi>i</mi></msub><mo>−</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mtext>if </mtext><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>i</mi><mtext>acc</mtext></msubsup></mrow><mo>=</mo><mn>1</mn></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">r_{i}^{\text{len}}=\begin{cases}0,&amp;\text{if }r_{i}^{\text{acc}}=0,\\
l_{i}-\min(\mathcal{L})&amp;\text{if }r_{i}^{\text{acc}}=1,\\
\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
</div></li>
</ul>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Additional Experiments</h2>

<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Gaussian Distribution Test of All Response Lengths and Correct Response Lengths</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">To verify the reasonableness of our theoretical analysis assumptions, we conducted a Gaussian distribution test on the model’s response length. We use <span id="A3.SS1.p1.1.1" class="ltx_text ltx_font_bold">Shapiro-Wilk</span> and <span id="A3.SS1.p1.1.2" class="ltx_text ltx_font_bold">Kolmogorov-Smirnov</span> methods to test the distributions. For both methods, the significance threshold was set to 0.05. In addition, we also use skewness and kurtosis to detect shape. We denote passing the Shapiro-Wilk test as <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="P_{\text{SW}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>SW</mtext></msub><annotation encoding="application/x-tex">P_{\text{SW}}</annotation></semantics></math>, passing the Kolmogorov-Smirnov test as <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="P_{\text{KS}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>KS</mtext></msub><annotation encoding="application/x-tex">P_{\text{KS}}</annotation></semantics></math>, and satisfying absolute skewness less than 1.5 and absolute kurtosis less than 3.0 as <math id="A3.SS1.p1.m3" class="ltx_Math" alttext="P_{\text{shape}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>shape</mtext></msub><annotation encoding="application/x-tex">P_{\text{shape}}</annotation></semantics></math>.</p>
</div>
<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p">We generate 64 responses for each question on the Olympiad <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib36" title="" class="ltx_ref">He et al., 2024</a>)</cite> dataset and filter out questions with fewer than 16 correct answers. The length distribution test of the remaining questions is shown in the  <a href="#A3.T5" title="Table 5 ‣ C.1 Gaussian Distribution Test of All Response Lengths and Correct Response Lengths ‣ Appendix C Additional Experiments ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Table 5</span></a>. The results show that, under tolerable shape deviations, more than half of the responses to the questions can be approximated by a Gaussian distribution. This proves the reasonableness of the premises in our theoretical analysis.</p>
</div>
<figure id="A3.T5" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A3.T5.3" class="ltx_text" style="font-size:90%;">Table 5</span>: </span><span id="A3.T5.4" class="ltx_text" style="font-size:90%;">Gaussion test of length distributions.</span></figcaption>
<div id="A3.T5.5" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:138.0pt;height:21.8pt;vertical-align:-9.4pt;"><span class="ltx_transformed_inner" style="transform:translate(-48.6pt,7.7pt) scale(0.586509851235504,0.586509851235504) ;">
<table id="A3.T5.5.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A3.T5.5.1.1" class="ltx_tr">
<th id="A3.T5.5.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="A3.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T5.m1" class="ltx_Math" alttext="P_{\text{SW}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>SW</mtext></msub><annotation encoding="application/x-tex">P_{\text{SW}}</annotation></semantics></math></th>
<th id="A3.T5.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_tt"><math id="A3.T5.m2" class="ltx_Math" alttext="P_{\text{KS}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>KS</mtext></msub><annotation encoding="application/x-tex">P_{\text{KS}}</annotation></semantics></math> and <math id="A3.T5.m3" class="ltx_Math" alttext="P_{\text{shape}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>shape</mtext></msub><annotation encoding="application/x-tex">P_{\text{shape}}</annotation></semantics></math></th>
<th id="A3.T5.5.1.1.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T5.m4" class="ltx_Math" alttext="P_{\text{KS}}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mtext>KS</mtext></msub><annotation encoding="application/x-tex">P_{\text{KS}}</annotation></semantics></math></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A3.T5.5.1.2" class="ltx_tr">
<th id="A3.T5.5.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">All Responses</th>
<td id="A3.T5.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">20.0</td>
<th id="A3.T5.5.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t">52.3</th>
<td id="A3.T5.5.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t">62.9</td></tr>
<tr id="A3.T5.5.1.3" class="ltx_tr">
<th id="A3.T5.5.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">Correct Responses</th>
<td id="A3.T5.5.1.3.2" class="ltx_td ltx_align_center ltx_border_bb">27.7</td>
<th id="A3.T5.5.1.3.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb">60.0</th>
<td id="A3.T5.5.1.3.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb">74.3</td></tr>
</tbody>
</table>
</span></div>
</figure>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Optimal Length Comparison between ShorterBetter and <span id="A3.SS2.2" class="ltx_text ltx_font_italic">SmartThinker</span></h3>

<figure id="A3.F6" class="ltx_figure"><object type="image/svg+xml" data="2603.08000v1/opt_len_comp.svg" id="A3.F6.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:333/167;" width="333" height="167"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F6.3" class="ltx_text" style="font-size:90%;">Figure 6</span>: </span><span id="A3.F6.4" class="ltx_text" style="font-size:90%;">Comparison of optimal length under different pass counts.</span></figcaption>
</figure>
<div id="A3.SS2.p1" class="ltx_para">
<p id="A3.SS2.p1.1" class="ltx_p">We compare the optimal length of ShorterBetter and <span id="A3.SS2.p1.1.1" class="ltx_text ltx_font_italic">SmartThinker</span> under different pass counts using DeepSeek-R1-Distill-Qwen-1.5B, which is presented in  <a href="#A3.F6" title="Figure 6 ‣ C.2 Optimal Length Comparison between ShorterBetter and SmartThinker ‣ Appendix C Additional Experiments ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 6</span></a>. Since the model’s response length is generally proportional to the question difficulty, for ease of comparison, we show the ratio of optimal length to average length in the figure. As can be seen from the figure, the optimal length of <span id="A3.SS2.p1.1.2" class="ltx_text ltx_font_italic">SmartThinker</span> is significantly higher than that of ShorterBetter. This indicates that the length compression strategy of <span id="A3.SS2.p1.1.3" class="ltx_text ltx_font_italic">SmartThinker</span> is more moderate. From the benchmark tests in  <a href="#S4.T1" title="Table 1 ‣ 4 Experiment ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Table 1</span></a>, it can be observed that this more moderate compression strategy can maintain the model’s high-quality reasoning ability while achieving compression.</p>
</div>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p">We also observe that the optimal length does not change monotonically with the pass rate, indicating that the causes of model errors are diverse, possibly due to either overthinking or underthinking. This further highlights the importance of dynamically computing the optimal length.</p>
</div>
</section>
<section id="A3.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.3 </span>Out-of-Domain Tests</h3>

<figure id="A3.F7" class="ltx_figure"><object type="image/svg+xml" data="2603.08000v1/ood.svg" id="A3.F7.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:429/115;" width="429" height="115"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F7.4" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="A3.F7.5" class="ltx_text" style="font-size:90%;">Test results of baseline and <span id="A3.F7.5.1" class="ltx_text ltx_font_italic">SmartThinker</span> on three out-of-domain benchmarks</span></figcaption>
</figure>
<figure id="A3.F9" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A3.F9.fig1" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:165.6pt;"><object type="image/svg+xml" data="2603.08000v1/mmlu_best_subjects_pie_chart.svg" id="A3.F9.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/115;" width="229" height="115"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F9.fig1.1" class="ltx_text" style="font-size:90%;">Figure 8</span>: </span><span id="A3.F9.fig1.2" class="ltx_text" style="font-size:90%;">#Rank1 MMLU subjects of each method.</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A3.F9.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_middle" style="width:165.6pt;"><object type="image/svg+xml" data="2603.08000v1/mean_length_reduction_bar_detailed.svg" id="A3.F9.g2" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:229/115;" width="229" height="115"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F9.fig2.1" class="ltx_text" style="font-size:90%;">Figure 9</span>: </span><span id="A3.F9.fig2.2" class="ltx_text" style="font-size:90%;">Compression ratios of different methods on problems of various difficulty levels in Math500. </span></figcaption>
</figure></div></div>
</figure>
<div id="A3.SS3.p1" class="ltx_para">
<p id="A3.SS3.p1.1" class="ltx_p">To verify that the efficient reasoning ability trained on mathematical reasoning problems can generalize to other tasks without compromising model accuracy, we also conduct out-of-domain (OOD) tests on three additional benchmarks: MathQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib31" title="" class="ltx_ref">Amini et al., 2019</a>)</cite>, MMLU <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Hendrycks et al., 2020b</a>; <a href="#bib.bib33" title="" class="ltx_ref">Hendrycks et al., 2020a</a>)</cite>, LiveCodeBench <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib34" title="" class="ltx_ref">Jain et al., 2024</a>)</cite>, and HumanEval <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Chen, 2021</a>)</cite>.</p>
</div>
<div id="A3.SS3.p2" class="ltx_para">
<p id="A3.SS3.p2.1" class="ltx_p">We test the 1.5B models of all methods on these benchmarks. The results are shown in <a href="#A3.F7" title="Figure 7 ‣ C.3 Out-of-Domain Tests ‣ Appendix C Additional Experiments ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 7</span></a>, which shows that all methods except shorterBetter maintain or even improve accuracy while compressing output length, achieving comparable levels of efficiency and accuracy. We also counted the number of MMLU subjects in which each method ranked first, which is presented in <a href="#A3.F9" title="Figure 9 ‣ C.3 Out-of-Domain Tests ‣ Appendix C Additional Experiments ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 9</span></a>. The figure shows that <span id="A3.SS3.p2.1.1" class="ltx_text ltx_font_italic">SmartThinker</span> achieved the most first-place rankings, accounting for as high as 42%. This indicates that the capability learned by LRMs on math problems can be transferred to other domains.</p>
</div>
</section>
<section id="A3.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.4 </span>Length distribution on Math500 of varying difficulty</h3>

<div id="A3.SS4.p1" class="ltx_para">
<p id="A3.SS4.p1.1" class="ltx_p">We test the response length compression ratio of questions with different difficulty levels using the built-in difficulty labels of Math500 on a 1.5B model. The results are shown in  <a href="#A3.F9" title="Figure 9 ‣ C.3 Out-of-Domain Tests ‣ Appendix C Additional Experiments ‣ SmartThinker: Progressive Chain-of-Thought Length Calibration for Efficient Large Language Model Reasoning" class="ltx_ref ltx_refmacro_autoref"><span class="ltx_text ltx_ref_tag">Figure 9</span></a> It can be observed that under the 1.5B parameter scale, our method achieves the highest compression rate across all difficulty levels. We also notice that the compression ratio of <span id="A3.SS4.p1.1.1" class="ltx_text ltx_font_italic">SmartThinker</span> decreases as difficulty increases from level 1 to 4, but shows a significant rise at level 5, while the other methods exhibit more random length distributions. This indicates that models trained with the <span id="A3.SS4.p1.1.2" class="ltx_text ltx_font_italic">SmartThinker</span> approach tend to increase output length for harder questions to improve accuracy, whereas for extremely difficult questions, due to a significant drop in correctness, the model shortens its output to avoid unnecessary token waste.</p>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Demonstration of an Example</h2>

<div id="A4.p1" class="ltx_para">
<p id="A4.p1.1" class="ltx_p">In this section, we use a case to demonstrate the differences between the model trained with <span id="A4.p1.1.1" class="ltx_text ltx_font_italic">SmartThinker</span> and the Base Model in terms of response length and thinking structure. The example is shown in the boxes below.</p>
</div>
<div id="A4.p2" class="ltx_para">
<p id="A4.p2.1" class="ltx_p">In the example, the sequence generated by the Base Model uses fewer tokens in the Plan stage but repeatedly attempts during exploration, resulting in significant token consumption. In contrast, the sequence generated by <span id="A4.p2.1.1" class="ltx_text ltx_font_italic">SmartThinker</span> consumes more tokens in the Plan stage, enabling the model to derive the correct answer with fewer tokens during the exploration phase. This indicates that models trained with <span id="A4.p2.1.2" class="ltx_text ltx_font_italic">SmartThinker</span> optimize the structure of their chain-of-thought, performing thorough planning before attempting solutions, thereby streamlining the reasoning process while improving accuracy.</p>
</div>
<div class="ltx_pagination ltx_role_newpage"></div>
<div id="A4.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p3.pic1" class="ltx_picture" height="219.69" overflow="visible" version="1.1" viewBox="0 0 477.38 219.69" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,219.69) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#04A5E5;" fill="#04A5E5" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 213.78 C 0 217.04 2.64 219.69 5.91 219.69 L 471.47 219.69 C 474.73 219.69 477.38 217.04 477.38 213.78 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#E6F6FC;" fill="#E6F6FC" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 195.73 L 475.41 195.73 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 204.33)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.p3.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p3.pic1.1.1" class="ltx_p"><span id="A4.p3.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#EFF1F5;">Question</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 13.78)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:12.3em;--ltx-fo-depth:0em;font-size:10pt;" height="170.14" overflow="visible" transform="matrix(1 0 0 -1 0 170.14)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A4.p3.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p3.pic1.p2" class="ltx_para">
<span id="A4.p3.pic1.p2.1" class="ltx_p"><span id="A4.p3.pic1.p2.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">The 9 members of a baseball team went to an ice cream parlor after their game. Each player had a singlescoop cone of chocolate, vanilla, or strawberry ice cream. At least one player chose each flavor, and the number of players who chose chocolate was greater than the number of players who chose vanilla, which was greater than the number of players who chose strawberry. Let <math id="A4.p3.pic1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> be the number of different assignments of flavors to players that meet these conditions. Find the remainder when <math id="A4.p3.pic1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is divided by 1000.</span></span>
</span>
<span id="A4.p3.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p3.pic1.p1.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#04A5E5;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#04A5E5" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p3.pic1.p3" class="ltx_para">
<span id="A4.p3.pic1.p3.1" class="ltx_p"><span id="A4.p3.pic1.p3.1.1" class="ltx_text" style="--ltx-fg-color:#000000;">Ground Truth: 16</span></span>
</span></span></span></span></foreignObject></g></g></svg></span>
</div>
<div class="ltx_pagination ltx_role_start_2_columns"></div>
<div id="A4.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1" class="ltx_picture" height="746.58" overflow="visible" version="1.1" viewBox="0 0 477.38 746.58" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,746.58) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#E64553;" fill="#E64553" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 740.68 C 0 743.94 2.64 746.58 5.91 746.58 L 471.47 746.58 C 474.73 746.58 477.38 743.94 477.38 740.68 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FDECEE;" fill="#FDECEE" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 725.16 L 475.41 725.16 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 731.07)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.69em;--ltx-fo-depth:0em;font-size:10pt;" height="9.61" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.p4.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p4.pic1.1.1" class="ltx_p"><span id="A4.p4.pic1.1.1.1" class="ltx_text" style="--ltx-fg-color:#EFF1F5;">Base Model: 16404 Tokens</span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:50.36em;--ltx-fo-depth:0.19em;font-size:10pt;" height="699.58" overflow="visible" transform="matrix(1 0 0 -1 0 696.89)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A4.p4.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p4.pic1.p6" class="ltx_para">
<span id="A4.p4.pic1.p6.1" class="ltx_p"><span id="A4.p4.pic1.p6.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Understand the Question: 94 Tokens<span id="A4.p4.pic1.p6.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p6.2" class="ltx_p"><span id="A4.p4.pic1.p6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">&lt;think&gt;</span></span>
<span id="A4.p4.pic1.p6.3" class="ltx_p"><span id="A4.p4.pic1.p6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Okay, so I have this problem where 9 baseball team members each ordered a singlescoop ice cream <math id="A4.p4.pic1.m1" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math> I need to find the number of different assignments that meet these conditions and then find the remainder when that number is divided by 1000.</span></span>
</span>
<span id="A4.p4.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1.p1.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#E64553;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#E64553" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p4.pic1.p7" class="ltx_para">
<span id="A4.p4.pic1.p7.1" class="ltx_p"><span id="A4.p4.pic1.p7.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Plan: 134 Tokens<span id="A4.p4.pic1.p7.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p7.2" class="ltx_p"><span id="A4.p4.pic1.p7.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Hmm, okay. Let’s break this down step by step.
First, without any restrictions <math id="A4.p4.pic1.m2" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p7.3" class="ltx_p"><span id="A4.p4.pic1.p7.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, step one is to compute the number of <math id="A4.p4.pic1.m3" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
</span>
<span id="A4.p4.pic1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1.p2.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#E64553;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#E64553" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p4.pic1.p8" class="ltx_para">
<span id="A4.p4.pic1.p8.1" class="ltx_p"><span id="A4.p4.pic1.p8.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Initial Attempt: 5375 Tokens<span id="A4.p4.pic1.p8.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p8.2" class="ltx_p"><span id="A4.p4.pic1.p8.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, the total number of onto functions is given by the inclusion-exclusion principle <math id="A4.p4.pic1.m4" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p8.3" class="ltx_p"><span id="A4.p4.pic1.p8.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, hold on, c=4, v + s=5 <math id="A4.p4.pic1.m5" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p8.4" class="ltx_p"><span id="A4.p4.pic1.p8.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, hold on. Wait, we have to make sure <math id="A4.p4.pic1.m6" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p8.5" class="ltx_p"><span id="A4.p4.pic1.p8.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, hold on, if c=3, then v must be 2 or 1 <math id="A4.p4.pic1.m7" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p8.6" class="ltx_p"><span id="A4.p4.pic1.p8.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">But that might be more complicated.</span></span>
</span>
<span id="A4.p4.pic1.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1.p3.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#E64553;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#E64553" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p4.pic1.p9" class="ltx_para">
<span id="A4.p4.pic1.p9.1" class="ltx_p"><span id="A4.p4.pic1.p9.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Repeated Attempts: 10025 Tokens<span id="A4.p4.pic1.p9.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p9.2" class="ltx_p"><span id="A4.p4.pic1.p9.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Alternatively, perhaps using generating functions or other combinatorial techniques.</span></span>
<span id="A4.p4.pic1.p9.3" class="ltx_p"><span id="A4.p4.pic1.p9.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, another approach: <math id="A4.p4.pic1.m8" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p9.4" class="ltx_p"><span id="A4.p4.pic1.p9.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Alternatively, perhaps the number of <math id="A4.p4.pic1.m9" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p9.5" class="ltx_p"><span id="A4.p4.pic1.p9.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Alternatively, perhaps I can compute <math id="A4.p4.pic1.m10" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p9.6" class="ltx_p"><span id="A4.p4.pic1.p9.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">Therefore, the answer is 422.</span></span>
</span>
<span id="A4.p4.pic1.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1.p4.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#E64553;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#E64553" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p4.pic1.p10" class="ltx_para">
<span id="A4.p4.pic1.p10.1" class="ltx_p"><span id="A4.p4.pic1.p10.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Double-Check: 311 Tokens<span id="A4.p4.pic1.p10.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p10.2" class="ltx_p"><span id="A4.p4.pic1.p10.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">But, in the 5-player case, 50 is the number of assignments where c &gt;v &gt;s<math id="A4.p4.pic1.m11" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p10.3" class="ltx_p"><span id="A4.p4.pic1.p10.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Therefore, the answer is 422.</span></span>
<span id="A4.p4.pic1.p10.4" class="ltx_p"><span id="A4.p4.pic1.p10.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">But I’m not entirely confident<math id="A4.p4.pic1.m12" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p10.5" class="ltx_p"><span id="A4.p4.pic1.p10.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">Therefore, I think the answer is 422.</span></span>
<span id="A4.p4.pic1.p10.6" class="ltx_p"><span id="A4.p4.pic1.p10.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">&lt;/think&gt;</span></span>
</span>
<span id="A4.p4.pic1.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p4.pic1.p5.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#E64553;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#E64553" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p4.pic1.p11" class="ltx_para">
<span id="A4.p4.pic1.p11.1" class="ltx_p"><span id="A4.p4.pic1.p11.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Answer: 568 Tokens<span id="A4.p4.pic1.p11.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p4.pic1.p11.2" class="ltx_p"><span id="A4.p4.pic1.p11.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">To solve the problem, we need to find <math id="A4.p4.pic1.m13" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p4.pic1.p11.3" class="ltx_p"><span id="A4.p4.pic1.p11.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Thus, the final answer is <math id="A4.p4.pic1.m14" class="ltx_Math" alttext="\boxed{422}" display="inline" intent=":literal"><semantics><menclose notation="box"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">422</mn></menclose><annotation encoding="application/x-tex">\boxed{422}</annotation></semantics></math>.</span></span>
</span></span></span></span></foreignObject></g></g></svg></span>
</div>
<div id="A4.p5" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p5.pic1" class="ltx_picture" height="702.28" overflow="visible" version="1.1" viewBox="0 0 477.38 702.28" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,702.28) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#40A02B;" fill="#40A02B" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 696.38 C 0 699.64 2.64 702.28 5.91 702.28 L 471.47 702.28 C 474.73 702.28 477.38 699.64 477.38 696.38 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#ECF6EA;" fill="#ECF6EA" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 664.26 L 475.41 664.26 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 670.16)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:1.89em;--ltx-fo-depth:0em;font-size:10pt;" height="26.21" overflow="visible" transform="matrix(1 0 0 -1 0 26.21)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A4.p5.pic1.1" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p5.pic1.1.1" class="ltx_p"><span id="A4.p5.pic1.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#EFF1F5;">SmartThinker<span id="A4.p5.pic1.1.1.1.1" class="ltx_text ltx_font_upright">: 2935 Tokens</span></span></span>
</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 16.47)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:45.96em;--ltx-fo-depth:0.19em;font-size:10pt;" height="638.67" overflow="visible" transform="matrix(1 0 0 -1 0 635.98)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A4.p5.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:31.37em;">
<span id="A4.p5.pic1.p5" class="ltx_para">
<span id="A4.p5.pic1.p5.1" class="ltx_p"><span id="A4.p5.pic1.p5.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Understand the Problem: 108 Tokens<span id="A4.p5.pic1.p5.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p5.pic1.p5.2" class="ltx_p"><span id="A4.p5.pic1.p5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">&lt;think&gt;</span></span>
<span id="A4.p5.pic1.p5.3" class="ltx_p"><span id="A4.p5.pic1.p5.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Alright, so I have this problem where 9 players from a baseball team went to an ice cream parlor <math id="A4.p5.pic1.m1" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p5.4" class="ltx_p"><span id="A4.p5.pic1.p5.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">I need to find the number of different assignments of flavors to players that meet these conditions, and then find the remainder when that number is divided by 1000.</span></span>
</span>
<span id="A4.p5.pic1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p5.pic1.p1.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#40A02B;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#40A02B" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p5.pic1.p6" class="ltx_para">
<span id="A4.p5.pic1.p6.1" class="ltx_p"><span id="A4.p5.pic1.p6.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Plan: 487 Tokens<span id="A4.p5.pic1.p6.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p5.pic1.p6.2" class="ltx_p"><span id="A4.p5.pic1.p6.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Okay, let me try to break this down step by step.</span></span>
<span id="A4.p5.pic1.p6.3" class="ltx_p"><span id="A4.p5.pic1.p6.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">First, without any restrictions <math id="A4.p5.pic1.m2" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p6.4" class="ltx_p"><span id="A4.p5.pic1.p6.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">But wait, it’s not just about the counts <math id="A4.p5.pic1.m3" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p6.5" class="ltx_p"><span id="A4.p5.pic1.p6.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, the problem reduces to:</span></span>
<span id="A4.p5.pic1.p6.6" class="ltx_p"><math id="A4.p5.pic1.m4" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math><span id="A4.p5.pic1.p6.6.1" class="ltx_text"></span></span>
</span>
<span id="A4.p5.pic1.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p5.pic1.p2.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#40A02B;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#40A02B" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p5.pic1.p7" class="ltx_para">
<span id="A4.p5.pic1.p7.1" class="ltx_p"><span id="A4.p5.pic1.p7.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Explore the Solution: 1564 Tokens<span id="A4.p5.pic1.p7.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p5.pic1.p7.2" class="ltx_p"><span id="A4.p5.pic1.p7.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">So, first step is to find all ordered triples (C, V, S) with C &gt;V &gt;S <math id="A4.p5.pic1.m5" class="ltx_Math" alttext="\geq" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">≥</mo><annotation encoding="application/x-tex">\geq</annotation></semantics></math> 1 and C + V + S = 9.</span></span>
<span id="A4.p5.pic1.p7.3" class="ltx_p"><math id="A4.p5.pic1.m6" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math><span id="A4.p5.pic1.p7.3.1" class="ltx_text"></span></span>
<span id="A4.p5.pic1.p7.4" class="ltx_p"><span id="A4.p5.pic1.p7.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, but since C &gt;V &gt;S, each triple is ordered <math id="A4.p5.pic1.m7" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math>
Wait, no, actually, for each such partition <math id="A4.p5.pic1.m8" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math>
Wait, no, a + b + c = 9, so if a is as large as possible <math id="A4.p5.pic1.m9" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p7.5" class="ltx_p"><math id="A4.p5.pic1.m10" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math><span id="A4.p5.pic1.p7.5.1" class="ltx_text"></span></span>
<span id="A4.p5.pic1.p7.6" class="ltx_p"><span id="A4.p5.pic1.p7.6.1" class="ltx_text" style="--ltx-fg-color:#000000;">Thus, the remainder is 16.</span></span>
</span>
<span id="A4.p5.pic1.p3" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p5.pic1.p3.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#40A02B;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#40A02B" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p5.pic1.p8" class="ltx_para">
<span id="A4.p5.pic1.p8.1" class="ltx_p"><span id="A4.p5.pic1.p8.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Double-Check: 269 Tokens<span id="A4.p5.pic1.p8.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p5.pic1.p8.2" class="ltx_p"><span id="A4.p5.pic1.p8.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">Wait, is that it? That seems straightforward.</span></span>
<span id="A4.p5.pic1.p8.3" class="ltx_p"><span id="A4.p5.pic1.p8.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">But let me double-check the calculations. <math id="A4.p5.pic1.m11" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p8.4" class="ltx_p"><span id="A4.p5.pic1.p8.4.1" class="ltx_text" style="--ltx-fg-color:#000000;">Therefore, the answer is 16.</span></span>
<span id="A4.p5.pic1.p8.5" class="ltx_p"><span id="A4.p5.pic1.p8.5.1" class="ltx_text" style="--ltx-fg-color:#000000;">**Final Answer**</span></span>
<span id="A4.p5.pic1.p8.6" class="ltx_p"><math id="A4.p5.pic1.m12" class="ltx_Math ltx_framed ltx_framed_rectangle" display="block" intent=":literal"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn></math></span>
<span id="A4.p5.pic1.p8.7" class="ltx_p"><span id="A4.p5.pic1.p8.7.1" class="ltx_text" style="--ltx-fg-color:#000000;">&lt;/think&gt;</span></span>
</span>
<span id="A4.p5.pic1.p4" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p5.pic1.p4.pic1" class="ltx_picture" color="#000000" height="23.62" overflow="visible" version="1.1" viewBox="0 0 434.07 23.62" width="434.07"><g style="--ltx-stroke-color:#40A02B;--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0" stroke="#40A02B" stroke-dasharray="2.84528pt,2.84528pt" stroke-dashoffset="0.0pt" stroke-width="0.4pt" transform="translate(0,23.62) matrix(1 0 0 -1 0 0) translate(0,11.81)"><path style="fill:none" d="M -19.68 0 L 453.75 0"></path></g></svg></span>
</span>
<span id="A4.p5.pic1.p9" class="ltx_para">
<span id="A4.p5.pic1.p9.1" class="ltx_p"><span id="A4.p5.pic1.p9.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Answer: 507 Tokens<span id="A4.p5.pic1.p9.1.1.1" class="ltx_text"></span></span></span>
<span id="A4.p5.pic1.p9.2" class="ltx_p"><span id="A4.p5.pic1.p9.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">The problem involves finding the number of <math id="A4.p5.pic1.m13" class="ltx_Math" alttext="\cdots" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#000000;" mathcolor="#000000">⋯</mo><annotation encoding="application/x-tex">\cdots</annotation></semantics></math></span></span>
<span id="A4.p5.pic1.p9.3" class="ltx_p"><span id="A4.p5.pic1.p9.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">Thus, the remainder when <math id="A4.p5.pic1.m14" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> is divided by 1000 is <math id="A4.p5.pic1.m15" class="ltx_Math" alttext="\boxed{16}" display="inline" intent=":literal"><semantics><menclose notation="box"><mn style="--ltx-fg-color:#000000;" mathcolor="#000000">16</mn></menclose><annotation encoding="application/x-tex">\boxed{16}</annotation></semantics></math>.</span></span>
</span></span></span></span></foreignObject></g></g></svg></span>
</div>
