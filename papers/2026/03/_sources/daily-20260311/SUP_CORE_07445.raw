</thead>
<tbody class="ltx_tbody">
<tr id="S4.T5.5.2" class="ltx_tr">
<th id="S4.T5.5.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_t">
<span id="S4.T5.5.2.1.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S4.T5.5.2.1.1.1" class="ltx_p">Full-vocab KL</span>
</span></th>
<td id="S4.T5.5.2.2" class="ltx_td ltx_align_center ltx_border_t">89.30</td>
<td id="S4.T5.5.2.3" class="ltx_td ltx_align_center ltx_border_t">36.74</td>
<td id="S4.T5.5.2.4" class="ltx_td ltx_align_center ltx_border_t">35.00</td>
<td id="S4.T5.5.2.5" class="ltx_td ltx_align_center ltx_border_t">73.00</td></tr>
<tr id="S4.T5.5.3" class="ltx_tr">
<th id="S4.T5.5.3.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row">
<span id="S4.T5.5.3.1.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S4.T5.5.3.1.1.1" class="ltx_p">+Safety tokens</span>
</span></th>
<td id="S4.T5.5.3.2" class="ltx_td ltx_align_center">88.50</td>
<td id="S4.T5.5.3.3" class="ltx_td ltx_align_center">25.88</td>
<td id="S4.T5.5.3.4" class="ltx_td ltx_align_center">28.00</td>
<td id="S4.T5.5.3.5" class="ltx_td ltx_align_center">69.00</td></tr>
<tr id="S4.T5.5.4" class="ltx_tr">
<th id="S4.T5.5.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row">
<span id="S4.T5.5.4.1.1" class="ltx_inline-block ltx_align_top" style="width:68.3pt;">
<span id="S4.T5.5.4.1.1.1" class="ltx_p">+Safety weights</span>
</span></th>
<td id="S4.T5.5.4.2" class="ltx_td ltx_align_center">89.20</td>
<td id="S4.T5.5.4.3" class="ltx_td ltx_align_center">18.85</td>
<td id="S4.T5.5.4.4" class="ltx_td ltx_align_center">23.50</td>
