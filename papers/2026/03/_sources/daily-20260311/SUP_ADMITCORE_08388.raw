<span id="S3.T1.2.1.3.1.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.2.1.3.1.1.1.1" class="ltx_text" style="font-size:90%;">Script-Parsing-Error</span></span>
</span></td>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S3.T1.2.1.3.2.1" class="ltx_inline-block ltx_align_middle" style="width:37.0pt;">
<span id="S3.T1.2.1.3.2.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.2.1.3.2.1.1.1" class="ltx_text" style="font-size:90%;">High</span></span>
</span></td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S3.T1.2.1.3.3.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;">
<span id="S3.T1.2.1.3.3.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.2.1.3.3.1.1.1" class="ltx_text" style="font-size:90%;">[putin] &lt;obj&gt;</span></span>
</span></td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_left ltx_align_middle ltx_border_r ltx_border_t">
<span id="S3.T1.2.1.3.4.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;">
<span id="S3.T1.2.1.3.4.1.1" class="ltx_p ltx_align_center"><span id="S3.T1.2.1.3.4.1.1.1" class="ltx_text" style="font-size:90%;">Action lacks necessary parameters, resulting in a parsing failure.</span></span>
