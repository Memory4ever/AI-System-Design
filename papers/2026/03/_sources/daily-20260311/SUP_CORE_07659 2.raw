<th id="S4.T4.3.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MMB-E</th>
<th id="S4.T4.3.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MME</th>
<th id="S4.T4.3.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">CCB</th>
<th id="S4.T4.3.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">MMS</th>
