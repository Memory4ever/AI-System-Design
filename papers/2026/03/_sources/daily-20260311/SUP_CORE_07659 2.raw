<th id="S4.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S4.T2.3.1.2.1" class="ltx_text ltx_font_bold">B Subset</span></th>
<th id="S4.T2.3.1.3" class="ltx_td ltx_th ltx_th_column ltx_border_tt"></th>
<th id="S4.T2.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="3"><span id="S4.T2.3.1.4.1" class="ltx_text ltx_font_bold">S Subset</span></th>
