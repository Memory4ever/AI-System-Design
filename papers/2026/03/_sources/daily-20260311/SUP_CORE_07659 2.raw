<th id="S4.T2.3.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Others</th>
<th id="S4.T2.3.2.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t">Overall</th>
