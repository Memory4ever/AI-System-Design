<tbody class="ltx_tbody">
<tr id="S4.T2.3.3" class="ltx_tr">
<th id="S4.T2.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">LLaVA-NeXT</th>
<td id="S4.T2.3.3.2" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T2.3.3.3" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T2.3.3.4" class="ltx_td ltx_align_center ltx_border_t">0.0</td>
<td id="S4.T2.3.3.5" class="ltx_td ltx_border_t"></td>
<td id="S4.T2.3.3.6" class="ltx_td ltx_align_center ltx_border_t">39.2</td>
<td id="S4.T2.3.3.7" class="ltx_td ltx_align_center ltx_border_t">37.63</td>
