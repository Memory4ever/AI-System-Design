<tr id="S3.T1.3.6" class="ltx_tr">
<th id="S3.T1.3.6.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;">Qwen2-VL (Others)</th>
