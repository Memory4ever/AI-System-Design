<th id="S5.T1.12.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_tt"><span id="S5.T1.12.1.2.1" class="ltx_text ltx_font_bold">Setting</span></th>
<td id="S5.T1.12.1.3" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T1.m19" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S5.T1.12.1.3.1" class="ltx_text ltx_font_bold">=4</span></td>
<td id="S5.T1.12.1.4" class="ltx_td ltx_align_center ltx_border_tt"><math id="S5.T1.m20" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math><span id="S5.T1.12.1.4.1" class="ltx_text ltx_font_bold">=8</span></td>
