<td id="A1.T6.2.3.2" class="ltx_td ltx_align_center">20.9 <math id="A1.T6.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 3.9</td>
<td id="A1.T6.2.3.3" class="ltx_td ltx_align_center">41.8 <math id="A1.T6.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 7.8</td>
