<td id="A3.T12.2.5.2" class="ltx_td ltx_align_center ltx_border_t">7</td></tr>
<tr id="A3.T12.2.6" class="ltx_tr">
<th id="A3.T12.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Top-<math id="A3.T12.m1" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> settings tested</th>
<td id="A3.T12.2.6.2" class="ltx_td ltx_align_center">3 (4, 8, 16)</td></tr>
