<td id="A1.T6.2.4.4" class="ltx_td ltx_align_center ltx_border_bb">71,956 <math id="A1.T6.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 23,449</td></tr>
