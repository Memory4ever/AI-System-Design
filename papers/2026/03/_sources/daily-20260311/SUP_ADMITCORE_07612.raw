<tr id="A4.T14.2.1" class="ltx_tr">
<th id="A4.T14.2.1.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.1.1" class="ltx_text ltx_font_bold">Pub Rank</span></th>
