<tr id="A4.T14.2.7" class="ltx_tr">
<td id="A4.T14.2.7.1" class="ltx_td ltx_align_center">#6</td>
<td id="A4.T14.2.7.2" class="ltx_td ltx_align_center">0.856</td>
<td id="A4.T14.2.7.3" class="ltx_td ltx_align_center">0.839</td>
