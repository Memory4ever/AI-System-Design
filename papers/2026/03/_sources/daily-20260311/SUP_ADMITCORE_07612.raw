<th id="A4.T14.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.4.1" class="ltx_text ltx_font_bold">Priv Rank</span></th>
<th id="A4.T14.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.5.1" class="ltx_text ltx_font_bold">Score <math id="A4.T14.m7" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></span></th>
<th id="A4.T14.2.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T14.2.1.6.1" class="ltx_text ltx_font_bold">Rank <math id="A4.T14.m8" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A4.T14.2.2" class="ltx_tr">
<td id="A4.T14.2.2.1" class="ltx_td ltx_align_center ltx_border_t">#1 <math id="A4.T14.m9" class="ltx_Math" alttext="\star" display="inline" intent=":literal"><semantics><mo>⋆</mo><annotation encoding="application/x-tex">\star</annotation></semantics></math></td>
