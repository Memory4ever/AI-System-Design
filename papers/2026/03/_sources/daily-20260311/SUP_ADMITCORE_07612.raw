ts</span><span id="lstnumberx26.23" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx27" class="ltx_listingline"><span id="lstnumberx27.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">If</span><span id="lstnumberx27.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">evidence</span><span id="lstnumberx27.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is</span><span id="lstnumberx27.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">insufficient</span><span id="lstnumberx27.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx27.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">set</span><span id="lstnumberx27.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx27.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is_blank</span><span id="lstnumberx27.13" class="ltx_text ltx_font_typewriter">=</span><span id="lstnumberx27.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">true</span><span id="lstnumberx27.15" class="ltx_text ltx_font_typewriter">.</span>
</div>
<div id="lstnumberx28" class="ltx_listingline">
</div>
<div id="lstnumberx29" class="ltx_listingline"><span id="lstnumberx29.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Output</span><span id="lstnumberx29.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">JSON</span><span id="lstnumberx29.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">with</span><span id="lstnumberx29.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx29.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">fields</span><span id="lstnumberx29.8" class="ltx_text ltx_font_typewriter">:</span>
</div>
<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx30.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx30.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx30.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx30.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx30.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Natural</span><span id="lstnumberx30.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx30.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">language</span><span id="lstnumberx30.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx30.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span>
</div>
<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx31.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer_value</span><span id="lstnumberx31.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx31.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Extracted</span><span id="lstnumberx31.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">numeric</span><span id="lstnumberx31.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">or</span><span id="lstnumberx31.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">categorical</span><span id="lstnumberx31.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx31.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">value</span>
</div>
<div id="lstnumberx32" class="ltx_listingline"><span id="lstnumberx32.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx32.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ref_id</span><span id="lstnumberx32.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx32.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">List</span><span id="lstnumberx32.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx32.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">source</span><span id="lstnumberx32.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">document</span><span id="lstnumberx32.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx32.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">IDs</span>
</div>
<div id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx33.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx33.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">explanation</span><span id="lstnumberx33.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx33.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx33.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Brief</span><span id="lstnumberx33.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx33.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">reasoning</span><span id="lstnumberx33.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx33.10" class="ltx_text ltx_font_typewriter">(</span><span id="lstnumberx33.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter">optional</span><span id="lstnumberx33.12" class="ltx_text ltx_font_typewriter">)</span>
</div>
<div id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_font_typewriter">-</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">is_blank</span><span id="lstnumberx34.4" class="ltx_text ltx_font_typewriter">:</span><span id="lstnumberx34.5" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter">true</span><span id="lstnumberx34.7" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">if</span><span id="lstnumberx34.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">cannot</span><span id="lstnumberx34.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">answer</span><span id="lstnumberx34.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">from</span><span id="lstnumberx34.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx34.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">context</span>
</div>
</div>
</div>
</section>
<section id="A1.SS3.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Context Length Management.</h4>

<div id="A1.SS3.SSS0.Px2.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px2.p1.1" class="ltx_p">We limit total context to 8,000 tokens to avoid degradation from overly long contexts. When retrieved content exceeds this limit, we truncate lower-ranked nodes while preserving the hierarchical context of top-ranked nodes.</p>
</div>
</section>
<section id="A1.SS3.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Ensemble Voting.</h4>

<div id="A1.SS3.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px3.p1.1" class="ltx_p">Ensemble voting aggregates <math id="A1.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> independent runs. For answer voting, we normalize answers (lowercase, strip whitespace, parse numerics) before counting. Algorithm <a href="#alg5" title="Algorithm 5 ‣ Ensemble Voting. ‣ A.3 Answer Generation Pipeline ‣ Appendix A Implementation Details ‣ KohakuRAG: A simple RAG framework with hierarchical document indexing" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> presents the complete voting procedure.</p>
</div>
<figure id="alg5" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg5.3" class="ltx_text ltx_font_bold">Algorithm 5</span> </span> Ensemble Voting with Blank Handling</figcaption>
<div id="alg5.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg5.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">1:</span>
                
                
              Predictions <math id="alg5.l1.m1" class="ltx_Math" alttext="\mathcal{A}=\{(a^{(j)},R^{(j)},b^{(j)})\}_{j=1}^{m}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{A}=\{(a^{(j)},R^{(j)},b^{(j)})\}_{j=1}^{m}</annotation></semantics></math>, <span id="alg5.l1.2" class="ltx_text ltx_font_typewriter">ignore_blank</span>, <span id="alg5.l1.3" class="ltx_text ltx_font_typewriter">vote_mode</span>

</div>
<div id="alg5.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">2:</span>
                
                
              Final prediction <math id="alg5.l2.m1" class="ltx_Math" alttext="(a,R,b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>R</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a,R,b)</annotation></semantics></math>

</div>
<div id="alg5.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">3:</span>
                
                
              
</div>
<div id="alg5.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">4:</span>
                
                
              <span id="alg5.l4.2" class="ltx_text ltx_font_bold">function</span> <span id="alg5.l4.3" class="ltx_text ltx_font_smallcaps">EnsembleVote</span>(<math id="alg5.l4.m1" class="ltx_Math" alttext="\mathcal{A}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒜</mi><annotation encoding="application/x-tex">\mathcal{A}</annotation></semantics></math>, <span id="alg5.l4.4" class="ltx_text ltx_font_typewriter">ignore_blank</span>, <span id="alg5.l4.5" class="ltx_text ltx_font_typewriter">vote_mode</span>)

</div>
<div id="alg5.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">5:</span>
                
                
                <span id="alg5.l5.2" class="ltx_text ltx_font_bold">if</span> <span id="alg5.l5.3" class="ltx_text ltx_font_typewriter">ignore_blank</span> <span id="alg5.l5.4" class="ltx_text ltx_font_bold">and</span> <math id="alg5.l5.m1" class="ltx_Math" alttext="\exists j:b^{(j)}=0" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∃</mo><mi>j</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\exists j:b^{(j)}=0</annotation></semantics></math> <span id="alg5.l5.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg5.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">6:</span>
                
                
                 <math id="alg5.l6.m1" class="ltx_Math" alttext="\mathcal{A}\leftarrow\{(a^{(j)},R^{(j)},b^{(j)})\in\mathcal{A}:b^{(j)}=0\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>R</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}\leftarrow\{(a^{(j)},R^{(j)},b^{(j)})\in\mathcal{A}:b^{(j)}=0\}</annotation></semantics></math> <span id="alg5.l6.2" class="ltx_text" style="float:right;"><math id="alg5.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Filter blanks
</span>
</div>
<div id="alg5.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">7:</span>
                
                
                <span id="alg5.l7.2" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l7.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg5.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8:</span>
                
                
              
</div>
<div id="alg5.l9" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">9:</span>
                
                
                <span id="alg5.l9.2" class="ltx_text ltx_font_bold">if</span> <math id="alg5.l9.m1" class="ltx_Math" alttext="\forall j:b^{(j)}=1" display="inline" intent=":literal"><semantics><mrow><mrow><mo rspace="0.167em">∀</mo><mi>j</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>b</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\forall j:b^{(j)}=1</annotation></semantics></math> <span id="alg5.l9.3" class="ltx_text ltx_font_bold">then</span> <span id="alg5.l9.4" class="ltx_text" style="float:right;"><math id="alg5.l9.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> All abstained
</span>
</div>
<div id="alg5.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">10:</span>
                
                
                 <span id="alg5.l10.2" class="ltx_text ltx_font_bold">return</span> <math id="alg5.l10.m1" class="ltx_Math" alttext="(\texttt{null},\emptyset,1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mtext class="ltx_mathvariant_monospace">null</mtext><mo>,</mo><mi mathvariant="normal">∅</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\texttt{null},\emptyset,1)</annotation></semantics></math>

</div>
<div id="alg5.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">11:</span>
                
                
                <span id="alg5.l11.2" class="ltx_text ltx_font_bold">end</span> <span id="alg5.l11.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg5.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">12:</span>
                
                
              
</div>
<div id="alg5.l13" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">13:</span>
                
                
                <math id="alg5.l13.m1" class="ltx_Math" alttext="\mathcal{G}\leftarrow\textsc{GroupBy}(\mathcal{A},\textsc{Normalize}(a))" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒢</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">GroupBy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi><mo>,</mo><mrow><mtext class="ltx_font_smallcaps">Normalize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}\leftarrow\textsc{GroupBy}(\mathcal{A},\textsc{Normalize}(a))</annotation></semantics></math> <span id="alg5.l13.2" class="ltx_text" style="float:right;"><math id="alg5.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Group by answer
</span>
</div>
<div id="alg5.l14" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">14:</span>
                
                
                <math id="alg5.l14.m1" class="ltx_Math" alttext="a\leftarrow\arg\max_{g\in\mathcal{G}}|g|" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo stretchy="false">←</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>g</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒢</mi></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>g</mi><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">a\leftarrow\arg\max_{g\in\mathcal{G}}|g|</annotation></semantics></math> <span id="alg5.l14.2" class="ltx_text" style="float:right;"><math id="alg5.l14.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Plurality vote
</span>
</div>
<div id="alg5.l15" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">15:</span>
                
                
                <math id="alg5.l15.m1" class="ltx_Math" alttext="\mathcal{A}_{a}\leftarrow\{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}:\textsc{Normalize}(a^{\prime})=a\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>a</mi></msub><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒜</mi></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mtext class="ltx_font_smallcaps">Normalize</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mi>a</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{A}_{a}\leftarrow\{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}:\textsc{Normalize}(a^{\prime})=a\}</annotation></semantics></math>

</div>
<div id="alg5.l16" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">16:</span>
                
                
              
</div>
<div id="alg5.l17" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">17:</span>
                
                
                <span id="alg5.l17.2" class="ltx_text ltx_font_bold">if</span> <span id="alg5.l17.3" class="ltx_text ltx_font_typewriter">vote_mode</span> = <span id="alg5.l17.4" class="ltx_text ltx_font_smallcaps">AnswerPriority</span> <span id="alg5.l17.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg5.l18" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">18:</span>
                
                
                 <math id="alg5.l18.m1" class="ltx_Math" alttext="R\leftarrow\textsc{MajorityVote}(\{R^{\prime}:(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}\})" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">MajorityVote</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msup><mi>R</mi><mo>′</mo></msup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>a</mi></msub></mrow><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow\textsc{MajorityVote}(\{R^{\prime}:(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}\})</annotation></semantics></math>

</div>
<div id="alg5.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">19:</span>
                
                
                <span id="alg5.l19.2" class="ltx_text ltx_font_bold">else</span> <span id="alg5.l19.3" class="ltx_text ltx_font_bold">if</span> <span id="alg5.l19.4" class="ltx_text ltx_font_typewriter">vote_mode</span> = <span id="alg5.l19.5" class="ltx_text ltx_font_smallcaps">Union</span> <span id="alg5.l19.6" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg5.l20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">20:</span>
                
                
                 <math id="alg5.l20.m1" class="ltx_Math" alttext="R\leftarrow\bigcup_{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}}R^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>⋃</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>a</mi></msub></mrow></msub><msup><mi>R</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow\bigcup_{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}}R^{\prime}</annotation></semantics></math>

</div>
<div id="alg5.l21" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">21:</span>
                
                
                <span id="alg5.l21.2" class="ltx_text ltx_font_bold">else</span> <span id="alg5.l21.3" class="ltx_text ltx_font_bold">if</span> <span id="alg5.l21.4" class="ltx_text ltx_font_typewriter">vote_mode</span> = <span id="alg5.l21.5" class="ltx_text ltx_font_smallcaps">Intersection</span> <span id="alg5.l21.6" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg5.l22" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">22:</span>
                
                
                 <math id="alg5.l22.m1" class="ltx_Math" alttext="R\leftarrow\bigcap_{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}}R^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo rspace="0.111em" stretchy="false">←</mo><mrow><msub><mo>⋂</mo><mrow><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mo>′</mo></msup><mo>,</mo><msup><mi>R</mi><mo>′</mo></msup><mo>,</mo><msup><mi>b</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒜</mi><mi>a</mi></msub></mrow></msub><msup><mi>R</mi><mo>′</mo></msup></mrow></mrow><annotation encoding="application/x-tex">R\leftarrow\bigcap_{(a^{\prime},R^{\prime},b^{\prime})\in\mathcal{A}_{a}}R^{\prime}</annotation></semantics></math>

</div>
