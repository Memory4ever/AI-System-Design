<th id="A2.T9.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A2.T9.2.1.5.1" class="ltx_text ltx_font_bold">img <math id="A2.T9.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>=8</span></th></tr>
