<th id="A1.T6.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T6.2.1.2.1" class="ltx_text ltx_font_bold">Matches</span></th>
<th id="A1.T6.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T6.2.1.3.1" class="ltx_text ltx_font_bold">Snippets</span></th>
<th id="A1.T6.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A1.T6.2.1.4.1" class="ltx_text ltx_font_bold">Context (chars)</span></th></tr>
