</div>
<div id="alg4.l15" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">15:</span>
                
                
                <math id="alg4.l15.m1" class="ltx_Math" alttext="\mathcal{S}^{\prime}\leftarrow[\ ]" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mo rspace="0.500em" stretchy="false">[</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}^{\prime}\leftarrow[\ ]</annotation></semantics></math>; <math id="alg4.l15.m2" class="ltx_Math" alttext="\textit{seen}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">seen</mtext><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\textit{seen}\leftarrow\emptyset</annotation></semantics></math>

</div>
<div id="alg4.l16" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">16:</span>
                
                
                <span id="alg4.l16.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l16.m1" class="ltx_Math" alttext="(v_{i},t_{i},s_{i})\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">(v_{i},t_{i},s_{i})\in\mathcal{S}</annotation></semantics></math> <span id="alg4.l16.3" class="ltx_text ltx_font_bold">do</span> <span id="alg4.l16.4" class="ltx_text" style="float:right;"><math id="alg4.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Preserve original order
</span>
</div>
<div id="alg4.l17" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">17:</span>
                
                
                 <span id="alg4.l17.2" class="ltx_text ltx_font_bold">if</span> <math id="alg4.l17.m1" class="ltx_Math" alttext="v_{i}\notin\mathcal{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∉</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow><annotation encoding="application/x-tex">v_{i}\notin\mathcal{D}</annotation></semantics></math> <span id="alg4.l17.3" class="ltx_text ltx_font_bold">and</span> <math id="alg4.l17.m2" class="ltx_Math" alttext="v_{i}\notin\textit{seen}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>i</mi></msub><mo>∉</mo><mtext class="ltx_mathvariant_italic">seen</mtext></mrow><annotation encoding="application/x-tex">v_{i}\notin\textit{seen}</annotation></semantics></math> <span id="alg4.l17.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg4.l18" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">18:</span>
                
                
                   append <math id="alg4.l18.m1" class="ltx_Math" alttext="(v_{i},t_{i},s_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(v_{i},t_{i},s_{i})</annotation></semantics></math> to <math id="alg4.l18.m2" class="ltx_Math" alttext="\mathcal{S}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{S}^{\prime}</annotation></semantics></math>; <math id="alg4.l18.m3" class="ltx_Math" alttext="\textit{seen}\leftarrow\textit{seen}\cup\{v_{i}\}" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_italic">seen</mtext><mo stretchy="false">←</mo><mrow><mtext class="ltx_mathvariant_italic">seen</mtext><mo>∪</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\textit{seen}\leftarrow\textit{seen}\cup\{v_{i}\}</annotation></semantics></math>

</div>
<div id="alg4.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">19:</span>
                
                
