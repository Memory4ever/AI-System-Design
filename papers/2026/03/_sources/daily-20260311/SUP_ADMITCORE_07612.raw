</div>
<div id="alg3.l16" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">16:</span>
                
                
                 <math id="alg3.l16.m1" class="ltx_Math" alttext="\hat{f}_{v}\leftarrow(f_{v}-\min f)/(\max f-\min f)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mi>v</mi></msub><mo>−</mo><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mi>f</mi></mrow><mo>−</mo><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mi>f</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{f}_{v}\leftarrow(f_{v}-\min f)/(\max f-\min f)</annotation></semantics></math> <span id="alg3.l16.2" class="ltx_text" style="float:right;"><math id="alg3.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Normalize
</span>
</div>
<div id="alg3.l17" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">17:</span>
                
                
                 <math id="alg3.l17.m1" class="ltx_Math" alttext="\hat{s}_{v}\leftarrow(s_{v}-\min s)/(\max s-\min s)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>v</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>s</mi><mi>v</mi></msub><mo>−</mo><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mi>s</mi></mrow><mo>−</mo><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mi>s</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{s}_{v}\leftarrow(s_{v}-\min s)/(\max s-\min s)</annotation></semantics></math>

</div>
<div id="alg3.l18" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">18:</span>
                
                
                 <span id="alg3.l18.2" class="ltx_text ltx_font_bold">return</span> <math id="alg3.l18.m1" class="ltx_Math" alttext="\textsc{SortBy}(\mathcal{V},0.5\cdot\hat{f}_{v}+0.5\cdot\hat{s}_{v},\text{desc})" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps">SortBy</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>,</mo><mrow><mrow><mn>0.5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>f</mi><mo>^</mo></mover><mi>v</mi></msub></mrow><mo>+</mo><mrow><mn>0.5</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mover accent="true"><mi>s</mi><mo>^</mo></mover><mi>v</mi></msub></mrow></mrow><mo>,</mo><mtext>desc</mtext><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{SortBy}(\mathcal{V},0.5\cdot\hat{f}_{v}+0.5\cdot\hat{s}_{v},\text{desc})</annotation></semantics></math>

</div>
<div id="alg3.l19" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">19:</span>
                
                
                <span id="alg3.l19.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l19.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l20" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">20:</span>
                
                
              <span id="alg3.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l20.3" class="ltx_text ltx_font_bold">function</span>
</div>
</div>
</figure>
</section>
<section id="A1.SS2.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">BM25 Indexing.</h4>

<div id="A1.SS2.SSS0.Px4.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS0.Px4.p1.1" class="ltx_p">BM25 indexing uses rank_bm25 library with default parameters (<math id="A1.SS2.SSS0.Px4.p1.m1" class="ltx_Math" alttext="k_{1}=1.5" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>1</mn></msub><mo>=</mo><mn>1.5</mn></mrow><annotation encoding="application/x-tex">k_{1}=1.5</annotation></semantics></math>, <math id="A1.SS2.SSS0.Px4.p1.m2" class="ltx_Math" alttext="b=0.75" display="inline" intent=":literal"><semantics><mrow><mi>b</mi><mo>=</mo><mn>0.75</mn></mrow><annotation encoding="application/x-tex">b=0.75</annotation></semantics></math>). We index paragraph-level content only (not sentences) to balance precision with recall. Tokenization uses NLTK word_tokenize with lowercasing and stopword removal.</p>
</div>
</section>
<section id="A1.SS2.SSS0.Px5" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Hybrid Retrieval.</h4>

<div id="A1.SS2.SSS0.Px5.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS0.Px5.p1.1" class="ltx_p">At query time, BM25 scores are computed for all paragraphs, and top-<math id="A1.SS2.SSS0.Px5.p1.m1" class="ltx_Math" alttext="k_{\text{bm25}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mtext>bm25</mtext></msub><annotation encoding="application/x-tex">k_{\text{bm25}}</annotation></semantics></math> results are appended to dense retrieval results without score normalization. This simple concatenation strategy avoids the need to calibrate score distributions between dense and sparse retrievers.</p>
</div>
</section>
<section id="A1.SS2.SSS0.Px6" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Tree Deduplication.</h4>

<div id="A1.SS2.SSS0.Px6.p1" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS0.Px6.p1.1" class="ltx_p">Because retrieval targets both sentence and paragraph nodes, multi-query retrieval can return a parent node alongside one or more of its descendants, e.g., paragraph <span id="A1.SS2.SSS0.Px6.p1.1.1" class="ltx_text ltx_font_typewriter">doc:sec1:p2</span> and sentence <span id="A1.SS2.SSS0.Px6.p1.1.2" class="ltx_text ltx_font_typewriter">doc:sec1:p2:s3</span>. Standard node-ID deduplication only removes exact duplicates and does not detect this hierarchical overlap; the child’s text is already contained within the parent, wasting context window capacity. Tree deduplication addresses this by removing any node whose ancestor (determined by node-ID prefix matching) is also present in the result set. This step is applied after reranking but before top-<math id="A1.SS2.SSS0.Px6.p1.m1" class="ltx_Math" alttext="k_{\text{final}}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mtext>final</mtext></msub><annotation encoding="application/x-tex">k_{\text{final}}</annotation></semantics></math> truncation, so that the freed slots can be filled by other unique content.</p>
</div>
<div id="A1.SS2.SSS0.Px6.p2" class="ltx_para ltx_noindent">
<p id="A1.SS2.SSS0.Px6.p2.1" class="ltx_p">Algorithm <a href="#alg4" title="Algorithm 4 ‣ Tree Deduplication. ‣ A.2 Retrieval Pipeline ‣ Appendix A Implementation Details ‣ KohakuRAG: A simple RAG framework with hierarchical document indexing" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a> presents the tree deduplication procedure. The algorithm first collects all unique node IDs from the expanded snippet set, then identifies nodes whose ancestor is also present by checking node-ID prefix relationships. Finally, it removes these subsumed nodes and deduplicates by node ID (keeping the first occurrence) in a single pass.</p>
</div>
<figure id="alg4" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg4.3" class="ltx_text ltx_font_bold">Algorithm 4</span> </span> Tree Deduplication of Context Snippets</figcaption>
<div id="alg4.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg4.l1" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">1:</span>
                
                
              Expanded snippet set <math id="alg4.l1.m1" class="ltx_Math" alttext="\mathcal{S}=\{(v_{i},t_{i},s_{i})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{S}=\{(v_{i},t_{i},s_{i})\}</annotation></semantics></math> where <math id="alg4.l1.m2" class="ltx_Math" alttext="v_{i}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>i</mi></msub><annotation encoding="application/x-tex">v_{i}</annotation></semantics></math> is node ID, <math id="alg4.l1.m3" class="ltx_Math" alttext="t_{i}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi>i</mi></msub><annotation encoding="application/x-tex">t_{i}</annotation></semantics></math> is text, <math id="alg4.l1.m4" class="ltx_Math" alttext="s_{i}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mi>i</mi></msub><annotation encoding="application/x-tex">s_{i}</annotation></semantics></math> is score

</div>
<div id="alg4.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">2:</span>
                
                
              Deduplicated snippets <math id="alg4.l2.m1" class="ltx_Math" alttext="\mathcal{S}^{\prime}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo>′</mo></msup><annotation encoding="application/x-tex">\mathcal{S}^{\prime}</annotation></semantics></math> with no ancestor–descendant overlap

</div>
<div id="alg4.l3" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">3:</span>
                
                
              
</div>
<div id="alg4.l4" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">4:</span>
                
                
              <span id="alg4.l4.2" class="ltx_text ltx_font_bold">function</span> <span id="alg4.l4.3" class="ltx_text ltx_font_smallcaps">TreeDedup</span>(<math id="alg4.l4.m1" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>)

</div>
<div id="alg4.l5" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">5:</span>
                
                
                <math id="alg4.l5.m1" class="ltx_Math" alttext="\mathcal{V}\leftarrow\{v_{i}:(v_{i},t_{i},s_{i})\in\mathcal{S}\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><msub><mi>v</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo>,</mo><msub><mi>t</mi><mi>i</mi></msub><mo>,</mo><msub><mi>s</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}\leftarrow\{v_{i}:(v_{i},t_{i},s_{i})\in\mathcal{S}\}</annotation></semantics></math> <span id="alg4.l5.2" class="ltx_text" style="float:right;"><math id="alg4.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Collect unique node IDs
</span>
</div>
<div id="alg4.l6" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">6:</span>
                
                
                <math id="alg4.l6.m1" class="ltx_Math" alttext="\mathcal{D}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{D}\leftarrow\emptyset</annotation></semantics></math> <span id="alg4.l6.2" class="ltx_text" style="float:right;"><math id="alg4.l6.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> IDs to discard
</span>
</div>
<div id="alg4.l7" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">7:</span>
                
                
                <span id="alg4.l7.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l7.m1" class="ltx_Math" alttext="v\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">v\in\mathcal{V}</annotation></semantics></math> <span id="alg4.l7.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l8" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline">8:</span>
                
                
                 <span id="alg4.l8.2" class="ltx_text ltx_font_bold">for</span> <math id="alg4.l8.m1" class="ltx_Math" alttext="u\in\mathcal{V}\setminus\{v\}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∖</mo><mrow><mo stretchy="false">{</mo><mi>v</mi><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">u\in\mathcal{V}\setminus\{v\}</annotation></semantics></math> <span id="alg4.l8.3" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="alg4.l9" class="ltx_listingline">
