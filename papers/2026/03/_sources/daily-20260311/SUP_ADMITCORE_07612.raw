<section id="A1.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.3 </span>Answer Generation Pipeline</h3>

<div id="A1.SS3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.p1.1" class="ltx_p">This section describes the prompt construction, structured output format, and ensemble voting mechanism that transform retrieved context into final answers with citations.</p>
</div>
<section id="A1.SS3.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Prompt Construction.</h4>

<div id="A1.SS3.SSS0.Px1.p1" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p1.1" class="ltx_p">Retrieved nodes are formatted as:</p>
<div id="A1.SS3.SSS0.Px1.p1.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64,W3JlZl9pZD17ZG9jX2lkfV0ge25vZGVfY29udGVudH0=" download="">⬇</a></div>
<div id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_font_typewriter">[</span><span id="lstnumberx14.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">ref_id</span><span id="lstnumberx14.3" class="ltx_text ltx_font_typewriter">={</span><span id="lstnumberx14.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter">doc_id</span><span id="lstnumberx14.5" class="ltx_text ltx_font_typewriter">}]</span><span id="lstnumberx14.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx14.7" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx14.8" class="ltx_text ltx_lst_identifier ltx_font_typewriter">node_content</span><span id="lstnumberx14.9" class="ltx_text ltx_font_typewriter">}</span>
</div>
</div>
</div>
<div id="A1.SS3.SSS0.Px1.p2" class="ltx_para ltx_noindent">
<p id="A1.SS3.SSS0.Px1.p2.1" class="ltx_p">The full prompt structure (with reordering):</p>
<div id="A1.SS3.SSS0.Px1.p2.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_font_typewriter">##</span><span id="lstnumberx15.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Referenced</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx15.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Documents</span>
</div>
<div id="lstnumberx16" class="ltx_listingline"><span id="lstnumberx16.1" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx16.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">formatted_nodes</span><span id="lstnumberx16.3" class="ltx_text ltx_font_typewriter">}</span>
</div>
<div id="lstnumberx17" class="ltx_listingline">
</div>
<div id="lstnumberx18" class="ltx_listingline"><span id="lstnumberx18.1" class="ltx_text ltx_font_typewriter">##</span><span id="lstnumberx18.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx18.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Referenced</span><span id="lstnumberx18.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx18.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Media</span>
</div>
<div id="lstnumberx19" class="ltx_listingline"><span id="lstnumberx19.1" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx19.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">image_captions</span><span id="lstnumberx19.3" class="ltx_text ltx_font_typewriter">}</span>
</div>
<div id="lstnumberx20" class="ltx_listingline">
</div>
<div id="lstnumberx21" class="ltx_listingline"><span id="lstnumberx21.1" class="ltx_text ltx_font_typewriter">##</span><span id="lstnumberx21.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx21.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Question</span>
</div>
<div id="lstnumberx22" class="ltx_listingline"><span id="lstnumberx22.1" class="ltx_text ltx_font_typewriter">{</span><span id="lstnumberx22.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter">question</span><span id="lstnumberx22.3" class="ltx_text ltx_font_typewriter">}</span>
</div>
<div id="lstnumberx23" class="ltx_listingline">
</div>
<div id="lstnumberx24" class="ltx_listingline"><span id="lstnumberx24.1" class="ltx_text ltx_font_typewriter">##</span><span id="lstnumberx24.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx24.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Instructions</span>
</div>
