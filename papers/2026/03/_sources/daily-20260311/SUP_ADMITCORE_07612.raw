<td id="A1.T6.2.2.2" class="ltx_td ltx_align_center ltx_border_t">32.0 <math id="A1.T6.m9" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0</td>
<td id="A1.T6.2.2.3" class="ltx_td ltx_align_center ltx_border_t">64.0 <math id="A1.T6.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.0</td>
<td id="A1.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">148,125 <math id="A1.T6.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 34,415</td></tr>
<tr id="A1.T6.2.3" class="ltx_tr">
