<figure id="A2.T11" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 11: </span>Effect of ignore_blank on ensemble performance (union voting).</figcaption>
<table id="A2.T11.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A2.T11.2.1" class="ltx_tr">
<th id="A2.T11.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A2.T11.2.1.1.1" class="ltx_text ltx_font_bold">ignore_blank</span></th>
<th id="A2.T11.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T11.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="A2.T11.2.1.2.1" class="ltx_text ltx_font_bold">=1</span></th>
<th id="A2.T11.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T11.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math><span id="A2.T11.2.1.3.1" class="ltx_text ltx_font_bold">=3</span></th>
