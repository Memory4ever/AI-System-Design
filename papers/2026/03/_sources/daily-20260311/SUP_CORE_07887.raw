<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A6.E131.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mu^{{\scriptscriptstyle N-1}}(y_{iK+2:(i+1)K-1};y^{\star}_{iK+2:(i+1)K-1})\cdot\mu^{{\scriptscriptstyle N}}(y_{iK+1}\mid{}y_{1:iK};y^{\star})\mu^{{\scriptscriptstyle N}}(y_{(i+1)K}\mid{}y_{1:(i+1)K-1};y^{\star})" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msup><mi>μ</mi><mrow><mi mathsize="0.710em">N</mi><mo mathsize="0.710em">−</mo><mn mathsize="0.710em">1</mn></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msubsup><mi>y</mi><mrow><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>2</mn></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo>⋆</mo></msubsup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mi>μ</mi><mi mathsize="0.710em">N</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow></msub><mo>;</mo><msup><mi>y</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow><msup><mi>μ</mi><mi mathsize="0.710em">N</mi></msup><mrow><mo stretchy="false">(</mo><msub><mi>y</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></msub><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msup><mi>y</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mu^{{\scriptscriptstyle N-1}}(y_{iK+2:(i+1)K-1};y^{\star}_{iK+2:(i+1)K-1})\cdot\mu^{{\scriptscriptstyle N}}(y_{iK+1}\mid{}y_{1:iK};y^{\star})\mu^{{\scriptscriptstyle N}}(y_{(i+1)K}\mid{}y_{1:(i+1)K-1};y^{\star})</annotation></semantics></math></td>
