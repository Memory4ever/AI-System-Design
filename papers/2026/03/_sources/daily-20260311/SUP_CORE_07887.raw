="0.167em">∣</mo><msub><mi>y</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>i</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow></msub><mo>;</mo><msup><mi>y</mi><mo>⋆</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mu^{{\scriptscriptstyle N}}(y_{iK+2:(i+1)K-1}\mid{}y_{1:iK+1};y^{\star})\cdot\mu^{{\scriptscriptstyle N}}(y_{iK+1}\mid{}y_{1:iK};y^{\star})\mu^{{\scriptscriptstyle N}}(y_{(i+1)K}\mid{}y_{1:(i+1)K-1};y^{\star})</annotation></semantics></math></td>
