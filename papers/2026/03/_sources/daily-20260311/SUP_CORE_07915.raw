<td id="S4.T2.18.1.16.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.18.1.16.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F2F2F2;">–</span></td>
<td id="S4.T2.18.1.16.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.18.1.16.8.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F2F2F2;">2653</span></td>
