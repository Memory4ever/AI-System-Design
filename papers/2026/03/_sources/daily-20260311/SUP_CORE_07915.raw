<td id="S4.T3.8.1.3.2" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T3.8.1.3.2.1" class="ltx_text" style="font-size:90%;">47.3</span></td>
<td id="S4.T3.8.1.3.3" class="ltx_td ltx_align_center ltx_border_r" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><math id="S4.T3.m6" class="ltx_Math" alttext="{\color[rgb]{1,0.23,0.13}\uparrow 7.5}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo style="--ltx-fg-color:#FF3B21;" mathcolor="#FF3B21" mathsize="0.900em" stretchy="false">↑</mo><mn style="--ltx-fg-color:#FF3B21;" mathcolor="#FF3B21" mathsize="0.900em">7.5</mn></mrow><annotation encoding="application/x-tex">{\color[rgb]{1,0.23,0.13}\uparrow 7.5}</annotation></semantics></math></td>
<td id="S4.T3.8.1.3.4" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T3.8.1.3.4.1" class="ltx_text" style="font-size:90%;">137k</span></td>
<td id="S4.T3.8.1.3.5" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T3.8.1.3.5.1" class="ltx_text" style="font-size:90%;">1198</span></td>
<td id="S4.T3.8.1.3.6" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T3.8.1.3.6.1" class="ltx_text" style="font-size:90%;">82</span></td></tr>
