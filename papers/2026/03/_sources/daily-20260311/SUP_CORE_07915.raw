<td id="S4.T3.8.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T3.8.1.2.5.1" class="ltx_text" style="font-size:90%;">223</span></td>
