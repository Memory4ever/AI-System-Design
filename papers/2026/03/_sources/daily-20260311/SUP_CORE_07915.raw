<td id="S4.T4.8.1.3.6" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S4.T4.8.1.3.6.1" class="ltx_text" style="font-size:90%;">148</span></td></tr>
