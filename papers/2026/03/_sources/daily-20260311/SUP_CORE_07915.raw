<td id="S4.T2.18.1.16.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.18.1.16.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#F2F2F2;">42.0</span></td>
