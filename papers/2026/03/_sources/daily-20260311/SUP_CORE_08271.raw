            <math id="algx1.l20.m1" class="ltx_Math" alttext="z_{t-1}\leftarrow\frac{1}{\sqrt{\alpha_{t}}}\!\left(z_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}}\tilde{\epsilon}_{\theta}(z_{t},c)\right)+\sigma_{t}\,\varepsilon,\quad\varepsilon\sim\mathcal{N}(0,I)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>z</mi><mrow><mi>t</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mfrac><mn>1</mn><msqrt><msub><mi>α</mi><mi>t</mi></msub></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>z</mi><mi>t</mi></msub><mo>−</mo><mrow><mfrac><mrow><mn>1</mn><mo>−</mo><msub><mi>α</mi><mi>t</mi></msub></mrow><msqrt><mrow><mn>1</mn><mo>−</mo><msub><mover accent="true"><mi>α</mi><mo>¯</mo></mover><mi>t</mi></msub></mrow></msqrt></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow></mrow><mo rspace="1.167em">,</mo><mrow><mi>ε</mi><mo>∼</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>I</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">z_{t-1}\leftarrow\frac{1}{\sqrt{\alpha_{t}}}\!\left(z_{t}-\frac{1-\alpha_{t}}{\sqrt{1-\bar{\alpha}_{t}}}\tilde{\epsilon}_{\theta}(z_{t},c)\right)+\sigma_{t}\,\varepsilon,\quad\varepsilon\sim\mathcal{N}(0,I)</annotation></semantics></math> <span id="algx1.l20.3" class="ltx_text" style="float:right;"><math id="algx1.l20.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Reverse diffusion
