            <math id="algx1.l19.m1" class="ltx_Math" alttext="\tilde{\epsilon}_{\theta}(z_{t},c)\leftarrow\epsilon_{\theta}(z_{t})+\alpha\big(\epsilon_{\theta}(z_{t},c)-\epsilon_{\theta}(z_{t})\big)-\beta\big(\epsilon_{\theta}(z_{t},p_{\mathbf{T}}^{(k^{\ast})})-\epsilon_{\theta}(z_{t})\big)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>ϵ</mi><mo>~</mo></mover><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mrow><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>α</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mi>β</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><msubsup><mi>p</mi><mi>𝐓</mi><mrow><mo stretchy="false">(</mo><msup><mi>k</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\tilde{\epsilon}_{\theta}(z_{t},c)\leftarrow\epsilon_{\theta}(z_{t})+\alpha\big(\epsilon_{\theta}(z_{t},c)-\epsilon_{\theta}(z_{t})\big)-\beta\big(\epsilon_{\theta}(z_{t},p_{\mathbf{T}}^{(k^{\ast})})-\epsilon_{\theta}(z_{t})\big)</annotation></semantics></math>

