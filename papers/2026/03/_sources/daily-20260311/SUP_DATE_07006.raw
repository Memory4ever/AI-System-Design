{"data":{"id":"10.48550/arxiv.2603.07006","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.07006","prefix":"10.48550","suffix":"arxiv.2603.07006","identifiers":[{"identifier":"2603.07006","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.07006"}],"creators":[{"name":"Luo, Shuqing","nameType":"Personal","givenName":"Shuqing","familyName":"Luo","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Han, Ye","nameType":"Personal","givenName":"Ye","familyName":"Han","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Li, Pingzhi","nameType":"Personal","givenName":"Pingzhi","familyName":"Li","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Qin, Jiayin","nameType":"Personal","givenName":"Jiayin","familyName":"Qin","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Peng, Jie","nameType":"Personal","givenName":"Jie","familyName":"Peng","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Yang","nameType":"Personal","familyName":"Yang","affiliation":["Katie"],"nameIdentifiers":[]},{"name":"Zhao","nameType":"Personal","familyName":"Zhao","affiliation":["Kevin"],"nameIdentifiers":[]},{"name":"Yu","nameType":"Personal","familyName":"Yu","affiliation":["Kevin"],"nameIdentifiers":[]},{"name":"Cao","nameType":"Organizational","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Tianlong","nameType":"Personal","givenName":"Tianlong","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Mozart: Modularized and Efficient MoE Training on 3.5D Wafer-Scale Chiplet Architectures"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-07T02:57:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-10T00:25:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Mixture-of-Experts (MoE) architecture offers enhanced efficiency for Large Language Models (LLMs) with modularized computation, yet its inherent sparsity poses significant hardware deployment challenges, including memory locality issues, communication overhead, and inefficient computing resource utilization. Inspired by the modular organization of the human brain, we propose Mozart, a novel algorithm-hardware co-design framework tailored for efficient training of MoE-based LLMs on 3.5D wafer-scale chiplet architectures. On the algorithm side, Mozart exploits the inherent modularity of chiplets and introduces: (1) an expert allocation strategy that enables efficient on-package all-to-all communication, and (2) a fine-grained scheduling mechanism that improves communication-computation overlap through streaming tokens and experts. On the architecture side, Mozart adaptively co-locates heterogeneous modules on specialized chiplets with a 2.5D NoP-Tree topology and hierarchical memory structure. Evaluation across three popular MoE models demonstrates significant efficiency gains, enabling more effective parallelization and resource utilization for large-scale modularized MoE-LLMs.","descriptionType":"Abstract"},{"description":"NeurIPS 2025 Spotlight","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.07006","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-10T03:57:30.000Z","registered":"2026-03-10T03:57:31.000Z","published":"2026","updated":"2026-03-10T03:57:31.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.07006","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}