<th id="S6.T2.2.1.16.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r">Remote memory size</th>
<td id="S6.T2.2.1.16.2" class="ltx_td ltx_align_center ltx_border_r">16 GiB</td></tr>
