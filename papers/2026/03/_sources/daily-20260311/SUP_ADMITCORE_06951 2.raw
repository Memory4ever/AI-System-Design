<td id="S3.T1.2.1.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#C0C0C0;" colspan="4"><span id="S3.T1.2.1.1.2.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#C0C0C0;">Requirements</span></td></tr>
<tr id="S3.T1.2.1.2" class="ltx_tr" style="--ltx-bg-color:#C0C0C0;">
<th id="S3.T1.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_rr" style="--ltx-bg-color:#C0C0C0;"><span id="S3.T1.2.1.2.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#C0C0C0;">Work</span></th>
<td id="S3.T1.2.1.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#C0C0C0;">
<table id="S3.T1.2.1.2.2.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.2.1.2.2.1.1" class="ltx_tr">
<td id="S3.T1.2.1.2.2.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.2.1.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#C0C0C0;">R1: Principle of</span></td></tr>
<tr id="S3.T1.2.1.2.2.1.2" class="ltx_tr">
<td id="S3.T1.2.1.2.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.2.1.2.1.1" class="ltx_text ltx_font_bold">Least Privilege</span></td></tr>
</table></td>
<td id="S3.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#C0C0C0;">
<table id="S3.T1.2.1.2.3.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.2.1.2.3.1.1" class="ltx_tr">
<td id="S3.T1.2.1.2.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.3.1.1.1.1" class="ltx_text ltx_font_bold">R2: Small TCB</span></td></tr>
</table></td>
<td id="S3.T1.2.1.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="--ltx-bg-color:#C0C0C0;">
<table id="S3.T1.2.1.2.4.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.2.1.2.4.1.1" class="ltx_tr">
<td id="S3.T1.2.1.2.4.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.4.1.1.1.1" class="ltx_text ltx_font_bold">R3: Low Access</span></td></tr>
<tr id="S3.T1.2.1.2.4.1.2" class="ltx_tr">
<td id="S3.T1.2.1.2.4.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.4.1.2.1.1" class="ltx_text ltx_font_bold">Control Metadata</span></td></tr>
</table></td>
<td id="S3.T1.2.1.2.5" class="ltx_td ltx_align_center ltx_border_rr ltx_border_t">
<table id="S3.T1.2.1.2.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S3.T1.2.1.2.5.1.1" class="ltx_tr">
<td id="S3.T1.2.1.2.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.5.1.1.1.1" class="ltx_text ltx_font_bold">R4: Memory</span></td></tr>
<tr id="S3.T1.2.1.2.5.1.2" class="ltx_tr">
<td id="S3.T1.2.1.2.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T1.2.1.2.5.1.2.1.1" class="ltx_text ltx_font_bold">Sharing</span></td></tr>
</table></td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_rr ltx_border_tt">Mondrian <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib2" title="" class="ltx_ref">Witchel et al., 2002</a>)</cite></th>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S3.T1.2.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#00E000;">✓</span></td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S3.T1.2.1.3.3.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="S3.T1.2.1.3.4.1" class="ltx_text" style="--ltx-fg-color:#FF0000;">✗</span></td>
<td id="S3.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_rr ltx_border_tt"><span id="S3.T1.2.1.3.5.1" class="ltx_text" style="--ltx-fg-color:#00E000;">✓</span></td></tr>
<tr id="S3.T1.2.1.4" class="ltx_tr">
<th id="S3.T1.2.1.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_rr ltx_border_t">Border Control <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib28" title="" class="ltx_ref">Olson et al., 2015</a>)</cite></th>
