<td id="S5.T1.2.8.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.2.8.2.1" class="ltx_text ltx_underline">58.1</span></td>
<td id="S5.T1.2.8.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T1.2.8.3.1" class="ltx_text ltx_underline">18.6</span></td>
