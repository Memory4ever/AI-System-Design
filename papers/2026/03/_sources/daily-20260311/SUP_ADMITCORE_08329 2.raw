<td id="S5.T2.2.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.2.3.5.1" class="ltx_text ltx_font_bold">60.9</span> / <span id="S5.T2.2.3.5.2" class="ltx_text ltx_font_bold">54.5%</span></td></tr>
