<td id="S5.T2.2.2.5" class="ltx_td ltx_align_center">(<math id="S5.T2.m4" class="ltx_Math" alttext="n=11" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>11</mn></mrow><annotation encoding="application/x-tex">n=11</annotation></semantics></math>)</td></tr>
