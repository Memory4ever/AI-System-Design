<th id="S9.T7.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="2"><span id="S9.T7.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">w. Overthinking Score</span></th></tr>
