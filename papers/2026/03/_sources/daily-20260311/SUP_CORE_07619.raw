</thead>
<tbody class="ltx_tbody">
<tr id="S9.T7.5.3" class="ltx_tr">
<th id="S9.T7.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.3.1.1" class="ltx_text" style="font-size:90%;">SVAR <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></span></th>
<td id="S9.T7.5.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.3.2.1" class="ltx_text" style="font-size:90%;">85.12</span></td>
<td id="S9.T7.5.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.3.3.1" class="ltx_text" style="font-size:90%;">69.35</span></td>
<td id="S9.T7.5.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.3.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">86.67</span></td>
<td id="S9.T7.5.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">75.06</span></td></tr>
<tr id="S9.T7.5.4" class="ltx_tr">
<th id="S9.T7.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.4.1.1" class="ltx_text" style="font-size:90%;">HalLoc <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib19" title="" class="ltx_ref">19</a>]</cite></span></th>
<td id="S9.T7.5.4.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.4.2.1" class="ltx_text" style="font-size:90%;">80.38</span></td>
<td id="S9.T7.5.4.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.4.3.1" class="ltx_text" style="font-size:90%;">73.68</span></td>
<td id="S9.T7.5.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.4.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">88.53</span></td>
<td id="S9.T7.5.4.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.4.5.1" class="ltx_text" style="font-size:90%;">72.97</span></td></tr>
<tr id="S9.T7.5.5" class="ltx_tr">
<th id="S9.T7.5.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.5.1.1" class="ltx_text" style="font-size:90%;">MetaToken (LR) <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib7" title="" class="ltx_ref">7</a>]</cite></span></th>
