<td id="S9.T7.5.6.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.6.2.1" class="ltx_text" style="font-size:90%;">88.95</span></td>
