<td id="S9.T7.5.6.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.6.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">89.15</span></td>
