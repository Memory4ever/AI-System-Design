<th id="S9.T7.5.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S9.T7.5.2.3.1" class="ltx_text" style="font-size:90%;">F1</span></th>
