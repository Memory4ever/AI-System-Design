<td id="S4.T4.2.1.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="S4.T4.2.1.1.3.1" class="ltx_text ltx_font_bold">Resolved Issues<math id="S4.T4.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
