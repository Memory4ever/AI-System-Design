<td id="S4.T4.2.1.2.2" class="ltx_td ltx_align_right ltx_border_t">13.5</td>
<td id="S4.T4.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">27/200</td></tr>
<tr id="S4.T4.2.1.3" class="ltx_tr">
<th id="S4.T4.2.1.3.1" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_t">1k</th>
<td id="S4.T4.2.1.3.2" class="ltx_td ltx_align_right ltx_border_t">24.5<span id="S4.T4.2.1.3.2.1" class="ltx_text" style="--ltx-fg-color:#008000;">(<math id="S4.T4.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>+11.0%)</span></td>
<td id="S4.T4.2.1.3.3" class="ltx_td ltx_align_right ltx_border_t">49/200</td></tr>
<tr id="S4.T4.2.1.4" class="ltx_tr">
<th id="S4.T4.2.1.4.1" class="ltx_td ltx_align_right ltx_th ltx_th_row">2k</th>
<td id="S4.T4.2.1.4.2" class="ltx_td ltx_align_right">31.5<span id="S4.T4.2.1.4.2.1" class="ltx_text" style="--ltx-fg-color:#008000;">(<math id="S4.T4.m4" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>+18.0%)</span></td>
<td id="S4.T4.2.1.4.3" class="ltx_td ltx_align_right">63/200</td></tr>
<tr id="S4.T4.2.1.5" class="ltx_tr">
