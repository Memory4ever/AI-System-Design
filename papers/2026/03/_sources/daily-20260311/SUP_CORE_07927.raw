<td id="S4.T4.2.1.6.2" class="ltx_td ltx_align_right">35.0 <span id="S4.T4.2.1.6.2.1" class="ltx_text" style="--ltx-fg-color:#008000;">(<math id="S4.T4.m6" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#008000;" mathcolor="#008000" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>+21.5%)</span></td>
<td id="S4.T4.2.1.6.3" class="ltx_td ltx_align_right">70/200</td></tr>
<tr id="S4.T4.2.1.7" class="ltx_tr">
