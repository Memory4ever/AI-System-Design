{"data":{"id":"10.48550/arxiv.2603.07557","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.07557","prefix":"10.48550","suffix":"arxiv.2603.07557","identifiers":[{"identifier":"2603.07557","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.07557"}],"creators":[{"name":"Lin, Yixi","nameType":"Personal","givenName":"Yixi","familyName":"Lin","affiliation":["Sun Yat-sen University, Zhuhai, Guangdong, China"],"nameIdentifiers":[]},{"name":"Wu, Jiangrong","nameType":"Personal","givenName":"Jiangrong","familyName":"Wu","affiliation":["Sun Yat-sen University, Zhuhai, Guangdong, China"],"nameIdentifiers":[]},{"name":"Nan, Yuhong","nameType":"Personal","givenName":"Yuhong","familyName":"Nan","affiliation":["Sun Yat-sen University, Zhuhai, Guangdong, China"],"nameIdentifiers":[]},{"name":"Wang, Xueqiang","nameType":"Personal","givenName":"Xueqiang","familyName":"Wang","affiliation":["University of Central Florida, Orlando, Florida, USA"],"nameIdentifiers":[]},{"name":"Zhang, Xinyuan","nameType":"Personal","givenName":"Xinyuan","familyName":"Zhang","affiliation":["Sun Yat-sen University, Zhuhai, Guangdong, China"],"nameIdentifiers":[]},{"name":"Zheng, Zibin","nameType":"Personal","givenName":"Zibin","familyName":"Zheng","affiliation":["Sun Yat-sen University, Zhuhai, Guangdong, China"],"nameIdentifiers":[]}],"titles":[{"title":"AgentRaft: Automated Detection of Data Over-Exposure in LLM Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-08T09:40:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-10T01:09:06Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The rapid integration of Large Language Model (LLM) agents into autonomous task execution has introduced significant privacy concerns within cross-tool data flows. In this paper, we systematically investigate and define a novel risk termed Data Over-Exposure (DOE) in LLM Agent, where an Agent inadvertently transmits sensitive data beyond the scope of user intent and functional necessity. We identify that DOE is primarily driven by the broad data paradigms in tool design and the coarse-grained data processing inherent in LLMs. In this paper, we present AgentRaft, the first automated framework for detecting DOE risks in LLM agents. AgentRaft combines program analysis with semantic reasoning through three synergistic modules: (1) it constructs a Cross-Tool Function Call Graph (FCG) to model the interaction landscape of heterogeneous tools; (2) it traverses the FCG to synthesize high-quality testing user prompts that act as deterministic triggers for deep-layer tool execution; and (3) it performs runtime taint tracking and employs a multi-LLM voting committee grounded in global privacy regulations (e.g., GDPR, CCPA, PIPL) to accurately identify privacy violations. We evaluate AgentRaft on a testing environment of 6,675 real-world agent tools. Our findings reveal that DOE is indeed a systemic risk, prevalent in 57.07% of potential tool interaction paths. AgentRaft achieves a high detection accuracy and effectiveness, outperforming baselines by 87.24%. Furthermore, AgentRaft reaches near-total DOE coverage (99%) within only 150 prompts while reducing per-chain verification costs by 88.6%. Our work provides a practical foundation for building auditable and privacy-compliant LLM agent systems.","descriptionType":"Abstract"},{"description":"26 pages, 7 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.07557","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-10T04:10:29.000Z","registered":"2026-03-10T04:10:29.000Z","published":"2026","updated":"2026-03-10T04:10:29.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.07557","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}