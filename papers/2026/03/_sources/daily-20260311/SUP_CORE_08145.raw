<td id="A8.T11.3.3.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="A8.T11.m5" class="ltx_Math" alttext="[7,\,7,\,8,\,8,\,7]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mn mathsize="0.900em">7</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 7</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 8</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 8</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 7</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[7,\,7,\,8,\,8,\,7]</annotation></semantics></math></td>
<td id="A8.T11.3.3.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A8.T11.m6" class="ltx_Math" alttext="7.4\ \ (0.55)" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">7.4</mn><mo lspace="0.920em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">0.55</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">7.4\ \ (0.55)</annotation></semantics></math></td></tr>
