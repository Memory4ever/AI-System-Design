<th id="A8.T10.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T10.m1" class="ltx_Math" alttext="\hat{\mu}\ \uparrow\ \ (\hat{\sigma}\ \downarrow)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi mathsize="0.900em">μ</mi><mo>^</mo></mover><mo lspace="0.738em" mathsize="0.900em" rspace="1.198em" stretchy="false">↑</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mover accent="true"><mi mathsize="0.900em">σ</mi><mo>^</mo></mover><mo mathsize="0.900em" stretchy="false">↓</mo><mphantom></mphantom></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\hat{\mu}\ \uparrow\ \ (\hat{\sigma}\ \downarrow)</annotation></semantics></math></th></tr>
