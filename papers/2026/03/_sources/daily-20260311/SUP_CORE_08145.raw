<td id="A8.T11.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A8.T11.m2" class="ltx_Math" alttext="[3,\,8,\,6,\,7,\,6]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mn mathsize="0.900em">3</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 8</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 6</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 7</mn><mo mathsize="0.900em">,</mo><mn mathsize="0.900em"> 6</mn></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow><annotation encoding="application/x-tex">[3,\,8,\,6,\,7,\,6]</annotation></semantics></math></td>
<td id="A8.T11.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A8.T11.m3" class="ltx_Math" alttext="6.0\ \ (1.87)" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">6.0</mn><mo lspace="0.920em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">1.87</mn><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">6.0\ \ (1.87)</annotation></semantics></math></td></tr>
