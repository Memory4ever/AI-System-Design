<td id="A8.T15.7.3.2" class="ltx_td ltx_align_center"><span id="A8.T15.7.3.2.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="A8.T15.7.3.3" class="ltx_td ltx_align_center"><span id="A8.T15.7.3.3.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="A8.T15.7.3.4" class="ltx_td ltx_align_center"><span id="A8.T15.7.3.4.1" class="ltx_text" style="font-size:90%;">2</span></td></tr>
<tr id="A8.T15.7.4" class="ltx_tr">
