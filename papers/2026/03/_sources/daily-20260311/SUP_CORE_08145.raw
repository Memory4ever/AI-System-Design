<td id="A8.T15.7.4.2" class="ltx_td ltx_align_center"><span id="A8.T15.7.4.2.1" class="ltx_text" style="font-size:90%;">4</span></td>
<td id="A8.T15.7.4.3" class="ltx_td ltx_align_center"><span id="A8.T15.7.4.3.1" class="ltx_text" style="font-size:90%;">5</span></td>
<td id="A8.T15.7.4.4" class="ltx_td ltx_align_center"><span id="A8.T15.7.4.4.1" class="ltx_text" style="font-size:90%;">5</span></td></tr>
<tr id="A8.T15.7.5" class="ltx_tr">
<th id="A8.T15.7.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A8.T15.7.5.1.1" class="ltx_text" style="font-size:90%;">Caution</span></th>
<td id="A8.T15.7.5.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A8.T15.7.5.2.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="A8.T15.7.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A8.T15.7.5.3.1" class="ltx_text" style="font-size:90%;">3</span></td>
<td id="A8.T15.7.5.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="A8.T15.7.5.4.1" class="ltx_text" style="font-size:90%;">4</span></td></tr>
