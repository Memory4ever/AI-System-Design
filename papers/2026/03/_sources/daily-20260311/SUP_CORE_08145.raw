</div>
<div id="alg1.l33" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l33.1" class="ltx_text" style="font-size:80%;">33:</span></span>
              
              
              <math id="alg1.l33.m1" class="ltx_Math" alttext="k^{\star}\leftarrow\arg\max_{k\in\mathcal{F}}\widetilde{V}_{\beta,\gamma,k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{\star}\leftarrow\arg\max_{k\in\mathcal{F}}\widetilde{V}_{\beta,\gamma,k}</annotation></semantics></math>

</div>
<div id="alg1.l34" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l34.1" class="ltx_text" style="font-size:80%;">34:</span></span>
              
              
              <span id="alg1.l34.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l34.m1" class="ltx_Math" alttext="y_{k^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><msup><mi>k</mi><mo>⋆</mo></msup></msub><annotation encoding="application/x-tex">y_{k^{\star}}</annotation></semantics></math>

</div>
<div id="alg1.l35" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l35.1" class="ltx_text" style="font-size:80%;">35:</span></span>
              
              
            <span id="alg1.l35.3" class="ltx_text ltx_font_bold">else</span> <span id="alg1.l35.4" class="ltx_text ltx_font_bold">if</span> variant <math id="alg1.l35.m1" class="ltx_Math" alttext="=\textsc{Eps}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mtext class="ltx_font_smallcaps">Eps</mtext></mrow><annotation encoding="application/x-tex">=\textsc{Eps}</annotation></semantics></math> <span id="alg1.l35.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l36.1" class="ltx_text" style="font-size:80%;">36:</span></span>
              
              
              <math id="alg1.l36.m1" class="ltx_Math" alttext="\widetilde{V}_{\beta,\gamma,\max}\leftarrow\max_{k\in[K]}\widetilde{V}_{\beta,\gamma,k}" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>max</mi></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>k</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\widetilde{V}_{\beta,\gamma,\max}\leftarrow\max_{k\in[K]}\widetilde{V}_{\beta,\gamma,k}</annotation></semantics></math>

</div>
<div id="alg1.l37" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l37.1" class="ltx_text" style="font-size:80%;">37:</span></span>
              
              
              <math id="alg1.l37.m1" class="ltx_Math" alttext="\mathcal{F}\leftarrow\{k\in[K]:\widetilde{V}_{\beta,\gamma,k}\geq\widetilde{V}_{\beta,\gamma,\max}-\epsilon\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo rspace="0.278em" stretchy="false">]</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>k</mi></mrow></msub><mo>≥</mo><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mi>max</mi></mrow></msub><mo>−</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow\{k\in[K]:\widetilde{V}_{\beta,\gamma,k}\geq\widetilde{V}_{\beta,\gamma,\max}-\epsilon\}</annotation></semantics></math> <span id="alg1.l37.3" class="ltx_text" style="float:right;"><math id="alg1.l37.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg1.l37.m3" class="ltx_Math" alttext="\mathcal{F}\neq\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>≠</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}\neq\emptyset</annotation></semantics></math> if <math id="alg1.l37.m4" class="ltx_Math" alttext="\epsilon\geq 0" display="inline" intent=":literal"><semantics><mrow><mi>ϵ</mi><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\epsilon\geq 0</annotation></semantics></math>
</span>
</div>
<div id="alg1.l38" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l38.1" class="ltx_text" style="font-size:80%;">38:</span></span>
              
              
              <math id="alg1.l38.m1" class="ltx_Math" alttext="k^{\star}\leftarrow\arg\min_{k\in\mathcal{F}}\widetilde{\sigma}_{k}" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>⋆</mo></msup><mo stretchy="false">←</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mrow><mi>k</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mi>k</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">k^{\star}\leftarrow\arg\min_{k\in\mathcal{F}}\widetilde{\sigma}_{k}</annotation></semantics></math>

</div>
<div id="alg1.l39" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l39.1" class="ltx_text" style="font-size:80%;">39:</span></span>
              
              
              <span id="alg1.l39.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l39.m1" class="ltx_Math" alttext="y_{k^{\star}}" display="inline" intent=":literal"><semantics><msub><mi>y</mi><msup><mi>k</mi><mo>⋆</mo></msup></msub><annotation encoding="application/x-tex">y_{k^{\star}}</annotation></semantics></math>

</div>
<div id="alg1.l40" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l40.1" class="ltx_text" style="font-size:80%;">40:</span></span>
              
              
            <span id="alg1.l40.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l40.4" class="ltx_text ltx_font_bold">if</span>
</div>
</div>
</figure>
<section id="A6.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Notes.</h4>

<div id="A6.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS1.SSS0.Px1.p1.1" class="ltx_p">Each <math id="A6.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\textsc{Score}^{(m)}_{\beta}" display="inline" intent=":literal"><semantics><msubsup><mtext class="ltx_font_smallcaps">Score</mtext><mi>β</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\textsc{Score}^{(m)}_{\beta}</annotation></semantics></math> may be instantiated by multi-annotator samples or proxy perturbation samples under scorer <math id="A6.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math>.
Because reward scales differ across scorers, aggregation is performed on selection-time normalized scores (within each prompt),
while all reported metrics in the main tables are computed <em id="A6.SS1.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">within each scorer</em> on its raw scale (Appendix <a href="#A8.SS3" title="H.3 Complete metric definitions and computation ‣ Appendix H Experiments ‣ DARC: Disagreement-Aware Alignment via Risk-Constrained Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">H.3</span></a>).
When <math id="A6.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="M=1" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">M=1</annotation></semantics></math>, the procedure reduces to the original single-scorer DARC.</p>
</div>
</section>
</section>
<section id="A6.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.2 </span>Inference-time selection baselines.</h3>

<div id="A6.SS2.p1" class="ltx_para">
<p id="A6.SS2.p1.1" class="ltx_p">All rules below select one output from the same <math id="A6.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{Y}(s)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}(s)</annotation></semantics></math>:</p>
</div>
<div id="A6.SS2.p2" class="ltx_para">
<ul id="A6.I1" class="ltx_itemize">
<li id="A6.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i1.p1" class="ltx_para">
<p id="A6.I1.i1.p1.1" class="ltx_p"><span id="A6.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Mean (Best-of-<math id="A6.I1.i1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>):</span>
<math id="A6.I1.i1.p1.m2" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\hat{\mu}_{\text{sel}}(s,y)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\hat{\mu}_{\text{sel}}(s,y).</annotation></semantics></math></p>
</div></li>
<li id="A6.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i2.p1" class="ltx_para">
<p id="A6.I1.i2.p1.1" class="ltx_p"><span id="A6.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">CVaR (Best-of-<math id="A6.I1.i2.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>):</span>
<math id="A6.I1.i2.p1.m2" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widehat{\mathrm{CVaR}}_{\alpha,\text{sel}}(s,y)," display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>CVaR</mi><mo>^</mo></mover><mrow><mi>α</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widehat{\mathrm{CVaR}}_{\alpha,\text{sel}}(s,y),</annotation></semantics></math>
where <math id="A6.I1.i2.p1.m3" class="ltx_Math" alttext="\widehat{\mathrm{CVaR}}_{\alpha,\text{sel}}(s,y)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>CVaR</mi><mo>^</mo></mover><mrow><mi>α</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathrm{CVaR}}_{\alpha,\text{sel}}(s,y)</annotation></semantics></math> is the average of the bottom <math id="A6.I1.i2.p1.m4" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> fraction of satisfaction samples for candidate <math id="A6.I1.i2.p1.m5" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>.
We fix <math id="A6.I1.i2.p1.m6" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> throughout (no tuning).</p>
</div></li>
<li id="A6.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i3.p1" class="ltx_para">
<p id="A6.I1.i3.p1.1" class="ltx_p"><span id="A6.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">MC-Dropout reranking (uncertainty-aware scoring).</span>
To obtain an uncertainty estimate without human multi-rater samples, we perform <math id="A6.I1.i3.p1.m1" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> stochastic forward passes through the scorer (dropout enabled) and treat the resulting scores as an empirical proxy distribution
<math id="A6.I1.i3.p1.m2" class="ltx_Math" alttext="\{r_{t}(s,y)\}_{t=1}^{T}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><annotation encoding="application/x-tex">\{r_{t}(s,y)\}_{t=1}^{T}</annotation></semantics></math> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib69" title="" class="ltx_ref">Gal and Ghahramani, 2016</a>; <a href="#bib.bib47" title="" class="ltx_ref">Kendall and Gal, 2017</a>)</cite>.
We then compute
<math id="A6.I1.i3.p1.m3" class="ltx_Math" alttext="\hat{\mu}_{\text{MC}}(s,y)=\frac{1}{T}\sum_{t=1}^{T}r_{t}(s,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>T</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{\mu}_{\text{MC}}(s,y)=\frac{1}{T}\sum_{t=1}^{T}r_{t}(s,y)</annotation></semantics></math>
and
<math id="A6.I1.i3.p1.m4" class="ltx_Math" alttext="\hat{\sigma}_{\text{MC}}(s,y)=\sqrt{\frac{1}{T-1}\sum_{t=1}^{T}\big(r_{t}(s,y)-\hat{\mu}_{\text{MC}}(s,y)\big)^{2}}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msqrt><mrow><mfrac><mn>1</mn><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>t</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></msubsup><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>r</mi><mi>t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\sigma}_{\text{MC}}(s,y)=\sqrt{\frac{1}{T-1}\sum_{t=1}^{T}\big(r_{t}(s,y)-\hat{\mu}_{\text{MC}}(s,y)\big)^{2}}.</annotation></semantics></math>
We use a pessimistic selection rule analogous to MV/LCB:</p>
<table id="A6.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex43.m1" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\Big(\hat{\mu}_{\text{MC}}(s,y)-\lambda_{\text{MC}}\hat{\sigma}_{\text{MC}}(s,y)\Big)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>λ</mi><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mtext>MC</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\Big(\hat{\mu}_{\text{MC}}(s,y)-\lambda_{\text{MC}}\hat{\sigma}_{\text{MC}}(s,y)\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i3.p1.2" class="ltx_p">where <math id="A6.I1.i3.p1.m5" class="ltx_Math" alttext="\lambda_{\text{MC}}" display="inline" intent=":literal"><semantics><msub><mi>λ</mi><mtext>MC</mtext></msub><annotation encoding="application/x-tex">\lambda_{\text{MC}}</annotation></semantics></math> is tuned on the dev set (same protocol as other inference-time baselines).</p>
</div></li>
<li id="A6.I1.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i4.p1" class="ltx_para">
<p id="A6.I1.i4.p1.1" class="ltx_p"><span id="A6.I1.i4.p1.1.1" class="ltx_text ltx_font_bold">DeAL decoding-time alignment (rollout reranking).</span>
Given a prompt <math id="A6.I1.i4.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> and a partially generated prefix <math id="A6.I1.i4.p1.m2" class="ltx_Math" alttext="x_{&lt;t}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><annotation encoding="application/x-tex">x_{&lt;t}</annotation></semantics></math> at decoding step <math id="A6.I1.i4.p1.m3" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, the base LM defines next-token probabilities <math id="A6.I1.i4.p1.m4" class="ltx_Math" alttext="p_{\theta}(v\mid s,x_{&lt;t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{\theta}(v\mid s,x_{&lt;t})</annotation></semantics></math> over the vocabulary <math id="A6.I1.i4.p1.m5" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math>.
DeAL performs a one-step lookahead search over the top-<math id="A6.I1.i4.p1.m6" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> next tokens:</p>
<table id="A6.Ex44" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex44.m1" class="ltx_Math" alttext="\mathcal{V}_{t}^{(k)}:=\arg\max_{v\in\mathcal{V}}^{k}\ \log p_{\theta}(v\mid s,x_{&lt;t})." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munderover><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><mi>k</mi></munderover><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{V}_{t}^{(k)}:=\arg\max_{v\in\mathcal{V}}^{k}\ \log p_{\theta}(v\mid s,x_{&lt;t}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i4.p1.2" class="ltx_p">For each candidate token <math id="A6.I1.i4.p1.m7" class="ltx_Math" alttext="v\in\mathcal{V}_{t}^{(k)}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">v\in\mathcal{V}_{t}^{(k)}</annotation></semantics></math>, we form the candidate prefix <math id="A6.I1.i4.p1.m8" class="ltx_Math" alttext="x_{&lt;t}v" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><annotation encoding="application/x-tex">x_{&lt;t}v</annotation></semantics></math> and compute a length-<math id="A6.I1.i4.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> lookahead continuation using <em id="A6.I1.i4.p1.2.1" class="ltx_emph ltx_font_italic">greedy</em> rollout:</p>
<table id="A6.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex45.m1" class="ltx_math_unparsed" alttext="\tilde{x}_{t:t+L-1}^{(v)}:=\mathrm{GreedyRollout}\bigl(\pi_{\theta};\ s,\ x_{&lt;t}v,\ L\bigr)," display="block" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>t</mi><mo>+</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>:=</mo><mi>GreedyRollout</mi><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>π</mi><mi>θ</mi></msub><mo rspace="0.667em">;</mo><mi>s</mi><mo rspace="0.667em">,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mi>v</mi><mo rspace="0.667em">,</mo><mi>L</mi><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{x}_{t:t+L-1}^{(v)}:=\mathrm{GreedyRollout}\bigl(\pi_{\theta};\ s,\ x_{&lt;t}v,\ L\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i4.p1.3" class="ltx_p">where <math id="A6.I1.i4.p1.m10" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> is the same LM used as the proposal policy.
We then score the resulting partial completion with a reward model <math id="A6.I1.i4.p1.m11" class="ltx_Math" alttext="r_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>r</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">r_{\phi}</annotation></semantics></math>:</p>
<table id="A6.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex46.m1" class="ltx_math_unparsed" alttext="\mathrm{RM}(s,x_{&lt;t}v):=r_{\phi}\!\left(s,\ x_{&lt;t}v\tilde{x}_{t:t+L-1}^{(v)}\right)." display="block" intent=":literal"><semantics><mrow><mi>RM</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mi>v</mi><mo stretchy="false">)</mo></mrow><mo>:=</mo><msub><mi>r</mi><mi>ϕ</mi></msub><mrow><mo>(</mo><mi>s</mi><mo rspace="0.667em">,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mi>v</mi><msubsup><mover accent="true"><mi>x</mi><mo>~</mo></mover><mrow><mi>t</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi>t</mi><mo>+</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow></mrow><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{RM}(s,x_{&lt;t}v):=r_{\phi}\!\left(s,\ x_{&lt;t}v\tilde{x}_{t:t+L-1}^{(v)}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i4.p1.4" class="ltx_p">DeAL selects the next token by maximizing a combined objective</p>
<table id="A6.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex47.m1" class="ltx_Math" alttext="v_{t}\in\arg\max_{v\in\mathcal{V}_{t}^{(k)}}\Bigl\{\log p_{\theta}(v\mid s,x_{&lt;t})+\gamma\cdot\mathrm{RM}(s,x_{&lt;t}v)\Bigr\}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>v</mi><mi>t</mi></msub><mo>∈</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>v</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi>t</mi><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></munder></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>p</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>s</mi><mo>,</mo><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>RM</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mrow><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">v_{t}\in\arg\max_{v\in\mathcal{V}_{t}^{(k)}}\Bigl\{\log p_{\theta}(v\mid s,x_{&lt;t})+\gamma\cdot\mathrm{RM}(s,x_{&lt;t}v)\Bigr\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i4.p1.5" class="ltx_p">and updates <math id="A6.I1.i4.p1.m12" class="ltx_Math" alttext="x_{&lt;t+1}\leftarrow x_{&lt;t}v_{t}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></mrow></msub><mo stretchy="false">←</mo><mrow><msub><mi>x</mi><mrow><mphantom></mphantom><mo>&lt;</mo><mi>t</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>t</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x_{&lt;t+1}\leftarrow x_{&lt;t}v_{t}</annotation></semantics></math> until EOS or the maximum length is reached.
This baseline is substantially more expensive than reranking a fixed candidate set, since it requires <math id="A6.I1.i4.p1.m13" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math> rollouts and RM evaluations at each decoding step.</p>
</div></li>
<li id="A6.I1.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i5.p1" class="ltx_para">
<p id="A6.I1.i5.p1.1" class="ltx_p"><span id="A6.I1.i5.p1.1.1" class="ltx_text ltx_font_bold">Regularized Best-of-<math id="A6.I1.i5.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> (RBoN).</span>
RBoN augments reward-model reranking with a reference-policy regularizer to mitigate reward hacking at inference time <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib70" title="" class="ltx_ref">Jinnai et al., 2024</a>)</cite>.
Let <math id="A6.I1.i5.p1.m2" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> be a fixed reference policy (we use the generator as <math id="A6.I1.i5.p1.m3" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> unless otherwise stated).
For each candidate <math id="A6.I1.i5.p1.m4" class="ltx_Math" alttext="y\in\mathcal{Y}(s)" display="inline" intent=":literal"><semantics><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">y\in\mathcal{Y}(s)</annotation></semantics></math>, compute the per-token average log-likelihood under <math id="A6.I1.i5.p1.m5" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math>,
<math id="A6.I1.i5.p1.m6" class="ltx_Math" alttext="\bar{\ell}_{\mathrm{ref}}(s,y)=\frac{1}{|y|}\log\pi_{\mathrm{ref}}(y\mid s)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi mathvariant="normal">ℓ</mi><mo>¯</mo></mover><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mrow><mo stretchy="false">|</mo><mi>y</mi><mo stretchy="false">|</mo></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo fence="true" lspace="0em" rspace="0em">∣</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\bar{\ell}_{\mathrm{ref}}(s,y)=\frac{1}{|y|}\log\pi_{\mathrm{ref}}(y\mid s)</annotation></semantics></math>
(or the unnormalized log-likelihood if length normalization is disabled).
RBoN selects</p>
<table id="A6.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex48.m1" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\Big(\hat{\mu}_{\text{sel}}(s,y)+\beta_{\text{RBoN}}\,\bar{\ell}_{\mathrm{ref}}(s,y)\Big)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><munder><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>β</mi><mtext>RBoN</mtext></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi mathvariant="normal">ℓ</mi><mo>¯</mo></mover><mi>ref</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\Big(\hat{\mu}_{\text{sel}}(s,y)+\beta_{\text{RBoN}}\,\bar{\ell}_{\mathrm{ref}}(s,y)\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i5.p1.2" class="ltx_p">where <math id="A6.I1.i5.p1.m7" class="ltx_Math" alttext="\beta_{\text{RBoN}}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mtext>RBoN</mtext></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta_{\text{RBoN}}\geq 0</annotation></semantics></math> controls the strength of regularization and is tuned on the dev set.</p>
</div></li>
<li id="A6.I1.i6" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i6.p1" class="ltx_para">
<p id="A6.I1.i6.p1.1" class="ltx_p"><span id="A6.I1.i6.p1.1.1" class="ltx_text ltx_font_bold">Best-of-Poisson (BoP) and HedgeTune.</span>
Following <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib72" title="" class="ltx_ref">Khalaf et al. (2025)</a></cite>, we hedge greedy best-of-<math id="A6.I1.i6.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> selection by randomizing the effective candidate budget.
For each prompt <math id="A6.I1.i6.p1.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, sample <math id="A6.I1.i6.p1.m3" class="ltx_Math" alttext="K^{\prime}\sim\mathrm{Poisson}(\lambda)" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>′</mo></msup><mo>∼</mo><mrow><mi>Poisson</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>λ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K^{\prime}\sim\mathrm{Poisson}(\lambda)</annotation></semantics></math> and truncate to <math id="A6.I1.i6.p1.m4" class="ltx_Math" alttext="K^{\prime}\leftarrow\min(\max(K^{\prime},1),K)" display="inline" intent=":literal"><semantics><mrow><msup><mi>K</mi><mo>′</mo></msup><mo stretchy="false">←</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>K</mi><mo>′</mo></msup><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">K^{\prime}\leftarrow\min(\max(K^{\prime},1),K)</annotation></semantics></math>.
Let <math id="A6.I1.i6.p1.m5" class="ltx_Math" alttext="\mathcal{I}\subseteq\{1,\dots,K\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>⊆</mo><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{I}\subseteq\{1,\dots,K\}</annotation></semantics></math> be a uniformly sampled index set of size <math id="A6.I1.i6.p1.m6" class="ltx_Math" alttext="|\mathcal{I}|=K^{\prime}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo stretchy="false">|</mo></mrow><mo>=</mo><msup><mi>K</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">|\mathcal{I}|=K^{\prime}</annotation></semantics></math> and define the corresponding subset
<math id="A6.I1.i6.p1.m7" class="ltx_Math" alttext="\mathcal{Y}_{\mathcal{I}}(s)=\{y_{i}:i\in\mathcal{I}\}\subseteq\mathcal{Y}(s)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi class="ltx_font_mathcaligraphic">ℐ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mi>i</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>i</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}_{\mathcal{I}}(s)=\{y_{i}:i\in\mathcal{I}\}\subseteq\mathcal{Y}(s)</annotation></semantics></math>.
BoP selects</p>
<table id="A6.Ex49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex49.m1" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}_{\mathcal{I}}(s)}\hat{\mu}_{\text{sel}}(s,y)." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒴</mi><mi class="ltx_font_mathcaligraphic">ℐ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}_{\mathcal{I}}(s)}\hat{\mu}_{\text{sel}}(s,y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i6.p1.2" class="ltx_p">HedgeTune chooses <math id="A6.I1.i6.p1.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math> using the same dev-set protocol as other inference-time baselines, and fixes it for evaluation.</p>
</div></li>
<li id="A6.I1.i7" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i7.p1" class="ltx_para">
<p id="A6.I1.i7.p1.1" class="ltx_p"><em id="A6.I1.i7.p1.1.1" class="ltx_emph ltx_font_bold ltx_font_italic">Caution</em><span id="A6.I1.i7.p1.1.2" class="ltx_text ltx_font_bold">: pessimistic best-of-<math id="A6.I1.i7.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> reranking.</span>
Inspired by <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib71" title="" class="ltx_ref">Anonymous (2025)</a></cite>, we penalize atypical candidates using an auxiliary error (or atypicality) signal <math id="A6.I1.i7.p1.m2" class="ltx_Math" alttext="e(s,y)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>e</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">e(s,y)\geq 0</annotation></semantics></math>,
yielding a pessimistic score</p>
<table id="A6.Ex50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex50.m1" class="ltx_Math" alttext="\mathrm{Score}_{\mathrm{caut}}(s,y):=\hat{\mu}_{\text{sel}}(s,y)-\alpha_{\mathrm{caut}}\,e(s,y)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>Score</mi><mi>caut</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>α</mi><mi>caut</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Score}_{\mathrm{caut}}(s,y):=\hat{\mu}_{\text{sel}}(s,y)-\alpha_{\mathrm{caut}}\,e(s,y).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i7.p1.2" class="ltx_p">We then select</p>
<table id="A6.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex51.m1" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\mathrm{Score}_{\mathrm{caut}}(s,y)," display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mi>Score</mi><mi>caut</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\mathrm{Score}_{\mathrm{caut}}(s,y),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i7.p1.3" class="ltx_p">where <math id="A6.I1.i7.p1.m3" class="ltx_Math" alttext="\alpha_{\mathrm{caut}}\geq 0" display="inline" intent=":literal"><semantics><mrow><msub><mi>α</mi><mi>caut</mi></msub><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\alpha_{\mathrm{caut}}\geq 0</annotation></semantics></math> controls the strength of pessimism and is tuned on the dev set.</p>
</div></li>
<li id="A6.I1.i8" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i8.p1" class="ltx_para">
<p id="A6.I1.i8.p1.1" class="ltx_p"><span id="A6.I1.i8.p1.1.1" class="ltx_text ltx_font_bold">DARC (ours, scorer-robust):</span>
define scorer-specific <math id="A6.I1.i8.p1.m1" class="ltx_Math" alttext="\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)</annotation></semantics></math> and aggregate</p>
<table id="A6.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex52.m1" class="ltx_Math" alttext="\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y):=-\frac{1}{\gamma}\log\!\left(\frac{1}{M}\sum_{m=1}^{M}\exp\!\big(-\gamma\,\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)\big)\right)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mo>−</mo><mrow><mfrac><mn>1</mn><mi>γ</mi></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mpadded style="width:1.146em;" width="1.146em"><mi>log</mi></mpadded><mo>⁡</mo><mrow><mo>(</mo><mrow><mfrac><mn>1</mn><mi>M</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>M</mi></munderover><mrow><mpadded style="width:1.370em;" width="1.370em"><mi>exp</mi></mpadded><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo>−</mo><mrow><mi>γ</mi><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y):=-\frac{1}{\gamma}\log\!\left(\frac{1}{M}\sum_{m=1}^{M}\exp\!\big(-\gamma\,\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)\big)\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i8.p1.2" class="ltx_p">then select
<math id="A6.I1.i8.p1.m2" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y).</annotation></semantics></math></p>
</div></li>
<li id="A6.I1.i9" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i9.p1" class="ltx_para">
<p id="A6.I1.i9.p1.1" class="ltx_p"><span id="A6.I1.i9.p1.1.1" class="ltx_text ltx_font_bold">Hard budget (DARC-<math id="A6.I1.i9.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> on scorer-robust entropic risk premium):</span>
define scorer-specific risk premia
<math id="A6.I1.i9.p1.m2" class="ltx_Math" alttext="\widehat{\mathrm{RP}}^{(m)}_{\beta,\text{sel}}(s,y)=\hat{\mu}^{(m)}_{\text{sel}}(s,y)-\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>RP</mi><mo>^</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><msubsup><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mtext>sel</mtext><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msubsup><mover accent="true"><mi>V</mi><mo>^</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathrm{RP}}^{(m)}_{\beta,\text{sel}}(s,y)=\hat{\mu}^{(m)}_{\text{sel}}(s,y)-\widehat{V}^{(m)}_{\beta,\text{sel}}(s,y)</annotation></semantics></math>
and aggregate pessimistically
<math id="A6.I1.i9.p1.m3" class="ltx_Math" alttext="\widetilde{\mathrm{RP}}_{\beta,\text{sel}}(s,y):=\max_{m\in[M]}\widehat{\mathrm{RP}}^{(m)}_{\beta,\text{sel}}(s,y)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>RP</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>RP</mi><mo>^</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\mathrm{RP}}_{\beta,\text{sel}}(s,y):=\max_{m\in[M]}\widehat{\mathrm{RP}}^{(m)}_{\beta,\text{sel}}(s,y).</annotation></semantics></math>
Select</p>
<table id="A6.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex53.m1" class="ltx_Math" alttext="y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y)\ \text{s.t.}\ \widetilde{\mathrm{RP}}_{\beta,\text{sel}}(s,y)\leq\tau;" display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><munder><mi>max</mi><mrow><mi>y</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></munder></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.500em" rspace="0em">​</mo><mtext>s.t.</mtext><mo lspace="0.500em" rspace="0em">​</mo><msub><mover accent="true"><mi>RP</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi>τ</mi></mrow><mo>;</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\max_{y\in\mathcal{Y}(s)}\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y)\ \text{s.t.}\ \widetilde{\mathrm{RP}}_{\beta,\text{sel}}(s,y)\leq\tau;</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.I1.i9.p1.2" class="ltx_p">if the feasible set is empty, we fall back to <math id="A6.I1.i9.p1.m4" class="ltx_Math" alttext="\mathcal{Y}(s)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}(s)</annotation></semantics></math>.</p>
</div></li>
<li id="A6.I1.i10" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A6.I1.i10.p1" class="ltx_para">
<p id="A6.I1.i10.p1.1" class="ltx_p"><math id="A6.I1.i10.p1.m1" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math><span id="A6.I1.i10.p1.1.1" class="ltx_text ltx_font_bold">-tie breaking (DARC-<math id="A6.I1.i10.p1.m2" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math> on scorer-robust value):</span>
define the near-tie set
<math id="A6.I1.i10.p1.m3" class="ltx_Math" alttext="\mathcal{F}_{\epsilon}(s)=\{y:\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y)\geq\widetilde{V}_{\beta,\gamma,\text{sel},\max}(s)-\epsilon\}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><mi>y</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mtext>sel</mtext></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mover accent="true"><mi>V</mi><mo>~</mo></mover><mrow><mi>β</mi><mo>,</mo><mi>γ</mi><mo>,</mo><mtext>sel</mtext><mo>,</mo><mi>max</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>ϵ</mi></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{F}_{\epsilon}(s)=\{y:\widetilde{V}_{\beta,\gamma,\text{sel}}(s,y)\geq\widetilde{V}_{\beta,\gamma,\text{sel},\max}(s)-\epsilon\},</annotation></semantics></math>
and define the worst-case disagreement proxy
<math id="A6.I1.i10.p1.m4" class="ltx_Math" alttext="\widetilde{\sigma}_{\text{sel}}(s,y):=\max_{m\in[M]}\hat{\sigma}^{(m)}_{\text{sel}}(s,y)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>m</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mtext>sel</mtext><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widetilde{\sigma}_{\text{sel}}(s,y):=\max_{m\in[M]}\hat{\sigma}^{(m)}_{\text{sel}}(s,y).</annotation></semantics></math>
Select
<math id="A6.I1.i10.p1.m5" class="ltx_Math" alttext="y^{\star}=\arg\min_{y\in\mathcal{F}_{\epsilon}(s)}\widetilde{\sigma}_{\text{sel}}(s,y)." display="inline" intent=":literal"><semantics><mrow><mrow><msup><mi>y</mi><mo>⋆</mo></msup><mo>=</mo><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>min</mi><mrow><mi>y</mi><mo>∈</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>ϵ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mtext>sel</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">y^{\star}=\arg\min_{y\in\mathcal{F}_{\epsilon}(s)}\widetilde{\sigma}_{\text{sel}}(s,y).</annotation></semantics></math></p>
</div></li>
</ul>
</div>
</section>
<section id="A6.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">F.3 </span>Training-time robust policies: cDPO and rDPO</h3>

<section id="A6.SS3.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Preference data and DPO objective.</h4>

<div id="A6.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A6.SS3.SSS0.Px1.p1.1" class="ltx_p">Let <math id="A6.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathcal{D}=\{(s,y^{+},y^{-})\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒟</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}=\{(s,y^{+},y^{-})\}</annotation></semantics></math> be a preference dataset, where for each input <math id="A6.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> the response <math id="A6.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="y^{+}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mo>+</mo></msup><annotation encoding="application/x-tex">y^{+}</annotation></semantics></math> is preferred over <math id="A6.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="y^{-}" display="inline" intent=":literal"><semantics><msup><mi>y</mi><mo>−</mo></msup><annotation encoding="application/x-tex">y^{-}</annotation></semantics></math>.
Let <math id="A6.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math> be the policy to be trained and <math id="A6.SS3.SSS0.Px1.p1.m6" class="ltx_Math" alttext="\pi_{\mathrm{ref}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>ref</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{ref}}</annotation></semantics></math> a fixed reference policy.
Define the logit difference</p>
<table id="A6.Ex54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex54.m1" class="ltx_Math" alttext="\Delta_{\theta}(s,y^{+},y^{-})=\Big(\log\pi_{\theta}(y^{+}|s)-\log\pi_{\theta}(y^{-}|s)\Big)-\Big(\log\pi_{\mathrm{ref}}(y^{+}|s)-\log\pi_{\mathrm{ref}}(y^{-}|s)\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>θ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>−</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi>π</mi><mi>ref</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>−</mo></msup><mo lspace="0em" rspace="0em">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\Delta_{\theta}(s,y^{+},y^{-})=\Big(\log\pi_{\theta}(y^{+}|s)-\log\pi_{\theta}(y^{-}|s)\Big)-\Big(\log\pi_{\mathrm{ref}}(y^{+}|s)-\log\pi_{\mathrm{ref}}(y^{-}|s)\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p1.2" class="ltx_p">The standard DPO loss is</p>
<table id="A6.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex55.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{DPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[-\log\sigma\big(\beta\,\Delta_{\theta}(s,y^{+},y^{-})\big)\Big]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>DPO</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mo rspace="0.167em">−</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{DPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[-\log\sigma\big(\beta\,\Delta_{\theta}(s,y^{+},y^{-})\big)\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px1.p1.3" class="ltx_p">where <math id="A6.SS3.SSS0.Px1.p1.m7" class="ltx_Math" alttext="\sigma(\cdot)" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma(\cdot)</annotation></semantics></math> is the logistic sigmoid and <math id="A6.SS3.SSS0.Px1.p1.m8" class="ltx_Math" alttext="\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\beta&gt;0</annotation></semantics></math> controls the strength of preference optimization.</p>
</div>
</section>
<section id="A6.SS3.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Conservative DPO (cDPO).</h4>

<div id="A6.SS3.SSS0.Px2.p1" class="ltx_para">
<p id="A6.SS3.SSS0.Px2.p1.1" class="ltx_p">We implement a conservative variant by applying label smoothing to the pairwise preference target.
Specifically, for a smoothing parameter <math id="A6.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="\varepsilon\in(0,1/2)" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\in(0,1/2)</annotation></semantics></math>, we use the smoothed loss</p>
<table id="A6.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex56.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{cDPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[-(1-\varepsilon)\log\sigma(\beta\,\Delta_{\theta})-\varepsilon\log\big(1-\sigma(\beta\,\Delta_{\theta})\big)\Big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>cDPO</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>ε</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mi>ε</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{cDPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[-(1-\varepsilon)\log\sigma(\beta\,\Delta_{\theta})-\varepsilon\log\big(1-\sigma(\beta\,\Delta_{\theta})\big)\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px2.p1.2" class="ltx_p">We denote the resulting trained policy as <math id="A6.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\pi_{\mathrm{cDPO}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>cDPO</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{cDPO}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A6.SS3.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Robust DPO (rDPO).</h4>

<div id="A6.SS3.SSS0.Px3.p1" class="ltx_para">
<p id="A6.SS3.SSS0.Px3.p1.1" class="ltx_p">Preference data may contain noise or ambiguity. We consider a robust variant that optimizes against uncertainty in preference labels.
Let <math id="A6.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="q\in[0,1]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in[0,1]</annotation></semantics></math> denote an (unknown) probability that the pair <math id="A6.SS3.SSS0.Px3.p1.m2" class="ltx_Math" alttext="(y^{+},y^{-})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(y^{+},y^{-})</annotation></semantics></math> is correctly labeled for input <math id="A6.SS3.SSS0.Px3.p1.m3" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>.
We model robustness by optimizing the worst-case (or uncertainty-aware) expected loss over an admissible set <math id="A6.SS3.SSS0.Px3.p1.m4" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math>:</p>
<table id="A6.Ex57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A6.Ex57.m1" class="ltx_Math" alttext="\mathcal{L}_{\mathrm{rDPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[\sup_{q\in\mathcal{Q}}\big(-q\log\sigma(\beta\,\Delta_{\theta})-(1-q)\log(1-\sigma(\beta\,\Delta_{\theta}))\big)\Big]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>rDPO</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>y</mi><mo>+</mo></msup><mo>,</mo><msup><mi>y</mi><mo>−</mo></msup><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi class="ltx_font_mathcaligraphic">𝒟</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><munder><mo lspace="0em" movablelimits="false" rspace="0em">sup</mo><mrow><mi>q</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒬</mi></mrow></munder><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo>−</mo><mrow><mi>q</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>q</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.170em" rspace="0em">​</mo><msub><mi mathvariant="normal">Δ</mi><mi>θ</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{L}_{\mathrm{rDPO}}(\theta)=\mathbb{E}_{(s,y^{+},y^{-})\sim\mathcal{D}}\Big[\sup_{q\in\mathcal{Q}}\big(-q\log\sigma(\beta\,\Delta_{\theta})-(1-q)\log(1-\sigma(\beta\,\Delta_{\theta}))\big)\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A6.SS3.SSS0.Px3.p1.2" class="ltx_p">Here <math id="A6.SS3.SSS0.Px3.p1.m5" class="ltx_Math" alttext="\mathcal{Q}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒬</mi><annotation encoding="application/x-tex">\mathcal{Q}</annotation></semantics></math> specifies the assumed noise level (e.g., <math id="A6.SS3.SSS0.Px3.p1.m6" class="ltx_Math" alttext="q\in[1-\rho,1]" display="inline" intent=":literal"><semantics><mrow><mi>q</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mn>1</mn><mo>−</mo><mi>ρ</mi></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">q\in[1-\rho,1]</annotation></semantics></math> for some <math id="A6.SS3.SSS0.Px3.p1.m7" class="ltx_Math" alttext="\rho\in[0,1/2)" display="inline" intent=":literal"><semantics><mrow><mi>ρ</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\rho\in[0,1/2)</annotation></semantics></math>).
We denote the resulting trained policy as <math id="A6.SS3.SSS0.Px3.p1.m8" class="ltx_Math" alttext="\pi_{\mathrm{rDPO}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>rDPO</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{rDPO}}</annotation></semantics></math>.</p>
</div>
</section>
<section id="A6.SS3.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Evaluation protocol (policy + inference-time selection).</h4>

<div id="A6.SS3.SSS0.Px4.p1" class="ltx_para">
<p id="A6.SS3.SSS0.Px4.p1.1" class="ltx_p">For any trained policy <math id="A6.SS3.SSS0.Px4.p1.m1" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math> (including <math id="A6.SS3.SSS0.Px4.p1.m2" class="ltx_Math" alttext="\pi_{\mathrm{cDPO}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>cDPO</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{cDPO}}</annotation></semantics></math> and <math id="A6.SS3.SSS0.Px4.p1.m3" class="ltx_Math" alttext="\pi_{\mathrm{rDPO}}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>rDPO</mi></msub><annotation encoding="application/x-tex">\pi_{\mathrm{rDPO}}</annotation></semantics></math>), at inference time we sample a candidate set
<math id="A6.SS3.SSS0.Px4.p1.m4" class="ltx_math_unparsed" alttext="\mathcal{Y}(s)=\{y_{1},\dots,y_{K}\}\sim\pi(\cdot|s)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><mi>K</mi></msub><mo stretchy="false">}</mo></mrow><mo>∼</mo><mi>π</mi><mrow><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}(s)=\{y_{1},\dots,y_{K}\}\sim\pi(\cdot|s)</annotation></semantics></math> and then apply the same selection rules defined in Appendix <a href="#A6" title="Appendix F Detailed decoding rules and baselines ‣ DARC: Disagreement-Aware Alignment via Risk-Constrained Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">F</span></a>,
e.g., Mean (Best-of-<math id="A6.SS3.SSS0.Px4.p1.m5" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math>) or DARC-<math id="A6.SS3.SSS0.Px4.p1.m6" class="ltx_Math" alttext="\epsilon" display="inline" intent=":literal"><semantics><mi>ϵ</mi><annotation encoding="application/x-tex">\epsilon</annotation></semantics></math>.
This isolates the effect of <em id="A6.SS3.SSS0.Px4.p1.1.1" class="ltx_emph ltx_font_italic">training-time robustness</em> (changing <math id="A6.SS3.SSS0.Px4.p1.m7" class="ltx_Math" alttext="\pi" display="inline" intent=":literal"><semantics><mi>π</mi><annotation encoding="application/x-tex">\pi</annotation></semantics></math>) from <em id="A6.SS3.SSS0.Px4.p1.1.2" class="ltx_emph ltx_font_italic">inference-time robustness</em> (changing the selection rule).</p>
</div>
</section>
</section>
</section>
<section id="A7" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix G </span>Related Work</h2>

<section id="A7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.1 </span>Preference optimization for alignment</h3>

<div id="A7.SS1.p1" class="ltx_para">
<p id="A7.SS1.p1.1" class="ltx_p">Preference-based alignment is the prevailing paradigm for steering LLMs, ranging from RLHF-style reward modeling with policy optimization to direct preference objectives that learn from comparisons without explicit RL loops <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib1" title="" class="ltx_ref">Ouyang et al., 2022</a>; <a href="#bib.bib9" title="" class="ltx_ref">Christiano et al., 2017</a>; <a href="#bib.bib2" title="" class="ltx_ref">Rafailov et al., 2023</a>)</cite>.
Recent work largely focuses on making preference optimization simpler and more stable, e.g., via single-stage or reference-light formulations that resemble standard fine-tuning <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib5" title="" class="ltx_ref">Hong et al., 2024</a>; <a href="#bib.bib6" title="" class="ltx_ref">Meng et al., 2024</a>; <a href="#bib.bib38" title="" class="ltx_ref">Guo et al., 2024</a>)</cite>.
A second theme highlights the role of <em id="A7.SS1.p1.1.1" class="ltx_emph ltx_font_italic">data coverage</em>: when preference data poorly covers the model’s behavior distribution, offline updates can degrade, motivating unified online–offline perspectives and value-aware objectives <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib34" title="" class="ltx_ref">Song et al., 2024</a>; <a href="#bib.bib35" title="" class="ltx_ref">Cen et al., 2024</a>)</cite>.
Meanwhile, newer datasets enrich supervision beyond pairwise comparisons with multi-attribute ratings and complementary preference signals, enabling finer-grained diagnosis and reward learning <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Wang et al., 2024c</a>; <a href="#bib.bib33" title="" class="ltx_ref">Wang et al., 2024b</a>)</cite>.
Despite these advances, most methods still collapse alignment into optimizing a single scalar proxy of utility (often motivated by Bradley–Terry style models <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Bradley and Terry, 1952</a>)</cite>), which can mask structured disagreement and sensitivity to annotator mix.</p>
</div>
</section>
<section id="A7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">G.2 </span>Heterogeneity, robustness, and inference-time alignment</h3>

<div id="A7.SS2.p1" class="ltx_para">
<p id="A7.SS2.p1.1" class="ltx_p">A growing body of work shows that preferences are intrinsically heterogeneous: annotators disagree systematically, and average-score alignment can hide persistent failures for sub-populations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib11" title="" class="ltx_ref">Zhang et al., 2024</a>; <a href="#bib.bib12" title="" class="ltx_ref">Chen et al., 2024</a>; <a href="#bib.bib13" title="" class="ltx_ref">Casper et al., 2023</a>)</cite>.
This is compounded by proxy over-optimization, where scaling up optimization against an imperfect reward/preference proxy can degrade the underlying target for both RLHF and direct alignment <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib14" title="" class="ltx_ref">Gao et al., 2023</a>; <a href="#bib.bib15" title="" class="ltx_ref">Rafailov et al., 2024</a>)</cite>.
Robustness-oriented approaches therefore move beyond mean objectives, including distributionally robust and group-robust formulations that protect against noise and minority-group degradation <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib16" title="" class="ltx_ref">Wu et al., 2024</a>; <a href="#bib.bib17" title="" class="ltx_ref">Ramesh et al., 2024</a>; <a href="#bib.bib36" title="" class="ltx_ref">Chakraborty et al., 2024</a>)</cite>.
Another complementary direction makes reward signals multi-dimensional via multi-objective reward modeling or multi-head aggregation, improving interpretability and offering more conservative combinations, but typically requiring richer supervision and an explicit (often fixed) scalarization for deployment <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib31" title="" class="ltx_ref">Wang et al., 2024a</a>; <a href="#bib.bib39" title="" class="ltx_ref">Li et al., 2025</a>; <a href="#bib.bib37" title="" class="ltx_ref">Yang et al., 2024</a>)</cite>.
Finally, inference-time alignment methods avoid retraining by allocating extra computation at decoding to select better candidates, though recent analyses caution that aggressive best-of-<math id="A7.SS2.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> selection can amplify proxy error under miscalibration or under-coverage <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib22" title="" class="ltx_ref">Sun et al., 2024</a>; <a href="#bib.bib26" title="" class="ltx_ref">Huang et al., 2025a</a>; <a href="#bib.bib21" title="" class="ltx_ref">Ichihara et al., 2025</a>; <a href="#bib.bib40" title="" class="ltx_ref">Huang et al., 2025b</a>)</cite>.
Standardized reward-model benchmarks further support systematic study of these issues across settings, including retrieval-augmented generation <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib27" title="" class="ltx_ref">Lambert et al., 2025</a>; <a href="#bib.bib28" title="" class="ltx_ref">Zhou et al., 2024</a>; <a href="#bib.bib30" title="" class="ltx_ref">Jin et al., 2025</a>; <a href="#bib.bib29" title="" class="ltx_ref">Liu et al., 2024b</a>)</cite>.</p>
</div>
<section id="A7.SS2.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Distributionally robust optimization and variance regularization.</h4>

<div id="A7.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A7.SS2.SSS0.Px1.p1.1" class="ltx_p">Distributionally robust optimization (DRO) studies objectives of the form <math id="A7.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\min_{\theta}\sup_{\mathbb{Q}\in\mathcal{U}(\widehat{\mathbb{P}})}\mathbb{E}_{\mathbb{Q}}[\ell(\theta;Z)]" display="inline" intent=":literal"><semantics><mrow><mi>min</mi><mo lspace="0.167em">⁡</mo><mrow><mrow><mmultiscripts><mo>sup</mo><mrow><mi>ℚ</mi><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒰</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>ℙ</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow></mrow><mprescripts></mprescripts><mi>θ</mi><mrow></mrow></mmultiscripts><mo lspace="0.167em">⁡</mo><msub><mi>𝔼</mi><mi>ℚ</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\min_{\theta}\sup_{\mathbb{Q}\in\mathcal{U}(\widehat{\mathbb{P}})}\mathbb{E}_{\mathbb{Q}}[\ell(\theta;Z)]</annotation></semantics></math>,
where the true distribution is assumed to lie in an ambiguity set around the empirical distribution <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib58" title="" class="ltx_ref">Wiesemann et al., 2014</a>; <a href="#bib.bib59" title="" class="ltx_ref">Rahimian and Mehrotra, 2019</a>)</cite>.
Local <math id="A7.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>-divergence neighborhoods yield tractable robust objectives and have been widely used in learning and optimization <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib53" title="" class="ltx_ref">Namkoong and Duchi, 2016</a>)</cite>.
In particular, <math id="A7.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\chi^{2}" display="inline" intent=":literal"><semantics><msup><mi>χ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\chi^{2}</annotation></semantics></math>-DRO is closely connected to variance-based regularization and generalized empirical likelihood perspectives <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib54" title="" class="ltx_ref">Duchi and Namkoong, 2019</a>; <a href="#bib.bib55" title="" class="ltx_ref">Duchi et al., 2021</a>)</cite>.
Our work brings this DRO view to <em id="A7.SS2.SSS0.Px1.p1.1.1" class="ltx_emph ltx_font_italic">inference-time decoding</em> under heterogeneous human preferences:
the same mean–dispersion score used by DARC arises as the closed-form robust value of a <math id="A7.SS2.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\chi^{2}" display="inline" intent=":literal"><semantics><msup><mi>χ</mi><mn>2</mn></msup><annotation encoding="application/x-tex">\chi^{2}</annotation></semantics></math>-ambiguity set.
DRO is also motivated by heterogeneous subpopulations and uniform-performance desiderata <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib57" title="" class="ltx_ref">Duchi and Namkoong, 2021</a>)</cite>,
and efficient large-scale methods exist for common DRO formulations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib60" title="" class="ltx_ref">Levy et al., 2020</a>)</cite>.</p>
</div>
</section>
</section>
</section>
<section id="A8" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix H </span>Experiments</h2>

<section id="A8.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">H.1 </span>Human disagreement on the raw Top-<math id="A8.SS1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> candidate pool</h3>

<div id="A8.SS1.p1" class="ltx_para">
<p id="A8.SS1.p1.1" class="ltx_p">Even before applying any reranking, the raw Top-<math id="A8.SS1.p1.m1" class="ltx_Math" alttext="K" display="inline" intent=":literal"><semantics><mi>K</mi><annotation encoding="application/x-tex">K</annotation></semantics></math> candidate pool can exhibit substantial human disagreement.
We quantify this on <span id="A8.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">AlpacaEval 2.0</span> and <span id="A8.SS1.p1.1.2" class="ltx_text ltx_font_smallcaps">MT-Bench</span> using the same pool size <math id="A8.SS1.p1.m2" class="ltx_Math" alttext="K{=}5" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">K{=}5</annotation></semantics></math>.</p>
</div>
<section id="A8.SS1.SSS0.Px1" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Setup.</h4>

<div id="A8.SS1.SSS0.Px1.p1" class="ltx_para">
<p id="A8.SS1.SSS0.Px1.p1.1" class="ltx_p">For each prompt <math id="A8.SS1.SSS0.Px1.p1.m1" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>, we generate <math id="A8.SS1.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathcal{Y}(s)=\{y_{1},\dots,y_{K}\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒴</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mo stretchy="false">{</mo><msub><mi>y</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>y</mi><mi>K</mi></msub><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{Y}(s)=\{y_{1},\dots,y_{K}\}</annotation></semantics></math> and collect <math id="A8.SS1.SSS0.Px1.p1.m3" class="ltx_Math" alttext="n{=}5" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">n{=}5</annotation></semantics></math> human ratings per candidate on a <math id="A8.SS1.SSS0.Px1.p1.m4" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>–<math id="A8.SS1.SSS0.Px1.p1.m5" class="ltx_Math" alttext="10" display="inline" intent=":literal"><semantics><mn>10</mn><annotation encoding="application/x-tex">10</annotation></semantics></math> scale
(see Appendix <a href="#A9" title="Appendix I Human Evaluation Protocol and Annotator Quality Controls ‣ DARC: Disagreement-Aware Alignment via Risk-Constrained Decoding" class="ltx_ref"><span class="ltx_text ltx_ref_tag">I</span></a>).
For each candidate, we compute the sample mean and variance across raters:</p>
<table id="A8.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex58.m1" class="ltx_Math" alttext="\hat{\mu}_{\mathrm{human}}(s,y_{k}):=\frac{1}{n}\sum_{j=1}^{n}h_{j}(s,y_{k}),\qquad\hat{\sigma}^{2}_{\mathrm{human}}(s,y_{k}):=\frac{1}{n-1}\sum_{j=1}^{n}\bigl(h_{j}(s,y_{k})-\hat{\mu}_{\mathrm{human}}(s,y_{k})\bigr)^{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>human</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>human</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mfrac><mn>1</mn><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>h</mi><mi>j</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>human</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\hat{\mu}_{\mathrm{human}}(s,y_{k}):=\frac{1}{n}\sum_{j=1}^{n}h_{j}(s,y_{k}),\qquad\hat{\sigma}^{2}_{\mathrm{human}}(s,y_{k}):=\frac{1}{n-1}\sum_{j=1}^{n}\bigl(h_{j}(s,y_{k})-\hat{\mu}_{\mathrm{human}}(s,y_{k})\bigr)^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS1.SSS0.Px1.p1.2" class="ltx_p">We summarize per-prompt disagreement by the maximum variance over the pool,
<math id="A8.SS1.SSS0.Px1.p1.m6" class="ltx_Math" alttext="D(s):=\max_{k\in[K]}\hat{\sigma}^{2}_{\mathrm{human}}(s,y_{k})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>:=</mo><mrow><mrow><msub><mi>max</mi><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>^</mo></mover><mi>human</mi><mn>2</mn></msubsup></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msub><mi>y</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D(s):=\max_{k\in[K]}\hat{\sigma}^{2}_{\mathrm{human}}(s,y_{k}),</annotation></semantics></math>
which captures whether at least one candidate is highly contentious.</p>
</div>
</section>
<section id="A8.SS1.SSS0.Px2" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">High-disagreement subset (top 20%).</h4>

<div id="A8.SS1.SSS0.Px2.p1" class="ltx_para">
<p id="A8.SS1.SSS0.Px2.p1.1" class="ltx_p">We define the high-disagreement subset as the top 20% prompts by <math id="A8.SS1.SSS0.Px2.p1.m1" class="ltx_Math" alttext="D(s)" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D(s)</annotation></semantics></math>:</p>
<table id="A8.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A8.Ex59.m1" class="ltx_Math" alttext="\mathcal{S}_{\mathrm{high}}:=\left\{s\in\mathcal{S}:\;D(s)\geq Q_{0.8}(D)\right\}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>high</mi></msub><mo>:=</mo><mrow><mo>{</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo lspace="0.278em" rspace="0.558em">:</mo><mrow><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>Q</mi><mn>0.8</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>}</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\mathrm{high}}:=\left\{s\in\mathcal{S}:\;D(s)\geq Q_{0.8}(D)\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A8.SS1.SSS0.Px2.p1.2" class="ltx_p">where <math id="A8.SS1.SSS0.Px2.p1.m2" class="ltx_Math" alttext="Q_{0.8}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mi>Q</mi><mn>0.8</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>D</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{0.8}(D)</annotation></semantics></math> denotes the <math id="A8.SS1.SSS0.Px2.p1.m3" class="ltx_Math" alttext="80" display="inline" intent=":literal"><semantics><mn>80</mn><annotation encoding="application/x-tex">80</annotation></semantics></math>-th percentile of <math id="A8.SS1.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\{D(s):s\in\mathcal{S}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><mi>D</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{D(s):s\in\mathcal{S}\}</annotation></semantics></math> computed on the evaluation set.
We report main metrics both on the full set and on <math id="A8.SS1.SSS0.Px2.p1.m5" class="ltx_Math" alttext="\mathcal{S}_{\mathrm{high}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>high</mi></msub><annotation encoding="application/x-tex">\mathcal{S}_{\mathrm{high}}</annotation></semantics></math>.</p>
</div>
<figure id="A8.T4" class="ltx_table">
<table id="A8.T4.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A8.T4.3.1" class="ltx_tr">
<th id="A8.T4.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A8.T4.3.1.1.1" class="ltx_text" style="font-size:90%;">Dataset</span></th>
<th id="A8.T4.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T4.m1" class="ltx_Math" alttext="\mathbb{E}_{s}[D(s)]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">𝔼</mi><mi mathsize="0.900em">s</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mi mathsize="0.900em">D</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">s</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{E}_{s}[D(s)]</annotation></semantics></math></th>
<th id="A8.T4.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T4.m2" class="ltx_Math" alttext="Q_{0.8}(D)" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">Q</mi><mn mathsize="0.900em">0.8</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">D</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">Q_{0.8}(D)</annotation></semantics></math></th>
