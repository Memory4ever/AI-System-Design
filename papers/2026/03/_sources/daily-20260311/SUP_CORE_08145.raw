<th id="A8.T4.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A8.T4.3.2.1.1" class="ltx_text" style="font-size:90%;">AlpacaEval 2.0</span></th>
