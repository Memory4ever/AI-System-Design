              <span id="alg1.l30.3" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l30.m1" class="ltx_Math" alttext="\mathcal{F}=\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{F}=\emptyset</annotation></semantics></math> <span id="alg1.l30.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg1.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l31.1" class="ltx_text" style="font-size:80%;">31:</span></span>
              
              
               <math id="alg1.l31.m1" class="ltx_Math" alttext="\mathcal{F}\leftarrow[K]" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mi>K</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}\leftarrow[K]</annotation></semantics></math>

</div>
<div id="alg1.l32" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l32.1" class="ltx_text" style="font-size:80%;">32:</span></span>
              
              
