<td id="A8.T4.3.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A8.T4.3.2.4.1" class="ltx_text" style="font-size:90%;">1.65</span></td>
<td id="A8.T4.3.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="A8.T4.3.2.5.1" class="ltx_text" style="font-size:90%;">0.20</span></td></tr>
