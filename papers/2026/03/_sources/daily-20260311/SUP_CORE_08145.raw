<th id="A8.T4.3.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A8.T4.m4" class="ltx_math_unparsed" alttext="\Pr[D(s)\geq Q_{0.8}(D)]" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">Pr</mi><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mi mathsize="0.900em">D</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">s</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">≥</mo><msub><mi mathsize="0.900em">Q</mi><mn mathsize="0.900em">0.8</mn></msub><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">D</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\Pr[D(s)\geq Q_{0.8}(D)]</annotation></semantics></math></th></tr>
</thead>
