<th id="A8.T10.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="A8.T10.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Method</span></th>
