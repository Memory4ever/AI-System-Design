<td id="S3.T2.2.1.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">0.012</td>
<td id="S3.T2.2.1.4.4" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">86.4%</td>
<td id="S3.T2.2.1.4.5" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">13.6%</td>
<td id="S3.T2.2.1.4.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;">0.005</td>
<td id="S3.T2.2.1.4.7" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.062</td></tr>
<tr id="S3.T2.2.1.5" class="ltx_tr">
<th id="S3.T2.2.1.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bbb ltx_border_r" style="padding:1pt 4.0pt;">Peg Insertion</th>
<th id="S3.T2.2.1.5.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bbb ltx_border_r" style="padding:1pt 4.0pt;">60</th>
<td id="S3.T2.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bbb ltx_border_r" style="padding:1pt 4.0pt;">0.016</td>
<td id="S3.T2.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bbb ltx_border_r" style="padding:1pt 4.0pt;">81.2%</td>
