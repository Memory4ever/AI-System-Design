<tr id="S6.T5.2.1.2" class="ltx_tr">
<th id="S6.T5.2.1.2.1" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T5.2.1.2.1.1" class="ltx_text ltx_font_bold">Lat.</span></th>
<th id="S6.T5.2.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S6.T5.2.1.2.2.1" class="ltx_text ltx_font_bold">Load</span></th>
<th id="S6.T5.2.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T5.2.1.2.3.1" class="ltx_text ltx_font_bold">Lat.</span></th>
<th id="S6.T5.2.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t"><span id="S6.T5.2.1.2.4.1" class="ltx_text ltx_font_bold">Load</span></th>
<th id="S6.T5.2.1.2.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T5.2.1.2.5.1" class="ltx_text ltx_font_bold">Lat.</span></th>
<th id="S6.T5.2.1.2.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><span id="S6.T5.2.1.2.6.1" class="ltx_text ltx_font_bold">Load</span></th></tr>
</thead>
