<td id="S6.T4.2.1.6.4" class="ltx_td ltx_align_center ltx_border_bbbb"><span id="S6.T4.2.1.6.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#CCFFCC;">148.5ms</span></td>
