<td id="S3.T2.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 4.0pt;">82.5%</td>
<td id="S3.T2.2.1.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 4.0pt;">17.5%</td>
<td id="S3.T2.2.1.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1pt 4.0pt;">0.008</td>
<td id="S3.T2.2.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1pt 4.0pt;">0.076</td></tr>
<tr id="S3.T2.2.1.4" class="ltx_tr">
