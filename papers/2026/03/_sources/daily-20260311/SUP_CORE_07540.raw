<td id="A6.T5.14.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HPS v3<math id="A6.T5.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
