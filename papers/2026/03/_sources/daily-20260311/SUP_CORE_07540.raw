</span></td>
<td id="S5.T1.21.1.2.9" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.45pt 3.8pt;">
<span id="S5.T1.21.1.2.9.1" class="ltx_inline-block ltx_align_middle" style="width:35.6pt;">
<span id="S5.T1.21.1.2.9.1.1" class="ltx_p ltx_align_center"><span id="S5.T1.21.1.2.9.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">PickScore</span></span>
</span></td>
<td id="S5.T1.21.1.2.10" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.45pt 3.8pt;">
<span id="S5.T1.21.1.2.10.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
<span id="S5.T1.21.1.2.10.1.1" class="ltx_p ltx_align_center"><span id="S5.T1.21.1.2.10.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Qual.</span></span>
</span></td>
<td id="S5.T1.21.1.2.11" class="ltx_td ltx_align_left ltx_align_middle ltx_border_t" style="padding:0.45pt 3.8pt;">
<span id="S5.T1.21.1.2.11.1" class="ltx_inline-block ltx_align_middle" style="width:25.6pt;">
