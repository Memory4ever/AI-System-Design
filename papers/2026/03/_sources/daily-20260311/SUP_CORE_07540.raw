<td id="A6.T5.14.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.2.1.1" class="ltx_text" style="font-size:90%;">Baseline</span></td>
<td id="A6.T5.14.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.2.2.1" class="ltx_text" style="font-size:90%;">3.1677</span></td>
<td id="A6.T5.14.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.2.3.1" class="ltx_text" style="font-size:90%;">0.1943</span></td>
<td id="A6.T5.14.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.2.4.1" class="ltx_text" style="font-size:90%;">3.99</span></td>
<td id="A6.T5.14.1.2.5" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.2.5.1" class="ltx_text" style="font-size:90%;">0.3164</span></td></tr>
