<span id="S5.T1.21.1.2.2.1" class="ltx_inline-block ltx_align_middle" style="width:48.4pt;">
<span id="S5.T1.21.1.2.2.1.1" class="ltx_p ltx_align_center"><span id="S5.T1.21.1.2.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Signal</span></span>
</span></td>
