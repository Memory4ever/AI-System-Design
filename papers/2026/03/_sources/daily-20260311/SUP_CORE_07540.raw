<td id="A6.T5.14.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.7pt 5.5pt;"><span id="A6.T5.14.1.4.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F5F7FF;">7.5701</span></td>
