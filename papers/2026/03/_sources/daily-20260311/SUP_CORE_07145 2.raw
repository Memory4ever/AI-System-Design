<td id="S4.T2.7.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.7.1.2.2.1" class="ltx_text" style="font-size:80%;">E2</span></td>
<td id="S4.T2.7.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T2.7.1.2.3.1" class="ltx_text" style="font-size:80%;">E1</span></td>
