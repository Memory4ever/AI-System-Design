<span class="ltx_personname">Yefei He<sup id="7" class="ltx_sup"><span id="7.1" class="ltx_text ltx_font_italic">4</span></sup>
</span></span>
<span class="ltx_author_before">  </span><span class="ltx_creator ltx_role_author">
<span class="ltx_personname">Feng Chen<sup id="8" class="ltx_sup"><span id="8.1" class="ltx_text ltx_font_italic">1†</span></sup>
</span></span>
