<th id="S3.T1.10.2.9" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">Corr<math id="S3.T1.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<th id="S3.T1.10.2.10" class="ltx_td ltx_th ltx_th_column" style="padding-left:4.5pt;padding-right:4.5pt;"></th>
<th id="S3.T1.10.2.11" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.5pt;padding-right:4.5pt;">Acc<math id="S3.T1.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
