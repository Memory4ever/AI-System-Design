<tr id="S3.T1.10.4" class="ltx_tr">
<td id="S3.T1.10.4.1" class="ltx_td ltx_align_left" style="padding-left:4.5pt;padding-right:4.5pt;">Australia</td>
<td id="S3.T1.10.4.2" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;">90.03</td>
<td id="S3.T1.10.4.3" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;">57.22</td>
<td id="S3.T1.10.4.4" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;">67.99</td>
<td id="S3.T1.10.4.5" class="ltx_td ltx_align_right" style="padding-left:4.5pt;padding-right:4.5pt;"><math id="S3.T1.m16" class="ltx_Math" alttext="0.03_{0.71}" display="inline" intent=":literal"><semantics><msub><mn>0.03</mn><mn>0.71</mn></msub><annotation encoding="application/x-tex">0.03_{0.71}</annotation></semantics></math></td>
<td id="S3.T1.10.4.6" class="ltx_td" style="padding-left:4.5pt;padding-right:4.5pt;"></td>
<td id="S3.T1.10.4.7" class="ltx_td ltx_align_center" style="padding-left:4.5pt;padding-right:4.5pt;">83.78</td>
