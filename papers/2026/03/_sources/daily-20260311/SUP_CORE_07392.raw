<td id="A2.T7.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt"><span id="A2.T7.2.1.2.1" class="ltx_text ltx_font_bold">Total</span></td>
<td id="A2.T7.2.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T7.2.1.3.1" class="ltx_text ltx_font_bold">Sprs.</span></td>
<td id="A2.T7.2.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T7.2.1.4.1" class="ltx_text ltx_font_bold">Mod.</span></td>
<td id="A2.T7.2.1.5" class="ltx_td ltx_align_center ltx_border_tt"><span id="A2.T7.2.1.5.1" class="ltx_text ltx_font_bold">Freq.</span></td></tr>
<tr id="A2.T7.2.2" class="ltx_tr">
<td id="A2.T7.2.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A2.T7.2.2.1.1" class="ltx_text ltx_font_smallcaps">OAKS</span>-B</td>
<td id="A2.T7.2.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t">1,224</td>
<td id="A2.T7.2.2.3" class="ltx_td ltx_align_center ltx_border_t">40%</td>
<td id="A2.T7.2.2.4" class="ltx_td ltx_align_center ltx_border_t">25%</td>
