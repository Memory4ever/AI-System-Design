</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#404040;--ltx-fill-color:#404040;--ltx-fg-color:#404040;" color="#404040" fill="#404040" stroke="#404040" transform="matrix(1.0 0.0 0.0 1.0 200.13 -298.74)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:10.26em;--ltx-fo-height:0.58em;--ltx-fo-depth:0em;font-size:10.65pt;" color="#000000" height="8.54" overflow="visible" transform="matrix(1 0 0 -1 0 8.54)" width="151.24"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F1.pic1.4" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-fg-color:#404040;">PHASE II: ANALYSIS</span></span></span></foreignObject></g><g style="--ltx-fill-color:#FFE0B2;" fill="#FFE0B2"><path style="stroke:none" d="M 77.63 -117.81 L -77.63 -117.81 C -83.74 -117.81 -88.7 -122.76 -88.7 -128.88 L -88.7 -267.04 C -88.7 -273.15 -83.74 -278.11 -77.63 -278.11 L 77.63 -278.11 C 83.74 -278.11 88.7 -273.15 88.7 -267.04 L 88.7 -128.88 C 88.7 -122.76 83.74 -117.81 77.63 -117.81 Z M -88.7 -278.11"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -72.09 -197.96)"><foreignObject style="--ltx-fo-width:10.42em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="144.18"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
