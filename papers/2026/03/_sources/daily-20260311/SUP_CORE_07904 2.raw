<div id="S6.T2.4" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:50.3pt;vertical-align:-22.6pt;"><span class="ltx_transformed_inner" style="transform:translate(3.9pt,-0.6pt) scale(1.02308677458151,1.02308677458151) ;">
