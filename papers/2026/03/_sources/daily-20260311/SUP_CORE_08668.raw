<td id="S5.T1.4.5.9" class="ltx_td ltx_align_center" style="--ltx-bg-color:#DEF1F7;padding-left:2.0pt;padding-right:2.0pt;"><span id="S5.T1.4.5.9.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#DEF1F7;">0.81<math id="S5.T1.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#DEF1F7;" mathbackground="#DEF1F7">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.92 (-84%)</span></td></tr>
<tr id="S5.T1.4.6" class="ltx_tr">
