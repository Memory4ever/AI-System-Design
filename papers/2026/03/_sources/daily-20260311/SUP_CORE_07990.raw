</figure>
<figure id="A3.F11" class="ltx_figure"><span class="ltx_inline-block"><svg id="A3.F11.pic1" class="ltx_picture" height="477.21" overflow="visible" version="1.1" viewBox="0 0 477.38 477.21" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,477.21) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#FFBF80;" fill="#FFBF80" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 472.58 C 0 475.14 2.07 477.21 4.63 477.21 L 472.75 477.21 C 475.3 477.21 477.38 475.14 477.38 472.58 L 477.38 4.63 C 477.38 2.07 475.3 0 472.75 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#F7F7F7;" fill="#F7F7F7" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 456.88 L 476.68 456.88 L 476.68 4.63 C 476.68 2.45 474.92 0.69 472.75 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 10.16 463.93)"><foreignObject style="--ltx-fo-width:31.01em;--ltx-fo-height:0.63em;--ltx-fo-depth:0.18em;font-size:10pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.65)" width="429.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
