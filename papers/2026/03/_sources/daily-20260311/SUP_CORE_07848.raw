<td id="A2.T7.10.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="A2.T7.10.2.3.1" class="ltx_text" style="font-size:90%;">+4.1</span></td>
<td id="A2.T7.10.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="A2.T7.10.2.4.1" class="ltx_text" style="font-size:90%;">+12.1</span></td>
<td id="A2.T7.10.2.5" class="ltx_td ltx_align_right ltx_border_t"><span id="A2.T7.10.2.5.1" class="ltx_text" style="font-size:90%;">-7.5</span></td></tr>
