<td id="S5.T3.2.8.3" class="ltx_td ltx_align_right"><span id="S5.T3.2.8.3.1" class="ltx_text ltx_font_bold">36.8%</span></td>
<td id="S5.T3.2.8.4" class="ltx_td ltx_align_right"><span id="S5.T3.2.8.4.1" class="ltx_text ltx_font_bold">+18.1%</span>***</td></tr>
