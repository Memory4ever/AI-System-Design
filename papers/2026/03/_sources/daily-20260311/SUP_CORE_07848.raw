<td id="A2.T7.10.3.2" class="ltx_td ltx_align_right"><span id="A2.T7.10.3.2.1" class="ltx_text" style="font-size:90%;">-15.8</span></td>
<td id="A2.T7.10.3.3" class="ltx_td ltx_align_right"><span id="A2.T7.10.3.3.1" class="ltx_text" style="font-size:90%;">+11.3</span></td>
<td id="A2.T7.10.3.4" class="ltx_td ltx_align_right"><span id="A2.T7.10.3.4.1" class="ltx_text" style="font-size:90%;">+19.2</span></td>
<td id="A2.T7.10.3.5" class="ltx_td ltx_align_right"><span id="A2.T7.10.3.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">-24.7<math id="A2.T7.m13" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></span></td></tr>
<tr id="A2.T7.10.4" class="ltx_tr">
<th id="A2.T7.10.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A2.T7.10.4.1.1" class="ltx_text" style="font-size:90%;">Lawful Evil</span></th>
<td id="A2.T7.10.4.2" class="ltx_td ltx_align_right"><span id="A2.T7.10.4.2.1" class="ltx_text" style="font-size:90%;">-2.2</span></td>
<td id="A2.T7.10.4.3" class="ltx_td ltx_align_right"><span id="A2.T7.10.4.3.1" class="ltx_text" style="font-size:90%;">-5.1</span></td>
<td id="A2.T7.10.4.4" class="ltx_td ltx_align_right"><span id="A2.T7.10.4.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">+22.5*</span></td>
<td id="A2.T7.10.4.5" class="ltx_td ltx_align_right"><span id="A2.T7.10.4.5.1" class="ltx_text" style="font-size:90%;">-1.3</span></td></tr>
<tr id="A2.T7.10.5" class="ltx_tr">
