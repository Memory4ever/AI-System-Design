<td id="S5.T3.2.2.2" class="ltx_td ltx_align_right ltx_border_t">84.1%</td>
<td id="S5.T3.2.2.3" class="ltx_td ltx_align_right ltx_border_t">78.9%</td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_right ltx_border_t">+5.2%</td></tr>
<tr id="S5.T3.2.3" class="ltx_tr">
