<td id="S5.T3.2.7.2" class="ltx_td ltx_align_right"><span id="S5.T3.2.7.2.1" class="ltx_text ltx_font_bold">16.8%</span></td>
<td id="S5.T3.2.7.3" class="ltx_td ltx_align_right"><span id="S5.T3.2.7.3.1" class="ltx_text ltx_font_bold">3.3%</span></td>
<td id="S5.T3.2.7.4" class="ltx_td ltx_align_right"><span id="S5.T3.2.7.4.1" class="ltx_text ltx_font_bold">+13.5%</span>***</td></tr>
