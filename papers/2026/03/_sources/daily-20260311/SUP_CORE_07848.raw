<td id="S5.T3.2.3.3" class="ltx_td ltx_align_right">45.1%</td>
<td id="S5.T3.2.3.4" class="ltx_td ltx_align_right"><math id="S5.T3.m8" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>2.5%</td></tr>
<tr id="S5.T3.2.4" class="ltx_tr">
