<td id="S5.T3.2.5.2" class="ltx_td ltx_align_right"><span id="S5.T3.2.5.2.1" class="ltx_text ltx_font_bold">62.4%</span></td>
<td id="S5.T3.2.5.3" class="ltx_td ltx_align_right"><span id="S5.T3.2.5.3.1" class="ltx_text ltx_font_bold">48.4%</span></td>
<td id="S5.T3.2.5.4" class="ltx_td ltx_align_right"><span id="S5.T3.2.5.4.1" class="ltx_text ltx_font_bold">+14.0%</span>**</td></tr>
<tr id="S5.T3.2.6" class="ltx_tr">
<td id="S5.T3.2.6.1" class="ltx_td ltx_align_left">True Neutral</td>
