                Set <math id="alg1.l20.m1" class="ltx_Math" alttext="R_{\text{think}}^{(k)}=R_{\text{eff}}^{(k)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mtext>think</mtext><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>R</mi><mtext>eff</mtext><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">R_{\text{think}}^{(k)}=R_{\text{eff}}^{(k)}</annotation></semantics></math> and <math id="alg1.l20.m2" class="ltx_Math" alttext="R_{\text{answer}}^{(k)}=R_{\text{len}}^{(k)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>R</mi><mtext>answer</mtext><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><msubsup><mi>R</mi><mtext>len</mtext><mrow><mo stretchy="false">(</mo><mi>k</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">R_{\text{answer}}^{(k)}=R_{\text{len}}^{(k)}</annotation></semantics></math> (Eq. <a href="#S3.E12" title="In Segment returns. ‣ 3.6 Overall objective of Difficulty-Scaled Segment-Wise GRPO ‣ 3 Methodology ‣ Shorter Thoughts, Same Answers: Difficulty-Scaled Segment-Wise RL for CoT Compression" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>)

