<th id="Ax1.T5.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="Ax1.T5.m3" class="ltx_Math" alttext="M_{\text{PKU-RLHF}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>PKU-RLHF</mtext></msub><annotation encoding="application/x-tex">M_{\text{PKU-RLHF}}</annotation></semantics></math></th>
<td id="Ax1.T5.2.6.2" class="ltx_td ltx_align_right">0.5617</td>
<td id="Ax1.T5.2.6.3" class="ltx_td ltx_align_right"><span id="Ax1.T5.2.6.3.1" class="ltx_text ltx_font_bold">0.7304</span></td>
<td id="Ax1.T5.2.6.4" class="ltx_td ltx_align_right">0.5497</td>
<td id="Ax1.T5.2.6.5" class="ltx_td ltx_align_right">0.6969</td></tr>
<tr id="Ax1.T5.2.7" class="ltx_tr">
<th id="Ax1.T5.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="Ax1.T5.m4" class="ltx_Math" alttext="M_{\text{Self-MOA}}" display="inline" intent=":literal"><semantics><msub><mi>M</mi><mtext>Self-MOA</mtext></msub><annotation encoding="application/x-tex">M_{\text{Self-MOA}}</annotation></semantics></math></th>
<td id="Ax1.T5.2.7.2" class="ltx_td ltx_align_right"><span id="Ax1.T5.2.7.2.1" class="ltx_text ltx_font_bold">0.6001</span></td>
<td id="Ax1.T5.2.7.3" class="ltx_td ltx_align_right">0.6546</td>
<td id="Ax1.T5.2.7.4" class="ltx_td ltx_align_right"><span id="Ax1.T5.2.7.4.1" class="ltx_text ltx_font_bold">0.5580</span></td>
<td id="Ax1.T5.2.7.5" class="ltx_td ltx_align_right"><span id="Ax1.T5.2.7.5.1" class="ltx_text ltx_font_bold">0.7403</span></td></tr>
