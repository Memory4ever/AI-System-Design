</div>
<div id="alg3.l4" class="ltx_listingline">
            
            
            <span id="alg3.l4.2" class="ltx_text ltx_font_bold">for</span> <math id="alg3.l4.m1" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> in <math id="alg3.l4.m2" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> to <math id="alg3.l4.m3" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> <span id="alg3.l4.3" class="ltx_text ltx_font_bold">do</span> <span id="alg3.l4.4" class="ltx_text" style="float:right;"><math id="alg3.l4.m4" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <math id="alg3.l4.m5" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> = number of responses
</span>
</div>
<div id="alg3.l5" class="ltx_listingline">
            
            
             <span id="alg3.l5.2" class="ltx_text ltx_font_bold">if</span> <math id="alg3.l5.m1" class="ltx_Math" alttext="\mathcal{S}_{\text{help}}[i]\geq\tau_{\text{help}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>help</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>≥</mo><msub><mi>τ</mi><mtext>help</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\text{help}}[i]\geq\tau_{\text{help}}</annotation></semantics></math> <span id="alg3.l5.3" class="ltx_text ltx_font_bold">and</span> <math id="alg3.l5.m2" class="ltx_Math" alttext="\mathcal{S}_{\text{safety}}[i]\leq\tau_{\text{safety}}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mtext>safety</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>i</mi><mo stretchy="false">]</mo></mrow></mrow><mo>≤</mo><msub><mi>τ</mi><mtext>safety</mtext></msub></mrow><annotation encoding="application/x-tex">\mathcal{S}_{\text{safety}}[i]\leq\tau_{\text{safety}}</annotation></semantics></math> <span id="alg3.l5.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg3.l6" class="ltx_listingline">
            
            
               <math id="alg3.l6.m1" class="ltx_Math" alttext="\mathcal{E}^{t}\leftarrow\mathcal{E}^{t}\cup\{(\text{s},\text{e})\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mtext>s</mtext><mo>,</mo><mtext>e</mtext><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}^{t}\leftarrow\mathcal{E}^{t}\cup\{(\text{s},\text{e})\}</annotation></semantics></math>, <math id="alg3.l6.m2" class="ltx_Math" alttext="\mathcal{H}^{t}\leftarrow\mathcal{H}^{t}\cup\{(\text{e},\text{h})\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><mtext>e</mtext><mo>,</mo><mtext>h</mtext><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}^{t}\leftarrow\mathcal{H}^{t}\cup\{(\text{e},\text{h})\}</annotation></semantics></math>

</div>
<div id="alg3.l7" class="ltx_listingline">
            
            
               <span id="alg3.l7.2" class="ltx_text ltx_font_bold">break</span>

</div>
<div id="alg3.l8" class="ltx_listingline">
            
            
             <span id="alg3.l8.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l8.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg3.l9" class="ltx_listingline">
            
            
            <span id="alg3.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l10" class="ltx_listingline">
            
            
          <span id="alg3.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg3.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg3.l11" class="ltx_listingline">
            
            
          <span id="alg3.l11.2" class="ltx_text ltx_font_bold">Return:</span> <math id="alg3.l11.m1" class="ltx_Math" alttext="\mathcal{E}^{t}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\mathcal{E}^{t}</annotation></semantics></math>, <math id="alg3.l11.m2" class="ltx_Math" alttext="\mathcal{H}^{t}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\mathcal{H}^{t}</annotation></semantics></math>

</div>
</div>
</figure>
