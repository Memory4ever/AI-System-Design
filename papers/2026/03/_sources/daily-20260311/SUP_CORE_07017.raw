</div>
<div id="alg2.l14" class="ltx_listingline">
              
              
                 <span id="alg2.l14.2" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l14.m1" class="ltx_Math" alttext="\Delta_{\text{help}}&gt;\delta_{\text{help}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mtext>help</mtext></msub><mo>&gt;</mo><msub><mi>δ</mi><mtext>help</mtext></msub></mrow><annotation encoding="application/x-tex">\Delta_{\text{help}}&gt;\delta_{\text{help}}</annotation></semantics></math> <span id="alg2.l14.3" class="ltx_text ltx_font_bold">or</span> <math id="alg2.l14.m2" class="ltx_Math" alttext="\Delta_{\text{safety}}&gt;\delta_{\text{safety}}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathvariant="normal">Δ</mi><mtext>safety</mtext></msub><mo>&gt;</mo><msub><mi>δ</mi><mtext>safety</mtext></msub></mrow><annotation encoding="application/x-tex">\Delta_{\text{safety}}&gt;\delta_{\text{safety}}</annotation></semantics></math> <span id="alg2.l14.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="alg2.l15" class="ltx_listingline">
              
              
                  <math id="alg2.l15.m1" class="ltx_Math" alttext="c\leftarrow r_{\text{front}}" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo stretchy="false">←</mo><msub><mi>r</mi><mtext>front</mtext></msub></mrow><annotation encoding="application/x-tex">c\leftarrow r_{\text{front}}</annotation></semantics></math>, <math id="alg2.l15.m2" class="ltx_Math" alttext="r\leftarrow r_{\text{back}}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><msub><mi>r</mi><mtext>back</mtext></msub></mrow><annotation encoding="application/x-tex">r\leftarrow r_{\text{back}}</annotation></semantics></math>, <math id="alg2.l15.m3" class="ltx_Math" alttext="m_{c}\leftarrow\mathcal{K}_{h}[c].\text{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>c</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>c</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>s</mtext></mrow><annotation encoding="application/x-tex">m_{c}\leftarrow\mathcal{K}_{h}[c].\text{s}</annotation></semantics></math>, <math id="alg2.l15.m4" class="ltx_Math" alttext="m_{r}\leftarrow\mathcal{K}_{h}[r].\text{s}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>m</mi><mi>r</mi></msub><mo stretchy="false">←</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒦</mi><mi>h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>r</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0.167em">.</mo><mtext>s</mtext></mrow><annotation encoding="application/x-tex">m_{r}\leftarrow\mathcal{K}_{h}[r].\text{s}</annotation></semantics></math>

</div>
<div id="alg2.l16" class="ltx_listingline">
              
              
                  <math id="alg2.l16.m1" class="ltx_Math" alttext="\mathcal{P}^{t}\leftarrow\mathcal{P}^{t}\cup\{p,c,r,m_{c},m_{r}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>t</mi></msup><mo stretchy="false">←</mo><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>t</mi></msup><mo>∪</mo><mrow><mo stretchy="false">{</mo><mrow><mi>p</mi><mo>,</mo><mi>c</mi><mo>,</mo><mi>r</mi><mo>,</mo><msub><mi>m</mi><mi>c</mi></msub><mo>,</mo><msub><mi>m</mi><mi>r</mi></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{P}^{t}\leftarrow\mathcal{P}^{t}\cup\{p,c,r,m_{c},m_{r}\}</annotation></semantics></math>

</div>
<div id="alg2.l17" class="ltx_listingline">
              
              
                 <span id="alg2.l17.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l17.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l18" class="ltx_listingline">
              
              
               <span id="alg2.l18.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l18.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l19" class="ltx_listingline">
              
              
              <span id="alg2.l19.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l19.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg2.l20" class="ltx_listingline">
              
              
            <span id="alg2.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l20.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l21" class="ltx_listingline">
              
              
            <span id="alg2.l21.2" class="ltx_text ltx_font_bold">Return:</span> <math id="alg2.l21.m1" class="ltx_Math" alttext="\mathcal{P}^{t}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒫</mi><mi>t</mi></msup><annotation encoding="application/x-tex">\mathcal{P}^{t}</annotation></semantics></math>

