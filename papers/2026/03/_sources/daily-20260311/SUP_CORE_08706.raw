<div id="S4.F3.p2" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.F3.p2.pic1" class="ltx_picture" height="161.03" overflow="visible" version="1.1" viewBox="0 0 229.14 161.03" width="229.14"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,161.03) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#DC143C;" fill="#DC143C" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.57 L 0 138.55 C 0 143.28 3.84 147.12 8.57 147.12 L 220.57 147.12 C 225.3 147.12 229.14 143.28 229.14 138.55 L 229.14 8.57 C 229.14 3.84 225.3 0 220.57 0 L 8.57 0 C 3.84 0 0 3.84 0 8.57 Z"></path></g><g style="--ltx-fill-color:#FFF0F5;" fill="#FFF0F5" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 8.57 L 0.69 138.55 C 0.69 142.9 4.22 146.43 8.57 146.43 L 220.57 146.43 C 224.92 146.43 228.45 142.9 228.45 138.55 L 228.45 8.57 C 228.45 4.22 224.92 0.69 220.57 0.69 L 8.57 0.69 C 4.22 0.69 0.69 4.22 0.69 8.57 Z"></path></g><g transform="matrix(1.0 0.0 0.0 1.0 11.81 137.27)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0)"><g style="--ltx-fill-color:#DC143C;" fill="#DC143C" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.51 L 0 18.24 C 0 21.29 2.47 23.75 5.51 23.75 L 154.31 23.75 C 157.35 23.75 159.82 21.29 159.82 18.24 L 159.82 5.51 C 159.82 2.47 157.35 0 154.31 0 L 5.51 0 C 2.47 0 0 2.47 0 5.51 Z"></path></g><g style="--ltx-fill-color:#DC143C;" fill="#DC143C" fill-opacity="1.0"><path style="stroke:none" d="M 1.57 5.51 L 1.57 18.24 C 1.57 20.42 3.34 22.18 5.51 22.18 L 154.31 22.18 C 156.48 22.18 158.24 20.42 158.24 18.24 L 158.24 5.51 C 158.24 3.34 156.48 1.57 154.31 1.57 L 5.51 1.57 C 3.34 1.57 1.57 3.34 1.57 5.51 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.39 7.65)"><foreignObject style="--ltx-fo-width:7.77em;--ltx-fo-height: