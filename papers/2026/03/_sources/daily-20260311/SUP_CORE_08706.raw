m;--ltx-fo-depth:0.22em;font-size:11.5pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="165.23"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F8.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">RL Prompt (WebShop)</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 14.53 250.71)"><foreignObject style="--ltx-fo-width:52.46em;--ltx-fo-height:0.55em;--ltx-fo-depth:17em;font-size:10pt;" height="242.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.61)" width="725.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.F8.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:52.46em;">
<span id="A1.F8.pic1.2.1" class="ltx_p"><span id="A1.F8.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">You are an expert shopping assistant navigating an e-commerce website.
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Task: {task_description}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Prior to this step, you have already taken {n} step(s).
<br class="ltx_break">Below are the most recent {k} observations and actions:
<br class="ltx_break">{history}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
You are now at step {current_step} and your current observation is:
<br class="ltx_break">{observation}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Your admissible actions of the current situation are:
<br class="ltx_break">{admissible_actions}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Action format examples:
<br class="ltx_break">- search[{query}]
<br class="ltx_break">- click[{element}]
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Now it’s your turn to take an action.
<br class="ltx_break">Once you’ve finished your reasoning, you should choose an admissible action for current step and MUST be enclosed within &lt;action&gt; &lt;/action&gt; tags.
<span id="A1.F8.pic1.2.1.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F8.3" class="ltx_text" style="font-size:90%;">Figure 8</span>: </span><span id="A1.F8.4" class="ltx_text" style="font-size:90%;">The RL prompt for WebShop. The model is presented with the task, history, current observation, and admissible actions, and is asked to generate the next action.</span></figcaption>
</figure>
<div class="ltx_pagination ltx_role_newpage"></div>
</section>
<section id="A1.SS5.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">ScienceWorld Prompts.</h4>

<div id="A1.SS5.SSS0.Px3.p1" class="ltx_para ltx_noindent">
<p id="A1.SS5.SSS0.Px3.p1.1" class="ltx_p">The ACT and RL prompts for ScienceWorld are shown in <a href="#A1.F9" title="In ScienceWorld Prompts. ‣ A.5 Prompt Templates ‣ Appendix A Experimental Details ‣ Agentic Critical Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Figures</span> <span class="ltx_text ltx_ref_tag">9</span></a> and <a href="#A1.F10" title="Figure 10 ‣ ScienceWorld Prompts. ‣ A.5 Prompt Templates ‣ Appendix A Experimental Details ‣ Agentic Critical Training" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a>, respectively.</p>
</div>
<figure id="A1.F9" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F9.pic1" class="ltx_picture ltx_centering" height="381.69" overflow="visible" version="1.1" viewBox="0 0 700.39 381.69" width="700.39"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,381.69) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.57 L 0 356.14 C 0 360.87 3.84 364.7 8.57 364.7 L 691.83 364.7 C 696.56 364.7 700.39 360.87 700.39 356.14 L 700.39 8.57 C 700.39 3.84 696.56 0 691.83 0 L 8.57 0 C 3.84 0 0 3.84 0 8.57 Z"></path></g><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 8.57 L 0.69 356.14 C 0.69 360.49 4.22 364.01 8.57 364.01 L 691.83 364.01 C 696.18 364.01 699.7 360.49 699.7 356.14 L 699.7 8.57 C 699.7 4.22 696.18 0.69 691.83 0.69 L 8.57 0.69 C 4.22 0.69 0.69 4.22 0.69 8.57 Z"></path></g><g transform="matrix(1.0 0.0 0.0 1.0 11.81 354.86)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.51 L 0 21.32 C 0 24.36 2.47 26.83 5.51 26.83 L 225.8 26.83 C 228.84 26.83 231.31 24.36 231.31 21.32 L 231.31 5.51 C 231.31 2.47 228.84 0 225.8 0 L 5.51 0 C 2.47 0 0 2.47 0 5.51 Z"></path></g><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 1.57 5.51 L 1.57 21.32 C 1.57 23.49 3.34 25.25 5.51 25.25 L 225.8 25.25 C 227.97 25.25 229.73 23.49 229.73 21.32 L 229.73 5.51 C 229.73 3.34 227.97 1.57 225.8 1.57 L 5.51 1.57 C 3.34 1.57 1.57 3.34 1.57 5.51 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.39 9.96)"><foreignObject style="--ltx-fo-width:12.97em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.22em;font-size:11.5pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="206.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F9.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">ACT Prompt (ScienceWorld)</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 14.53 333.74)"><foreignObject style="--ltx-fo-width:52.46em;--ltx-fo-height:0.55em;--ltx-fo-depth:23em;font-size:10pt;" height="325.87" overflow="visible" transform="matrix(1 0 0 -1 0 7.61)" width="725.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.F9.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:52.46em;">
<span id="A1.F9.pic1.2.1" class="ltx_p"><span id="A1.F9.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">You are an expert science tutor guiding a student through hands-on experiments in the ScienceWorld environment.
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Task: {task_description}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Prior to this step, you have already taken {n} step(s).
<br class="ltx_break">Below are the most recent {k} observations and actions:
<br class="ltx_break">{history}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
You are now at step {current_step} and your current observation is:
<br class="ltx_break">{observation}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Your admissible actions of the current situation are:
<br class="ltx_break">{admissible_actions}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
You need to decide which action is better for completing the task.
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Output format requirements:
<br class="ltx_break">1. First, think about which action is better and why.
<br class="ltx_break">2. Then, output the chosen action content inside &lt;action&gt;...&lt;/action&gt; tags.
<br class="ltx_break">3. You must output the actual action text, NOT ‘Action 1’ or ‘Action 2’.
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Candidate Actions for the NEXT step:
<br class="ltx_break">Action 1: {action_1}
<br class="ltx_break">Action 2: {action_2}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Which action is better as the NEXT step? Think about why, then output the chosen action inside &lt;action&gt;...&lt;/action&gt; tags.
<span id="A1.F9.pic1.2.1.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F9.3" class="ltx_text" style="font-size:90%;">Figure 9</span>: </span><span id="A1.F9.4" class="ltx_text" style="font-size:90%;">The ACT prompt for ScienceWorld. The model is presented with the full context followed by two candidate actions and is asked to select the better one with reasoning.</span></figcaption>
</figure>
<figure id="A1.F10" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F10.pic1" class="ltx_picture ltx_centering" height="365.09" overflow="visible" version="1.1" viewBox="0 0 700.39 365.09" width="700.39"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,365.09) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.57 L 0 339.53 C 0 344.26 3.84 348.1 8.57 348.1 L 691.83 348.1 C 696.56 348.1 700.39 344.26 700.39 339.53 L 700.39 8.57 C 700.39 3.84 696.56 0 691.83 0 L 8.57 0 C 3.84 0 0 3.84 0 8.57 Z"></path></g><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 8.57 L 0.69 339.53 C 0.69 343.88 4.22 347.41 8.57 347.41 L 691.83 347.41 C 696.18 347.41 699.7 343.88 699.7 339.53 L 699.7 8.57 C 699.7 4.22 696.18 0.69 691.83 0.69 L 8.57 0.69 C 4.22 0.69 0.69 4.22 0.69 8.57 Z"></path></g><g transform="matrix(1.0 0.0 0.0 1.0 11.81 338.26)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.51 L 0 21.32 C 0 24.36 2.47 26.83 5.51 26.83 L 213.15 26.83 C 216.2 26.83 218.66 24.36 218.66 21.32 L 218.66 5.51 C 218.66 2.47 216.2 0 213.15 0 L 5.51 0 C 2.47 0 0 2.47 0 5.51 Z"></path></g><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 1.57 5.51 L 1.57 21.32 C 1.57 23.49 3.34 25.25 5.51 25.25 L 213.15 25.25 C 215.33 25.25 217.09 23.49 217.09 21.32 L 217.09 5.51 C 217.09 3.34 215.33 1.57 213.15 1.57 L 5.51 1.57 C 3.34 1.57 1.57 3.34 1.57 5.51 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.39 9.96)"><foreignObject style="--ltx-fo-width:12.14em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.22em;font-size:11.5pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="193.22"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="A1.F10.pic1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#FFFFFF;">RL Prompt (ScienceWorld)</span></span></span></foreignObject></g></g></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 14.53 317.13)"><foreignObject style="--ltx-fo-width:52.46em;--ltx-fo-height:0.55em;--ltx-fo-depth:21.8em;font-size:10pt;" height="309.26" overflow="visible" transform="matrix(1 0 0 -1 0 7.61)" width="725.9"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
<span id="A1.F10.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:52.46em;">
<span id="A1.F10.pic1.2.1" class="ltx_p"><span id="A1.F10.pic1.2.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#000000;">You are an expert science tutor guiding a student through hands-on experiments in the ScienceWorld environment.
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Task: {task_description}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Prior to this step, you have already taken {n} step(s).
<br class="ltx_break">Below are the most recent {k} observations and actions:
<br class="ltx_break">{history}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
You are now at step {current_step} and your current observation is:
<br class="ltx_break">{observation}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Your admissible actions of the current situation are:
<br class="ltx_break">{admissible_actions}
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Action format examples:
<br class="ltx_break">- pick up {object}
<br class="ltx_break">- put {object} in {container}
<br class="ltx_break">- pour {object} into {container}
<br class="ltx_break">- open/close {object}, focus on {object}
<br class="ltx_break">- teleport to {location}, look around, inventory
<br class="ltx_break" style="--ltx-break-space:7.8pt;">
Now it’s your turn to take an action.
<br class="ltx_break">Once you’ve finished your reasoning, you should choose an admissible action for current step and MUST be enclosed within &lt;action&gt; &lt;/action&gt; tags.
<span id="A1.F10.pic1.2.1.1.1" class="ltx_text ltx_font_serif">
</span></span></span>
</span></span></span></foreignObject></g></g></svg></span>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A1.F10.3" class="ltx_text" style="font-size:90%;">Figure 10</span>: </span><span id="A1.F10.4" class="ltx_text" style="font-size:90%;">The RL prompt for ScienceWorld. The model is presented with the task, history, current observation, and admissible actions, and is asked to generate the next action.</span></figcaption>
</figure>
