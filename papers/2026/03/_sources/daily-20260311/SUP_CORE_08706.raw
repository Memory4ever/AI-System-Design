<div id="S4.F3.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="S4.F3.p1.pic1" class="ltx_picture" height="246.29" overflow="visible" version="1.1" viewBox="0 0 229.14 246.29" width="229.14"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,246.29) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 8.57 L 0 224.69 C 0 229.42 3.84 233.25 8.57 233.25 L 220.57 233.25 C 225.3 233.25 229.14 229.42 229.14 224.69 L 229.14 8.57 C 229.14 3.84 225.3 0 220.57 0 L 8.57 0 C 3.84 0 0 3.84 0 8.57 Z"></path></g><g style="--ltx-fill-color:#F0F8FF;" fill="#F0F8FF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 8.57 L 0.69 224.69 C 0.69 229.04 4.22 232.56 8.57 232.56 L 220.57 232.56 C 224.92 232.56 228.45 229.04 228.45 224.69 L 228.45 8.57 C 228.45 4.22 224.92 0.69 220.57 0.69 L 8.57 0.69 C 4.22 0.69 0.69 4.22 0.69 8.57 Z"></path></g><g transform="matrix(1.0 0.0 0.0 1.0 11.81 223.41)"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" class="ltx_nestedsvg" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="matrix(1 0 0 1 0 0)"><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.51 L 0 17.37 C 0 20.41 2.47 22.88 5.51 22.88 L 231.53 22.88 C 234.57 22.88 237.04 20.41 237.04 17.37 L 237.04 5.51 C 237.04 2.47 234.57 0 231.53 0 L 5.51 0 C 2.47 0 0 2.47 0 5.51 Z"></path></g><g style="--ltx-fill-color:#000080;" fill="#000080" fill-opacity="1.0"><path style="stroke:none" d="M 1.57 5.51 L 1.57 17.37 C 1.57 19.54 3.34 21.3 5.51 21.3 L 231.53 21.3 C 233.7 21.3 235.46 19.54 235.46 17.37 L 235.46 5.51 C 235.46 3.34 233.7 1.57 231.53 1.57 L 5.51 1.57 C 3.34 1.57 1.57 3.34 1.57 5.51 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 13.39 6.5)"><foreignObject style="--ltx-fo-width:12.86em;--ltx-fo-height:0.6e