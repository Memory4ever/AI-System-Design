<td id="S5.T6.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T6.2.1.2.3.1" class="ltx_text ltx_font_bold">37.2</span></td>
<td id="S5.T6.2.1.2.4" class="ltx_td ltx_align_center ltx_border_t">62.3</td>
