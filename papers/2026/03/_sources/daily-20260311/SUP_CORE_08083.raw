<td id="S5.T6.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t">39.4</td>
<td id="S5.T6.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t">74.5</td>
<td id="S5.T6.2.1.2.9" class="ltx_td ltx_align_center ltx_border_t">36.9</td>
<td id="S5.T6.2.1.2.10" class="ltx_td ltx_align_center ltx_border_t">43.1</td>
