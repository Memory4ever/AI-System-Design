<tr id="S6.T3.6.3" class="ltx_tr">
<th id="S6.T3.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">AWQ 4-bit (w=4, g=128)</th>
<td id="S6.T3.6.3.2" class="ltx_td ltx_align_center"><span id="S6.T3.6.3.2.1" class="ltx_text ltx_font_bold">0.4344</span></td>
<td id="S6.T3.6.3.3" class="ltx_td ltx_align_center">0.4539</td></tr>
<tr id="S6.T3.6.4" class="ltx_tr">
<th id="S6.T3.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DACQ Hybrid</th>
<td id="S6.T3.6.4.2" class="ltx_td"></td>
<td id="S6.T3.6.4.3" class="ltx_td"></td></tr>
<tr id="S6.T3.6.5" class="ltx_tr">
<th id="S6.T3.6.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">4-bit (w=4, g=128)</th>
<td id="S6.T3.6.5.2" class="ltx_td ltx_align_center">0.4108</td>
