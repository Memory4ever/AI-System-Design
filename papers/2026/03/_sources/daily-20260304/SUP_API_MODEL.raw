      <name>Philipp Arnold</name>
      <arxiv:affiliation>Department of Radiology, Medical Center -- University of Freiburg, Germany</arxiv:affiliation>
    </author>
    <author>
      <name>Sebastian Walter</name>
      <arxiv:affiliation>Chair of Algorithms and Data Structures, University of Freiburg, Germany</arxiv:affiliation>
    </author>
    <author>
      <name>Hani Alnahas</name>
      <arxiv:affiliation>Computer Vision Group, University of Freiburg, Germany</arxiv:affiliation>
    </author>
    <author>
      <name>Hannah Bast</name>
      <arxiv:affiliation>Chair of Algorithms and Data Structures, University of Freiburg, Germany</arxiv:affiliation>
    </author>
    <author>
      <name>Elmar Kotter</name>
      <arxiv:affiliation>Department of Radiology, Medical Center -- University of Freiburg, Germany</arxiv:affiliation>
    </author>
    <author>
