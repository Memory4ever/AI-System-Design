      <name>Chenxu Wang</name>
    </author>
    <author>
      <name>Jing Tao</name>
    </author>
    <arxiv:doi>10.1109/TIFS.2026.3671112</arxiv:doi>
    <link rel="related" href="https://doi.org/10.1109/TIFS.2026.3671112" title="doi"/>
