<td id="S5.T2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:1.2pt;padding-bottom:1.2pt;"><span id="S5.T2.1.2.3.1" class="ltx_text" style="font-size:70%;">40.1%</span></td>
