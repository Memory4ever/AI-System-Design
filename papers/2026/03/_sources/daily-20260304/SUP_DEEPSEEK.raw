k.com/\",\"methodology\":\"https://cdn.deepseek.com/policies/en-US/model-algorithm-disclosure.html\",\"newsV4\":\"https://api-docs.deepseek.com/news/news260424\",\"githubR1\":\"https://github.com/deepseek-ai/DeepSeek-R1\",\"githubV3\":\"https://github.com/deepseek-ai/DeepSeek-V3\",\"githubCoderV2\":\"https://github.com/deepseek-ai/DeepSeek-Coder-V2\"},\"Index\":{\"metaTitle\":\"DeepSeek\",\"metaDesc\":\"Into the Unknown\",\"heroBadge\":\"DeepSeek-V4 Preview is Live\",\"heroTitleSub\":\"\",\"heroTitle\":\"Into the Unknown\",\"heroSubtitle\":\"The official version of DeepSeek-V4.1-Flash has been released, featuring comprehensive improvements in text and Agent performance, along with native multimodal visual understanding capabilities.\",\"heroPlaceholder\":\"Ask anything, explore together\",\"heroCta1\":\"Chat with DeepSeek\",\"heroCta2\":\"API Platform\",\"heroCta3\":\"Harness Desktop\",\"heroThinkBtn\":\"DeepThink\",\"heroSearchBtn\":\"Search\",\"navNews\":\"Research \u0026 News\",\"navApi\":\"API\",\"navApiIntro\":\"API Overview\",\"navApiPlatform\":\"API Platform\",\"navApiPricing\":\"API Pricing\",\"navProducts\":\"Products\",\"navJoinUs\":\"Join Us\",\"navGetApp\":\"Get App\",\"navGetStarted\":\"Get Started\",\"navWebVersion\":\"DeepSeek Web\",\"navApiDocs\":\"API Docs\",\"downloadAppTooltip\":\"Scan to get DeepSeek App\",\"wechatTooltip\":\"Scan to follow DeepSeek on WeChat\",\"homeCtaHeading\":\"Start your next creation\",\"homeCtaDesc\":\"Solve bigger, harder problems with DeepSeek\",\"homeCtaApp\":\"App\",\"homeCtaWeb\":\"Web\",\"homeCtaPlatform\":\"API Platform\",\"footerSectionLegal\":\"Legal \u0026 Security\",\"footerPrivacy\":\"Privacy Policy\",\"footerTerms\":\"Terms of Use\",\"footerSecurity\":\"Report Security Issue\",\"footerTransparency\":\"Transparency\",\"footerSectionJoin\":\"Join Us\",\"footerJobs\":\"Careers\",\"footerSectionProducts\":\"Products\",\"footerApp\":\"DeepSeek App\",\"footerDownloads\":\"Downloads\",\"footerHarness\":\"DeepSeek Harness\",\"footerWebVersion\":\"DeepSeek Web\",\"footerPlatform\":\"API Platform\",\"footerApiDocs\":\"API Docs\",\"footerPricing\":\"API Pricing\",\"footerStatus\":\"Service Status\",\"footerSectionResearch\":\"Research\",\"footerMore\":\"More\",\"footerCopyright\":\"© 2026 DeepSeek. All rights reserved.\",\"footerLang\":\"English\",\"emailAddressCopied\":\"Email address copied to clipboard\",\"cookieBannerTitle\":\"Cookie Settings\",\"cookieBannerDesc\":\"We use cookies to provide and improve services and ensure security. Click to view our %r. You can choose to accept all or only necessary cookies, which may affect some functionalities.\",\"cookieBannerCookiePolicyLink\":\"cookie policy\",\"cookieBannerAcceptAll\":\"Accept all cookies\",\"cookieBannerAcceptEssential\":\"Necessary cookies only\",\"platformHeroTitle\":\"Build with DeepSeek API\",\"platformRotating1\":\"Code your application\",\"platformRotating2\":\"Boost enterprise efficiency\",\"platformRotating3\":\"Assist daily work\",\"platformRotating4\":\"Create next-gen products\",\"platformCtaBuild\":\"Start Building\",\"platformCtaDocs\":\"View API Docs\",\"platformPricingNote\":\"Prices may change. For details, see the\",\"platformPricingLink\":\"Pricing\",\"platformEntTitle\":\"Enterprise\",\"platformEntDesc\":\"Scale your business — contact us for higher concurrency\",\"platformEntCta\":\"Contact Us\",\"platformFooterHeading\":\"Start building your AI app\",\"platformFooterDesc\":\"Integrate world-leading AI capabilities with the DeepSeek API\",\"platformCtaApiKey\":\"Get API Key\",\"platformPricingTitle\":\"Lastest Models\",\"platformPriceInputCacheHit\":\"Input (cache hit)\",\"platformPriceInputCacheMiss\":\"Input (cache miss)\",\"platformPriceOutput\":\"Output\",\"platformFeature1\":\"Auto-caching with reduced cache hit pricing\",\"platformFeature2\":\"Supports up to 1M tokens of context\",\"platformFeature3\":\"Powerful agent tool-use capabilities\",\"platformPricingDisclaimer\":\"Prices may change. For details, see the\",\"platformPricingDocsLink\":\"API docs\",\"platformPricePrefix\":\"US$\",\"platformPriceSuffix\":\"\",\"platformPricePerUnit\":\"per 1M tokens\",\"metaHomeTitle\":\"DeepSeek | Into the Unknown\",\"metaPlatformTitle\":\"API Platform\",\"metaPlatformDesc\":\"Integrate world-leading AI capabilities with the DeepSeek API\",\"metaNewsTitle\":\"Research \u0026 News\",\"metaNewsDesc\":\"DeepSeek Research \u0026 News — Latest research papers, product updates, and announcements\",\"metaTransparencyTitle\":\"Transparency Center\",\"metaTransparencyDesc\":\"Here we disclose DeepSeek's major released models\",\"platformPageTitle\":\"API Platform\",\"newsPageTitle1\":\"Research \u0026 News\",\"newsPageTitle2\":\"\",\"newsPageDesc\":\"Dedicated to exploring the essence of AGI — driven by curiosity, answering the biggest questions with the longest-term vision.\",\"newsViewAll\":\"View All\",\"researchIndex\":\"Research Index\",\"researchViewAll\":\"View All\",\"relatedContent\":\"Related content\",\"readMore\":\"Read more\",\"readPaper\":\"Read Paper\",\"notFoundLine1\":\"The path forks here\",\"notFoundLine2\":\"A page yet unwritten\",\"notFoundLine3\":\"Exploration continues\",\"notFoundCta\":\"Back to Home\",\"transparencyMetaTitle\":\"Transparency Center - DeepSeek\",\"transparencyMethodologyLink\":\"View Details\",\"transparencyMethodologyTitle\":\"Model Principles and Training Methodology\",\"transparencyHeroDesc\":\"Here we disclose DeepSeek's major released models\",\"transparencyOverviewDesc\":\"Below are DeepSeek's released models, including names, release dates, technical reports and model cards.\",\"transparencyOverviewTitle\":\"Model Overview\",\"transparencyPageTitle\":\"Transparency Center\",\"transparencyTableColCard\":\"Model Card\",\"transparencyTableColDate\":\"Release Date\",\"transparencyTableColReport\":\"Technical Report\",\"transparencyFooterHeading\":\"Learn more about DeepSeek\",\"transparencyFooterDesc\":\"Explore our research and open models\",\"transparencyFooterCta1\":\"Start Chatting\",\"transparencyFooterCta2\":\"API Platform\"},\"Harness\":{\"Index\":{\"harnessNavDownload\":\"Download desktop\",\"harnessHeaderDownload\":\"Download\",\"harnessOpenMenu\":\"Open menu\",\"harnessCloseMenu\":\"Close menu\",\"harnessMetaTitle\":\"DeepSeek Harness | Explore the limits of intelligence\",\"harnessMetaDesc\":\"Use DeepSeek Harness to work with documents, analyze spreadsheets, write code, and schedule tasks. Extend its capabilities with composable plugins.\",\"harnessHeroTitlePre\":\"DeepSeek Harness\",\"harnessHeroTitlePost\":\"Ready to use. Right now.\",\"harnessHeroSubtitle\":\"DeepSeek Harness preview\",\"harnessPreviewBadge\":\"Preview\",\"harnessPreviewLabel\":\"DeepSeek Harness preview\",\"harnessHeroDesc\":\"Everyday tasks, coding, or your own harness—it starts here.\",\"harnessHeroDesc2\":\"DeepSeek Harness is now in public preview worldwide and open source, with composable plugins that extend what agents can do.\",\"harnessHeroGithub\":\"View on GitHub\",\"harnessHeroDownload\":\"Download for macOS\",\"harnessHeroDownloadOptions\":\"Desktop downloads\",\"harnessHeroDownloadMac\":\"macOS (Apple silicon)\",\"harnessHeroDownloadWindows\":\"Windows (64-bit)\",\"harnessHeroScreenshotAlt\":\"DeepSeek Harness desktop interface with workspace sidebar and chat input\",\"harnessHeroCopy\":\"Copy\",\"harnessHeroCopied\":\"Copied\",\"harnessHeroWebTab\":\"Quick start\",\"harnessHeroStartTab\":\"Install from source\",\"harnessWhyTitle\":\"Expanding capabilities. \u003cbr\u003e\u003c/br\u003eWork on your terms.\",\"harnessWhyFormula\":\"Agent = Model + Harness\",\"harnessWhyP1\":\"The model is the soul of an agent.\",\"harnessWhyP2\":\"A harness lets an agent understand its environment, use tools, and keep working in real-world settings.\",\"harnessPillar1Title\":\"Cordis kernel\",\"harnessPillar1En\":\"CORDIS KERNEL\",\"harnessPillar1Desc\":\"The Cordis kernel manages plugin mounting, unmounting, and dependencies. Agent capabilities live in the plugins.\",\"harnessPillar2Title\":\"Capabilities as plugins\",\"harnessPillar2En\":\"CAPABILITIES AS PLUGINS\",\"harnessPillar2Desc\":\"Plugins provide every agent capability, including models, tools, skills, sessions, sandboxes, storage, loops, scheduling, and the UI. Cordis services and events let the plugins work together.\",\"harnessPillar3Title\":\"Compose with configuration\",\"harnessPillar3En\":\"COMPOSE IN CONFIGURATION\",\"harnessPillar3Desc\":\"Developers can select, swap, or extend any capability in configuration without changing the DeepSeek Harness source code.\",\"harnessFeatEyebrow\":\"Design approach\",\"harnessFeatTitle\":\"Everything is a plugin.\\nEvery run is traceable.\",\"harnessFeat1Label\":\"Everything is a plugin\",\"harnessFeat1DescPrefix\":\"DeepSeek Harness is built on \",\"harnessFeat1DescSuffix\":\"'s plugin system. Plugins provide every agent capability, including models, tools, skills, sessions, sandboxes, storage, loops, scheduling, and the UI. Cordis services and events let the plugins work together. Developers can select, swap, or extend any capability in configuration without changing the DeepSeek Harness source code.\",\"harnessFeat1Alt\":\"Compose models, tools, storage, and the agent loop through Cordis configuration\",\"harnessFeat1ScreenshotAlt\":\"DeepSeek Harness plugin management page in Chinese, showing official plugins and a frosted workspace sidebar\",\"harnessFeat2Label\":\"Every run is traceable\",\"harnessFeat2Desc\":\"Everything the model sees is recorded in an append-only session log: system prompts, reasoning, tool calls and results, subagent scheduling, and every context injection. In the Trajectory view, you can inspect these records by source. Resume, fork, search, and replay all operate on the same event stream.\",\"harnessFeat2Alt\":\"Reconstruct a complete run from a single session log\",\"harnessFeat3Label\":\"Multiple runtime modes\",\"harnessFeat3Desc\":\"Standard mode includes the full toolset. Code mode uses model-generated code to orchestrate multiple rounds of tool calls. Minimal mode keeps only a shell tool and a file editor for benchmarking models in a minimal environment. Creator mode lets you inspect the current runtime, test Cordis plugins in memory, and combine them into new modes.\",\"harnessModePlaceholder\":\"Describe what you want to build\",\"harnessModeStandardName\":\"Standard mode\",\"harnessModeStandardDesc\":\"Full coding agent with file editing, shell, file and web search, skills, planning, goals, subagents, and workflows.\",\"harnessModeCodeName\":\"Code mode\",\"harnessModeCodeDesc\":\"All Standard mode capabilities, with tools exposed through the Code Mode SDK so the model can combine multi-step operations in one TypeScript program.\",\"harnessModeMinimalName\":\"Minimal mode\",\"harnessModeMinimalDesc\":\"Two-tool coding agent with persistent bash and str_replace_editor.\",\"harnessModeCordisName\":\"Creator mode\",\"harnessModeCordisDesc\":\"Built for creating custom agent presets, with all Standard mode capabilities plus runtime inspection, plugin experiments, and preset-authoring guidance.\",\"harnessDemoTitle\":\"Customize your DeepSeek Harness\",\"harnessDemoDesc\":\"Watch how you can customize page elements, tools, and agent presets in real time.\",\"harnessDemoAlt\":\"DeepSeek Harness product feature demo video\",\"harnessUseEyebrow\":\"Get started\",\"harnessUseTitle\":\"Developer experience\",\"harnessUse1Label\":\"Start with one command\",\"harnessUse1Desc\":\"Install Node.js, then launch the Web UI with npx.\",\"harnessUse1Alt\":\"DeepSeek Harness dark-mode Web UI analyzing a project and switching between Chat and Trajectory\",\"harnessUse2Label\":\"Install from source\",\"harnessUse2Desc\":\"Clone the full source and follow the setup instructions in the repository.\",\"harnessUse2Alt\":\"Clone, install, build, and launch the DeepSeek Harness Web UI from source\",\"harnessCtaTitle\":\"Join the DSH plugin ecosystem\",\"harnessCtaDesc\":\"DeepSeek Harness is in preview, with evolving core plugins and APIs. We invite users and developers worldwide to explore the limits of intelligence together through open-source, reusable, and composable infrastructure.\",\"harnessCtaDocs\":\"Developer docs\",\"harnessCtaPaper\":\"Cordis paper\",\"harnessCtaPlugins\":\"Community plugins\",\"harnessFooterCopyright\":\"© 2026 DeepSeek. All rights reserved.\",\"harnessFooterPolicyLinks\":\"Policies and statements\",\"harnessFooterSafeUse\":\"Safe Use Policy\",\"harnessFooterDataProcessing\":\"Data Processing Statement\",\"wechatLabel\":\"Official WeChat account\",\"wechatTooltip\":\"Scan to follow\",\"harnessFooterLicense\":\"Open source · MIT\",\"harnessFeat3Alt\":\"The new-session mode picker listing Standard, Code, Minimal, and Creator modes\",\"harnessFooterPrivacyPolicy\":\"Privacy Policy\",\"harnessFooterTermsOfUse\":\"Terms of Use\",\"harnessWhyTitlePrefix\":\"\",\"harnessWhyTitleSuffix\":\"keeps agents working in real-world environments\",\"harnessCtaEyebrow\":\"Developer preview\",\"harnessHeroDownloadForWindows\":\"Download for Windows\",\"harnessHeroDownloadDesktop\":\"Download Desktop\",\"harnessHeroDownloadMacNote\":\"Requires macOS 13 or later\",\"harnessHeroDownloadWindowsNote\":\"Requires Windows 10 or later\"},\"Capabilities\":{\"plugins\":{\"title\":\"Everything is a plugin\",\"description\":\"Install plugins, or create them through chat in “Creator mode”, to extend tools, skills, and the interface.\",\"imageAlt\":\"DeepSeek Harness plugin manager showing official plugins and the Add plugin action\"},\"trace\":{\"title\":\"Developer tools\",\"description\":\"Inspect execution traces and detailed runtime information to troubleshoot issues with tool calls and task execution.\",\"imageAlt\":\"DeepSeek Harness trajectory view showing a timeline, tool calls, and execution details\"},\"deliverables\":{\"title\":\"Complete a range of tasks\",\"description\":\"Organize documents, analyze spreadsheets, and write code. Preview the results directly and refine them through conversation.\"},\"workflow\":{\"title\":\"Adapt to your workflow\",\"description\":\"Enable the Scheduled tasks plugin to start tasks anytime and run recurring work on schedule. Stay on top of progress and inspect tool call details when needed.\"},\"pauseAnimation\":\"Pause demo\",\"playAnimation\":\"Resume demo\"},\"WorkflowPreview\":{\"accessibleLabel\":\"Workflow illustration: project reports, sales summaries, and project tests show a scheduled task's input, its scheduled result, and the task card that remains after the process collapses. This demo does not create real tasks.\",\"pauseAnimation\":\"Pause workflow demo\",\"playAnimation\":\"Resume workflow demo\",\"working\":\"Deep diving...\",\"finished\":\"Worked\",\"toolTitle\":\"Create reminder\",\"input\":\"IN\",\"scheduledFor\":\"Scheduled for\",\"repeat\":\"Repeat\",\"status\":\"Status\",\"scheduled\":\"Scheduled\",\"open\":\"Open\",\"scenarios\":{\"report\":{\"title\":\"Weekly project report\",\"prompt\":\"Summarize this week's project notes in a weekly report.\",\"request\":\"Every Friday at 17:00 Beijing time, summarize this week's project notes in a weekly report.\",\"confirmation\":\"Created “Weekly project report”, scheduled for Fridays at 17:00 Beijing time.\",\"repeat\":\"Weekly on Fri at 17:00 (Asia/Shanghai)\",\"frequency\":\"Weekly on Fri at 17:00 (UTC+08:00 · China Standard Time)\"},\"sales\":{\"title\":\"Sales summary\",\"prompt\":\"Summarize sales spreadsheets and flag unusual changes.\",\"request\":\"Every day at 09:00 Beijing time, summarize sales spreadsheets and flag unusual changes.\",\"confirmation\":\"Created “Sales summary”, scheduled for 09:00 Beijing time every day.\",\"repeat\":\"Every day at 09:00 (Asia/Shanghai)\",\"frequency\":\"Daily at 09:00 (UTC+08:00 · China Standard Time)\"},\"tests\":{\"title\":\"Project test summary\",\"prompt\":\"Run the project tests and summarize any failures.\",\"request\":\"Every Monday at 10:00 Beijing time, run the project tests and summarize any failures.\",\"confirmation\":\"Created “Project test summary”, scheduled for Mondays at 10:00 Beijing time.\",\"repeat\":\"Weekly on Mon at 10:00 (Asia/Shanghai)\",\"frequency\":\"Weekly on Mon at 10:00 (UTC+08:00 · China Standard Time)\"}}},\"DeliverablesPreview\":{\"accessibleLabel\":\"Illustration of file and code work: Word, Excel, HTML, TypeScript, Python, PDF, and Markdown file cards cycle upward beside a stationary code diff showing two added lines and one removed line.\",\"pauseAnimation\":\"Pause file carousel\",\"playAnimation\":\"Resume file carousel\",\"htmlName\":\"index.html\",\"htmlType\":\"HTML page\",\"typescriptName\":\"label.ts\",\"typescriptType\":\"TypeScript code\",\"pythonName\":\"analyze.py\",\"pythonType\":\"Python script\",\"wordName\":\"Brief.docx\",\"wordType\":\"Word document\",\"excelName\":\"Data.xlsx\",\"excelType\":\"Excel spreadsheet\",\"pdfName\":\"Report.pdf\",\"pdfType\":\"PDF document\",\"markdownName\":\"README.md\",\"markdownType\":\"Markdown document\",\"reviewTab\":\"Review · turn 1\"},\"DesktopPreview\":{\"accessibleLabel\":\"DeepSeek Harness conversation preview: beside a frosted sidebar, a user asks for an introduction and DSH describes itself and five areas of work, with the composer at the bottom.\",\"conversationTitle\":\"Meet DeepSeek Harness\",\"conversationQuestion\":\"Could you introduce yourself?\",\"conversationTime\":\"2min\",\"thinkingCompleted\":\"Thought for a while\",\"conversationIntro\":\"I'm DeepSeek Harness, an open-source harness from DeepSeek built on \u003ccordis\u003eCordis\u003c/cordis\u003e's “everything is a plugin” architecture. Run me as a desktop app or launch the web UI from code.\",\"conversationLead\":\"I can help with:\",\"conversationItem1\":\"\u003cstrong\u003eEveryday work\u003c/strong\u003e — Organize files, analyze data, draft docs, and create slides.\",\"conversationItem2\