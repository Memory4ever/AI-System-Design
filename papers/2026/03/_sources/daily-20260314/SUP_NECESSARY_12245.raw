<td id="A6.T7.5.3.2" class="ltx_td ltx_align_center ltx_border_bb">11.98</td>
<td id="A6.T7.5.3.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A6.T7.5.3.3.1" class="ltx_text ltx_font_bold">90.18</span></td>
