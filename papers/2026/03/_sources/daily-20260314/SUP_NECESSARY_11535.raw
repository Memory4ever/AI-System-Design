<td id="A3.T7.5.6.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A3.T7.m20" class="ltx_Math" alttext="0.02\lambda" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.02</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">λ</mi></mrow><annotation encoding="application/x-tex">0.02\lambda</annotation></semantics></math></td>
<td id="A3.T7.5.6.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="A3.T7.5.6.4.1" class="ltx_text" style="font-size:80%;">Muon</span></td></tr>
<tr id="A3.T7.5.7" class="ltx_tr">
<td id="A3.T7.5.7.1" class="ltx_td ltx_align_left"><math id="A3.T7.m21" class="ltx_Math" alttext="W^{(e)}_{\uparrow}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">W</mi><mo mathsize="0.800em" stretchy="false">↑</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">e</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></msubsup><annotation encoding="application/x-tex">W^{(e)}_{\uparrow}</annotation></semantics></math><span id="A3.T7.5.7.1.1" class="ltx_text" style="font-size:80%;"> (exp. up)</span></td>
