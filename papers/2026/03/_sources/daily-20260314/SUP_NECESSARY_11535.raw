<td id="S4.T2.5.3.4" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.5.3.4.1" class="ltx_text" style="font-size:90%;">22.31</span></td></tr>
