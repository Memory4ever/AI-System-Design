</span></th>
<th id="S4.T2.5.3.2" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.5.3.2.1" class="ltx_text" style="font-size:90%;">32k</span></th>
