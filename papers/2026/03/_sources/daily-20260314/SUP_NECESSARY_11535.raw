<td id="S4.T2.5.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.5.2.3.1" class="ltx_text" style="font-size:90%;">2.751</span></td>
<td id="S4.T2.5.2.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.5.2.4.1" class="ltx_text" style="font-size:90%;">20.43</span></td></tr>
