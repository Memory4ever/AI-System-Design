<td id="A3.T7.5.7.3" class="ltx_td ltx_align_center"><math id="A3.T7.m22" class="ltx_Math" alttext="0.02\lambda" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.02</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">λ</mi></mrow><annotation encoding="application/x-tex">0.02\lambda</annotation></semantics></math></td>
<td id="A3.T7.5.7.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A3.T7.5.7.4.1" class="ltx_text" style="font-size:80%;">Muon</span></td></tr>
<tr id="A3.T7.5.8" class="ltx_tr">
<td id="A3.T7.5.8.1" class="ltx_td ltx_align_left"><math id="A3.T7.m23" class="ltx_Math" alttext="W^{(e)}_{\downarrow}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">W</mi><mo mathsize="0.800em" stretchy="false">↓</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">e</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></msubsup><annotation encoding="application/x-tex">W^{(e)}_{\downarrow}</annotation></semantics></math><span id="A3.T7.5.8.1.1" class="ltx_text" style="font-size:80%;"> (exp. dn)</span></td>
<td id="A3.T7.5.8.2" class="ltx_td ltx_align_center"><math id="A3.T7.m24" class="ltx_Math" alttext="\mathbf{0}" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">𝟎</mn><annotation encoding="application/x-tex">\mathbf{0}</annotation></semantics></math></td>
<td id="A3.T7.5.8.3" class="ltx_td ltx_align_center"><math id="A3.T7.m25" class="ltx_Math" alttext="0.02\lambda" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.800em">0.02</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">λ</mi></mrow><annotation encoding="application/x-tex">0.02\lambda</annotation></semantics></math></td>
<td id="A3.T7.5.8.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="A3.T7.5.8.4.1" class="ltx_text" style="font-size:80%;">Muon</span></td></tr>
<tr id="A3.T7.5.9" class="ltx_tr">
<td id="A3.T7.5.9.1" class="ltx_td ltx_align_left"><math id="A3.T7.m26" class="ltx_Math" alttext="W^{(s)}_{\uparrow}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">W</mi><mo mathsize="0.800em" stretchy="false">↑</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">s</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></msubsup><annotation encoding="application/x-tex">W^{(s)}_{\uparrow}</annotation></semantics></math><span id="A3.T7.5.9.1.1" class="ltx_text" style="font-size:80%;"> (shd. up)</span></td>
