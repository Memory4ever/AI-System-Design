<th id="A2.T5.5.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A2.T5.5.10.1.1" class="ltx_text" style="font-size:90%;">QK Normalization</span></th>
<th id="A2.T5.5.10.2" class="ltx_td ltx_align_left ltx_align_top ltx_th ltx_th_row ltx_border_r">
<span id="A2.T5.5.10.2.1" class="ltx_inline-block ltx_align_top" style="width:99.6pt;">
<span id="A2.T5.5.10.2.1.1" class="ltx_p ltx_align_center"><span id="A2.T5.5.10.2.1.1.1" class="ltx_text" style="font-size:90%;">No</span></span>
</span></th>
