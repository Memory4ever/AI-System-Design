<figure id="A7.T6" class="ltx_table">
<div class="ltx_flex_figure ltx_flex_table">
<div class="ltx_flex_cell ltx_flex_size_1">
<p id="A7.T6.3" class="ltx_p ltx_figure_panel ltx_align_center"><span id="A7.T6.3.1" class="ltx_text ltx_font_bold">Q&amp;A Coding
<br class="ltx_break" style="--ltx-break-space:2.8pt;"></span><span id="A7.T6.3.2" class="ltx_text" style="font-size:80%;">

<span id="A7.T6.3.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<span class="ltx_tbody">
<span id="A7.T6.3.2.1.1" class="ltx_tr">
<span id="A7.T6.3.2.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt" style="padding:0.65pt 4.0pt;"></span>
<span id="A7.T6.3.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.65pt 4.0pt;"><span id="A7.T6.3.2.1.1.2.1" class="ltx_text ltx_font_bold">CE Q&amp;A</span></span>
<span id="A7.T6.3.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_4" style="padding:0.65pt 4.0pt;"><span id="A7.T6.3.2.1.1.3.1" class="ltx_text ltx_font_bold">HumanEval</span></span>
<span id="A7.T6.3.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_4" style="padding:0.65pt 4.0pt;"><span id="A7.T6.3.2.1.1.4.1" class="ltx_text ltx_font_bold">MBPP</span></span>
<span id="A7.T6.3.2.1.1.5" class="ltx_td ltx_align_center ltx_border_tt ltx_colspan ltx_colspan_4" style="padding:0.65pt 4.0pt;"><span id="A7.T6.3.2.1.1.5.1" class="ltx_text ltx_font_bold">Multipl-E</span></span></span>
<span id="A7.T6.3.2.1.2" class="ltx_tr">
<span id="A7.T6.3.2.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.65pt 4.0pt;"><span id="A7.T6.3.2.1.2.1.1" class="ltx_text ltx_font_bold">Method</span></span>
