<span id="A8.F19.pic1.p3.6" class="ltx_p"><span id="A8.F19.pic1.p3.6.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#000000;">(continuation omitted)<span id="A8.F19.pic1.p3.6.1.1" class="ltx_text"></span></span></span>
