<span id="lstnumberx97" class="ltx_listingline"><span id="lstnumberx97.1" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:70%;--ltx-fg-color:#000000;">#<span id="lstnumberx97.1.1" class="ltx_text ltx_lst_space"> </span>core<span id="lstnumberx97.1.2" class="ltx_text ltx_lst_space"> </span>logic<span id="lstnumberx97.1.3" class="ltx_text ltx_lst_space"> </span>resembles<span id="lstnumberx97.1.4" class="ltx_text ltx_lst_space"> </span>EBFT,<span id="lstnumberx97.1.5" class="ltx_text ltx_lst_space"> </span>but<span id="lstnumberx97.1.6" class="ltx_text ltx_lst_space"> </span>output<span id="lstnumberx97.1.7" class="ltx_text ltx_lst_space"> </span>contained<span id="lstnumberx97.1.8" class="ltx_text ltx_lst_space"> </span>extra<span id="lstnumberx97.1.9" class="ltx_text ltx_lst_space"> </span>non-code/formatting</span>
