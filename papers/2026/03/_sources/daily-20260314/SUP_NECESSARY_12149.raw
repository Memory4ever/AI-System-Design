<td id="S4.T3.6.1.7.2" class="ltx_td ltx_align_center"><span id="S4.T3.6.1.7.2.1" class="ltx_text ltx_underline">38.94</span></td>
<td id="S4.T3.6.1.7.3" class="ltx_td ltx_align_center"><span id="S4.T3.6.1.7.3.1" class="ltx_text ltx_underline">43.93</span></td>
<td id="S4.T3.6.1.7.4" class="ltx_td ltx_align_center"><span id="S4.T3.6.1.7.4.1" class="ltx_text ltx_underline">41.45</span></td></tr>
<tr id="S4.T3.6.1.8" class="ltx_tr">
