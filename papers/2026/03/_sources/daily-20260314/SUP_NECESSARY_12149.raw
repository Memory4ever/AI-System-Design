<th id="S1.T5.8.1.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<th id="S1.T5.8.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="6"><span id="S1.T5.8.1.1.2.1" class="ltx_text ltx_font_bold">Math Reasoning</span></th>
<th id="S1.T5.8.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" colspan="6"><span id="S1.T5.8.1.1.3.1" class="ltx_text ltx_font_bold">General VQA</span></th>
<td id="S1.T5.8.1.1.4" class="ltx_td ltx_border_tt"></td></tr>
<tr id="S1.T5.8.1.2" class="ltx_tr">
<th id="S1.T5.8.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row"><span id="S1.T5.8.1.2.1.1" class="ltx_text ltx_font_bold">Methods</span></th>
<th id="S1.T5.8.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="3"><span id="S1.T5.8.1.2.2.1" class="ltx_text ltx_font_bold">Math-Vista<sub id="S1.T5.8.1.2.2.1.1" class="ltx_sub"><span id="S1.T5.8.1.2.2.1.1.1" class="ltx_text ltx_font_italic">testmini</span></sub></span></th>
<th id="S1.T5.8.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" colspan="3"><span id="S1.T5.8.1.2.3.1" class="ltx_text ltx_font_bold">Math-Vision<sub id="S1.T5.8.1.2.3.1.1" class="ltx_sub"><span id="S1.T5.8.1.2.3.1.1.1" class="ltx_text ltx_font_italic">testmini</span></sub></span></th>
