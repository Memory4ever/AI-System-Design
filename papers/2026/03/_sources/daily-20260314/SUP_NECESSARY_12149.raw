<td id="S4.T3.6.1.8.3" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T3.6.1.8.3.1" class="ltx_text ltx_font_bold">42.41</span></td>
<td id="S4.T3.6.1.8.4" class="ltx_td ltx_align_center ltx_border_b"><span id="S4.T3.6.1.8.4.1" class="ltx_text ltx_font_bold">43.75</span></td></tr>
