<td id="S4.T3.2.1.8.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.25pt 4.0pt;">1</td>
<td id="S4.T3.2.1.8.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding:0.25pt 4.0pt;">3.64</td>
