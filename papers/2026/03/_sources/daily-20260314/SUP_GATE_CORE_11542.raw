<td id="S4.T1.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.2.2.1" class="ltx_text" style="font-size:80%;">60.35</span></td>
<td id="S4.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.2.3.1" class="ltx_text" style="font-size:80%;">85.68</span></td>
<td id="S4.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.2.4.1" class="ltx_text" style="font-size:80%;">42.91</span></td>
<td id="S4.T1.2.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.2.5.1" class="ltx_text" style="font-size:80%;">36.27</span></td>
<td id="S4.T1.2.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.2.6.1" class="ltx_text" style="font-size:80%;">17.01</span></td>
