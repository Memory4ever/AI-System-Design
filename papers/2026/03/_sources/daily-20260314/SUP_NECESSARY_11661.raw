<td id="S3.T4.5.1.3.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">5.276</td>
<td id="S3.T4.5.1.3.3" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">6.063</td>
<td id="S3.T4.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T4.5.1.3.4.1" class="ltx_text ltx_font_bold">0.479</span></td>
<td id="S3.T4.5.1.3.5" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">0.711</td></tr>
<tr id="S3.T4.5.1.4" class="ltx_tr">
<th id="S3.T4.5.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T4.5.1.4.1.1" class="ltx_ERROR undefined">\rowcolor</span>blue!10
 w. AQAScore</th>
<td id="S3.T4.5.1.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T4.5.1.4.2.1" class="ltx_text ltx_font_bold">5.328</span></td>
<td id="S3.T4.5.1.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T4.5.1.4.3.1" class="ltx_text ltx_font_bold">6.064</span></td>
<td id="S3.T4.5.1.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;">0.476</td>
<td id="S3.T4.5.1.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S3.T4.5.1.4.5.1" class="ltx_text ltx_font_bold">0.737</span></td></tr>
