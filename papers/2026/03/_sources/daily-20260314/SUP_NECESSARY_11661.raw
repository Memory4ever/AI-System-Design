<td id="S2.T2.5.1.3.4" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S2.T2.5.1.3.4.1" class="ltx_text ltx_font_bold">0.429</span></td></tr>
<tr id="S2.T2.5.1.4" class="ltx_tr">
