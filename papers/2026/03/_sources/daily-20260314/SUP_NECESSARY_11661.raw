<th id="S2.T1.5.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">AudioLDM-2-Large <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib14" title="" class="ltx_ref">31</a>]</cite></th>
<th id="S2.T1.5.1.4.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">718M</th>
<th id="S2.T1.5.1.4.3" class="ltx_td ltx_align_center ltx_th ltx_th_row">200</th>
