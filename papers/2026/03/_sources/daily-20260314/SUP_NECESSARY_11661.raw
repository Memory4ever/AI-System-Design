<td id="S2.T2.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.472</td>
<td id="S2.T2.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.477</td>
<td id="S2.T2.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;">0.337</td></tr>
<tr id="S2.T2.5.1.3" class="ltx_tr">
<th id="S2.T2.5.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:8.0pt;padding-right:8.0pt;">Qwen2.5-Omni-7B</th>
<td id="S2.T2.5.1.3.2" class="ltx_td ltx_align_center" style="padding-left:8.0pt;padding-right:8.0pt;">0.518</td>
