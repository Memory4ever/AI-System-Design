<th id="S4.T4.2.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt"><span id="S4.T4.2.1.2.1" class="ltx_text ltx_font_bold">Retrieval</span></th>
<th id="S4.T4.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.2.1.3.1" class="ltx_text ltx_font_bold">360M</span></th>
<th id="S4.T4.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt"><span id="S4.T4.2.1.4.1" class="ltx_text ltx_font_bold">1.5B</span></th>
