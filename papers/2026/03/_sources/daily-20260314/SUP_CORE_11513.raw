<td id="S4.T4.2.2.3" class="ltx_td ltx_align_right ltx_border_t">0.0</td>
<td id="S4.T4.2.2.4" class="ltx_td ltx_align_right ltx_border_t">0.0</td>
<td id="S4.T4.2.2.5" class="ltx_td ltx_align_right ltx_border_t">0.0</td>
<td id="S4.T4.2.2.6" class="ltx_td ltx_align_right ltx_border_t">0.0</td></tr>
