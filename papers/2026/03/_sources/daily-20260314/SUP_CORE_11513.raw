<td id="S4.T3.2.2.3" class="ltx_td ltx_align_right ltx_border_t">0.0</td>
<td id="S4.T3.2.2.4" class="ltx_td ltx_align_right ltx_border_t">0.0</td>
<td id="S4.T3.2.2.5" class="ltx_td ltx_align_right ltx_border_t">0.0</td></tr>
<tr id="S4.T3.2.3" class="ltx_tr">
<th id="S4.T3.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5-1.5B</th>
<td id="S4.T3.2.3.2" class="ltx_td ltx_align_right">14.5</td>
<td id="S4.T3.2.3.3" class="ltx_td ltx_align_right">5.5</td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_align_right">3.5</td>
<td id="S4.T3.2.3.5" class="ltx_td ltx_align_right">6.0</td></tr>
<tr id="S4.T3.2.4" class="ltx_tr">
<th id="S4.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Qwen2.5-3B</th>
<td id="S4.T3.2.4.2" class="ltx_td ltx_align_right">19.5</td>
<td id="S4.T3.2.4.3" class="ltx_td ltx_align_right">5.5</td>
<td id="S4.T3.2.4.4" class="ltx_td ltx_align_right">12.0</td>
<td id="S4.T3.2.4.5" class="ltx_td ltx_align_right">6.5</td></tr>
<tr id="S4.T3.2.5" class="ltx_tr">
<th id="S4.T3.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">Qwen2.5-7B</th>
<td id="S4.T3.2.5.2" class="ltx_td ltx_align_right ltx_border_bb">16.5</td>
<td id="S4.T3.2.5.3" class="ltx_td ltx_align_right ltx_border_bb">–</td>
<td id="S4.T3.2.5.4" class="ltx_td ltx_align_right ltx_border_bb">14.0</td>
