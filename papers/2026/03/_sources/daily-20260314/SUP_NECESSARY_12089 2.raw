<td id="S5.T2.4.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.75pt 8.5pt;"><span id="S5.T2.4.1.4.1" class="ltx_text ltx_font_bold">FedAvg</span></td>
