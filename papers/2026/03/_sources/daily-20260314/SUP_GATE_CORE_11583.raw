<td id="S5.T1.2.4.2" class="ltx_td ltx_align_center"><span id="S5.T1.2.4.2.1" class="ltx_text ltx_font_bold">0.471 (0.060)</span></td>
<td id="S5.T1.2.4.3" class="ltx_td ltx_align_center"><span id="S5.T1.2.4.3.1" class="ltx_text ltx_font_bold">0.664 (0.064)</span></td></tr>
<tr id="S5.T1.2.5" class="ltx_tr">
<th id="S5.T1.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="3"><span id="S5.T1.2.5.1.1" class="ltx_text">GPT-5.4</span></th>
<th id="S5.T1.2.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Basic</th>
<td id="S5.T1.2.5.3" class="ltx_td ltx_align_center ltx_border_t">0.532 (0.052)</td>
<td id="S5.T1.2.5.4" class="ltx_td ltx_align_center ltx_border_t">0.739 (0.056)</td></tr>
<tr id="S5.T1.2.6" class="ltx_tr">
<th id="S5.T1.2.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Harsh</th>
<td id="S5.T1.2.6.2" class="ltx_td ltx_align_center">0.518 (0.050)</td>
<td id="S5.T1.2.6.3" class="ltx_td ltx_align_center">0.712 (0.060)</td></tr>
<tr id="S5.T1.2.7" class="ltx_tr">
<th id="S5.T1.2.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">UtilityMax</th>
<td id="S5.T1.2.7.2" class="ltx_td ltx_align_center"><span id="S5.T1.2.7.2.1" class="ltx_text ltx_font_bold">0.578 (0.047)</span></td>
<td id="S5.T1.2.7.3" class="ltx_td ltx_align_center"><span id="S5.T1.2.7.3.1" class="ltx_text ltx_font_bold">0.788 (0.050)</span></td></tr>
<tr id="S5.T1.2.8" class="ltx_tr">
<th id="S5.T1.2.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="3"><span id="S5.T1.2.8.1.1" class="ltx_text">Gemini 2.5 Pro</span></th>
