<td id="S5.T1.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.418 (0.054)</td>
<td id="S5.T1.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.570 (0.070)</td></tr>
