<th id="S7.T7.6.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T7.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Overall</span></th>
<th id="S7.T7.6.1.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="S7.T7.m5" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathsize="0.900em" mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math><span id="S7.T7.6.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;"> vs. Full</span></th></tr>
