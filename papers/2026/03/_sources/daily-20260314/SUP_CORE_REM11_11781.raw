<td id="A4.T9.5.21.3" class="ltx_td ltx_nopad_r ltx_align_right"><span id="A4.T9.5.21.3.1" class="ltx_text" style="font-size:90%;">1–10</span></td></tr>
<tr id="A4.T9.5.22" class="ltx_tr">
<td id="A4.T9.5.22.1" class="ltx_td ltx_align_left"><span id="A4.T9.5.22.1.1" class="ltx_text" style="font-size:90%;">Significance test</span></td>
<td id="A4.T9.5.22.2" class="ltx_td ltx_align_left"><span id="A4.T9.5.22.2.1" class="ltx_text" style="font-size:90%;">Statistical test</span></td>
<td id="A4.T9.5.22.3" class="ltx_td ltx_nopad_r ltx_align_right"><span id="A4.T9.5.22.3.1" class="ltx_text" style="font-size:90%;">Wilcoxon</span></td></tr>
<tr id="A4.T9.5.23" class="ltx_tr">
<td id="A4.T9.5.23.1" class="ltx_td ltx_align_left"><span id="A4.T9.5.23.1.1" class="ltx_text" style="font-size:90%;">Multiple comparison</span></td>
<td id="A4.T9.5.23.2" class="ltx_td ltx_align_left"><span id="A4.T9.5.23.2.1" class="ltx_text" style="font-size:90%;">Correction method</span></td>
<td id="A4.T9.5.23.3" class="ltx_td ltx_nopad_r ltx_align_right"><span id="A4.T9.5.23.3.1" class="ltx_text" style="font-size:90%;">Holm-Šidák</span></td></tr>
<tr id="A4.T9.5.24" class="ltx_tr">
<td id="A4.T9.5.24.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T9.5.24.1.1" class="ltx_text" style="font-size:90%;">Confidence intervals</span></td>
<td id="A4.T9.5.24.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T9.5.24.2.1" class="ltx_text" style="font-size:90%;">Bootstrap method</span></td>
<td id="A4.T9.5.24.3" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_bb"><span id="A4.T9.5.24.3.1" class="ltx_text" style="font-size:90%;">95% CI</span></td></tr>
