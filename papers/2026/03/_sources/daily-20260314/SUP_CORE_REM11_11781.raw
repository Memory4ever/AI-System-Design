<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span><span id="A1.2" class="ltx_text ltx_font_smallcaps">DCI-CF</span> Pseudocode</h2>

<figure id="LST1" class="ltx_float ltx_lstlisting">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float">Listing 1: </span><span id="LST1.3" class="ltx_text ltx_font_smallcaps">DCI-CF</span> convergent flow algorithm.</figcaption>
<div id="LST1.4" class="ltx_listing ltx_lst_language_Python ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing" style="--ltx-bg-color:#F9F9F9;"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_keyword ltx_font_bold" style="font-size:90%;">def</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier" style="font-size:90%;">dci_convergent_flow</span><span id="lstnumberx1.4" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx1.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">problem</span><span id="lstnumberx1.6" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx1.7" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.8" class="ltx_text ltx_lst_identifier" style="font-size:90%;">delegates</span><span id="lstnumberx1.9" class="ltx_text" style="font-size:90%;">,</span><span id="lstnumberx1.10" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx1.11" class="ltx_text ltx_lst_identifier" style="font-size:90%;">criteria</span><span id="lstnumberx1.12" class="ltx_text" style="font-size:90%;">,</span>
</div>
<div id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_lst_space" style="font-size:90%;">                        </span><span id="lstnumberx2.2" class="ltx_text ltx_lst_identifier" style="font-size:90%;">max_rounds</span><span id="lstnumberx2.3" class="ltx_text" style="font-size:90%;">=2,</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">max_options</span><span id="lstnumberx2.6" class="ltx_text" style="font-size:90%;">=5,</span>
</div>
