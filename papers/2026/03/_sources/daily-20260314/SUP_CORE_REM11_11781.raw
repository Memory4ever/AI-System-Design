<th id="S7.T8.5.1.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S7.T8.5.1.4.1" class="ltx_text" style="font-size:90%;">Claude</span></th></tr>
