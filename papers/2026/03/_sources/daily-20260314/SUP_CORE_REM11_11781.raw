<td id="S7.T7.6.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S7.T7.6.2.2.1" class="ltx_text" style="font-size:90%;">8.24</span></td>
<td id="S7.T7.6.2.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t"><span id="S7.T7.6.2.3.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="S7.T7.6.3" class="ltx_tr">
<th id="S7.T7.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S7.T7.6.3.1.1" class="ltx_text" style="font-size:90%;">A1: No Archetypes</span></th>
<td id="S7.T7.6.3.2" class="ltx_td ltx_align_center"><span id="S7.T7.6.3.2.1" class="ltx_text" style="font-size:90%;">8.61 <math id="S7.T7.m6" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 0.68</span></td>
<td id="S7.T7.6.3.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S7.T7.6.3.3.1" class="ltx_text" style="font-size:90%;">+0.37</span></td></tr>
<tr id="S7.T7.6.4" class="ltx_tr">
<th id="S7.T7.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S7.T7.6.4.1.1" class="ltx_text" style="font-size:90%;">A2: No Typed Grammar</span></th>
<td id="S7.T7.6.4.2" class="ltx_td ltx_align_center"><span id="S7.T7.6.4.2.1" class="ltx_text" style="font-size:90%;">8.32 <math id="S7.T7.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.47</span></td>
<td id="S7.T7.6.4.3" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S7.T7.6.4.3.1" class="ltx_text" style="font-size:90%;">+0.08</span></td></tr>
<tr id="S7.T7.6.5" class="ltx_tr">
