<td id="S7.T6.5.2.4" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_t"><span id="S7.T6.5.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">2.320</span></td></tr>
