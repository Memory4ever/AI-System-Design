<div id="lstnumberx55" class="ltx_listingline"><span id="lstnumberx55.1" class="ltx_text ltx_lst_space" style="font-size:90%;">        </span><span id="lstnumberx55.2" class="ltx_text ltx_lst_string ltx_font_italic" style="font-size:90%;">"reopen_conditions"</span><span id="lstnumberx55.3" class="ltx_text" style="font-size:90%;">:</span><span id="lstnumberx55.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx55.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">derive_reopen_conditions</span><span id="lstnumberx55.6" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx55.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;">records</span><span id="lstnumberx55.8" class="ltx_text" style="font-size:90%;">),</span>
</div>
<div id="lstnumberx56" class="ltx_listingline"><span id="lstnumberx56.1" class="ltx_text ltx_lst_space" style="font-size:90%;">        </span><span id="lstnumberx56.2" class="ltx_text ltx_lst_string ltx_font_italic" style="font-size:90%;">"confidence"</span><span id="lstnumberx56.3" class="ltx_text" style="font-size:90%;">:</span><span id="lstnumberx56.4" class="ltx_text ltx_lst_space" style="font-size:90%;"> </span><span id="lstnumberx56.5" class="ltx_text ltx_lst_identifier" style="font-size:90%;">compute_confidence</span><span id="lstnumberx56.6" class="ltx_text" style="font-size:90%;">(</span><span id="lstnumberx56.7" class="ltx_text ltx_lst_identifier" style="font-size:90%;">winner</span><span id="lstnumberx56.8" class="ltx_text" style="font-size:90%;">),</span>
</div>
