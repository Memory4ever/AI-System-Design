{"data":{"id":"10.48550/arxiv.2603.11653","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.11653","prefix":"10.48550","suffix":"arxiv.2603.11653","identifiers":[{"identifier":"2603.11653","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.11653"}],"creators":[{"name":"Hu, Jiaheng","nameType":"Personal","givenName":"Jiaheng","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Shim, Jay","nameType":"Personal","givenName":"Jay","familyName":"Shim","affiliation":[],"nameIdentifiers":[]},{"name":"Tang, Chen","nameType":"Personal","givenName":"Chen","familyName":"Tang","affiliation":[],"nameIdentifiers":[]},{"name":"Sung, Yoonchang","nameType":"Personal","givenName":"Yoonchang","familyName":"Sung","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Bo","nameType":"Personal","givenName":"Bo","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Stone, Peter","nameType":"Personal","givenName":"Peter","familyName":"Stone","affiliation":[],"nameIdentifiers":[]},{"name":"Martin-Martin, Roberto","nameType":"Personal","givenName":"Roberto","familyName":"Martin-Martin","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Simple Recipe Works: Vision-Language-Action Models are Natural Continual Learners with Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-12T08:22:39Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:33:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-01T01:17:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-02T01:28:35Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-11T00:24:04Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-07-14T00:13:48Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Continual Reinforcement Learning (CRL) for Vision-Language-Action (VLA) models is a promising direction toward self-improving embodied agents that can adapt in openended, evolving environments. However, conventional wisdom from continual learning suggests that naive Sequential Fine-Tuning (Seq. FT) leads to catastrophic forgetting, necessitating complex CRL strategies. In this work, we take a step back and conduct a systematic study of CRL for large pretrained VLAs across diverse lifelong RL benchmarks. We find that, contrary to established belief, simple Seq. FT with low-rank adaptation (LoRA) is remarkably strong: it achieves high plasticity, exhibits little to no forgetting, and retains strong zero-shot generalization, frequently outperforming more sophisticated CRL methods. Through detailed analysis, we show that this robustness arises from a synergy between the large pretrained model, parameter-efficient adaptation, and on-policy RL. Together, these components reshape the stability-plasticity trade-off, making continual adaptation both stable and scalable. Our results position Sequential Fine-Tuning as a powerful method for continual RL with VLAs and provide new insights into lifelong learning in the large model era. Code is available at https://github.com/UT-Austin-RobIn/continual-vla-rl","descriptionType":"Abstract"},{"description":"Accepted at RLC 2026; Best paper award at ICRA26 RL4IL Workshop","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.11653","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-13T02:00:30.000Z","registered":"2026-03-13T02:00:31.000Z","published":"2026","updated":"2026-07-14T04:02:24.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.11653","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}