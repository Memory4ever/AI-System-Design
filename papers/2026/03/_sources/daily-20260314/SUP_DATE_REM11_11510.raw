ion":[],"nameIdentifiers":[]},{"name":"Lin, Hangyu","nameType":"Personal","givenName":"Hangyu","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Locatelli, Acyr","nameType":"Personal","givenName":"Acyr","familyName":"Locatelli","affiliation":[],"nameIdentifiers":[]},{"name":"Hooker, Sara","nameType":"Personal","givenName":"Sara","familyName":"Hooker","affiliation":[],"nameIdentifiers":[]},{"name":"Kocmi, Tom","nameType":"Personal","givenName":"Tom","familyName":"Kocmi","affiliation":[],"nameIdentifiers":[]},{"name":"Gomez, Aidan","nameType":"Personal","givenName":"Aidan","familyName":"Gomez","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Ivan","nameType":"Personal","givenName":"Ivan","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Blunsom, Phil","nameType":"Personal","givenName":"Phil","familyName":"Blunsom","affiliation":[],"nameIdentifiers":[]},{"name":"Frosst, Nick","nameType":"Personal","givenName":"Nick","familyName":"Frosst","affiliation":[],"nameIdentifiers":[]},{"name":"Pineau, Joelle","nameType":"Personal","givenName":"Joelle","familyName":"Pineau","affiliation":[],"nameIdentifiers":[]},{"name":"Ermis, Beyza","nameType":"Personal","givenName":"Beyza","familyName":"Ermis","affiliation":[],"nameIdentifiers":[]},{"name":"Üstün, Ahmet","nameType":"Personal","givenName":"Ahmet","familyName":"Üstün","affiliation":[],"nameIdentifiers":[]},{"name":"Kreutzer, Julia","nameType":"Personal","givenName":"Julia","familyName":"Kreutzer","affiliation":[],"nameIdentifiers":[]},{"name":"Fadaee, Marzieh","nameType":"Personal","givenName":"Marzieh","familyName":"Fadaee","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Tiny Aya: Bridging Scale and Multilingual Depth"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-12T03:53:13Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:22:21Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Tiny Aya redefines what a small multilingual language model can achieve. Trained on 70 languages and refined through region-aware posttraining, it delivers state-of-the-art in translation quality, strong multilingual understanding, and high-quality target-language generation, all with just 3.35B parameters. The release includes a pretrained foundation model, a globally balanced instruction-tuned variant, and three region-specialized models targeting languages from Africa, South Asia, Europe, Asia-Pacific, and West Asia. This report details the training strategy, data composition, and comprehensive evaluation framework behind Tiny Aya, and presents an alternative scaling path for multilingual AI: one centered on efficiency, balanced performance across languages, and practical deployment.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.11510","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-13T01:57:12.000Z","registered":"2026-03-13T01:57:13.000Z","published":"2026","updated":"2026-03-13T01:57:13.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.11510","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}