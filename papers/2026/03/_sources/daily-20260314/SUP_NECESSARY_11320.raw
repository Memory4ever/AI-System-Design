<tr id="S3.T1.6.1.7" class="ltx_tr">
<th id="S3.T1.6.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S3.T1.6.1.7.1.1" class="ltx_text ltx_font_smallcaps">VARGPT-Compressed</span></th>
<td id="S3.T1.6.1.7.2" class="ltx_td ltx_align_center">55.90</td>
<td id="S3.T1.6.1.7.3" class="ltx_td ltx_align_center">265.83</td>
<td id="S3.T1.6.1.7.4" class="ltx_td ltx_align_center">1272.80</td>
<td id="S3.T1.6.1.7.5" class="ltx_td ltx_align_center">84.99</td>
<td id="S3.T1.6.1.7.6" class="ltx_td ltx_align_center">48.41</td>
<td id="S3.T1.6.1.7.7" class="ltx_td ltx_align_center">25.34</td>
<td id="S3.T1.6.1.7.8" class="ltx_td ltx_align_center">27.40</td>
