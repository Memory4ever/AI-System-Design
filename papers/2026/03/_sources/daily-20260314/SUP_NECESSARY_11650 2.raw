<td id="S3.T1.2.1.2.12" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T1.2.1.2.12.1" class="ltx_text ltx_font_bold">MET.</span></td></tr>
<tr id="S3.T1.2.1.3" class="ltx_tr">
<th id="S3.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">Original</th>
<td id="S3.T1.2.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.5022</td>
<td id="S3.T1.2.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.5654</td>
<td id="S3.T1.2.1.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.7324</td>
<td id="S3.T1.2.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.1906</td>
<td id="S3.T1.2.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.2254</td>
<td id="S3.T1.2.1.3.7" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.3904</td>
<td id="S3.T1.2.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.1707</td>
<td id="S3.T1.2.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.2315</td>
