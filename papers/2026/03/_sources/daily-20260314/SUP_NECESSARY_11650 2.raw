<td id="S3.T1.2.1.2.10" class="ltx_td ltx_align_center" style="padding-top:0.5pt;padding-bottom:0.5pt;"><span id="S3.T1.2.1.2.10.1" class="ltx_text ltx_font_bold">BLEU</span></td>
