<td id="A0.T12.10.1.9.8" class="ltx_td ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.9.8.1" class="ltx_text" style="font-size:50%;">75.90</span></td>
<td id="A0.T12.10.1.9.9" class="ltx_td ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.9.9.1" class="ltx_text" style="font-size:50%;">84.51</span></td>
<td id="A0.T12.10.1.9.10" class="ltx_td ltx_align_center" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.9.10.1" class="ltx_text" style="font-size:50%;">74.50</span></td></tr>
<tr id="A0.T12.10.1.10" class="ltx_tr">
<th id="A0.T12.10.1.10.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.1.1" class="ltx_text" style="font-size:50%;">✔</span></th>
<th id="A0.T12.10.1.10.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.2.1" class="ltx_text" style="font-size:50%;">✔</span></th>
<th id="A0.T12.10.1.10.3" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.3.1" class="ltx_text" style="font-size:50%;">✔</span></th>
<th id="A0.T12.10.1.10.4" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.4.1" class="ltx_text" style="font-size:50%;">3.57</span></th>
<td id="A0.T12.10.1.10.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.5.1" class="ltx_text" style="font-size:50%;">85.92</span></td>
<td id="A0.T12.10.1.10.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.6.1" class="ltx_text" style="font-size:50%;">77.25</span></td>
<td id="A0.T12.10.1.10.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.7.1" class="ltx_text" style="font-size:50%;">85.02</span></td>
<td id="A0.T12.10.1.10.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.8.1" class="ltx_text" style="font-size:50%;">75.48</span></td>
<td id="A0.T12.10.1.10.9" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#BFBFBF;padding-top:-1pt;padding-bottom:-1pt;"><span id="A0.T12.10.1.10.9.1" class="ltx_text" style="font-size:50%;--ltx-bg-color:#BFBFBF;">84.72</span></td>
