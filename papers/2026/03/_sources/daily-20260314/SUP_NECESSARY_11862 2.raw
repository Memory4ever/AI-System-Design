<td id="S4.T5.5.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S4.T5.5.1.1.2.1" class="ltx_text ltx_font_bold">Benign <math id="S4.T5.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
