<tr id="S4.T5.5.1.2" class="ltx_tr">
<td id="S4.T5.5.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">Anonymize</td>
<td id="S4.T5.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.9</td>
<td id="S4.T5.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;"><span id="S4.T5.5.1.2.3.1" class="ltx_text ltx_font_bold">1</span></td>
<td id="S4.T5.5.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">0.9</td></tr>
<tr id="S4.T5.5.1.3" class="ltx_tr">
