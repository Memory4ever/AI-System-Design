<span id="S4.T3.5.2.1.1.1" class="ltx_p">Stealth success</span>
</span></td>
<td id="S4.T3.5.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t" style="padding-top:2.5pt;padding-bottom:2.5pt;">
