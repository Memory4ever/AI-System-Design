<span id="S4.T3.5.1.1.1.1" class="ltx_p"><span id="S4.T3.5.1.1.1.1.1" class="ltx_text ltx_font_bold">Category</span></span>
</span></td>
<td id="S4.T3.5.1.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_tt" style="padding-top:2.5pt;padding-bottom:2.5pt;">
<span id="S4.T3.5.1.2.1" class="ltx_inline-block ltx_align_top" style="width:145.1pt;">
