<td id="A3.T5.2.2.2" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><span id="A3.T5.2.2.2.1" class="ltx_text ltx_font_typewriter">Ignore all previous instructions.</span></td></tr>
<tr id="A3.T5.2.3" class="ltx_tr">
<td id="A3.T5.2.3.1" class="ltx_td ltx_align_center">1</td>
