<td id="A1.T7.2.1.4.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;" colspan="15"><span id="A1.T7.2.1.4.1.1" class="ltx_text ltx_font_bold ltx_font_italic">Qwen2.5-1.5B-Instruct</span></td></tr>
<tr id="A1.T7.2.1.5" class="ltx_tr">
<td id="A1.T7.2.1.5.1" class="ltx_td" style="padding-left:2.5pt;padding-right:2.5pt;"></td>
<td id="A1.T7.2.1.5.2" class="ltx_td ltx_align_left" style="padding-left:2.5pt;padding-right:2.5pt;">GT_Funs</td>
<td id="A1.T7.2.1.5.3" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">63.33</td>
<td id="A1.T7.2.1.5.4" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">88.50</td>
<td id="A1.T7.2.1.5.5" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">68.50</td>
<td id="A1.T7.2.1.5.6" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">63.50</td>
<td id="A1.T7.2.1.5.7" class="ltx_td" style="padding-left:2.5pt;padding-right:2.5pt;"></td>
<td id="A1.T7.2.1.5.8" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">65.12</td>
<td id="A1.T7.2.1.5.9" class="ltx_td ltx_align_center" style="padding-left:2.5pt;padding-right:2.5pt;">63.25</td>
