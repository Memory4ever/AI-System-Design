<td id="S4.T1.8.1.5.3" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">70.96</td>
<td id="S4.T1.8.1.5.4" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">62.77</td>
<td id="S4.T1.8.1.5.5" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">66.87</td>
<td id="S4.T1.8.1.5.6" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">47.92</td>
<td id="S4.T1.8.1.5.7" class="ltx_td ltx_align_left" style="padding-left:3.5pt;padding-right:3.5pt;">57.40</td>
<td id="S4.T1.8.1.5.8" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">70.96</td>
<td id="S4.T1.8.1.5.9" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">62.77</td>
<td id="S4.T1.8.1.5.10" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;">66.87</td>
