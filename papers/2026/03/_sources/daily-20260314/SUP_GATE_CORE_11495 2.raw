<td id="S4.T3.4.1.5.5" class="ltx_td ltx_align_center ltx_border_t">44.19</td>
<td id="S4.T3.4.1.5.6" class="ltx_td ltx_align_center ltx_border_t">29.39</td>
<td id="S4.T3.4.1.5.7" class="ltx_td ltx_align_center ltx_border_t">36.79</td></tr>
<tr id="S4.T3.4.1.6" class="ltx_tr">
<td id="S4.T3.4.1.6.1" class="ltx_td ltx_align_left"><span id="S4.T3.4.1.6.1.1" class="ltx_text ltx_font_italic">w/o</span> Check</td>
<td id="S4.T3.4.1.6.2" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T3.4.1.6.3" class="ltx_td ltx_align_center">✗</td>
<td id="S4.T3.4.1.6.4" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T3.4.1.6.5" class="ltx_td ltx_align_center">52.06</td>
<td id="S4.T3.4.1.6.6" class="ltx_td ltx_align_center">52.41</td>
<td id="S4.T3.4.1.6.7" class="ltx_td ltx_align_center">52.24</td></tr>
<tr id="S4.T3.4.1.7" class="ltx_tr">
<td id="S4.T3.4.1.7.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S4.T3.4.1.7.1.1" class="ltx_text ltx_font_italic">w/o</span> Retry</td>
<td id="S4.T3.4.1.7.2" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
<td id="S4.T3.4.1.7.3" class="ltx_td ltx_align_center ltx_border_bb">✓</td>
<td id="S4.T3.4.1.7.4" class="ltx_td ltx_align_center ltx_border_bb">✗</td>
<td id="S4.T3.4.1.7.5" class="ltx_td ltx_align_center ltx_border_bb">7.33</td>
<td id="S4.T3.4.1.7.6" class="ltx_td ltx_align_center ltx_border_bb">3.18</td>
