<td id="S4.T3.4.1.4.5" class="ltx_td ltx_align_center"><span id="S4.T3.4.1.4.5.1" class="ltx_text ltx_font_bold">71.79</span></td>
<td id="S4.T3.4.1.4.6" class="ltx_td ltx_align_center"><span id="S4.T3.4.1.4.6.1" class="ltx_text ltx_font_bold">57.74</span></td>
<td id="S4.T3.4.1.4.7" class="ltx_td ltx_align_center"><span id="S4.T3.4.1.4.7.1" class="ltx_text ltx_font_bold">64.77</span></td></tr>
<tr id="S4.T3.4.1.5" class="ltx_tr">
<td id="S4.T3.4.1.5.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S4.T3.4.1.5.1.1" class="ltx_text ltx_font_italic">w/o</span> Try</td>
<td id="S4.T3.4.1.5.2" class="ltx_td ltx_align_center ltx_border_t">✗</td>
<td id="S4.T3.4.1.5.3" class="ltx_td ltx_align_center ltx_border_t">✓</td>
