<span id="S4.T1.7.1.9.1.2.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><span id="S4.T1.7.1.9.1.2.1.2.1.1" class="ltx_text ltx_font_bold">Capacity<sub id="S4.T1.7.1.9.1.2.1.2.1.1.1" class="ltx_sub">L</sub> &gt; Capacity<sub id="S4.T1.7.1.9.1.2.1.2.1.1.2" class="ltx_sub">G</sub>,  Large <math id="S4.T1.m28" class="ltx_Math" alttext="\rightarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">→</mo><annotation encoding="application/x-tex">\rightarrow</annotation></semantics></math> Small,  <math id="S4.T1.m29" class="ltx_Math" alttext="\bm{\eta_{learner}=1\times 10^{-5}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mrow><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></msub><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mrow><mn>𝟏</mn><mo class="ltx_mathvariant_bold" lspace="0.222em" mathvariant="bold" rspace="0.222em">×</mo><msup><mn>𝟏𝟎</mn><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">−</mo><mn>𝟓</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta_{learner}=1\times 10^{-5}}</annotation></semantics></math> <math id="S4.T1.m30" class="ltx_Math" alttext="\bm{\eta_{guide}=5\times 10^{-6}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>η</mi><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi></mrow></msub><mo class="ltx_mathvariant_bold" mathvariant="bold">=</mo><mrow><mn>𝟓</mn><mo class="ltx_mathvariant_bold" lspace="0.222em" mathvariant="bold" rspace="0.222em">×</mo><msup><mn>𝟏𝟎</mn><mrow><mo class="ltx_mathvariant_bold" mathvariant="bold">−</mo><mn>𝟔</mn></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\bm{\eta_{guide}=5\times 10^{-6}}</annotation></semantics></math></span></span></span>
</span></span><span id="S4.T1.7.1.9.1.3" class="ltx_text"></span></td></tr>
