<th id="S4.T2.6.22.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-top:1.3pt;padding-bottom:1.3pt;"><span id="S4.T2.6.22.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F2F2F2;">Multitask (Oracle)</span></th>
