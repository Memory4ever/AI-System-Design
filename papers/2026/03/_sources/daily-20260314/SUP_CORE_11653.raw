<tr id="S4.T1.6.3" class="ltx_tr">
<th id="S4.T1.6.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:1.3pt;padding-bottom:1.3pt;" colspan="7"><span id="S4.T1.6.3.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">libero-spatial</span></th></tr>
