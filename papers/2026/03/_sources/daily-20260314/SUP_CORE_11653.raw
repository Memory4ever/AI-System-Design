<td id="S4.T2.6.21.5" class="ltx_td ltx_align_center" style="padding-top:1.3pt;padding-bottom:1.3pt;"><span id="S4.T2.6.21.5.1" class="ltx_text" style="font-size:80%;">2.4<math id="S4.T2.m49" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.3</span></td>
