<td id="A7.T7.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A7.T7.5.2.2.1" class="ltx_text" style="font-size:90%;">regularization coefficient <math id="A7.T7.m1" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></span></td>
<td id="A7.T7.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A7.T7.m2" class="ltx_Math" alttext="1\times 10^{6}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">1</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mn mathsize="0.900em">6</mn></msup></mrow><annotation encoding="application/x-tex">1\times 10^{6}</annotation></semantics></math></td></tr>
