<td id="S4.T1.6.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:1.3pt;padding-bottom:1.3pt;" colspan="6"><span id="S4.T1.6.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Metrics (%)</span></td></tr>
<tr id="S4.T1.6.2" class="ltx_tr">
