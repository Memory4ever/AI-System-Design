<td id="S4.T1.6.4.2" class="ltx_td ltx_align_center" style="padding-top:1.3pt;padding-bottom:1.3pt;"><span id="S4.T1.6.4.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-bg-color:#E6E6FF;">81.2<math id="S4.T1.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#E6E6FF;" mathbackground="#E6E6FF">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>0.4</span></td>
