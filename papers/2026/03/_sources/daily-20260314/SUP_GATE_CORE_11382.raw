<td id="S5.T9.6.8.2" class="ltx_td ltx_align_left">0.7889</td>
<td id="S5.T9.6.8.3" class="ltx_td ltx_align_left">0.4249</td></tr>
<tr id="S5.T9.6.9" class="ltx_tr">
