<th id="S5.T9.6.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><math id="S5.T9.m14" class="ltx_Math" alttext="\langle S_{\mathrm{ent}}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><msub><mi>S</mi><mi>ent</mi></msub><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle S_{\mathrm{ent}}\rangle</annotation></semantics></math></th>
