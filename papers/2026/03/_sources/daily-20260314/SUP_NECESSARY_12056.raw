<td id="S3.T1.10.1.7.5" class="ltx_td ltx_align_center"><math id="S3.T1.m12" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td></tr>
<tr id="S3.T1.10.1.8" class="ltx_tr">
<th id="S3.T1.10.1.8.1" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_t" style="--ltx-bg-color:#E6E6E6;" colspan="5"><span id="S3.T1.10.1.8.1.1" class="ltx_text ltx_font_italic" style="font-size:80%;--ltx-bg-color:#E6E6E6;">Comprehensive</span></th></tr>
<tr id="S3.T1.10.1.9" class="ltx_tr">
<th id="S3.T1.10.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S3.T1.10.1.9.1.1" class="ltx_text" style="font-size:80%;">AgentVista</span></th>
<td id="S3.T1.10.1.9.2" class="ltx_td ltx_align_center ltx_border_bb"><math id="S3.T1.m13" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
