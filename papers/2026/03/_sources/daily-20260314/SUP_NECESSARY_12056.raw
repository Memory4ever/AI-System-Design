<td id="A1.T5.4.14.6" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:2.5pt;padding-right:2.5pt;"><span id="A1.T5.4.14.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#E6E6E6;">24.17</span></td>
<td id="A1.T5.4.14.7" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#E6E6E6;padding-left:2.5pt;padding-right:2.5pt;"><span id="A1.T5.4.14.7.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#E6E6E6;">4.18</span></td></tr>
