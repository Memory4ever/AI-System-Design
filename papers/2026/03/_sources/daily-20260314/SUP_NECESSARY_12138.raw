<span id="A2.T6.7.1.2.1" class="ltx_inline-block ltx_align_top" style="--ltx-bg-color:#D9D9D9;">
<span id="A2.T6.7.1.2.1.1" class="ltx_p ltx_align_center"><span id="A2.T6.7.1.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Category</span></span>
</span></th>
<th id="A2.T6.7.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_th_row ltx_border_tt" style="padding:0.45pt 4.0pt;">
<span id="A2.T6.7.1.3.1" class="ltx_inline-block ltx_align_top" style="--ltx-bg-color:#D9D9D9;">
<span id="A2.T6.7.1.3.1.1" class="ltx_p ltx_align_center"><span id="A2.T6.7.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Application</span></span>
</span></th>
