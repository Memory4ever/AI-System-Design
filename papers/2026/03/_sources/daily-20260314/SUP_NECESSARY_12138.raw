<span id="A2.T7.7.4.1.1.1" class="ltx_p ltx_align_center"><span id="A2.T7.7.4.1.1.1.1" class="ltx_text" style="font-size:80%;">Qwen2-VL-7B</span></span>
</span></td>
<td id="A2.T7.7.4.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;">
<span id="A2.T7.7.4.2.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T7.7.4.2.1.1" class="ltx_p ltx_align_center"><span id="A2.T7.7.4.2.1.1.1" class="ltx_text" style="font-size:80%;">2e-6</span></span>
</span></td>
<td id="A2.T7.7.4.3" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;">
<span id="A2.T7.7.4.3.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T7.7.4.3.1.1" class="ltx_p ltx_align_center"><span id="A2.T7.7.4.3.1.1.1" class="ltx_text" style="font-size:80%;">128</span></span>
</span></td>
<td id="A2.T7.7.4.4" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;">
<span id="A2.T7.7.4.4.1" class="ltx_inline-block ltx_align_top">
<span id="A2.T7.7.4.4.1.1" class="ltx_p ltx_align_center"><span id="A2.T7.7.4.4.1.1.1" class="ltx_text" style="font-size:80%;">15</span></span>
</span></td></tr>
</tbody>
