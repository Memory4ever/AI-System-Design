<span id="A2.T7.7.3.4.1.1" class="ltx_p ltx_align_center"><span id="A2.T7.7.3.4.1.1.1" class="ltx_text" style="font-size:80%;">15</span></span>
</span></td></tr>
<tr id="A2.T7.7.4" class="ltx_tr">
