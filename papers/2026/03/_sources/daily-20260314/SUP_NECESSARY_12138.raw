</span></td></tr>
<tr id="S3.T1.8.18" class="ltx_tr">
<th id="S3.T1.8.18.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S3.T1.8.18.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;--ltx-bg-color:#E6F3FF;">HATS</span></th>
<td id="S3.T1.8.18.2" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">
