<td id="S4.T1.13.1.2.12" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.12.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Proj.</span></td>
<td id="S4.T1.13.1.2.13" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.13.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Part.</span></td></tr>
<tr id="S4.T1.13.1.3" class="ltx_tr" style="--ltx-bg-color:#EEF6FF;">
<td id="S4.T1.13.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:1.4pt 5.0pt;" colspan="15"><span id="S4.T1.13.1.3.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;">Closed-source MLLMs</span></td></tr>
<tr id="S4.T1.13.1.4" class="ltx_tr">
<td id="S4.T1.13.1.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.1.1" class="ltx_text" style="font-size:90%;">GPT-4o-mini </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T1.13.1.4.1.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib37" title="" class="ltx_ref">24</a><span id="S4.T1.13.1.4.1.3" class="ltx_text" style="font-size:90%;">]</span></cite></td>
<td id="S4.T1.13.1.4.2" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.2.1" class="ltx_text" style="font-size:90%;">–</span></td>
<td id="S4.T1.13.1.4.3" class="ltx_td ltx_align_center ltx_border_r" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.3.1" class="ltx_text" style="font-size:90%;">12.2</span></td>
<td id="S4.T1.13.1.4.4" class="ltx_td ltx_align_center" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.4.1" class="ltx_text" style="font-size:90%;">14.3</span></td>
<td id="S4.T1.13.1.4.5" class="ltx_td ltx_align_center" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.5.1" class="ltx_text" style="font-size:90%;">13.9</span></td>
<td id="S4.T1.13.1.4.6" class="ltx_td ltx_align_center" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.4.6.1" class="ltx_text" style="font-size:90%;">12.4</span></td>
