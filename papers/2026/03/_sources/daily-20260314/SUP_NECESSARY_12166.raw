<td id="S4.T1.13.1.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Spat.</span></td>
<td id="S4.T1.13.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Analy.</span></td>
<td id="S4.T1.13.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Angle</span></td>
<td id="S4.T1.13.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Circ.</span></td>
<td id="S4.T1.13.1.2.9" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.9.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Conn.</span></td>
<td id="S4.T1.13.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.10.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Trans.</span></td>
