<td id="S4.T1.13.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Anal.</span></td>
<td id="S4.T1.13.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:1.4pt 5.0pt;"><span id="S4.T1.13.1.2.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Eucl.</span></td>
