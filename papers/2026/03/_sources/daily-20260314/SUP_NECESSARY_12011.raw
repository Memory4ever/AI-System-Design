<td id="A4.T6.5.27.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A4.T6.m126" class="ltx_Math" alttext="13.60" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">13.60</mn><annotation encoding="application/x-tex">13.60</annotation></semantics></math></td>
