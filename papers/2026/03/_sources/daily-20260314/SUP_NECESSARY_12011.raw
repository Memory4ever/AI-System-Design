<td id="A4.T6.5.25.5" class="ltx_td ltx_align_center"><math id="A4.T6.m118" class="ltx_Math" alttext="40.63" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">40.63</mn><annotation encoding="application/x-tex">40.63</annotation></semantics></math></td>
<td id="A4.T6.5.25.6" class="ltx_td ltx_align_center"><math id="A4.T6.m119" class="ltx_Math" alttext="24.06" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">24.06</mn><annotation encoding="application/x-tex">24.06</annotation></semantics></math></td>
<td id="A4.T6.5.25.7" class="ltx_td ltx_align_center"><math id="A4.T6.m120" class="ltx_Math" alttext="89.37" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">89.37</mn><annotation encoding="application/x-tex">89.37</annotation></semantics></math></td></tr>
