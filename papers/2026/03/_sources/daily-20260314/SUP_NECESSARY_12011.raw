<td id="A4.T6.5.26.1" class="ltx_td"></td>
<td id="A4.T6.5.26.2" class="ltx_td ltx_align_left"><span id="A4.T6.5.26.2.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">+ TextCraft</span></td>
<td id="A4.T6.5.26.3" class="ltx_td ltx_align_center"><math id="A4.T6.m121" class="ltx_Math" alttext="17.95" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">17.95</mn><annotation encoding="application/x-tex">17.95</annotation></semantics></math></td>
<td id="A4.T6.5.26.4" class="ltx_td ltx_align_center"><math id="A4.T6.m122" class="ltx_Math" alttext="33.37" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">33.37</mn><annotation encoding="application/x-tex">33.37</annotation></semantics></math></td>
<td id="A4.T6.5.26.5" class="ltx_td ltx_align_center"><math id="A4.T6.m123" class="ltx_Math" alttext="86.00" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">86.00</mn><annotation encoding="application/x-tex">86.00</annotation></semantics></math></td>
<td id="A4.T6.5.26.6" class="ltx_td ltx_align_center"><math id="A4.T6.m124" class="ltx_Math" alttext="29.31" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">29.31</mn><annotation encoding="application/x-tex">29.31</annotation></semantics></math></td>
<td id="A4.T6.5.26.7" class="ltx_td ltx_align_center"><math id="A4.T6.m125" class="ltx_Math" alttext="88.60" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">88.60</mn><annotation encoding="application/x-tex">88.60</annotation></semantics></math></td></tr>
