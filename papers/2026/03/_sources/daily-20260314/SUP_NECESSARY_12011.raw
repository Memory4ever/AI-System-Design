<td id="A2.T5.5.6.3" class="ltx_td ltx_align_right"><math id="A2.T5.m20" class="ltx_Math" alttext="1153" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">1153</mn><annotation encoding="application/x-tex">1153</annotation></semantics></math></td>
