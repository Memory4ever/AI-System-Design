<td id="S4.T2.5.1.4.16" class="ltx_td ltx_align_right" style="--ltx-bg-color:#F2F2F2;"><math id="S4.T2.m15" class="ltx_Math" style="--ltx-bg-color:#F2F2F2;" alttext="61.6" display="inline" intent=":literal"><semantics><mn style="--ltx-bg-color:#F2F2F2;" mathbackground="#F2F2F2">61.6</mn><annotation encoding="application/x-tex">61.6</annotation></semantics></math></td></tr>
