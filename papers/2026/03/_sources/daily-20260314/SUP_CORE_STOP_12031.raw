<td id="S5.T4.5.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.2pt 2.5pt;"><span id="S5.T4.5.2.2.1" class="ltx_text" style="font-size:80%;">0–30</span></td>
