</figure>
<figure id="S5.T4" class="ltx_table">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_table"><span id="S5.T4.3" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="S5.T4.4" class="ltx_text" style="font-size:90%;">Experimental protocol for Scenario 2: volatile churn and fault injection test</span></figcaption>
<table id="S5.T4.5" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="S5.T4.5.1" class="ltx_tr">
<th id="S5.T4.5.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.2pt 2.5pt;"><span id="S5.T4.5.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Ph.</span></th>
<th id="S5.T4.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.2pt 2.5pt;"><span id="S5.T4.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Time</span></th>
<th id="S5.T4.5.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.2pt 2.5pt;">
<span id="S5.T4.5.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T4.5.1.3.1.1" class="ltx_p ltx_align_left"><span id="S5.T4.5.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Workload</span></span>
</span></th>
<th id="S5.T4.5.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding:0.2pt 2.5pt;">
<span id="S5.T4.5.1.4.1" class="ltx_inline-block ltx_align_top">
