<span id="A9.T18.7.1.1.1.7.3.1" class="ltx_inline-block ltx_align_top">
<span id="A9.T18.7.1.1.1.7.3.1.1" class="ltx_p">Knowledge Graph (Entities), Document Structure Graph (DOM)</span>
</span></span></span>
<span id="A9.T18.7.1.1.1.8" class="ltx_tr">
<span id="A9.T18.7.1.1.1.8.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;"><span id="A9.T18.7.1.1.1.8.1.1" class="ltx_text ltx_font_bold">3. Retrieval</span></span>
<span id="A9.T18.7.1.1.1.8.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;">Indexing</span>
<span id="A9.T18.7.1.1.1.8.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t" style="padding-top:0.85pt;padding-bottom:0.85pt;">
<span id="A9.T18.7.1.1.1.8.3.1" class="ltx_inline-block ltx_align_top">
