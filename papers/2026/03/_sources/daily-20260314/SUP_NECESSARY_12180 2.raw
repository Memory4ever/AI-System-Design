<td id="S3.T3.9.1.6" class="ltx_td ltx_align_center ltx_border_tt" style="padding-bottom: 2.0pt;padding:0.45pt 7.0pt;"><span id="S3.T3.9.1.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Doc F1</span></td>
<td id="S3.T3.9.1.7" class="ltx_td ltx_align_center ltx_border_tt" style="padding-bottom: 2.0pt;padding:0.45pt 7.0pt;"><span id="S3.T3.9.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Kuiper<span id="S3.T3.9.1.7.1.1" class="ltx_text ltx_font_medium"> <math id="S3.T3.m7" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></span></td></tr>
<tr id="S3.T3.9.2" class="ltx_tr">
<td id="S3.T3.9.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-bottom: 2.0pt;padding:0.45pt 7.0pt;" colspan="7"><span id="S3.T3.9.2.1.1" class="ltx_text ltx_font_bold ltx_font_italic" style="font-size:90%;">Non-Agentic Systems</span></td></tr>
<tr id="S3.T3.9.3" class="ltx_tr">
<td id="S3.T3.9.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.1.1" class="ltx_text" style="font-size:90%;">Gemini 3 Pro <sub id="S3.T3.9.3.1.1.1" class="ltx_sub">File Search</sub></span></td>
<td id="S3.T3.9.3.2" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#84C6EB;padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#84C6EB;"><span id="S3.T3.9.3.2.1.1" class="ltx_text ltx_font_bold">78.6 <math id="S3.T3.m8" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#84C6EB;" mathbackground="#84C6EB" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.3.2.1.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 2.2</span></span></span></td>
<td id="S3.T3.9.3.3" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#86C7EB;padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#86C7EB;"><span id="S3.T3.9.3.3.1.1" class="ltx_text ltx_font_bold">74.1 <math id="S3.T3.m9" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#86C7EB;" mathbackground="#86C7EB" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.3.3.1.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 3.6</span></span></span></td>
<td id="S3.T3.9.3.4" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#83C6EA;padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#83C6EA;"><span id="S3.T3.9.3.4.1.1" class="ltx_text ltx_font_bold">75.0 <math id="S3.T3.m10" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#83C6EA;" mathbackground="#83C6EA" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.3.4.1.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 3.6</span></span></span></td>
<td id="S3.T3.9.3.5" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#82C6EA;padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#82C6EA;"><span id="S3.T3.9.3.5.1.1" class="ltx_text ltx_font_bold">70.1 <math id="S3.T3.m11" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#82C6EA;" mathbackground="#82C6EA" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.3.5.1.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 2.0</span></span></span></td>
<td id="S3.T3.9.3.6" class="ltx_td ltx_align_center ltx_border_t" style="--ltx-bg-color:#5FB5E5;padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.6.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#5FB5E5;"><span id="S3.T3.9.3.6.1.1" class="ltx_text ltx_font_bold">94.2 <math id="S3.T3.m12" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#5FB5E5;" mathbackground="#5FB5E5" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.3.6.1.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 1.0</span></span></span></td>
<td id="S3.T3.9.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 7.0pt;"><span id="S3.T3.9.3.7.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
<tr id="S3.T3.9.4" class="ltx_tr">
<td id="S3.T3.9.4.1" class="ltx_td ltx_align_left" style="padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.1.1" class="ltx_text" style="font-size:90%;">Gemini 2.5 Flash <sub id="S3.T3.9.4.1.1.1" class="ltx_sub">File Search</sub></span></td>
<td id="S3.T3.9.4.2" class="ltx_td ltx_align_center" style="--ltx-bg-color:#92CDED;padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#92CDED;">71.8 <math id="S3.T3.m13" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#92CDED;" mathbackground="#92CDED" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.4.2.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 2.4</span></span></td>
<td id="S3.T3.9.4.3" class="ltx_td ltx_align_center" style="--ltx-bg-color:#9DD2EF;padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.3.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#9DD2EF;">61.3 <math id="S3.T3.m14" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#9DD2EF;" mathbackground="#9DD2EF" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.4.3.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 4.1</span></span></td>
<td id="S3.T3.9.4.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#87C8EB;padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.4.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#87C8EB;">73.0 <math id="S3.T3.m15" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#87C8EB;" mathbackground="#87C8EB" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.4.4.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 3.7</span></span></td>
<td id="S3.T3.9.4.5" class="ltx_td ltx_align_center" style="--ltx-bg-color:#AAD8F1;padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.5.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#AAD8F1;">52.2 <math id="S3.T3.m16" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#AAD8F1;" mathbackground="#AAD8F1" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.4.5.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 2.2</span></span></td>
<td id="S3.T3.9.4.6" class="ltx_td ltx_align_center" style="--ltx-bg-color:#7AC2E9;padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.6.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#7AC2E9;">80.9 <math id="S3.T3.m17" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#1F4463;--ltx-bg-color:#7AC2E9;" mathbackground="#7AC2E9" mathcolor="#1F4463" mathsize="0.780em">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math><span id="S3.T3.9.4.6.1.1" class="ltx_text" style="font-size:78%;--ltx-fg-color:#1F4463;"> 1.8</span></span></td>
<td id="S3.T3.9.4.7" class="ltx_td ltx_align_center" style="padding:0.45pt 7.0pt;"><span id="S3.T3.9.4.7.1" class="ltx_text" style="font-size:90%;">–</span></td></tr>
