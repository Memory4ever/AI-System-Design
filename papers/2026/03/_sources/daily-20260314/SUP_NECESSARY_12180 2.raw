<td id="A4.T7.7.17.1" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T7.7.17.1.1" class="ltx_text" style="font-size:80%;">16</span></td>
<td id="A4.T7.7.17.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T7.7.17.2.1" class="ltx_text" style="font-size:80%;">Alibaba</span></td>
<td id="A4.T7.7.17.3" class="ltx_td ltx_align_left ltx_border_bb"><span id="A4.T7.7.17.3.1" class="ltx_text" style="font-size:80%;">Qwen3-VL-32B Instruct</span></td>
