{"data":{"id":"10.48550/arxiv.2603.11351","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.11351","prefix":"10.48550","suffix":"arxiv.2603.11351","identifiers":[{"identifier":"2603.11351","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.11351"}],"creators":[{"name":"Lu, Hong","nameType":"Personal","givenName":"Hong","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Lorang, Pierrick","nameType":"Personal","givenName":"Pierrick","familyName":"Lorang","affiliation":[],"nameIdentifiers":[]},{"name":"Duggan, Timothy R.","nameType":"Personal","givenName":"Timothy R.","familyName":"Duggan","affiliation":[],"nameIdentifiers":[]},{"name":"Sinapov, Jivko","nameType":"Personal","givenName":"Jivko","familyName":"Sinapov","affiliation":[],"nameIdentifiers":[]},{"name":"Scheutz, Matthias","nameType":"Personal","givenName":"Matthias","familyName":"Scheutz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Novelty Adaptation Through Hybrid Large Language Model (LLM)-Symbolic Planning and LLM-guided Reinforcement Learning"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-11T22:38:05Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:12:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-23T19:56:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-25T00:10:32Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-02T06:30:34Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-05T00:35:23Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"In dynamic open-world environments, autonomous agents often encounter novelties that hinder their ability to find plans to achieve their goals. Specifically, traditional symbolic planners fail to generate plans when the robot's planning domain lacks the operators that enable it to interact appropriately with novel objects in the environment. We propose a neuro-symbolic architecture that integrates symbolic planning, reinforcement learning, and a large language model (LLM) to learn how to handle novel objects. In particular, we leverage the common sense reasoning capability of the LLM to identify missing operators, generate plans with the symbolic AI planner, and write reward functions to guide the reinforcement learning agent in learning control policies for newly identified operators. Our method outperforms the state-of-the-art methods in operator discovery as well as operator learning in continuous robotic domains.Our webpage and code can be access here: https://helenlu66.github.io/hybridLLMguided/","descriptionType":"Abstract"},{"description":"Accepted at IEEE/RSJ International Conference on Intelligent Robots \u0026amp; Systems (IROS) 2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.11351","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-13T01:53:30.000Z","registered":"2026-03-13T01:53:31.000Z","published":"2026","updated":"2026-10-05T02:45:05.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.11351","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}