{"data":{"id":"10.48550/arxiv.2603.11287","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.11287","prefix":"10.48550","suffix":"arxiv.2603.11287","identifiers":[{"identifier":"2603.11287","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.11287"}],"creators":[{"name":"Fu, Weimin","nameType":"Personal","givenName":"Weimin","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Zeng","nameType":"Personal","givenName":"Zeng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Shao, Minghao","nameType":"Personal","givenName":"Minghao","familyName":"Shao","affiliation":[],"nameIdentifiers":[]},{"name":"Karri, Ramesh","nameType":"Personal","givenName":"Ramesh","familyName":"Karri","affiliation":[],"nameIdentifiers":[]},{"name":"Shafique, Muhammad","nameType":"Personal","givenName":"Muhammad","familyName":"Shafique","affiliation":[],"nameIdentifiers":[]},{"name":"Knechtel, Johann","nameType":"Personal","givenName":"Johann","familyName":"Knechtel","affiliation":[],"nameIdentifiers":[]},{"name":"Sinanoglu, Ozgur","nameType":"Personal","givenName":"Ozgur","familyName":"Sinanoglu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Xiaolong","nameType":"Personal","givenName":"Xiaolong","familyName":"Guo","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Synthesis-in-the-Loop Evaluation of LLMs for RTL Generation: Quality, Reliability, and Failure Modes"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Hardware Architecture (cs.AR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"B.6.3; D.2.5","subjectScheme":"ACM"}],"contributors":[],"dates":[{"date":"2026-03-11T20:26:58Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:08:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-10T03:42:23Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:04:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1145/3787109.3815245","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"RTL generation is more than code synthesis. Designs must be syntactically valid, synthesizable, correct, hardware-efficient. SOTA evaluations stop at functional correctness and do not measure synthesis and implementation quality. This paper evaluates 32 language models on 202 Verilog tasks from VerilogEval and RTLLM using the Hardware Quality Index (HQI) that combines post-synthesis area, delay, and warnings related to expert references in a Nangate45 45\\,nm flow. Three performance regimes emerge: 14 frontier models achieve HQI $\u0026gt;$ 66, led by Gemini-3-Pro at 87.5\\% coverage and 85.1 HQI; 15 models cluster 43--66 HQI; 3 are below 43. Gap between best-of-five capability and single-attempt quality spans 3.7--22.1 HQI points, limiting integration into agentic pipelines. A taxonomy of 195 synthesis failures reveals systematic divergence: proprietary models fail late through elaboration errors and synthesis timeout; open models fail early often due to missing module wrappers and non-synthesizable constructs, a pattern consistent with training corpora skewed toward simulation over synthesis-grade RTL.","descriptionType":"Abstract"},{"description":"8 pages, 8 figures","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.11287","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-03-13T01:52:02.000Z","registered":"2026-03-13T01:52:03.000Z","published":"2026","updated":"2026-05-12T05:14:08.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.11287","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[{"id":"10.1145/3787109.3815245","type":"dois"}]}}}}