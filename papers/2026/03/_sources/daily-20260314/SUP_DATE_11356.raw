{"data":{"id":"10.48550/arxiv.2603.11356","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.11356","prefix":"10.48550","suffix":"arxiv.2603.11356","identifiers":[{"identifier":"2603.11356","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.11356"}],"creators":[{"name":"Ganhotra, Jatin","nameType":"Personal","givenName":"Jatin","familyName":"Ganhotra","affiliation":[],"nameIdentifiers":[]},{"name":"Serhan, Sami","nameType":"Personal","givenName":"Sami","familyName":"Serhan","affiliation":[],"nameIdentifiers":[]},{"name":"Nassar, Antonio Abu","nameType":"Personal","givenName":"Antonio Abu","familyName":"Nassar","affiliation":[],"nameIdentifiers":[]},{"name":"Shinnar, Avraham","nameType":"Personal","givenName":"Avraham","familyName":"Shinnar","affiliation":[],"nameIdentifiers":[]},{"name":"Nevo, Ziv","nameType":"Personal","givenName":"Ziv","familyName":"Nevo","affiliation":[],"nameIdentifiers":[]},{"name":"Hirzel, Martin","nameType":"Personal","givenName":"Martin","familyName":"Hirzel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Resolving Java Code Repository Issues with iSWE Agent"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-11T22:43:55Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:12:50Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Resolving issues on code repositories is an important part of software engineering. Various recent systems automatically resolve issues using large language models and agents, often with impressive performance. Unfortunately, most of these models and agents focus primarily on Python, and their performance on other programming languages is lower. In particular, a lot of enterprise software is written in Java, yet automated issue resolution for Java is under-explored. This paper introduces iSWE Agent, an automated issue resolver with an emphasis on Java. It consists of two sub-agents, one for localization and the other for editing. Both have access to novel tools based on rule-based Java static analysis and transformation. Using this approach, iSWE achieves state-of-the-art issue resolution rates across the Java splits of both Multi-SWE-bench and SWE-PolyBench. More generally, we hope that by combining the best of rule-based and model-based techniques, this paper contributes towards improving enterprise software development.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.11356","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-13T01:53:37.000Z","registered":"2026-03-13T01:53:38.000Z","published":"2026","updated":"2026-03-13T01:53:38.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.11356","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}