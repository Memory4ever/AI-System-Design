<span id="A2.F25.pic1.1.21" class="ltx_p"><span id="A2.F25.pic1.1.21.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">— end all interactions!</span></span>
<span id="A2.F25.pic1.1.22" class="ltx_p"><span id="A2.F25.pic1.1.22.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">— end!</span></span>
<span id="A2.F25.pic1.1.23" class="ltx_p"><span id="A2.F25.pic1.1.23.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">END OF SESSION</span></span>
<span id="A2.F25.pic1.1.24" class="ltx_p"><span id="A2.F25.pic1.1.24.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">END</span></span>
<span id="A2.F25.pic1.1.25" class="ltx_p"><span id="A2.F25.pic1.1.25.1" class="ltx_text" style="font-size:80%;--ltx-fg-color:#000000;">— THE END!</span></span>
