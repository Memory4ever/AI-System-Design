<td id="A1.T10.8.28.2" class="ltx_td ltx_align_left"><span id="A1.T10.8.28.2.1" class="ltx_text" style="font-size:90%;">Athene-V2-Chat</span></td>
<td id="A1.T10.8.28.3" class="ltx_td ltx_align_right"><span id="A1.T10.8.28.3.1" class="ltx_text" style="font-size:90%;">14.6</span></td>
<td id="A1.T10.8.28.4" class="ltx_td ltx_align_center"><span id="A1.T10.8.28.4.1" class="ltx_text" style="font-size:90%;">(-1.1 / +1.3)</span></td></tr>
<tr id="A1.T10.8.29" class="ltx_tr">
<td id="A1.T10.8.29.1" class="ltx_td ltx_align_right"><span id="A1.T10.8.29.1.1" class="ltx_text" style="font-size:90%;">28</span></td>
<td id="A1.T10.8.29.2" class="ltx_td ltx_align_left"><span id="A1.T10.8.29.2.1" class="ltx_text" style="font-size:90%;">llama4-maverick-instruct-basic</span></td>
<td id="A1.T10.8.29.3" class="ltx_td ltx_align_right"><span id="A1.T10.8.29.3.1" class="ltx_text" style="font-size:90%;">12.5</span></td>
<td id="A1.T10.8.29.4" class="ltx_td ltx_align_center"><span id="A1.T10.8.29.4.1" class="ltx_text" style="font-size:90%;">(-1.1 / +1.6)</span></td></tr>
