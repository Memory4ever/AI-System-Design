<td id="A1.T10.8.30.1" class="ltx_td ltx_align_right"><span id="A1.T10.8.30.1.1" class="ltx_text" style="font-size:90%;">29</span></td>
<td id="A1.T10.8.30.2" class="ltx_td ltx_align_left"><span id="A1.T10.8.30.2.1" class="ltx_text" style="font-size:90%;">Qwen2.5-72B-Instruct</span></td>
<td id="A1.T10.8.30.3" class="ltx_td ltx_align_right"><span id="A1.T10.8.30.3.1" class="ltx_text" style="font-size:90%;">8.9</span></td>
