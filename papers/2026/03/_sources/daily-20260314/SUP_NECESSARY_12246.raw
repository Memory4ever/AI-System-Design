<td id="A1.T10.8.31.2" class="ltx_td ltx_align_left ltx_border_bb"><span id="A1.T10.8.31.2.1" class="ltx_text" style="font-size:90%;">Llama-3.1-Nemotron-70B-Instruct-HF</span></td>
<td id="A1.T10.8.31.3" class="ltx_td ltx_align_right ltx_border_bb"><span id="A1.T10.8.31.3.1" class="ltx_text" style="font-size:90%;">8.7</span></td>
