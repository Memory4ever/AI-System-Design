<td id="A6.T4.2.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.0008</td>
<td id="A6.T4.2.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">0.04%</td></tr>
<tr id="A6.T4.2.3" class="ltx_tr">
<td id="A6.T4.2.3.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">Formatting-only edits</td>
