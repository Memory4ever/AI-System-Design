</div>
<div id="lstnumberx4" class="ltx_listingline">
                    <span class="ltx_tag ltx_tag_listingline">4</span>
                    
                    
                    
                  <span id="lstnumberx4.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx4.3" class="ltx_text ltx_font_typewriter">Returns</span><span id="lstnumberx4.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.5" class="ltx_text ltx_font_typewriter">a</span><span id="lstnumberx4.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.7" class="ltx_text ltx_font_typewriter">list</span><span id="lstnumberx4.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.9" class="ltx_text ltx_font_typewriter">in</span><span id="lstnumberx4.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.11" class="ltx_text ltx_font_typewriter">the</span><span id="lstnumberx4.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.13" class="ltx_text ltx_font_typewriter">order</span><span id="lstnumberx4.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.15" class="ltx_text ltx_font_typewriter">[Bread,</span><span id="lstnumberx4.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.17" class="ltx_text ltx_font_typewriter">Sausage,</span><span id="lstnumberx4.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx4.19" class="ltx_text ltx_font_typewriter">Cheese].</span>
</div>
<div id="lstnumberx5" class="ltx_listingline">
