</div>
<div id="lstnumberx10" class="ltx_listingline">
                    <span class="ltx_tag ltx_tag_listingline">10</span>
                    
                    
                    
                  <span id="lstnumberx10.2" class="ltx_text ltx_lst_space ltx_font_typewriter">    </span><span id="lstnumberx10.3" class="ltx_text ltx_font_typewriter">Calculates</span><span id="lstnumberx10.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.5" class="ltx_text ltx_font_typewriter">the</span><span id="lstnumberx10.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.7" class="ltx_text ltx_font_typewriter">maximum</span><span id="lstnumberx10.8" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.9" class="ltx_text ltx_font_typewriter">number</span><span id="lstnumberx10.10" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.11" class="ltx_text ltx_font_typewriter">of</span><span id="lstnumberx10.12" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.13" class="ltx_text ltx_font_typewriter">hamburgers</span><span id="lstnumberx10.14" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.15" class="ltx_text ltx_font_typewriter">that</span><span id="lstnumberx10.16" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.17" class="ltx_text ltx_font_typewriter">can</span><span id="lstnumberx10.18" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.19" class="ltx_text ltx_font_typewriter">be</span><span id="lstnumberx10.20" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx10.21" class="ltx_text ltx_font_typewriter">made</span>
