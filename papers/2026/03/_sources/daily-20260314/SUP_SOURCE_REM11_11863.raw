               <math id="alg2.l18.m1" class="ltx_Math" alttext="\text{Feedback}\leftarrow\text{generate\_feedback}(v_{exec},v_{const})" display="inline" intent=":literal"><semantics><mrow><mtext>Feedback</mtext><mo stretchy="false">←</mo><mrow><mtext>generate_feedback</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>c</mi></mrow></msub><mo>,</mo><msub><mi>v</mi><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{Feedback}\leftarrow\text{generate\_feedback}(v_{exec},v_{const})</annotation></semantics></math>

</div>
