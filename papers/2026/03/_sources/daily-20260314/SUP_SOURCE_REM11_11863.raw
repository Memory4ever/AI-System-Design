</span></span></span></span>
<span id="A12.T19.2.2.1.1.22" class="ltx_p" style="width:327.8pt;"><span id="A12.T19.2.2.1.1.22.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="width:327.8pt;"><span id="A12.T19.2.2.1.1.22.1.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A12.T19.2.2.1.1.22.1.2" class="ltx_text ltx_inline-block" style="width:0.0pt;"> </span><span id="A12.T19.2.2.1.1.22.1.3" class="ltx_text ltx_inline-block" style="width:21.0pt;"> </span><span id="A12.T19.2.2.1.1.22.1.4" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:306.8pt;">
<span id="A12.T19.p22" class="ltx_para ltx_noindent">
