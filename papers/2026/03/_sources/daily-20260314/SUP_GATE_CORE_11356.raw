          <span id="lstnumberx18.2" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">System.out.println(brokerStatsManager.getStatsItem(TOPIC_PUT_NUMS,"topicTest").getValue());</span>
</div>
<div id="lstnumberx19" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">19</span>
            
            
            
            
            
            
            
