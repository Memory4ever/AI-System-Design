          <span id="lstnumberx12.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">    </span><span id="lstnumberx12.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">public</span><span id="lstnumberx12.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;"> </span><span id="lstnumberx12.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">void</span><span id="lstnumberx12.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;"> </span><span id="lstnumberx12.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">run()</span><span id="lstnumberx12.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;"> </span><span id="lstnumberx12.9" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">{</span>
</div>
<div id="lstnumberx13" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">13</span>
            
            
            
            
            
            
            
          <span id="lstnumberx13.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">      </span><span id="lstnumberx13.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">brokerStatsManager.incTopicPutNums("topicTest",</span><span id="lstnumberx13.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;"> </span><span id="lstnumberx13.5" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">2,</span><span id="lstnumberx13.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;"> </span><span id="lstnumberx13.7" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">1);</span>
</div>
<div id="lstnumberx14" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">14</span>
            
            
            
            
            
            
            
          <span id="lstnumberx14.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">    </span><span id="lstnumberx14.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">}</span>
</div>
<div id="lstnumberx15" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline">15</span>
            
            
            
            
            
            
            
          <span id="lstnumberx15.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">  </span><span id="lstnumberx15.3" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#0070C0;">});</span>
</div>
