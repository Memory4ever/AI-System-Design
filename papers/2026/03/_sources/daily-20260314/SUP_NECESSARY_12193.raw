<div id="lstnumberx28" class="ltx_listingline"><span id="lstnumberx28.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">3.</span><span id="lstnumberx28.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx28.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Replacing</span><span id="lstnumberx28.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx28.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">core</span><span id="lstnumberx28.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx28.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">referents</span><span id="lstnumberx28.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx28.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">with</span><span id="lstnumberx28.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx28.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">synonyms</span><span id="lstnumberx28.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
</div>
