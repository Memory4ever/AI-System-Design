</div>
<div id="lstnumberx30" class="ltx_listingline"><span id="lstnumberx30.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">5.</span><span id="lstnumberx30.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Switching</span><span id="lstnumberx30.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">to</span><span id="lstnumberx30.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">non</span><span id="lstnumberx30.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">-</span><span id="lstnumberx30.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">imperative</span><span id="lstnumberx30.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">forms</span><span id="lstnumberx30.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span><span id="lstnumberx30.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">e</span><span id="lstnumberx30.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx30.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">g</span><span id="lstnumberx30.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.,</span><span id="lstnumberx30.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"</span><span id="lstnumberx30.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">You</span><span id="lstnumberx30.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">should</span><span id="lstnumberx30.23" class="ltx_text ltx_font_typewriter" style="font-size:80%;">...",</span><span id="lstnumberx30.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.25" class="ltx_text ltx_font_typewriter" style="font-size:80%;">"</span><span id="lstnumberx30.26" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">It</span><span id="lstnumberx30.27" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.28" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">is</span><span id="lstnumberx30.29" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.30" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">necessary</span><span id="lstnumberx30.31" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx30.32" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">to</span><span id="lstnumberx30.33" class="ltx_text ltx_font_typewriter" style="font-size:80%;">...").</span>
</div>
<div id="lstnumberx31" class="ltx_listingline"><span id="lstnumberx31.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">6.</span><span id="lstnumberx31.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Adding</span><span id="lstnumberx31.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">unrelated</span><span id="lstnumberx31.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">task</span><span id="lstnumberx31.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx31.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">steps</span><span id="lstnumberx31.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
</div>
<div id="lstnumberx32" class="ltx_listingline">
</div>
<div id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Task</span><span id="lstnumberx33.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span>
</div>
<div id="lstnumberx34" class="ltx_listingline"><span id="lstnumberx34.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Original</span><span id="lstnumberx34.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx34.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">instruction</span><span id="lstnumberx34.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;">:</span><span id="lstnumberx34.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx34.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">{</span><span id="lstnumberx34.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">INSTRUCTION</span><span id="lstnumberx34.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">}</span>
</div>
<div id="lstnumberx35" class="ltx_listingline">
</div>
<div id="lstnumberx36" class="ltx_listingline"><span id="lstnumberx36.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">Provide</span><span id="lstnumberx36.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx36.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">only</span><span id="lstnumberx36.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx36.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">the</span><span id="lstnumberx36.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx36.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">rewritten</span><span id="lstnumberx36.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;"> </span><span id="lstnumberx36.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">instruction</span><span id="lstnumberx36.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span>
