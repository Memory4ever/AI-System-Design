<td id="S4.T2.2.3.1" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Low</td>
<td id="S4.T2.2.3.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Low</td>
<td id="S4.T2.2.3.3" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;">Filter</td>
<td id="S4.T2.2.3.4" class="ltx_td ltx_align_left ltx_align_middle" style="padding-left:3.0pt;padding-right:3.0pt;">
<span id="S4.T2.2.3.4.1" class="ltx_inline-block ltx_align_middle" style="width:85.4pt;">
<span id="S4.T2.2.3.4.1.1" class="ltx_p">Corrupted, too hard, or trivial</span>
</span></td></tr>
