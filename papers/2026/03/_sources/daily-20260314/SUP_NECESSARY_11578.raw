<div id="A1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A1.p1.pic1" class="ltx_picture" height="128.73" overflow="visible" version="1.1" viewBox="0 0 477.38 128.73" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,128.73) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#404040;" fill="#404040" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 122.82 C 0 126.08 2.64 128.73 5.91 128.73 L 471.47 128.73 C 474.73 128.73 477.38 126.08 477.38 122.82 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 104.46 L 475.41 104.46 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 113.13)"><foreignObject style="--ltx-fo-width:31.37em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="434.07"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
