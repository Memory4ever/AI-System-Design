<td id="S3.T2.2.3.3" class="ltx_td ltx_align_left">
<span id="S3.T2.2.3.3.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T2.2.3.3.1.1" class="ltx_p"><span id="S3.T2.2.3.3.1.1.1" class="ltx_text" style="font-size:90%;">High-quality podcasts (</span><math id="S3.T2.m2" class="ltx_Math" alttext="\sim 1.5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">∼</mo><mn mathsize="0.900em">1.5</mn></mrow><annotation encoding="application/x-tex">\sim 1.5</annotation></semantics></math><span id="S3.T2.2.3.3.1.1.2" class="ltx_text" style="font-size:90%;"> h on average). </span><span id="S3.T2.2.3.3.1.1.3" class="ltx_text ltx_font_italic" style="font-size:90%;">In-house</span><span id="S3.T2.2.3.3.1.1.4" class="ltx_text" style="font-size:90%;">.</span></span>
</span></td></tr>
<tr id="S3.T2.2.4" class="ltx_tr">
<td id="S3.T2.2.4.1" class="ltx_td ltx_align_left ltx_border_bb"><span id="S3.T2.2.4.1.1" class="ltx_text" style="font-size:90%;">IWSLT25 Instruct</span></td>
<td id="S3.T2.2.4.2" class="ltx_td ltx_align_right ltx_border_bb"><span id="S3.T2.2.4.2.1" class="ltx_text" style="font-size:90%;">2</span></td>
<td id="S3.T2.2.4.3" class="ltx_td ltx_align_left ltx_border_bb">
<span id="S3.T2.2.4.3.1" class="ltx_inline-block ltx_align_top">
<span id="S3.T2.2.4.3.1.1" class="ltx_p"><span id="S3.T2.2.4.3.1.1.1" class="ltx_text" style="font-size:90%;">Thickly accented, terminologically dense, long-form monologues (</span><math id="S3.T2.m3" class="ltx_Math" alttext="\sim 5.5" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo mathsize="0.900em">∼</mo><mn mathsize="0.900em">5.5</mn></mrow><annotation encoding="application/x-tex">\sim 5.5</annotation></semantics></math><span id="S3.T2.2.4.3.1.1.2" class="ltx_text" style="font-size:90%;"> min on average). </span><span id="S3.T2.2.4.3.1.1.3" class="ltx_text ltx_font_italic" style="font-size:90%;">CC-BY</span></span>
</span></td></tr>
