<th id="S5.T5.2.4.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r ltx_border_t"><span id="S5.T5.2.4.2.1" class="ltx_text" style="font-size:90%;">No</span></th>
<td id="S5.T5.2.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.2.4.3.1" class="ltx_text" style="font-size:90%;">3.2</span></td>
<td id="S5.T5.2.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t"><span id="S5.T5.2.4.4.1" class="ltx_text" style="font-size:90%;">3.5</span></td>
<td id="S5.T5.2.4.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T5.2.4.5.1" class="ltx_text" style="font-size:90%;">3.0</span></td></tr>
<tr id="S5.T5.2.5" class="ltx_tr">
<th id="S5.T5.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S5.T5.2.5.1.1" class="ltx_text" style="font-size:90%;">2</span></th>
<th id="S5.T5.2.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="S5.T5.2.5.2.1" class="ltx_text" style="font-size:90%;">Yes</span></th>
<td id="S5.T5.2.5.3" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T5.2.5.3.1" class="ltx_text" style="font-size:90%;">3.6</span></td>
<td id="S5.T5.2.5.4" class="ltx_td ltx_align_center ltx_border_r"><span id="S5.T5.2.5.4.1" class="ltx_text" style="font-size:90%;">1.5</span></td>
<td id="S5.T5.2.5.5" class="ltx_td ltx_align_center"><span id="S5.T5.2.5.5.1" class="ltx_text" style="font-size:90%;">1.8</span></td></tr>
