<tr id="S2.T1.2.1.4" class="ltx_tr">
<td id="S2.T1.2.1.4.1" class="ltx_td ltx_align_left"><span id="S2.T1.2.1.4.1.1" class="ltx_text ltx_font_bold">MemAgent</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib41" title="" class="ltx_ref">Yu et al., 2025</a>)</cite></td>
<td id="S2.T1.2.1.4.2" class="ltx_td ltx_align_left">Semantic Slots</td>
<td id="S2.T1.2.1.4.3" class="ltx_td ltx_align_left"><span id="S2.T1.2.1.4.3.1" class="ltx_text ltx_font_bold">RL (DAPO)</span></td>
<td id="S2.T1.2.1.4.4" class="ltx_td ltx_align_left">Selective Overwriting</td>
