<tr id="S2.T1.2.1.5" class="ltx_tr">
<td id="S2.T1.2.1.5.1" class="ltx_td ltx_align_left"><span id="S2.T1.2.1.5.1.1" class="ltx_text ltx_font_bold">AtomMem</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib13" title="" class="ltx_ref">Huo et al., 2026</a>)</cite></td>
<td id="S2.T1.2.1.5.2" class="ltx_td ltx_align_left">Vector + Buffer</td>
