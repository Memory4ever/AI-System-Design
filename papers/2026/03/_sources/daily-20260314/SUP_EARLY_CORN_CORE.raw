<td id="S7.T2.2.8.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.3.1" class="ltx_text" style="font-size:80%;">88.8</span></td>
<td id="S7.T2.2.8.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.4.1" class="ltx_text" style="font-size:80%;">236.5</span></td>
<td id="S7.T2.2.8.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.5.1" class="ltx_text" style="font-size:80%;">340.5</span></td>
<td id="S7.T2.2.8.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.6.1" class="ltx_text" style="font-size:80%;">21.9</span></td>
<td id="S7.T2.2.8.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.7.1" class="ltx_text" style="font-size:80%;">36.7</span></td>
<td id="S7.T2.2.8.8" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.8.8.1" class="ltx_text" style="font-size:80%;">44.3</span></td></tr>
<tr id="S7.T2.2.9" class="ltx_tr">
<th id="S7.T2.2.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.1.1" class="ltx_text" style="font-size:80%;">T + I + A</span></th>
<th id="S7.T2.2.9.2" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.2.1" class="ltx_text" style="font-size:80%;">A</span></th>
<td id="S7.T2.2.9.3" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.3.1" class="ltx_text" style="font-size:80%;">29.6</span></td>
<td id="S7.T2.2.9.4" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.4.1" class="ltx_text" style="font-size:80%;">182.5</span></td>
<td id="S7.T2.2.9.5" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.5.1" class="ltx_text" style="font-size:80%;">284.5</span></td>
<td id="S7.T2.2.9.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.6.1" class="ltx_text" style="font-size:80%;">23.1</span></td>
<td id="S7.T2.2.9.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.7.1" class="ltx_text" style="font-size:80%;">33.6</span></td>
<td id="S7.T2.2.9.8" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.9.8.1" class="ltx_text" style="font-size:80%;">37.7</span></td></tr>
<tr id="S7.T2.2.10" class="ltx_tr">
<th id="S7.T2.2.10.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.10.1.1" class="ltx_text" style="font-size:80%;">T + I</span></th>
