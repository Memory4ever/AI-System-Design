</table></th>
<th id="S2.T1.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">
<table id="S2.T1.2.1.5.1" class="ltx_tabular ltx_align_middle">
<tr id="S2.T1.2.1.5.1.1" class="ltx_tr">
<td id="S2.T1.2.1.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T1.2.1.5.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Text</span></td></tr>
<tr id="S2.T1.2.1.5.1.2" class="ltx_tr">
<td id="S2.T1.2.1.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S2.T1.2.1.5.1.2.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">in/out</span></td></tr>
</table></th>
<th id="S2.T1.2.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;">
<table id="S2.T1.2.1.6.1" class="ltx_tabular ltx_align_middle">
