hcolor="#008000">w</mi><mrow><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">s</mi><mo style="--ltx-fg-color:#008000;" mathcolor="#008000">,</mo><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">t</mi><mo style="--ltx-fg-color:#008000;" mathcolor="#008000">,</mo><mi style="--ltx-fg-color:#008000;" mathcolor="#008000">p</mi></mrow></msub></mrow><mo style="--ltx-fg-color:#008000;" mathcolor="#008000">=</mo><mn style="--ltx-fg-color:#008000;" mathcolor="#008000">0</mn></mrow><annotation encoding="application/x-tex">x_{t,p}/w_{s,t,p}=0</annotation></semantics></math> </span>
