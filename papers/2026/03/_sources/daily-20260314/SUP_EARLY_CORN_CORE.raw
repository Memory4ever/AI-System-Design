<td id="S7.T2.2.10.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.10.5.1" class="ltx_text" style="font-size:80%;">375.2</span></td>
