<td id="S7.T2.2.7.6" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.7.6.1" class="ltx_text" style="font-size:80%;">24.8</span></td>
<td id="S7.T2.2.7.7" class="ltx_td ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S7.T2.2.7.7.1" class="ltx_text" style="font-size:80%;">36.5</span></td>
