          <span id="algorithm3.3.35.2" class="ltx_text ltx_font_bold">return</span> <em id="algorithm3.3.35.3" class="ltx_emph ltx_font_italic"><math id="algorithm3.m60" class="ltx_Math" alttext="\{w_{s,t,p}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>w</mi><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>p</mi></mrow></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{w_{s,t,p}\}</annotation></semantics></math></em>

