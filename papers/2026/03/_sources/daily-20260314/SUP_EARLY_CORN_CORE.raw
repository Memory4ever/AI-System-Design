          <math id="algorithm3.m48" class="ltx_Math" alttext="\text{role}_{s,t,p}\leftarrow\mathrm{Comp}(s)\cap R" display="inline" intent=":literal"><semantics><mrow><msub><mtext>role</mtext><mrow><mi>s</mi><mo>,</mo><mi>t</mi><mo>,</mo><mi>p</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mrow><mi>Comp</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∩</mo><mi>R</mi></mrow></mrow><annotation encoding="application/x-tex">\text{role}_{s,t,p}\leftarrow\mathrm{Comp}(s)\cap R</annotation></semantics></math> 
