<span id="S4.T1.6.1.6.1.1" class="ltx_inline-block ltx_align_middle" style="width:119.2pt;">
<span id="S4.T1.6.1.6.1.1.1" class="ltx_p">LongText-Bench <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib5" title="" class="ltx_ref">7</a>]</cite></span>
</span></td>
<td id="S4.T1.6.1.6.2" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">✓</td>
<td id="S4.T1.6.1.6.3" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">✓</td>
<td id="S4.T1.6.1.6.4" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">✗</td>
<td id="S4.T1.6.1.6.5" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">✗</td>
<td id="S4.T1.6.1.6.6" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">✗</td>
<td id="S4.T1.6.1.6.7" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S4.T1.m7" class="ltx_Math" alttext="320" display="inline" intent=":literal"><semantics><mn>320</mn><annotation encoding="application/x-tex">320</annotation></semantics></math></td>
<td id="S4.T1.6.1.6.8" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S4.T1.m8" class="ltx_Math" alttext="116.7" display="inline" intent=":literal"><semantics><mn>116.7</mn><annotation encoding="application/x-tex">116.7</annotation></semantics></math></td>
<td id="S4.T1.6.1.6.9" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.38</td>
<td id="S4.T1.6.1.6.10" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.72</td>
<td id="S4.T1.6.1.6.11" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.69</td>
<td id="S4.T1.6.1.6.12" class="ltx_td ltx_align_center ltx_align_middle" style="padding-top:0.5pt;padding-bottom:0.5pt;">0.74</td></tr>
<tr id="S4.T1.6.1.7" class="ltx_tr">
<td id="S4.T1.6.1.7.1" class="ltx_td ltx_align_left ltx_align_middle ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;">
<span id="S4.T1.6.1.7.1.1" class="ltx_inline-block ltx_align_middle" style="width:119.2pt;">
<span id="S4.T1.6.1.7.1.1.1" class="ltx_p">Ours</span>
</span></td>
