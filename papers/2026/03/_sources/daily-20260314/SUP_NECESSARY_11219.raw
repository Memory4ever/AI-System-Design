<td id="S3.T1.11.4.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.7.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.7.1.1" class="ltx_text ltx_font_bold">0.780</span>   </span></td>
<td id="S3.T1.11.4.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.8.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.8.1.1" class="ltx_text ltx_font_bold">0.838</span>   </span></td>
<td id="S3.T1.11.4.9" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.9.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.9.1.1" class="ltx_text ltx_font_bold">0.760</span>   </span></td></tr>
