<td id="S3.T1.11.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.2.3.1" class="ltx_text" style="font-size:80%;">   Right   </span></td>
<td id="S3.T1.11.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.2.4.1" class="ltx_text" style="font-size:80%;">   Keep   </span></td>
<td id="S3.T1.11.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.2.5.1" class="ltx_text" style="font-size:80%;">   Acc.   </span></td>
<td id="S3.T1.11.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.2.6.1" class="ltx_text" style="font-size:80%;">   Dec.   </span></td>
<td id="S3.T1.11.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.2.7.1" class="ltx_text" style="font-size:80%;">   Stop   </span></td></tr>
<tr id="S3.T1.11.3" class="ltx_tr">
<td id="S3.T1.11.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.1.1" class="ltx_text" style="font-size:80%;">   Senna <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib15" title="" class="ltx_ref">19</a>]</cite>   </span></td>
<td id="S3.T1.11.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.2.1" class="ltx_text" style="font-size:80%;">   0.763   </span></td>
<td id="S3.T1.11.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.3.1" class="ltx_text" style="font-size:80%;">   0.533   </span></td>
<td id="S3.T1.11.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.4.1" class="ltx_text" style="font-size:80%;">   0.574   </span></td>
<td id="S3.T1.11.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.5.1" class="ltx_text" style="font-size:80%;">   0.550   </span></td>
<td id="S3.T1.11.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.6.1" class="ltx_text" style="font-size:80%;">   0.612   </span></td>
<td id="S3.T1.11.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.7.1" class="ltx_text" style="font-size:80%;">   0.628   </span></td>
<td id="S3.T1.11.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.8.1" class="ltx_text" style="font-size:80%;">   0.802   </span></td>
<td id="S3.T1.11.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.3.9.1" class="ltx_text" style="font-size:80%;">   0.637   </span></td></tr>
<tr id="S3.T1.11.4" class="ltx_tr" style="--ltx-bg-color:#F0F0F0;">
<td id="S3.T1.11.4.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.1.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.1.1.1" class="ltx_text ltx_font_bold">Ours</span>   </span></td>
<td id="S3.T1.11.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.2.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.2.1.1" class="ltx_text ltx_font_bold">0.809</span>   </span></td>
<td id="S3.T1.11.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.3.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.3.1.1" class="ltx_text ltx_font_bold">0.664</span>   </span></td>
<td id="S3.T1.11.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.4.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.4.1.1" class="ltx_text ltx_font_bold">0.710</span>   </span></td>
<td id="S3.T1.11.4.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:17.2pt;padding-right:17.2pt;"><span id="S3.T1.11.4.5.1" class="ltx_text" style="font-size:80%;--ltx-bg-color:#F0F0F0;">   <span id="S3.T1.11.4.5.1.1" class="ltx_text ltx_font_bold">0.754</span>   </span></td>
