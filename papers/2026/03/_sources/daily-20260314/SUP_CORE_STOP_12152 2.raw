<span id="lstnumberx555" class="ltx_listingline"><span id="lstnumberx555.1" class="ltx_text" style="--ltx-fg-color:#000000;">*</span><span id="lstnumberx555.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.3" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">Definition</span><span id="lstnumberx555.4" class="ltx_text" style="--ltx-fg-color:#000000;">:</span><span id="lstnumberx555.5" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.6" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">Whether</span><span id="lstnumberx555.7" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.8" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">the</span><span id="lstnumberx555.9" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.10" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">user</span><span id="lstnumberx555.11" class="ltx_text" style="--ltx-fg-color:#000000;">’</span><span id="lstnumberx555.12" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">s</span><span id="lstnumberx555.13" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.14" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">dialogue</span><span id="lstnumberx555.15" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.16" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">faithfully</span><span id="lstnumberx555.17" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.18" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">expresses</span><span id="lstnumberx555.19" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx555.20" class="lt