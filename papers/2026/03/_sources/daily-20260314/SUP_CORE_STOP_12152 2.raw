</span><span id="lstnumberx87.40" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.41" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">has</span><span id="lstnumberx87.42" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.43" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">any</span><span id="lstnumberx87.44" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.45" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">impact</span><span id="lstnumberx87.46" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.47" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">on</span><span id="lstnumberx87.48" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.49" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">exercise</span><span id="lstnumberx87.50" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.51" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx87.52" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.53" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">health</span><span id="lstnumberx87.54" class="ltx_text" style="--ltx-fg-color:#000000;">",</span><span id="lstnumberx87.55" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.56" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">a</span><span id="lstnumberx87.57" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.58" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">possible</span><span id="lstnumberx87.59" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.60" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">triggering</span><span id="lstnumberx87.61" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.62" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">event</span><span id="lstnumberx87.63" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.64" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">could</span><span id="lstnumberx87.65" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.66" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">be</span><span id="lstnumberx87.67" class="ltx_text" style="--ltx-fg-color:#000000;">:</span><span id="lstnumberx87.68" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.69" class="ltx_text" style="--ltx-fg-color:#000000;">"</span><span id="lstnumberx87.70" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">Recently</span><span id="lstnumberx87.71" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.72" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">resumed</span><span id="lstnumberx87.73" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.74" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">strength</span><span id="lstnumberx87.75" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.76" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">training</span><span id="lstnumberx87.77" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.78" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">at</span><span id="lstnumberx87.79" class="ltx_text ltx