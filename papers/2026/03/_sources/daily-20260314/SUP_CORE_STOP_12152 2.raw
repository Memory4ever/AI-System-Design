<td id="S6.T5.2.1.7.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S6.T5.m26" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
<td id="S6.T5.2.1.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="S6.T5.m27" class="ltx_Math" alttext="\checkmark" display="inline" intent=":literal"><semantics><mi>✓</mi><annotation encoding="application/x-tex">\checkmark</annotation></semantics></math></td>
