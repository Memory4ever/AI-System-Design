<span id="lstnumberx556" class="ltx_listingline"><span id="lstnumberx556.1" class="ltx_text" style="--ltx-fg-color:#000000;">*</span><span id="lstnumberx556.2" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx556.3" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">Scoring</span><span id="lstnumberx556.4" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx556.5" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">rubric</span><span id="lstnumberx556.6" class="ltx_text" style="--ltx-fg-color:#000000;">:</span>
