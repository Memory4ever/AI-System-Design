d</span><span id="lstnumberx87.99" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.100" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">down</span><span id="lstnumberx87.101" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.102" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">or</span><span id="lstnumberx87.103" class="ltx_text ltx_lst_space" style="--ltx-fg-color:#000000;"> </span><span id="lstnumberx87.104" class="ltx_text ltx_lst_identifier" style="--ltx-fg-color:#000000;">plateaued</span><span id="lstnumberx87.105" class="ltx_text" style="--ltx-fg-color:#000000;">."</span>
</span>
