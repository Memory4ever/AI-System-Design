<td id="S4.T3.5.9.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">(e)+OT refinement</td>
<td id="S4.T3.5.9.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">59.60</td>
<td id="S4.T3.5.9.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">54.77</td>
