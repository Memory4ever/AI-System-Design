<td id="S4.T3.5.8.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">39.10</td>
<td id="S4.T3.5.8.6" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">52.60</td></tr>
