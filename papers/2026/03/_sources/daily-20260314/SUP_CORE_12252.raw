<td id="A4.F11.3.1.3" class="ltx_td ltx_nopad_l ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;" colspan="2"><span id="A4.F11.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Low Resolution</span></td></tr>
