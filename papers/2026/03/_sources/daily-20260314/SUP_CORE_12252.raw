<td id="S5.F8.3.2.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.F8.3.2.3.1" class="ltx_text" style="font-size:70%;">Ori</span></td>
<td id="S5.F8.3.2.4" class="ltx_td ltx_nopad_l ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.F8.3.2.4.1" class="ltx_text" style="font-size:70%;">MLLM-Only</span></td>
<td id="S5.F8.3.2.5" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.F8.3.2.5.1" class="ltx_text" style="font-size:70%;">Ori</span></td>
<td id="S5.F8.3.2.6" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><span id="S5.F8.3.2.6.1" class="ltx_text" style="font-size:70%;">MLLM-Only</span></td></tr>
<tr id="S5.F8.3.3" class="ltx_tr">
<td id="S5.F8.3.3.1" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center" style="padding-left:1.0pt;padding-right:1.0pt;"><img src="2603.12252v1/images/1.5_analysis/1_ori.PNG" id="S5.F8.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:69/69;" width="69" height="69" alt="Refer to caption"></td>
