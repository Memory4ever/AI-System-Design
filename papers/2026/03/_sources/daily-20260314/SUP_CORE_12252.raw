            <math id="alg3.l8.m1" class="ltx_Math" alttext="\mathcal{S}\leftarrow\emptyset" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi></mrow><annotation encoding="application/x-tex">\mathcal{S}\leftarrow\emptyset</annotation></semantics></math>

