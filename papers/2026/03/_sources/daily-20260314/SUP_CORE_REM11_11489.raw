<td id="S4.T3.2.3.3" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_t" style="padding:0.5pt 1.3pt;">80.3</td>
<td id="S4.T3.2.3.4" class="ltx_td ltx_nopad_l ltx_nopad_r ltx_align_center ltx_border_r ltx_border_t" style="padding:0.5pt 1.3pt;">84.8</td>
