<td id="S4.T2.14.4.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding:2.5pt 4.0pt;">
<span id="S4.T2.14.4.1.1" class="ltx_inline-block ltx_align_top" style="width:71.1pt;">
<span id="S4.T2.14.4.1.1.1" class="ltx_p"><span id="S4.T2.14.4.1.1.1.1" class="ltx_text ltx_font_bold">Verilog-Specific Models</span></span>
</span></td>
<td id="S4.T2.14.4.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_r ltx_border_t" style="padding:2.5pt 4.0pt;">
<span id="S4.T2.14.4.2.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="S4.T2.14.4.2.1.1" class="ltx_p">VerilogEval <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib6" title="" class="ltx_ref">6</a>]</cite></span>
</span></td>
