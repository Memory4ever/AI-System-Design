<td id="S4.T1.2.1.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding:2.5pt 11.4pt;"><span id="S4.T1.2.1.2.1" class="ltx_text ltx_font_bold">Syntactic</span></td>
