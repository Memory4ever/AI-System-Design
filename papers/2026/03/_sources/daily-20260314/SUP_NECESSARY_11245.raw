<td id="S3.T1.16.1.31.6" class="ltx_td ltx_align_center"><span id="S3.T1.16.1.31.6.1" class="ltx_text" style="--ltx-bg-color:#FFF9F2;">67.4<sub id="S3.T1.16.1.31.6.1.1" class="ltx_sub"><span id="S3.T1.16.1.31.6.1.1.1" class="ltx_text ltx_font_italic">±0.8</span></sub></span></td>
