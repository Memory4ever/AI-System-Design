<td id="S3.T1.16.1.32.6" class="ltx_td ltx_align_center"><span id="S3.T1.16.1.32.6.1" class="ltx_text" style="--ltx-bg-color:#FFF9F2;">72.8<sub id="S3.T1.16.1.32.6.1.1" class="ltx_sub"><span id="S3.T1.16.1.32.6.1.1.1" class="ltx_text ltx_font_italic">±1.3</span></sub></span></td>
<td id="S3.T1.16.1.32.7" class="ltx_td ltx_align_center"><span id="S3.T1.16.1.32.7.1" class="ltx_text" style="--ltx-bg-color:#FFF9F2;">0.237<sub id="S3.T1.16.1.32.7.1.1" class="ltx_sub"><span id="S3.T1.16.1.32.7.1.1.1" class="ltx_text ltx_font_italic">±0.016</span></sub></span></td>
