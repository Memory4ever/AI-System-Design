<td id="S5.T1.2.8.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T1.2.8.2.1" class="ltx_text ltx_font_bold">36.7</span></td>
<td id="S5.T1.2.8.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S5.T1.2.8.3.1" class="ltx_text ltx_font_bold">87.0</span></td>
