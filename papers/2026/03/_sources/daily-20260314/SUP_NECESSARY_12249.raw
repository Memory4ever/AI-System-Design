</figure>
</section>
</section>
<section id="S5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">5.2 </span>Main Results</h3>

<figure id="S5.T4" class="ltx_table ltx_align_floatright" style="width:42%;">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 4: </span><span id="S5.T4.5" class="ltx_text ltx_font_bold">Performance comparison on <span id="S5.T4.5.1" class="ltx_text ltx_font_smallcaps">SciMDR</span>-Eval against advanced models.</span> Despite having only 7B parameters, our model matches the performance of <span id="S5.T4.6" class="ltx_text ltx_font_typewriter">GPT-5.2</span> and <span id="S5.T4.7" class="ltx_text ltx_font_typewriter">GPT-5.1</span> on this domain-specific task.</figcaption>
<table id="S5.T4.8" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S5.T4.8.1" class="ltx_tr">
<td id="S5.T4.8.1.1" class="ltx_td ltx_align_left ltx_border_tt"><span id="S5.T4.8.1.1.1" class="ltx_text ltx_font_bold">Model</span></td>
<td id="S5.T4.8.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T4.8.1.2.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">SciMDR<span id="S5.T4.8.1.2.1.1" class="ltx_text ltx_font_upright">-Eval</span></span></td></tr>
<tr id="S5.T4.8.2" class="ltx_tr">
<td id="S5.T4.8.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T4.8.2.1.1" class="ltx_text ltx_font_typewriter">GPT-5.2</span></td>
<td id="S5.T4.8.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T4.8.2.2.1" class="ltx_text ltx_font_bold">49.9</span></td></tr>
