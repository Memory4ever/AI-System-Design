<td id="S5.T4.8.3.1" class="ltx_td ltx_align_left"><span id="S5.T4.8.3.1.1" class="ltx_text ltx_font_typewriter">GPT-5.1</span></td>
<td id="S5.T4.8.3.2" class="ltx_td ltx_align_center">47.2</td></tr>
<tr id="S5.T4.8.4" class="ltx_tr">
