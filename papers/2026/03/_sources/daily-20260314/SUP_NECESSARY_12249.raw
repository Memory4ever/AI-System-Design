<td id="S5.T3.6.1.8.5" class="ltx_td ltx_align_center ltx_border_t">62.7<span id="S5.T3.6.1.8.5.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"><sup id="S5.T3.6.1.8.5.1.1" class="ltx_sup"><span id="S5.T3.6.1.8.5.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#006400;">-3.7</span></sup></span></td>
<td id="S5.T3.6.1.8.6" class="ltx_td ltx_align_center ltx_border_t">44.7<span id="S5.T3.6.1.8.6.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"><sup id="S5.T3.6.1.8.6.1.1" class="ltx_sup"><span id="S5.T3.6.1.8.6.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#006400;">-11.9</span></sup></span></td>
<td id="S5.T3.6.1.8.7" class="ltx_td ltx_align_center ltx_border_t">40.0<span id="S5.T3.6.1.8.7.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"><sup id="S5.T3.6.1.8.7.1.1" class="ltx_sup"><span id="S5.T3.6.1.8.7.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#006400;">-8.9</span></sup></span></td>
<td id="S5.T3.6.1.8.8" class="ltx_td ltx_align_center ltx_border_t">5.6<span id="S5.T3.6.1.8.8.1" class="ltx_text ltx_inline-block" style="width:0.0pt;"><sup id="S5.T3.6.1.8.8.1.1" class="ltx_sup"><span id="S5.T3.6.1.8.8.1.1.1" class="ltx_text ltx_font_italic" style="--ltx-fg-color:#006400;">-14.2</span></sup></span></td></tr>
