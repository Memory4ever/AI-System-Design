<tr id="S2.T1.14.1.8" class="ltx_tr">
<td id="S2.T1.14.1.8.1" class="ltx_td ltx_align_left">DomainCQA <cite class="ltx_cite ltx_citemacro_cite"><a href="#bib.bib25" title="" class="ltx_ref">Zhong et al. (2025)</a></cite></td>
<td id="S2.T1.14.1.8.2" class="ltx_td"></td>
<td id="S2.T1.14.1.8.3" class="ltx_td ltx_align_center"><span id="S2.T1.14.1.8.3.1" class="ltx_text ltx_font_typewriter">llms</span></td>
