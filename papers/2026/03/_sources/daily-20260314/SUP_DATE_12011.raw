{"data":{"id":"10.48550/arxiv.2603.12011","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.12011","prefix":"10.48550","suffix":"arxiv.2603.12011","identifiers":[{"identifier":"2603.12011","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.12011"}],"creators":[{"name":"Xi, Zhiheng","nameType":"Personal","givenName":"Zhiheng","familyName":"Xi","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Xin","nameType":"Personal","givenName":"Xin","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Jiaqi","nameType":"Personal","givenName":"Jiaqi","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Jiazheng","nameType":"Personal","givenName":"Jiazheng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Fan, Yutao","nameType":"Personal","givenName":"Yutao","familyName":"Fan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Zhihao","nameType":"Personal","givenName":"Zhihao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Shichun","nameType":"Personal","givenName":"Shichun","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Chai, Mingxu","nameType":"Personal","givenName":"Mingxu","familyName":"Chai","affiliation":[],"nameIdentifiers":[]},{"name":"Shi, Xiaowei","nameType":"Personal","givenName":"Xiaowei","familyName":"Shi","affiliation":[],"nameIdentifiers":[]},{"name":"Zhai, Yitao","nameType":"Personal","givenName":"Yitao","familyName":"Zhai","affiliation":[],"nameIdentifiers":[]},{"name":"Cai, Xunliang","nameType":"Personal","givenName":"Xunliang","familyName":"Cai","affiliation":[],"nameIdentifiers":[]},{"name":"Gui, Tao","nameType":"Personal","givenName":"Tao","familyName":"Gui","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Qi","nameType":"Personal","givenName":"Qi","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Xuanjing","nameType":"Personal","givenName":"Xuanjing","familyName":"Huang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Can RL Improve Generalization of LLM Agents? An Empirical Study"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-12T14:54:59Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-13T00:53:34Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Reinforcement fine-tuning (RFT) has shown promise for training LLM agents to perform multi-turn decision-making based on environment feedback. However, most existing evaluations remain largely in-domain: training and testing are conducted in the same environment or even on the same tasks. In real-world deployment, agents may operate in unseen environments with different background knowledge, observation spaces, and action interfaces. To characterize the generalization profile of RFT under such shifts, we conduct a systematic study along three axes: (1) within-environment generalization across task difficulty, (2) cross-environment transfer to unseen environments, and (3) sequential multi-environment training to quantify transfer and forgetting. Our results show that RFT generalizes well across task difficulty within an environment, but exhibits weaker transfer to unseen environments, which correlates with shifts in both semantic priors and observation/action interfaces. In contrast, sequential training yields promising downstream gains with minimal upstream forgetting, and mixture training across environments improves the overall balance. We further provide detailed analyses and deeper insights, and hope our work helps the community develop and deploy generalizable LLM agents.","descriptionType":"Abstract"},{"description":"Preprint, under review","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.12011","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-13T02:08:50.000Z","registered":"2026-03-13T02:08:50.000Z","published":"2026","updated":"2026-03-13T02:08:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.12011","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}