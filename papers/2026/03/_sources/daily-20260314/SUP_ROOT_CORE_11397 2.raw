<td id="S5.T5.2.4.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T5.2.4.3.1" class="ltx_text" style="font-size:70%;">0.78</span></td>
