<td id="S5.T1.5.5.1" class="ltx_td ltx_align_left"><span id="S5.T1.5.5.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">lookup_only</span></td>
<td id="S5.T1.5.5.2" class="ltx_td ltx_align_right"><span id="S5.T1.5.5.2.1" class="ltx_text" style="font-size:90%;">130</span></td>
<td id="S5.T1.5.5.3" class="ltx_td ltx_align_right"><span id="S5.T1.5.5.3.1" class="ltx_text" style="font-size:90%;">140</span></td>
<td id="S5.T1.5.5.4" class="ltx_td ltx_align_right"><span id="S5.T1.5.5.4.1" class="ltx_text" style="font-size:90%;">+110</span></td></tr>
