<td id="S5.T1.5.2.2" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T1.5.2.2.1" class="ltx_text" style="font-size:90%;">20</span></td>
<td id="S5.T1.5.2.3" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T1.5.2.3.1" class="ltx_text" style="font-size:90%;">30</span></td>
<td id="S5.T1.5.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S5.T1.5.2.4.1" class="ltx_text" style="font-size:90%;">—</span></td></tr>
<tr id="S5.T1.5.3" class="ltx_tr">
<td id="S5.T1.5.3.1" class="ltx_td ltx_align_left"><span id="S5.T1.5.3.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">noop</span></td>
<td id="S5.T1.5.3.2" class="ltx_td ltx_align_right"><span id="S5.T1.5.3.2.1" class="ltx_text" style="font-size:90%;">100</span></td>
<td id="S5.T1.5.3.3" class="ltx_td ltx_align_right"><span id="S5.T1.5.3.3.1" class="ltx_text" style="font-size:90%;">111</span></td>
<td id="S5.T1.5.3.4" class="ltx_td ltx_align_right"><span id="S5.T1.5.3.4.1" class="ltx_text" style="font-size:90%;">+80</span></td></tr>
<tr id="S5.T1.5.4" class="ltx_tr">
<td id="S5.T1.5.4.1" class="ltx_td ltx_align_left"><span id="S5.T1.5.4.1.1" class="ltx_text ltx_font_typewriter" style="font-size:90%;">size_aware_v2</span></td>
<td id="S5.T1.5.4.2" class="ltx_td ltx_align_right"><span id="S5.T1.5.4.2.1" class="ltx_text" style="font-size:90%;">100</span></td>
<td id="S5.T1.5.4.3" class="ltx_td ltx_align_right"><span id="S5.T1.5.4.3.1" class="ltx_text" style="font-size:90%;">111</span></td>
<td id="S5.T1.5.4.4" class="ltx_td ltx_align_right"><span id="S5.T1.5.4.4.1" class="ltx_text" style="font-size:90%;">+80</span></td></tr>
