<td id="S3.T2.3.4.4" class="ltx_td ltx_nopad_r ltx_align_center"><span id="S3.T2.3.4.4.1" class="ltx_text" style="font-size:90%;">262k</span></td></tr>
<tr id="S3.T2.3.5" class="ltx_tr">
