<div id="A4.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A4.p1.pic1" class="ltx_picture" height="191.55" overflow="visible" version="1.1" viewBox="0 0 477.38 191.55" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,191.55) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#2D4CB9;" fill="#2D4CB9" fill-opacity="1.0"><path style="stroke:none" d="M 0 4.63 L 0 186.92 C 0 189.47 2.07 191.55 4.63 191.55 L 472.75 191.55 C 475.3 191.55 477.38 189.47 477.38 186.92 L 477.38 4.63 C 477.38 2.07 475.3 0 472.75 0 L 4.63 0 C 2.07 0 0 2.07 0 4.63 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 4.63 L 0.69 168.45 L 476.68 168.45 L 476.68 4.63 C 476.68 2.45 474.92 0.69 472.75 0.69 L 4.63 0.69 C 2.45 0.69 0.69 2.45 0.69 4.63 Z"></path></g><g style="--ltx-fill-color:#2D4CB9;" fill="#2D4CB9" fill-opacity="1.0"><path style="stroke:none" d="M 0.69 169.14 L 0.69 186.92 C 0.69 189.09 2.45 190.86 4.63 190.86 L 472.75 190.86 C 474.92 190.86 476.68 189.09 476.68 186.92 L 476.68 169.14 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 12.93 176.54)"><foreignObject style="--ltx-fo-width:28.37em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="392.56"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
