<th id="S5.T4.3.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t"><math id="S5.T4.m1" class="ltx_Math" alttext="44.9\pm 7.3" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">44.9</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">7.3</mn></mrow><annotation encoding="application/x-tex">44.9\pm 7.3</annotation></semantics></math></th>
