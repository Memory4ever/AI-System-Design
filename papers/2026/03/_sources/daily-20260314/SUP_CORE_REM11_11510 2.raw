<tr id="S5.T4.3.5" class="ltx_tr">
<th id="S5.T4.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T4.3.5.1.1" class="ltx_text ltx_font_smallcaps" style="font-size:90%;">Qwen3.5-4B</span></th>
<td id="S5.T4.3.5.2" class="ltx_td ltx_align_center"><math id="S5.T4.m10" class="ltx_Math" alttext="\textbf{54.8}\pm 10.3" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_bold" mathsize="0.900em">54.8</mtext><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">10.3</mn></mrow><annotation encoding="application/x-tex">\textbf{54.8}\pm 10.3</annotation></semantics></math></td>
