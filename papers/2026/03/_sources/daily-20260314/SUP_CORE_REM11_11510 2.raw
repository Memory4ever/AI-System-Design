<td id="S5.T4.3.3.4" class="ltx_td ltx_align_center ltx_border_t"><math id="S5.T4.m6" class="ltx_Math" alttext="70.8\pm 9.8" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">70.8</mn><mo mathsize="0.900em">±</mo><mn mathsize="0.900em">9.8</mn></mrow><annotation encoding="application/x-tex">70.8\pm 9.8</annotation></semantics></math></td></tr>
