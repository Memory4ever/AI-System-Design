<td id="A1.T10.2.2.4" class="ltx_td ltx_align_left ltx_border_t"><math id="A1.T10.m1" class="ltx_Math" alttext="2\times 512" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>512</mn></mrow><annotation encoding="application/x-tex">2\times 512</annotation></semantics></math> sequences <math id="A1.T10.m2" class="ltx_Math" alttext="\times\,T{=}512" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo lspace="0.222em" rspace="0.392em">×</mo><mrow><mi>T</mi><mo>=</mo><mn>512</mn></mrow></mrow><annotation encoding="application/x-tex">\times\,T{=}512</annotation></semantics></math> (<math id="A1.T10.m3" class="ltx_Math" alttext="2^{19}" display="inline" intent=":literal"><semantics><msup><mn>2</mn><mn>19</mn></msup><annotation encoding="application/x-tex">2^{19}</annotation></semantics></math> obs.)</td></tr>
