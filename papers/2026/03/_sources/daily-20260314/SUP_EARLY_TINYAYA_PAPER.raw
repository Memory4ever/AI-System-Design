mutable/chunks/2ry0ss73fsgwj.js\",\"/_next/static/immutable/chunks/0xc3t64g5bcw4.js\",\"/_next/static/immutable/chunks/26471dss6hz9h.js\",\"/_next/static/immutable/chunks/205up3w_sgm5w.js\",\"/_next/static/immutable/chunks/00zl0b5s3ippq.js\",\"/_next/static/immutable/chunks/0niind4o4gudf.js\",\"/_next/static/immutable/chunks/0i9goxbq7gp4o.js\",\"/_next/static/immutable/chunks/072trt60k8m_q.js\",\"/_next/static/immutable/chunks/2lo9w783yxdg4.js\",\"/_next/static/immutable/chunks/2uvsqmjl372t0.js\",\"/_next/static/immutable/chunks/0r5eqi0tfjukm.js\",\"/_next/static/immutable/chunks/1kd1-d8ev-cxm.js\",\"/_next/static/immutable/chunks/3ex1de4o2vb4g.js\",\"/_next/static/immutable/chunks/1-ffytpsf_u9g.js\"],\"CalloutCard\"]\n2e:[\"$\",\"div\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"mx-auto mb-7 max-w-[670px] px-4 lg:mb-12 lg:px-0\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-web3-20 lg:text-web3-24 font-body\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":\"Authors\"}],[\"$\",\"br\",null,{}],[\"$\",\"p\",null,{\"className\":\"text-web3-16 font-body\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":\"Alejandro R. Salamanca, Diana Abagyan, Daniel D’souza, Ammar Khairi, David Mora, Saurabh Dash, Viraat Aryabumi, Sara Rajaee, Mehrnaz Mofakhami, Ananya Sahu, Thomas Euyang, Brittawnya Prince, Madeline Smith, Hangyu Lin, Acyr Locatelli, Sara Hooker, Tom Kocmi, Aidan Gomez, Ivan Zhang, Phil Blunsom, Nick Frosst, Joelle Pineau, Beyza Ermis, Ahmet Üstün,  Julia Kreutzer and Marzieh Fadaee\"}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[670px] px-4 pb-9 lg:px-0 lg:pb-[60px]\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-web3-20 lg:text-web3-24 font-body\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":\"Abstract\"}],[\"$\",\"br\",null,{}],[\"$\",\"span\",null,{\"className\":\"text-web3-16 font-body\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":[\"$\",\"div\",null,{\"className\":\"[\u0026_p_a]:!inline portable-text-breaks\",\"style\":\"$undefined\",\"children\":[[\"$\",\"span\",\"dcfd1c75b948\",{\"className\":\"\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":[\"Tiny Aya redefines what a small multilingual language model can achieve. Trained on 70 languages and refined through region-aware posttraining, it delivers state-of-the-art in translation quality, strong multilingual understanding, and high-quality target-language generation, all with just 3.35B parameters. The release includes a pretrained foundation model, a globally balanced instruction-tuned variant, and three region-specialized models targeting languages from Africa, South Asia, Europe, Asia-Pacific, and West Asia. This report details the training strategy, data composition, and comprehensive evaluation framework behind Tiny Aya, and presents an alternative scaling path for multilingual AI: one centered on efficiency, balanced performance across languages, and practical deployment.\"]}]]}]}]]}],[\"$\",\"$d\",null,{\"children\":[[\"$\",\"$1\",\"86625bfa91d2\",{\"children\":[[\"$\",\"$L30\",null,{\"moduleIds\":[80404]}],\"$L31\"]}]]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-[670px]\",\"children\":[[\"$\",\"hr\",null,{\"className\":\"pt-6 lg:pt-9\"}],[\"$\",\"$L32\",null,{\"tags\":[{\"_createdAt\":\"2024-02-12T23:45:20Z\",\"_id\":\"eb6631f8-6131-4842-99e0-04ca4a23480b\",\"_rev\":\"t31M8RnwAWNSk6WWfZovOy\",\"_type\":\"researchTag\",\"_updatedAt\":\"2024-11-27T00:05:50Z\",\"tag\":\"multilingual\"},{\"_createdAt\":\"2023-09-28T19:40:35Z\",\"_id\":\"c6f2643d-4add-453a-b38c-3e81fe3e1da7\",\"_rev\":\"t31M8RnwAWNSk6WWfZovOy\",\"_type\":\"researchTag\",\"_updatedAt\":\"2024-11-27T00:05:50Z\",\"tag\":\"Efficiency\"}]}]]}]]}]\n2f:[[\"$\",\"p\",null,{\"className\":\"text-web3-24-heading lg:text-web3-32 font-body mx-auto mb-9 max-w-web3-internal-wrapper px-4 lg:px-10\",\"role\":\"$undefined\",\"style\":\"$undefined\",\"children\":\"Related works\"}],[\"$\",\"div\",null,{\"className\":\"flex w-full flex-col lg:grid gap-6 items-center justify-center lg:place-content-center lg:grid-cols-[repeat(3,1fr)] mx-auto max-w-web3-internal-wrapper px-4 lg:px-10 pb-14 lg:pb-36\",\"children\":[[\"$\",\"$L33\",\"0b757bd9-940b-4664-8f7c-f74f568aec88\",{\"theme\":\"custom\",\"customBgColor\":\"#F0EEE8\",\"imageSize\":\"small\",\"headingStyleAs\":\"web3-h6\",\"index\":0,\"eyebrow\":\"Research\",\"heading\":\"Unlocking Reasoning Capability on Machine Translation in Large Language Models\",\"cta\":{\"label\":\"Read\",\"url\":\"unlocking-reasoning-capability-on-machine-translation-in-large-language-models-2026-02-16\"},\"imageUrl\":\"https://cdn.sanity.io/images/rjtqmwfu/web3-prod/2aac5a8e3c8d00b0afb247f06d7205453d080111-1920x1080.png\",\"moreThanTwoCards\":true,\"isAnimationTriggered\":true}],[\"$\",\"$L33\",\"c1e2600a-23bb-41c1-ae24-7614193c9920\",{\"theme\":\"custom\",\"customBgColor\":\"#F0EEE8\",\"imageSize\":\"small\",\"headingStyleAs\":\"web3-h6\",\"index\":1,\"eyebrow\":\"Research\",\"heading\":\"Findings of the WMT26 Multilingual Instruction Shared Task: Small Models Are Not Yet Polyglots\",\"cta\":{\"label\":\"Read\",\"url\":\"findings-of-the-wmt26-multilingual-instruction-shared-task-small-models-are-not-yet-polyglots-2026-06-06\"},\"imageUrl\":\"/research/CohereLabs_Fallback_2-min.png\",\"moreThanTwoCards\":true,\"isAnimationTriggered\":true}],[\"$\",\"$L33\",\"6b7db0f9-93df-4af3-8a1b-855190fae4e6\",{\"theme\":\"custom\",\"customBgColor\":\"#F0EEE8\",\"imageSize\":\"small\",\"headingStyleAs\":\"web3-h6\",\"index\":2,\"eyebrow\":\"Research\",\"heading\":\"The Culture Funnel: You can’t align what isn’t in the data\",\"cta\":{\"label\":\"Read\",\"url\":\"the-culture-funnel-you-can-t-align-what-isn-t-in-the-data-2026-06-15\"},\"imageUrl\":\"https://cdn.sanity.io/images/rjtqmwfu/web3-prod/f60094ffccf2702cd7c3c2940fb02df5419fd9ae-1480x974.png\",\"moreThanTwoCards\":true,\"isAnimationTriggered\":true}]]}]]\n34:I[753189,[\"/_next/static/imm