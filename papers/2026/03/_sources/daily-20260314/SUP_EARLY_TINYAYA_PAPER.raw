em"><div class="translate-x-5 opacity-0 transition-[opacity,transform] duration-300 ease-out motion-reduce:translate-x-0 motion-reduce:opacity-100 motion-reduce:transition-none group-data-[nav-animated=true]/navContent:translate-x-0 group-data-[nav-animated=true]/navContent:opacity-100"><span class="text-web3-14 font-body leading-[120%] text-neutral-15">The future of work debate has an evidence<!-- --> <span class="whitespace-nowrap">problem<i class="icon-default icon-arrow-right text-icon-sm mb-0.5 ml-1.5 inline-block shrink-0 align-text-bottom transition-transform group-hover/featured:translate-x-1"></i></span></span></div></a></div></div></div></div><div class="min-h-0 flex-1 flex-col hidden" aria-hidden="true"><div class="min-h-0 flex-1 overflow-y-auto"><div><section class="px-4 pb-10"><ul class="flex list-none flex-col"><li><a class="group/nav-link flex min-h-[44px] flex-col items-start justify-center" href="/about"><div class="translate-x-5 opacity-0 transition-[opacity,transform] duration-300 ease-out motion-reduce:translate-x-0 motion-reduce:opacity-100 motion-reduce:transition-none group-data-[nav-animated=true]/navContent:translate-x-0 group-data-[nav-animated=true]/navContent:opacity-100"><span class="inline-flex items-center gap-x-1.5"><p class="text-web3-20 lg:text-web3-24 font-body">About</p></span></div></a></li><li><a class="group/nav-link flex min-h-[44px] flex-col items-start justify-center" href="/careers"><div class="translate-x-5 opacity-0 transition-[opacity,transform] duration-300 ease-out motion-reduce:translate-x-0 motion-reduce:opacity-100 motion-reduce:transition-none group-data-[nav-animated=true]/navContent:translate-x-0 group-data-[nav-animated=true]/navContent:opacity-100"><span class="inline-flex items-center gap-x-1.5"><p class="text-web3-20 lg:text-web3-24 font-body">Careers</p></span></div></a></li><li><a class="group/nav-link flex min-h-[44px] flex-col items-start justify-center" href="/newsroom"><div class="translate-x-5 opacity-0 transition-[opacity,transform] duration-300 ease-out motion-reduce:translate-x-0 motion-reduce:opacity-100 motion-reduce:transition-none group-data-[nav-animated=true]/navContent:translate-x-0 group-data-[nav-animated=true]/navContent:opacity-100"><span class="inline-flex items-center gap-x-1.5"><p class="text-web3-20 lg:text-web3-24 font-body">Newsroom</p></span></div></a></li></ul></section></div></div></div></div><div class="h-full"><!--$--><!--/$--><main id="main-content" role="main" tabindex="-1"><script type="application/ld+json">{"@context":"https://schema.org","@type":"Article","mainEntityOfPage":{"@type":"WebPage","@id":"https://cohere.com/research/papers/tiny-aya-bridging-scale-and-multilingual-depth-2026-02-17"},"headline":"Tiny Aya: Bridging Scale and Multilingual Depth","description":"Tiny Aya redefines what a small multilingual language model can achieve. Trained on 70 languages and refined through region-aware posttraining, it delivers","image":"https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?w=1920&q=80&fit=max&auto=format","datePublished":"2026-02-17T00:00:00.000Z","dateModified":"2026-02-17T00:00:00.000Z","author":{"@type":"Person","name":"Alejandro R. Salamanca, Diana Abagyan, Daniel D’souza, Ammar Khairi, David Mora, Saurabh Dash, Viraat Aryabumi, Sara Rajaee, Mehrnaz Mofakhami, Ananya Sahu, Thomas Euyang, Brittawnya Prince, Madeline Smith, Hangyu Lin, Acyr Locatelli, Sara Hooker, Tom Kocmi, Aidan Gomez, Ivan Zhang, Phil Blunsom, Nick Frosst, Joelle Pineau, Beyza Ermis, Ahmet Üstün,  Julia Kreutzer and Marzieh Fadaee"}}</script><section class="relative w-full px-4 lg:px-10 pt-28 md:pt-40 text-black"><div class="relative z-content mx-auto w-full max-w-web3-internal-wrapper"><div class="text-center"><div><p class="text-web3-14-eyebrow uppercase font-eyebrow mb-6 lg:mb-9">Feb 17, 2026</p><h1 class="text-web3-32-heading lg:text-web3-60 font-body mb-6 lg:mb-9 break-words lg:max-w-[904px] mx-auto max-w-[500px]">Tiny Aya: Bridging Scale and Multilingual Depth</h1><p class="text-web3-16 lg:text-web3-18 font-body mx-auto mb-6 max-w-[670px] lg:mb-9">Tiny Aya, a compact 3.35B-parameter multilingual model, achieves state-of-the-art translation and understanding across 70 languages through innovative training and region-specialized variants, offering an efficient, balanced path for practical multilingual AI deployment.</p></div><div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row sm:items-center lg:mb-[84px]"><div class="group relative z-10 inline-block" style="width:inherit"><a target="_blank" tabindex="0" aria-disabled="false" class="[&amp;&gt;span]:first-letter:uppercase relative flex w-fit items-center justify-center transition-all duration-300 ease-button-gradient cursor-pointer bg-neutral-15 text-pureWhite web3-primary-solid-btn rounded-full px-6 py-3 border-2 border-transparent focus-visible:border-white focus-visible:shadow-[0_0_0_2px_#4C6EE6] focus-visible:outline-none [&amp;&gt;*]:text-web3-18 gap-2 outline-none" href="https://arxiv.org/abs/2603.11510"><span class="text-web3-16 lg:text-web3-18 font-body">Read the paper</span><span class="flex shrink-0 items-center"><i class="icon-default icon-arrow-up-right text-icon-md"></i></span></a></div></div></div><img alt="" class="mx-auto mb-7 h-auto w-full max-w-[900px] rounded-lg lg:mb-10" srcSet="https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?auto=format&amp;fit=max&amp;q=80&amp;w=250 250w, https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?auto=format&amp;fit=max&amp;q=80&amp;w=500 500w, https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?auto=format&amp;fit=max&amp;q=80&amp;w=750 750w, https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?auto=format&amp;fit=max&amp;q=80&amp;w=1000 1000w" src="https://cdn.sanity.io/images/rjtqmwfu/web3-prod/ff6d97ec8ebae66f1b250ac4a9fba9efd682dbaa-1000x563.png?auto=format&amp;fit=max&amp;q=80&amp;w=1000" width="1000" height="563"/></div></section><div><div class="mx-auto mb-7 max-w-[670px] px-4 lg:mb-12 lg:px-0"><p class="text-web3-20 lg:text-web3-24 font-body">Authors</p><br/><p class="text-web3-16 font-body">Alejandro R. Salamanca, Diana Abagyan, Daniel D’souza, Ammar Khairi, David Mora, Saurabh Dash, Viraat Aryabumi, Sara Rajaee, Mehrnaz Mofakhami, Ananya Sahu, Thomas Euyang, Brittawnya Prince, Madeline Smith, Hangyu Lin, Acyr Locatelli, Sara Hooker, Tom Kocmi, Aidan Gomez, Ivan Zhang, Phil Blunsom, Nick Frosst, Joelle Pineau, Beyza Ermis, Ahmet Üstün,  Julia Kreutzer and Marzieh Fadaee</p></div><div class="mx-auto max-w-[670px] px-4 pb-9 lg:px-0 lg:pb-[60px]"><p class="text-web3-20 lg:text-web3-24 font-body">Abstract</p><br/><span class="text-web3-16 font-body"><div class="[&amp;_p_a]:!inline portable-text-breaks"><span class="">Tiny Aya redefines what a small multilingual language model can achieve. Trained on 70 languages and refined through region-aware posttraining, it delivers state-of-the-art in translation quality, strong multilingual understanding, and high-quality target-language generation, all with just 3.35B parameters. The release includes a pretrained foundation model, a globally balanced instruction-tuned variant, and three region-specialized models targeting languages from Africa, South Asia, Europe, Asia-Pacific, and West Asia. This report details the training strategy, data composition, and comprehensive evaluation framework behind Tiny Aya, and presents an alternative scaling path for multilingual AI: one centered on efficiency, balanced performance across languages, and practical deployment.</span></div></span></div><!--$?--><template id="B:0"></template><!--/$--><div class="mx-auto max-w-[670px]"><hr class="pt-6 lg:pt-9"/><div class="flex flex-wrap gap-1 px-4 pb-12 md:px-0 lg:pb-[84px]"><button aria-pressed="false" class="box-border inline-flex items-center justify-center gap-2.5 rounded-full bg-transparent py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 ring-offset-white dark:ring-offset-neutral-950 px-3 border border-neutral-15 text-neutral-15 hover:border-transparent hover:bg-neutral-15 hover:text-pureWhite" variant="filter" type="button"><span class="text-web3-14 font-body flex items-center justify-center gap-2.5"><span class="max-w-full min-w-0 truncate text-center">multilingual</span></span></button><button aria-pressed="false" class="box-border inline-flex items-center justify-center gap-2.5 rounded-full bg-transparent py-1.5 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 ring-offset-white dark:ring-offset-neutral-950 px-3 border border-neutral-15 text-neutral-15 hover:border-transparent hover:bg-neutral-15 hover:text-pureWhite" variant="filter" type="button"><span class="text-web3-14 font-body flex items-center justify-center gap-2.5"><span class="max-w-full min-w-0 truncate text-center">Efficiency</span></span></button></div></div></div><p class="text-web3-24-heading lg:text-web3-32 font-body mx-auto mb-9 max-w-web3-internal-wrapper px-4 lg:px-10">Related works</p><div class="flex w-full flex-col lg:grid gap-6 items-center justify-center lg:place-content-center lg:grid-cols-[repeat(3,1fr)] mx-auto max-w-web3-internal-wrapper px-4 lg:px-10 pb-14 lg:pb-36"><a href="unlocking-reasoning-capability-on-machine-translation-in-large-language-models-2026-02-16" class="group/calloutCard relative flex h-full w-full max-w-[617px] flex-col overflow-hidden rounded-lg lg:rounded-xl callout-module__BRueBa__cardSvg" target="_self"><div class="flex w-full flex-1 flex-col justify-between rounded-t-lg p-4 lg:rounded-t-xl text-volcanic-900" style="background-color:#F0EEE8"><div><div class="relative mb-5 w-full overflow-hidden rounded-[6px] md:rounded-[8px] aspect-[2/1] motion-s