    <div class="row-card__body">
        
          <a class="row-card__heading glue-link" href=https://research.google/pubs/inhibitory-normalization-of-error-signals-improves-learning-in-neural-circuits/ >
            
              Inhibitory normalization of error signals improves learning in neural circuits
            
          </a>
        
        <div class="row-card__subheading">
          
            
              
                
                  
                    <div class="row-card__subheading__item small-text">
                      
                        Roy Henha Eyono
                      
                    </div>
                
              
            
              
                
                  
                    <div class="row-card__subheading__spacer"></div>
