<tr id="A1.T5.2.6" class="ltx_tr">
<td id="A1.T5.2.6.1" class="ltx_td ltx_align_left" style="padding-left:2.8pt;padding-right:2.8pt;">Rollout (<math id="A1.T5.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>)</td>
<td id="A1.T5.2.6.2" class="ltx_td ltx_align_center" style="padding-left:2.8pt;padding-right:2.8pt;">20</td></tr>
<tr id="A1.T5.2.7" class="ltx_tr">
