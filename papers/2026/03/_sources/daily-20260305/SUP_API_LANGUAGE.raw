      <name>Kyuhan Koh</name>
    </author>
    <arxiv:doi>10.1016/j.knosys.2026.117071</arxiv:doi>
    <link rel="related" href="https://doi.org/10.1016/j.knosys.2026.117071" title="doi"/>
