></g></g><g style="--ltx-stroke-color:#A6A6A6;--ltx-fill-color:#A6A6A6;" fill="#A6A6A6" stroke="#A6A6A6" transform="matrix(1.0 0.0 0.0 1.0 -89.54 166.52)"><foreignObject style="--ltx-fo-width:13.21em;--ltx-fo-height:0.61em;--ltx-fo-depth:0.2em;font-size:9.8pt;" height="11.07" overflow="visible" transform="matrix(1 0 0 -1 0 8.3)" width="179.09"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.8" class="ltx_text ltx_font_bold" style="font-size:80%;--ltx-fg-color:#A6A6A6;">Four-Layer Governance (§4.2)</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#E2A4A4;--ltx-fill-color:#F6E4E4;" fill="#F6E4E4" stroke="#E2A4A4"><path d="M 108.84 154.53 L -108.84 154.53 C -111.9 154.53 -114.38 152.05 -114.38 148.99 L -114.38 138.41 C -114.38 135.35 -111.9 132.87 -108.84 132.87 L 108.84 132.87 C 111.9 132.87 114.38 135.35 114.38 138.41 L 114.38 148.99 C 114.38 152.05 111.9 154.53 108.84 154.53 Z M -114.38 132.87"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 -109.77 140.93)"><foreignObject style="--ltx-fo-width:18.67em;--ltx-fo-height:0.65em;--ltx-fo-depth:0.18em;font-size:8.5pt;" height="9.84" overflow="visible" transform="matrix(1 0 0 -1 0 7.69)" width="219.53"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F2.pic1.9" class="ltx_text" style="font-size:80%;">Constitution Layer — immutable red lines</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFCC99;--ltx-fill-color:#FFF2E6;" fill="#FFF2E6" stroke="#FFCC99"><path d="M 114.17 126.97 L -114.17 126.97 C -117.23 126.97 -119.71 124.49 -119.71 121.43 L -119.71 110.85 C -119.71 107.79 -117.23 105.31 -114.17 105.31 L 114.17 105.31 C 117.23 105.31 119.71 107.79 119.71 110.85 L 119.71 121.43 C 119.71 124.49 117.23 126.97 114.17 126.97 Z M -119.71 105.31"></path></g><g style="--ltx-stroke-color:#000000;--l