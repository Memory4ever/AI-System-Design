<td id="S5.T1.5.10.3" class="ltx_td ltx_align_right ltx_border_bb" style="padding:0.6pt 5.0pt;"><span id="S5.T1.5.10.3.1" class="ltx_text" style="font-size:70%;">280,885</span></td></tr>
