<td id="S5.T1.5.6.3" class="ltx_td ltx_align_right" style="padding:0.6pt 5.0pt;"><span id="S5.T1.5.6.3.1" class="ltx_text" style="font-size:70%;">29,657</span></td></tr>
<tr id="S5.T1.5.7" class="ltx_tr">
