<td id="S5.T1.5.2.4" class="ltx_td ltx_align_right ltx_border_t" style="padding:0.6pt 5.0pt;"><span id="S5.T1.5.2.4.1" class="ltx_text" style="font-size:70%;">41,072</span></td></tr>
