<td id="S5.T1.5.1.4" class="ltx_td ltx_align_right ltx_border_tt" style="padding:0.6pt 5.0pt;"><span id="S5.T1.5.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Yelp</span></td></tr>
