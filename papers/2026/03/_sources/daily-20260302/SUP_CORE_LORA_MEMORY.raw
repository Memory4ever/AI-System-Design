nt_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx110.75" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">single</span><span id="lstnumberx110.76" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx110.77" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">key</span><span id="lstnumberx110.78" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">:</span><span id="lstnumberx110.79" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx110.80" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx110.81" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">rewrite</span><span id="lstnumberx110.82" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#000000;">".</span>
