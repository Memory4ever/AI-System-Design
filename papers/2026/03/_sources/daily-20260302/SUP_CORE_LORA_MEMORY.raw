<figure id="A12.F18.fig4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.01097v1/x5.svg" id="A12.F18.g4" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/330;" width="476" height="330"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A12.F18.fig5" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.01097v1/x6.svg" id="A12.F18.g5" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/330;" width="476" height="330"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="A12.F18.fig6" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.01097v1/x7.svg" id="A12.F18.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/330;" width="476" height="330"></object>
