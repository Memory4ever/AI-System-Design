</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 16.85 12.92)"><foreignObject style="--ltx-fo-width:44.54em;--ltx-fo-height:81.11em;--ltx-fo-depth:0em;font-size:10pt;" height="1122.33" overflow="visible" transform="matrix(1 0 0 -1 0 1122.33)" width="616.31"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S5.SS3.p6.pic1.2" class="ltx_inline-logical-block ltx_minipage ltx_align_bottom" style="width:44.54em;">
<span id="S5.SS3.p6.pic1.p2" class="ltx_para">
