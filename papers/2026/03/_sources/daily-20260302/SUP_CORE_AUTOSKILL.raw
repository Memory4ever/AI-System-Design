foreignObject></g></g></svg></span> <span class="ltx_inline-block"><svg id="p3.pic1.pic14" class="ltx_picture" height="25.05" overflow="visible" style="vertical-align:-9.07px" version="1.1" viewBox="0 0 65.13 25.05" width="65.13"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,25.05) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#EAF2FB;" fill="#EAF2FB" fill-opacity="1.0"><path style="stroke:none" d="M 0 7.87 L 0 17.18 C 0 21.53 3.53 25.05 7.87 25.05 L 57.26 25.05 C 61.61 25.05 65.13 21.53 65.13 17.18 L 65.13 7.87 C 65.13 3.53 61.61 0 57.26 0 L 7.87 0 C 3.53 0 0 3.53 0 7.87 Z"></path></g><g style="--ltx-fill-color:#EAF2FB;" fill="#EAF2FB" fill-opacity="1.0"><path style="stroke:none" d="M 0 7.87 L 0 17.18 C 0 21.53 3.53 25.05 7.87 25.05 L 57.26 25.05 C 61.61 25.05 65.13 21.53 65.13 17.18 L 65.13 7.87 C 65.13 3.53 61.61 0 57.26 0 L 7.87 0 C 3.53 0 0 3.53 0 7.87 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 11.81 9.07)"><foreignObject style="--ltx-fo-width:3em;--ltx-fo-height:0.7em;--ltx-fo-depth:0.2em;font-size:10pt;" height="12.45" overflow="visible" transform="matrix(1 0 0 -1 0 9.69)" width="41.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">帮我算命</span></span></foreignObject></g></g></svg></span> <span class="ltx_inline-block"><svg id="p3.pic1.pic15" class="ltx_picture" height="25.05" overflow="visible" style="vertical-align:-9.07px" version="1.1" viewBox="0 0 85.89 25.05" width="85.89"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,25.05) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#EAF2FB;" fill="#EAF2FB" fill-opacity="1.0"><path style="stroke:none" d="M 0 7.87 L 0 17.18 C 0 21.53 3.53 25.05 7.87 25.05 L 78.01 25.05 C 82.36 25.05 85.89 21.53 85.89 17.18 L 85.89 7.87 C 85.89 3.53 82.36 0 78.01 0 L 7.87 0 C 3.53 0 0