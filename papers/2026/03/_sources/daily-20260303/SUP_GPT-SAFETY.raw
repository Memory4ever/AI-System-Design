stant&#34;:{&#34;value&#34;:0.92,&#34;display&#34;:&#34;0.920&#34;},&#34;gpt-5.3-instant&#34;:{&#34;value&#34;:0.911,&#34;display&#34;:&#34;0.911&#34;}},&#34;valueDecimals&#34;:3}]}" class="w-full min-w-0"> <div class="chart-row flex w-full min-w-0 flex-col gap-2.5"> <div class="controls flex w-full min-w-0 flex-wrap items-center gap-2"> <label data-role="ds-wrapper" class="flex w-full min-w-0 flex-wrap items-center gap-2 text-primary-100 md:w-auto">
Category
<select data-role="ds" class="min-w-0 flex-1 rounded border border-primary-12 bg-secondary-100 px-2 py-1 text-primary-100 md:ml-1 md:min-w-64 md:flex-none"></select> </label> </div> <div class="chart-wrapper flex min-w-0 flex-col gap-3"> <div class="chart-container min-w-0 w-full overflow-x-auto" data-role="chart"> <canvas id="tbl-2-canvas" data-role="canvas" width="480" height="400" class="block h-auto w-full max-w-full"></canvas> </div> <div class="table-container" data-role="table" hidden></div> <div class="footnotes-container" data-role="footnotes"></div> </div> </div> <astro-island uid="Z1tz260" component-url="/_astro/ChartIsland.BiXfHJrt.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;rootId&quot;:[0,&quot;tbl-2-root&quot;]}" ssr client="load" opts="{&quot;name&quot;:&quot;ChartIsland&quot;,&quot;value&quot;:true}"></astro-island> </div>  </article><article> <div class="system-card-richtext"><p>*Ahead of the GPT-5.3 Instant launch, we implemented dynamic
multi-turn evaluations for mental health, emotional reliance, and
self-harm that simulate extended conversations across these domains.
Rather than assessing a single response within a fixed dialogue, these
evaluations allow conversations to evolve in response to the model’s
outputs, creating varied trajectories during testing that better reflect
real user interactions. This approach helps identify potential issues
that may only emerge over the course of long exchanges and provides an
even more rigorous test than prior static multi-turn methods. By
utilizing realistic, yet adversarial user simulations, these evaluations
have enabled continued improvements in safety performance, particularly
in areas where earlier evaluation frameworks had reached saturation.</p></div><div class="system-card-richtext"><p>Our standard evaluations measure whether the final model response
violates our policies. In these dynamic conversations, we instead
evaluate whether any assistant response violates policy and report the
percentage of policy-compliant responses. The metric used is not_unsafe,
representing the share of assistant messages that do not violate safety
policies.</p></div> </article>  </div> </section><section id="health-performance" class="scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--system-card-toc-offset,0px)+var(--anchor-scroll-clearance))] md:scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--anchor-scroll-clearance))] mt-2xl md:mt-3xl [&#38;>header]:mb-md" data-section data-section-slug="health-performance" data-section-anchor="health-performance" data-section-id="sec-4"> <header id="section.4" class="relative scroll-mt-[inherit]"> <h2 class="text-h2_5 m-0! pe-lg"> 4. Health Performance </h2> <div class="not-prose absolute right-0 top-0"> <astro-island uid="LzLYb" component-url="/_astro/PermalinkButton.BujwbSR_.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-3-instant/health-performance&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 4. Health Performance&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 4. Health Performance" title="Copy permalink to 4. Health Performance" data-analytics-id="copy-permalink-to-4-health-performance" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button><!--astro:end--></astro-island> </div> </header> <div class="*:first:mt-0">    </div> </section><section id="healthbench" class="scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--system-card-toc-offset,0px)+var(--anchor-scroll-clearance))] md:scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--anchor-scroll-clearance))] [&#38;>header]:mb-sm" data-section data-section-slug="healthbench" data-section-anchor="healthbench" data-section-id="sec-4-1"> <header id="subsection.4.1" class="relative scroll-mt-[inherit]"> <h2 class="text-h3 m-0! pe-lg"> 4.1 HealthBench </h2> <div class="not-prose absolute right-0 top-0"> <astro-island uid="jhDKW" component-url="/_astro/PermalinkButton.BujwbSR_.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-3-instant/healthbench&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 4.1 HealthBench&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 4.1 HealthBench" title="Copy permalink to 4.1 HealthBench" data-analytics-id="copy-permalink-to-4-1-healthbench" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button><!--astro:end--></astro-island> </div> </header> <div class="*:first:mt-0">  <article> <div class="system-card-richtext"><p>Chatbots can empower consumers to better understand their health and
help health professionals deliver better care <span class="citation" data-cites="openaigpt52025blog">[<a class="citation-link" data-cite="openaigpt52025blog" href="/gpt-5-3-instant/references#ref-openaigpt52025blog" title="OpenAI. “Introducing GPT-5.” Available at: https://openai.com/index/introducing-gpt-5/ ." aria-label="Reference 1: OpenAI. “Introducing GPT-5.” Available at: https://openai.com/index/introducing-gpt-5/ .">1</a>]</span> <span class="citation" data-cites="openaipendaclinicalcopilot2025">[<a class="citation-link" data-cite="openaipendaclinicalcopilot2025" href="/gpt-5-3-instant/references#ref-openaipendaclinicalcopilot2025" title="OpenAI. “Pioneering an AI clinical copilot with Penda health.” Available at: https://openai.com/index/ai-clinical-copilot-penda-health/ ." aria-label="Reference 2: OpenAI. “Pioneering an AI clinical copilot with Penda health.” Available at: https://openai.com/index/ai-clinical-copilot-penda-health/ .">2</a>]</span>. We evaluate GPT-5.3
on HealthBench <span class="citation" data-cites="openaihealthbench2025">[<a class="citation-link" data-cite="openaihealthbench2025" href="/gpt-5-3-instant/references#ref-openaihealthbench2025" title="OpenAI. “Introducing HealthBench.” Available at: https://openai.com/index/healthbench/ ." aria-label="Reference 3: OpenAI. “Introducing HealthBench.” Available at: https://openai.com/index/healthbench/ .">3</a>]</span>, an evaluation of health
performance and safety. HealthBench comprises 5,000 realistic
(potentially multi-turn) health conversations. Model responses are
evaluated with example-specific rubrics. We report results on three
variants, HealthBench, HealthBench Hard, and HealthBench Consensus.</p></div> </article><article id="tbl-3" class="scroll-mt-[max(6rem,calc(var(--site-nav-sticky-offset)_+_var(--system-card-banner-h,0px)_+_var(--system-card-toc-offset,0px)))] md:scroll-mt-[max(6rem,calc(var(--site-nav-sticky-offset)_+_var(--system-card-banner-h,0px)))] not-prose my-12" aria-labelledby="tbl-3-heading" data-block data-block-ref="tbl-3" data-block-section="healthbench" tabindex="-1"> <div class="not-prose mb-2xs flex min-w-0 flex-col gap-2xs md:flex-row md:items-start md:justify-between"> <h3 id="tbl-3-heading" class="text-h4 min-w-0 font-normal text-primary-100 md:flex-1"> Table 3: HealthBench </h3> <div class="shrink-0 self-start"> <astro-island uid="2tnprP" component-url="/_astro/BlockActions.BmUAId7m.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;blockId&quot;:[0,&quot;tbl-3&quot;],&quot;chartId&quot;:[0,null],&quot;copyHref&quot;:[0,&quot;/gpt-5-3-instant/healthbench/tbl-3&quot;],&quot;figureHref&quot;:[0,null],&quot;figureKind&quot;:[0]}" ssr client="load" opts="{&quot;name&quot;:&quot;BlockActions&quot;,&quot;value&quot;:true}" await-children><div class="flex items-center gap-4xs"><button type="button" aria-label="Copy permalink" title="Copy permalink" data-analytics-id="copy-permalink" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.707c1.704-1.704 4.441-1.672 6.232.118 1.787 1.788 1.821 4.52.125 6.225l-.833.856a.75.75 0 0 1-1.076-1.047l.834-.855.007-.008c1.087-1.087 1.118-2.874-.118-4.11s-3.024-1.206-4.11-.12l-.007.007-.857.834a.75.75 0 0 1-1.046-1.074z" style="fill-opacity:1"/></svg></button></div><!--astro:end--></astro-island> </div> </div> <div class="scrollable rounded-md border border-primary-12 bg-secondary-100" data-scrollable-label="Scrollable content">  <table class="min-w-full border-collapse text-sm/snug text-primary-100"> <caption class="sr-only"> Table 3. HealthBench </caption> <thead> <tr> <th class="border-b border-primary-12 bg-primary-4 px-2 py-1 text-left text-primary-100" scope="col"><strong>Metric</strong></th><th class="border-b border-primary-12 bg-primary-4 px-2 py-1 text-left text-primary-100" scope="col"><strong>gpt-5.2-instant</strong></th><th class="border-b border-primary-12 bg-primary-4 px-2 py-1 text-left text-primary-100" scope="col"><strong>gpt-5.3-instant</strong></th> </tr> </thead> <tbody> <tr> <td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>HealthBench</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>55.4%</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>54.1%</div>  </td> </tr><tr> <td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>Hard</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>26.8%</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>25.9%</div>  </td> </tr><tr> <td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>Consensus</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>95.8%</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>95.3%</div>  </td> </tr><tr> <td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>Length</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>2101 chars</div>  </td><td class="border-b border-primary-12 px-2 py-1 align-top text-primary-100"> <div>2140 chars</div>  </td> </tr> </tbody> </table>  </div> <script type="module" src="/_astro/Scrollable.astro_astro_type_script_index_0_lang.SzTDgNh0.js"></script>   </article><article> <div class="system-card-richtext"><p>The major wins and losses below refer only to consensus-criteria
deltas greater than 2.0% versus GPT-5.2 instant.</p></div><div class="system-card-richtext"><p>Relative to GPT-5.2 instant, GPT-5.3 instant scores 54.1% on
HealthBench (-1.3%), 25.9% on Hard (-0.9%), and 95.3% on Consensus
(-0.5%); at 2140 chars on average (+1.9%), it has slightly worse
performance at essentially matched length. On consensus criteria, its
main strengths are better context-seeking when important information is
missing (+4.4%) and better hedging behavior in irreducible-uncertainty
settings (+4.0%). On consensus criteria, its main weaknesses are poorer
behavior in seeking context before referral (-10.1%), and lower accuracy
when local healthcare context may be pertinent but is not obvious
(-5.5%).</p></div> </article>  </div> </section><section id="references" class="scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--system-card-toc-offset,0px)+var(--anchor-scroll-clearance))] md:scroll-mt-[calc(var(--site-nav-sticky-offset)+var(--system-card-banner-h,0px)+var(--anchor-scroll-clearance))] mt-2xl md:mt-3xl [&#38;>header]:mb-md" data-section data-section-slug="references" data-section-anchor="references" data-section-id="sec-5"> <header id="section.5" class="relative scroll-mt-[inherit]"> <h2 class="text-h2_5 m-0! pe-lg"> 5. References </h2> <div class="not-prose absolute right-0 top-0"> <astro-island uid="1PGUFl" component-url="/_astro/PermalinkButton.BujwbSR_.js" component-export="default" renderer-url="/_astro/client.P6ud_8Vb.js" props="{&quot;href&quot;:[0,&quot;/gpt-5-3-instant/references&quot;],&quot;ariaLabel&quot;:[0,&quot;Copy permalink to 5. References&quot;]}" ssr client="idle" opts="{&quot;name&quot;:&quot;PermalinkButton&quot;,&quot;value&quot;:true}" await-children><button type="button" aria-label="Copy permalink to 5. References" title="Copy permalink to 5. References" data-analytics-id="copy-permalink-to-5-references" class="flex h-9 w-9 items-center justify-center rounded-full border border-primary-12 text-primary-80 transition hover:bg-primary-4 hover:text-primary-60 focus:outline focus:outline-2 focus:outline-primary-44"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3.534 6.094A.75.75 0 0 1 4.608 7.14l-.834.857-.006.007c-1.086 1.086-1.119 2.874.118 4.11 1.236 1.236 3.023 1.205 4.11.118l.008-.007.855-.834a.75.75 0 0 1 1.047 1.076l-.856.832c-1.705 1.697-4.437 1.663-6.225-.124-1.788-1.788-1.821-4.52-.124-6.225z" style="fill-opacity:1"/><path fill="currentColor" d="M9.47 5.47a.75.75 0 0 1 1.06 1.06l-4 4a.75.75 0 1 1-1.06-1.06z" style="fill-opacity:1"/><path fill="currentColor" d="M6.943 2.70