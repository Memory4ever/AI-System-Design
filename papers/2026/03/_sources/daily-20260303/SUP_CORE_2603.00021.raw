<tr id="A3.T5.2.1.4" class="ltx_tr">
<th id="A3.T5.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_r"><span id="A3.T5.2.1.4.1.1" class="ltx_text ltx_font_bold">max</span></th>
<td id="A3.T5.2.1.4.2" class="ltx_td ltx_align_center">99.29</td>
<td id="A3.T5.2.1.4.3" class="ltx_td ltx_align_center">0.40</td>
