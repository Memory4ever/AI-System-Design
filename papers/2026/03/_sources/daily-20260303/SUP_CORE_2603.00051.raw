<div id="lstnumberx3" class="ltx_listingline"><span id="lstnumberx3.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter">Given</span><span id="lstnumberx3.2" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx3.4" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter">scientific</span><span id="lstnumberx3.6" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter">paper</span><span id="lstnumberx3.8" class="ltx_text ltx_font_typewriter">,</span><span id="lstnumberx3.9" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.10" class="ltx_text ltx_lst_identifier ltx_font_typewriter">generate</span><span id="lstnumberx3.11" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter">a</span><span id="lstnumberx3.13" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter">list</span><span id="lstnumberx3.15" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter">of</span><span id="lstnumberx3.17" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter">three</span><span id="lstnumberx3.19" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter">very</span><span id="lstnumberx3.21" class="ltx_text ltx_lst_space ltx_font_typewriter"> </span><span id="lstnumberx3.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter">high</span><span id="lstn