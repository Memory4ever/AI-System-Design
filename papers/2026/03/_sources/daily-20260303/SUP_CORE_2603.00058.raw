<th id="S4.T1.5.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">% Applicability</th>
<th id="S4.T1.5.1.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">% Executability</th>
<th id="S4.T1.5.1.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">$ Cost</th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S4.T1.5.1.2" class="ltx_tr">
<th id="S4.T1.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">SWE-Agent</th>
<td id="S4.T1.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">10.7</td>
<td id="S4.T1.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">19.6</td>
<td id="S4.T1.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">16.3</td>
<td id="S4.T1.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">1.20</td></tr>
<tr id="S4.T1.5.1.3" class="ltx_tr">
<th id="S4.T1.5.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">AutoGPT</th>
<td id="S4.T1.5.1.3.2" class="ltx_td ltx_align_center">20.5</td>
<td id="S4.T1.5.1.3.3" class="ltx_td ltx_align_center">60.7</td>
<td id="S4.T1.5.1.3.4" class="ltx_td ltx_align_center">45.7</td>
<td id="S4.T1.5.1.3.5" class="ltx_td ltx_align_center">2.03</td></tr>
<tr id="S4.T1.5.1.4" class="ltx_tr">
<th id="S4.T1.5.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">CORE-Agent</th>
<td id="S4.T1.5.1.4.2" class="ltx_td ltx_align_center">21.4</td>
<td id="S4.T1.5.1.4.3" class="ltx_td ltx_align_center">46.4</td>
<td id="S4.T1.5.1.4.4" class="ltx_td ltx_align_center">39.1</td>
