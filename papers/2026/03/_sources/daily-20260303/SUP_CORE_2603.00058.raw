<figure id="A1.F10" class="ltx_figure"><span class="ltx_inline-block"><svg id="A1.F10.pic1" class="ltx_picture ltx_centering" height="43.7" overflow="visible" version="1.1" viewBox="0 0 477.38 43.7" width="477.38"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,43.7) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#000000;" fill="#000000" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 37.79 C 0 41.06 2.64 43.7 5.91 43.7 L 471.47 43.7 C 474.73 43.7 477.38 41.06 477.38 37.79 L 477.38 5.91 C 477.38 2.64 474.73 0 471.47 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 19.74 L 475.41 19.74 L 475.41 5.91 C 475.41 3.73 473.65 1.97 471.47 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 1.97 28.34)"><foreignObject style="--ltx-fo-width:34.22em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.15" overflow="visible" transform="matrix(1 0 0 -1 0 9.46)" width="473.51"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
