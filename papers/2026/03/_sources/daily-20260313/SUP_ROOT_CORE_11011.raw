            <span id="alg2.l5.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l5.m1" class="ltx_Math" alttext="e_{i}\leftarrow f_{\mathrm{enc}}(p_{i})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">e</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">enc</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">e_{i}\leftarrow f_{\mathrm{enc}}(p_{i})</annotation></semantics></math><span id="alg2.l5.4" class="ltx_text" style="font-size:90%;">
</span>
