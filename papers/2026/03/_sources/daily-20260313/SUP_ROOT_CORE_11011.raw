          <span id="alg1.l12.3" class="ltx_text ltx_font_bold" style="font-size:90%;">Execute:</span><span id="alg1.l12.4" class="ltx_text" style="font-size:90%;"> generate output with </span><math id="alg1.l12.m1" class="ltx_Math" alttext="m^{\star}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">⋆</mo></msup><annotation encoding="application/x-tex">m^{\star}</annotation></semantics></math><span id="alg1.l12.5" class="ltx_text" style="font-size:90%;">; optionally audit with </span><math id="alg1.l12.m2" class="ltx_Math" alttext="\tilde{m}" display="inline" intent=":literal"><semantics><mover accent="true"><mi mathsize="0.900em">m</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{m}</annotation></semantics></math><span id="alg1.l12.6" class="ltx_text" style="font-size:90%;">
