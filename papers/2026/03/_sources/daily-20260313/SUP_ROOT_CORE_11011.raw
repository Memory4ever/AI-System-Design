            <math id="alg2.l8.m1" class="ltx_Math" alttext="\{c_{i}\}_{i=1}^{N}\leftarrow\mathrm{KMeans}(\{x_{i}\},K)" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">N</mi></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mi mathsize="0.900em">KMeans</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">i</mi></msub><mo stretchy="false">}</mo></mrow><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{c_{i}\}_{i=1}^{N}\leftarrow\mathrm{KMeans}(\{x_{i}\},K)</annotation></semantics></math><span id="alg2.l8.3" class="ltx_text" style="font-size:90%;">
</span>
</div>
