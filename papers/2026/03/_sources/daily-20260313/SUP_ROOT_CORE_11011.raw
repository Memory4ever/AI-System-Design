          <span id="alg1.l10.3" class="ltx_text ltx_font_bold" style="font-size:90%;">Expose awareness cues:</span><span id="alg1.l10.4" class="ltx_text" style="font-size:90%;"> report delegation rationale using </span><math id="alg1.l10.m1" class="ltx_Math" alttext="(w_{m,\hat{c}},d_{\hat{c}})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">w</mi><mrow><mi mathsize="0.900em">m</mi><mo mathsize="0.900em">,</mo><mover accent="true"><mi mathsize="0.900em">c</mi><mo>^</mo></mover></mrow></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">d</mi><mover accent="true"><mi mathsize="0.900em">c</mi><mo>^</mo></mover></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><annotation encoding="application/x-tex">(w_{m,\hat{c}},d_{\hat{c}})</annotation></semantics></math><span id="alg1.l10.5" class="ltx_text" style="font-size:90%;"> and active strategy
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
