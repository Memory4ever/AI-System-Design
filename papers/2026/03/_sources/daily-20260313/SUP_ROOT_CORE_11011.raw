            <span id="alg2.l11.3" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span><span id="alg2.l11.4" class="ltx_text" style="font-size:90%;"> each cluster </span><math id="alg2.l11.m1" class="ltx_Math" alttext="c\in\{1,\dots,K\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">c</mi><mo mathsize="0.900em">∈</mo><mrow><mo stretchy="false">{</mo><mrow><mn mathsize="0.900em">1</mn><mo mathsize="0.900em">,</mo><mi mathsize="0.900em" mathvariant="normal">…</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">K</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">c\in\{1,\dots,K\}</annotation></semantics></math><span id="alg2.l11.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l11.6" class="ltx_text ltx_font_bold" style="font-size:90%;">do</span><span id="alg2.l11.7" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="alg2.l12.3" class="ltx_text" style="font-size:90%;">  </span><math id="alg2.l12.m1" class="ltx_Math" alttext="\mathcal{D}_{c}\leftarrow\{(i,y_{i})\in\mathcal{R}:c_{i}=c\}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒟</mi><mi mathsize="0.900em">c</mi></msub><mo mathsize="0.900em" stretchy="false">←</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">y</mi><mi mathsize="0.900em">i</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo mathsize="0.900em">∈</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℛ</mi></mrow><mo lspace="0.278em" mathsize="0.900em" rspace="0.278em">:</mo><mrow><msub><mi mathsize="0.900em">c</mi><mi mathsize="0.900em">i</mi></msub><mo mathsize="0.900em">=</mo><mi mathsize="0.900em">c</mi></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{D}_{c}\leftarrow\{(i,y_{i})\in\mathcal{R}:c_{i}=c\}</annotation></semantics></math><span id="alg2.l12.4" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg2.l13" class="ltx_listingline">
