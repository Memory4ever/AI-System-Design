            <span id="alg2.l30.3" class="ltx_text" style="font-size:90%;">  Evaluate on </span><math id="alg2.l30.m1" class="ltx_Math" alttext="\mathcal{R}_{\mathrm{test}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℛ</mi><mi mathsize="0.900em">test</mi></msub><annotation encoding="application/x-tex">\mathcal{R}_{\mathrm{test}}</annotation></semantics></math><span id="alg2.l30.4" class="ltx_text" style="font-size:90%;"> and record MSE
</span>
</div>
<div id="alg2.l31" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l31.1" class="ltx_text" style="font-size:80%;">31:</span></span>
              
              
            <span id="alg2.l31.3" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l31.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l31.5" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
