<tr id="A9.T14.5.10" class="ltx_tr">
<td id="A9.T14.5.10.1" class="ltx_td ltx_align_left">GAE</td>
<td id="A9.T14.5.10.2" class="ltx_td ltx_align_center">64</td>
<td id="A9.T14.5.10.3" class="ltx_td ltx_align_center"><span id="A9.T14.5.10.3.1" class="ltx_text ltx_font_bold">78.3</span></td>
