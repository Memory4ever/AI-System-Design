<section id="A6" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix F </span>Algorithm of Patch Convolution</h2>

<div id="A6.p1" class="ltx_para">
<p id="A6.p1.1" class="ltx_p">As detailed in Algorithm <a href="#alg1" title="Algorithm 1 ‣ Appendix F Algorithm of Patch Convolution ‣ Geometric Autoencoder for Diffusion Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">1</span></a>, our patch-wise module is implemented through a two-step procedure designed to optimize computational efficiency. Specifically, we first perform a patch-wise convolution that projects each local spatial block directly into a high-dimensional feature vector. Subsequently, the resulting feature map is re-partitioned and flattened into the target latent patch format.</p>
</div>
<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Patch Convolution with Window Reshaping</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Feature map <math id="alg1.l0.m1" class="ltx_Math" alttext="F\in\mathbb{R}^{B\times H\times W\times C}" display="inline" intent=":literal"><semantics><mrow><mi>F</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>C</mi></mrow></msup></mrow><annotation encoding="application/x-tex">F\in\mathbb{R}^{B\times H\times W\times C}</annotation></semantics></math>, window size <math id="alg1.l0.m2" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math>.

</div>
<div id="alg1.l0a" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0a.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Latent map <math id="alg1.l0a.m1" class="ltx_Math" alttext="Z\in\mathbb{R}^{B\times H\times W\times d}" display="inline" intent=":literal"><semantics><mrow><mi>Z</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">Z\in\mathbb{R}^{B\times H\times W\times d}</annotation></semantics></math>.

</div>
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           {Phase 1: Local Window Partitioning}

</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           <math id="alg1.l2.m1" class="ltx_Math" alttext="F_{win}\leftarrow\text{WindowPartition}(F,w)" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">←</mo><mrow><mtext>WindowPartition</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>F</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{win}\leftarrow\text{WindowPartition}(F,w)</annotation></semantics></math> {Shape: <math id="alg1.l2.m2" class="ltx_Math" alttext="[B\cdot\frac{HW}{w^{2}},w^{2},C]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><msup><mi>w</mi><mn>2</mn></msup></mfrac></mrow><mo>,</mo><msup><mi>w</mi><mn>2</mn></msup><mo>,</mo><mi>C</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[B\cdot\frac{HW}{w^{2}},w^{2},C]</annotation></semantics></math>}

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           <math id="alg1.l3.m1" class="ltx_Math" alttext="X\leftarrow\text{Flatten}(F_{win})" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo stretchy="false">←</mo><mrow><mtext>Flatten</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>F</mi><mrow><mi>w</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X\leftarrow\text{Flatten}(F_{win})</annotation></semantics></math> {Flatten each window to <math id="alg1.l3.m2" class="ltx_Math" alttext="[B\cdot\frac{HW}{w^{2}},w^{2}\cdot C]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>B</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><msup><mi>w</mi><mn>2</mn></msup></mfrac></mrow><mo>,</mo><mrow><msup><mi>w</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>C</mi></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[B\cdot\frac{HW}{w^{2}},w^{2}\cdot C]</annotation></semantics></math>}

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
           {Phase 2: Patch-wise Joint Projection}

</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
           <math id="alg1.l5.m1" class="ltx_Math" alttext="Y\leftarrow XW_{proj}" display="inline" intent=":literal"><semantics><mrow><mi>Y</mi><mo stretchy="false">←</mo><mrow><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">Y\leftarrow XW_{proj}</annotation></semantics></math>, where <math id="alg1.l5.m2" class="ltx_Math" alttext="W_{proj}\in\mathbb{R}^{(w^{2}\cdot C)\times(w^{2}\cdot d)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>j</mi></mrow></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>w</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>C</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>w</mi><mn>2</mn></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>d</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow><annotation encoding="application/x-tex">W_{proj}\in\mathbb{R}^{(w^{2}\cdot C)\times(w^{2}\cdot d)}</annotation></semantics></math>

</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
           {Phase 3: Spatial Structure Reconstruction}

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
