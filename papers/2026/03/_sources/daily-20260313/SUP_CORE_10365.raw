<td id="S4.T1.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="3">Autoencoder</td>
<td id="S4.T1.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:10.0pt;padding-right:10.0pt;" colspan="2">Teacher</td></tr>
