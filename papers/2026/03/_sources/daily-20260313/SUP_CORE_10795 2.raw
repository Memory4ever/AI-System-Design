<td id="S3.T1.10.9.2" class="ltx_td ltx_align_center"><span id="S3.T1.10.9.2.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.10.9.3" class="ltx_td ltx_align_center"><span id="S3.T1.10.9.3.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.10.9.4" class="ltx_td ltx_align_left"><span id="S3.T1.10.9.4.1" class="ltx_text" style="font-size:90%;">Feb 5, 2026</span></td>
<td id="S3.T1.10.9.5" class="ltx_td ltx_align_left"><span id="S3.T1.10.9.5.1" class="ltx_text" style="font-size:90%;">4 reasoning levels</span></td></tr>
<tr id="S3.T1.10.10" class="ltx_tr">
<td id="S3.T1.10.10.1" class="ltx_td ltx_align_left"><span id="S3.T1.10.10.1.1" class="ltx_text" style="font-size:90%;">GPT-5.3-Codex (agentic)</span></td>
<td id="S3.T1.10.10.2" class="ltx_td"></td>
<td id="S3.T1.10.10.3" class="ltx_td ltx_align_center"><span id="S3.T1.10.10.3.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.10.10.4" class="ltx_td ltx_align_left"><span id="S3.T1.10.10.4.1" class="ltx_text" style="font-size:90%;">Feb 5, 2026</span></td>
<td id="S3.T1.10.10.5" class="ltx_td ltx_align_left"><span id="S3.T1.10.10.5.1" class="ltx_text" style="font-size:90%;">multi-agent enabled</span></td></tr>
<tr id="S3.T1.10.11" class="ltx_tr">
<td id="S3.T1.10.11.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S3.T1.10.11.1.1" class="ltx_text" style="font-size:90%;">Gemini</span></td>
<td id="S3.T1.10.11.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.10.11.2.1" class="ltx_text" style="font-size:90%;">Gemini 3 Pro Preview</span></td>
<td id="S3.T1.10.11.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.10.11.3.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.10.11.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S3.T1.10.11.4.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S3.T1.10.11.5" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.10.11.5.1" class="ltx_text" style="font-size:90%;">Nov 18, 2025</span></td>
<td id="S3.T1.10.11.6" class="ltx_td ltx_border_t"></td></tr>
<tr id="S3.T1.10.12" class="ltx_tr">
