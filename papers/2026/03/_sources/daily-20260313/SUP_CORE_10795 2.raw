<td id="S4.T6.2.2.4" class="ltx_td ltx_align_center ltx_border_t">3.33%</td></tr>
<tr id="S4.T6.2.3" class="ltx_tr">
<th id="S4.T6.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GPT-5.2</th>
<td id="S4.T6.2.3.2" class="ltx_td ltx_align_center">100.00%</td>
<td id="S4.T6.2.3.3" class="ltx_td ltx_align_center">0.83%</td>
<td id="S4.T6.2.3.4" class="ltx_td ltx_align_center">0.83%</td></tr>
