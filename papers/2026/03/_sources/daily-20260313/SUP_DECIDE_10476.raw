            <span id="alg1.l15.3" class="ltx_text" style="font-size:90%;">   Compute GRPO loss over dialogue tokens of </span><math id="alg1.l15.m1" class="ltx_Math" alttext="\{D_{i}\}_{i=1}^{G}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.900em">D</mi><mi mathsize="0.900em">i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi mathsize="0.900em">i</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">1</mn></mrow><mi mathsize="0.900em">G</mi></msubsup><annotation encoding="application/x-tex">\{D_{i}\}_{i=1}^{G}</annotation></semantics></math><span id="alg1.l15.4" class="ltx_text" style="font-size:90%;"> using </span><math id="alg1.l15.m2" class="ltx_Math" alttext="\hat{A}_{i}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathsize="0.900em">A</mi><mo>^</mo></mover><mi mathsize="0.900em">i</mi></msub><annotation encoding="application/x-tex">\hat{A}_{i}</annotation></semantics></math><span id="alg1.l15.5" class="ltx_text" style="font-size:90%;">
</span>
</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:90%;">16:</span></span>
              
              
            <span id="alg1.l16.3" class="ltx_text" style="font-size:90%;">   Update </span><math id="alg1.l16.m1" class="ltx_Math" alttext="\pi_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">π</mi><mi mathsize="0.900em">θ</mi></msub><annotation encoding="application/x-tex">\pi_{\theta}</annotation></semantics></math><span id="alg1.l16.4" class="ltx_text" style="font-size:90%;"> via gradient descent
</span>
</div>
