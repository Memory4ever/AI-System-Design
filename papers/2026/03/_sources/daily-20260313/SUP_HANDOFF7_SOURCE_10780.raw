<td id="S6.T4.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.2.2.1" class="ltx_text" style="font-size:90%;">5.456</span></td>
<td id="S6.T4.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.2.3.1" class="ltx_text" style="font-size:90%;">5.66</span></td>
<td id="S6.T4.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.2.4.1" class="ltx_text" style="font-size:90%;">91.44</span></td></tr>
<tr id="S6.T4.5.3" class="ltx_tr">
<td id="S6.T4.5.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.3.1.1" class="ltx_text"></span><span id="S6.T4.5.3.1.2" class="ltx_text" style="font-size:90%;">
