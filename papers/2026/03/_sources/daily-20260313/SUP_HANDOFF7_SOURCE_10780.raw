<td id="S6.T4.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Time (s)</span></td>
<td id="S6.T4.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Aesthetic</span></td>
<td id="S6.T4.5.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">VQA</span></td></tr>
