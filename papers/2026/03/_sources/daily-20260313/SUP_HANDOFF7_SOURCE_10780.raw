<td id="S6.T4.5.4.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.4.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">5.655 (+3.6%)</span></td>
