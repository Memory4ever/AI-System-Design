               <span id="alg2.l8.3" class="ltx_text ltx_font_bold">ProcessToken</span>(<math id="alg2.l8.m1" class="ltx_Math" alttext="\boldsymbol{c},\boldsymbol{c}_{\emptyset},\boldsymbol{i}_{\text{sorted}},r_{\text{deg}}" display="inline" intent=":literal"><semantics><mrow><mi>𝒄</mi><mo>,</mo><msub><mi>𝒄</mi><mi mathvariant="normal">∅</mi></msub><mo>,</mo><msub><mi>𝒊</mi><mtext>sorted</mtext></msub><mo>,</mo><msub><mi>r</mi><mtext>deg</mtext></msub></mrow><annotation encoding="application/x-tex">\boldsymbol{c},\boldsymbol{c}_{\emptyset},\boldsymbol{i}_{\text{sorted}},r_{\text{deg}}</annotation></semantics></math>):

</div>
