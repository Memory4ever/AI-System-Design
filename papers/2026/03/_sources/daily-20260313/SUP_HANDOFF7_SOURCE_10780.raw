                 <math id="alg2.l9.m1" class="ltx_Math" alttext="\boldsymbol{m}\leftarrow\mathrm{BuildMask}(\boldsymbol{i}_{\text{sorted}},r_{\text{deg}})" display="inline" intent=":literal"><semantics><mrow><mi>𝒎</mi><mo stretchy="false">←</mo><mrow><mi>BuildMask</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>𝒊</mi><mtext>sorted</mtext></msub><mo>,</mo><msub><mi>r</mi><mtext>deg</mtext></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{m}\leftarrow\mathrm{BuildMask}(\boldsymbol{i}_{\text{sorted}},r_{\text{deg}})</annotation></semantics></math>

</div>
<div id="alg2.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                
                
                 <math id="alg2.l10.m1" class="ltx_Math" alttext="\boldsymbol{c}_{\text{deg}}\leftarrow\boldsymbol{m}\odot\boldsymbol{c}+(1-\boldsymbol{m})\odot\boldsymbol{c}_{\emptyset}" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝒄</mi><mtext>deg</mtext></msub><mo stretchy="false">←</mo><mrow><mrow><mi>𝒎</mi><mo lspace="0.222em" rspace="0.222em">⊙</mo><mi>𝒄</mi></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mi>𝒎</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⊙</mo><msub><mi>𝒄</mi><mi mathvariant="normal">∅</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{c}_{\text{deg}}\leftarrow\boldsymbol{m}\odot\boldsymbol{c}+(1-\boldsymbol{m})\odot\boldsymbol{c}_{\emptyset}</annotation></semantics></math>

</div>
<div id="alg2.l11" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
                
                
               <span id="alg2.l11.3" class="ltx_text ltx_font_bold">return</span>  <math id="alg2.l11.m1" class="ltx_Math" alttext="\boldsymbol{c}_{\text{deg}}" display="inline" intent=":literal"><semantics><msub><mi>𝒄</mi><mtext>deg</mtext></msub><annotation encoding="application/x-tex">\boldsymbol{c}_{\text{deg}}</annotation></semantics></math>

</div>
<div id="alg2.l12" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
                
                
               <span id="alg2.l12.3" class="ltx_text ltx_font_bold">// Main sampling process</span>

</div>
<div id="alg2.l13" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
                
                
               <span id="alg2.l13.3" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l13.m1" class="ltx_Math" alttext="t=T,T-1,\ldots,1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>t</mi><mo>=</mo><mi>T</mi></mrow><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">t=T,T-1,\ldots,1</annotation></semantics></math> <span id="alg2.l13.4" class="ltx_text ltx_font_bold">do</span>



</div>
<div id="alg2.l14" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
                
                
                <span id="alg2.l14.3" class="ltx_text ltx_font_bold">if</span> <math id="alg2.l14.m1" class="ltx_Math" alttext="t=T" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">t=T</annotation></semantics></math> <span id="alg2.l14.4" class="ltx_text ltx_font_bold">then</span>



</div>
<div id="alg2.l15" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
                
                
