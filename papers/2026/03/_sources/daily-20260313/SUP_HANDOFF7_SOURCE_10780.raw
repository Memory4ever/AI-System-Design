</span></span><span id="S6.T4.5.3.1.3" class="ltx_text" style="font-size:90%;"><span id="S6.T4.5.3.1.3.1" class="ltx_text"></span></span></td>
<td id="S6.T4.5.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.3.2.1" class="ltx_text" style="font-size:90%;">8.031 (+47.2%)</span></td>
<td id="S6.T4.5.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.3.3.1" class="ltx_text" style="font-size:90%;">5.68</span></td>
<td id="S6.T4.5.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.3.4.1" class="ltx_text" style="font-size:90%;">92.33</span></td></tr>
