</div>
<div id="alg2.l2" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
                
                
                 <math id="alg2.l2.m1" class="ltx_Math" alttext="\boldsymbol{Q},\boldsymbol{K}\leftarrow\textsc{ExtractQK}(D_{\theta},\lambda_{\text{block}},\boldsymbol{c})" display="inline" intent=":literal"><semantics><mrow><mi>𝑸</mi><mo>,</mo><mrow><mi>𝑲</mi><mo stretchy="false">←</mo><mrow><mtext class="ltx_font_smallcaps">ExtractQK</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>D</mi><mi>θ</mi></msub><mo>,</mo><msub><mi>λ</mi><mtext>block</mtext></msub><mo>,</mo><mi>𝒄</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\boldsymbol{Q},\boldsymbol{K}\leftarrow\textsc{ExtractQK}(D_{\theta},\lambda_{\text{block}},\boldsymbol{c})</annotation></semantics></math>

</div>
