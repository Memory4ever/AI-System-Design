<td id="S6.T4.5.4.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding:-0.25pt 4.0pt;"><span id="S6.T4.5.4.4.1" class="ltx_text" style="font-size:90%;">92.21</span></td></tr>
