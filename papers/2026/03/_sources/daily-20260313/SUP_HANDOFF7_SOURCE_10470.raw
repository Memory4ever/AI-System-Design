<td id="S6.T6.3.1.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S6.T6.3.1.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F0F0F0;">Values</span></td></tr>
