<th id="S4.T3.3.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CIPHER</span></th>
<td id="S4.T3.3.5.2" class="ltx_td ltx_align_center" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.5.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">6.16<sub id="S4.T3.3.5.2.1.1" class="ltx_sub"><span id="S4.T3.3.5.2.1.1.1" class="ltx_text ltx_font_italic">±1.99</span></sub></span></td>
<td id="S4.T3.3.5.3" class="ltx_td ltx_align_center" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.5.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">6.64<sub id="S4.T3.3.5.3.1.1" class="ltx_sub"><span id="S4.T3.3.5.3.1.1.1" class="ltx_text ltx_font_italic">±1.88</span></sub></span></td></tr>
<tr id="S4.T3.3.6" class="ltx_tr">
<th id="S4.T3.3.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" style="padding:0.45pt 7.5pt;" rowspan="2"><span id="S4.T3.3.6.1.1" class="ltx_text" style="font-size:90%;">mPLUG-Owl2</span></th>
<th id="S4.T3.3.6.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.6.2.1" class="ltx_text" style="font-size:90%;">Original</span></th>
<td id="S4.T3.3.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.6.3.1" class="ltx_text" style="font-size:90%;">6.48<sub id="S4.T3.3.6.3.1.1" class="ltx_sub"><span id="S4.T3.3.6.3.1.1.1" class="ltx_text ltx_font_italic">±2.12</span></sub></span></td>
<td id="S4.T3.3.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.6.4.1" class="ltx_text" style="font-size:90%;">6.26<sub id="S4.T3.3.6.4.1.1" class="ltx_sub"><span id="S4.T3.3.6.4.1.1.1" class="ltx_text ltx_font_italic">±1.62</span></sub></span></td></tr>
