<td id="S6.T6.3.1.11.1" class="ltx_td ltx_align_left"><span id="S6.T6.3.1.11.1.1" class="ltx_text" style="font-size:90%;">Hallucination Space Rank (LLaVA-1.5)</span></td>
<td id="S6.T6.3.1.11.2" class="ltx_td ltx_align_left"><span id="S6.T6.3.1.11.2.1" class="ltx_text" style="font-size:90%;">8</span></td></tr>
