<th id="S4.T3.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding:0.45pt 7.5pt;"><span id="S4.T3.3.7.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">CIPHER</span></th>
