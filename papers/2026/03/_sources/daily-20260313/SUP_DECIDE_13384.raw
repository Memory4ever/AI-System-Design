<th id="S4.T7.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T7.2.1.3.1" class="ltx_text" style="font-size:90%;">VulnAgent-X</span></th>
<th id="S4.T7.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T7.2.1.4.1" class="ltx_text" style="font-size:90%;">Relative change</span></th></tr>
