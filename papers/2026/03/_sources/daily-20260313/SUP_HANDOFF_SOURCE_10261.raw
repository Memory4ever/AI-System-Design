<th id="Sx1.T19.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx1.T19.2.1.1.2.1" class="ltx_text" style="font-size:90%;">Scope</span></th>
<th id="Sx1.T19.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="Sx1.T19.2.1.1.3.1" class="ltx_text" style="font-size:90%;">H65 cell head (4D) + linear</span></th>
