<td id="Sx1.T20.2.1.4.3" class="ltx_td ltx_align_center" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.4.3.1" class="ltx_text" style="font-size:80%;">0.280</span></td>
<td id="Sx1.T20.2.1.4.4" class="ltx_td ltx_align_left" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.4.4.1" class="ltx_text" style="font-size:80%;">R: IL7R, TENTSC, GSPT1, GVPC, GBK1, PRBX2; W: CSF3R, SLC2BA1, S100A8, ELR2, ACSL1, PRBB</span></td>
<td id="Sx1.T20.2.1.4.5" class="ltx_td ltx_align_left ltx_align_top" style="padding-bottom: 2.0pt;">
<span id="Sx1.T20.2.1.4.5.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
