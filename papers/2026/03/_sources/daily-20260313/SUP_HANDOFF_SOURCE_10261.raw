<td id="Sx1.T19.2.1.5.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx1.T19.2.1.5.3.1" class="ltx_text" style="font-size:90%;">5–170</span></td>
<td id="Sx1.T19.2.1.5.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="Sx1.T19.2.1.5.4.1" class="ltx_text" style="font-size:90%;">172,610–174,690</span></td></tr>
