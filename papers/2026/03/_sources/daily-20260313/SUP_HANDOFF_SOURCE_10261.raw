</span></td></tr>
<tr id="Sx1.T20.2.1.3" class="ltx_tr">
<td id="Sx1.T20.2.1.3.1" class="ltx_td ltx_align_center" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.3.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">f02</span></td>
<td id="Sx1.T20.2.1.3.2" class="ltx_td ltx_align_left" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.3.2.1" class="ltx_text" style="font-size:80%;">Lymphoid contrast</span></td>
<td id="Sx1.T20.2.1.3.3" class="ltx_td ltx_align_center" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.3.3.1" class="ltx_text" style="font-size:80%;">0.254</span></td>
<td id="Sx1.T20.2.1.3.4" class="ltx_td ltx_align_left" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.3.4.1" class="ltx_text" style="font-size:80%;">R: IL7R, GSTPL, DIF2R, ChrFTB, GPFC, FNL; W: HLA-DRA, MARCB9, AC96579.19, IGKC, IGLC1</span></td>
<td id="Sx1.T20.2.1.3.5" class="ltx_td ltx_align_left ltx_align_top" style="padding-bottom: 2.0pt;">
<span id="Sx1.T20.2.1.3.5.1" class="ltx_inline-block ltx_align_top" style="width:128.0pt;">
<span id="Sx1.T20.2.1.3.5.1.1" class="ltx_p"><span id="Sx1.T20.2.1.3.5.1.1.1" class="ltx_text" style="font-size:80%;">Naïve CD8</span><sup id="Sx1.T20.2.1.3.5.1.1.2" class="ltx_sup"><span id="Sx1.T20.2.1.3.5.1.1.2.1" class="ltx_text" style="font-size:80%;">+</span></sup><span id="Sx1.T20.2.1.3.5.1.1.3" class="ltx_text" style="font-size:80%;"> T-cell; thymic CD4</span><sup id="Sx1.T20.2.1.3.5.1.1.4" class="ltx_sup"><span id="Sx1.T20.2.1.3.5.1.1.4.1" class="ltx_text" style="font-size:80%;">+</span></sup><span id="Sx1.T20.2.1.3.5.1.1.5" class="ltx_text" style="font-size:80%;">; B-cell lineage</span></span>
</span></td></tr>
<tr id="Sx1.T20.2.1.4" class="ltx_tr">
<td id="Sx1.T20.2.1.4.1" class="ltx_td ltx_align_center" style="padding-bottom: 2.0pt;"><span id="Sx1.T20.2.1.4.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">f00</span></td>
