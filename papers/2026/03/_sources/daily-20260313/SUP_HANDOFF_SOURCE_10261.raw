<td id="Sx1.T19.2.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx1.T19.2.1.2.2.1" class="ltx_text" style="font-size:90%;">one-time shared</span></td>
<td id="Sx1.T19.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" colspan="2"><span id="Sx1.T19.2.1.2.3.1" class="ltx_text" style="font-size:90%;">164.7 s</span></td></tr>
<tr id="Sx1.T19.2.1.3" class="ltx_tr">
<th id="Sx1.T19.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="Sx1.T19.2.1.3.1.1" class="ltx_text" style="font-size:90%;">Method-specific cache build</span></th>
<td id="Sx1.T19.2.1.3.2" class="ltx_td ltx_align_center"><span id="Sx1.T19.2.1.3.2.1" class="ltx_text" style="font-size:90%;">one-time</span></td>
<td id="Sx1.T19.2.1.3.3" class="ltx_td ltx_align_center"><span id="Sx1.T19.2.1.3.3.1" class="ltx_text" style="font-size:90%;">99.5 s (drift + head training)</span></td>
