<td id="Sx1.T23.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx1.T23.2.2.2.1" class="ltx_text" style="font-size:90%;">0.8850</span></td>
<td id="Sx1.T23.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="Sx1.T23.2.2.3.1" class="ltx_text" style="font-size:90%;">-0.0909</span></td></tr>
