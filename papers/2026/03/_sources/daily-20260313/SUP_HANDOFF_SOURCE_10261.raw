<th id="Sx1.T18.2.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="Sx1.T18.2.1.3.1.1" class="ltx_text" style="font-size:90%;">Branch macro-F1</span></th>
