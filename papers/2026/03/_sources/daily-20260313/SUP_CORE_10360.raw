<td id="S3.T1.3.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">Avg. Accuracy <math id="S3.T1.m7" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td>
<td id="S3.T1.3.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">Avg. F1 <math id="S3.T1.m8" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
<tr id="S3.T1.3.1.3" class="ltx_tr">
<td id="S3.T1.3.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" rowspan="6"><span id="S3.T1.3.1.3.1.1" class="ltx_text">MSCOCO</span></td>
<td id="S3.T1.3.1.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">Vanilla</td>
<td id="S3.T1.3.1.3.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">84.79</td>
<td id="S3.T1.3.1.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">85.61</td>
<td id="S3.T1.3.1.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">76.76</td>
<td id="S3.T1.3.1.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">76.82</td>
<td id="S3.T1.3.1.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">81.32</td>
<td id="S3.T1.3.1.3.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">82.01</td>
<td id="S3.T1.3.1.3.9" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">84.36</td>
<td id="S3.T1.3.1.3.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">84.64</td></tr>
<tr id="S3.T1.3.1.4" class="ltx_tr">
<td id="S3.T1.3.1.4.1" class="ltx_td ltx_align_left" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">VCD <span id="S3.T1.3.1.4.1.1" class="ltx_text ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#808080;">[CVPR’24]</span></td>
<td id="S3.T1.3.1.4.2" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">84.80</td>
<td id="S3.T1.3.1.4.3" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">85.65</td>
<td id="S3.T1.3.1.4.4" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">76.01</td>
<td id="S3.T1.3.1.4.5" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">76.28</td>
<td id="S3.T1.3.1.4.6" class="ltx_td ltx_align_center" style="padding-top:-0.5pt;padding-bottom:-0.5pt;">81.34</td>
