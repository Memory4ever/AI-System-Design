<td id="S3.T1.3.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-top:-0.5pt;padding-bottom:-0.5pt;" rowspan="2"><span id="S3.T1.3.1.1.2.1" class="ltx_text">Method</span></td>
