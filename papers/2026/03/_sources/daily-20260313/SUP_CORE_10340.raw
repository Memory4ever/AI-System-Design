<td id="S4.T1.3.1.6.6" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;"><span id="S4.T1.3.1.6.6.1" class="ltx_text ltx_font_bold">74.0</span></td>
<td id="S4.T1.3.1.6.7" class="ltx_td ltx_align_center" style="padding-top:1pt;padding-bottom:1pt;">+10.0</td></tr>
