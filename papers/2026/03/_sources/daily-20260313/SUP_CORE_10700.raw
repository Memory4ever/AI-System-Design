<section id="Pt0.A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">0.A.1 </span>Standard RAG Generation Prompt</h3>

<div id="Pt0.A1.SS1.p1" class="ltx_para">
<p id="Pt0.A1.SS1.p1.1" class="ltx_p">The following prompt is used by Gemini 2.5 Flash to generate answers
from retrieved context in conditions C1–C3 (standard RAG):</p>
</div>
<div id="Pt0.A1.SS1.p2" class="ltx_para">
<div id="Pt0.A1.SS1.p2.1" class="ltx_listing ltx_lstlisting ltx_framed ltx_framed_rectangle ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">You</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">are</span><span id="lstnumberx1.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">a</span><span id="lstnumberx1.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">helpful</span><span id="lstnumberx1.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">assistant</span><span id="lstnumberx1.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">answering</span><span id="lstnumberx1.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx1.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">questions</span>
</div>
