                        <div class="tablenoborder">
                           <table cellpadding="4" cellspacing="0" summary="" class="table" frame="border" border="1" rules="all">
                              <thead class="thead" align="left">
                                 <tr class="row">
                                    <th class="entry" colspan="2" valign="top" id="d54e1291" rowspan="1">Data Center L-Series Products</th>
                                 </tr>
                                 <tr class="row">
                                    <th class="entry" valign="top" width="47.61904761904761%" id="d54e1297" rowspan="1" colspan="1">Product</th>
                                    <th class="entry" valign="top" width="52.38095238095239%" id="d54e1300" rowspan="1" colspan="1">GPU Architecture</th>
                                 </tr>
                              </thead>
                              <tbody class="tbody">
                                 <tr class="row">
                                    <td class="entry" valign="top" width="47.61904761904761%" headers="d54e1291 d54e1297" rowspan="1" colspan="1">NVIDIA L2</td>
                                    <td class="entry" valign="top" width="52.38095238095239%" headers="d54e1291 d54e1300" rowspan="1" colspan="1">NVIDIA Ada Lovelace</td>
                                 </tr>
                                 <tr class="row">
                                    <td class="entry" valign="top" width="47.61904761904761%" headers="d54e1291 d54e1297" rowspan="1" colspan="1">NVIDIA L20</td>
                                    <td class="entry" valign="top" width="52.38095238095239%" headers="d54e1291 d54e1300" rowspan="1" colspan="1">NVIDIA Ada Lovelace</td>
                                 </tr>
                                 <tr class="row">
                                    <td class="entry" valign="top" width="47.61904761904761%" headers="d54e1291 d54e1297" rowspan="1" colspan="1">NVIDIA L40</td>
                                    <td class="entry" valign="top" width="52.38095238095239%" headers="d54e1291 d54e1300" rowspan="1" colspan="1">NVIDIA Ada Lovelace</td>
                                 </tr>
                                 <tr class="row">
                                    <td class="entry" valign="top" width="47.61904761904761%" headers="d54e1291 d54e1297" rowspan="1" colspan="1">NVIDIA L40S</td>
                                    <td class="entry" valign="top" width="52.38095238095239%" headers="d54e1291 d54e1300" rowspan="1" colspan="1">NVIDIA Ada Lovelace</td>
