                                    <td class="entry" valign="top" width="47.61904761904761%" headers="d54e1187 d54e1193" rowspan="1" colspan="1">NVIDIA HGX A100 8-GPU</td>
                                    <td class="entry" valign="top" width="52.38095238095239%" headers="d54e1187 d54e1196" rowspan="1" colspan="1">A100 and NVSwitch</td>
