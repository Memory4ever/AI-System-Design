<th id="S7.T1.5.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S7.T1.5.1.5.1" class="ltx_text ltx_font_bold">Size (MB)</span></th>
<th id="S7.T1.5.1.6" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S7.T1.5.1.6.1" class="ltx_text ltx_font_bold">#Q</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S7.T1.5.2" class="ltx_tr">
<td id="S7.T1.5.2.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">Archeology</td>
<td id="S7.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">5</td>
<td id="S7.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">16</td>
<td id="S7.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">11,289</td>
<td id="S7.T1.5.2.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">5.90</td>
<td id="S7.T1.5.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;">12</td></tr>
<tr id="S7.T1.5.3" class="ltx_tr">
<td id="S7.T1.5.3.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Astronomy<sup id="S7.T1.5.3.1.1" class="ltx_sup">∗</sup></td>
<td id="S7.T1.5.3.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">1,438</td>
<td id="S7.T1.5.3.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">29</td>
<td id="S7.T1.5.3.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">1,053</td>
<td id="S7.T1.5.3.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">313.87</td>
<td id="S7.T1.5.3.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">4</td></tr>
<tr id="S7.T1.5.4" class="ltx_tr">
<td id="S7.T1.5.4.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Biomedical</td>
<td id="S7.T1.5.4.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">24</td>
<td id="S7.T1.5.4.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">43</td>
<td id="S7.T1.5.4.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">16,297</td>
<td id="S7.T1.5.4.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">76.96</td>
<td id="S7.T1.5.4.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">9</td></tr>
<tr id="S7.T1.5.5" class="ltx_tr">
<td id="S7.T1.5.5.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Environment<sup id="S7.T1.5.5.1.1" class="ltx_sup">∗</sup></td>
<td id="S7.T1.5.5.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">36</td>
<td id="S7.T1.5.5.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">10</td>
<td id="S7.T1.5.5.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">9,199</td>
<td id="S7.T1.5.5.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">29.45</td>
<td id="S7.T1.5.5.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">17</td></tr>
<tr id="S7.T1.5.6" class="ltx_tr">
<td id="S7.T1.5.6.1" class="ltx_td ltx_align_center ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Legal<sup id="S7.T1.5.6.1.1" class="ltx_sup">∗</sup></td>
<td id="S7.T1.5.6.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">144</td>
<td id="S7.T1.5.6.3" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">3</td>
<td id="S7.T1.5.6.4" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">25</td>
<td id="S7.T1.5.6.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">0.20</td>
<td id="S7.T1.5.6.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">28</td></tr>
<tr id="S7.T1.5.7" class="ltx_tr">
<td id="S7.T1.5.7.1" class="ltx_td ltx_align_center ltx_border_b ltx_border_l ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">Wildfire<sup id="S7.T1.5.7.1.1" class="ltx_sup">∗</sup></td>
<td id="S7.T1.5.7.2" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">20</td>
<td id="S7.T1.5.7.3" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">14</td>
<td id="S7.T1.5.7.4" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">432,277</td>
<td id="S7.T1.5.7.5" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">1040</td>
<td id="S7.T1.5.7.6" class="ltx_td ltx_align_center ltx_border_b ltx_border_r ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;">18</td></tr>
</tbody>
</table></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
<p id="S7.T1.6" class="ltx_p ltx_figure_panel ltx_align_center"><sup id="S7.T1.6.1" class="ltx_sup"><span id="S7.T1.6.1.1" class="ltx_text" style="font-size:80%;">∗</span></sup><span id="S7.T1.6.2" class="ltx_text" style="font-size:80%;"> Filtered to include only questions that require tabular data. 
<br class="ltx_break"><sup id="S7.T1.6.2.1" class="ltx_sup">‡</sup> Average per table.</span></p></div></div>
</figure>
<div id="S7.p4" class="ltx_para">
<p id="S7.p4.1" class="ltx_p">We deliberately choose KramaBench because the questions are non-trivial and predominantly require multi-table integration. In contrast, many existing benchmarks (e.g., MMTU <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib35" title="" class="ltx_ref">Xing et al., 2025</a>)</cite>, RADAR <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib46" title="" class="ltx_ref">Gu et al., 2025</a>)</cite>, DataBench <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib45" title="" class="ltx_ref">Osés Grijalba et al., 2024</a>)</cite>) primarily focus on single-table question answering with relatively simpler queries. While MultiTabQA <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib44" title="" class="ltx_ref">Pal et al., 2023</a>)</cite> supports multi-table integration, its questions are simple. Similarly, TAG <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib43" title="" class="ltx_ref">Biswal et al., 2024</a>)</cite>, which builds on BIRD <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib42" title="" class="ltx_ref">Li et al., 2024</a>)</cite>, contains questions with incorrect annotations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib10" title="" class="ltx_ref">Jin et al., 2026</a>)</cite>. These issues make such benchmarks less suitable for evaluating precise, data-grounded question-answering over tables.</p>
</div>
<div id="S7.p5" class="ltx_para ltx_noindent">
<p id="S7.p5.1" class="ltx_p"><span id="S7.p5.1.1" class="ltx_text ltx_font_bold">Baselines.</span>  To contextualize our results, we compare <span id="S7.p5.1.2" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> against the following LLM-based baselines:</p>
</div>
<div id="S7.p6" class="ltx_para">
<ul id="S7.I2" class="ltx_itemize" style="--ltx-enum-leftmargin:1em;">
<li id="S7.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i1.p1" class="ltx_para">
<p id="S7.I2.i1.p1.1" class="ltx_p"><span id="S7.I2.i1.p1.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">DS-Guru</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib47" title="" class="ltx_ref">Lai et al., 2025</a>)</cite>: A system that instructs an LLM to decompose a question into subtasks, reason through each step, and synthesize Python code implementing the plan.</p>
</div></li>
<li id="S7.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="S7.I2.i2.p1" class="ltx_para">
<p id="S7.I2.i2.p1.1" class="ltx_p"><span id="S7.I2.i2.p1.1.1" class="ltx_text ltx_font_bold ltx_font_smallcaps">smolagents</span> <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib23" title="" class="ltx_ref">Face, 2024</a>)</cite>: An agentic baseline implemented using <span id="S7.I2.i2.p1.1.2" class="ltx_text ltx_font_smallcaps">smolagents</span>,<span id="footnote8" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">8</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">8</sup>
                  <span class="ltx_tag ltx_tag_note">8</span>
                  
                  
                  
                <a href="https://huggingface.co/docs/smolagents/en/index" title="" class="ltx_ref ltx_url ltx_font_typewriter">https://huggingface.co/docs/smolagents/en/index</a></span></span></span> an open-source agent framework supporting tool calling and code-based reasoning. The agent is provided with tools to execute Python code, list available tables, and inspect schemas and sample rows (up to 5 rows per table).</p>
</div></li>
</ul>
</div>
<div id="S7.p7" class="ltx_para ltx_noindent">
<p id="S7.p7.1" class="ltx_p"><span id="S7.p7.1.1" class="ltx_text ltx_font_bold">System Setup and Configurations.</span> 
All experiments are conducted on a MacBook Air (M4) with 16 GB of RAM. The Python version is 3.12.12. The LLM and embedding models are OpenAI’s <code id="S7.p7.1.2" class="ltx_verbatim ltx_font_typewriter">o3-2025-04-16</code> and <code id="S7.p7.1.3" class="ltx_verbatim ltx_font_typewriter">text-embedding-3-small</code>, respectively. To ensure a fair comparison with the baselines, we disable Web Search, Web Crawl, and Knowledge Store in <span id="S7.p7.1.4" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span>, and restrict all systems to operate solely over the provided local tables.</p>
</div>
<section id="S7.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.1. </span>RQ1: Answer Quality</h3>

<div id="S7.SS1.p1" class="ltx_para">
<p id="S7.SS1.p1.1" class="ltx_p">Here we assume the user has converged into <math id="S7.SS1.p1.m1" class="ltx_Math" alttext="\mathcal{I}^{*}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathcal{I}^{*}</annotation></semantics></math> (see Section <a href="#S6" title="6. Validating (𝒯,𝑆): Two Examples ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) and measure whether the system answers the question correctly, i.e., whether <span id="S7.SS1.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> meets <span id="S7.SS1.p1.1.2" class="ltx_text ltx_font_bold">R1</span>. Concretely, we treat each question in KramaBench as <math id="S7.SS1.p1.m2" class="ltx_Math" alttext="\mathcal{I}^{*}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathcal{I}^{*}</annotation></semantics></math>, and define <span id="S7.SS1.p1.1.3" class="ltx_text ltx_font_bold">answer quality</span> as the proportion of correctly answered questions across the benchmark. For questions whose answers are sets or lists of values, we report the F1 score to account for partial correctness.</p>
</div>
<figure id="S7.F2" class="ltx_figure"><object type="image/svg+xml" data="2603.10747v1/rq1_answer_quality_all_in_one.svg" id="S7.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/108;" width="476" height="108"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>. </span><span id="S7.F2.4" class="ltx_text" style="font-size:90%;">Comparison of Answer Quality</span></figcaption>
</figure>
<section id="S7.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.1. </span>Overall Answer Quality</h4>

<div id="S7.SS1.SSS1.p1" class="ltx_para">
<p id="S7.SS1.SSS1.p1.1" class="ltx_p">As shown in Figure <a href="#S7.F2" title="Figure 2 ‣ 7.1. RQ1: Answer Quality ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(a), <span id="S7.SS1.SSS1.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> consistently achieves higher answer quality than the baselines, and is on par with <span id="S7.SS1.SSS1.p1.1.2" class="ltx_text ltx_font_smallcaps">smolagents</span> on the Astronomy dataset. The performance gap between <span id="S7.SS1.SSS1.p1.1.3" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> and the baselines is particularly pronounced on the Biomedical and Environment datasets. For example, on the Biomedical dataset, <span id="S7.SS1.SSS1.p1.1.4" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> attains an answer quality of <math id="S7.SS1.SSS1.p1.m1" class="ltx_Math" alttext="94.44\%" display="inline" intent=":literal"><semantics><mrow><mn>94.44</mn><mo>%</mo></mrow><annotation encoding="application/x-tex">94.44\%</annotation></semantics></math>, exceeding <span id="S7.SS1.SSS1.p1.1.5" class="ltx_text ltx_font_smallcaps">DS-Guru</span> and <span id="S7.SS1.SSS1.p1.1.6" class="ltx_text ltx_font_smallcaps">smolagents</span> by <math id="S7.SS1.SSS1.p1.m2" class="ltx_Math" alttext="27.77" display="inline" intent=":literal"><semantics><mn>27.77</mn><annotation encoding="application/x-tex">27.77</annotation></semantics></math> and <math id="S7.SS1.SSS1.p1.m3" class="ltx_Math" alttext="38.88" display="inline" intent=":literal"><semantics><mn>38.88</mn><annotation encoding="application/x-tex">38.88</annotation></semantics></math> percentage points, respectively.</p>
</div>
<div id="S7.SS1.SSS1.p2" class="ltx_para">
<p id="S7.SS1.SSS1.p2.1" class="ltx_p">For <span id="S7.SS1.SSS1.p2.1.1" class="ltx_text ltx_font_smallcaps">DS-Guru</span>, we limit the number of sampled rows per table to <math id="S7.SS1.SSS1.p2.m1" class="ltx_Math" alttext="5" display="inline" intent=":literal"><semantics><mn>5</mn><annotation encoding="application/x-tex">5</annotation></semantics></math> on the Biomedical dataset to ensure that the input fits within the LLM context window (200,000 tokens). On the Astronomy dataset, even when restricting the number of sampled rows per table to <math id="S7.SS1.SSS1.p2.m2" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>, the input still requires 986,955 tokens, far exceeding the context limit. We therefore omit <span id="S7.SS1.SSS1.p2.1.2" class="ltx_text ltx_font_smallcaps">DS-Guru</span> on Astronomy.</p>
</div>
</section>
<section id="S7.SS1.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.2. </span>Value of Context Extraction</h4>

<div id="S7.SS1.SSS2.p1" class="ltx_para">
<p id="S7.SS1.SSS2.p1.1" class="ltx_p">We demonstrate the importance of micro context management for achieving high answer quality. Specifically, we ablate Context Extraction—the action implementing micro context management in <span id="S7.SS1.SSS2.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span>—and comparing the answer quality of <span id="S7.SS1.SSS2.p1.1.2" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> with and without this action.</p>
</div>
<div id="S7.SS1.SSS2.p2" class="ltx_para">
<p id="S7.SS1.SSS2.p2.1" class="ltx_p">As shown in Figure <a href="#S7.F2" title="Figure 2 ‣ 7.1. RQ1: Answer Quality ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(b), enabling Context Extraction improves answer quality on <math id="S7.SS1.SSS2.p2.m1" class="ltx_Math" alttext="4/5" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo>/</mo><mn>5</mn></mrow><annotation encoding="application/x-tex">4/5</annotation></semantics></math> datasets. Beyond the example in Section <a href="#S4.SS2" title="4.2. Micro Context Management ‣ 4. Designing a System to Support (𝒯,𝑆) ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>, we highlight a representative failure example that arises without Context Extraction. Consider this query from the Archeology dataset: <span id="S7.SS1.SSS2.p2.1.1" class="ltx_text ltx_font_italic">“What is the average latitude of capital cities? If there are more than one capital in a country, only count the latitude of the capital with the largest population. Round your answer to 4 decimal places.”</span> The relevant table is <span id="S7.SS1.SSS2.p2.1.2" class="ltx_text ltx_font_italic">worldcities</span> with the following schema: <span id="S7.SS1.SSS2.p2.1.3" class="ltx_text ltx_font_typewriter">[city,lat,lng,capital,...]</span></p>
</div>
<div id="S7.SS1.SSS2.p3" class="ltx_para">
<p id="S7.SS1.SSS2.p3.1" class="ltx_p">Without Context Extraction, <span id="S7.SS1.SSS2.p3.1.1" class="ltx_text ltx_font_smallcaps">Conductor</span> directly instantiates a filter predicate based on the surface form of the column name <span id="S7.SS1.SSS2.p3.1.2" class="ltx_text ltx_font_typewriter">capital</span>, implicitly assuming that any non-empty value in this column denotes a national capital. This leads to an incorrect predicate of the form <span id="S7.SS1.SSS2.p3.1.3" class="ltx_text ltx_font_typewriter">capital IS NOT NULL AND capital &lt;&gt; ’’</span>, which conflates national capitals with administrative and minor capitals. As a result, the query executes successfully, but it computes the statistic over a semantically incorrect population.</p>
</div>
<div id="S7.SS1.SSS2.p4" class="ltx_para">
<p id="S7.SS1.SSS2.p4.1" class="ltx_p">With Context Extraction enabled, <span id="S7.SS1.SSS2.p4.1.1" class="ltx_text ltx_font_smallcaps">Conductor</span> first inspects the empirical distribution of values in the <span id="S7.SS1.SSS2.p4.1.2" class="ltx_text ltx_font_typewriter">capital</span> column prior to defining <math id="S7.SS1.SSS2.p4.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>. In this case, Context Extraction reveals that <span id="S7.SS1.SSS2.p4.1.3" class="ltx_text ltx_font_typewriter">capital</span> takes values in <span id="S7.SS1.SSS2.p4.1.4" class="ltx_text ltx_font_typewriter">primary</span>, <span id="S7.SS1.SSS2.p4.1.5" class="ltx_text ltx_font_typewriter">admin</span>, <span id="S7.SS1.SSS2.p4.1.6" class="ltx_text ltx_font_typewriter">minor</span>, <span id="S7.SS1.SSS2.p4.1.7" class="ltx_text ltx_font_typewriter">NULL</span>, where <span id="S7.SS1.SSS2.p4.1.8" class="ltx_text ltx_font_italic">primary</span> uniquely identifies national capitals. This observation grounds the subsequent query construction, yielding the correct predicate <span id="S7.SS1.SSS2.p4.1.9" class="ltx_text ltx_font_typewriter">capital = ’primary’</span> before applying the per-country max-pop-ulation selection and aggregation.</p>
</div>
<div id="S7.SS1.SSS2.p5" class="ltx_para">
<p id="S7.SS1.SSS2.p5.1" class="ltx_p">Overall, Context Extraction explicitly nudges the LLM to make data-grounded decisions by inspecting actual table values. This directly conditions downstream processes (e.g., defining <math id="S7.SS1.SSS2.p5.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>) on empirical observations rather than implicit assumptions.</p>
</div>
</section>
<section id="S7.SS1.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.1.3. </span>Value of <math id="S7.SS1.SSS3.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math></h4>

<div id="S7.SS1.SSS3.p1" class="ltx_para">
<p id="S7.SS1.SSS3.p1.1" class="ltx_p">In addition to helping transform <math id="S7.SS1.SSS3.p1.m1" class="ltx_Math" alttext="\mathcal{I}^{+}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>+</mo></msup><annotation encoding="application/x-tex">\mathcal{I}^{+}</annotation></semantics></math> into <math id="S7.SS1.SSS3.p1.m2" class="ltx_Math" alttext="\mathcal{I}^{*}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">\mathcal{I}^{*}</annotation></semantics></math>, the relational reification <math id="S7.SS1.SSS3.p1.m3" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math> impacts answer quality as well because it grounds the system’s behavior. We compare the answer quality of <span id="S7.SS1.SSS3.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> with and without <math id="S7.SS1.SSS3.p1.m4" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>. Specifically, without <math id="S7.SS1.SSS3.p1.m5" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>, <span id="S7.SS1.SSS3.p1.1.2" class="ltx_text ltx_font_smallcaps">Conductor</span> no longer defines or materializes <math id="S7.SS1.SSS3.p1.m6" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>; instead, it relies on Context Extraction to directly synthesize an answer.</p>
</div>
<div id="S7.SS1.SSS3.p2" class="ltx_para">
<p id="S7.SS1.SSS3.p2.1" class="ltx_p">As shown in Figure <a href="#S7.F2" title="Figure 2 ‣ 7.1. RQ1: Answer Quality ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>(c), <span id="S7.SS1.SSS3.p2.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> with <math id="S7.SS1.SSS3.p2.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math> consistently achieves higher answer quality than without <math id="S7.SS1.SSS3.p2.m2" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>. We highlight a representative failure example that arises without <math id="S7.SS1.SSS3.p2.m3" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>. Consider this query from the Legal dataset: <span id="S7.SS1.SSS3.p2.1.2" class="ltx_text ltx_font_italic">“How many total Identity Theft reports were there in 2024 from cross-state Metropolitan Statistical Areas?”</span> This requires consolidating identity theft data across all states in the U.S.</p>
</div>
<div id="S7.SS1.SSS3.p3" class="ltx_para">
<p id="S7.SS1.SSS3.p3.1" class="ltx_p">Without <math id="S7.SS1.SSS3.p3.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>, the system attempts to generate an answer by reasoning over only the state-level tables it has retrieved, resulting in incomplete coverage. Some states are not included, leading to an underestimated total of 114,392 reports in our experiment.</p>
</div>
<div id="S7.SS1.SSS3.p4" class="ltx_para">
<p id="S7.SS1.SSS3.p4.1" class="ltx_p">With <math id="S7.SS1.SSS3.p4.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>, <span id="S7.SS1.SSS3.p4.1.1" class="ltx_text ltx_font_smallcaps">Conductor</span> defines <math id="S7.SS1.SSS3.p4.m2" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math> as a single table <code id="S7.SS1.SSS3.p4.1.2" class="ltx_verbatim ltx_font_typewriter">identity_</code> <code id="S7.SS1.SSS3.p4.1.3" class="ltx_verbatim ltx_font_typewriter">theft_msa_reports</code> with schema: <code id="S7.SS1.SSS3.p4.1.4" class="ltx_verbatim ltx_font_typewriter">[state, metropolitan_area,</code> <code id="S7.SS1.SSS3.p4.1.5" class="ltx_verbatim ltx_font_typewriter">num_of_reports]</code>, and <math id="S7.SS1.SSS3.p4.m3" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> specifies the operations needed to consolidate, deduplicate, and sum the reports. <span id="S7.SS1.SSS3.p4.1.6" class="ltx_text ltx_font_smallcaps">Conductor</span> invokes <span id="S7.SS1.SSS3.p4.1.7" class="ltx_text ltx_font_smallcaps">Materializer</span> with the note to populate <code id="S7.SS1.SSS3.p4.1.8" class="ltx_verbatim ltx_font_typewriter">identity-</code> <code id="S7.SS1.SSS3.p4.1.9" class="ltx_verbatim ltx_font_typewriter">_theft_msa_reports</code> by UNION-ing all tables whose names match <code id="S7.SS1.SSS3.p4.1.10" class="ltx_verbatim ltx_font_typewriter">state_msa_identity_</code> <code id="S7.SS1.SSS3.p4.1.11" class="ltx_verbatim ltx_font_typewriter">theft_data_*</code>. <span id="S7.SS1.SSS3.p4.1.12" class="ltx_text ltx_font_smallcaps">Materializer</span> ensures that all relevant tables are retrieved, so no state is omitted. Execution of <math id="S7.SS1.SSS3.p4.m4" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> produces the correct total of 243,377 reports as intended.</p>
</div>
<div id="S7.SS1.SSS3.p5" class="ltx_para">
<p id="S7.SS1.SSS3.p5.1" class="ltx_p">Even without <math id="S7.SS1.SSS3.p5.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>, the system can still enumerate tables, but <math id="S7.SS1.SSS3.p5.m2" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math> explicitly encodes cues that guide correct materialization, ensuring that all relevant tables contribute to the final answer.</p>
</div>
</section>
</section>
<section id="S7.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">7.2. </span>RQ2: Cost and Scalability</h3>

<div id="S7.SS2.p1" class="ltx_para">
<p id="S7.SS2.p1.1" class="ltx_p">We compare the cost and scalability of <span id="S7.SS2.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> against the baselines to study how <span id="S7.SS2.p1.1.2" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> meets <span id="S7.SS2.p1.1.3" class="ltx_text ltx_font_bold">R4</span>. Specifically, we measure: (1) monetary cost for LLM inference, derived from input and output token usage,<span id="footnote9" class="ltx_note ltx_role_footnote"><sup class="ltx_note_mark">9</sup><span class="ltx_note_outer"><span class="ltx_note_content"><sup class="ltx_note_mark">9</sup>
              <span class="ltx_tag ltx_tag_note">9</span>
              
              
              
            According to OpenAI’s latest pricing as of February 27, 2026, <span id="footnote9.2" class="ltx_text ltx_font_typewriter">o3-2025-04-16</span> costs $2 per 1 million input tokens and $8 per 1 million output tokens.</span></span></span> (2) runtime scalability as dataset size increases, and (3) the overall runtime of the system across datasets.</p>
</div>
<section id="S7.SS2.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.1. </span>Cost–Quality Trade-offs</h4>

<div id="S7.SS2.SSS1.p1" class="ltx_para">
<p id="S7.SS2.SSS1.p1.1" class="ltx_p">We derive monetary cost from token usage using the pricing of <span id="S7.SS2.SSS1.p1.1.1" class="ltx_text ltx_font_typewriter">o3-2025-04-16</span> and plot average LLM cost against answer quality in Figure <a href="#S7.F3.sf1" title="In Figure 3 ‣ 7.2.1. Cost–Quality Trade-offs ‣ 7.2. RQ2: Cost and Scalability ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3(a)</span></a>.
<span id="S7.SS2.SSS1.p1.1.2" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> occupies most of the Pareto-optimal frontier, indicating that across many cost–quality trade-offs, it achieves state-of-the-art efficiency.</p>
</div>
<div id="S7.SS2.SSS1.p2" class="ltx_para">
<p id="S7.SS2.SSS1.p2.1" class="ltx_p">We also report the average input and output token usage for LLM inference across datasets. As shown in Figure <a href="#S7.F3.sf2" title="In Figure 3 ‣ 7.2.1. Cost–Quality Trade-offs ‣ 7.2. RQ2: Cost and Scalability ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3(b)</span></a>, <span id="S7.SS2.SSS1.p2.1.1" class="ltx_text ltx_font_smallcaps">DS-Guru</span> consistently uses the fewest tokens. <span id="S7.SS2.SSS1.p2.1.2" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> exhibits similar token usage to <span id="S7.SS2.SSS1.p2.1.3" class="ltx_text ltx_font_smallcaps">smolagents</span> and is lower on 4 out of 6 datasets.</p>
</div>
<figure id="S7.F3" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S7.F3.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.10747v1/pareto_quality_vs_cost.svg" id="S7.F3.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/272;" width="476" height="272"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F3.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="S7.F3.sf1.4" class="ltx_text" style="font-size:90%;">Average LLM Cost vs. Answer Quality</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S7.F3.sf2" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.10747v1/rq2_token_usage_stacked.svg" id="S7.F3.sf2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/242;" width="476" height="242"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F3.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S7.F3.sf2.4" class="ltx_text" style="font-size:90%;">Average Input and Output Token Usage</span></figcaption>
</figure></div></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F3.3" class="ltx_text" style="font-size:90%;">Figure 3</span>. </span><span id="S7.F3.4" class="ltx_text" style="font-size:90%;">Cost–quality trade-offs and token usage across methods.</span></figcaption>
</figure>
</section>
<section id="S7.SS2.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.2. </span>Scalability</h4>

<div id="S7.SS2.SSS2.p1" class="ltx_para">
<p id="S7.SS2.SSS2.p1.1" class="ltx_p">We examine the performance profile of <span id="S7.SS2.SSS2.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> as dataset size increases. We evaluate runtime scalability using a subset of the procurement dataset introduced in Section <a href="#S7.SS1" title="7.1. RQ1: Answer Quality ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.1</span></a>. Specifically, we use two tables corresponding to purchase order lines and item details, and vary the number of rows to construct datasets of increasing size: 224 MB, 608 MB, 1 GB, and 1.9 GB. The query remains fixed: <span id="S7.SS2.SSS2.p1.1.2" class="ltx_text ltx_font_italic">“What is the grand total amount for purchase order lines that include green products?”</span></p>
</div>
<div id="S7.SS2.SSS2.p2" class="ltx_para">
<p id="S7.SS2.SSS2.p2.1" class="ltx_p">As shown in Figure <a href="#S7.F4" title="Figure 4 ‣ 7.2.2. Scalability ‣ 7.2. RQ2: Cost and Scalability ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>, <span id="S7.SS2.SSS2.p2.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> is comparable to <span id="S7.SS2.SSS2.p2.1.2" class="ltx_text ltx_font_smallcaps">smolagents</span>, while <span id="S7.SS2.SSS2.p2.1.3" class="ltx_text ltx_font_smallcaps">DS-Guru</span> eventually overtakes both systems at the 1 GB scale. At the 1 GB scale, for instance, <span id="S7.SS2.SSS2.p2.1.4" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> spends 58.74 seconds on LLM inference and 0.37 seconds on non-LLM processing. In comparison, <span id="S7.SS2.SSS2.p2.1.5" class="ltx_text ltx_font_smallcaps">smolagents</span> and <span id="S7.SS2.SSS2.p2.1.6" class="ltx_text ltx_font_smallcaps">DS-Guru</span> spend 39.94 and 11.73 seconds on LLM inference, and 15.75 and 51.71 seconds on non-LLM processing, respectively.</p>
</div>
<div id="S7.SS2.SSS2.p3" class="ltx_para">
<p id="S7.SS2.SSS2.p3.1" class="ltx_p">We observe that the runtime bottleneck of <span id="S7.SS2.SSS2.p3.1.1" class="ltx_text ltx_font_smallcaps">smolagents</span> gradually shifts toward non-LLM processing as dataset size increases, exhibiting a trend similar to <span id="S7.SS2.SSS2.p3.1.2" class="ltx_text ltx_font_smallcaps">DS-Guru</span>, though less extreme. In contrast, for <span id="S7.SS2.SSS2.p3.1.3" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span>, runtime remains dominated by LLM inference and does not grow visibly relative to non-LLM processing time. This highlights the importance of database-backed execution: even when memory pressure is partially controlled via batching, non-LLM processing overhead can dominate runtime when data are loaded and processed in memory.</p>
</div>
<figure id="S7.F4" class="ltx_figure"><object type="image/svg+xml" data="2603.10747v1/rq2_scalability_runtime_stacked.svg" id="S7.F4.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/221;" width="476" height="221"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S7.F4.3" class="ltx_text" style="font-size:90%;">Figure 4</span>. </span><span id="S7.F4.4" class="ltx_text" style="font-size:90%;">Scalability of Runtime</span></figcaption>
</figure>
</section>
<section id="S7.SS2.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">7.2.3. </span>Runtime</h4>

<div id="S7.SS2.SSS3.p1" class="ltx_para">
<p id="S7.SS2.SSS3.p1.1" class="ltx_p">While <span id="S7.SS2.SSS3.p1.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> incurs higher runtime than <span id="S7.SS2.SSS3.p1.1.2" class="ltx_text ltx_font_smallcaps">DS-Guru</span> on several datasets, this overhead primarily reflects the additional structured processing introduced by <math id="S7.SS2.SSS3.p1.m1" class="ltx_Math" alttext="(\mathcal{T},S)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>S</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},S)</annotation></semantics></math>, rather than inefficiencies in data access or execution. As shown in Table <a href="#S7.T2" title="Table 2 ‣ 7.2.3. Runtime ‣ 7.2. RQ2: Cost and Scalability ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, <span id="S7.SS2.SSS3.p1.1.3" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> takes longer than <span id="S7.SS2.SSS3.p1.1.4" class="ltx_text ltx_font_smallcaps">DS-Guru</span> but is competitive with <span id="S7.SS2.SSS3.p1.1.5" class="ltx_text ltx_font_smallcaps">smolagents</span>: it is faster on three datasets and slower on three datasets. For example, on the Biomedical dataset, <span id="S7.SS2.SSS3.p1.1.6" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> spends 60.94 seconds on LLM inference on average (<math id="S7.SS2.SSS3.p1.m2" class="ltx_Math" alttext="\sigma=35.51" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>35.51</mn></mrow><annotation encoding="application/x-tex">\sigma=35.51</annotation></semantics></math>), while <span id="S7.SS2.SSS3.p1.1.7" class="ltx_text ltx_font_smallcaps">smolagents</span> spends 68.05 seconds on average (<math id="S7.SS2.SSS3.p1.m3" class="ltx_Math" alttext="\sigma=49.07" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>49.07</mn></mrow><annotation encoding="application/x-tex">\sigma=49.07</annotation></semantics></math>). In contrast, <span id="S7.SS2.SSS3.p1.1.8" class="ltx_text ltx_font_smallcaps">DS-Guru</span> spends 29.86 seconds on average (<math id="S7.SS2.SSS3.p1.m4" class="ltx_Math" alttext="\sigma=11.99" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>11.99</mn></mrow><annotation encoding="application/x-tex">\sigma=11.99</annotation></semantics></math>).</p>
</div>
<div id="S7.SS2.SSS3.p2" class="ltx_para">
<p id="S7.SS2.SSS3.p2.1" class="ltx_p">Across all systems, non-LLM running time is substantially lower than LLM inference time: <span id="S7.SS2.SSS3.p2.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span>, <span id="S7.SS2.SSS3.p2.1.2" class="ltx_text ltx_font_smallcaps">smolagents</span>, and <span id="S7.SS2.SSS3.p2.1.3" class="ltx_text ltx_font_smallcaps">DS-Guru</span> spend 4.55, 4.11, and 1.62 seconds on average, respectively (standard deviations: 1.56, 1.02, and 1.68).</p>
</div>
<div id="S7.SS2.SSS3.p3" class="ltx_para">
<p id="S7.SS2.SSS3.p3.1" class="ltx_p">For both <span id="S7.SS2.SSS3.p3.1.1" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> and <span id="S7.SS2.SSS3.p3.1.2" class="ltx_text ltx_font_smallcaps">smolagents</span>, LLM inference dominates runtime, whereas for <span id="S7.SS2.SSS3.p3.1.3" class="ltx_text ltx_font_smallcaps">DS-Guru</span>, the bottleneck shifts to non-LLM processing on the Wildfire dataset. In this case, <span id="S7.SS2.SSS3.p3.1.4" class="ltx_text ltx_font_smallcaps">DS-Guru</span> spends 62.10 seconds (<math id="S7.SS2.SSS3.p3.m1" class="ltx_Math" alttext="\sigma=9.79" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>9.79</mn></mrow><annotation encoding="application/x-tex">\sigma=9.79</annotation></semantics></math>) on non-LLM time on average, compared to 27.92 seconds (<math id="S7.SS2.SSS3.p3.m2" class="ltx_Math" alttext="\sigma=13.52" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo>=</mo><mn>13.52</mn></mrow><annotation encoding="application/x-tex">\sigma=13.52</annotation></semantics></math>) on LLM inference. This is because <span id="S7.SS2.SSS3.p3.1.5" class="ltx_text ltx_font_smallcaps">DS-Guru</span> loads all rows of all tables into memory for processing. In contrast, <span id="S7.SS2.SSS3.p3.1.6" class="ltx_text ltx_font_smallcaps">smolagents</span> implicitly prompts the LLM to process data in batches, while <span id="S7.SS2.SSS3.p3.1.7" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span> relies on database-backed execution and loads only sample rows into memory. This design substantially reduces non-LLM processing overhead and contributes to the scalability behavior observed in Figure <a href="#S7.F4" title="Figure 4 ‣ 7.2.2. Scalability ‣ 7.2. RQ2: Cost and Scalability ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>. As we further analyze in Section <a href="#S7.SS3.SSS2" title="7.3.2. Memory Usage and Runtime–Memory Trade-offs ‣ 7.3. RQ3: Microbenchmark ‣ 7. Quantitative Evaluation ‣ Pneuma-Seeker: Relational Reification of Information Needs for Agentic Data Discovery and Preparation" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7.3.2</span></a>, this overhead manifests primarily as increased runtime rather than increased memory footprint, reflecting a deliberate design trade-off in <span id="S7.SS2.SSS3.p3.1.8" class="ltx_text ltx_font_smallcaps">Pneuma-Seeker</span>.</p>
</div>
