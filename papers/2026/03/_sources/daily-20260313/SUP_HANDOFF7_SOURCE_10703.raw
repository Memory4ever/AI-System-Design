<th id="S4.T4.6.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T4.6.1.2.1.1" class="ltx_text" style="font-size:90%;">LLaVA-1.5 </span><cite class="ltx_cite ltx_citemacro_cite"><span id="S4.T4.6.1.2.1.2" class="ltx_text" style="font-size:90%;">[</span><a href="#bib.bib23" title="" class="ltx_ref">30</a><span id="S4.T4.6.1.2.1.3" class="ltx_text" style="font-size:90%;">]</span></cite></th>
<td id="S4.T4.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T4.6.1.2.2.1" class="ltx_text" style="font-size:90%;">22.16</span></td>
<td id="S4.T4.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:8.0pt;padding-right:8.0pt;"><span id="S4.T4.6.1.2.3.1" class="ltx_text" style="font-size:90%;">33.04</span></td></tr>
<tr id="S4.T4.6.1.3" class="ltx_tr">
