<td id="S4.T2.7.1.10.2" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S4.T2.7.1.10.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#ECECEC;">76.2</span></td>
<td id="S4.T2.7.1.10.3" class="ltx_td ltx_align_center ltx_border_b" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S4.T2.7.1.10.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#ECECEC;">78.5</span></td>
