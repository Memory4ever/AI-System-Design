<td id="S4.T2.7.1.9.9" class="ltx_td ltx_align_center" style="padding-top:0.7pt;padding-bottom:0.7pt;"><span id="S4.T2.7.1.9.9.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#ECECEC;">70.5</span></td></tr>
