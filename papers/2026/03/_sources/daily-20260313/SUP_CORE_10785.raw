<th id="Pt0.A8.T7.6.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="Pt0.A8.T7.6.1.1.2.1" class="ltx_text ltx_font_bold">Foundation Models</span></th>
<th id="Pt0.A8.T7.6.1.1.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="Pt0.A8.T7.6.1.1.3.1" class="ltx_text ltx_font_bold">Community Derivatives</span></th></tr>
</thead>
<tbody class="ltx_tbody">
