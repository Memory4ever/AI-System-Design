          <math id="algorithm2.m36" class="ltx_Math" alttext="\mathrm{acc\_count}\leftarrow\mathrm{acc\_count}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">acc</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">count</mi></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mrow><mi mathsize="0.800em">acc</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">count</mi></mrow><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></mrow><annotation encoding="application/x-tex">\mathrm{acc\_count}\leftarrow\mathrm{acc\_count}+1</annotation></semantics></math><span id="algorithm2.6.24.5" class="ltx_text" style="font-size:80%;">; </span><span id="algorithm2.6.24.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Backward<math id="algorithm2.m37" class="ltx_Math" alttext="\!\big(\mathcal{L}\big)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.500em" minsize="1.500em">(</mo><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo maxsize="1.500em" minsize="1.500em">)</mo></mrow><annotation encoding="application/x-tex">\!\big(\mathcal{L}\big)</annotation></semantics></math></span><span id="algorithm2.6.24.7" class="ltx_text" style="font-size:80%;"> with gradient sync </span><span id="algorithm2.6.24.8" class="ltx_text ltx_font_bold" style="font-size:80%;">deferred</span><span id="algorithm2.6.24.9" class="ltx_text" style="font-size:80%;">;</span>
</div>
<div id="algorithm2.6.25" class="ltx_listingline"><span id="algorithm2.6.25.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.25.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.25.3" class="ltx_text" style="font-size:80%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.25.4" class="ltx_text ltx_font_bold" style="font-size:80%;">18</span></span>
          <span id="algorithm2.6.25.5" class="ltx_text ltx_font_bold" style="font-size:80%;">if</span><span id="algorithm2.6.25.6" class="ltx_text" style="font-size:80%;"> </span><em id="algorithm2.6.25.7" class="ltx_emph ltx_font_italic" style="font-size:80%;"><math id="algorithm2.m38" class="ltx_Math" alttext="\mathrm{acc\_count}\geq K_{\mathrm{target}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>acc</mi><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">_</mi><mo lspace="0em" rspace="0em">​</mo><mi>count</mi></mrow><mo>≥</mo><msub><mi>K</mi><mi>target</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{acc\_count}\geq K_{\mathrm{target}}</annotation></semantics></math></em><span id="algorithm2.6.25.8" class="ltx_text" style="font-size:80%;"> </span><span id="algorithm2.6.25.9" class="ltx_text ltx_font_bold" style="font-size:80%;">then</span><span id="algorithm2.6.25.10" class="ltx_text" style="font-size:80%;">  </span><span id="algorithm2.6.25.11" class="ltx_text ltx_font_typewriter" style="font-size:80%;"><math id="algorithm2.m39" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> </span><span id="algorithm2.6.25.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Tuple complete</span>
</div>
<div id="algorithm2.6.26" class="ltx_listingline"><span id="algorithm2.6.26.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.26.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.26.3" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.26.4" class="ltx_text" style="font-size:80%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.26.5" class="ltx_text ltx_font_bold" style="font-size:80%;">19</span></span>
          <span id="algorithm2.6.26.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;">SyncGradients</span><span id="algorithm2.6.26.7" class="ltx_text" style="font-size:80%;">(); </span><span id="algorithm2.6.26.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;">ClipGradNorm</span><span id="algorithm2.6.26.9" class="ltx_text" style="font-size:80%;">(</span><math id="algorithm2.m40" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math><span id="algorithm2.6.26.10" class="ltx_text" style="font-size:80%;">);</span>
</div>
<div id="algorithm2.6.27" class="ltx_listingline"><span id="algorithm2.6.27.1" class="ltx_text" style="font-size:80%;">  </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.27.2" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.27.3" class="ltx_text" style="font-size:80%;">    </span><span class="ltx_rule" style="width:1px;height:100%;--ltx-bg-color:black;display:inline-block;"> </span><span id="algorithm2.6.27.4" class="ltx_text" style="font-size:80%;">  </span>
            <span class="ltx_tag ltx_tag_listingline"><span id="algorithm2.6.27.5" class="ltx_text ltx_font_bold" style="font-size:80%;">20</span></span>
          <math id="algorithm2.m41" class="ltx_Math" alttext="\theta\leftarrow\theta-\eta\cdot\texttt{Optimizer}(\nabla_{\theta})" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">θ</mi><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">θ</mi><mo mathsize="0.800em">−</mo><mrow><mrow><mi mathsize="0.800em">η</mi><mo lspace="0.222em" mathsize="0.800em" rspace="0.222em">⋅</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">Optimizer</mtext></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mo mathsize="0.800em">∇</mo><mi mathsize="0.800em">θ</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow\theta-\eta\cdot\texttt{Optimizer}(\nabla_{\theta})</annotation></semantics></math><span id="algorithm2.6.27.6" class="ltx_text" style="font-size:80%;">; </span><math id="algorithm2.m42" class="ltx_Math" alttext="\nabla_{\theta}\leftarrow\mathbf{0}" display="inline" intent=":literal"><semantics><mrow><msub><mo mathsize="0.800em">∇</mo><mi mathsize="0.800em">θ</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mn mathsize="0.800em">𝟎</mn></mrow><annotation encoding="application/x-tex">\nabla_{\theta}\leftarrow\mathbf{0}</annotation></semantics></math><span id="algorithm2.6.27.7" class="ltx_text" style="font-size:80%;">; </span><math id="algorithm2.m43" class="ltx_Math" alttext="\mathrm{acc\_count}\leftarrow 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">acc</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">_</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">count</mi></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mn mathsize="0.800em">0</mn></mrow><annotation encoding="application/x-tex">\mathrm{acc\_count}\leftarrow 0</annotation></semantics></math><span id="algorithm2.6.27.8" class="ltx_text" style="font-size:80%;">; </span><math id="algorithm2.m44" class="ltx_Math" alttext="K_{\mathrm{target}}\leftarrow\texttt{null}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">K</mi><mi mathsize="0.800em">target</mi></msub><mo mathsize="0.800em" stretchy="false">←</mo><mtext class="ltx_mathvariant_monospace" mathsize="0.800em">null</mtext></mrow><annotation encoding="application/x-tex">K_{\mathrm{target}}\leftarrow\texttt{null}</annotation></semantics></math><span id="algorithm2.6.27.9" class="ltx_text" style="font-size:80%;">;</span>
</div>
