<td id="A10.T12.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A10.T12.5.2.2.1" class="ltx_text" style="font-size:90%;">92.22</span></td>
<td id="A10.T12.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A10.T12.5.2.3.1" class="ltx_text" style="font-size:90%;">89.08</span></td></tr>
