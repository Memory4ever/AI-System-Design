<th id="A10.T12.5.5.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="A10.T12.5.5.1.1" class="ltx_text" style="font-size:90%;">4</span></th>
<td id="A10.T12.5.5.2" class="ltx_td ltx_align_center"><span id="A10.T12.5.5.2.1" class="ltx_text" style="font-size:90%;">92.14</span></td>
<td id="A10.T12.5.5.3" class="ltx_td ltx_align_center"><span id="A10.T12.5.5.3.1" class="ltx_text" style="font-size:90%;">89.30</span></td></tr>
