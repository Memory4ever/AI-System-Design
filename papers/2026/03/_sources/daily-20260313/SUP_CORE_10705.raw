<td id="A10.T12.5.3.2" class="ltx_td ltx_align_center"><span id="A10.T12.5.3.2.1" class="ltx_text" style="font-size:90%;">92.12</span></td>
<td id="A10.T12.5.3.3" class="ltx_td ltx_align_center"><span id="A10.T12.5.3.3.1" class="ltx_text" style="font-size:90%;">89.34</span></td></tr>
