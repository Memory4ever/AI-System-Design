<th id="A10.T12.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A10.T12.5.1.2.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="font-size:90%;">Qwen3-4B</span></th>
<th id="A10.T12.5.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A10.T12.5.1.3.1" class="ltx_text ltx_font_bold ltx_font_smallcaps" style="font-size:90%;">Qwen3-8B</span></th></tr>
</thead>
