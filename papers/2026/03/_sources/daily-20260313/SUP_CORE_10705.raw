<th id="A10.T12.5.4.1" class="ltx_td ltx_align_center ltx_th ltx_th_row"><span id="A10.T12.5.4.1.1" class="ltx_text" style="font-size:90%;">3</span></th>
<td id="A10.T12.5.4.2" class="ltx_td ltx_align_center"><span id="A10.T12.5.4.2.1" class="ltx_text" style="font-size:90%;">92.08</span></td>
<td id="A10.T12.5.4.3" class="ltx_td ltx_align_center"><span id="A10.T12.5.4.3.1" class="ltx_text" style="font-size:90%;">88.98</span></td></tr>
