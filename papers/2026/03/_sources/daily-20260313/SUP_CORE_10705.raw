<th id="A13.T14.6.2.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-top:0.45pt;padding-bottom:0.45pt;"><span id="A13.T14.6.2.2.1" class="ltx_text" style="font-size:90%;">Differential</span></th>
