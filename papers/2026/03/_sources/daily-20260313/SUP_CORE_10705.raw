<td id="S5.T4.6.1.3.2" class="ltx_td ltx_align_center" style="padding:-0.45pt 20.0pt;"><span id="S5.T4.6.1.3.2.1" class="ltx_text" style="font-size:90%;">   1.194 </span><span id="S5.T4.6.1.3.2.2" class="ltx_text" style="font-size:90%;--ltx-fg-color:#808080;">(+0.01)</span><span id="S5.T4.6.1.3.2.3" class="ltx_text" style="font-size:90%;">   </span></td>
<td id="S5.T4.6.1.3.3" class="ltx_td ltx_align_center" style="padding:-0.45pt 20.0pt;"><span id="S5.T4.6.1.3.3.1" class="ltx_text" style="font-size:90%;">   1.0</span><math id="S5.T4.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math><span id="S5.T4.6.1.3.3.2" class="ltx_text" style="font-size:90%;">   </span></td>
