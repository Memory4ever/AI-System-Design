<td id="S5.T2.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.3.1" class="ltx_text" style="font-size:90%;">10</span></td>
<td id="S5.T2.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.2.4.1" class="ltx_text" style="font-size:90%;">8</span></td></tr>
<tr id="S5.T2.5.3" class="ltx_tr">
<td id="S5.T2.5.3.1" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T2.5.3.1.1" class="ltx_text" style="font-size:90%;">ASB (email)</span></td>
<td id="S5.T2.5.3.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.3.2.1" class="ltx_text" style="font-size:90%;">114</span></td>
<td id="S5.T2.5.3.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.3.3.1" class="ltx_text" style="font-size:90%;">17</span></td>
<td id="S5.T2.5.3.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T2.5.3.4.1" class="ltx_text" style="font-size:90%;">13</span></td></tr>
