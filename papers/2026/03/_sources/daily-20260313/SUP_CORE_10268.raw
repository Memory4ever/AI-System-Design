<td id="S5.T5.5.3.2" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S5.T5.5.3.2.1" class="ltx_text" style="font-size:90%;">17</span></td>
<td id="S5.T5.5.3.3" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S5.T5.5.3.3.1" class="ltx_text" style="font-size:90%;">79</span></td>
<td id="S5.T5.5.3.4" class="ltx_td ltx_align_center" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S5.T5.5.3.4.1" class="ltx_text" style="font-size:90%;">147</span></td>
