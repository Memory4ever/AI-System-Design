<td id="S5.T5.5.2.6" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:-0.7pt;padding-bottom:-0.7pt;"><span id="S5.T5.5.2.6.1" class="ltx_text" style="font-size:90%;">133</span></td>
