<td id="S5.T10.1.3.2" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.3.2.1" class="ltx_text" style="font-size:90%;">496</span></td>
<td id="S5.T10.1.3.3" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.3.3.1" class="ltx_text" style="font-size:90%;">203.8K</span></td>
<td id="S5.T10.1.3.4" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.3.4.1" class="ltx_text" style="font-size:90%;">11.5K</span></td>
<td id="S5.T10.1.3.5" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.3.5.1" class="ltx_text" style="font-size:90%;">0.77</span></td></tr>
<tr id="S5.T10.1.4" class="ltx_tr">
<td id="S5.T10.1.4.1" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.4.1.1" class="ltx_text" style="font-size:90%;">SOC</span></td>
<td id="S5.T10.1.4.2" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.4.2.1" class="ltx_text" style="font-size:90%;">742</span></td>
<td id="S5.T10.1.4.3" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.4.3.1" class="ltx_text" style="font-size:90%;">445.1K</span></td>
<td id="S5.T10.1.4.4" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.4.4.1" class="ltx_text" style="font-size:90%;">160.0K</span></td>
<td id="S5.T10.1.4.5" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.4.5.1" class="ltx_text" style="font-size:90%;">1.58</span></td></tr>
<tr id="S5.T10.1.5" class="ltx_tr">
<td id="S5.T10.1.5.1" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.5.1.1" class="ltx_text" style="font-size:90%;">OI</span></td>
<td id="S5.T10.1.5.2" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.5.2.1" class="ltx_text" style="font-size:90%;">299</span></td>
<td id="S5.T10.1.5.3" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.5.3.1" class="ltx_text" style="font-size:90%;">97.9K</span></td>
<td id="S5.T10.1.5.4" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.5.4.1" class="ltx_text" style="font-size:90%;">8.4K</span></td>
<td id="S5.T10.1.5.5" class="ltx_td ltx_align_center" style="padding-top:-0.9pt;padding-bottom:-0.9pt;"><span id="S5.T10.1.5.5.1" class="ltx_text" style="font-size:90%;">0.42</span></td></tr>
