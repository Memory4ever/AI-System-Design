<td id="S1.T1.5.5.3" class="ltx_td ltx_align_center"><span id="S1.T1.5.5.3.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.5.4" class="ltx_td ltx_align_center"><span id="S1.T1.5.5.4.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.5.5" class="ltx_td ltx_align_center"><span id="S1.T1.5.5.5.1" class="ltx_text" style="font-size:90%;">Manual</span></td></tr>
<tr id="S1.T1.5.6" class="ltx_tr">
<td id="S1.T1.5.6.1" class="ltx_td ltx_align_left"><span id="S1.T1.5.6.1.1" class="ltx_text" style="font-size:90%;">R-Judge </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.6.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib41" title="" class="ltx_ref">Yuan et al., 2024</a><span id="S1.T1.5.6.1.4" class="ltx_text" style="font-size:90%;">)</span></cite></td>
<td id="S1.T1.5.6.2" class="ltx_td ltx_align_center"><span id="S1.T1.5.6.2.1" class="ltx_text" style="font-size:90%;">Manual</span></td>
<td id="S1.T1.5.6.3" class="ltx_td ltx_align_center"><span id="S1.T1.5.6.3.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.6.4" class="ltx_td ltx_align_center"><span id="S1.T1.5.6.4.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.6.5" class="ltx_td ltx_align_center"><span id="S1.T1.5.6.5.1" class="ltx_text" style="font-size:90%;">Manual</span></td></tr>
<tr id="S1.T1.5.7" class="ltx_tr">
<td id="S1.T1.5.7.1" class="ltx_td ltx_align_left"><span id="S1.T1.5.7.1.1" class="ltx_text" style="font-size:90%;">Windows Agent Arena </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.7.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib5" title="" class="ltx_ref">Bonatti et al., 2025</a><span id="S1.T1.5.7.1.4" class="ltx_text" style="font-size:90%;">)</span></cite></td>
<td id="S1.T1.5.7.2" class="ltx_td ltx_align_center"><span id="S1.T1.5.7.2.1" class="ltx_text" style="font-size:90%;">Manual</span></td>
<td id="S1.T1.5.7.3" class="ltx_td ltx_align_center"><span id="S1.T1.5.7.3.1" class="ltx_text" style="font-size:90%;">✓</span></td>
<td id="S1.T1.5.7.4" class="ltx_td ltx_align_center"><span id="S1.T1.5.7.4.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.7.5" class="ltx_td ltx_align_center"><span id="S1.T1.5.7.5.1" class="ltx_text" style="font-size:90%;">Manual Scripts</span></td></tr>
<tr id="S1.T1.5.8" class="ltx_tr">
<td id="S1.T1.5.8.1" class="ltx_td ltx_align_left"><span id="S1.T1.5.8.1.1" class="ltx_text" style="font-size:90%;">PrivacyLens </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.8.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib25" title="" class="ltx_ref">Shao et al., 2024</a><span id="S1.T1.5.8.1.4" class="ltx_text" style="font-size:90%;">)</span></cite></td>
<td id="S1.T1.5.8.2" class="ltx_td ltx_align_center"><span id="S1.T1.5.8.2.1" class="ltx_text" style="font-size:90%;">Semi-automated</span></td>
<td id="S1.T1.5.8.3" class="ltx_td ltx_align_center"><span id="S1.T1.5.8.3.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.8.4" class="ltx_td ltx_align_center"><span id="S1.T1.5.8.4.1" class="ltx_text" style="font-size:90%;">×</span></td>
<td id="S1.T1.5.8.5" class="ltx_td ltx_align_center"><span id="S1.T1.5.8.5.1" class="ltx_text" style="font-size:90%;">Automated</span></td></tr>
<tr id="S1.T1.5.9" class="ltx_tr">
<td id="S1.T1.5.9.1" class="ltx_td ltx_align_left"><span id="S1.T1.5.9.1.1" class="ltx_text" style="font-size:90%;">ToolEmu </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.9.1.2" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib22" title="" class="ltx_ref">Ruan et al., 2024</a><span id="S1.T1.5.9.1.4" class="ltx_text" style="font-size:90%;">)</span></cite></td>
