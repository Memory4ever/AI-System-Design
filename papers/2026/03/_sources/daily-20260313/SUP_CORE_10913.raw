2</mn></msup><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mn mathsize="0.700em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">π</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">0</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">r</mi><mn mathsize="0.700em">2</mn></msup></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(q^{2})/(4\pi\epsilon 0r^{2})</annotation></semantics></math><span id="A7.T13.9.3.3.1.1.17" class="ltx_text" style="font-size:70%;">   F = </span><math id="A7.T13.m20" class="ltx_Math" alttext="(q1q2)/(4\pi\epsilon 0r^{2})" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">1</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">q</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">2</mn></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow><mo maxsize="0.700em" minsize="0.700em" stretchy="true" symmetric="true">/</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mrow><mn mathsize="0.700em">4</mn><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">π</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.700em">ϵ</mi><mo lspace="0em" rspace="0em">​</mo><mn mathsize="0.700em">0</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.700em">r</mi><mn mathsize="0.700em">2</mn></msup></mrow><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(q1q2)/(4\pi\epsilon 0r^{2})</annotation></semantics></math><span id="A7.T13.9.3.3.1.1.18" class="ltx_text" style="font-size:70%;"> […]</span></span>
