<div id="alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <span id="alg1.l3.3" class="ltx_text" style="font-size:90%;">Transition </span><math id="alg1.l3.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math><span id="alg1.l3.4" class="ltx_text" style="font-size:90%;">, observation function </span><math id="alg1.l3.m2" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math><span id="alg1.l3.5" class="ltx_text" style="font-size:90%;">, failure detector </span><math id="alg1.l3.m3" class="ltx_Math" alttext="\textsc{Fail}(\cdot)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_font_smallcaps" mathsize="0.900em">Fail</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋅</mo><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\textsc{Fail}(\cdot)</annotation></semantics></math><span id="alg1.l3.6" class="ltx_text" style="font-size:90%;">
</span>
