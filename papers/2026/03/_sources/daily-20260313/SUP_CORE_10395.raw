              <span id="alg2.l1.2" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l1.3" class="ltx_text ltx_font_bold" style="font-size:90%;">Input:</span><span id="alg2.l1.4" class="ltx_text" style="font-size:90%;"> Graph </span><math id="alg2.l1.m1" class="ltx_Math" alttext="G_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">G</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">G_{t}</annotation></semantics></math><span id="alg2.l1.5" class="ltx_text" style="font-size:90%;">, time </span><math id="alg2.l1.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math><span id="alg2.l1.6" class="ltx_text" style="font-size:90%;">, interval </span><math id="alg2.l1.m3" class="ltx_Math" alttext="\Delta t" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow><annotation encoding="application/x-tex">\Delta t</annotation></semantics></math><span id="alg2.l1.7" class="ltx_text" style="font-size:90%;">, denoiser </span><math id="alg2.l1.m4" class="ltx_Math" alttext="f_{\theta}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">f</mi><mi mathsize="0.900em">θ</mi></msub><annotation encoding="application/x-tex">f_{\theta}</annotation></semantics></math><span id="alg2.l1.8" class="ltx_text" style="font-size:90%;">
