<td id="S4.T1.5.1.13.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.5.1.13.3.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F0F0F0;">95.0<math id="S4.T1.m13" class="ltx_Math" alttext="\mathord{\pm}4.0" display="inline" intent=":literal"><semantics><mrow><mi style="--ltx-bg-color:#F0F0F0;" mathbackground="#F0F0F0" mathsize="0.700em" mathvariant="normal">±</mi><mo lspace="0em" rspace="0em">​</mo><mn style="--ltx-bg-color:#F0F0F0;" mathbackground="#F0F0F0" mathsize="0.700em">4.0</mn></mrow><annotation encoding="application/x-tex">\mathord{\pm}4.0</annotation></semantics></math></span></td>
