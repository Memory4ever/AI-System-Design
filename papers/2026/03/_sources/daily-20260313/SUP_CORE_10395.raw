              <span id="alg2.l9.2" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l9.3" class="ltx_text ltx_font_bold" style="font-size:90%;">Output:</span><span id="alg2.l9.4" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l9.m1" class="ltx_Math" alttext="p_{t+\Delta t}=[p(1|z_{t}),\cdots,p(\mathcal{|Z|}\mid z_{t})]" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">p</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo mathsize="0.900em">=</mo><mrow><mo maxsize="0.900em" minsize="0.900em">[</mo><mrow><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mn mathsize="0.900em">1</mn><mo lspace="0em" mathsize="0.900em" rspace="0em">|</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mo lspace="0em" mathsize="0.900em" rspace="0em">⋯</mo><mo mathsize="0.900em">,</mo><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mrow><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">𝒵</mi><mo maxsize="0.900em" minsize="0.900em" stretchy="true">|</mo></mrow><mo fence="true" lspace="0em" mathsize="0.900em" rspace="0em">∣</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">]</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t+\Delta t}=[p(1|z_{t}),\cdots,p(\mathcal{|Z|}\mid z_{t})]</annotation></semantics></math><span id="alg2.l9.5" class="ltx_text" style="font-size:90%;">
</span>
