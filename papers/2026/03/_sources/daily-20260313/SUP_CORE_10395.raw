              <span id="alg2.l7.2" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l7.m1" class="ltx_Math" alttext="p(z_{t+\Delta t}|z_{t})=\delta(z_{t},z_{t+\Delta t})+R_{t}^{\theta}(z_{t},z_{t+\Delta t})\Delta t" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">p</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo lspace="0em" mathsize="0.900em" rspace="0em">|</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">=</mo><mrow><mrow><mi mathsize="0.900em">δ</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">z</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">+</mo><mrow><msubsup><mi mathsize="0.900em">R</mi><mi mathsize="0.900em">t</mi><mi mathsize="0.900em">θ</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mi mathsize="0.900em">z</mi><mi mathsize="0.900em">t</mi></msub><mo mathsize="0.900em">,</mo><msub><mi mathsize="0.900em">z</mi><mrow><mi mathsize="0.900em">t</mi><mo mathsize="0.900em">+</mo><mrow><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em" mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">p(z_{t+\Delta t}|z_{t})=\delta(z_{t},z_{t+\Delta t})+R_{t}^{\theta}(z_{t},z_{t+\Delta t})\Delta t</annotation></semantics></math><span id="alg2.l7.3" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l7.4" class="ltx_text" style="font-size:90%;float:right;"><math id="alg2.l7.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#808080;" mathcolor="#808080">⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math><span id="alg2.l7.4.1" class="ltx_text" style="--ltx-fg-color:#808080;"> Transition</span>
</span>
</div>
