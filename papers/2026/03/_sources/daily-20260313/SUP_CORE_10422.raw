<td id="S2.T3.3.7.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="S2.T3.3.7.3.1" class="ltx_text" style="--ltx-bg-color:#E9F8F0;">Chunk-wise</span></td>
<td id="S2.T3.3.7.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t"><span id="S2.T3.3.7.4.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E9F8F0;">0.726</span></td></tr>
