<th id="S2.T2.3.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Adapter</th>
<th id="S2.T2.3.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Train Time (<math id="S2.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math>)</th>
<th id="S2.T2.3.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Success Rate (<math id="S2.T2.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math>)</th></tr>
<tr id="S2.T2.3.2" class="ltx_tr">
