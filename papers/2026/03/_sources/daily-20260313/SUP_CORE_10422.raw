<td id="S3.T6.3.1.12.3" class="ltx_td ltx_align_left">FC(<math id="S3.T6.m17" class="ltx_Math" alttext="D_{\text{proprio}}" display="inline" intent=":literal"><semantics><msub><mi>D</mi><mtext>proprio</mtext></msub><annotation encoding="application/x-tex">D_{\text{proprio}}</annotation></semantics></math>, 128), ReLU, FC(128, <math id="S3.T6.m18" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math>), LayerNorm</td></tr>
<tr id="S3.T6.3.1.13" class="ltx_tr">
<td id="S3.T6.3.1.13.1" class="ltx_td ltx_align_left">   <span id="S3.T6.3.1.13.1.1" class="ltx_text ltx_font_italic">Visual Encoder</span></td>
<td id="S3.T6.3.1.13.2" class="ltx_td ltx_align_left"><math id="S3.T6.m19" class="ltx_Math" alttext="\mathbb{R}^{3\times H_{img}\times W_{img}}\rightarrow\mathbb{R}^{D}" display="inline" intent=":literal"><semantics><mrow><msup><mi>ℝ</mi><mrow><mn>3</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>H</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub><mo lspace="0.222em" rspace="0.222em">×</mo><msub><mi>W</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>m</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi></mrow></msub></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">\mathbb{R}^{3\times H_{img}\times W_{img}}\rightarrow\mathbb{R}^{D}</annotation></semantics></math></td>
<td id="S3.T6.3.1.13.3" class="ltx_td ltx_align_left">Conv2D(3, 16, <math id="S3.T6.m20" class="ltx_Math" alttext="k=8,s=4,p=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>8</mn></mrow><mo>,</mo><mrow><mi>s</mi><mo>=</mo><mn>4</mn></mrow><mo>,</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">k=8,s=4,p=0</annotation></semantics></math>), ReLU</td></tr>
<tr id="S3.T6.3.1.14" class="ltx_tr">
<td id="S3.T6.3.1.14.1" class="ltx_td"></td>
<td id="S3.T6.3.1.14.2" class="ltx_td"></td>
<td id="S3.T6.3.1.14.3" class="ltx_td ltx_align_left">Conv2D(16, 32, <math id="S3.T6.m21" class="ltx_Math" alttext="k=4,s=2,p=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>4</mn></mrow><mo>,</mo><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">k=4,s=2,p=0</annotation></semantics></math>), ReLU</td></tr>
<tr id="S3.T6.3.1.15" class="ltx_tr">
<td id="S3.T6.3.1.15.1" class="ltx_td"></td>
<td id="S3.T6.3.1.15.2" class="ltx_td"></td>
<td id="S3.T6.3.1.15.3" class="ltx_td ltx_align_left">Conv2D(32, 32, <math id="S3.T6.m22" class="ltx_Math" alttext="k=3,s=2,p=0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>3</mn></mrow><mo>,</mo><mrow><mi>s</mi><mo>=</mo><mn>2</mn></mrow><mo>,</mo><mrow><mi>p</mi><mo>=</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">k=3,s=2,p=0</annotation></semantics></math>)</td></tr>
