<td id="S2.T5.3.5.3" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb"><span id="S2.T5.3.5.3.1" class="ltx_text" style="--ltx-bg-color:#E6F3FF;">48.8</span></td></tr>
