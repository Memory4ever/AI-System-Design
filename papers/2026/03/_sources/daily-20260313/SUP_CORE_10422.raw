<th id="S2.T3.3.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="S2.T3.3.7.1.1" class="ltx_text ltx_font_smallcaps" style="--ltx-bg-color:#E9F8F0;">World2Act<span id="S2.T3.3.7.1.1.1" class="ltx_text ltx_font_upright"> (Ours)</span></span></th>
