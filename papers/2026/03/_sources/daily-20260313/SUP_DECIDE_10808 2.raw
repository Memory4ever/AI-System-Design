</span></td>
<td id="S3.T1.5.3.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="S3.T1.5.3.4.1" class="ltx_inline-block ltx_align_top" style="width:136.6pt;">
<span id="S3.T1.5.3.4.1.1" class="ltx_p"><span id="S3.T1.5.3.4.1.1.1" class="ltx_text" style="font-size:90%;">Continuous, concurrent</span></span>
</span></td></tr>
<tr id="S3.T1.5.4" class="ltx_tr">
<td id="S3.T1.5.4.1" class="ltx_td ltx_align_left ltx_align_top">
