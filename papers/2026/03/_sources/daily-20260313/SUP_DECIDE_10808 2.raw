</span></td>
<td id="S3.T1.5.4.2" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.5.4.2.1" class="ltx_inline-block ltx_align_top" style="width:102.4pt;">
<span id="S3.T1.5.4.2.1.1" class="ltx_p"><span id="S3.T1.5.4.2.1.1.1" class="ltx_text" style="font-size:90%;">Explicit logic only</span></span>
</span></td>
<td id="S3.T1.5.4.3" class="ltx_td ltx_align_left ltx_align_top">
<span id="S3.T1.5.4.3.1" class="ltx_inline-block ltx_align_top" style="width:102.4pt;">
<span id="S3.T1.5.4.3.1.1" class="ltx_p"><span id="S3.T1.5.4.3.1.1.1" class="ltx_text" style="font-size:90%;">Declarative snapshot</span></span>
</span></td>
<td id="S3.T1.5.4.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="S3.T1.5.4.4.1" class="ltx_inline-block ltx_align_top" style="width:136.6pt;">
