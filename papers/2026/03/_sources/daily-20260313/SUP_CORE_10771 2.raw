<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S3.F5.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S3.F5.sf3.4" class="ltx_text" style="font-size:90%;">CSQA</span></figcaption>
</figure></div><div class="ltx_flex_cell ltx_flex_size_4">
<figure id="S3.F5.sf4" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2603.10771v1/intervention_l4.svg" id="S3.F5.sf4.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/384;" width="476" height="384"></object>
