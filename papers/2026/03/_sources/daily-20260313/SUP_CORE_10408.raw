<th id="S4.T2.6.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">Motion Forcing</th>
<td id="S4.T2.6.1.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.2.2.1" class="ltx_text ltx_font_bold">157.8</span></td>
<td id="S4.T2.6.1.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.2.3.1" class="ltx_text ltx_font_bold">205.2</span></td>
<td id="S4.T2.6.1.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.2.4.1" class="ltx_text ltx_font_bold">33.2</span></td></tr>
<tr id="S4.T2.6.1.3" class="ltx_tr">
<th id="S4.T2.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="4"><span id="S4.T2.6.1.3.1.1" class="ltx_text ltx_font_bold">Motion Representation</span></th></tr>
<tr id="S4.T2.6.1.4" class="ltx_tr">
<th id="S4.T2.6.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Segmentation</th>
