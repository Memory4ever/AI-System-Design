<th id="S4.T2.6.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" colspan="4"><span id="S4.T2.6.1.8.1.1" class="ltx_text ltx_font_bold">Ego Motion Encoding</span></th></tr>
<tr id="S4.T2.6.1.9" class="ltx_tr">
