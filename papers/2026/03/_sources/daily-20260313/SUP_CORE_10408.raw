<td id="S4.T2.6.1.1.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.1.2.1" class="ltx_text ltx_font_bold">FVD<math id="S4.T2.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T2.6.1.1.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.1.3.1" class="ltx_text ltx_font_bold">FVMD<math id="S4.T2.m2" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="S4.T2.6.1.1.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.6.1.1.4.1" class="ltx_text ltx_font_bold">Physics-IQ<math id="S4.T2.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
