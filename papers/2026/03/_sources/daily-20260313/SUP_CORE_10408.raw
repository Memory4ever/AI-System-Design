<th id="S4.T2.6.1.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Softmax Splatting <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib29" title="" class="ltx_ref">31</a>]</cite></th>
<td id="S4.T2.6.1.7.2" class="ltx_td ltx_align_center">160.3</td>
<td id="S4.T2.6.1.7.3" class="ltx_td ltx_align_center">251.7</td>
<td id="S4.T2.6.1.7.4" class="ltx_td ltx_align_center">28.5</td></tr>
