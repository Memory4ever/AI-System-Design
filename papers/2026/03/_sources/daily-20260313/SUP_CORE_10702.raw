<td id="S4.T5.2.1.8.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">73.11</td>
<td id="S4.T5.2.1.8.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.2.1.8.5.1" class="ltx_text ltx_font_bold">45.00</span></td>
<td id="S4.T5.2.1.8.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">60.88</td>
<td id="S4.T5.2.1.8.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">48.10</td></tr>
<tr id="S4.T5.2.1.9" class="ltx_tr">
<th id="S4.T5.2.1.9.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_r" style="padding-left:4.0pt;padding-right:4.0pt;">Seq. Concat</th>
<td id="S4.T5.2.1.9.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;">65.03</td>
<td id="S4.T5.2.1.9.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T5.2.1.9.3.1" class="ltx_text ltx_font_bold">64.58</span></td>
