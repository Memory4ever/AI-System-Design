</table></th>
<th id="A5.T7.2.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_row ltx_border_r ltx_border_tt">Metric</th>
<td id="A5.T7.2.1.1.3" class="ltx_td ltx_align_center ltx_border_tt">GPT-4o</td>
<td id="A5.T7.2.1.1.4" class="ltx_td ltx_align_center ltx_border_tt">Nano-Banana</td>
<td id="A5.T7.2.1.1.5" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt">Seedream4.0</td>
<td id="A5.T7.2.1.1.6" class="ltx_td ltx_align_center ltx_border_tt">UniCom</td>
<td id="A5.T7.2.1.1.7" class="ltx_td ltx_align_center ltx_border_tt">WorldEdit</td>
