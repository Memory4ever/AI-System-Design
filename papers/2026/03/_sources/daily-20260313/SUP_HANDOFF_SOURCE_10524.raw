<td id="A1.T7.2.1.4.3" class="ltx_td ltx_align_right">7,661</td>
<td id="A1.T7.2.1.4.4" class="ltx_td ltx_align_right">49,607</td>
<td id="A1.T7.2.1.4.5" class="ltx_td ltx_align_right">6.5</td></tr>
<tr id="A1.T7.2.1.5" class="ltx_tr">
<th id="A1.T7.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Cloud</th>
<th id="A1.T7.2.1.5.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">Technical docs</th>
<td id="A1.T7.2.1.5.3" class="ltx_td ltx_align_right">8,578</td>
<td id="A1.T7.2.1.5.4" class="ltx_td ltx_align_right">72,442</td>
<td id="A1.T7.2.1.5.5" class="ltx_td ltx_align_right">8.4</td></tr>
<tr id="A1.T7.2.1.6" class="ltx_tr">
<th id="A1.T7.2.1.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t"><span id="A1.T7.2.1.6.1.1" class="ltx_text ltx_font_bold">Total</span></th>
<th id="A1.T7.2.1.6.2" class="ltx_td ltx_th ltx_th_row ltx_border_bb ltx_border_t"></th>
<td id="A1.T7.2.1.6.3" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t"><span id="A1.T7.2.1.6.3.1" class="ltx_text ltx_font_bold">78,170</span></td>
<td id="A1.T7.2.1.6.4" class="ltx_td ltx_align_right ltx_border_bb ltx_border_t"><span id="A1.T7.2.1.6.4.1" class="ltx_text ltx_font_bold">366,479</span></td>
<td id="A1.T7.2.1.6.5" class="ltx_td ltx_border_bb ltx_border_t"></td></tr>
