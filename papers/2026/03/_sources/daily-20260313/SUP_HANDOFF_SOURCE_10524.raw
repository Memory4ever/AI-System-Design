<td id="A3.T37.2.1.4.2" class="ltx_td ltx_align_center">18%</td>
<td id="A3.T37.2.1.4.3" class="ltx_td ltx_align_center">All</td></tr>
<tr id="A3.T37.2.1.5" class="ltx_tr">
