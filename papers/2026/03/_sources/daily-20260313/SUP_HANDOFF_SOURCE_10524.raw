<td id="A3.T36.2.4.4" class="ltx_td ltx_align_center"><math id="A3.T36.m4" class="ltx_math_unparsed" alttext="1.2\times" display="inline" intent=":literal"><semantics><mrow><mn>1.2</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">1.2\times</annotation></semantics></math></td></tr>
