<td id="S4.T1.2.1.3.4" class="ltx_td ltx_align_center">49,607</td>
<td id="S4.T1.2.1.3.5" class="ltx_td ltx_align_center">72,442</td></tr>
<tr id="S4.T1.2.1.4" class="ltx_tr">
<th id="S4.T1.2.1.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Avg. passages/doc</th>
<td id="S4.T1.2.1.4.2" class="ltx_td ltx_align_center">42.7</td>
