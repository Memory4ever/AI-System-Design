<td id="S5.T3.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.2.2.3.1" class="ltx_text ltx_font_bold">0.5776</span></td>
<td id="S5.T3.2.2.4" class="ltx_td ltx_align_center ltx_border_t">1/38</td></tr>
<tr id="S5.T3.2.3" class="ltx_tr">
