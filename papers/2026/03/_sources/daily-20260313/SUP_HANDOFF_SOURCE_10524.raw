<th id="A1.T9.2.1.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="A1.T9.2.1.1.2.1" class="ltx_text ltx_font_bold">Top-3 Question Types</span></th>
