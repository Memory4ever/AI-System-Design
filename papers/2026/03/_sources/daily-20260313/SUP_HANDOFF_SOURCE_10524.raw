<td id="A2.SS8.SSS0.Px2.p4.1.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.SS8.SSS0.Px2.p4.1.2.2.1" class="ltx_text ltx_font_bold">0.725</span></td>
<td id="A2.SS8.SSS0.Px2.p4.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;">$0.001</td>
<td id="A2.SS8.SSS0.Px2.p4.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A2.SS8.SSS0.Px2.m1" class="ltx_math_unparsed" alttext="1\times" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">1\times</annotation></semantics></math></td></tr>
