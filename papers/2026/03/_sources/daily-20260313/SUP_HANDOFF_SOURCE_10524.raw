nobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.4" class="ltx_text ltx_font_sansserif" style="--ltx-fg-color:#282828;">Minimal</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#F1D3AB;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#F1D3AB" stroke-width="0.35pt"><path d="M 121.07 -66.14 L 56.69 -66.14 C 55.54 -66.14 54.61 -67.07 54.61 -68.22 L 54.61 -81.9 C 54.61 -83.05 55.54 -83.98 56.69 -83.98 L 121.07 -83.98 C 122.21 -83.98 123.14 -83.05 123.14 -81.9 L 123.14 -68.22 C 123.14 -67.07 122.21 -66.14 121.07 -66.14 Z M 54.61 -83.98"></path></g><g style="--ltx-stroke-color:#282828;--ltx-fill-color:#282828;" fill="#282828" stroke="#282828" stroke-width="0.35pt" transform="matrix(1.0 0.0 0.0 1.0 57.38 -78.52)"><foreignObject style="--ltx-fo-width:4.58em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="63.38"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S3.F1.pic1.5" class="ltx_text ltx_font_sansserif" style="--ltx-fg-color:#282828;">Corpus-Sp.</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#F1D3AB;--ltx-fill-color:#FFFFFF;" fill="#FFFFFF" stroke="#F1D3AB" stroke-width="0.35pt"><path d="M 163.89 -66.14 L 128.07 -66.14 C 126.92 -66.14 125.99 -67.07 125.99 -68.22 L 125.99 -81.9 C 125.99 -83.05 126.92 -83.98 128.07 -83.98 L 163.89 -83.98 C 165.03 -83.98 165.96 -83.05 165.96 -81.9 L 165.96 -68.22 C 165.96 -67.07 165.03 -66.14 163.89 -66.14 Z M 125.99 -83.98"></path></g><g style="--ltx-stroke-color:#282828;--ltx-fill-color:#282828;" fill="#282828" stroke="#282828" stroke-width="0.35pt" transform="matrix(1.0 0.0 0.0 1.0 128.76 -78.52)"><foreignObject style="--ltx-fo-width:2.49em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="34.44"><span class="ltx_foreignobject_container"><span cl