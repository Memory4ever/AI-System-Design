<td id="A3.T35.2.3.2" class="ltx_td ltx_align_center">0.731</td>
<td id="A3.T35.2.3.3" class="ltx_td ltx_align_center"><math id="A3.T35.m5" class="ltx_Math" alttext="-0.012" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.012</mn></mrow><annotation encoding="application/x-tex">-0.012</annotation></semantics></math></td></tr>
<tr id="A3.T35.2.4" class="ltx_tr">
