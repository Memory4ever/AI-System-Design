<td id="A1.T7.2.1.2.3" class="ltx_td ltx_align_right ltx_border_t">4,293</td>
<td id="A1.T7.2.1.2.4" class="ltx_td ltx_align_right ltx_border_t">183,408</td>
<td id="A1.T7.2.1.2.5" class="ltx_td ltx_align_right ltx_border_t">42.7</td></tr>
<tr id="A1.T7.2.1.3" class="ltx_tr">
