<td id="A3.T37.2.1.3.2" class="ltx_td ltx_align_center">34%</td>
<td id="A3.T37.2.1.3.3" class="ltx_td ltx_align_center">Cloud</td></tr>
<tr id="A3.T37.2.1.4" class="ltx_tr">
