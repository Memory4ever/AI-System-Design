<td id="A2.SS8.SSS0.Px2.p4.1.4.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A2.SS8.SSS0.Px2.m3" class="ltx_math_unparsed" alttext="5\times" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">5\times</annotation></semantics></math></td></tr>
