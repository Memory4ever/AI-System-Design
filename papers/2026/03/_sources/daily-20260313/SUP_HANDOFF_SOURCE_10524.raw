<td id="A2.SS8.SSS0.Px2.p4.1.3.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">Pointwise LLM (1–10)</td>
<td id="A2.SS8.SSS0.Px2.p4.1.3.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">0.701</td>
<td id="A2.SS8.SSS0.Px2.p4.1.3.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">$0.050</td>
<td id="A2.SS8.SSS0.Px2.p4.1.3.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="A2.SS8.SSS0.Px2.m2" class="ltx_math_unparsed" alttext="10\times" display="inline" intent=":literal"><semantics><mrow><mn>10</mn><mo lspace="0.222em">×</mo></mrow><annotation encoding="application/x-tex">10\times</annotation></semantics></math></td></tr>
