<th id="A3.T36.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T36.2.1.2.1" class="ltx_text ltx_font_bold">HM</span></th>
<th id="A3.T36.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T36.2.1.3.1" class="ltx_text ltx_font_bold">RB<math id="A3.T36.m1" class="ltx_Math" alttext="{}_{\text{llm}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">llm</mtext></msub><annotation encoding="application/x-tex">{}_{\text{llm}}</annotation></semantics></math></span></th>
