<th id="A3.T35.2.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T35.2.1.2.1" class="ltx_text ltx_font_bold">HM</span></th>
<th id="A3.T35.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A3.T35.m1" class="ltx_Math" alttext="\Delta" display="inline" intent=":literal"><semantics><mi mathvariant="normal">Δ</mi><annotation encoding="application/x-tex">\Delta</annotation></semantics></math></th></tr>
