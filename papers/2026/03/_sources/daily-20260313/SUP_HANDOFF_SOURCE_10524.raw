<tr id="A3.T35.2.7" class="ltx_tr">
<td id="A3.T35.2.7.1" class="ltx_td ltx_align_left ltx_border_bb"><math id="A3.T35.m11" class="ltx_Math" alttext="[0.35,0.50]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.35</mn><mo>,</mo><mn>0.50</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.35,0.50]</annotation></semantics></math> (high)</td>
<td id="A3.T35.2.7.2" class="ltx_td ltx_align_center ltx_border_bb">0.733</td>
<td id="A3.T35.2.7.3" class="ltx_td ltx_align_center ltx_border_bb"><math id="A3.T35.m12" class="ltx_Math" alttext="-0.010" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.010</mn></mrow><annotation encoding="application/x-tex">-0.010</annotation></semantics></math></td></tr>
