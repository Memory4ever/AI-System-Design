<td id="A4.T39.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.798</td>
<td id="A4.T39.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.312</td></tr>
<tr id="A4.T39.2.3" class="ltx_tr">
<td id="A4.T39.2.3.1" class="ltx_td ltx_align_left">Single-judge gate, top-5 passages</td>
<td id="A4.T39.2.3.2" class="ltx_td ltx_align_center">0.561</td>
<td id="A4.T39.2.3.3" class="ltx_td ltx_align_center">0.821</td>
<td id="A4.T39.2.3.4" class="ltx_td ltx_align_center">0.356</td></tr>
<tr id="A4.T39.2.4" class="ltx_tr">
