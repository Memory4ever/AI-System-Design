<td id="A3.T35.2.4.2" class="ltx_td ltx_align_center">0.738</td>
<td id="A3.T35.2.4.3" class="ltx_td ltx_align_center"><math id="A3.T35.m7" class="ltx_Math" alttext="-0.005" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mn>0.005</mn></mrow><annotation encoding="application/x-tex">-0.005</annotation></semantics></math></td></tr>
<tr id="A3.T35.2.5" class="ltx_tr">
<td id="A3.T35.2.5.1" class="ltx_td ltx_align_left"><math id="A3.T35.m8" class="ltx_Math" alttext="[0.28,0.38]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0.28</mn><mo>,</mo><mn>0.38</mn><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0.28,0.38]</annotation></semantics></math><span id="A3.T35.2.5.1.1" class="ltx_text ltx_font_bold"> (ours)</span></td>
<td id="A3.T35.2.5.2" class="ltx_td ltx_align_center"><span id="A3.T35.2.5.2.1" class="ltx_text ltx_font_bold">0.743</span></td>
<td id="A3.T35.2.5.3" class="ltx_td ltx_align_center">–</td></tr>
