<td id="A4.T38.2.2.3" class="ltx_td ltx_align_center ltx_border_t">0.892</td>
<td id="A4.T38.2.2.4" class="ltx_td ltx_align_center ltx_border_t">0.261</td></tr>
<tr id="A4.T38.2.3" class="ltx_tr">
<td id="A4.T38.2.3.1" class="ltx_td ltx_align_center">0.60</td>
<td id="A4.T38.2.3.2" class="ltx_td ltx_align_center">0.591</td>
<td id="A4.T38.2.3.3" class="ltx_td ltx_align_center">0.923</td>
<td id="A4.T38.2.3.4" class="ltx_td ltx_align_center">0.251</td></tr>
<tr id="A4.T38.2.4" class="ltx_tr">
