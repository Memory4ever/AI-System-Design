<td id="A4.T38.2.4.2" class="ltx_td ltx_align_center"><span id="A4.T38.2.4.2.1" class="ltx_text ltx_font_bold">0.610</span></td>
<td id="A4.T38.2.4.3" class="ltx_td ltx_align_center"><span id="A4.T38.2.4.3.1" class="ltx_text ltx_font_bold">0.958</span></td>
<td id="A4.T38.2.4.4" class="ltx_td ltx_align_center"><span id="A4.T38.2.4.4.1" class="ltx_text ltx_font_bold">0.240</span></td></tr>
<tr id="A4.T38.2.5" class="ltx_tr">
<td id="A4.T38.2.5.1" class="ltx_td ltx_align_center">0.80</td>
<td id="A4.T38.2.5.2" class="ltx_td ltx_align_center">0.597</td>
<td id="A4.T38.2.5.3" class="ltx_td ltx_align_center">0.971</td>
<td id="A4.T38.2.5.4" class="ltx_td ltx_align_center">0.198</td></tr>
