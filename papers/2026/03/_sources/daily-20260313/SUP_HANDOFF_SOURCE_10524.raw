<th id="A3.T33.2.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A3.T33.2.1.1.3.1" class="ltx_text ltx_font_bold">RL<math id="A3.T33.m1" class="ltx_Math" alttext="{}_{\text{F}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext class="ltx_mathvariant_bold">F</mtext></msub><annotation encoding="application/x-tex">{}_{\text{F}}</annotation></semantics></math></span></th>
