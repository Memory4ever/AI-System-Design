<th id="A1.T7.2.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_row">Finance forum</th>
<td id="A1.T7.2.1.3.3" class="ltx_td ltx_align_right">57,638</td>
<td id="A1.T7.2.1.3.4" class="ltx_td ltx_align_right">61,022</td>
<td id="A1.T7.2.1.3.5" class="ltx_td ltx_align_right">1.1</td></tr>
<tr id="A1.T7.2.1.4" class="ltx_tr">
