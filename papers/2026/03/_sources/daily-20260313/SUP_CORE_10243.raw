<tr id="A3.T5.5.9" class="ltx_tr">
<td id="A3.T5.5.9.1" class="ltx_td ltx_align_left"><span id="A3.T5.5.9.1.1" class="ltx_text">WinoGrande</span> &amp;
<span id="A3.T5.5.9.1.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Choose the most appropriate option to fill in the blank for the sentence: {sentence}.</span></td></tr>
<tr id="A3.T5.5.10" class="ltx_tr">
<td id="A3.T5.5.10.1" class="ltx_td ltx_align_left">&amp; <span id="A3.T5.5.10.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Options: A: {optionA}, B: {optionB}</span></td></tr>
<tr id="A3.T5.5.11" class="ltx_tr">
<td id="A3.T5.5.11.1" class="ltx_td ltx_align_left">&amp; <span id="A3.T5.5.11.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Output only A or B</span></td></tr>
<tr id="A3.T5.5.12" class="ltx_tr">
<td id="A3.T5.5.12.1" class="ltx_td ltx_align_left"><span id="A3.T5.5.12.1.1" class="ltx_text">MedQA</span> &amp;
<span id="A3.T5.5.12.1.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Question:{query}</span></td></tr>
<tr id="A3.T5.5.13" class="ltx_tr">
<td id="A3.T5.5.13.1" class="ltx_td ltx_align_left">&amp; <span id="A3.T5.5.13.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Options: A: {optionA}, B: {optionB}, C: {optionC}, D: {optionD}</span></td></tr>
<tr id="A3.T5.5.14" class="ltx_tr">
<td id="A3.T5.5.14.1" class="ltx_td ltx_align_left ltx_border_bb">&amp; <span id="A3.T5.5.14.1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;">Output only A, B, C, or D</span></td></tr>
