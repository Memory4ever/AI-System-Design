<span id="S4.T1.7.2.12.1.1" class="ltx_p ltx_align_center"><span id="S4.T1.7.2.12.1.1.1" class="ltx_text" style="font-size:90%;">Acc </span><math id="S4.T1.m13" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span>
</span></td>
<td id="S4.T1.7.2.13" class="ltx_td ltx_align_left ltx_align_middle"></td></tr>
<tr id="S4.T1.7.3" class="ltx_tr">
