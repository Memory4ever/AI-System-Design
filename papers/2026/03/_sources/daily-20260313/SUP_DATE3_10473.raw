{"data":{"id":"10.48550/arxiv.2603.10473","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.10473","prefix":"10.48550","suffix":"arxiv.2603.10473","identifiers":[{"identifier":"2603.10473","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.10473"}],"creators":[{"name":"Wu, Wei","nameType":"Personal","givenName":"Wei","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Peilun","nameType":"Personal","givenName":"Peilun","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Liyi","nameType":"Personal","givenName":"Liyi","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qimeng","nameType":"Personal","givenName":"Qimeng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Chengqiang","nameType":"Personal","givenName":"Chengqiang","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Gao, Yan","nameType":"Personal","givenName":"Yan","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Yi","nameType":"Personal","givenName":"Yi","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Hu, Yao","nameType":"Personal","givenName":"Yao","familyName":"Hu","affiliation":[],"nameIdentifiers":[]},{"name":"Xiong, Hui","nameType":"Personal","givenName":"Hui","familyName":"Xiong","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Aligning Large Language Models with Searcher Preferences"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-11T06:44:30Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-12T00:30:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"The paradigm shift from item-centric ranking to answer-centric synthesis is redefining the role of search engines. While recent industrial progress has applied generative techniques to closed-set item ranking in e-commerce, research and deployment of open-ended generative search on large content platforms remain limited. This setting introduces challenges, including robustness to noisy retrieval, non-negotiable safety guarantees, and alignment with diverse user needs. In this work, we introduce SearchLLM, the first large language model (LLM) for open-ended generative search. We design a hierarchical, multi-dimensional reward system that separates bottom-line constraints, including factual grounding, basic answer quality and format compliance, from behavior optimization objectives that promote robustness to noisy retrieval and alignment with user needs. Concretely, our reward model evaluates responses conditioned on the user query, session history, and retrieved evidence set, combining rule-based checks with human-calibrated LLM judges to produce an interpretable score vector over these dimensions. We introduce a Gated Aggregation Strategy to derive the training reward for optimizing SearchLLM with Group Relative Policy Optimization (GRPO). We deploy SearchLLM in the AI search entry of RedNote. Offline evaluations and online A/B tests show improved generation quality and user engagement, increasing Valid Consumption Rate by 1.03% and reducing Re-search Rate by 2.81%, while upholding strict safety and reliability standards.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.10473","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-12T02:02:27.000Z","registered":"2026-03-12T02:02:28.000Z","published":"2026","updated":"2026-03-12T02:02:28.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.10473","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}