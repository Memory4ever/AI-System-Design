<tr id="S7.T22.4.10" class="ltx_tr">
<td id="S7.T22.4.10.1" class="ltx_td ltx_align_left" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T22.4.10.1.1" class="ltx_text" style="font-size:80%;">RepE <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib27" title="" class="ltx_ref">24</a>]</cite></span></td>
<td id="S7.T22.4.10.2" class="ltx_td ltx_align_center" style="padding-left:2.0pt;padding-right:2.0pt;"><span id="S7.T22.4.10.2.1" class="ltx_text" style="font-size:80%;">Yes</span></td>
