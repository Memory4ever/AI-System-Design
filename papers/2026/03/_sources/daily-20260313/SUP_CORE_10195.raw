<td id="S3.T4.4.7.2" class="ltx_td ltx_align_left"><span id="S3.T4.4.7.2.1" class="ltx_text" style="font-size:90%;">MC2</span></td>
<td id="S3.T4.4.7.3" class="ltx_td ltx_align_left"><span id="S3.T4.4.7.3.1" class="ltx_text" style="font-size:90%;">Normalised prob. mass over true answers <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib16" title="" class="ltx_ref">20</a>]</cite></span></td>
<td id="S3.T4.4.7.4" class="ltx_td ltx_align_center"><math id="S3.T4.m9" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></td></tr>
