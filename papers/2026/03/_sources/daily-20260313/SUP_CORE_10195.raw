<th id="S5.T19.10.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S5.T19.10.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Model</span></th>
<th id="S5.T19.10.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S5.T19.10.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Metric</span></th>
<th id="S5.T19.10.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T19.10.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">ITI</span></th>
<th id="S5.T19.10.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T19.10.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">DoLA</span></th>
<th id="S5.T19.10.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="S5.T19.10.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">H-Node ANC</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="S5.T19.10.2" class="ltx_tr">
<td id="S5.T19.10.2.1" class="ltx_td ltx_align_left ltx_border_t" rowspan="2"><span id="S5.T19.10.2.1.1" class="ltx_text" style="font-size:90%;">OPT-125M</span></td>
<td id="S5.T19.10.2.2" class="ltx_td ltx_align_left ltx_border_t"><span id="S5.T19.10.2.2.1" class="ltx_text" style="font-size:90%;">Best probe selectivity</span></td>
<td id="S5.T19.10.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T19.10.2.3.1" class="ltx_text" style="font-size:90%;">1.56<math id="S5.T19.m1" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td>
