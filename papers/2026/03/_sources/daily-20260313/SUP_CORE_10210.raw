                <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
                
                
                <span id="alg1.l8.3" class="ltx_text ltx_font_bold">for</span> each layer <math id="alg1.l8.m1" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math> <span id="alg1.l8.4" class="ltx_text ltx_font_bold">do</span>



