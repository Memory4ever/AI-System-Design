               <math id="alg1.l22.m1" class="ltx_Math" alttext="\theta\leftarrow\text{optimizer}(\theta,g,\eta)" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo stretchy="false">←</mo><mrow><mtext>optimizer</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>g</mi><mo>,</mo><mi>η</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\theta\leftarrow\text{optimizer}(\theta,g,\eta)</annotation></semantics></math>

