gnObject></g><g style="--ltx-fg-color:#000000;" color="#000000" transform="translate(0.32,0)"><foreignObject style="--ltx-fo-width:2.56em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:19.87pt;" height="13.79" overflow="visible" transform="matrix(1 0 0 -1 0 13.79)" width="70.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.8" class="ltx_text ltx_font_bold" style="font-size:90%;position:relative; bottom:-0.6pt;--ltx-fg-color:#FFFFFF;">Desired<span id="S2.F2.pic1.8.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <span id="S2.F2.pic1.8.1.1" class="ltx_text" style="font-size:160%;">✓</span></span></span></span></span></foreignObject></g><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:2.56em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:19.87pt;" color="#000000" height="13.79" overflow="visible" transform="matrix(1 0 0 -1 0 13.79)" width="70.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.9" class="ltx_text ltx_font_bold" style="font-size:90%;position:relative; bottom:-0.6pt;--ltx-fg-color:#FFFFFF;">Desired<span id="S2.F2.pic1.9.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <span id="S2.F2.pic1.9.1.1" class="ltx_text" style="font-size:160%;">✓</span></span></span></span></span></foreignObject><g style="--ltx-fg-color:#000000;" color="#000000" transform="translate(-0.32,0)"><foreignObject style="--ltx-fo-width:2.56em;--ltx-fo-height:0.5em;--ltx-fo-depth:0em;font-size:19.87pt;" height="13.79" overflow="visible" transform="matrix(1 0 0 -1 0 13.79)" width="70.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S2.F2.pic1.10" class="ltx_text ltx_font_bold" style="font-size:90%;position:relative; bottom:-0.6pt;--ltx-fg-color:#FFFFFF;">Desired<span id="S2.F2.pic1.10.1" class="ltx_text" style="--ltx-fg-color:#000000;"> <span id="S2.F2.pic1.10.1.1" class="ltx_text" style="font-size:160%;">✓</