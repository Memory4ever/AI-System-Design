               <math id="alg1.l12.m1" class="ltx_Math" alttext="\mathcal{L}_{f}\leftarrow||\epsilon^{\prime}-\epsilon_{\theta}(x_{t}^{f},t)||_{2}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>f</mi></msub><mo stretchy="false">←</mo><msubsup><mrow><mo stretchy="false">‖</mo><mrow><msup><mi>ϵ</mi><mo>′</mo></msup><mo>−</mo><mrow><msub><mi>ϵ</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>x</mi><mi>t</mi><mi>f</mi></msubsup><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{L}_{f}\leftarrow||\epsilon^{\prime}-\epsilon_{\theta}(x_{t}^{f},t)||_{2}^{2}</annotation></semantics></math>
<span id="alg1.l12.2" class="ltx_text" style="float:right;"><math id="alg1.l12.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Forget loss
</span>
</div>
<div id="alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
               <math id="alg1.l13.m1" class="ltx_Math" alttext="\lambda(t)\leftarrow 1-\beta t" display="inline" intent=":literal"><semantics><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">←</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\lambda(t)\leftarrow 1-\beta t</annotation></semantics></math> <span id="alg1.l13.2" class="ltx_text" style="float:right;"><math id="alg1.l13.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Timestep-aware weighting
</span>
</div>
<div id="alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
               <math id="alg1.l14.m1" class="ltx_Math" alttext="g_{r}\leftarrow\lambda(t)\nabla_{\theta}\mathcal{L}_{r}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>r</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>r</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{r}\leftarrow\lambda(t)\nabla_{\theta}\mathcal{L}_{r}</annotation></semantics></math>

</div>
<div id="alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
               <math id="alg1.l15.m1" class="ltx_Math" alttext="g_{f}\leftarrow(1-\lambda(t))\nabla_{\theta}\mathcal{L}_{f}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mi>f</mi></msub><mo stretchy="false">←</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>λ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>f</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{f}\leftarrow(1-\lambda(t))\nabla_{\theta}\mathcal{L}_{f}</annotation></semantics></math>

</div>
<div id="alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
               <span id="alg1.l16.2" class="ltx_text ltx_font_bold">if</span> <math id="alg1.l16.m1" class="ltx_Math" alttext="g_{r}\cdot g_{f}&lt;0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>g</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>g</mi><mi>f</mi></msub></mrow><mo>&lt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">g_{r}\cdot g_{f}&lt;0</annotation></semantics></math> <span id="alg1.l16.3" class="ltx_text ltx_font_bold">then</span> <span id="alg1.l16.4" class="ltx_text" style="float:right;"><math id="alg1.l16.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Gradient surgery
</span>
</div>
<div id="alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
                 <math id="alg1.l17.m1" class="ltx_Math" alttext="g_{f}^{\prime}\leftarrow g_{f}-\frac{g_{r}\cdot g_{f}}{||g_{r}||^{2}}g_{r}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>f</mi><mo>′</mo></msubsup><mo stretchy="false">←</mo><mrow><msub><mi>g</mi><mi>f</mi></msub><mo>−</mo><mrow><mfrac><mrow><msub><mi>g</mi><mi>r</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>g</mi><mi>f</mi></msub></mrow><msup><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>r</mi></msub><mo stretchy="false">‖</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>r</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">g_{f}^{\prime}\leftarrow g_{f}-\frac{g_{r}\cdot g_{f}}{||g_{r}||^{2}}g_{r}</annotation></semantics></math>

</div>
<div id="alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
               <span id="alg1.l18.2" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
                 <math id="alg1.l19.m1" class="ltx_Math" alttext="g_{f}^{\prime}\leftarrow g_{f}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>g</mi><mi>f</mi><mo>′</mo></msubsup><mo stretchy="false">←</mo><msub><mi>g</mi><mi>f</mi></msub></mrow><annotation encoding="application/x-tex">g_{f}^{\prime}\leftarrow g_{f}</annotation></semantics></math>

</div>
<div id="alg1.l20" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l20.1" class="ltx_text" style="font-size:80%;">20:</span></span>
              
               <span id="alg1.l20.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l20.3" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="alg1.l21" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l21.1" class="ltx_text" style="font-size:80%;">21:</span></span>
              
               <math id="alg1.l21.m1" class="ltx_Math" alttext="g\leftarrow g_{r}+g_{f}^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo stretchy="false">←</mo><mrow><msub><mi>g</mi><mi>r</mi></msub><mo>+</mo><msubsup><mi>g</mi><mi>f</mi><mo>′</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">g\leftarrow g_{r}+g_{f}^{\prime}</annotation></semantics></math> <span id="alg1.l21.2" class="ltx_text" style="float:right;"><math id="alg1.l21.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Combine gradients for update
</span>
</div>
