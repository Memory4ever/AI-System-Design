              <span id="alg1.l23.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l23.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l24" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l24.1" class="ltx_text" style="font-size:80%;">24:</span></span>
              
            <span id="alg1.l24.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l24.3" class="ltx_text ltx_font_bold">for</span>
