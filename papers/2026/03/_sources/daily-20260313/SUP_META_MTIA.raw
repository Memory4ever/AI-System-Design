yY2UiOiJ3d3cifQ\u00253D\u00253D&amp;ccb=17-1&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;_nc_zt=28&amp;oh=00_AQOMdsaqQrAnK4Qx34as8YY0jmQg6EXdB0O75QuJZdKWxA&amp;oe=6ACECA71&amp;bitrate=35065&amp;tag=sve_sd\" autoplay=\"1\" class=\"_abv1 _9rzn _9lwe\" controlslist=\"nodownload\" height=\"2400\" loop=\"1\" muted=\"1\" poster=\"https:\/\/scontent-lax3-1.xx.fbcdn.net\/v\/t15.5256-10\/646355837_2131296100986929_6968962060134426067_n.jpg?_nc_cat=104&amp;ccb=1-7&amp;_nc_sid=b07905&amp;_nc_ohc=z9r0esot4_IQ7kNvwGrdAnO&amp;_nc_oc=AdqsgNyC0NUR0A7DTfd8vkukt6fvcuDmeS7W7NWG2_bX4-nYosD-HeQtv31FU_krKu_UbYOPPoAjotxl5ADJhemf&amp;_nc_zt=23&amp;_nc_ht=scontent-lax3-1.xx&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;oh=00_AQMOOw4PDiAL924milSvxKyQGat7W9BsQLj_mnPZQyE2Tg&amp;oe=6ACEC469\" title=\"Block diagram of the MTIA 300 chip architecture. The central compute chiplet contains a PE Grid at its core, flanked on both sides by LLC (Last-Level Cache) blocks and D2D (die-to-die) interconnects. HBM memory stacks sit on the far left and right, each connected via HBM CTR\/PHY controllers. At the bottom of the compute chiplet are CCP, D2D, and PCIe blocks. Two network chiplets &#x2014; one above and one below the compute chiplet &#x2014; each contain a D2D interface, a Network IO block, and a RoCE interface running at 6x800 Gbps.\" width=\"1920\" id=\"u_0_33_wu\">\u003C\/video>\u003C\/div>\u003C\/div>\u003C\/div>"},5,"HTML"],["__markup_9eee46c6_0_3_bp",{"__html":"\u003Cdiv class=\"_a5n5 _al8o _a5n7 _aceh\">\u003Cdiv class=\"_8h4z _8h4- _a4zf\">\u003Cdiv data-testid=\"responsive-video\" id=\"u_0_34_52\">\u003Cspan id=\"u_0_35_vx\">\u003C\/span>\u003Cvideo src=\"https:\/\/video-lax3-1.xx.fbcdn.net\/o1\/v\/t2\/f2\/m412\/AQNgzvXyUnLaHbkNwFfvyiDadUDLvpbTZLy_5G49fa8QL4Uukrx-yiydRWmxDXl7pEqoWzgsL47DgPGcD01cX1iVDTsaGov0xFkmDGV6XQ.mp4?_nc_cat=109&amp;_nc_sid=8bf8fe&amp;_nc_ht=video-lax3-1.xx.fbcdn.net&amp;_nc_ohc=f6xLvtZ1_ukQ7kNvwH1dKuN&amp;efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5GQUNFQk9PSy4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6MTg3NTM3MDIyNjUwMDUyOCwiYXNzZXRfYWdlX2RheXMiOjIxNywidmlfdXNlY2FzZV9pZCI6MTAxMjgsImR1cmF0aW9uX3MiOjUsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\u00253D\u00253D&amp;ccb=17-1&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;_nc_zt=28&amp;oh=00_AQMjdbUd_maXOtNk1zDeCGhicjkF6ebxWwqwXakwwbeTbA&amp;oe=6ACEADCD&amp;bitrate=50147&amp;tag=sve_sd\" autoplay=\"1\" class=\"_abv1 _ag1_ _9lwe\" controlslist=\"nodownload\" height=\"2400\" loop=\"1\" muted=\"1\" poster=\"https:\/\/scontent-lax3-2.xx.fbcdn.net\/v\/t15.5256-10\/645642206_1649328296420771_4196987306986508150_n.jpg?_nc_cat=103&amp;ccb=1-7&amp;_nc_sid=b07905&amp;_nc_ohc=T1eJyrohtRkQ7kNvwEJY_3K&amp;_nc_oc=AdoEKof-2v-FZXCvqR1-yeOxiLQEeiZTpeVXGTmQ1J3d6A5GbqCPZKwG8DfXZzSkmeV5XBacYcJrbM4FAn9_CdHV&amp;_nc_zt=23&amp;_nc_ht=scontent-lax3-2.xx&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;oh=00_AQOUeCxByhcG2g7uVb7T-4gh1W90ruDYbJpNGDEZuVRYWw&amp;oe=6ACEA3E7\" title=\"Block diagram of the MTIA 500 chip architecture. The package adopts a 2x2 configuration of four smaller compute chiplets arranged in a two-by-two grid. Each row of two chiplets forms a wide compute tier, with the left and right chiplets in each row each containing a PE Grid; the two chiplets within each row are connected to each other via a pair of vertical D2D interfaces at their shared centre boundary. Each row is flanked on the far left and right by HBM memory stacks connected via HBM CTR\/PHY controllers and LLC blocks. The two rows of compute chiplets are stacked vertically and interconnected via paired D2D interfaces at their shared horizontal boundary. At the top, a wider SoC chiplet provides Host Inference PCIe connectivity and houses a CCP block, connected to the upper compute row via two D2D interfaces. At the bottom, two network chiplets sit side by side, each connected via two D2D interfaces and providing a Network IO block and a RoCE interface running at 6x800 Gbps.\" width=\"1920\" id=\"u_0_36_TI\">\u003C\/video>\u003C\/div>\u003C\/div>\u003C\/div>"},5,"HTML"],["__markup_9eee46c6_0_2_ch",{"__html":"\u003Cdiv class=\"_a5n5 _al8o _a5n7 _aceh\">\u003Cdiv class=\"_8h4z _8h4- _a4zf\">\u003Cdiv data-testid=\"responsive-video\" id=\"u_0_37_1u\">\u003Cspan id=\"u_0_38_pq\">\u003C\/span>\u003Cvideo src=\"https:\/\/video-lax3-1.xx.fbcdn.net\/o1\/v\/t2\/f2\/m412\/AQMlZu07C4cvJtRrtrRjiXgSd_7XhJt2bfBcVCOCiviQ5UkgO5IhfXglodgZOGwF6oLX_oy5JX8usyPGazVg01wOX1xKeDK0ewoXIWJGWA.mp4?_nc_cat=108&amp;_nc_sid=8bf8fe&amp;_nc_ht=video-lax3-1.xx.fbcdn.net&amp;_nc_ohc=aSjjkIvLNiUQ7kNvwGw_I9V&amp;efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5GQUNFQk9PSy4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6MTI2MjM1NjcwMTkxOTM5MiwiYXNzZXRfYWdlX2RheXMiOjIxNywidmlfdXNlY2FzZV9pZCI6MTAxMjgsImR1cmF0aW9uX3MiOjUsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\u00253D\u00253D&amp;ccb=17-1&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;_nc_zt=28&amp;oh=00_AQOrY4DnKRwQUKt1xor-_0aBFETXn-hNbMvh8JSLiZRggA&amp;oe=6ACEB6CE&amp;bitrate=44198&amp;tag=sve_sd\" autoplay=\"1\" class=\"_ag1_ _9lwe\" controlslist=\"nodownload\" height=\"2400\" loop=\"1\" muted=\"1\" playsinline=\"1\" poster=\"https:\/\/scontent-lax3-1.xx.fbcdn.net\/v\/t15.5256-10\/646176466_1962437588044959_6344221133981035511_n.jpg?_nc_cat=109&amp;ccb=1-7&amp;_nc_sid=b07905&amp;_nc_ohc=lsHGye-6u8QQ7kNvwGSUWWk&amp;_nc_oc=AdrKbbm3eao95bEPp6hIZsxyw6pSB7vCl_A0okCLhvAaPlyZ9k2h6GpxZVYnDqP7ssl-d-Yd3QuQvnsX2ewY1jjN&amp;_nc_zt=23&amp;_nc_ht=scontent-lax3-1.xx&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;oh=00_AQNXm-aha1_8rnQos3RDxvT-PByzuXdbh0MUx2EdKftULA&amp;oe=6ACEC6E5\" title=\"Block diagram of the MTIA 450 chip architecture. The package contains two compute chiplets stacked vertically, each with a PE Grid at its core, flanked on both sides by LLC blocks and HBM memory stacks connected via HBM CTR\/PHY controllers. A key difference from MTIA 400 is that each chiplet now features two D2D interfaces at both its top and bottom edges &#x2014; rather than one &#x2014; reflecting the doubled HBM bandwidth. The two compute chiplets are linked to each other via paired D2D interfaces. At the top, a SoC chiplet provides Host Inference PCIe connectivity and houses a CCP block, connected to the upper compute chiplet via two D2D interfaces. At the bottom, two network chiplets sit side by side, each connected via two D2D interfaces and providing a Network IO block and a RoCE interface running at 6x800 Gbps.\" width=\"1920\" id=\"u_0_39_ss\">\u003C\/video>\u003C\/div>\u003C\/div>\u003C\/div>"},5,"HTML"],["__markup_9eee46c6_0_1_Wj",{"__html":"\u003Cdiv class=\"_a5n5 _al8o _a5n7 _aceh\">\u003Cdiv class=\"_8h4z _8h4- _a4zf\">\u003Cdiv data-testid=\"responsive-video\" id=\"u_0_3a_nB\">\u003Cspan id=\"u_0_3b_aY\">\u003C\/span>\u003Cvideo src=\"https:\/\/video-lax3-2.xx.fbcdn.net\/o1\/v\/t2\/f2\/m412\/AQP3sA3L87Mka2l0XZ2-5dae6n4j70Vl72XAFRdPGpIXeVphap0iv-4LPczC_yuUtUO9F-HGJ3jv8Unv-F3uyKN62MqsuIJgT8E7ljCwSQ.mp4?_nc_cat=111&amp;_nc_sid=8bf8fe&amp;_nc_ht=video-lax3-2.xx.fbcdn.net&amp;_nc_ohc=rac1XlorEDAQ7kNvwHdWQUI&amp;efg=eyJ2ZW5jb2RlX3RhZyI6Inhwdl9wcm9ncmVzc2l2ZS5GQUNFQk9PSy4uQzMuMzYwLnN2ZV9zZCIsInhwdl9hc3NldF9pZCI6MTY2Mzk4NTI1ODM2Njc4NCwiYXNzZXRfYWdlX2RheXMiOjIxNywidmlfdXNlY2FzZV9pZCI6MTAxMjgsImR1cmF0aW9uX3MiOjUsInVybGdlbl9zb3VyY2UiOiJ3d3cifQ\u00253D\u00253D&amp;ccb=17-1&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;_nc_zt=28&amp;oh=00_AQM9wI9BVEwFbsoii-ft2XrTnPQAmtYgr9jdQntK-1Efaw&amp;oe=6ACEB3E7&amp;bitrate=43033&amp;tag=sve_sd\" autoplay=\"1\" class=\"_ag1_ _9lwe\" controlslist=\"nodownload\" height=\"2400\" loop=\"1\" muted=\"1\" playsinline=\"1\" poster=\"https:\/\/scontent-lax3-1.xx.fbcdn.net\/v\/t15.5256-10\/646758120_2037139414351049_1709213513492882960_n.jpg?_nc_cat=102&amp;ccb=1-7&amp;_nc_sid=b07905&amp;_nc_ohc=pWkvp8Y8bawQ7kNvwFeOrVK&amp;_nc_oc=AdqGsTeVD-rzVJj3nwOcVboGpodbFTmCNREGFByop7ksda1-6ubCw0no0cF8DIFDVtzIUVpPoaOIQEdv2M11WNEW&amp;_nc_zt=23&amp;_nc_ht=scontent-lax3-1.xx&amp;_nc_gid=j8MdErER5OBYor6xsKieVw&amp;_nc_ss=7020f&amp;oh=00_AQOroA1md-W8-QIf3Yq6NSr703cO6uczxzBfJq1ETGDE5A&amp;oe=6ACECD87\" title=\"Block diagram of the MTIA 400 chip architecture. The package contains two compute chiplets stacked vertically, each with a PE Grid at its core, flanked on both sides by LLC blocks and D2D interconnects, with HBM memory stacks on the far left and right connected via HBM CTR\/PHY controllers. The two chiplets are linked to each other via D2D interfaces. At the top of the upper compute chiplet, a SoC chiplet provides Host Inference PCIe connectivity and houses a CCP block. At the bottom, two network chiplets sit side by side, each connected via a D2D interface and providing a Network IO block and a RoCE interface running at 6x800 Gbps.\" width=\"1920\" id=\"u_0_3c_uA\">\u003C\/video>\u003C\/div>\u003C\/div>\u003C\/div>"},5,"HTML"]],"elements":[["__elem_c37bd704_0_0_qB","u_0_0_yf",1],["__elem_c37bd704_0_1_xf","u_0_1_fx",1],["__elem_fc9f538f_0_0_GY","u_0_2_3q",1],["__elem_4bf8f142_0_3_iu","u_0_3_p+",1],["__elem_4bf8f142_0_0_F3","u_0_4_U3",1],["__elem_fc9f538f_0_1_5T","u_0_5_md",1],["__elem_4bf8f142_0_1_7L","u_0_6_uT",1],["__elem_4bf8f142_0_2_Te","u_0_7_Jm",1],["__elem_a588f507_0_0_w0","u_0_8_py",1],["__elem_072b8e64_0_0_7e","u_0_9_6b",1],["__elem_94c15385_0_0_mA","u_0_a_Jr",1],["__elem_94c15385_0_1_sm","u_0_b_bl",1],["__elem_a588f507_0_1_XK","u_0_c_Sv",1],["__elem_072b8e64_0_1_HS","u_0_d_gl",1],["__elem_072b8e64_0_2_ZZ","u_0_e_wm",1],["__elem_072b8e64_0_3_Ne","u_0_f_dz",1],["__elem_a588f507_0_2_jm","u_0_g_U5",1],["__elem_072b8e64_0_4_Pq","u_0_h_if",1],["__elem_94c15385_0_2_j2","u_0_i_uP",1],["__elem_94c15385_0_3_N7","u_0_j_2x",1],["__elem_a588f507_0_3_U7","u_0_k_NP",1],["__elem_072b8e64_0_5_Sh","u_0_l_8V",1],["__elem_072b8e64_0_6_Yh","u_0_m_uJ",1],["__elem_072b8e64_0_7_2E","u_0_n_ys",1],["__elem_072b8e64_0_8_UN","u_0_o_el",1],["__elem_a588f507_0_4_HC","u_0_p_8B",1],["__elem_072b8e64_0_9_fn","u_0_q_kp",1],["__elem_94c15385_0_4_m+","u_0_r_9h",1],["__elem_94c15385_0_5_7E","u_0_s_