<picture class="media__image media__image">
    
    
        <source media="(min-width: 768px)" srcset="https://storage.googleapis.com/gweb-research2023-media/images/Urban-Flash-Floods-1.width-1250.png" alt="Urban-Flash-Floods-1" />
    
    <img src="https://storage.googleapis.com/gweb-research2023-media/images/Urban-Flash-Floods-1.width-1250.png" alt="Urban-Flash-Floods-1" loading="lazy" />
    
</picture>
  


          </div>
        </div>
      

      
        <div class="
          glue-grid__col
