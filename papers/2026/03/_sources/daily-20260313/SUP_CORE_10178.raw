</span>
</div>
<div id="alg3.l10" class="ltx_listingline">
                <span class="ltx_tag ltx_tag_listingline"><span id="alg3.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
                
                
              <span id="alg3.l10.3" class="ltx_text" style="font-size:90%;">      </span><math id="alg3.l10.m1" class="ltx_Math" alttext="\mathbf{v}^{(\text{ref})}_{i}\leftarrow\mathbf{v}^{(t)}_{i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.900em">𝐯</mi><mi mathsize="0.900em">i</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mtext mathsize="0.900em">ref</mtext><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup><mo mathsize="0.900em" stretchy="false">←</mo><msubsup><mi mathsize="0.900em">𝐯</mi><mi mathsize="0.900em">i</mi><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">\mathbf{v}^{(\text{ref})}_{i}\leftarrow\mathbf{v}^{(t)}_{i}</annotation></semantics></math><span id="alg3.l10.4" class="ltx_text" style="font-size:90%;"> </span><span id="alg3.l10.5" class="ltx_text" style="font-size:90%;float:right;"><math id="alg3.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Update reference
