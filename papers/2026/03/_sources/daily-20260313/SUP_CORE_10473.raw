</span></span></span></foreignObject></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 11.81 14.3)"><foreignObject style="--ltx-fo-width:35.45em;--ltx-fo-height:0.68em;--ltx-fo-depth:0.19em;font-size:9.25pt;" height="11.21" overflow="visible" transform="matrix(1 0 0 -1 0 8.72)" width="453.73"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
