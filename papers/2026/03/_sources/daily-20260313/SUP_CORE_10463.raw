<td id="S3.T2.5.1.17.1" class="ltx_td ltx_align_left ltx_border_b" style="padding-left:4.0pt;padding-right:4.0pt;">o3 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib47" title="" class="ltx_ref">29</a>]</cite></td>
