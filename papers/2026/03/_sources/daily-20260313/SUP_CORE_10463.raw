<td id="S3.T2.5.1.14.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;">3.50</td></tr>
<tr id="S3.T2.5.1.15" class="ltx_tr">
<td id="S3.T2.5.1.15.1" class="ltx_td ltx_align_left" style="padding-left:4.0pt;padding-right:4.0pt;">Claude Sonnet 4 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib45" title="" class="ltx_ref">3</a>]</cite></td>
