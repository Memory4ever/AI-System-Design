<span id="S6.T15.2.1.1.2.1.1" class="ltx_p"><span id="S6.T15.2.1.1.2.1.1.1" class="ltx_text ltx_font_bold" style="--ltx-fg-color:#000000;">Text</span></span>
</span></th>
