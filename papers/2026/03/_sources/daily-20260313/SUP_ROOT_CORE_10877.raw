<td id="S6.T17.2.1.5.2" class="ltx_td ltx_align_center"><span id="S6.T17.2.1.5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">59.4</span></td>
<td id="S6.T17.2.1.5.3" class="ltx_td ltx_align_center"><span id="S6.T17.2.1.5.3.1" class="ltx_text" style="--ltx-fg-color:#000000;">84.5</span></td>
