<th id="S5.T13.2.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S5.T13.2.1.5.1.1" class="ltx_text ltx_font_typewriter" style="--ltx-fg-color:#000000;">ARMADA</span><span id="S5.T13.2.1.5.1.2" class="ltx_text" style="--ltx-fg-color:#000000;"> with </span><math id="S5.T13.m3" class="ltx_Math" alttext="\mathcal{L}_{elementwise}" display="inline" intent=":literal"><semantics><msub><mi style="--ltx-fg-color:#000000;" class="ltx_font_mathcaligraphic" mathcolor="#000000">ℒ</mi><mrow><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">l</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">m</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">n</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">t</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">w</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">i</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">s</mi><mo lspace="0em" rspace="0em">​</mo><mi style="--ltx-fg-color:#000000;" mathcolor="#000000">e</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{L}_{elementwise}</annotation></semantics></math></th>
<td id="S5.T13.2.1.5.2" class="ltx_td ltx_align_center"><span id="S5.T13.2.1.5.2.1" class="ltx_text" style="--ltx-fg-color:#000000;">34.63</span></td>
<td id="S5.T13.2.1.5.3" class="ltx_td ltx_align_center"><span id="S5.T13.2.1.5.3.1" class="ltx_text" style="--ltx-fg-color:#0000FF;"><span id="S5.T13.2.1.5.3.1.1" class="ltx_text ltx_font_bold">29.06</span></span></td>
