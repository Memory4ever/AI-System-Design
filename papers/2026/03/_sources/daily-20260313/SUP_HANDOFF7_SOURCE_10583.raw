<span id="S5.T1.3.1.1.1.1.1.1.2.8" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.9" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.10" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.11" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.12" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.13" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.14" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.15" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.16" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.17" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.18" class="ltx_td ltx_align_center ltx_border_r">mAP</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.19" class="ltx_td ltx_align_center">Rank-1</span>
<span id="S5.T1.3.1.1.1.1.1.1.2.20" class="ltx_td ltx_align_center">mAP</span></span>
