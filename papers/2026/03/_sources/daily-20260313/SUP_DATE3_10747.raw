{"data":{"id":"10.48550/arxiv.2603.10747","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.10747","prefix":"10.48550","suffix":"arxiv.2603.10747","identifiers":[{"identifier":"2603.10747","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.10747"}],"creators":[{"name":"Balaka, Muhammad Imam Luthfi","nameType":"Personal","givenName":"Muhammad Imam Luthfi","familyName":"Balaka","affiliation":[],"nameIdentifiers":[]},{"name":"Hillesland, John","nameType":"Personal","givenName":"John","familyName":"Hillesland","affiliation":[],"nameIdentifiers":[]},{"name":"Badur, Kemal","nameType":"Personal","givenName":"Kemal","familyName":"Badur","affiliation":[],"nameIdentifiers":[]},{"name":"Fernandez, Raul Castro","nameType":"Personal","givenName":"Raul Castro","familyName":"Fernandez","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Pneuma-Seeker: A Relational Reification Mechanism to Align AI Agents with Human Work over Relational Data"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Databases (cs.DB)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-11T13:20:16Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-12T00:49:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"When faced with data problems, many data workers cannot articulate their information need precisely enough for software to help. Although LLMs interpret natural-language requests, they behave brittly when intent is under-specified, e.g., hallucinating fields, assuming join paths, or producing ungrounded answers.\n We present Pneuma-Seeker, a system built around a central idea: relational reification. Pneuma-Seeker represents a user's evolving information need as a relational schema: a concrete, analysis-ready data model shared between user and system. Rather than answering prompts directly, Pneuma-Seeker iteratively refines this schema, then discovers and prepares relevant sources to construct a relation and executable program that compute the answer. Pneuma-Seeker employs an LLM-powered agentic architecture with conductor-style planning and macro- and micro-level context management to operate effectively over heterogeneous relational corpora.\n We evaluate Pneuma-Seeker across multiple domains against state-of-the-art academic and industrial baselines, demonstrating higher answer accuracy. Deployment in a real organization highlights trust and inspectability as essential requirements for LLM-mediated data systems.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.10747","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-12T02:08:52.000Z","registered":"2026-03-12T02:08:53.000Z","published":"2026","updated":"2026-03-12T02:08:53.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.10747","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}