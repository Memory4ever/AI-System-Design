<td id="S4.T3.10.1.1.6" class="ltx_td ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"></td></tr>
<tr id="S4.T3.10.1.2" class="ltx_tr">
<td id="S4.T3.10.1.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="2"><span id="S4.T3.10.1.2.1.1" class="ltx_text ltx_font_bold">Type</span></td>
<td id="S4.T3.10.1.2.2" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" rowspan="2"><span id="S4.T3.10.1.2.2.1" class="ltx_text ltx_font_bold">Method</span></td>
<td id="S4.T3.10.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="2">ScanNet</td>
<td id="S4.T3.10.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="2">IBims-1</td>
<td id="S4.T3.10.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="2">VOID</td>
