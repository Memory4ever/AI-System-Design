<td id="A2.T5.3.11.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A2.T5.3.11.4.1" class="ltx_text ltx_font_bold">1.93<math id="A2.T5.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></span></td></tr>
</tbody>
