<td id="S6.T3.3.1.1.2" class="ltx_td ltx_align_center ltx_border_tt" colspan="4"><span id="S6.T3.3.1.1.2.1" class="ltx_text ltx_font_bold">Same Domain, Task-to-Task Generalization, #Allocs <math id="S6.T3.m1" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
