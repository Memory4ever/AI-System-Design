<td id="S5.T2.2.13.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb"></td>
<td id="S5.T2.2.13.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_bb ltx_border_t">
<span id="S5.T2.2.13.2.1" class="ltx_inline-block ltx_align_top" style="width:51.7pt;">
<span id="S5.T2.2.13.2.1.1" class="ltx_p"><span id="S5.T2.2.13.2.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Tool hardening</span></span>
</span></td>
<td id="S5.T2.2.13.3" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t">
<span id="S5.T2.2.13.3.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T2.2.13.3.1.1" class="ltx_p"><span id="S5.T2.2.13.3.1.1.1" class="ltx_text" style="font-size:80%;">Anthropic Connectors </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T2.2.13.3.1.1.2" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib115" title="" class="ltx_ref">Anthropic, 2025</a><span id="S5.T2.2.13.3.1.1.4" class="ltx_text" style="font-size:80%;">)</span></cite><span id="S5.T2.2.13.3.1.1.5" class="ltx_text" style="font-size:80%;">, ETDI </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T2.2.13.3.1.1.6" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib119" title="" class="ltx_ref">Documentation, 2025</a><span id="S5.T2.2.13.3.1.1.8" class="ltx_text" style="font-size:80%;">)</span></cite><span id="S5.T2.2.13.3.1.1.9" class="ltx_text" style="font-size:80%;">, MCP Context Protector </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T2.2.13.3.1.1.10" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib118" title="" class="ltx_ref">trailofbits, 2025</a><span id="S5.T2.2.13.3.1.1.12" class="ltx_text" style="font-size:80%;">)</span></cite><span id="S5.T2.2.13.3.1.1.13" class="ltx_text" style="font-size:80%;">, MCP Safety Audit </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T2.2.13.3.1.1.14" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib90" title="" class="ltx_ref">Radosevich and Halloran, 2025</a><span id="S5.T2.2.13.3.1.1.16" class="ltx_text" style="font-size:80%;">)</span></cite><span id="S5.T2.2.13.3.1.1.17" class="ltx_text" style="font-size:80%;">, MCIP </span><cite class="ltx_cite ltx_citemacro_citep"><span id="S5.T2.2.13.3.1.1.18" class="ltx_text" style="font-size:80%;">(</span><a href="#bib.bib177" title="" class="ltx_ref">Jing et al., 2025</a><span id="S5.T2.2.13.3.1.1.20" class="ltx_text" style="font-size:80%;">)</span></cite></span>
</span></td>
