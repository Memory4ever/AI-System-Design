{"data":{"id":"10.48550/arxiv.2603.10521","type":"dois","attributes":{"doi":"10.48550/arxiv.2603.10521","prefix":"10.48550","suffix":"arxiv.2603.10521","identifiers":[{"identifier":"2603.10521","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2603.10521"}],"creators":[{"name":"Guo, Chuan","nameType":"Personal","givenName":"Chuan","familyName":"Guo","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Uribe, Juan Felipe Ceron","nameType":"Personal","givenName":"Juan Felipe Ceron","familyName":"Uribe","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Zhu, Sicheng","nameType":"Personal","givenName":"Sicheng","familyName":"Zhu","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Choquette-Choo, Christopher A.","nameType":"Personal","givenName":"Christopher A.","familyName":"Choquette-Choo","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Lin, Steph","nameType":"Personal","givenName":"Steph","familyName":"Lin","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Kandpal, Nikhil","nameType":"Personal","givenName":"Nikhil","familyName":"Kandpal","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Nasr, Milad","nameType":"Personal","givenName":"Milad","familyName":"Nasr","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Rai","nameType":"Personal","familyName":"Rai","affiliation":["Michael Pokorny"],"nameIdentifiers":[]},{"name":"Toyer, Sam","nameType":"Personal","givenName":"Sam","familyName":"Toyer","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Miles","nameType":"Personal","givenName":"Miles","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Yu, Yaodong","nameType":"Personal","givenName":"Yaodong","familyName":"Yu","affiliation":[],"nameIdentifiers":[]},{"name":"Beutel, Alex","nameType":"Personal","givenName":"Alex","familyName":"Beutel","affiliation":[],"nameIdentifiers":[]},{"name":"Xiao, Kai","nameType":"Personal","givenName":"Kai","familyName":"Xiao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"IH-Challenge: A Training Dataset to Improve Instruction Hierarchy on Frontier LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Cryptography and Security (cs.CR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-11T08:27:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-03-12T00:34:48Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-03","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Instruction hierarchy (IH) defines how LLMs prioritize system, developer, user, and tool instructions under conflict, providing a concrete, trust-ordered policy for resolving instruction conflicts. IH is key to defending against jailbreaks, system prompt extractions, and agentic prompt injections. However, robust IH behavior is difficult to train: IH failures can be confounded with instruction-following failures, conflicts can be nuanced, and models can learn shortcuts such as overrefusing. We introduce IH-Challenge, a reinforcement learning training dataset, to address these difficulties. Fine-tuning GPT-5-Mini on IH-Challenge with online adversarial example generation improves IH robustness by +10.0% on average across 16 in-distribution, out-of-distribution, and human red-teaming benchmarks (84.1% to 94.1%), reduces unsafe behavior from 6.6% to 0.7% while improving helpfulness on general safety evaluations, and saturates an internal static agentic prompt injection evaluation, with minimal capability regression. We release the IH-Challenge dataset (https://huggingface.co/datasets/openai/ih-challenge) to support future research on robust instruction hierarchy.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2603.10521","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-03-12T02:03:35.000Z","registered":"2026-03-12T02:03:36.000Z","published":"2026","updated":"2026-03-12T02:03:36.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2603.10521","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}