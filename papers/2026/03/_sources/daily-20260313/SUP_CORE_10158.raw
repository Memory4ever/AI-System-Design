<td id="S4.T3.3.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.45pt 2.0pt;"><span id="S4.T3.3.1.3.1" class="ltx_text" style="font-size:80%;">Inspire</span></td>
<td id="S4.T3.3.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.45pt 2.0pt;"><span id="S4.T3.3.1.4.1" class="ltx_text" style="font-size:80%;">X-Hand1</span></td>
