</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F16.fig5" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2603.10158v1/imgs/task_vis/005.png" id="S6.F16.g5" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/386;" width="685" height="386" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S6.F16.fig6" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2603.10158v1/imgs/task_vis/006.png" id="S6.F16.g6" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:685/386;" width="685" height="386" alt="Refer to caption">
