<tr id="S6.T2.6.4" class="ltx_tr">
<th id="S6.T2.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" rowspan="2"><span id="S6.T2.6.4.1.1" class="ltx_text">ML-20M</span></th>
