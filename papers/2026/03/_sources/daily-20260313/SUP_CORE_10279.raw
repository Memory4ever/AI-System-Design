</div>
<figure id="A2.F4" class="ltx_figure">
<p id="A2.F4.3" class="ltx_p ltx_align_center ltx_align_center"><span id="A2.F4.3.1" class="ltx_text"><img src="2603.10279v1/images/rating_distribution.png" id="A2.F4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:349/199;" width="349" height="199" alt="Refer to caption"></span></p>
