</thead>
<tbody class="ltx_tbody">
<tr id="S6.T1.5.2" class="ltx_tr">
<th id="S6.T1.5.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">ML-1M</th>
<td id="S6.T1.5.2.2" class="ltx_td ltx_align_center ltx_border_t">6,040</td>
<td id="S6.T1.5.2.3" class="ltx_td ltx_align_center ltx_border_t">3,706</td>
<td id="S6.T1.5.2.4" class="ltx_td ltx_align_center ltx_border_t">165.60</td>
<td id="S6.T1.5.2.5" class="ltx_td ltx_align_center ltx_border_t">1,530</td></tr>
<tr id="S6.T1.5.3" class="ltx_tr">
<th id="S6.T1.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">ML-20M</th>
<td id="S6.T1.5.3.2" class="ltx_td ltx_align_center">138,493</td>
<td id="S6.T1.5.3.3" class="ltx_td ltx_align_center">26,744</td>
<td id="S6.T1.5.3.4" class="ltx_td ltx_align_center">144.41</td>
<td id="S6.T1.5.3.5" class="ltx_td ltx_align_center">40,667</td></tr>
<tr id="S6.T1.5.4" class="ltx_tr">
<th id="S6.T1.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Amazon Books</th>
<td id="S6.T1.5.4.2" class="ltx_td ltx_align_center">811,227</td>
<td id="S6.T1.5.4.3" class="ltx_td ltx_align_center">695,762</td>
<td id="S6.T1.5.4.4" class="ltx_td ltx_align_center">14.47</td>
<td id="S6.T1.5.4.5" class="ltx_td ltx_align_center">424,271</td></tr>
