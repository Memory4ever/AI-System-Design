</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S4.F4.sf3" class="ltx_figure ltx_figure_panel ltx_align_center"><img src="2603.10444v1/figures/outlier/outlier_10k_layer3.png" id="S4.F4.sf3.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:548/220;" width="548" height="220" alt="Refer to caption">
