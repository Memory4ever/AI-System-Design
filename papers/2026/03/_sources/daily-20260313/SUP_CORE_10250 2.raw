,</span><span id="lstnumberx38.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx38.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">keepdims</span><span id="lstnumberx38.21" class="ltx_text ltx_font_typewriter" style="font-size:90%;">=</span><span id="lstnumberx38.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">True</span><span id="lstnumberx38.23" class="ltx_text ltx_font_typewriter" style="font-size:90%;">),</span><span id="lstnumberx38.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx38.25" class="ltx_text ltx_font_typewriter" style="font-size:90%;">1)</span>
