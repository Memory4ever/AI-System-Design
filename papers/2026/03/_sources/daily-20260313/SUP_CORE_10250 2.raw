<td id="S5.T3.8.12.3" class="ltx_td ltx_align_right"><span id="S5.T3.8.12.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#F6E1C4;">+3.8%</span></td></tr>
