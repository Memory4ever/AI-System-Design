tx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx45.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">C</span><span id="lstnumberx45.21" class="ltx_text ltx_font_typewriter" style="font-size:90%;">)</span>
</div>
<div id="lstnumberx46" class="ltx_listingline"><span id="lstnumberx46.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;">        </span><span id="lstnumberx46.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter" style="font-size:90%;--ltx-fg-color:#0000FF;">return</span><span id="lstnumberx46.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.4" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx46.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">S1</span><span id="lstnumberx46.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.7" class="ltx_text ltx_font_typewriter" style="font-size:90%;">-</span><span id="lstnumberx46.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">jnp</span><span id="lstnumberx46.10" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx46.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">sqrt</span><span id="lstnumberx46.12" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx46.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">jnp</span><span id="lstnumberx46.14" class="ltx_text ltx_font_typewriter" style="font-size:90%;">.</span><span id="lstnumberx46.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">maximum</span><span id="lstnumberx46.16" class="ltx_text ltx_font_typewriter" style="font-size:90%;">(</span><span id="lstnumberx46.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">delta</span><span id="lstnumberx46.18" class="ltx_text ltx_font_typewriter" style="font-size:90%;">,</span><span id="lstnumberx46.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.20" class="ltx_text ltx_font_typewriter" style="font-size:90%;">0.0)))</span><span id="lstnumberx46.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.22" class="ltx_text ltx_font_typewriter" style="font-size:90%;">/</span><span id="lstnumberx46.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:90%;"> </span><span id="lstnumberx46.24" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:90%;">k_star</span>
</div>
