<td id="S5.T3.8.13.2" class="ltx_td ltx_align_left"><span id="S5.T3.8.13.2.1" class="ltx_text" style="font-size:90%;--ltx-bg-color:#D1E2F3;">7.51(08)</span></td>
<td id="S5.T3.8.13.3" class="ltx_td ltx_align_right"><span id="S5.T3.8.13.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;--ltx-bg-color:#D1E2F3;">+15.2%</span></td></tr>
