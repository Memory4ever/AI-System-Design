<span id="Pt0.A2.T3.2.1.1.1.1.1.1.2" class="ltx_tr">
<span id="Pt0.A2.T3.2.1.1.1.1.1.1.2.1" class="ltx_td ltx_th ltx_th_column ltx_th_row"></span>
<span id="Pt0.A2.T3.2.1.1.1.1.1.1.2.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_th_row ltx_border_r">PR</span>
