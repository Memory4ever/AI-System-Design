<td id="S4.T5.6.6.2" class="ltx_td ltx_align_center ltx_border_bb">6.2%</td>
<td id="S4.T5.6.6.3" class="ltx_td ltx_align_center ltx_border_bb">23.4%</td>
<td id="S4.T5.6.6.4" class="ltx_td ltx_align_center ltx_border_bb">99.3%</td>
