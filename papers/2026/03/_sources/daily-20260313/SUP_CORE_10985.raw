<th id="S4.T7.6.10.2" class="ltx_td ltx_align_right ltx_th ltx_th_row ltx_border_bb ltx_border_t">499,224</th>
<td id="S4.T7.6.10.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">32.3</td>
