<td id="S4.T5.6.2.3" class="ltx_td ltx_align_center ltx_border_t">79.2%</td>
<td id="S4.T5.6.2.4" class="ltx_td ltx_align_center ltx_border_t">94.1%</td>
<td id="S4.T5.6.2.5" class="ltx_td ltx_align_center ltx_border_t">✓</td>
<td id="S4.T5.6.2.6" class="ltx_td ltx_align_right ltx_border_t">96.4pp</td></tr>
