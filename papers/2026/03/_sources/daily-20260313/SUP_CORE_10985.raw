<td id="S4.T5.6.3.1" class="ltx_td ltx_align_right">0.05</td>
<td id="S4.T5.6.3.2" class="ltx_td ltx_align_center">12.2%</td>
<td id="S4.T5.6.3.3" class="ltx_td ltx_align_center">77.2%</td>
<td id="S4.T5.6.3.4" class="ltx_td ltx_align_center">95.0%</td>
<td id="S4.T5.6.3.5" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T5.6.3.6" class="ltx_td ltx_align_right">95.9pp</td></tr>
