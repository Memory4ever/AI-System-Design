<td id="S4.T5.6.4.1" class="ltx_td ltx_align_right">0.10</td>
<td id="S4.T5.6.4.2" class="ltx_td ltx_align_center">11.3%</td>
<td id="S4.T5.6.4.3" class="ltx_td ltx_align_center">74.5%</td>
<td id="S4.T5.6.4.4" class="ltx_td ltx_align_center">95.8%</td>
<td id="S4.T5.6.4.5" class="ltx_td ltx_align_center">✓</td>
<td id="S4.T5.6.4.6" class="ltx_td ltx_align_right">94.3pp</td></tr>
<tr id="S4.T5.6.5" class="ltx_tr">
<td id="S4.T5.6.5.1" class="ltx_td ltx_align_right">0.50</td>
<td id="S4.T5.6.5.2" class="ltx_td ltx_align_center">7.9%</td>
<td id="S4.T5.6.5.3" class="ltx_td ltx_align_center">50.9%</td>
<td id="S4.T5.6.5.4" class="ltx_td ltx_align_center">98.5%</td>
