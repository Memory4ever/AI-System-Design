<td id="S4.T8.6.5.5" class="ltx_td ltx_align_center"><math id="S4.T8.m9" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>12.3</td></tr>
