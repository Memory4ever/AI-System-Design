<td id="S4.T1.5.1.11.5" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.5.1.11.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ADD8E6;">80.0<math id="S4.T1.m84" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#ADD8E6;" mathbackground="#ADD8E6">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.5</span></td>
