<td id="A2.T7.5.1.11.4" class="ltx_td ltx_align_center" style="padding:0.75pt 8.0pt;">52.0<math id="A2.T7.m36" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>1.4</td></tr>
