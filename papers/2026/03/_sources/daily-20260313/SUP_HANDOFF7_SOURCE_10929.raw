<td id="S4.T1.5.1.11.8" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.5.1.11.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ADD8E6;">60.8<math id="S4.T1.m87" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#ADD8E6;" mathbackground="#ADD8E6">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>2.8</span></td>
<td id="S4.T1.5.1.11.9" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.T1.5.1.11.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#ADD8E6;">8.6<math id="S4.T1.m88" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#ADD8E6;" mathbackground="#ADD8E6">±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math>6.2</span></td>
