<th id="S4.T6.5.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T6.5.1.2.3.1" class="ltx_text" style="font-size:90%;">T7</span></th>
<th id="S4.T6.5.1.2.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="S4.T6.5.1.2.4.1" class="ltx_text" style="font-size:90%;">T8</span></th>
