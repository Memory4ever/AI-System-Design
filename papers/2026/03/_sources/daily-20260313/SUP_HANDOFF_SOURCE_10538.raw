          <span id="alg1.l10.2" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l10.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
            
            
          <span id="alg1.l11.2" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>

</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> Our mask embedding implementation</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l1" class="ltx_listingline">
            
            
          image shape (<math id="alg2.l1.m1" class="ltx_Math" alttext="H,W" display="inline" intent=":literal"><semantics><mrow><mi>H</mi><mo>,</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">H,W</annotation></semantics></math>), target shape (<math id="alg2.l1.m2" class="ltx_Math" alttext="H^{\prime},W^{\prime}" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>′</mo></msup><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">H^{\prime},W^{\prime}</annotation></semantics></math>), number of masks <math id="alg2.l1.m3" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math>, binary masks <math id="alg2.l1.m4" class="ltx_Math" alttext="S\in\{0,1\}^{N\times H\times W}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>N</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>H</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>W</mi></mrow></msup></mrow><annotation encoding="application/x-tex">S\in\{0,1\}^{N\times H\times W}</annotation></semantics></math>, pairs <math id="alg2.l1.m5" class="ltx_Math" alttext="P\subset\{1,\dots N\}^{2}" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>⊂</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi mathvariant="normal">…</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow></mrow><mo stretchy="false">}</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">P\subset\{1,\dots N\}^{2}</annotation></semantics></math>

</div>
<div id="alg2.l2" class="ltx_listingline">
            
            
          
</div>
<div id="alg2.l3" class="ltx_listingline">
            
            
          <math id="alg2.l3.m1" class="ltx_Math" alttext="E\leftarrow\emptyset\subset\mathbb{R}^{H^{\prime}\times W^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mi mathvariant="normal">∅</mi><mo>⊂</mo><msup><mi>ℝ</mi><mrow><msup><mi>H</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>W</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">E\leftarrow\emptyset\subset\mathbb{R}^{H^{\prime}\times W^{\prime}}</annotation></semantics></math>

</div>
<div id="alg2.l4" class="ltx_listingline">
            
            
          <math id="alg2.l4.m1" class="ltx_Math" alttext="R\leftarrow pool(S)\in\mathbb{R}^{H^{\prime}\times W^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi>R</mi><mo stretchy="false">←</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>S</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>H</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>W</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">R\leftarrow pool(S)\in\mathbb{R}^{H^{\prime}\times W^{\prime}}</annotation></semantics></math>

</div>
<div id="alg2.l5" class="ltx_listingline">
            
            
          <span id="alg2.l5.2" class="ltx_text ltx_font_bold">for</span> <math id="alg2.l5.m1" class="ltx_Math" alttext="p\in P" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo>∈</mo><mi>P</mi></mrow><annotation encoding="application/x-tex">p\in P</annotation></semantics></math> <span id="alg2.l5.3" class="ltx_text ltx_font_bold">do</span> <span id="alg2.l5.4" class="ltx_text" style="float:right;"><math id="alg2.l5.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> Performed in parallel
</span>
</div>
<div id="alg2.l6" class="ltx_listingline">
            
            
            <math id="alg2.l6.m1" class="ltx_Math" alttext="r_{0}\leftarrow R_{p_{0}}\in\mathbb{R}^{H^{\prime}\times W^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">←</mo><msub><mi>R</mi><msub><mi>p</mi><mn>0</mn></msub></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>H</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>W</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">r_{0}\leftarrow R_{p_{0}}\in\mathbb{R}^{H^{\prime}\times W^{\prime}}</annotation></semantics></math>

</div>
<div id="alg2.l7" class="ltx_listingline">
            
            
            <math id="alg2.l7.m1" class="ltx_Math" alttext="r_{1}\leftarrow R_{p_{1}}\in\mathbb{R}^{H^{\prime}\times W^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">←</mo><msub><mi>R</mi><msub><mi>p</mi><mn>1</mn></msub></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><msup><mi>H</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mi>W</mi><mo>′</mo></msup></mrow></msup></mrow><annotation encoding="application/x-tex">r_{1}\leftarrow R_{p_{1}}\in\mathbb{R}^{H^{\prime}\times W^{\prime}}</annotation></semantics></math>

</div>
<div id="alg2.l8" class="ltx_listingline">
            
            
            <math id="alg2.l8.m1" class="ltx_math_unparsed" alttext="E\leftarrow E\cup\{make\_embedding(r_{0},r_{1})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mi>E</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mi>a</mi><mi>k</mi><mi>e</mi><mi>_</mi><mi>e</mi><mi>m</mi><mi>b</mi><mi>e</mi><mi>d</mi><mi>d</mi><mi>i</mi><mi>n</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E\leftarrow E\cup\{make\_embedding(r_{0},r_{1})</annotation></semantics></math>}

</div>
<div id="alg2.l9" class="ltx_listingline">
            
            
          <span id="alg2.l9.2" class="ltx_text ltx_font_bold">end</span> <span id="alg2.l9.3" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg2.l10" class="ltx_listingline">
            
            
          <span id="alg2.l10.2" class="ltx_text ltx_font_bold">return</span> <math id="alg2.l10.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>

</div>
</div>
</figure>
<div id="S8.p3" class="ltx_para">
<p id="S8.p3.1" class="ltx_p">Since ratios are reused across different pairs, this saves us many calls to the pooling layer while also having to copy less data since the ratio tensors are smaller (<math id="S8.p3.m1" class="ltx_Math" alttext="W^{\prime}&lt;W" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>&lt;</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">W^{\prime}&lt;W</annotation></semantics></math> and <math id="S8.p3.m2" class="ltx_Math" alttext="H^{\prime}&lt;H" display="inline" intent=":literal"><semantics><mrow><msup><mi>H</mi><mo>′</mo></msup><mo>&lt;</mo><mi>H</mi></mrow><annotation encoding="application/x-tex">H^{\prime}&lt;H</annotation></semantics></math>) than the segmentation mask tensors.
While DSFormer copies segmentation masks and computes ratios <math id="S8.p3.m3" class="ltx_Math" alttext="2|P|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>P</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">2|P|</annotation></semantics></math> times, DSFlash computes <math id="S8.p3.m4" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> ratios and only copies the ratios <math id="S8.p3.m5" class="ltx_Math" alttext="2|P|" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi>P</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">2|P|</annotation></semantics></math> times.</p>
</div>
</section>
<section id="S9" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">9 </span>Implementation Details</h2>

<div id="S9.p1" class="ltx_para">
<p id="S9.p1.1" class="ltx_p">We use the AdamW optimizer with a learning rate of <math id="S9.p1.m1" class="ltx_Math" alttext="10^{-5}" display="inline" intent=":literal"><semantics><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup><annotation encoding="application/x-tex">10^{-5}</annotation></semantics></math>, weight decay of 0.02, and a cosine annealing scheduler with linear warmup.
During training, we clip the gradient norm to a maximum of 1.
To achieve best results, we train for 20 epochs.</p>
</div>
<div id="S9.p2" class="ltx_para">
<p id="S9.p2.1" class="ltx_p">For five ground truth relation, we sample one negative relation from the dataset, <em id="S9.p2.1.1" class="ltx_emph ltx_font_italic">i.e</em>.<span id="S9.p2.1.2" class="ltx_text"></span> mask-mask pairs that have no annotation in the ground truth.</p>
</div>
<div id="S9.p3" class="ltx_para">
<p id="S9.p3.1" class="ltx_p">In addition to the patch tokens and the classification token, DSFlash also uses the same location token from DSFormer.
We <em id="S9.p3.1.1" class="ltx_emph ltx_font_italic">don’t</em> use DSFormer’s semantic token and <em id="S9.p3.1.2" class="ltx_emph ltx_font_italic">don’t</em> include a frequency bias.</p>
</div>
</section>
<section id="S10" class="ltx_section">
<h2 class="ltx_title ltx_title_section"><span class="ltx_tag ltx_tag_section">10 </span>PredCls Results</h2>

<div id="S10.p1" class="ltx_para">
<p id="S10.p1.1" class="ltx_p"><a href="#S10.T4" title="In 10 PredCls Results ‣ DSFlash: Comprehensive Panoptic Scene Graph Generation in Realtime" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Tab.</span> <span class="ltx_text ltx_ref_tag">4</span></a> contains <em id="S10.p1.1.1" class="ltx_emph ltx_font_italic">mR@50</em> scores obtained with the Predicate Classification Protocol (<em id="S10.p1.1.2" class="ltx_emph ltx_font_italic">PredCls</em>).
While the base (B) and large (L) variants perform very similar on <em id="S10.p1.1.3" class="ltx_emph ltx_font_italic">PredCls</em>, their performance on <em id="S10.p1.1.4" class="ltx_emph ltx_font_italic">SGDet</em> differs considerably.
Since the L variant contains a more capable segmentation model, it misses less relations in the <em id="S10.p1.1.5" class="ltx_emph ltx_font_italic">SGDet</em> setting.
For <em id="S10.p1.1.6" class="ltx_emph ltx_font_italic">PredCls</em>, the ground truth segmentation masks are provided and the difference in the quality of the segmentation model is irrelevant.</p>
</div>
<figure id="S10.T4" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S10.T4.7" class="ltx_text" style="font-size:90%;">Table 4</span>: </span><span id="S10.T4.8" class="ltx_text" style="font-size:90%;">
Scene graph performance, evaluated as <em id="S10.T4.8.1" class="ltx_emph ltx_font_italic">mR@50</em> on the PSG dataset <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib4" title="" class="ltx_ref">4</a>]</cite> using Predicate Classification (<em id="S10.T4.8.2" class="ltx_emph ltx_font_italic">PredCls</em>) and Scene Graph Detection (<em id="S10.T4.8.3" class="ltx_emph ltx_font_italic">SGDet</em>, aka <em id="S10.T4.8.4" class="ltx_emph ltx_font_italic">SGGen</em>).
</span></figcaption>
