</div>
<div id="alg1.l9" class="ltx_listingline">
            
            
            <math id="alg1.l9.m1" class="ltx_math_unparsed" alttext="E\leftarrow E\cup\{make\_embedding(r_{0},r_{1})" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo stretchy="false">←</mo><mi>E</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mi>m</mi><mi>a</mi><mi>k</mi><mi>e</mi><mi>_</mi><mi>e</mi><mi>m</mi><mi>b</mi><mi>e</mi><mi>d</mi><mi>d</mi><mi>i</mi><mi>n</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo>,</mo><msub><mi>r</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">E\leftarrow E\cup\{make\_embedding(r_{0},r_{1})</annotation></semantics></math>}

