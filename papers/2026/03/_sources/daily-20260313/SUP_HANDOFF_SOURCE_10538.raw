<td id="S12.T5.7.5.1" class="ltx_td ltx_align_center"><math id="S12.T5.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo style="--ltx-fg-color:#FF0000;" mathcolor="#FF0000">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
