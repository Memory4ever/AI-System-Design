</thead>
<tbody class="ltx_tbody">
<tr id="S5.T3.7.2" class="ltx_tr">
<th id="S5.T3.7.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t">SF (ours)</th>
<td id="S5.T3.7.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.7.2.2.1" class="ltx_text ltx_underline">5.354</span></td>
<td id="S5.T3.7.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.7.2.3.1" class="ltx_text ltx_font_bold">21.091</span></td>
<td id="S5.T3.7.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.7.2.4.1" class="ltx_text ltx_underline">8.561</span></td>
<td id="S5.T3.7.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S5.T3.7.2.5.1" class="ltx_text ltx_font_bold">25702.2</span></td></tr>
<tr id="S5.T3.7.3" class="ltx_tr">
<th id="S5.T3.7.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">Reflextion</th>
<td id="S5.T3.7.3.2" class="ltx_td ltx_align_center">5.299</td>
<td id="S5.T3.7.3.3" class="ltx_td ltx_align_center"><span id="S5.T3.7.3.3.1" class="ltx_text ltx_underline">29.454</span></td>
<td id="S5.T3.7.3.4" class="ltx_td ltx_align_center">8.630</td>
<td id="S5.T3.7.3.5" class="ltx_td ltx_align_center"><span id="S5.T3.7.3.5.1" class="ltx_text ltx_underline">25314.69</span></td></tr>
<tr id="S5.T3.7.4" class="ltx_tr">
<th id="S5.T3.7.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">DQN</th>
