            <span id="alg1.l10.3" class="ltx_text" style="font-size:90%;">   </span><span id="alg1.l10.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg1.l10.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg1.l10.6" class="ltx_text ltx_font_bold" style="font-size:90%;">while</span>
