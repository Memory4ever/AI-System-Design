</span>
</div>
<div id="alg2.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <span id="alg2.l15.3" class="ltx_text" style="font-size:90%;">     </span><span id="alg2.l15.4" class="ltx_text ltx_font_bold" style="font-size:90%;">end</span><span id="alg2.l15.5" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l15.6" class="ltx_text ltx_font_bold" style="font-size:90%;">for</span>
</div>
<div id="alg2.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="alg2.l16.3" class="ltx_text" style="font-size:90%;">     </span><span id="alg2.l16.4" class="ltx_text ltx_font_bold" style="font-size:90%;">if</span><span id="alg2.l16.5" class="ltx_text" style="font-size:90%;"> </span><math id="alg2.l16.m1" class="ltx_Math" alttext="P(\hat{a}_{t}|I_{t})&gt;\rho" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.900em">P</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><msub><mover accent="true"><mi mathsize="0.900em">a</mi><mo>^</mo></mover><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" mathsize="0.900em" rspace="0em">|</mo><msub><mi mathsize="0.900em">I</mi><mi mathsize="0.900em">t</mi></msub><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">&gt;</mo><mi mathsize="0.900em">ρ</mi></mrow><annotation encoding="application/x-tex">P(\hat{a}_{t}|I_{t})&gt;\rho</annotation></semantics></math><span id="alg2.l16.6" class="ltx_text" style="font-size:90%;"> </span><span id="alg2.l16.7" class="ltx_text ltx_font_bold" style="font-size:90%;">then</span><span id="alg2.l16.8" class="ltx_text" style="font-size:90%;">


</span>
</div>
<div id="alg2.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
            <span id="alg2.l17.3" class="ltx_text" style="font-size:90%;">       Do not rollout </span><math id="alg2.l17.m1" class="ltx_Math" alttext="h_{t}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.900em">h</mi><mi mathsize="0.900em">t</mi></msub><annotation encoding="application/x-tex">h_{t}</annotation></semantics></math><span id="alg2.l17.4" class="ltx_text" style="font-size:90%;"> in next iteration
</span>
</div>
