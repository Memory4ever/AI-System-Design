<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.sf3.3" class="ltx_text" style="font-size:90%;">(c)</span> </span><span id="S5.F3.sf3.4" class="ltx_text" style="font-size:90%;">(f) KTO iteration 5</span></figcaption>
</figure>
          
