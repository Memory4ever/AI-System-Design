<td id="S5.T3.7.5.5" class="ltx_td ltx_align_center">19277.2</td></tr>
<tr id="S5.T3.7.6" class="ltx_tr">
<th id="S5.T3.7.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb">SAC</th>
<td id="S5.T3.7.6.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S5.T3.7.6.2.1" class="ltx_text ltx_font_bold">5.748</span></td>
<td id="S5.T3.7.6.3" class="ltx_td ltx_align_center ltx_border_bb">44.775</td>
