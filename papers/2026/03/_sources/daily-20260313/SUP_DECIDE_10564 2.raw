<div id="S5.F3.3.2" class="ltx_logical-block ltx_minipage ltx_align_center ltx_align_top" style="width:56.3pt;">
            
<figure id="S5.F3.sf4" class="ltx_figure"><object type="image/svg+xml" data="2603.10564v1/plot_1.svg" id="S5.F3.sf4.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:78/57;" width="78" height="57"></object>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S5.F3.sf4.3" class="ltx_text" style="font-size:90%;">(d)</span> </span><span id="S5.F3.sf4.4" class="ltx_text" style="font-size:90%;">(c) KTO iteration 2</span></figcaption>
</figure>
            
