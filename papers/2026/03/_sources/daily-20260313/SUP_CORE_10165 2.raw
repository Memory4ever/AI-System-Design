<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Algorithm Pseudocode</h2>

<figure id="alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg1.3" class="ltx_text ltx_font_bold">Algorithm 1</span> </span> Binary RL Pipeline (per main-line turn, both tracks)</figcaption>
<div id="alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg1.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Session/trajectory <math id="alg1.l0.m1" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>, turn <math id="alg1.l0.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>, messages <math id="alg1.l0.m3" class="ltx_Math" alttext="\mathcal{M}_{t}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathcal{M}_{t}</annotation></semantics></math>

</div>
<div id="alg1.l1" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
            
            
           <math id="alg1.l1.m1" class="ltx_Math" alttext="a_{t},\text{logp}_{\text{old}}\leftarrow\text{SGLang}(\mathcal{M}_{t})" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mtext>logp</mtext><mtext>old</mtext></msub><mo stretchy="false">←</mo><mrow><mtext>SGLang</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">a_{t},\text{logp}_{\text{old}}\leftarrow\text{SGLang}(\mathcal{M}_{t})</annotation></semantics></math> <span id="alg1.l1.3" class="ltx_text" style="float:right;"><span id="alg1.l1.3.1" class="ltx_text ltx_font_italic">// serve and collect log-probs</span>
</span>
</div>
<div id="alg1.l2" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
            
            
           Buffer <math id="alg1.l2.m1" class="ltx_Math" alttext="\{\text{prompt\_ids},\,\text{response\_ids},\,\text{logp}_{\text{old}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mtext>prompt_ids</mtext><mo rspace="0.337em">,</mo><mtext>response_ids</mtext><mo rspace="0.337em">,</mo><msub><mtext>logp</mtext><mtext>old</mtext></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{\text{prompt\_ids},\,\text{response\_ids},\,\text{logp}_{\text{old}}\}</annotation></semantics></math> for <math id="alg1.l2.m2" class="ltx_Math" alttext="(\mathcal{T},t)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{T},t)</annotation></semantics></math>

</div>
<div id="alg1.l3" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
            
            
           // — On next turn: extract <math id="alg1.l3.m1" class="ltx_Math" alttext="s_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{t+1}</annotation></semantics></math> and fire PRM —

</div>
<div id="alg1.l4" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
            
            
           <math id="alg1.l4.m1" class="ltx_Math" alttext="s_{t+1}\leftarrow" display="inline" intent=":literal"><semantics><mrow><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">←</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">s_{t+1}\leftarrow</annotation></semantics></math> first message of <math id="alg1.l4.m2" class="ltx_Math" alttext="\mathcal{M}_{t+1}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\mathcal{M}_{t+1}</annotation></semantics></math> <span id="alg1.l4.3" class="ltx_text" style="float:right;"><span id="alg1.l4.3.1" class="ltx_text ltx_font_italic">// user reply or env feedback</span>
</span>
</div>
<div id="alg1.l5" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
            
            
           <math id="alg1.l5.m1" class="ltx_Math" alttext="\{r_{i}\}_{i=1}^{m}\leftarrow\text{PRM}(a_{t},s_{t+1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>m</mi></msubsup><mo stretchy="false">←</mo><mrow><mtext>PRM</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{r_{i}\}_{i=1}^{m}\leftarrow\text{PRM}(a_{t},s_{t+1})</annotation></semantics></math> <span id="alg1.l5.3" class="ltx_text" style="float:right;"><span id="alg1.l5.3.1" class="ltx_text ltx_font_italic">// <math id="alg1.l5.m2" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> parallel votes, async</span>
</span>
</div>
<div id="alg1.l6" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
            
            
           <math id="alg1.l6.m1" class="ltx_Math" alttext="r\leftarrow\text{MajorityVote}(\{r_{i}\})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><mrow><mtext>MajorityVote</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>r</mi><mi>i</mi></msub><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\leftarrow\text{MajorityVote}(\{r_{i}\})</annotation></semantics></math>

</div>
<div id="alg1.l7" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
            
            
           <math id="alg1.l7.m1" class="ltx_Math" alttext="A_{t}\leftarrow r" display="inline" intent=":literal"><semantics><mrow><msub><mi>A</mi><mi>t</mi></msub><mo stretchy="false">←</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">A_{t}\leftarrow r</annotation></semantics></math> broadcast

</div>
<div id="alg1.l8" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
            
            
           Apply at-least-one guarantee if zero effective samples in <math id="alg1.l8.m1" class="ltx_Math" alttext="\mathcal{T}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒯</mi><annotation encoding="application/x-tex">\mathcal{T}</annotation></semantics></math>

</div>
<div id="alg1.l9" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
            
            
           Submit <span id="alg1.l9.3" class="ltx_text ltx_font_typewriter">Sample</span> to trainer queue

</div>
</div>
</figure>
<figure id="alg2" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="alg2.3" class="ltx_text ltx_font_bold">Algorithm 2</span> </span> OPD Pipeline (personal agent track)</figcaption>
<div id="alg2.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="alg2.l0" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg2.l0.1" class="ltx_text" style="font-size:80%;">0:</span></span>
            
            
           Turn data <math id="alg2.l0.m1" class="ltx_Math" alttext="(a_{t},\mathcal{M}_{t},\text{logp}_{\text{old}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>t</mi></msub><mo>,</mo><msub><mi class="ltx_font_mathcaligraphic">ℳ</mi><mi>t</mi></msub><mo>,</mo><msub><mtext>logp</mtext><mtext>old</mtext></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a_{t},\mathcal{M}_{t},\text{logp}_{\text{old}})</annotation></semantics></math>, next state <math id="alg2.l0.m2" class="ltx_Math" alttext="s_{t+1}" display="inline" intent=":literal"><semantics><msub><mi>s</mi><mrow><mi>t</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">s_{t+1}</annotation></semantics></math>

</div>
