<td id="S3.T1.5.2.3" class="ltx_td ltx_align_left ltx_border_t"><span id="S3.T1.5.2.3.1" class="ltx_text" style="font-size:90%;">user response / tool-call results</span></td>
<td id="S3.T1.5.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><span id="S3.T1.5.2.4.1" class="ltx_text" style="font-size:90%;">Long</span></td></tr>
