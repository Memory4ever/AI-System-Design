<div id="A2.SS1.p1" class="ltx_para ltx_noindent"><span class="ltx_inline-block"><svg id="A2.SS1.p1.pic1" class="ltx_picture" height="62.62" overflow="visible" version="1.1" viewBox="0 0 676.77 62.62" width="676.77"><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-width="0.4pt" transform="translate(0,62.62) matrix(1 0 0 -1 0 0)"><g style="--ltx-fill-color:#808080;" fill="#808080" fill-opacity="1.0"><path style="stroke:none" d="M 0 5.91 L 0 56.71 C 0 59.97 2.64 62.62 5.91 62.62 L 670.87 62.62 C 674.13 62.62 676.77 59.97 676.77 56.71 L 676.77 5.91 C 676.77 2.64 674.13 0 670.87 0 L 5.91 0 C 2.64 0 0 2.64 0 5.91 Z"></path></g><g style="--ltx-fill-color:#F2F2F2;" fill="#F2F2F2" fill-opacity="1.0"><path style="stroke:none" d="M 1.97 5.91 L 1.97 36.97 L 674.8 36.97 L 674.8 5.91 C 674.8 3.73 673.04 1.97 670.87 1.97 L 5.91 1.97 C 3.73 1.97 1.97 3.73 1.97 5.91 Z"></path></g><g fill-opacity="1.0" transform="matrix(1.0 0.0 0.0 1.0 21.65 46.33)"><foreignObject style="--ltx-fo-width:45.78em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="633.47"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
