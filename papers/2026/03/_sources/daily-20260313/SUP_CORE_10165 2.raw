<span id="A2.SS1.p1.pic1.2" class="ltx_inline-block ltx_minipage ltx_align_bottom" style="width:45.78em;">
<span id="A2.SS1.p1.pic1.2.1" class="ltx_listing ltx_lstlisting ltx_listing"><span class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></span>
<span id="lstnumberx1" class="ltx_listingline"><span id="lstnumberx1.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">[</span><span id="lstnumberx1.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">Before</span><span id="lstnumberx1.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx1.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">Optimization</span><span id="lstnumberx1.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">]</span>
</span>
<span id="lstnumberx2" class="ltx_listingline"><span id="lstnumberx2.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">1.</span><span id="lstnumberx2.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx2.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">probability</span><span id="lstnumberx2.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">of</span><span id="lstnumberx2.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">rolling</span><span id="lstnumberx2.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">a</span><span id="lstnumberx2.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.13" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">number</span><span id="lstnumberx2.14" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.15" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">greater</span><span id="lstnumberx2.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.17" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">than</span><span id="lstnumberx2.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">3</span><span id="lstnumberx2.20" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.21" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">on</span><span id="lstnumberx2.22" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.23" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">a</span><span id="lstnumberx2.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.25" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">single</span><span id="lstnumberx2.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.27" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">die</span><span id="lstnumberx2.28" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.29" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx2.30" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.31" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">**50%**</span><span id="lstnumberx2.32" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.33" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx2.34" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">numbers</span><span id="lstnumberx2.35" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.36" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">4,</span><span id="lstnumberx2.37" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.38" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">5,</span><span id="lstnumberx2.39" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.40" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">6</span><span id="lstnumberx2.41" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.42" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">out</span><span id="lstnumberx2.43" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.44" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">of</span><span id="lstnumberx2.45" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx2.46"