  "title": "[model, data, trainer] feat: precompute multimodal forward metadata in dataloader",
  "user": {
    "login": "TimYangst",
    "id": 4544577,
    "node_id": "MDQ6VXNlcjQ1NDQ1Nzc=",
    "avatar_url": "https://avatars.githubusercontent.com/u/4544577?v=4",
