{"data":{"id":"10.48550/arxiv.2605.22183","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.22183","prefix":"10.48550","suffix":"arxiv.2605.22183","identifiers":[{"identifier":"2605.22183","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.22183"}],"creators":[{"name":"Guo, Weilong","nameType":"Personal","givenName":"Weilong","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yuchen","nameType":"Personal","givenName":"Yuchen","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Renping","nameType":"Personal","givenName":"Renping","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Yunfeng","nameType":"Personal","givenName":"Yunfeng","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Rui","nameType":"Personal","givenName":"Rui","familyName":"Fang","affiliation":[],"nameIdentifiers":[]},{"name":"Pang, Yuyang","nameType":"Personal","givenName":"Yuyang","familyName":"Pang","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Wenda","nameType":"Personal","givenName":"Wenda","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Gao","nameType":"Personal","givenName":"Gao","familyName":"Huang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Action with Visual Primitives"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-21T08:52:47Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-22T00:41:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-24T02:38:35Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-26T00:51:09Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-06-13T04:46:06Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-06-16T00:21:54Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-09-20T14:20:32Z","dateType":"Withdrawn","dateInformation":"v4; We wish to complete further experimental improvements before publishing this work"},{"date":"2026-09-22T01:13:36Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Vision-Language-Action (VLA) models have emerged as a promising paradigm for generalist robotic manipulation. A common design in current architectures maps language instructions and visual observations to actions in a single forward pass. While conceptually simple, this formulation entangles instruction comprehension, spatial scene understanding, and motor control within a single learning objective. As a result, the action expert must implicitly relearn cognitive and perceptual capabilities already present in the pretrained VLM, which can limit both learning efficiency and generalization. We introduce AVP (Action with Visual Primitives), an end-to-end architecture that implements this visual-primitive-centric interface: the VLM infers the next-stage target and emits visual-primitive tokens that condition a flow-matching action expert, with supervision derived from end-effector kinematics. Real-robot experiments on general pick-and-place tasks show that AVP improves the success rate by 37.04% over pi_0.5 and outperforms other recent methods, with consistent gains in data efficiency, spatial-compositional generalization, and object-level transfer.","descriptionType":"Abstract"},{"description":"We wish to complete further experimental improvements before publishing this work","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.22183","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-22T02:10:10.000Z","registered":"2026-05-22T02:10:11.000Z","published":"2026","updated":"2026-09-22T04:50:59.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.22183","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}