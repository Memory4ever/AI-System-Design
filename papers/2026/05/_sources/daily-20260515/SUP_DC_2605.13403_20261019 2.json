{"data":{"id":"10.48550/arxiv.2605.13403","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.13403","prefix":"10.48550","suffix":"arxiv.2605.13403","identifiers":[{"identifier":"2605.13403","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.13403"}],"creators":[{"name":"Li, Qiwei","nameType":"Personal","givenName":"Qiwei","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Gong, Xicheng","nameType":"Personal","givenName":"Xicheng","familyName":"Gong","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xinghang","nameType":"Personal","givenName":"Xinghang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Peiyan","nameType":"Personal","givenName":"Peiyan","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Quanyun","nameType":"Personal","givenName":"Quanyun","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Hangjun","nameType":"Personal","givenName":"Hangjun","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Zhou, Jiahuan","nameType":"Personal","givenName":"Jiahuan","familyName":"Zhou","affiliation":[],"nameIdentifiers":[]},{"name":"Mu, Yadong","nameType":"Personal","givenName":"Yadong","familyName":"Mu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"RotVLA: Rotational Latent Action for Vision-Language-Action Model"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Robotics (cs.RO)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computer Vision and Pattern Recognition (cs.CV)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-13T11:58:02Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-14T01:01:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-24T16:58:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-25T01:13:47Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Latent Action Models (LAMs) have emerged as an effective paradigm for handling heterogeneous datasets during Vision-Language-Action (VLA) model pretraining, offering a unified action space across embodiments. However, existing LAMs often rely on discrete quantization encode and decode pipelines, which can lead to trivial frame reconstruction behavior, limited representational capacity, and a lack of physically meaningful structure. We introduce RotVLA, a VLA framework built on a continuous rotational latent action representation. Latent actions are modeled as elements of SO(n), providing continuity, compositionality, and structured geometry aligned with real-world action dynamics. A triplet frame learning framework further enforces meaningful temporal dynamics while avoiding degeneration. RotVLA consists of a VLM backbone and a flow-matching action head, pretrained on large-scale cross-embodiment robotic datasets and human videos with latent-action supervision. For downstream robot control, the flow-matching head is extended into a unified action expert that jointly denoises latent and robot actions. Here, latent actions serve as a latent planner, providing high-level guidance that conditions action generation. With only 1.7B parameters and 1700+ hours of pretraining data, RotVLA achieves 98.2% on LIBERO and 89.6% / 88.5% on RoboTwin2.0 under clean and randomized settings, respectively. It also demonstrates strong real-world performance on manipulation tasks, consistently outperforming existing VLA models.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.13403","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-14T02:31:46.000Z","registered":"2026-05-14T02:31:47.000Z","published":"2026","updated":"2026-09-25T02:55:15.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.13403","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}
