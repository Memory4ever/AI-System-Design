<td id="S4.T1.5.3.5" class="ltx_td ltx_align_right">302.6</td>
<td id="S4.T1.5.3.6" class="ltx_td ltx_align_center"><math id="S4.T1.m17" class="ltx_Math" alttext="7.55\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>7.55</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.55\times 10^{-6}</annotation></semantics></math></td>
<td id="S4.T1.5.3.7" class="ltx_td ltx_align_center"><math id="S4.T1.m18" class="ltx_Math" alttext="4.01\times 10^{7}" display="inline" intent=":literal"><semantics><mrow><mn>4.01</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>7</mn></msup></mrow><annotation encoding="application/x-tex">4.01\times 10^{7}</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.4" class="ltx_tr">
<td id="S4.T1.5.4.1" class="ltx_td ltx_align_center ltx_border_r">15</td>
<td id="S4.T1.5.4.2" class="ltx_td ltx_align_center">4096</td>
<td id="S4.T1.5.4.3" class="ltx_td ltx_align_center">3177</td>
<td id="S4.T1.5.4.4" class="ltx_td ltx_align_center">77.6</td>
<td id="S4.T1.5.4.5" class="ltx_td ltx_align_right">504.9</td>
<td id="S4.T1.5.4.6" class="ltx_td ltx_align_center"><math id="S4.T1.m19" class="ltx_Math" alttext="1.20\times 10^{-4}" display="inline" intent=":literal"><semantics><mrow><mn>1.20</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1.20\times 10^{-4}</annotation></semantics></math></td>
<td id="S4.T1.5.4.7" class="ltx_td ltx_align_center"><math id="S4.T1.m20" class="ltx_Math" alttext="4.19\times 10^{6}" display="inline" intent=":literal"><semantics><mrow><mn>4.19</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">4.19\times 10^{6}</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.5" class="ltx_tr">
<td id="S4.T1.5.5.1" class="ltx_td ltx_align_center ltx_border_r">20</td>
<td id="S4.T1.5.5.2" class="ltx_td ltx_align_center">4096</td>
<td id="S4.T1.5.5.3" class="ltx_td ltx_align_center">3258</td>
<td id="S4.T1.5.5.4" class="ltx_td ltx_align_center">79.6</td>
<td id="S4.T1.5.5.5" class="ltx_td ltx_align_right">537.5</td>
<td id="S4.T1.5.5.6" class="ltx_td ltx_align_center"><math id="S4.T1.m21" class="ltx_Math" alttext="7.16\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>7.16</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">7.16\times 10^{-6}</annotation></semantics></math></td>
<td id="S4.T1.5.5.7" class="ltx_td ltx_align_center"><math id="S4.T1.m22" class="ltx_Math" alttext="7.50\times 10^{7}" display="inline" intent=":literal"><semantics><mrow><mn>7.50</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>7</mn></msup></mrow><annotation encoding="application/x-tex">7.50\times 10^{7}</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.6" class="ltx_tr">
<td id="S4.T1.5.6.1" class="ltx_td ltx_align_center ltx_border_r">25</td>
<td id="S4.T1.5.6.2" class="ltx_td ltx_align_center">4096</td>
<td id="S4.T1.5.6.3" class="ltx_td ltx_align_center">3260</td>
<td id="S4.T1.5.6.4" class="ltx_td ltx_align_center">79.6</td>
<td id="S4.T1.5.6.5" class="ltx_td ltx_align_right">618.7</td>
<td id="S4.T1.5.6.6" class="ltx_td ltx_align_center"><math id="S4.T1.m23" class="ltx_Math" alttext="9.48\times 10^{-6}" display="inline" intent=":literal"><semantics><mrow><mn>9.48</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>6</mn></mrow></msup></mrow><annotation encoding="application/x-tex">9.48\times 10^{-6}</annotation></semantics></math></td>
<td id="S4.T1.5.6.7" class="ltx_td ltx_align_center"><math id="S4.T1.m24" class="ltx_Math" alttext="6.53\times 10^{7}" display="inline" intent=":literal"><semantics><mrow><mn>6.53</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>7</mn></msup></mrow><annotation encoding="application/x-tex">6.53\times 10^{7}</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.7" class="ltx_tr">
<td id="S4.T1.5.7.1" class="ltx_td ltx_align_center ltx_border_r">30</td>
<td id="S4.T1.5.7.2" class="ltx_td ltx_align_center">4096</td>
<td id="S4.T1.5.7.3" class="ltx_td ltx_align_center">2066</td>
<td id="S4.T1.5.7.4" class="ltx_td ltx_align_center">50.4</td>
<td id="S4.T1.5.7.5" class="ltx_td ltx_align_right">4922.3</td>
<td id="S4.T1.5.7.6" class="ltx_td ltx_align_center"><math id="S4.T1.m25" class="ltx_Math" alttext="3.85\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn>3.85</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3.85\times 10^{-5}</annotation></semantics></math></td>
<td id="S4.T1.5.7.7" class="ltx_td ltx_align_center"><math id="S4.T1.m26" class="ltx_Math" alttext="1.28\times 10^{8}" display="inline" intent=":literal"><semantics><mrow><mn>1.28</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>8</mn></msup></mrow><annotation encoding="application/x-tex">1.28\times 10^{8}</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.8" class="ltx_tr">
<td id="S4.T1.5.8.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r">31</td>
<td id="S4.T1.5.8.2" class="ltx_td ltx_align_center ltx_border_bb">4096</td>
<td id="S4.T1.5.8.3" class="ltx_td ltx_align_center ltx_border_bb">1023</td>
<td id="S4.T1.5.8.4" class="ltx_td ltx_align_center ltx_border_bb">25.0</td>
<td id="S4.T1.5.8.5" class="ltx_td ltx_align_right ltx_border_bb">13003.3</td>
<td id="S4.T1.5.8.6" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m27" class="ltx_Math" alttext="3.05\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn>3.05</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mrow><mo>−</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">3.05\times 10^{-3}</annotation></semantics></math></td>
<td id="S4.T1.5.8.7" class="ltx_td ltx_align_center ltx_border_bb"><math id="S4.T1.m28" class="ltx_Math" alttext="4.26\times 10^{6}" display="inline" intent=":literal"><semantics><mrow><mn>4.26</mn><mo lspace="0.222em" rspace="0.222em">×</mo><msup><mn>10</mn><mn>6</mn></msup></mrow><annotation encoding="application/x-tex">4.26\times 10^{6}</annotation></semantics></math></td></tr>
</table>
</figure>
<div id="S4.SS1.p8" class="ltx_para">
<p id="S4.SS1.p8.1" class="ltx_p">This setup allows us to ask a precise question: when an edit induces a change in hidden representations, how large is that change relative to the native signal scale of each principal direction?</p>
</div>
<div id="S4.Thmtheorem2" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Assumption 4.2</span></span><span id="S4.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(Small Perturbation Hypothesis)<span id="S4.Thmtheorem2.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem2.p1" class="ltx_para">
<p id="S4.Thmtheorem2.p1.1" class="ltx_p">A single editing operation induces a localized parameter perturbation <math id="S4.Thmtheorem2.p1.m1" class="ltx_Math" alttext="\triangle W" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">△</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">\triangle W</annotation></semantics></math> whose norm is sufficiently small for a first-order Taylor approximation of the induced representation change to be informative.</p>
</div>
</div>
<div id="S4.SS1.p9" class="ltx_para">
<p id="S4.SS1.p9.1" class="ltx_p">For single-edit regimes, the induced hidden-state perturbation norms remain relatively small in many edited layers across several parameter-based editing methods, supporting the use of local first-order analysis as a descriptive approximation. Full experimental results validating this hypothesis are provided in Appendix <a href="#A2.SS2" title="B.2 Hypothesis : Small-Perturbation Regime ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a> (Tables <a href="#A2.T9" title="Table 9 ‣ B.2 Hypothesis : Small-Perturbation Regime ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a>–<a href="#A2.T12" title="Table 12 ‣ B.2 Hypothesis : Small-Perturbation Regime ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">12</span></a>).</p>
</div>
<div id="S4.Thmtheorem3" class="ltx_theorem ltx_theorem_assumption">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Assumption 4.3</span></span><span id="S4.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Local Representation Stability Hypothesis)<span id="S4.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem3.p1" class="ltx_para">
<p id="S4.Thmtheorem3.p1.1" class="ltx_p">Within a short local editing regime, the principal directions <math id="S4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> of the original representation space remain sufficiently stable to serve as an approximate common basis for analyzing perturbations. This should be interpreted as a local analytical idealization rather than a global claim, especially because low-variance directions may drift rapidly under sequential editing.</p>
</div>
</div>
<div id="S4.SS1.p10" class="ltx_para">
<p id="S4.SS1.p10.1" class="ltx_p">Empirical observations (Appendix <a href="#A2.SS3" title="B.3 Hypothesis : Local Representation Stability ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a>, Tables <a href="#A2.T13" title="Table 13 ‣ B.3 Hypothesis : Local Representation Stability ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>–<a href="#A2.T20" title="Table 20 ‣ B.3 Hypothesis : Local Representation Stability ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>) suggest that dominant directions show higher stability under early sequential editing, while low-scale components deteriorate rapidly.</p>
</div>
<div id="S4.SS1.p11" class="ltx_para">
<p id="S4.SS1.p11.1" class="ltx_p">These hypotheses are not limited to a single model scale or family. A broader set of empirical measurements across different model sizes and architectures is provided in Appendix <a href="#A2.SS4" title="B.4 Generalization Across Model Scales and Architectures ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>, confirming the recurrence of the same spectral signatures and vulnerability mechanisms.</p>
</div>
</section>
<section id="S4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.2 </span>Relative Perturbation Amplification in Collapsed Directions</h3>

<div id="S4.SS2.p1" class="ltx_para">
<p id="S4.SS2.p1.1" class="ltx_p">For a given input x, the representation change induced by editing is approximated by a first-order Taylor expansion (per Hypothesis <a href="#S4.Thmtheorem2" title="Assumption 4.2 (Small Perturbation Hypothesis). ‣ 4.1 Working Hypotheses and Problem Formulation ‣ 4 Theoretical Analysis ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.2</span></a>):</p>
<table id="S4.EGx1" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="S4.E7"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S4.E7.m1" class="ltx_Math" alttext="\displaystyle\triangle h\stackrel{{\scriptstyle\triangle}}{{=}}h_{\text{edited}}-h" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">△</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mover><mo>=</mo><mi mathvariant="normal">△</mi></mover><mrow><msub><mi>h</mi><mtext>edited</mtext></msub><mo>−</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\triangle h\stackrel{{\scriptstyle\triangle}}{{=}}h_{\text{edited}}-h</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E7.m2" class="ltx_Math" alttext="\displaystyle=\phi((W+\triangle W)x)-\phi(Wx)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo>+</mo><mrow><mi mathvariant="normal">△</mi><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\phi((W+\triangle W)x)-\phi(Wx)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(7)</span></td></tr></tbody>
<tbody id="S4.E8"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S4.E8.m1" class="ltx_Math" alttext="\displaystyle\approx J_{\phi}(a)\cdot\triangle W\cdot x," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≈</mo><mrow><mrow><mrow><mrow><msub><mi>J</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mi mathvariant="normal">△</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>W</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>x</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\approx J_{\phi}(a)\cdot\triangle W\cdot x,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(8)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS2.p2" class="ltx_para">
<p id="S4.SS2.p2.1" class="ltx_p">where <math id="S4.SS2.p2.m1" class="ltx_Math" alttext="a=Wx" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo>=</mo><mrow><mi>W</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow></mrow><annotation encoding="application/x-tex">a=Wx</annotation></semantics></math> and <math id="S4.SS2.p2.m2" class="ltx_Math" alttext="J_{\phi}(a)=\operatorname{diag}(\phi^{\prime}(a_{1}),\dots,\phi^{\prime}(a_{d}))\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>diag</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>ϕ</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>a</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">J_{\phi}(a)=\operatorname{diag}(\phi^{\prime}(a_{1}),\dots,\phi^{\prime}(a_{d}))\in\mathbb{R}^{d\times d}</annotation></semantics></math> is the Jacobian matrix of activation function <math id="S4.SS2.p2.m3" class="ltx_Math" alttext="\phi" display="inline" intent=":literal"><semantics><mi>ϕ</mi><annotation encoding="application/x-tex">\phi</annotation></semantics></math> at <math id="S4.SS2.p2.m4" class="ltx_Math" alttext="a" display="inline" intent=":literal"><semantics><mi>a</mi><annotation encoding="application/x-tex">a</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p3" class="ltx_para">
<p id="S4.SS2.p3.1" class="ltx_p">Under Hypothesis <a href="#S4.Thmtheorem3" title="Assumption 4.3 (Local Representation Stability Hypothesis). ‣ 4.1 Working Hypotheses and Problem Formulation ‣ 4 Theoretical Analysis ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a>, we project <math id="S4.SS2.p3.m1" class="ltx_Math" alttext="\Delta h" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><annotation encoding="application/x-tex">\Delta h</annotation></semantics></math> onto the original principal basis <math id="S4.SS2.p3.m2" class="ltx_Math" alttext="\{u_{k}\}_{k=1}^{d}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>u</mi><mi>k</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></msubsup><annotation encoding="application/x-tex">\{u_{k}\}_{k=1}^{d}</annotation></semantics></math>:</p>
</div>
<div id="S4.SS2.p4" class="ltx_para">
<table id="S4.E9" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E9.m1" class="ltx_Math" alttext="\Delta h=\sum_{k=1}^{d}c_{k}u_{k}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow><mo rspace="0.111em">=</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mrow><msub><mi>c</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>u</mi><mi>k</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\Delta h=\sum_{k=1}^{d}c_{k}u_{k},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(9)</span></td></tr></tbody>
</table>
</div>
<div id="S4.SS2.p5" class="ltx_para">
<p id="S4.SS2.p5.1" class="ltx_p">where
<math id="S4.SS2.p5.m1" class="ltx_Math" alttext="c_{k}=u_{k}^{T}\Delta h" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mi>k</mi></msub><mo>=</mo><mrow><msubsup><mi>u</mi><mi>k</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mi mathvariant="normal">Δ</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></mrow><annotation encoding="application/x-tex">c_{k}=u_{k}^{T}\Delta h</annotation></semantics></math>
is the perturbation component along direction <math id="S4.SS2.p5.m2" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS2.p6" class="ltx_para">
<p id="S4.SS2.p6.1" class="ltx_p">To quantify the native signal scale of the unedited model in direction <math id="S4.SS2.p6.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>, we consider the root mean square (RMS) magnitude across the sample set:</p>
<table id="S4.E10" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E10.m1" class="ltx_Math" alttext="\mathrm{RMS}(h_{k})\stackrel{{\scriptstyle\triangle}}{{=}}\sqrt{\frac{1}{n}\sum_{i=1}^{n}(u_{k}^{T}h^{(i)})^{2}}=\frac{\sigma_{k}}{\sqrt{n}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>RMS</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mover><mo>=</mo><mi mathvariant="normal">△</mi></mover><msqrt><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><msup><mrow><mo stretchy="false">(</mo><mrow><msubsup><mi>u</mi><mi>k</mi><mi>T</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><msup><mi>h</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></msqrt><mo>=</mo><mfrac><msub><mi>σ</mi><mi>k</mi></msub><msqrt><mi>n</mi></msqrt></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{RMS}(h_{k})\stackrel{{\scriptstyle\triangle}}{{=}}\sqrt{\frac{1}{n}\sum_{i=1}^{n}(u_{k}^{T}h^{(i)})^{2}}=\frac{\sigma_{k}}{\sqrt{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(10)</span></td></tr></tbody>
</table>
<p id="S4.SS2.p6.2" class="ltx_p">For directions with non-zero <math id="S4.SS2.p6.m2" class="ltx_Math" alttext="\sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\sigma_{k}</annotation></semantics></math>, it determines the typical pre-edit scale of <math id="S4.SS2.p6.m3" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>.</p>
</div>
<div id="S4.Thmtheorem4" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Definition 4.4</span></span><span id="S4.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Directional Relative Change Rate)<span id="S4.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem4.p1" class="ltx_para">
<p id="S4.Thmtheorem4.p1.1" class="ltx_p">The relative change rate induced along direction <math id="S4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math> is defined as</p>
<table id="S4.E11" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E11.m1" class="ltx_Math" alttext="R_{k}\stackrel{{\scriptstyle\triangle}}{{=}}\frac{c_{k}}{\mathrm{RMS}(h_{k})}=\frac{\sqrt{n}|c_{k}|}{\sigma_{k}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>k</mi></msub><mover><mo>=</mo><mi mathvariant="normal">△</mi></mover><mfrac><msub><mi>c</mi><mi>k</mi></msub><mrow><mi>RMS</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>h</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>=</mo><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{k}\stackrel{{\scriptstyle\triangle}}{{=}}\frac{c_{k}}{\mathrm{RMS}(h_{k})}=\frac{\sqrt{n}|c_{k}|}{\sigma_{k}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(11)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="S4.SS2.p7" class="ltx_para">
<p id="S4.SS2.p7.1" class="ltx_p"><math id="S4.SS2.p7.m1" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> quantifies the perturbation size relative to the native signal scale of direction <math id="S4.SS2.p7.m2" class="ltx_Math" alttext="u_{k}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>k</mi></msub><annotation encoding="application/x-tex">u_{k}</annotation></semantics></math>. A large <math id="S4.SS2.p7.m3" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> arises from either a large <math id="S4.SS2.p7.m4" class="ltx_Math" alttext="c_{k}" display="inline" intent=":literal"><semantics><msub><mi>c</mi><mi>k</mi></msub><annotation encoding="application/x-tex">c_{k}</annotation></semantics></math> or a small <math id="S4.SS2.p7.m5" class="ltx_Math" alttext="\sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\sigma_{k}</annotation></semantics></math>.
When <math id="S4.SS2.p7.m6" class="ltx_Math" alttext="R_{k}\ll 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>k</mi></msub><mo>≪</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R_{k}\ll 1</annotation></semantics></math>, the edit remains small compared to the typical pre-edit magnitude in that direction. In contrast, when <math id="S4.SS2.p7.m7" class="ltx_Math" alttext="R_{k}\gtrsim 1" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>k</mi></msub><mo>≳</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R_{k}\gtrsim 1</annotation></semantics></math>, the perturbation becomes comparable to or larger than the direction’s native signal scale, indicating substantial distortion.</p>
</div>
<div id="S4.Thmtheorem5" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="S4.Thmtheorem5.2" class="ltx_text ltx_font_bold">Theorem 4.5</span></span><span id="S4.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(Relative Amplification in Low-Scale Directions)<span id="S4.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="S4.Thmtheorem5.p1" class="ltx_para">
<p id="S4.Thmtheorem5.p1.1" class="ltx_p"><span id="S4.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="S4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="u_{\min}" display="inline" intent=":literal"><semantics><msub><mi>u</mi><mi>min</mi></msub><annotation encoding="application/x-tex">u_{\min}</annotation></semantics></math> denote a principal direction associated with the smallest non-zero singular value <math id="S4.Thmtheorem5.p1.m2" class="ltx_Math" alttext="\sigma_{\min}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\sigma_{\min}</annotation></semantics></math>. If the projection of the editing-induced perturbation onto this direction has magnitude <math id="S4.Thmtheorem5.p1.m3" class="ltx_Math" alttext="|c_{\min}|=\varepsilon" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>min</mi></msub><mo stretchy="false">|</mo></mrow><mo>=</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">|c_{\min}|=\varepsilon</annotation></semantics></math>, then its directional relative change rate is</span></p>
<table id="S4.E12" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E12.m1" class="ltx_Math" alttext="R_{\min}=\frac{\sqrt{n}\,\varepsilon}{\sigma_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>min</mi></msub><mo>=</mo><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0.170em" rspace="0em">​</mo><mi>ε</mi></mrow><msub><mi>σ</mi><mi>min</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{\min}=\frac{\sqrt{n}\,\varepsilon}{\sigma_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(12)</span></td></tr></tbody>
</table>
</div>
<div id="S4.Thmtheorem5.p2" class="ltx_para">
<p id="S4.Thmtheorem5.p2.1" class="ltx_p"><span id="S4.Thmtheorem5.p2.1.1" class="ltx_text ltx_font_italic">More generally, for any principal direction with <math id="S4.Thmtheorem5.p2.m1" class="ltx_Math" alttext="\sigma_{k}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{k}&gt;0</annotation></semantics></math>,</span></p>
<table id="S4.E13" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.E13.m1" class="ltx_Math" alttext="R_{k}=\frac{\sqrt{n}|c_{k}|}{\sigma_{k}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>R</mi><mi>k</mi></msub><mo>=</mo><mfrac><mrow><msqrt><mi>n</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msub><mi>c</mi><mi>k</mi></msub><mo stretchy="false">|</mo></mrow></mrow><msub><mi>σ</mi><mi>k</mi></msub></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">R_{k}=\frac{\sqrt{n}|c_{k}|}{\sigma_{k}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(13)</span></td></tr></tbody>
</table>
</div>
<div id="S4.Thmtheorem5.p3" class="ltx_para">
<p id="S4.Thmtheorem5.p3.1" class="ltx_p"><span id="S4.Thmtheorem5.p3.1.1" class="ltx_text ltx_font_italic">Hence, for perturbation components of comparable absolute magnitude across directions, the induced relative distortion is larger in directions with smaller singular values. In particular, when <math id="S4.Thmtheorem5.p3.m1" class="ltx_Math" alttext="\sigma_{\min}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>min</mi></msub><annotation encoding="application/x-tex">\sigma_{\min}</annotation></semantics></math> is extremely small, even a modest local perturbation can produce a very large relative distortion.</span></p>
</div>
</div>
<div id="S4.SS2.p8" class="ltx_para">
<p id="S4.SS2.p8.1" class="ltx_p">This theorem highlights a critical vulnerability: representation distortions are disproportionately amplified in directions with small <math id="S4.SS2.p8.m1" class="ltx_Math" alttext="\sigma_{k}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>k</mi></msub><annotation encoding="application/x-tex">\sigma_{k}</annotation></semantics></math> irrespective of input perturbation energy.
This concerns relative fragility, not semantic importance. We do not assume low-singular-value directions are meaningful or that editing concentrates perturbation energy in them. The claim is simply that any perturbation component landing there becomes disproportionately large relative to the native signal.</p>
</div>
<div id="S4.SS2.p9" class="ltx_para">
<p id="S4.SS2.p9.1" class="ltx_p">This amplification effect, where <math id="S4.SS2.p9.m1" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> is most pronounced along directions with small singular values, is empirically supported by Figure <a href="#S4.F2" title="Figure 2 ‣ 4.2 Relative Perturbation Amplification in Collapsed Directions ‣ 4 Theoretical Analysis ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>, which shows the distribution of <math id="S4.SS2.p9.m2" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> in layer 30 of Llama-3.1-8B-Instruct after performing 1000 sequential edits using MEMIT. Specifically, this observation aligns with our empirical measurements: the largest relative change rates concentrate in directions with small singular values, and a single edit can often yield <math id="S4.SS2.p9.m3" class="ltx_Math" alttext="R_{k}&gt;1" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mi>k</mi></msub><mo>&gt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">R_{k}&gt;1</annotation></semantics></math> in many directions, exceeding the native signal scale of the original representation. Full empirical validations, including visualizations and statistics of <math id="S4.SS2.p9.m4" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math>, are provided in Appendix <a href="#A2.SS5" title="B.5 Direct Empirical Validation of the Amplification Mechanism ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a> (Figure <a href="#A2.F6" title="Figure 6 ‣ B.5.1 Directional amplification along collapsed directions ‣ B.5 Direct Empirical Validation of the Amplification Mechanism ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>, Tables <a href="#A2.T21" title="Table 21 ‣ B.5.2 Layerwise distributions of relative change rates ‣ B.5 Direct Empirical Validation of the Amplification Mechanism ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">21</span></a>–<a href="#A2.T24" title="Table 24 ‣ B.5.2 Layerwise distributions of relative change rates ‣ B.5 Direct Empirical Validation of the Amplification Mechanism ‣ Appendix B Justifications for Working Hypotheses and Empirical Support ‣ Revisiting Parameter-Based Knowledge Editing in Large Language Models: Theoretical Limits and Empirical Evidence" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>).</p>
</div>
<figure id="S4.F2" class="ltx_figure"><object type="image/svg+xml" data="2606.00570v1/R_k_MEMIT_1000_layer30.svg" id="S4.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:448/249;" width="448" height="249"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="S4.F2.4" class="ltx_text" style="font-size:90%;">
Distribution of <math id="S4.F2.m2" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> values in layer 30 of Llama-3.1-8B-Instruct after performing 1000 sequential edits using MEMIT.
</span></figcaption>
</figure>
<figure id="S4.T2" class="ltx_table">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S4.T2.6" class="ltx_text" style="font-size:90%;">Table 2</span>: </span><span id="S4.T2.7" class="ltx_text" style="font-size:90%;">
Spearman correlation between step-level amplification and editing performance, using the <span id="S4.T2.7.1" class="ltx_text ltx_font_bold">median</span> of the layer-wise <math id="S4.T2.m7" class="ltx_Math" alttext="R_{k}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>k</mi></msub><annotation encoding="application/x-tex">R_{k}</annotation></semantics></math> distribution and <span id="S4.T2.7.2" class="ltx_text ltx_font_bold">mean</span> aggregation across edited layers.
Entries report Spearman’s <math id="S4.T2.m8" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math> with significance markers, followed by the corresponding <math id="S4.T2.m9" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math>-value in parentheses.
<span id="S4.T2.7.3" class="ltx_text ltx_font_italic">Note.</span> <math id="S4.T2.m10" class="ltx_math_unparsed" alttext="{}^{*}p&lt;0.05" display="inline" intent=":literal"><semantics><mrow><msup><mrow></mrow><mo>∗</mo></msup><mi>p</mi><mo>&lt;</mo><mn>0.05</mn></mrow><annotation encoding="application/x-tex">{}^{*}p&lt;0.05</annotation></semantics></math>, <math id="S4.T2.m11" class="ltx_Math" alttext="{}^{**}p&lt;0.01" display="inline" intent=":literal"><semantics><mrow><mmultiscripts><mi>p</mi><mprescripts></mprescripts><mrow></mrow><mrow><mo>∗</mo><mo lspace="0em">⁣</mo><mo>∗</mo></mrow></mmultiscripts><mo>&lt;</mo><mn>0.01</mn></mrow><annotation encoding="application/x-tex">{}^{**}p&lt;0.01</annotation></semantics></math>, <math id="S4.T2.m12" class="ltx_math_unparsed" alttext="{}^{***}p&lt;0.001" display="inline" intent=":literal"><semantics><mrow><msup><mrow></mrow><mrow><mo rspace="0em">∗</mo><mo lspace="0em" rspace="0em">∗</mo><mo lspace="0em">∗</mo></mrow></msup><mi>p</mi><mo>&lt;</mo><mn>0.001</mn></mrow><annotation encoding="application/x-tex">{}^{***}p&lt;0.001</annotation></semantics></math>.
</span></figcaption>
<table id="S4.T2.8" class="ltx_tabular ltx_centering ltx_align_middle">
<tr id="S4.T2.8.1" class="ltx_tr">
<td id="S4.T2.8.1.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.1.1.1" class="ltx_text" style="font-size:90%;">Metric</span></td>
<td id="S4.T2.8.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.1.2.1" class="ltx_text" style="font-size:90%;">AlphaEdit</span></td>
<td id="S4.T2.8.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.1.3.1" class="ltx_text" style="font-size:90%;">MEMIT</span></td>
<td id="S4.T2.8.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.1.4.1" class="ltx_text" style="font-size:90%;">ROME</span></td>
<td id="S4.T2.8.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.1.5.1" class="ltx_text" style="font-size:90%;">WISE</span></td></tr>
<tr id="S4.T2.8.2" class="ltx_tr">
<td id="S4.T2.8.2.1" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding-left:7.0pt;padding-right:7.0pt;"><span id="S4.T2.8.2.1.1" class="ltx_text" style="font-size:90%;">Rel.</span></td>
<td id="S4.T2.8.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:7.0pt;padding-right:7.0pt;"><math id="S4.T2.m13" class="ltx_Math" alttext="-0.2034" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">0.2034</mn></mrow><annotation encoding="application/x-tex">-0.2034</annotation></semantics></math><span id="S4.T2.8.2.2.1" class="ltx_text" style="font-size:90%;"> <math id="S4.T2.m14" class="ltx_Math" alttext="(0.5996)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mn>0.5996</mn><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(0.5996)</annotation></semantics></math></span></td>
