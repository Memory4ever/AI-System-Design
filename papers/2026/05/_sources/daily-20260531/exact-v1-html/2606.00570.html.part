<td id="A2.T14.5.1.4" class="ltx_td ltx_align_center ltx_border_tt">Top200 PCs Cos</td>
<td id="A2.T14.5.1.5" class="ltx_td ltx_align_center ltx_border_tt">Top2000 PCs Cos</td></tr>
<tr id="A2.T14.5.2" class="ltx_tr">
<td id="A2.T14.5.2.1" class="ltx_td ltx_align_center ltx_border_t">1</td>
<td id="A2.T14.5.2.2" class="ltx_td ltx_align_center ltx_border_t">1.000</td>
<td id="A2.T14.5.2.3" class="ltx_td ltx_align_center ltx_border_t">0.984</td>
<td id="A2.T14.5.2.4" class="ltx_td ltx_align_center ltx_border_t">0.906</td>
<td id="A2.T14.5.2.5" class="ltx_td ltx_align_center ltx_border_t">0.014</td></tr>
