mnalign="left"><msub><mi>d</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>[varied]</mtext></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>i</mi></mtd></mtr></mtable></mpadded><mo stretchy="false">}</mo></mrow><mtext>iden</mtext></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mpadded voffset="1.0pt"><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∅</mi></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∅</mi></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>AI</mtext></mtd></mtr></mtable></mpadded><mo stretchy="false">}</mo></mrow><mtext>base</mtext></msub><mo>,</mo><mtext>revealed</mtext><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mpadded style="width:0.413em;" width="0.413em"><mi>λ</mi></mpadded><mtext>base</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">{</mo><mpadded voffset="1.0pt"><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><msub><mi>d</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>[varied]</mtext></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi>i</mi></mtd></mtr></mtable></mpadded><mo stretchy="false">}</mo></mrow><mtext>iden</mtext></msub><mo>,</mo><msub><mrow><mo stretchy="false">{</mo><mpadded voffset="1.0pt"><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∅</mi></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mi mathvariant="normal">∅</mi></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mtext>AI</mtext></mtd></mtr></mtable></mpadded><mo stretchy="false">}</mo></mrow><mtext>base</mtext></msub><mo>,</mo><mtext>anon.</mtext><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\begin{split}(\Delta_{\mathrm{Demo}}\Delta_{\mathrm{RC}}\lambda_{\text{base}})(d_{1},d_{2},i)=&amp;\Big[\lambda_{\text{base}}\!\big(\Big\{\raisebox{1.00006pt}{$\begin{array}[]{@{}l@{}}d_{1}\\
