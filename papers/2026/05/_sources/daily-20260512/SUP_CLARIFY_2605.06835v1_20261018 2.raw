<td id="A1.T2.5.3.1" class="ltx_td ltx_align_left">Statistics-Based Synthesis 100%</td>
<td id="A1.T2.5.3.2" class="ltx_td ltx_align_center">1.90</td>
<td id="A1.T2.5.3.3" class="ltx_td ltx_align_center">3.33</td>
<td id="A1.T2.5.3.4" class="ltx_td ltx_align_center">0.0</td></tr>
<tr id="A1.T2.5.4" class="ltx_tr">
<td id="A1.T2.5.4.1" class="ltx_td ltx_align_left">Noisy Adversary Data 25%</td>
<td id="A1.T2.5.4.2" class="ltx_td ltx_align_center">1.16</td>
<td id="A1.T2.5.4.3" class="ltx_td ltx_align_center">3.18</td>
