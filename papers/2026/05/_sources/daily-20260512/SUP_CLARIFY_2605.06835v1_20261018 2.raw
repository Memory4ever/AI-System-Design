</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F7.fig5" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2605.06835v1/diabetes_ensemble_dcr_batch_size.svg" id="S4.F7.g5" class="ltx_graphics ltx_img_square" style="aspect-ratio:471/471;" width="471" height="471"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F7.fig6" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2605.06835v1/diabetes_ensemble_dcr_synthetic_size.svg" id="S4.F7.g6" class="ltx_graphics ltx_img_square" style="aspect-ratio:471/471;" width="471" height="471"></object>
</figure></div></div>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="S4.F7.3" class="ltx_text" style="font-size:90%;">Figure 7</span>: </span><span id="S4.F7.4" class="ltx_text" style="font-size:90%;">Training and synthesis levers vs. Ensemble MIA success and DCR for the Diabetes dataset.</span></figcaption>
</figure>
<figure id="S4.F8" class="ltx_figure">
<div class="ltx_flex_figure">
<div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F8.fig1" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2605.06835v1/diabetes_ensemble_dcr_shadow_models.svg" id="S4.F8.g1" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:471/343;" width="471" height="343"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F8.fig2" class="ltx_figure ltx_figure_panel"><object type="image/svg+xml" data="2605.06835v1/diabetes_ensemble_shadow_variation.svg" id="S4.F8.g2" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:471/343;" width="471" height="343"></object>
</figure></div><div class="ltx_flex_cell ltx_flex_size_3">
<figure id="S4.F8.fig3" class="ltx_figure ltx_figure_panel"><img src="2605.06835v1/diabetes_ensemble_distribution_variation.png" id="S4.F8.g3" class="ltx_graphics ltx_img_landscape" style="aspect-ratio:471/343;" width="471" height="343" alt="Refer to caption">
</figure></div></div>
