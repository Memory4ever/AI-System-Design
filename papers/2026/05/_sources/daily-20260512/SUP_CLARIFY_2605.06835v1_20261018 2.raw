<tr id="A6.T3.5.1.2" class="ltx_tr">
<th id="A6.T3.5.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A6.T3.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math> Cov. <math id="A6.T3.m2" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></th>
<td id="A6.T3.5.1.2.2" class="ltx_td ltx_align_center ltx_border_t">5.91e-01</td>
<td id="A6.T3.5.1.2.3" class="ltx_td ltx_align_center ltx_border_t">5.78-e-01</td>
<td id="A6.T3.5.1.2.4" class="ltx_td ltx_align_center ltx_border_t">5.91e-01</td>
<td id="A6.T3.5.1.2.5" class="ltx_td ltx_align_center ltx_border_t">4.29e-01</td>
<td id="A6.T3.5.1.2.6" class="ltx_td ltx_align_center ltx_border_t">4.51e-01</td>
<td id="A6.T3.5.1.2.7" class="ltx_td ltx_align_center ltx_border_t">4.58e-01</td>
<td id="A6.T3.5.1.2.8" class="ltx_td ltx_align_center ltx_border_t">4.79e-01</td>
<td id="A6.T3.5.1.2.9" class="ltx_td ltx_align_center ltx_border_t">4.89e-01</td>
<td id="A6.T3.5.1.2.10" class="ltx_td ltx_align_center ltx_border_t">5.04e-01</td>
