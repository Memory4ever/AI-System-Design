<td id="S4.SS3.p2.1.1.11.3" class="ltx_td ltx_align_center"><span id="S4.SS3.p2.1.1.11.3.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">61.5</span></td>
<td id="S4.SS3.p2.1.1.11.4" class="ltx_td ltx_align_center"><span id="S4.SS3.p2.1.1.11.4.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">108.4</span></td>
<td id="S4.SS3.p2.1.1.11.5" class="ltx_td ltx_align_center"><span id="S4.SS3.p2.1.1.11.5.1" class="ltx_text ltx_underline" style="--ltx-bg-color:#F5F5F5;">120.4</span></td></tr>
<tr id="S4.SS3.p2.1.1.12" class="ltx_tr">
<td id="S4.SS3.p2.1.1.12.1" class="ltx_td ltx_align_left">MiniMax-M2</td>
<td id="S4.SS3.p2.1.1.12.2" class="ltx_td ltx_align_center">20.3</td>
