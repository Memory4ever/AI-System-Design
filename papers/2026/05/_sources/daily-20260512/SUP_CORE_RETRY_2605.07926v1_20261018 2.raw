<td id="S4.SS3.p2.1.1.13.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.SS3.p2.1.1.13.2.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">14.2</span></td>
<td id="S4.SS3.p2.1.1.13.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S4.SS3.p2.1.1.13.3.1" class="ltx_text" style="--ltx-bg-color:#F5F5F5;">50.5</span></td>
