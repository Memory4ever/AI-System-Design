<td id="S4.T2.4.1.2.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.5.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-20</span></td>
<td id="S4.T2.4.1.2.6" class="ltx_td"></td>
<td id="S4.T2.4.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.7.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-5</span></td>
<td id="S4.T2.4.1.2.8" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-10</span></td>
<td id="S4.T2.4.1.2.9" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-15</span></td>
<td id="S4.T2.4.1.2.10" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.10.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-20</span></td>
<td id="S4.T2.4.1.2.11" class="ltx_td"></td>
<td id="S4.T2.4.1.2.12" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.12.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-5</span></td>
<td id="S4.T2.4.1.2.13" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.13.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-10</span></td>
<td id="S4.T2.4.1.2.14" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.14.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-15</span></td>
<td id="S4.T2.4.1.2.15" class="ltx_td ltx_align_center ltx_border_t"><span id="S4.T2.4.1.2.15.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#F3F6FA;">D-20</span></td></tr>
