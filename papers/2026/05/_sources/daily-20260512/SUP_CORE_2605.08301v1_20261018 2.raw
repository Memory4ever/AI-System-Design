<td id="S5.T5.7.1.6.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_r"><math id="S5.T5.m24" class="ltx_Math" alttext="-6.0" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">6.0</mn></mrow><annotation encoding="application/x-tex">-6.0</annotation></semantics></math></td>
