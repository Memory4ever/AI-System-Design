<td id="S11.T14.5.3.2" class="ltx_td ltx_align_center"><span id="S11.T14.5.3.2.1" class="ltx_text" style="font-size:90%;">16,613 (1.86<math id="S11.T14.m3" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
<td id="S11.T14.5.3.3" class="ltx_td ltx_align_center"><span id="S11.T14.5.3.3.1" class="ltx_text" style="font-size:90%;">9,341 (1.81<math id="S11.T14.m4" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
<td id="S11.T14.5.3.4" class="ltx_td ltx_align_center"><span id="S11.T14.5.3.4.1" class="ltx_text" style="font-size:90%;">5,230 (1.91<math id="S11.T14.m5" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
<td id="S11.T14.5.3.5" class="ltx_td ltx_align_center"><span id="S11.T14.5.3.5.1" class="ltx_text" style="font-size:90%;">2,772 (2.26<math id="S11.T14.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td></tr>
<tr id="S11.T14.5.4" class="ltx_tr">
<th id="S11.T14.5.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S11.T14.5.4.1.1" class="ltx_text" style="font-size:90%;">GKA-Primed-HQwen3 (<span id="S11.T14.5.4.1.1.1" class="ltx_text ltx_font_typewriter">num_iter</span>=10)</span></th>
<td id="S11.T14.5.4.2" class="ltx_td ltx_align_center"><span id="S11.T14.5.4.2.1" class="ltx_text" style="font-size:90%;">17,368 (1.94<math id="S11.T14.m7" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>)</span></td>
