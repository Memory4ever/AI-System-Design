</tbody>
</table>
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="S9.T10.st2" class="ltx_table ltx_figure_panel ltx_align_center">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="S9.T10.st2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="S9.T10.st2.4" class="ltx_text" style="font-size:90%;">Multi-node (2<math id="S9.T10.st2.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>4 GPUs)</span></figcaption>
<table id="S9.T10.st2.5" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
