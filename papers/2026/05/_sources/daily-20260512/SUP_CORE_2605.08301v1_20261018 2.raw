<td id="S10.T11.6.3.3" class="ltx_td ltx_align_center"><span id="S10.T11.6.3.3.1" class="ltx_text" style="font-size:90%;">1.6B</span></td>
<td id="S10.T11.6.3.4" class="ltx_td ltx_align_center"><span id="S10.T11.6.3.4.1" class="ltx_text" style="font-size:90%;">1.6B</span></td></tr>
<tr id="S10.T11.6.4" class="ltx_tr">
<th id="S10.T11.6.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="S10.T11.6.4.1.1" class="ltx_text" style="font-size:90%;">Global batch size (tokens)</span></th>
