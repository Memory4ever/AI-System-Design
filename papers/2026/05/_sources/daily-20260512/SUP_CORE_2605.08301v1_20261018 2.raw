<td id="S10.T12.6.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="S10.T12.6.2.4.1" class="ltx_text" style="font-size:90%;">128K</span></td></tr>
<tr id="S10.T12.6.3" class="ltx_tr">
