<td id="S10.T12.6.6.2" class="ltx_td ltx_align_center"><span id="S10.T12.6.6.2.1" class="ltx_text" style="font-size:90%;">cosine</span></td>
<td id="S10.T12.6.6.3" class="ltx_td ltx_align_center"><span id="S10.T12.6.6.3.1" class="ltx_text" style="font-size:90%;">cosine</span></td>
<td id="S10.T12.6.6.4" class="ltx_td ltx_align_center"><span id="S10.T12.6.6.4.1" class="ltx_text" style="font-size:90%;">cosine</span></td></tr>
<tr id="S10.T12.6.7" class="ltx_tr">
<th id="S10.T12.6.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="S10.T12.6.7.1.1" class="ltx_text" style="font-size:90%;">Warmup ratio/steps</span></th>
<td id="S10.T12.6.7.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="S10.T12.6.7.2.1" class="ltx_text" style="font-size:90%;">10%</span></td>
<td id="S10.T12.6.7.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="S10.T12.6.7.3.1" class="ltx_text" style="font-size:90%;">200 steps</span></td>
<td id="S10.T12.6.7.4" class="ltx_td ltx_align_center ltx_border_bb"><span id="S10.T12.6.7.4.1" class="ltx_text" style="font-size:90%;">100 steps</span></td></tr>
