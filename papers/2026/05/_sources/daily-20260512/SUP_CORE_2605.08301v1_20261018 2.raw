<th id="S4.T1.5.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt"><span id="S4.T1.5.1.2.1" class="ltx_text ltx_font_bold">Transition operator</span> <math id="S4.T1.m11" class="ltx_Math" alttext="\mathbf{A}_{t}" display="inline" intent=":literal"><semantics><msub><mi>𝐀</mi><mi>t</mi></msub><annotation encoding="application/x-tex">\mathbf{A}_{t}</annotation></semantics></math></th>
