<td id="S4.T1.5.3.3" class="ltx_td ltx_align_left"><math id="S4.T1.m17" class="ltx_Math" alttext="\beta_{t}\,\bm{k}_{t}^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>t</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><msubsup><mi>𝒌</mi><mi>t</mi><mo>⊤</mo></msubsup></mrow><annotation encoding="application/x-tex">\beta_{t}\,\bm{k}_{t}^{\top}</annotation></semantics></math></td>
<td id="S4.T1.5.3.4" class="ltx_td ltx_align_left"><math id="S4.T1.m18" class="ltx_Math" alttext="\gamma_{t},\beta_{t}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>,</mo><mrow><msub><mi>β</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma_{t},\beta_{t}\in(0,1)</annotation></semantics></math></td></tr>
