<td id="S10.T12.6.5.3" class="ltx_td ltx_align_center"><math id="S10.T12.m3" class="ltx_Math" alttext="5\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-5}</annotation></semantics></math></td>
<td id="S10.T12.6.5.4" class="ltx_td ltx_align_center"><math id="S10.T12.m4" class="ltx_Math" alttext="5\times 10^{-5}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">5</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5\times 10^{-5}</annotation></semantics></math></td></tr>
<tr id="S10.T12.6.6" class="ltx_tr">
