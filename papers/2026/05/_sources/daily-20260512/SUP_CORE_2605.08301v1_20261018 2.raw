<td id="S4.T1.5.2.2" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T1.m13" class="ltx_Math" alttext="\gamma_{t}\,\mathbf{I}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo lspace="0.170em" rspace="0em">​</mo><mi>𝐈</mi></mrow><annotation encoding="application/x-tex">\gamma_{t}\,\mathbf{I}</annotation></semantics></math></td>
<td id="S4.T1.5.2.3" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T1.m14" class="ltx_Math" alttext="\bm{k}_{t}^{\top}" display="inline" intent=":literal"><semantics><msubsup><mi>𝒌</mi><mi>t</mi><mo>⊤</mo></msubsup><annotation encoding="application/x-tex">\bm{k}_{t}^{\top}</annotation></semantics></math></td>
<td id="S4.T1.5.2.4" class="ltx_td ltx_align_left ltx_border_t"><math id="S4.T1.m15" class="ltx_Math" alttext="\gamma_{t}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mi>t</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma_{t}\in(0,1)</annotation></semantics></math></td></tr>
<tr id="S4.T1.5.3" class="ltx_tr">
<th id="S4.T1.5.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row">GDN</th>
