<td id="S10.T11.6.1.4" class="ltx_td ltx_align_center ltx_border_tt"><span id="S10.T11.6.1.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">SFT (32B)</span></td></tr>
<tr id="S10.T11.6.2" class="ltx_tr">
