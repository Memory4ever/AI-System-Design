<td id="S9.T10.st1.5.2.2" class="ltx_td ltx_align_center ltx_border_t">1.04</td></tr>
<tr id="S9.T10.st1.5.3" class="ltx_tr">
<th id="S9.T10.st1.5.3.1" class="ltx_td ltx_align_right ltx_th ltx_th_row">32K</th>
<td id="S9.T10.st1.5.3.2" class="ltx_td ltx_align_center">1.23</td></tr>
<tr id="S9.T10.st1.5.4" class="ltx_tr">
<th id="S9.T10.st1.5.4.1" class="ltx_td ltx_align_right ltx_th ltx_th_row">64K</th>
<td id="S9.T10.st1.5.4.2" class="ltx_td ltx_align_center">1.29</td></tr>
<tr id="S9.T10.st1.5.5" class="ltx_tr">
<th id="S9.T10.st1.5.5.1" class="ltx_td ltx_align_right ltx_th ltx_th_row">128K</th>
<td id="S9.T10.st1.5.5.2" class="ltx_td ltx_align_center">1.35</td></tr>
<tr id="S9.T10.st1.5.6" class="ltx_tr">
<th id="S9.T10.st1.5.6.1" class="ltx_td ltx_align_right ltx_th ltx_th_row">256K</th>
<td id="S9.T10.st1.5.6.2" class="ltx_td ltx_align_center">1.37</td></tr>
