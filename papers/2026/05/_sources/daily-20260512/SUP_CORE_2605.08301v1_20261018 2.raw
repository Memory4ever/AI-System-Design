<td id="S10.T12.6.3.3" class="ltx_td ltx_align_center"><span id="S10.T12.6.3.3.1" class="ltx_text" style="font-size:90%;">10B/25B<sup id="S10.T12.6.3.3.1.1" class="ltx_sup"><math id="S10.T12.m1" class="ltx_Math" alttext="\dagger" display="inline" intent=":literal"><semantics><mo>†</mo><annotation encoding="application/x-tex">\dagger</annotation></semantics></math></sup></span></td>
