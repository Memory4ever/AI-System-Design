{"data":{"id":"10.48550/arxiv.2605.07463","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07463","prefix":"10.48550","suffix":"arxiv.2605.07463","identifiers":[{"identifier":"2605.07463","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.07463"}],"creators":[{"name":"He, Xin","nameType":"Personal","givenName":"Xin","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Jiao, Yuling","nameType":"Personal","givenName":"Yuling","familyName":"Jiao","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Xiliang","nameType":"Personal","givenName":"Xiliang","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Jerry Zhijian","nameType":"Personal","givenName":"Jerry Zhijian","familyName":"Yang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Approximation Error Upper and Lower Bounds for Hölder Class with Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T09:10:31Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:47:00Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-22T07:13:57Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-23T02:18:18Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"We explore the expressive power of Transformers by establishing precise approximation error upper and lower bounds for Hölder class. Specifically, a new approximation upper bound is derived for the standard Transformer architecture equipped with Softmax operators, ReLU activation functions, and residual connections. We prove that a Transformer network composed of at most $\\mathcal{O}(\\varepsilon^{-{d_{0}}/α})$ blocks can approximate any bounded Hölder function with $d_{0}$-dimensional input and smoothness $α\\in(0,1]$ under any accuracy $\\varepsilon\u0026gt;0$. In the case of approximation lower bounds, leveraging the VC-dimension upper bound, we are the first to rigorously prove that Transformers demand for at least $Ω(\\varepsilon^{-{d_{0}}/({4α})})$ blocks to achieve the $\\varepsilon$ approximation accuracy. As a final step, we extend the derived results for standard Transformers to a general regression task and establish the corresponding excess risk rates demonstrating Transformers' empirical effectiveness in real-world settings.","descriptionType":"Abstract"},{"description":"31 pages, 2 figures. Accepted by ICML2026","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07463","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:20:34.000Z","registered":"2026-05-11T02:20:35.000Z","published":"2026","updated":"2026-06-23T05:46:46.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07463","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}