<span id="A5.I5.i2.p1.1" class="ltx_p"><span id="A5.I5.i2.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving an input </span><math id="A5.I5.i2.p1.m1" class="ltx_Math" alttext="(RegisterAgent,sid,A,attr,Pwd,TA)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(RegisterAgent,sid,A,attr,Pwd,TA)</annotation></semantics></math><span id="A5.I5.i2.p1.1.2" class="ltx_text" style="font-size:80%;"> from party </span><math id="A5.I5.i2.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I5.i2.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I5.i2.p1.m3" class="ltx_Math" alttext="attr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">attr</annotation></semantics></math><span id="A5.I5.i2.p1.1.4" class="ltx_text" style="font-size:80%;"> is attribute of </span><math id="A5.I5.i2.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I5.i2.p1.1.5" class="ltx_text" style="font-size:80%;">, check that </span><math id="A5.I5.i2.p1.m5" class="ltx_Math" alttext="(TA,U,Pwd)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(TA,U,Pwd)</annotation></semantics></math><span id="A5.I5.i2.p1.1.6" class="ltx_text" style="font-size:80%;"> exists and hence </span><math id="A5.I5.i2.p1.m6" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I5.i2.p1.1.7" class="ltx_text" style="font-size:80%;"> is a registered user with </span><math id="A5.I5.i2.p1.m7" class="ltx_Math" alttext="TA" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><annotation encoding="application/x-tex">TA</annotation></semantics></math><span id="A5.I5.i2.p1.1.8" class="ltx_text" style="font-size:80%;">, also check that </span><math id="A5.I5.i2.p1.m8" class="ltx_Math" alttext="(U,A,attr)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(U,A,attr)</annotation></semantics></math><span id="A5.I5.i2.p1.1.9" class="ltx_text" style="font-size:80%;"> does not exist in the record, then send </span><math id="A5.I5.i2.p1.m9" class="ltx_Math" alttext="(RegisterAgent,sid,U,A)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800