<th id="S6.T2.6.1.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T2.6.1.5.1.1" class="ltx_text" style="font-size:90%;">Writing</span></th>
