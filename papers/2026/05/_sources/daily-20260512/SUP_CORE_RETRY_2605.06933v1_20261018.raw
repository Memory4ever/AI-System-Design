<span id="A5.I5.i3.p1" class="ltx_para">
<span id="A5.I5.i3.p1.1" class="ltx_p"><span id="A5.I5.i3.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving an input </span><math id="A5.I5.i3.p1.m1" class="ltx_Math" alttext="(AgentPolicy,sid,A,attr,CP_{A},Pwd,TA)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(AgentPolicy,sid,A,attr,CP_{A},Pwd,TA)</annotation></semantics></math><span id="A5.I5.i3.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I5.i3.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I5.i3.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I5.i3.p1.m3" class="ltx_Math" alttext="CP_{A}=\{[Send/Receive,A_{i},Budget_{i}]\}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><mo mathsize="0.800em">=</mo><mrow><mo stretchy="false">{</mo><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mrow><mrow><mi mathsize="0.800em">S</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true" symmetric="true">/</mo><mi mathsize="0.800em">R</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">v</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">B</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">i</mi></msub></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">CP_{A}=\{[Send/Receive,A_{i},Budget_{i}]\}</annotation></semantics></math><span id="A5.I5.i3.p1.1.4" class="ltx_text" style="font-size:80%;"> specifies the identity of agents who can contact with </span><math id="A5.I5.i3.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I5.i3.p1.1.5" class="ltx_text" style="font-size:80%;">, and the number of times each of those agents </span><math id="A5.I5.i3.p1.m5" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math><span id="A5.I5.i3.p1.1.6" class="ltx_text" style="font-size:80%;"> can contact </span><math id="A5.I5.i3.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I5.i3.p1.1.7" class="ltx_text" style="font-size:80%;">, i.e. </span><math id="A5.I5.i3.p1.m7" class="ltx_Math" alttext="Budget_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">B</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">Budget_{i}</annotation></semantics></math><span id="A5.I5.i3.p1.1.8" class="ltx_text" style="font-size:80%;">,
it checks whether the user is registered and </span><math id="A5.I5.i3.p1.m8" class="ltx_Math" alttext="(TA,U,Pwd)\in L_{UReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">U</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(TA,U,Pwd)\in L_{UReg}</annotation></semantics></math><span id="A5.I5.i3.p1.1.9" class="ltx_text" style="font-size:80%;">, checks whether </span><math id="A5.I5.i3.p1.m9" class="ltx_math_unparsed" alttext="(U,A,attr,\cdot,\cdot)\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">a</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">r</mi><mo mathsize="0.800em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo mathsize="0.800em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(U,A,attr,\cdot,\cdot)\in L_{AReg}</annotation></semantics></math><span id="A5.I5.i3.p1.1.10" class="ltx_text" style="font-size:80%;"> exists and hence </span><math id="A5.I5.i3.p1.m10" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I5.i3.p1.1.11" class="ltx_text" style="font-size:80%;"> is already registered.
Then send </span><math id="A5.I5.i3.p1.m11" class="ltx_Math" alttext="(AgentPolicy,sid,U)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">U</mi><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(AgentPolicy,sid,U)</annotation></semantics></math><span id="A5.I5.i3.p1.1.12" class="ltx_text" style="font-size:80%;"> to the adversary, and update </span><math id="A5.I5.i3.p1.m12" class="ltx_Math" alttext="(U,A,attr,CP_{A})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(U,A,attr,CP_{A})</annotation></semantics></math><span id="A5.I5.i3.p1.1.13" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I5.i3.p1.m13" class="ltx_Math" alttext="L_{AReg}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub><annotation encoding="application/x-tex">L_{AReg}</annotation></semantics></math><span id="A5.I5.i3.p1.1.14" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
</span>
</span><span id="A5.F15.3.1.2" class="ltx_text"></span></span></p>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A5.F15.4" class="ltx_text" style="font-size:90%;">Figure 15</span>. </span><span id="A5.F15.5" class="ltx_text" style="font-size:90%;">Secure user and agent registration ideal functionality <math id="A5.F15.m6" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Reg}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖱𝖾𝗀</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Reg}}</annotation></semantics></math></span><span id="acmlabel15" class="ltx_nodisplay ltx_acm_description">To avoid warning.</span></figcaption>
</figure>
</section>
<section id="A5.SS7" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.7. </span><math id="A5.SS7.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session Authorization Ideal Functionality <math id="A5.SS7.m2" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{A\text{-}auth}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>𝖠</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝖺𝗎𝗍𝗁</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{A\text{-}auth}}</annotation></semantics></math></h3>

<div id="A5.SS7.p1" class="ltx_para">
<p id="A5.SS7.p1.1" class="ltx_p">It is run between an agent <math id="A5.SS7.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math> and the Provider <math id="A5.SS7.p1.m2" class="ltx_Math" alttext="TA" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">TA</annotation></semantics></math>, and ensures that an agent is authorized (according to the user-defined policies <math id="A5.SS7.p1.m3" class="ltx_Math" alttext="CP_{A}" display="inline" intent=":literal"><semantics><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>A</mi></msub></mrow><annotation encoding="application/x-tex">CP_{A}</annotation></semantics></math>) to establish an <math id="A5.SS7.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session with another agent (see Figure <a href="#A5.F16" title='Figure 16 ‣ E.7. 𝐴-session Authorization Ideal Functionality ℱ_{𝖠⁢"-"⁢𝖺𝗎𝗍𝗁} ‣ Appendix E UC Model and Ideal Functionalities ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security' class="ltx_ref"><span class="ltx_text ltx_ref_tag">16</span></a>).</p>
</div>
<figure id="A5.F16" class="ltx_figure" aria-describedby="acmlabel16">
<p id="A5.F16.3" class="ltx_p"><span id="A5.F16.3.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:3.0pt;">

<span id="A5.F16.3.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
<span id="A5.F16.3.1.1.1" class="ltx_p ltx_align_center"><math id="A5.F16.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.F16.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">-session Authorization ideal functionality <math id="A5.F16.m2" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{A\text{-}auth}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>𝖠</mi><mo lspace="0em" rspace="0em">​</mo><mtext class="ltx_mathvariant_bold">-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝖺𝗎𝗍𝗁</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{A\text{-}auth}}</annotation></semantics></math></span><span id="A5.F16.3.1.1.1.2" class="ltx_text" style="font-size:80%;">,
holds a list </span><math id="A5.F16.m3" class="ltx_Math" alttext="L_{AReg}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub><annotation encoding="application/x-tex">L_{AReg}</annotation></semantics></math><span id="A5.F16.3.1.1.1.3" class="ltx_text" style="font-size:80%;"> containing the identity and attribute of the registered agents, and their contact policy </span><math id="A5.F16.m4" class="ltx_Math" alttext="CP_{A}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><annotation encoding="application/x-tex">CP_{A}</annotation></semantics></math><span id="A5.F16.3.1.1.1.4" class="ltx_text" style="font-size:80%;"> of all registered agents, and a counter </span><math id="A5.F16.m5" class="ltx_Math" alttext="CTR" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi></mrow><annotation encoding="application/x-tex">CTR</annotation></semantics></math><span id="A5.F16.3.1.1.1.5" class="ltx_text" style="font-size:80%;"> set that keeps the counter states for enforcing the budget.</span></span>
<span id="A5.I6" class="ltx_itemize ltx_centering">
<span id="A5.I6.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I6.i1.p1" class="ltx_para">
<span id="A5.I6.i1.p1.1" class="ltx_p"><span id="A5.I6.i1.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving an input </span><math id="A5.I6.i1.p1.m1" class="ltx_Math" alttext="(GetAuthorization,sid,A,attr,A^{\prime},attr^{\prime},TA)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">G</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(GetAuthorization,sid,A,attr,A^{\prime},attr^{\prime},TA)</annotation></semantics></math><span id="A5.I6.i1.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I6.i1.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I6.i1.p1.1.3" class="ltx_text" style="font-size:80%;">, the ideal functionality checks whether </span><math id="A5.I6.i1.p1.m3" class="ltx_Math" alttext="(A,attr)\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(A,attr)\in L_{AReg}</annotation></semantics></math><span id="A5.I6.i1.p1.1.4" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I6.i1.p1.m4" class="ltx_Math" alttext="(A^{\prime},attr^{\prime})\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(A^{\prime},attr^{\prime})\in L_{AReg}</annotation></semantics></math><span id="A5.I6.i1.p1.1.5" class="ltx_text" style="font-size:80%;">. It then retrieves </span><math id="A5.I6.i1.p1.m5" class="ltx_Math" alttext="CP_{A}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><annotation encoding="application/x-tex">CP_{A}</annotation></semantics></math><span id="A5.I6.i1.p1.1.6" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I6.i1.p1.m6" class="ltx_Math" alttext="CP_{A^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></msub></mrow><annotation encoding="application/x-tex">CP_{A^{\prime}}</annotation></semantics></math><span id="A5.I6.i1.p1.1.7" class="ltx_text" style="font-size:80%;"> and checks whether </span><math id="A5.I6.i1.p1.m7" class="ltx_Math" alttext="(A,A^{\prime})\in CP_{A}\cap CP_{A^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><mrow><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><mi mathsize="0.800em">A</mi></msub></mrow><mo mathsize="0.800em">∩</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">P</mi><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">(A,A^{\prime})\in CP_{A}\cap CP_{A^{\prime}}</annotation></semantics></math><span id="A5.I6.i1.p1.1.8" class="ltx_text" style="font-size:80%;">. If yes, it finds the counter </span><math id="A5.I6.i1.p1.m8" class="ltx_Math" alttext="ctr_{A,A^{\prime}}\in CTR" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><mo mathsize="0.800em">∈</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi></mrow></mrow><annotation encoding="application/x-tex">ctr_{A,A^{\prime}}\in CTR</annotation></semantics></math><span id="A5.I6.i1.p1.1.9" class="ltx_text" style="font-size:80%;"> which has ben initialized with </span><math id="A5.I6.i1.p1.m9" class="ltx_Math" alttext="B=min\{Budget_{A},Budget_{A^{\prime}}\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">B</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mi mathsize="0.800em">B</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">A</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">B</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">t</mi><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">B=min\{Budget_{A},Budget_{A^{\prime}}\}</annotation></semantics></math><span id="A5.I6.i1.p1.1.10" class="ltx_text" style="font-size:80%;"> the first time, and checks whether </span><math id="A5.I6.i1.p1.m10" class="ltx_Math" alttext="ctr_{A,A^{\prime}}\leq B" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><mo mathsize="0.800em">≤</mo><mi mathsize="0.800em">B</mi></mrow><annotation encoding="application/x-tex">ctr_{A,A^{\prime}}\leq B</annotation></semantics></math><span id="A5.I6.i1.p1.1.11" class="ltx_text" style="font-size:80%;">. If so, it decrements </span><math id="A5.I6.i1.p1.m11" class="ltx_Math" alttext="ctr_{A,A^{\prime}}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><annotation encoding="application/x-tex">ctr_{A,A^{\prime}}</annotation></semantics></math><span id="A5.I6.i1.p1.1.12" class="ltx_text" style="font-size:80%;"> by one, and sends </span><math id="A5.I6.i1.p1.m12" class="ltx_Math" alttext="(Allowed,sid,A,attr,A^{\prime},attr^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Allowed,sid,A,attr,A^{\prime},attr^{\prime})</annotation></semantics></math><span id="A5.I6.i1.p1.1.13" class="ltx_text" style="font-size:80%;"> to the agent </span><math id="A5.I6.i1.p1.m13" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I6.i1.p1.1.14" class="ltx_text" style="font-size:80%;">, the </span><math id="A5.I6.i1.p1.m14" class="ltx_Math" alttext="TA" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi></mrow><annotation encoding="application/x-tex">TA</annotation></semantics></math><span id="A5.I6.i1.p1.1.15" class="ltx_text" style="font-size:80%;">, and the adversary, and stores </span><math id="A5.I6.i1.p1.m15" class="ltx_Math" alttext="(Allowed,sid,A,attr,A^{\prime},attr^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Allowed,sid,A,attr,A^{\prime},attr^{\prime})</annotation></semantics></math><span id="A5.I6.i1.p1.1.16" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I6.i1.p1.m16" class="ltx_Math" alttext="L_{Auth}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub><annotation encoding="application/x-tex">L_{Auth}</annotation></semantics></math><span id="A5.I6.i1.p1.1.17" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
</span>
</span><span id="A5.F16.3.1.2" class="ltx_text"></span></span></p>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A5.F16.4" class="ltx_text" style="font-size:90%;">Figure 16</span>. </span><math id="A5.F16.m8" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.F16.5" class="ltx_text" style="font-size:90%;">-session Authorization ideal functionality <math id="A5.F16.m9" class="ltx_Math" alttext="F_{A\text{-}auth}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><mrow><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>h</mi></mrow></msub><annotation encoding="application/x-tex">F_{A\text{-}auth}</annotation></semantics></math></span><span id="acmlabel16" class="ltx_nodisplay ltx_acm_description">To avoid warning.</span></figcaption>
</figure>
</section>
<section id="A5.SS8" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.8. </span>Secure A-session Ideal Functionality <math id="A5.SS8.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math></h3>

<div id="A5.SS8.p1" class="ltx_para">
<p id="A5.SS8.p1.1" class="ltx_p">The secure <math id="A5.SS8.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session ideal functionality, shown in Figure <a href="#A5.F17" title="Figure 17 ‣ E.8. Secure A-session Ideal Functionality ℱ_𝖠𝗌𝖾𝗌 ‣ Appendix E UC Model and Ideal Functionalities ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security" class="ltx_ref"><span class="ltx_text ltx_ref_tag">17</span></a>, involves a
user and two agents, <math id="A5.SS8.p1.m2" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> and <math id="A5.SS8.p1.m3" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>. It captures the security requirements
of an <math id="A5.SS8.p1.m4" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session, including <span id="A5.SS8.p1.1.1" class="ltx_text ltx_font_italic">task-msg</span> confidentiality, participant authentication,
<span id="A5.SS8.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span> integrity, accountability, and policy enforcement with respect to
<span id="A5.SS8.p1.1.3" class="ltx_text ltx_font_italic">task-msg</span> and time budgets.
In this functionality, the users specify their agents’ policies, and the user of
<math id="A5.SS8.p1.m5" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> provides the task to be performed. <math id="A5.SS8.p1.m6" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> acts as the initiator and contacts <math id="A5.SS8.p1.m7" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math> multiple times to complete
the given task.</p>
</div>
<div id="A5.SS8.p2" class="ltx_para">
<p id="A5.SS8.p2.1" class="ltx_p">The task, in our model, determines when the session starts and when it
terminates. We model task execution as a stateful request-response computation
between the agents. The initiator-side algorithm <math id="A5.SS8.p2.m1" class="ltx_Math" alttext="\mathsf{ExeRes}" display="inline" intent=":literal"><semantics><mi>𝖤𝗑𝖾𝖱𝖾𝗌</mi><annotation encoding="application/x-tex">\mathsf{ExeRes}</annotation></semantics></math> takes the
task <math id="A5.SS8.p2.m2" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math>, the previous response, and the initiator’s code as input, and outputs
the next request. The responder-side algorithm <math id="A5.SS8.p2.m3" class="ltx_Math" alttext="\mathsf{ExeReq}" display="inline" intent=":literal"><semantics><mi>𝖤𝗑𝖾𝖱𝖾𝗊</mi><annotation encoding="application/x-tex">\mathsf{ExeReq}</annotation></semantics></math> takes a request
and the responder’s code as input, and outputs a response. The responder need
not know the underlying task <math id="A5.SS8.p2.m4" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math>.</p>
</div>
<div id="A5.SS8.p3" class="ltx_para">
<p id="A5.SS8.p3.1" class="ltx_p">The algorithm <math id="A5.SS8.p3.m1" class="ltx_Math" alttext="\mathsf{ExeReq}" display="inline" intent=":literal"><semantics><mi>𝖤𝗑𝖾𝖱𝖾𝗊</mi><annotation encoding="application/x-tex">\mathsf{ExeReq}</annotation></semantics></math> may itself be stateful and interactive: the
responding agent may interact with other agents before producing its response to
<math id="A5.SS8.p3.m2" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS8.p4" class="ltx_para">
<p id="A5.SS8.p4.1" class="ltx_p">The ideal functionality is parameterized by a leakage function <math id="A5.SS8.p4.m1" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math> on the
request/response transcript and the <span id="A5.SS8.p4.1.1" class="ltx_text ltx_font_italic">task-msg</span> and time budgets. If one agent is
corrupted, <math id="A5.SS8.p4.m2" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math> leaks the budgets fully, reflecting the policy information
exchanged during an <math id="A5.SS8.p4.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session. If both agents are honest, <math id="A5.SS8.p4.m4" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math> leaks only
unavoidable transcript metadata, such as message lengths and execution times.</p>
</div>
<div id="A5.SS8.p5" class="ltx_para">
<p id="A5.SS8.p5.1" class="ltx_p">The ideal functionality handles requests and responses internally, since the
number of rounds may depend on the task. When the initiator <math id="A5.SS8.p5.m1" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> is honest, the
adversary does not know the task; hence, without the ideal functionality running the task internally and suitable leakage the simulator
may be unable to reproduce the observable round structure of the real execution,
allowing the environment to distinguish the two worlds. Following the
internal simulation of rounds and leakage-based approach of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Eckey et al., 2020</a>; <a href="#bib.bib33" title="" class="ltx_ref">Avizheh et al., 2024</a>)</cite>,
the functionality simulates the task execution internally and therefore leaks specified metadata in each round, enabling the
simulator to match the observable transcript while preserving the intended
communication-security guarantees.</p>
</div>
<div id="A5.SS8.p6" class="ltx_para">
<p id="A5.SS8.p6.1" class="ltx_p"><math id="A5.SS8.p6.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> captures the stated security requirements as follows:</p>
<ul id="A5.I7" class="ltx_itemize">
<li id="A5.I7.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i1.p1" class="ltx_para">
<p id="A5.I7.i1.p1.1" class="ltx_p"><em id="A5.I7.i1.p1.1.1" class="ltx_emph ltx_font_italic">Confidentiality of task-msg.</em> If both agents are honest, the
adversary learns only the leakage about the requests and
responses, as defined by the leakage function <math id="A5.I7.i1.p1.m1" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math>.</p>
</div></li>
<li id="A5.I7.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i2.p1" class="ltx_para">
<p id="A5.I7.i2.p1.1" class="ltx_p"><em id="A5.I7.i2.p1.1.1" class="ltx_emph ltx_font_italic">Authentication.</em> Only registered and authorized agents can
participate in an <math id="A5.I7.i2.p1.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session; the adversary cannot impersonate an honest entity.</p>
</div></li>
<li id="A5.I7.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i3.p1" class="ltx_para">
<p id="A5.I7.i3.p1.1" class="ltx_p"><em id="A5.I7.i3.p1.1.1" class="ltx_emph ltx_font_italic">Integrity.</em> Requests and responses are simulated internally by <math id="A5.I7.i3.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> and cannot be modified, injected, replayed, or reordered by the adversary.</p>
</div></li>
<li id="A5.I7.i4" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i4.p1" class="ltx_para">
<p id="A5.I7.i4.p1.1" class="ltx_p"><em id="A5.I7.i4.p1.1.1" class="ltx_emph ltx_font_italic">Accountability.</em> If a corrupted party sends an invalid,
malformed, or policy-violating <span id="A5.I7.i4.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span>, <math id="A5.I7.i4.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> can identify the corrupted
party whose behavior causes an abort through the adversary, and attribute that to the corrupted party.</p>
</div></li>
<li id="A5.I7.i5" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A5.I7.i5.p1" class="ltx_para">
<p id="A5.I7.i5.p1.1" class="ltx_p"><em id="A5.I7.i5.p1.1.1" class="ltx_emph ltx_font_italic">Policy enforcement and authorization.</em> <math id="A5.I7.i5.p1.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> receives the two agents’ <math id="A5.I7.i5.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session policies, including their <span id="A5.I7.i5.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span> and time budgets, and enforces the effective
session policy obtained from their intersection. It maintains the relevant
counters and timers, and terminates the session once a budget is exhausted,
the time bound expires, or a corrupted party triggers an abort (capturing the early termination of session by a corrupted party).</p>
</div></li>
</ul>
<p id="A5.SS8.p6.2" class="ltx_p">The <span id="A5.SS8.p6.2.1" class="ltx_text ltx_font_italic">authorization soundness</span> in Section <a href="#S5" title="5. A Formalization of MAGIQ Properties ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a> is guaranteed by the composition of <math id="A5.SS8.p6.m2" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{A\text{-}auth}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mi>𝖠</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>𝖺𝗎𝗍𝗁</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{A\text{-}auth}}</annotation></semantics></math> and <math id="A5.SS8.p6.m3" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math>.</p>
</div>
<div id="A5.SS8.p7" class="ltx_para">
<p id="A5.SS8.p7.1" class="ltx_p">Note that our protocol also ensures <span id="A5.SS8.p7.1.1" class="ltx_text ltx_font_italic">Forward security</span> for an <math id="A5.SS8.p7.m1" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session  which means that
compromise of long-term credentials does not compromise previously established
<math id="A5.SS8.p7.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session keys. While our protocol provides this property, we leave modeling and proving this property for future work.</p>
</div>
<figure id="A5.F17" class="ltx_figure" aria-describedby="acmlabel17">
<p id="A5.F17.3" class="ltx_p"><span id="A5.F17.3.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:3.0pt;">

<span id="A5.F17.3.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
<span id="A5.F17.3.1.1.1" class="ltx_p ltx_align_center"><span id="A5.F17.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">The Secure A-session ideal functionality <math id="A5.F17.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math></span><span id="A5.F17.3.1.1.1.2" class="ltx_text" style="font-size:80%;">, is defined for a given task </span><math id="A5.F17.m2" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.F17.3.1.1.1.3" class="ltx_text" style="font-size:80%;">, and interacts with a global clock functionality </span><math id="A5.F17.m3" class="ltx_Math" alttext="\mathcal{G}_{\mathsf{clk}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">𝖼𝗅𝗄</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathsf{clk}}</annotation></semantics></math><span id="A5.F17.3.1.1.1.4" class="ltx_text" style="font-size:80%;">, and it is parametrized by a leakage function </span><math id="A5.F17.m4" class="ltx_Math" alttext="\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" rspace="0.278em">)</mo></mrow></mrow><mo mathsize="0.800em" rspace="0.278em">:</mo><mrow><mrow><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em">Q</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup></mrow><mo mathsize="0.800em" stretchy="false">→</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}</annotation></semantics></math><span id="A5.F17.3.1.1.1.5" class="ltx_text" style="font-size:80%;"> (note that </span><math id="A5.F17.m5" class="ltx_Math" alttext="sid" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><annotation encoding="application/x-tex">sid</annotation></semantics></math><span id="A5.F17.3.1.1.1.6" class="ltx_text" style="font-size:80%;"> includes </span><math id="A5.F17.m6" class="ltx_Math" alttext="\mathcal{G}_{h}(tsk)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">h</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{h}(tsk)</annotation></semantics></math><span id="A5.F17.3.1.1.1.7" class="ltx_text" style="font-size:80%;">).
</span><math id="A5.F17.m7" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">ℱ</mi><mi mathsize="0.800em">𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math><span id="A5.F17.3.1.1.1.8" class="ltx_text" style="font-size:80%;"> holds the list of registered agents </span><math id="A5.F17.m8" class="ltx_Math" alttext="L_{AReg}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub><annotation encoding="application/x-tex">L_{AReg}</annotation></semantics></math><span id="A5.F17.3.1.1.1.9" class="ltx_text" style="font-size:80%;"> and the list of agents that are authorized to establish an A-session </span><math id="A5.F17.m9" class="ltx_Math" alttext="L_{Auth}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub><annotation encoding="application/x-tex">L_{Auth}</annotation></semantics></math><span id="A5.F17.3.1.1.1.10" class="ltx_text" style="font-size:80%;">.</span></span>
<span id="A5.I8" class="ltx_itemize ltx_centering">
<span id="A5.I8.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I8.i1.p1" class="ltx_para">
<span id="A5.I8.i1.p1.1" class="ltx_p"><span id="A5.I8.i1.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving </span><math id="A5.I8.i1.p1.m1" class="ltx_Math" alttext="(AgentPolicy,sid,APolicy)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(AgentPolicy,sid,APolicy)</annotation></semantics></math><span id="A5.I8.i1.p1.1.2" class="ltx_text" style="font-size:80%;"> from the user </span><math id="A5.I8.i1.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I8.i1.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I8.i1.p1.m3" class="ltx_Math" alttext="Apolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">Apolicy</annotation></semantics></math><span id="A5.I8.i1.p1.1.4" class="ltx_text" style="font-size:80%;"> consists of the tuple of the form </span><math id="A5.I8.i1.p1.m4" class="ltx_Math" alttext="[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]</annotation></semantics></math><span id="A5.I8.i1.p1.1.5" class="ltx_text" style="font-size:80%;">, store </span><math id="A5.I8.i1.p1.m5" class="ltx_Math" alttext="(sid,APolicy)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(sid,APolicy)</annotation></semantics></math><span id="A5.I8.i1.p1.1.6" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I8.i1.p1.m6" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I8.i1.p1.1.7" class="ltx_text" style="font-size:80%;">. If </span><math id="A5.I8.i1.p1.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I8.i1.p1.1.8" class="ltx_text" style="font-size:80%;"> is corrupted and later it receives </span><math id="A5.I8.i1.p1.m8" class="ltx_Math" alttext="(ChangePolicy,sid,APolicy^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">y</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(ChangePolicy,sid,APolicy^{\prime})</annotation></semantics></math><span id="A5.I8.i1.p1.1.9" class="ltx_text" style="font-size:80%;"> from the adversary replace </span><math id="A5.I8.i1.p1.m9" class="ltx_Math" alttext="APolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">APolicy</annotation></semantics></math><span id="A5.I8.i1.p1.1.10" class="ltx_text" style="font-size:80%;"> with </span><math id="A5.I8.i1.p1.m10" class="ltx_Math" alttext="Apolicy^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">y</mi><mo mathsize="0.800em">′</mo></msup></mrow><annotation encoding="application/x-tex">Apolicy^{\prime}</annotation></semantics></math><span id="A5.I8.i1.p1.1.11" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I8.i1.p1.m11" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I8.i1.p1.1.12" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
<span id="A5.I8.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I8.i2.p1" class="ltx_para">
<span id="A5.I8.i2.p1.1" class="ltx_p"><span id="A5.I8.i2.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving a </span><math id="A5.I8.i2.p1.m1" class="ltx_Math" alttext="(Task,sid,tsk)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Task,sid,tsk)</annotation></semantics></math><span id="A5.I8.i2.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I8.i2.p1.m2" class="ltx_Math" alttext="(A_{I},attr_{I})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(A_{I},attr_{I})</annotation></semantics></math><span id="A5.I8.i2.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I8.i2.p1.m3" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.I8.i2.p1.1.4" class="ltx_text" style="font-size:80%;"> is given to agent </span><math id="A5.I8.i2.p1.m4" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.p1.1.5" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I8.i2.p1.m5" class="ltx_Math" alttext="attr_{I}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><annotation encoding="application/x-tex">attr_{I}</annotation></semantics></math><span id="A5.I8.i2.p1.1.6" class="ltx_text" style="font-size:80%;"> (if </span><math id="A5.I8.i2.p1.m6" class="ltx_Math" alttext="tsk=\perp" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.800em">⟂</mo></mrow><annotation encoding="application/x-tex">tsk=\perp</annotation></semantics></math><span id="A5.I8.i2.p1.1.7" class="ltx_text" style="font-size:80%;"> abort), it checks </span><math id="A5.I8.i2.p1.m7" class="ltx_Math" alttext="(A_{I},attr_{I})\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(A_{I},attr_{I})\in L_{AReg}</annotation></semantics></math><span id="A5.I8.i2.p1.1.8" class="ltx_text" style="font-size:80%;">, and stores </span><math id="A5.I8.i2.p1.m8" class="ltx_Math" alttext="(sid,tsk,A_{I},attr_{I})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(sid,tsk,A_{I},attr_{I})</annotation></semantics></math><span id="A5.I8.i2.p1.1.9" class="ltx_text" style="font-size:80%;">.
Then, run </span><math id="A5.I8.i2.p1.m9" class="ltx_math_unparsed" alttext="(A_{R},attr_{R},req_{1})\leftarrow ExeRes(A_{I},tsk,\perp)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">a</mi><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">t</mi><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">e</mi><msub><mi mathsize="0.800em">q</mi><mn mathsize="0.800em">1</mn></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em">E</mi><mi mathsize="0.800em">x</mi><mi mathsize="0.800em">e</mi><mi mathsize="0.800em">R</mi><mi mathsize="0.800em">e</mi><mi mathsize="0.800em">s</mi><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⟂</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(A_{R},attr_{R},req_{1})\leftarrow ExeRes(A_{I},tsk,\perp)</annotation></semantics></math><span id="A5.I8.i2.p1.1.10" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I8.i2.p1.m10" class="ltx_Math" alttext="Execute" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><annotation encoding="application/x-tex">Execute</annotation></semantics></math><span id="A5.I8.i2.p1.1.11" class="ltx_text" style="font-size:80%;"> runs the code of </span><math id="A5.I8.i2.p1.m11" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.p1.1.12" class="ltx_text" style="font-size:80%;"> on the given task </span><math id="A5.I8.i2.p1.m12" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.I8.i2.p1.1.13" class="ltx_text" style="font-size:80%;"> and outputs (i) the identity and attribute </span><math id="A5.I8.i2.p1.m13" class="ltx_Math" alttext="(A_{R},attr_{R})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(A_{R},attr_{R})</annotation></semantics></math><span id="A5.I8.i2.p1.1.14" class="ltx_text" style="font-size:80%;"> of the agent that </span><math id="A5.I8.i2.p1.m14" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.p1.1.15" class="ltx_text" style="font-size:80%;"> has to connect to, (ii) the first request to be sent from </span><math id="A5.I8.i2.p1.m15" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.p1.1.16" class="ltx_text" style="font-size:80%;"> denoted by </span><math id="A5.I8.i2.p1.m16" class="ltx_Math" alttext="req_{1}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mn mathsize="0.800em">1</mn></msub></mrow><annotation encoding="application/x-tex">req_{1}</annotation></semantics></math><span id="A5.I8.i2.p1.1.17" class="ltx_text" style="font-size:80%;">.
Then it checks </span><math id="A5.I8.i2.p1.m17" class="ltx_Math" alttext="(A_{R},attr_{R})\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(A_{R},attr_{R})\in L_{AReg}</annotation></semantics></math><span id="A5.I8.i2.p1.1.18" class="ltx_text" style="font-size:80%;">, if not aborts.
Next, retrieve and parse </span><math id="A5.I8.i2.p1.m18" class="ltx_Math" alttext="APolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">APolicy</annotation></semantics></math><span id="A5.I8.i2.p1.1.19" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I8.i2.p1.m19" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I8.i2.p1.1.20" class="ltx_text" style="font-size:80%;"> for both agents and retrieve </span><math id="A5.I8.i2.p1.m20" class="ltx_Math" alttext="[(A_{I},A_{R}),Q_{I},\Delta_{I}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A_{I},A_{R}),Q_{I},\Delta_{I}]</annotation></semantics></math><span id="A5.I8.i2.p1.1.21" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I8.i2.p1.m21" class="ltx_Math" alttext="[(A_{R},A_{I}),Q_{R},\Delta_{R}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A_{R},A_{I}),Q_{R},\Delta_{R}]</annotation></semantics></math><span id="A5.I8.i2.p1.1.22" class="ltx_text" style="font-size:80%;">. Then, set </span><math id="A5.I8.i2.p1.m22" class="ltx_Math" alttext="Q=min\{Q_{I},Q_{R}\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">Q</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">R</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">Q=min\{Q_{I},Q_{R}\}</annotation></semantics></math><span id="A5.I8.i2.p1.1.23" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I8.i2.p1.m23" class="ltx_Math" alttext="\Delta=min\{\Delta_{I},\Delta_{R}\}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">R</mi></msub><mo stretchy="false">}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\Delta=min\{\Delta_{I},\Delta_{R}\}</annotation></semantics></math><span id="A5.I8.i2.p1.1.24" class="ltx_text" style="font-size:80%;">. Next compute </span><math id="A5.I8.i2.p1.m24" class="ltx_Math" alttext="T_{exp}=\tau+\Delta" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">+</mo><mi mathsize="0.800em" mathvariant="normal">Δ</mi></mrow></mrow><annotation encoding="application/x-tex">T_{exp}=\tau+\Delta</annotation></semantics></math><span id="A5.I8.i2.p1.1.25" class="ltx_text" style="font-size:80%;">, and start a counter </span><math id="A5.I8.i2.p1.m25" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I8.i2.p1.1.26" class="ltx_text" style="font-size:80%;"> for interaction limit. Then,
simulates the task execution internally as below by starting with </span><span id="A5.I8.i2.p1.1.27" class="ltx_text ltx_font_italic" style="font-size:80%;">Request handling</span><span id="A5.I8.i2.p1.1.28" class="ltx_text" style="font-size:80%;"> where </span><math id="A5.I8.i2.p1.m26" class="ltx_Math" alttext="req_{0}=\perp" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mn mathsize="0.800em">0</mn></msub></mrow><mo mathsize="0.800em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.800em">⟂</mo></mrow><annotation encoding="application/x-tex">req_{0}=\perp</annotation></semantics></math><span id="A5.I8.i2.p1.1.29" class="ltx_text" style="font-size:80%;">:</span></span>
<span id="A5.I8.i2.I1" class="ltx_description">
<span id="A5.I8.i2.I1.ix1" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A5.I8.i2.I1.ix1.1" class="ltx_text ltx_font_bold">–Request handling:: </span></span></span>
<span class="ltx_item">
<span id="A5.I8.i2.I1.ix1.p1" class="ltx_para">
<span id="A5.I8.i2.I1.ix1.p1.1" class="ltx_p"><span id="A5.I8.i2.I1.ix1.p1.1.1" class="ltx_text" style="font-size:80%;">upon receiving </span><math id="A5.I8.i2.I1.ix1.p1.m1" class="ltx_Math" alttext="(Request,sid,A_{I},attr_{I},req_{i})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Request,sid,A_{I},attr_{I},req_{i})</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I8.i2.I1.ix1.p1.m2" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.3" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I8.i2.I1.ix1.p1.m3" class="ltx_Math" alttext="attr_{I}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><annotation encoding="application/x-tex">attr_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.4" class="ltx_text" style="font-size:80%;">, check </span><math id="A5.I8.i2.I1.ix1.p1.m4" class="ltx_Math" alttext="(AuthorizationAllowed,\cdot,A_{I},attr_{I},A_{R},attr_{R})\in L_{Auth}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(AuthorizationAllowed,\cdot,A_{I},attr_{I},A_{R},attr_{R})\in L_{Auth}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.5" class="ltx_text" style="font-size:80%;">; if so then
send </span><math id="A5.I8.i2.I1.ix1.p1.m5" class="ltx_Math" alttext="(ClockRead,sid)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(ClockRead,sid)</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.6" class="ltx_text" style="font-size:80%;"> to </span><math id="A5.I8.i2.I1.ix1.p1.m6" class="ltx_Math" alttext="\mathcal{G}_{\mathsf{clk}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">𝖼𝗅𝗄</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathsf{clk}}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.7" class="ltx_text" style="font-size:80%;"> and get the time </span><math id="A5.I8.i2.I1.ix1.p1.m7" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.8" class="ltx_text" style="font-size:80%;">.
Then check whether </span><math id="A5.I8.i2.I1.ix1.p1.m8" class="ltx_Math" alttext="ctr\leq Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">≤</mo><mi mathsize="0.800em">Q</mi></mrow><annotation encoding="application/x-tex">ctr\leq Q</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.9" class="ltx_text" style="font-size:80%;">, and increment </span><math id="A5.I8.i2.I1.ix1.p1.m9" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.10" class="ltx_text" style="font-size:80%;"> by one; Then, check </span><math id="A5.I8.i2.I1.ix1.p1.m10" class="ltx_Math" alttext="\tau\leq T_{exp}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">≤</mo><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tau\leq T_{exp}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.11" class="ltx_text" style="font-size:80%;">. If the checks do not pass, abort and inform the adversary. Otherwise, run </span><math id="A5.I8.i2.I1.ix1.p1.m11" class="ltx_Math" alttext="res_{i}\leftarrow ExeReq(A_{I},req_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">res_{i}\leftarrow ExeReq(A_{I},req_{i})</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.12" class="ltx_text" style="font-size:80%;">, and send </span><math id="A5.I8.i2.I1.ix1.p1.m12" class="ltx_Math" alttext="(Response,sid,A_{R},attr_{R},\ell(res_{i},Q_{R},\Delta_{R}))" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">R</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Response,sid,A_{R},attr_{R},\ell(res_{i},Q_{R},\Delta_{R}))</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.13" class="ltx_text" style="font-size:80%;"> to the adversary (if </span><math id="A5.I8.i2.I1.ix1.p1.m13" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.14" class="ltx_text" style="font-size:80%;"> or </span><math id="A5.I8.i2.I1.ix1.p1.m14" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.15" class="ltx_text" style="font-size:80%;"> is corrupted </span><math id="A5.I8.i2.I1.ix1.p1.m15" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.16" class="ltx_text" style="font-size:80%;"> leaks </span><math id="A5.I8.i2.I1.ix1.p1.m16" class="ltx_Math" alttext="Q_{R}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">Q_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.17" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I8.i2.I1.ix1.p1.m17" class="ltx_Math" alttext="\Delta_{R}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">\Delta_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix1.p1.1.18" class="ltx_text" style="font-size:80%;"> to the adversary). Upon receiving abort from the adversary, abort and output the identity of the corrupted agent, else proceed to </span><span id="A5.I8.i2.I1.ix1.p1.1.19" class="ltx_text ltx_font_italic" style="font-size:80%;">response handling</span><span id="A5.I8.i2.I1.ix1.p1.1.20" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
<span id="A5.I8.i2.I1.ix2" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A5.I8.i2.I1.ix2.1" class="ltx_text ltx_font_bold">–Response handling:: </span></span></span>
<span class="ltx_item">
<span id="A5.I8.i2.I1.ix2.p1" class="ltx_para">
<span id="A5.I8.i2.I1.ix2.p1.1" class="ltx_p"><span id="A5.I8.i2.I1.ix2.p1.1.1" class="ltx_text" style="font-size:80%;">upon receiving </span><math id="A5.I8.i2.I1.ix2.p1.m1" class="ltx_Math" alttext="(Response,sid,A_{R},attr_{R},res_{i})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Response,sid,A_{R},attr_{R},res_{i})</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I8.i2.I1.ix2.p1.m2" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.3" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I8.i2.I1.ix2.p1.m3" class="ltx_Math" alttext="attr_{R}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">R</mi></msub></mrow><annotation encoding="application/x-tex">attr_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.4" class="ltx_text" style="font-size:80%;">, check whether </span><math id="A5.I8.i2.I1.ix2.p1.m4" class="ltx_Math" alttext="ctr\leq Q" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">≤</mo><mi mathsize="0.800em">Q</mi></mrow><annotation encoding="application/x-tex">ctr\leq Q</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.5" class="ltx_text" style="font-size:80%;">, and increment </span><math id="A5.I8.i2.I1.ix2.p1.m5" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.6" class="ltx_text" style="font-size:80%;"> by one; Then, check </span><math id="A5.I8.i2.I1.ix2.p1.m6" class="ltx_Math" alttext="\tau\leq T_{exp}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">≤</mo><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tau\leq T_{exp}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.7" class="ltx_text" style="font-size:80%;">. If the checks do not pass, abort and inform the adversary. Otherwise, run </span><math id="A5.I8.i2.I1.ix2.p1.m7" class="ltx_Math" alttext="(req_{i},result)\leftarrow ExeRes(A_{R},tsk,res_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(req_{i},result)\leftarrow ExeRes(A_{R},tsk,res_{i})</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.8" class="ltx_text" style="font-size:80%;">. If </span><math id="A5.I8.i2.I1.ix2.p1.m8" class="ltx_Math" alttext="req_{i}=\perp" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.800em">⟂</mo></mrow><annotation encoding="application/x-tex">req_{i}=\perp</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.9" class="ltx_text" style="font-size:80%;">, then output </span><math id="A5.I8.i2.I1.ix2.p1.m9" class="ltx_Math" alttext="result" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><annotation encoding="application/x-tex">result</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.10" class="ltx_text" style="font-size:80%;"> and terminate. Else send </span><math id="A5.I8.i2.I1.ix2.p1.m10" class="ltx_Math" alttext="(Request,sid,A_{I},attr_{I},\ell(req_{i},Q_{I},\Delta_{I}))" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">I</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">I</mi></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">I</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Request,sid,A_{I},attr_{I},\ell(req_{i},Q_{I},\Delta_{I}))</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.11" class="ltx_text" style="font-size:80%;"> to adversary (if </span><math id="A5.I8.i2.I1.ix2.p1.m11" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.12" class="ltx_text" style="font-size:80%;"> or </span><math id="A5.I8.i2.I1.ix2.p1.m12" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.13" class="ltx_text" style="font-size:80%;"> is corrupted </span><math id="A5.I8.i2.I1.ix2.p1.m13" class="ltx_Math" alttext="\ell()" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\ell()</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.14" class="ltx_text" style="font-size:80%;"> leaks </span><math id="A5.I8.i2.I1.ix2.p1.m14" class="ltx_Math" alttext="Q_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">Q</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">Q_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.15" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I8.i2.I1.ix2.p1.m15" class="ltx_Math" alttext="\Delta_{I}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mi mathsize="0.800em">I</mi></msub><annotation encoding="application/x-tex">\Delta_{I}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.16" class="ltx_text" style="font-size:80%;"> to the adversary). Upon receiving </span><math id="A5.I8.i2.I1.ix2.p1.m16" class="ltx_Math" alttext="terminate" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">m</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><annotation encoding="application/x-tex">terminate</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.17" class="ltx_text" style="font-size:80%;"> from adversary, output </span><math id="A5.I8.i2.I1.ix2.p1.m17" class="ltx_Math" alttext="res_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">res_{i}</annotation></semantics></math><span id="A5.I8.i2.I1.ix2.p1.1.18" class="ltx_text" style="font-size:80%;"> and terminate. Upon receiving abort from the adversary, abort and output the identity of the corrupted agent, else proceed to </span><span id="A5.I8.i2.I1.ix2.p1.1.19" class="ltx_text ltx_font_italic" style="font-size:80%;">request handling</span><span id="A5.I8.i2.I1.ix2.p1.1.20" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
</span>
</span></span>
</span>
</span><span id="A5.F17.3.1.2" class="ltx_text"></span></span></p>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A5.F17.4" class="ltx_text" style="font-size:90%;">Figure 17</span>. </span><span id="A5.F17.5" class="ltx_text" style="font-size:90%;">The secure A-session ideal functionality, <math id="A5.F17.m11" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math></span><span id="acmlabel17" class="ltx_nodisplay ltx_acm_description">To avoid warning.</span></figcaption>
</figure>
</section>
<section id="A5.SS9" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.9. </span>The Secure Multi-Agent Composite Session (C-session) Ideal functionality, <math id="A5.SS9.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math> with Static Workflow</h3>

<div id="A5.SS9.p1" class="ltx_para">
<p id="A5.SS9.p1.1" class="ltx_p">This ideal functionality allows a user to give a task to an <span id="A5.SS9.p1.1.1" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS9.p1.m1" class="ltx_Math" alttext="A_{I}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A_{I}^{*}</annotation></semantics></math>, where <math id="A5.SS9.p1.m2" class="ltx_Math" alttext="A_{I}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A_{I}^{*}</annotation></semantics></math> contacts a set of responding agents <math id="A5.SS9.p1.m3" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> (according to a static work plan) to fulfill the task (see Figure <a href="#A5.F18" title="Figure 18 ‣ E.9. The Secure Multi-Agent Composite Session (C-session) Ideal functionality, ℱ_𝖢𝗌𝖾𝗌 with Static Workflow ‣ Appendix E UC Model and Ideal Functionalities ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security" class="ltx_ref"><span class="ltx_text ltx_ref_tag">18</span></a>). This ideal functionality ensures the security properties listed in <math id="A5.SS9.p1.m4" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> in a similar way but in the communication across mutiple responding agents (see description of <math id="A5.SS9.p1.m5" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math>). These properties are: <span id="A5.SS9.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span> confidentiality, participant authentication, <span id="A5.SS9.p1.1.3" class="ltx_text ltx_font_italic">task-msg</span> integrity, accountability, and policy enforcement with respect to <span id="A5.SS9.p1.1.4" class="ltx_text ltx_font_italic">task-msg</span> and time budgets of <math id="A5.SS9.p1.m6" class="ltx_Math" alttext="A_{I}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A_{I}^{*}</annotation></semantics></math> and the set of <math id="A5.SS9.p1.m7" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math>.
In <math id="A5.SS9.p1.m8" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math>  the users determine the policy for their agents at the beginning of the session. The agent policy is in the form of <math id="A5.SS9.p1.m9" class="ltx_Math" alttext="[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>Q</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]</annotation></semantics></math> and consists of the interaction budget <math id="A5.SS9.p1.m10" class="ltx_Math" alttext="Q_{A,A^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">Q_{A,A^{\prime}}</annotation></semantics></math> and time budget <math id="A5.SS9.p1.m11" class="ltx_Math" alttext="\Delta_{A,A^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\Delta_{A,A^{\prime}}</annotation></semantics></math>. <math id="A5.SS9.p1.m12" class="ltx_Math" alttext="[(A,\perp),Q_{tot},\Delta_{tot}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mo lspace="0em" rspace="0em">⟂</mo><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>Q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(A,\perp),Q_{tot},\Delta_{tot}]</annotation></semantics></math> represents the policy of <span id="A5.SS9.p1.1.5" class="ltx_text ltx_font_italic">orchestrator</span> agent (i.e., ICP).</p>
</div>
<div id="A5.SS9.p2" class="ltx_para">
<p id="A5.SS9.p2.1" class="ltx_p">We highlight three points in our model: (i) Similar to the A-session functionality, we model the task execution as a stateful interactive computation, in which <math id="A5.SS9.p2.m1" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> acts as initiator and contacts with other agents <math id="A5.SS9.p2.m2" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> several times in order to complete the given task. We only consider one-hop interactions, which means <math id="A5.SS9.p2.m3" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> runs <math id="A5.SS9.p2.m4" class="ltx_Math" alttext="ExeRes()" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeRes()</annotation></semantics></math>, and contact another agent <math id="A5.SS9.p2.m5" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> back and forth, but we do not model the case where <math id="A5.SS9.p2.m6" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> interacts with other agents to respond the requests from <math id="A5.SS9.p2.m7" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> as it makes it very complex for the analysis. Without loss of generality, we assume that the <math id="A5.SS9.p2.m8" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> uses the reactive function <math id="A5.SS9.p2.m9" class="ltx_Math" alttext="ExeReq()" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeReq()</annotation></semantics></math> to respond to a request. This function/ computation by itself is an stateful interactive function which allows <math id="A5.SS9.p2.m10" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> to interact with other agents and respond to <math id="A5.SS9.p2.m11" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> at the end. (ii) We consider a static workflow for task execution, where the <span id="A5.SS9.p2.1.1" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS9.p2.m12" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> first determines the <span id="A5.SS9.p2.1.2" class="ltx_text ltx_font_italic">schedule</span> consisting of the list of agents <math id="A5.SS9.p2.m13" class="ltx_Math" alttext="(A_{i},attr_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(A_{i},attr_{i})</annotation></semantics></math> that should be contacted based on the given task.
(iii) The ideal functionality simulates the handling of requests and responses internally since the number of requests and responses depend on the given task, and the adversary who has not corrupted the <span id="A5.SS9.p2.1.3" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS9.p2.m14" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> and does not know the task cannot simulate the number of rounds of requests and response and the agents who should be contacted with correctly. This will enable the environment to distinguish the ideal world from the real world. Therefore, we follow the approach of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Eckey et al., 2020</a>; <a href="#bib.bib33" title="" class="ltx_ref">Avizheh et al., 2024</a>)</cite> and consider that the ideal functionality simulate the request and response process internally, enforces the policy, and leak some information to the adversary. With this consideration, we only need to show that the simulator can simulate each round correctly even if only a negligible information is leaked to it.</p>
</div>
<figure id="A5.F18" class="ltx_figure" aria-describedby="acmlabel18">
<p id="A5.F18.3" class="ltx_p"><span id="A5.F18.3.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:3.0pt;">

<span id="A5.F18.3.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
<span id="A5.F18.3.1.1.1" class="ltx_p ltx_align_center"><span id="A5.F18.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">The secure multi-agent composite session (C-session) ideal functionality, <math id="A5.F18.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math></span><span id="A5.F18.3.1.1.1.2" class="ltx_text" style="font-size:80%;">, is defined for a task </span><math id="A5.F18.m2" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.F18.3.1.1.1.3" class="ltx_text" style="font-size:80%;"> and interacts with a global clock functionality </span><math id="A5.F18.m3" class="ltx_Math" alttext="\mathcal{G}_{\mathsf{clk}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">𝖼𝗅𝗄</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathsf{clk}}</annotation></semantics></math><span id="A5.F18.3.1.1.1.4" class="ltx_text" style="font-size:80%;">, and it is parametrized by a leakage function </span><math id="A5.F18.m4" class="ltx_Math" alttext="\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" rspace="0.278em">)</mo></mrow></mrow><mo mathsize="0.800em" rspace="0.278em">:</mo><mrow><mrow><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em">Q</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup></mrow><mo mathsize="0.800em" stretchy="false">→</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}</annotation></semantics></math><span id="A5.F18.3.1.1.1.5" class="ltx_text" style="font-size:80%;">. This ideal functionality has access to the list of registered agents </span><math id="A5.F18.m5" class="ltx_Math" alttext="L_{AReg}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub><annotation encoding="application/x-tex">L_{AReg}</annotation></semantics></math><span id="A5.F18.3.1.1.1.6" class="ltx_text" style="font-size:80%;">, and the list of agents that are authorized to establish an A-session </span><math id="A5.F18.m6" class="ltx_Math" alttext="L_{Auth}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub><annotation encoding="application/x-tex">L_{Auth}</annotation></semantics></math><span id="A5.F18.3.1.1.1.7" class="ltx_text" style="font-size:80%;">.</span></span>
<span id="A5.I9" class="ltx_itemize ltx_centering">
<span id="A5.I9.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I9.i1.p1" class="ltx_para">
<span id="A5.I9.i1.p1.1" class="ltx_p"><span id="A5.I9.i1.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving </span><math id="A5.I9.i1.p1.m1" class="ltx_Math" alttext="(AgentPolicy,sid,APolicy)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(AgentPolicy,sid,APolicy)</annotation></semantics></math><span id="A5.I9.i1.p1.1.2" class="ltx_text" style="font-size:80%;"> from the user </span><math id="A5.I9.i1.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I9.i1.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I9.i1.p1.m3" class="ltx_Math" alttext="Apolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">Apolicy</annotation></semantics></math><span id="A5.I9.i1.p1.1.4" class="ltx_text" style="font-size:80%;"> consists of the tuple of the form </span><math id="A5.I9.i1.p1.m4" class="ltx_Math" alttext="[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]</annotation></semantics></math><span id="A5.I9.i1.p1.1.5" class="ltx_text" style="font-size:80%;">, store </span><math id="A5.I9.i1.p1.m5" class="ltx_Math" alttext="(sid,APolicy)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(sid,APolicy)</annotation></semantics></math><span id="A5.I9.i1.p1.1.6" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I9.i1.p1.m6" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I9.i1.p1.1.7" class="ltx_text" style="font-size:80%;">. If </span><math id="A5.I9.i1.p1.m7" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math><span id="A5.I9.i1.p1.1.8" class="ltx_text" style="font-size:80%;"> is corrupted and later it receives </span><math id="A5.I9.i1.p1.m8" class="ltx_Math" alttext="(ChangePolicy,sid,APolicy^{\prime})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">y</mi><mo mathsize="0.800em">′</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(ChangePolicy,sid,APolicy^{\prime})</annotation></semantics></math><span id="A5.I9.i1.p1.1.9" class="ltx_text" style="font-size:80%;"> from the adversary replace </span><math id="A5.I9.i1.p1.m9" class="ltx_Math" alttext="APolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">APolicy</annotation></semantics></math><span id="A5.I9.i1.p1.1.10" class="ltx_text" style="font-size:80%;"> with </span><math id="A5.I9.i1.p1.m10" class="ltx_Math" alttext="Apolicy^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">y</mi><mo mathsize="0.800em">′</mo></msup></mrow><annotation encoding="application/x-tex">Apolicy^{\prime}</annotation></semantics></math><span id="A5.I9.i1.p1.1.11" class="ltx_text" style="font-size:80%;"> in </span><math id="A5.I9.i1.p1.m11" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I9.i1.p1.1.12" class="ltx_text" style="font-size:80%;">.</span></span>
