<td id="S6.T2.6.1.5.7" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S6.T2.6.1.5.7.1" class="ltx_text" style="font-size:90%;">N/A</span></td></tr>
