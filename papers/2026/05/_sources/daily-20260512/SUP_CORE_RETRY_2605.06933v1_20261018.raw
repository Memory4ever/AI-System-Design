<figure id="S6.F7.sf1" class="ltx_figure ltx_figure_panel ltx_align_center"><object type="image/svg+xml" data="2605.06933v1/amortised_proto_oh_a_anywhere.svg" id="S6.F7.sf1.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:476/318;" width="476" height="318"></object>
