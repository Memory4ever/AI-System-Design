<span id="A5.I9.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I9.i2.p1" class="ltx_para">
<span id="A5.I9.i2.p1.1" class="ltx_p"><span id="A5.I9.i2.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving </span><math id="A5.I9.i2.p1.m1" class="ltx_Math" alttext="(Task,sid,tsk,A^{*}_{I},attr^{*})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">∗</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Task,sid,tsk,A^{*}_{I},attr^{*})</annotation></semantics></math><span id="A5.I9.i2.p1.1.2" class="ltx_text" style="font-size:80%;"> from user </span><math id="A5.I9.i2.p1.m2" class="ltx_Math" alttext="U^{*}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">∗</mo></msup><annotation encoding="application/x-tex">U^{*}</annotation></semantics></math><span id="A5.I9.i2.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I9.i2.p1.m3" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.I9.i2.p1.1.4" class="ltx_text" style="font-size:80%;"> is the given task from user </span><math id="A5.I9.i2.p1.m4" class="ltx_Math" alttext="U^{*}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">∗</mo></msup><annotation encoding="application/x-tex">U^{*}</annotation></semantics></math><span id="A5.I9.i2.p1.1.5" class="ltx_text" style="font-size:80%;"> to </span><span id="A5.I9.i2.p1.1.6" class="ltx_text ltx_font_italic" style="font-size:80%;">orchestrator</span><span id="A5.I9.i2.p1.1.7" class="ltx_text" style="font-size:80%;"> agent </span><math id="A5.I9.i2.p1.m5" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math><span id="A5.I9.i2.p1.1.8" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I9.i2.p1.m6" class="ltx_Math" alttext="attr^{*}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">∗</mo></msup></mrow><annotation encoding="application/x-tex">attr^{*}</annotation></semantics></math><span id="A5.I9.i2.p1.1.9" class="ltx_text" style="font-size:80%;">, then store </span><math id="A5.I9.i2.p1.m7" class="ltx_Math" alttext="(sid,tsk,U^{*},A^{*}_{I},attr^{*})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">U</mi><mo mathsize="0.800em">∗</mo></msup><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">∗</mo></msup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(sid,tsk,U^{*},A^{*}_{I},attr^{*})</annotation></semantics></math><span id="A5.I9.i2.p1.1.10" class="ltx_text" style="font-size:80%;"> (if </span><math id="A5.I9.i2.p1.m8" class="ltx_Math" alttext="tsk=\perp" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.800em">⟂</mo></mrow><annotation encoding="application/x-tex">tsk=\perp</annotation></semantics></math><span id="A5.I9.i2.p1.1.11" class="ltx_text" style="font-size:80%;"> abort).
Next, run </span><math id="A5.I9.i2.p1.m9" class="ltx_math_unparsed" alttext="(schedule,req^{1}_{i})\leftarrow ExeRes(A^{*}_{I},tsk,\perp)" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">c</mi><mi mathsize="0.800em">h</mi><mi mathsize="0.800em">e</mi><mi mathsize="0.800em">d</mi><mi mathsize="0.800em">u</mi><mi mathsize="0.800em">l</mi><mi mathsize="0.800em">e</mi><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">e</mi><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi><mn mathsize="0.800em">1</mn></msubsup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mi mathsize="0.800em">E</mi><mi mathsize="0.800em">x</mi><mi mathsize="0.800em">e</mi><mi mathsize="0.800em">R</mi><mi mathsize="0.800em">e</mi><mi mathsize="0.800em">s</mi><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">t</mi><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⟂</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><annotation encoding="application/x-tex">(schedule,req^{1}_{i})\leftarrow ExeRes(A^{*}_{I},tsk,\perp)</annotation></semantics></math><span id="A5.I9.i2.p1.1.12" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I9.i2.p1.m10" class="ltx_Math" alttext="ExeRes" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi></mrow><annotation encoding="application/x-tex">ExeRes</annotation></semantics></math><span id="A5.I9.i2.p1.1.13" class="ltx_text" style="font-size:80%;"> runs the code of </span><math id="A5.I9.i2.p1.m11" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math><span id="A5.I9.i2.p1.1.14" class="ltx_text" style="font-size:80%;"> on the given task </span><math id="A5.I9.i2.p1.m12" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.I9.i2.p1.1.15" class="ltx_text" style="font-size:80%;"> and outputs the first request </span><math id="A5.I9.i2.p1.m13" class="ltx_Math" alttext="req^{1}_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi><mn mathsize="0.800em">1</mn></msubsup></mrow><annotation encoding="application/x-tex">req^{1}_{i}</annotation></semantics></math><span id="A5.I9.i2.p1.1.16" class="ltx_text" style="font-size:80%;"> and the schedule which consists of the identity </span><math id="A5.I9.i2.p1.m14" class="ltx_Math" alttext="[(A_{1},attr_{1}),\cdots,(A_{t},attr_{t})]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mn mathsize="0.800em">1</mn></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mn mathsize="0.800em">1</mn></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋯</mo><mo mathsize="0.800em">,</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">t</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">t</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A_{1},attr_{1}),\cdots,(A_{t},attr_{t})]</annotation></semantics></math><span id="A5.I9.i2.p1.1.17" class="ltx_text" style="font-size:80%;"> of all the agents that should be contacted with (and the order of invocation). Then, check whether </span><math id="A5.I9.i2.p1.m15" class="ltx_Math" alttext="(A_{i},attr_{i})\in L_{AReg}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(A_{i},attr_{i})\in L_{AReg}</annotation></semantics></math><span id="A5.I9.i2.p1.1.18" class="ltx_text" style="font-size:80%;"> </span><math id="A5.I9.i2.p1.m16" class="ltx_Math" alttext="\forall i" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.800em" rspace="0.167em">∀</mo><mi mathsize="0.800em">i</mi></mrow><annotation encoding="application/x-tex">\forall i</annotation></semantics></math><span id="A5.I9.i2.p1.1.19" class="ltx_text" style="font-size:80%;">, and retrieve and parse </span><math id="A5.I9.i2.p1.m17" class="ltx_Math" alttext="APolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">APolicy</annotation></semantics></math><span id="A5.I9.i2.p1.1.20" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I9.i2.p1.m18" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I9.i2.p1.1.21" class="ltx_text" style="font-size:80%;"> for </span><math id="A5.I9.i2.p1.m19" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math><span id="A5.I9.i2.p1.1.22" class="ltx_text" style="font-size:80%;">, that is, </span><math id="A5.I9.i2.p1.m20" class="ltx_Math" alttext="[(A^{*}_{I},\perp),Q_{tot},\Delta_{tot}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⟂</mo><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A^{*}_{I},\perp),Q_{tot},\Delta_{tot}]</annotation></semantics></math><span id="A5.I9.i2.p1.1.23" class="ltx_text" style="font-size:80%;">. Next compute </span><math id="A5.I9.i2.p1.m21" class="ltx_Math" alttext="T_{exp}=\tau+\Delta_{tot}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">T_{exp}=\tau+\Delta_{tot}</annotation></semantics></math><span id="A5.I9.i2.p1.1.24" class="ltx_text" style="font-size:80%;">. Also, start a counter </span><math id="A5.I9.i2.p1.m22" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I9.i2.p1.1.25" class="ltx_text" style="font-size:80%;"> for interaction limit.
It then simulates the task execution internally as below:</span></span>
<span id="A5.I9.i2.I1" class="ltx_description">
<span id="A5.I9.i2.I1.ix1" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A5.I9.i2.I1.ix1.1" class="ltx_text ltx_font_bold">–Request handling:: </span></span></span>
<span class="ltx_item">
<span id="A5.I9.i2.I1.ix1.p1" class="ltx_para">
<span id="A5.I9.i2.I1.ix1.p1.1" class="ltx_p"><span id="A5.I9.i2.I1.ix1.p1.1.1" class="ltx_text" style="font-size:80%;">upon receiving </span><math id="A5.I9.i2.I1.ix1.p1.m1" class="ltx_Math" alttext="(Request,sid,A_{i},req^{k}_{i})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Request,sid,A_{i},req^{k}_{i})</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I9.i2.I1.ix1.p1.m2" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.3" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I9.i2.I1.ix1.p1.m3" class="ltx_Math" alttext="attr^{*}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">∗</mo></msup></mrow><annotation encoding="application/x-tex">attr^{*}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.4" class="ltx_text" style="font-size:80%;">, check </span><math id="A5.I9.i2.I1.ix1.p1.m4" class="ltx_Math" alttext="(AuthorizationAllowed,\cdot,A^{*}_{I},attr^{*},A_{i},attr_{i})\in L_{Auth}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">z</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">w</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em" rspace="0em">,</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi mathsize="0.800em">r</mi><mo mathsize="0.800em">∗</mo></msup></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">∈</mo><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub></mrow><annotation encoding="application/x-tex">(AuthorizationAllowed,\cdot,A^{*}_{I},attr^{*},A_{i},attr_{i})\in L_{Auth}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.5" class="ltx_text" style="font-size:80%;">;
if so then
send </span><math id="A5.I9.i2.I1.ix1.p1.m5" class="ltx_Math" alttext="(ClockRead,sid)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">C</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(ClockRead,sid)</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.6" class="ltx_text" style="font-size:80%;"> to </span><math id="A5.I9.i2.I1.ix1.p1.m6" class="ltx_Math" alttext="\mathcal{G}_{\mathsf{clk}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">𝖼𝗅𝗄</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathsf{clk}}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.7" class="ltx_text" style="font-size:80%;"> and get the time </span><math id="A5.I9.i2.I1.ix1.p1.m7" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.8" class="ltx_text" style="font-size:80%;">. If this is the first time a request is received from </span><math id="A5.I9.i2.I1.ix1.p1.m8" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.9" class="ltx_text" style="font-size:80%;">, retrieve and parse </span><math id="A5.I9.i2.I1.ix1.p1.m9" class="ltx_Math" alttext="APolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">APolicy</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.10" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I9.i2.I1.ix1.p1.m10" class="ltx_Math" alttext="L_{APo}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi></mrow></msub><annotation encoding="application/x-tex">L_{APo}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.11" class="ltx_text" style="font-size:80%;"> for agent </span><math id="A5.I9.i2.I1.ix1.p1.m11" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.12" class="ltx_text" style="font-size:80%;"> and retrieve </span><math id="A5.I9.i2.I1.ix1.p1.m12" class="ltx_Math" alttext="[(A^{*}_{I},A_{i}),Q_{*,i},\Delta_{*,i}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A^{*}_{I},A_{i}),Q_{*,i},\Delta_{*,i}]</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.13" class="ltx_text" style="font-size:80%;">. Then, check </span><math id="A5.I9.i2.I1.ix1.p1.m13" class="ltx_Math" alttext="\Delta_{*,i}&lt;\Delta_{tot}" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub><mo mathsize="0.800em">&lt;</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\Delta_{*,i}&lt;\Delta_{tot}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.14" class="ltx_text" style="font-size:80%;"> and compute </span><math id="A5.I9.i2.I1.ix1.p1.m14" class="ltx_Math" alttext="T^{\prime}_{exp}=\tau+\Delta_{*,i}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em">=</mo><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">+</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">T^{\prime}_{exp}=\tau+\Delta_{*,i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.15" class="ltx_text" style="font-size:80%;">. Check that </span><math id="A5.I9.i2.I1.ix1.p1.m15" class="ltx_Math" alttext="T^{\prime}_{exp}&lt;T_{exp}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow><mo mathsize="0.800em">′</mo></msubsup><mo mathsize="0.800em">&lt;</mo><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">T^{\prime}_{exp}&lt;T_{exp}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.16" class="ltx_text" style="font-size:80%;"> and store </span><math id="A5.I9.i2.I1.ix1.p1.m16" class="ltx_Math" alttext="T^{\prime}_{exp}" display="inline" intent=":literal"><semantics><msubsup><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow><mo mathsize="0.800em">′</mo></msubsup><annotation encoding="application/x-tex">T^{\prime}_{exp}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.17" class="ltx_text" style="font-size:80%;">. Else, abort. Also, start a counter </span><math id="A5.I9.i2.I1.ix1.p1.m17" class="ltx_Math" alttext="ctr_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">ctr_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.18" class="ltx_text" style="font-size:80%;"> for interaction limit and increment both </span><math id="A5.I9.i2.I1.ix1.p1.m18" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.19" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I9.i2.I1.ix1.p1.m19" class="ltx_Math" alttext="ctr_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">ctr_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.20" class="ltx_text" style="font-size:80%;">.
Else, if this is not the first message, check whether </span><math id="A5.I9.i2.I1.ix1.p1.m20" class="ltx_Math" alttext="ctr_{i}\leq Q_{*,i}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><mo mathsize="0.800em">≤</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ctr_{i}\leq Q_{*,i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.21" class="ltx_text" style="font-size:80%;"> and </span><math id="A5.I9.i2.I1.ix1.p1.m21" class="ltx_Math" alttext="\tau&lt;T^{\prime}_{exp}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">&lt;</mo><msubsup><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow><mo mathsize="0.800em">′</mo></msubsup></mrow><annotation encoding="application/x-tex">\tau&lt;T^{\prime}_{exp}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.22" class="ltx_text" style="font-size:80%;">, and then increment </span><math id="A5.I9.i2.I1.ix1.p1.m22" class="ltx_Math" alttext="ctr_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">ctr_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.23" class="ltx_text" style="font-size:80%;"> by one.
If the checks do not pass, abort and inform the adversary. Otherwise, run </span><math id="A5.I9.i2.I1.ix1.p1.m23" class="ltx_Math" alttext="res^{k}_{i}\leftarrow ExeReq(A_{i},req^{k}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">res^{k}_{i}\leftarrow ExeReq(A_{i},req^{k}_{i})</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.24" class="ltx_text" style="font-size:80%;">, and send </span><math id="A5.I9.i2.I1.ix1.p1.m24" class="ltx_Math" alttext="(response,sid,A_{i},\ell(res^{k}_{i},Q_{*,i},\Delta_{*,i})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mo mathsize="0.800em" rspace="0em">∗</mo><mo mathsize="0.800em">,</mo><mi mathsize="0.800em">i</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow><annotation encoding="application/x-tex">(response,sid,A_{i},\ell(res^{k}_{i},Q_{*,i},\Delta_{*,i})</annotation></semantics></math><span id="A5.I9.i2.I1.ix1.p1.1.25" class="ltx_text" style="font-size:80%;"> to the adversary.
Upon receiving abort from the adversary, abort and output the identity of the corrupted agent, else proceed to </span><span id="A5.I9.i2.I1.ix1.p1.1.26" class="ltx_text ltx_font_italic" style="font-size:80%;">response handling</span><span id="A5.I9.i2.I1.ix1.p1.1.27" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
<span id="A5.I9.i2.I1.ix2" class="ltx_item"><span class="ltx_tag ltx_tag_item"><span id="A5.I9.i2.I1.ix2.1" class="ltx_text ltx_font_bold">–Response handling:: </span></span></span>
<span class="ltx_item">
<span id="A5.I9.i2.I1.ix2.p1" class="ltx_para">
<span id="A5.I9.i2.I1.ix2.p1.1" class="ltx_p"><span id="A5.I9.i2.I1.ix2.p1.1.1" class="ltx_text" style="font-size:80%;">upon receiving </span><math id="A5.I9.i2.I1.ix2.p1.m1" class="ltx_Math" alttext="(Response,sid,A^{*}_{I},res^{k}_{i})" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Response,sid,A^{*}_{I},res^{k}_{i})</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.2" class="ltx_text" style="font-size:80%;"> from </span><math id="A5.I9.i2.I1.ix2.p1.m2" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.3" class="ltx_text" style="font-size:80%;"> with attribute </span><math id="A5.I9.i2.I1.ix2.p1.m3" class="ltx_Math" alttext="attr_{i}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">i</mi></msub></mrow><annotation encoding="application/x-tex">attr_{i}</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.4" class="ltx_text" style="font-size:80%;">, check whether </span><math id="A5.I9.i2.I1.ix2.p1.m4" class="ltx_Math" alttext="ctr\leq Q_{tot}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><mo mathsize="0.800em">≤</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub></mrow><annotation encoding="application/x-tex">ctr\leq Q_{tot}</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.5" class="ltx_text" style="font-size:80%;">, and increment </span><math id="A5.I9.i2.I1.ix2.p1.m5" class="ltx_Math" alttext="ctr" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">r</mi></mrow><annotation encoding="application/x-tex">ctr</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.6" class="ltx_text" style="font-size:80%;"> by one; Then, check </span><math id="A5.I9.i2.I1.ix2.p1.m6" class="ltx_Math" alttext="\tau\leq T_{exp}" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">τ</mi><mo mathsize="0.800em">≤</mo><msub><mi mathsize="0.800em">T</mi><mrow><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\tau\leq T_{exp}</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.7" class="ltx_text" style="font-size:80%;">. If the checks do not pass, abort and inform the adversary. Otherwise, run </span><math id="A5.I9.i2.I1.ix2.p1.m7" class="ltx_Math" alttext="(A_{j},attr_{j},req^{k+1}_{j},result)\leftarrow ExeRes(A^{*}_{I},tsk,res^{k}_{i})" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">a</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi mathsize="0.800em">r</mi><mi mathsize="0.800em">j</mi></msub></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">j</mi><mrow><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></msubsup></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em" stretchy="false">←</mo><mrow><mi mathsize="0.800em">E</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">x</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><msubsup><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">I</mi><mo mathsize="0.800em">∗</mo></msubsup><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">s</mi><mi mathsize="0.800em">i</mi><mi mathsize="0.800em">k</mi></msubsup></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(A_{j},attr_{j},req^{k+1}_{j},result)\leftarrow ExeRes(A^{*}_{I},tsk,res^{k}_{i})</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.8" class="ltx_text" style="font-size:80%;">. If </span><math id="A5.I9.i2.I1.ix2.p1.m8" class="ltx_Math" alttext="A_{j}=\perp" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em" rspace="0em">=</mo><mo lspace="0em" mathsize="0.800em">⟂</mo></mrow><annotation encoding="application/x-tex">A_{j}=\perp</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.9" class="ltx_text" style="font-size:80%;">, then output </span><math id="A5.I9.i2.I1.ix2.p1.m9" class="ltx_Math" alttext="result" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><annotation encoding="application/x-tex">result</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.10" class="ltx_text" style="font-size:80%;"> and terminate. Else, send </span><math id="A5.I9.i2.I1.ix2.p1.m10" class="ltx_Math" alttext="(Request,sid,A_{j},\ell(req^{k+1}_{j},Q_{tot},\Delta_{tot}))" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">q</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">A</mi><mi mathsize="0.800em">j</mi></msub><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">r</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathsize="0.800em">q</mi><mi mathsize="0.800em">j</mi><mrow><mi mathsize="0.800em">k</mi><mo mathsize="0.800em">+</mo><mn mathsize="0.800em">1</mn></mrow></msubsup></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi></mrow></msub><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(Request,sid,A_{j},\ell(req^{k+1}_{j},Q_{tot},\Delta_{tot}))</annotation></semantics></math><span id="A5.I9.i2.I1.ix2.p1.1.11" class="ltx_text" style="font-size:80%;"> to adversary. Upon receiving abort from the adversary abort and output the identity of the corrupted agent, else proceed to </span><span id="A5.I9.i2.I1.ix2.p1.1.12" class="ltx_text ltx_font_italic" style="font-size:80%;">response handling</span><span id="A5.I9.i2.I1.ix2.p1.1.13" class="ltx_text" style="font-size:80%;">.</span></span>
</span></span>
</span>
</span></span>
</span>
</span><span id="A5.F18.3.1.2" class="ltx_text"></span></span></p>
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_figure"><span id="A5.F18.4" class="ltx_text" style="font-size:90%;">Figure 18</span>. </span><span id="A5.F18.5" class="ltx_text" style="font-size:90%;">The secure multi-agent composite session (C-session) ideal functionality, <math id="A5.F18.m8" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math> with static workflow</span><span id="acmlabel18" class="ltx_nodisplay ltx_acm_description">To avoid warning.</span></figcaption>
</figure>
</section>
<section id="A5.SS10" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.10. </span>The Secure Multi-agent Composite Session (C-session) Ideal Functionality, <math id="A5.SS10.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math> with Dynamic Workflow</h3>

<div id="A5.SS10.p1" class="ltx_para">
<p id="A5.SS10.p1.1" class="ltx_p">This ideal functionality allows the users to determine the policy for their agents, where the agent policy is in the form of <math id="A5.SS10.p1.m1" class="ltx_Math" alttext="[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>Q</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]</annotation></semantics></math> and consists of the interaction budget <math id="A5.SS10.p1.m2" class="ltx_Math" alttext="Q_{A,A^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>Q</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">Q_{A,A^{\prime}}</annotation></semantics></math> and time budget <math id="A5.SS10.p1.m3" class="ltx_Math" alttext="\Delta_{A,A^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">Δ</mi><mrow><mi>A</mi><mo>,</mo><msup><mi>A</mi><mo>′</mo></msup></mrow></msub><annotation encoding="application/x-tex">\Delta_{A,A^{\prime}}</annotation></semantics></math>. The policy <math id="A5.SS10.p1.m4" class="ltx_Math" alttext="[(A,\perp),Q_{tot},\Delta_{tot}]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mi>A</mi><mo>,</mo><mo lspace="0em" rspace="0em">⟂</mo><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>Q</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub><mo>,</mo><msub><mi mathvariant="normal">Δ</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[(A,\perp),Q_{tot},\Delta_{tot}]</annotation></semantics></math> represents the policy of a <span id="A5.SS10.p1.1.1" class="ltx_text ltx_font_italic">orchestrator</span> agent (i.e., ICP). <math id="A5.SS10.p1.m5" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math>ensures: <span id="A5.SS10.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span> confidentiality, participant authentication, <span id="A5.SS10.p1.1.3" class="ltx_text ltx_font_italic">task-msg</span> integrity, accountability, and policy enforcement with respect to <span id="A5.SS10.p1.1.4" class="ltx_text ltx_font_italic">task-msg</span> and time budgets of <math id="A5.SS10.p1.m6" class="ltx_Math" alttext="A_{I}^{*}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A_{I}^{*}</annotation></semantics></math> and the set of <math id="A5.SS10.p1.m7" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math>, across multiple agents. It ensures these security properties in a similar way described in <math id="A5.SS10.p1.m8" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math> but in the communication across many responding agents (see description of <math id="A5.SS10.p1.m9" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Ases}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖠𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Ases}}</annotation></semantics></math>).</p>
</div>
<div id="A5.SS10.p2" class="ltx_para">
<p id="A5.SS10.p2.1" class="ltx_p">In <math id="A5.SS10.p2.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math>, a user gives a task <math id="A5.SS10.p2.m2" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math> to an <span id="A5.SS10.p2.1.1" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS10.p2.m3" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> with attribute <math id="A5.SS10.p2.m4" class="ltx_Math" alttext="attr^{*}" display="inline" intent=":literal"><semantics><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>r</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">attr^{*}</annotation></semantics></math> which orchestrates the communication with other agents (see Figure <a href="#A5.F19" title="Figure 19 ‣ E.10. The Secure Multi-agent Composite Session (C-session) Ideal Functionality, ℱ_𝖢𝗌𝖾𝗌 with Dynamic Workflow ‣ Appendix E UC Model and Ideal Functionalities ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security" class="ltx_ref"><span class="ltx_text ltx_ref_tag">19</span></a>). The <span id="A5.SS10.p2.1.2" class="ltx_text ltx_font_italic">orchestrator</span> agent can be corrupted in which case there is no guarantee that it performs the task correctly (we allow the adversary to replace the task which affects the order of agent calls and the requests it makes, and also to replace the result with adversarial ones). If the <span id="A5.SS10.p2.1.3" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS10.p2.m5" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> is honest, the ideal functionality execute the task in a trusted way, which means that it first gets identity of the first agent that needs to be called and the first request by running the reactive function <math id="A5.SS10.p2.m6" class="ltx_math_unparsed" alttext="ExeRes(A^{*}_{I},tsk,\perp)" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mi>x</mi><mi>e</mi><mi>R</mi><mi>e</mi><mi>s</mi><mrow><mo stretchy="false">(</mo><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><mo>,</mo><mi>t</mi><mi>s</mi><mi>k</mi><mo>,</mo><mo lspace="0em" rspace="0em">⟂</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeRes(A^{*}_{I},tsk,\perp)</annotation></semantics></math> on the given task <math id="A5.SS10.p2.m7" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math> using the code of the agent <math id="A5.SS10.p2.m8" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math>. It, then, internally simulates the request sending and receiving of the agents, and leaks some information about each request and response to the adversary. We also let the adversary to terminate the request and response handling to capture the fact that in case the interacting agents are corrupted they may abort earlier and then no results will be returned to the user.</p>
</div>
<div id="A5.SS10.p3" class="ltx_para">
<p id="A5.SS10.p3.1" class="ltx_p">Note that we need to clarify three points: (i) We model the task execution as an stateful interactive computation, in which <math id="A5.SS10.p3.m1" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> acts as initiator and contacts with other agents <math id="A5.SS10.p3.m2" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> several times in order to complete the given task. We only consider one-hop interactions, which means <math id="A5.SS10.p3.m3" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> runs <math id="A5.SS10.p3.m4" class="ltx_Math" alttext="ExeRes()" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeRes()</annotation></semantics></math>, and contact another agent <math id="A5.SS10.p3.m5" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> back and forth, but we do not model the case where <math id="A5.SS10.p3.m6" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> interacts with other agents to respond the requests from <math id="A5.SS10.p3.m7" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> as it makes it very complex for the analysis. Without loss of generality, we assume that the <math id="A5.SS10.p3.m8" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> uses the reactive function <math id="A5.SS10.p3.m9" class="ltx_Math" alttext="ExeReq()" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>q</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeReq()</annotation></semantics></math> to respond to a request. This function/ computation by itself in an stateful interactive function which allows <math id="A5.SS10.p3.m10" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math> to interact with other agents and respond to <math id="A5.SS10.p3.m11" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> at the end. (ii) We consider a dynamic workflow for task execution, where the <span id="A5.SS10.p3.1.1" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS10.p3.m12" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> first determines the first contacting agent <math id="A5.SS10.p3.m13" class="ltx_Math" alttext="(A_{i},attr_{i})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>A</mi><mi>i</mi></msub><mo>,</mo><mrow><mi>a</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>i</mi></msub></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(A_{i},attr_{i})</annotation></semantics></math> based on the given task and then based on the responses that it receives from this agent it decides the next agent that should be contacted. Therefore, we consider that <math id="A5.SS10.p3.m14" class="ltx_Math" alttext="ExeRes()" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo lspace="0em" rspace="0em">​</mo><mi>x</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>R</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">ExeRes()</annotation></semantics></math> always output an identity and the next request. (iii) The ideal functionality simulates the handling of requests and responses internally since the number of requests and responses depend on the given task, and the adversary who has not corrupted the <span id="A5.SS10.p3.1.2" class="ltx_text ltx_font_italic">orchestrator</span> agent <math id="A5.SS10.p3.m15" class="ltx_Math" alttext="A^{*}_{I}" display="inline" intent=":literal"><semantics><msubsup><mi>A</mi><mi>I</mi><mo>∗</mo></msubsup><annotation encoding="application/x-tex">A^{*}_{I}</annotation></semantics></math> and does not know the task cannot simulate the number of rounds of requests and response and the agents who should be contacted with correctly. This will enable the environment to distinguish the ideal world from the real world. Therefore, we follow the approach of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib32" title="" class="ltx_ref">Eckey et al., 2020</a>; <a href="#bib.bib33" title="" class="ltx_ref">Avizheh et al., 2024</a>)</cite> and consider that the ideal functionality simulate the request and response process internally, enforces the policy, and leak some information to the adversary. With this consideration, we only need to show that the simulator can simulate each round correctly even if only a negligible information is leaked to it.</p>
</div>
<figure id="A5.F19" class="ltx_figure" aria-describedby="acmlabel19">
<p id="A5.F19.3" class="ltx_p"><span id="A5.F19.3.1" class="ltx_text ltx_framed ltx_framed_rectangle" style="--ltx-border-color:#000000;padding:3.0pt;">

<span id="A5.F19.3.1.1" class="ltx_inline-block ltx_minipage ltx_align_middle" style="width:345.0pt;">
<span id="A5.F19.3.1.1.1" class="ltx_p ltx_align_center"><span id="A5.F19.3.1.1.1.1" class="ltx_text ltx_font_bold" style="font-size:80%;">The secure multi-agent composite session (C-session) ideal functionality, <math id="A5.F19.m1" class="ltx_Math" alttext="\mathcal{F}_{\mathsf{Cses}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℱ</mi><mi>𝖢𝗌𝖾𝗌</mi></msub><annotation encoding="application/x-tex">\mathcal{F}_{\mathsf{Cses}}</annotation></semantics></math></span><span id="A5.F19.3.1.1.1.2" class="ltx_text" style="font-size:80%;">, is defined for a task </span><math id="A5.F19.m2" class="ltx_Math" alttext="tsk" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">k</mi></mrow><annotation encoding="application/x-tex">tsk</annotation></semantics></math><span id="A5.F19.3.1.1.1.3" class="ltx_text" style="font-size:80%;"> and interacts with a global clock functionality </span><math id="A5.F19.m3" class="ltx_Math" alttext="\mathcal{G}_{\mathsf{clk}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic" mathsize="0.800em">𝒢</mi><mi mathsize="0.800em">𝖼𝗅𝗄</mi></msub><annotation encoding="application/x-tex">\mathcal{G}_{\mathsf{clk}}</annotation></semantics></math><span id="A5.F19.3.1.1.1.4" class="ltx_text" style="font-size:80%;">, and it is parametrized by a leakage function </span><math id="A5.F19.m4" class="ltx_Math" alttext="\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi mathsize="0.800em" mathvariant="normal">ℓ</mi><mo>⁡</mo><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mo lspace="0em" mathsize="0.800em" rspace="0em">⋅</mo><mo maxsize="0.800em" minsize="0.800em" rspace="0.278em">)</mo></mrow></mrow><mo mathsize="0.800em" rspace="0.278em">:</mo><mrow><mrow><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo rspace="0.055em" stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em">Q</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup><mo mathsize="0.800em" rspace="0.222em">×</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mo maxsize="0.800em" minsize="0.800em" stretchy="true">|</mo></mrow></msup></mrow><mo mathsize="0.800em" stretchy="false">→</mo><msup><mrow><mo stretchy="false">{</mo><mn mathsize="0.800em">0</mn><mo mathsize="0.800em">,</mo><mn mathsize="0.800em">1</mn><mo stretchy="false">}</mo></mrow><mo mathsize="0.800em">∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\ell(\cdot):\{0,1\}^{*}\times\{0,1\}^{|Q|}\times\{0,1\}^{|\Delta|}\rightarrow\{0,1\}^{*}</annotation></semantics></math><span id="A5.F19.3.1.1.1.5" class="ltx_text" style="font-size:80%;">. This ideal functionality has access to the list of registered agents </span><math id="A5.F19.m5" class="ltx_Math" alttext="L_{AReg}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">R</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi></mrow></msub><annotation encoding="application/x-tex">L_{AReg}</annotation></semantics></math><span id="A5.F19.3.1.1.1.6" class="ltx_text" style="font-size:80%;">, and the list of agents that are authorized to establish an A-session </span><math id="A5.F19.m6" class="ltx_Math" alttext="L_{Auth}" display="inline" intent=":literal"><semantics><msub><mi mathsize="0.800em">L</mi><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">u</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">h</mi></mrow></msub><annotation encoding="application/x-tex">L_{Auth}</annotation></semantics></math><span id="A5.F19.3.1.1.1.7" class="ltx_text" style="font-size:80%;">.</span></span>
<span id="A5.I10" class="ltx_itemize ltx_centering">
<span id="A5.I10.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<span id="A5.I10.i1.p1" class="ltx_para">
<span id="A5.I10.i1.p1.1" class="ltx_p"><span id="A5.I10.i1.p1.1.1" class="ltx_text" style="font-size:80%;">Upon receiving </span><math id="A5.I10.i1.p1.m1" class="ltx_Math" alttext="(AgentPolicy,sid,APolicy)" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">g</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">e</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">n</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">t</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">s</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">d</mi></mrow><mo mathsize="0.800em">,</mo><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">P</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><annotation encoding="application/x-tex">(AgentPolicy,sid,APolicy)</annotation></semantics></math><span id="A5.I10.i1.p1.1.2" class="ltx_text" style="font-size:80%;"> from the user </span><math id="A5.I10.i1.p1.m2" class="ltx_Math" alttext="U" display="inline" intent=":literal"><semantics><mi mathsize="0.800em">U</mi><annotation encoding="application/x-tex">U</annotation></semantics></math><span id="A5.I10.i1.p1.1.3" class="ltx_text" style="font-size:80%;">, where </span><math id="A5.I10.i1.p1.m3" class="ltx_Math" alttext="Apolicy" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.800em">A</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">p</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">o</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">l</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">i</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">c</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.800em">y</mi></mrow><annotation encoding="application/x-tex">Apolicy</annotation></semantics></math><span id="A5.I10.i1.p1.1.4" class="ltx_text" style="font-size:80%;"> consists of the tuple of the form </span><math id="A5.I10.i1.p1.m4" class="ltx_Math" alttext="[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]" display="inline" intent=":literal"><semantics><mrow><mo maxsize="0.800em" minsize="0.800em">[</mo><mrow><mrow><mo maxsize="0.800em" minsize="0.800em">(</mo><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup><mo maxsize="0.800em" minsize="0.800em">)</mo></mrow><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em">Q</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub><mo mathsize="0.800em">,</mo><msub><mi mathsize="0.800em" mathvariant="normal">Δ</mi><mrow><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">,</mo><msup><mi mathsize="0.800em">A</mi><mo mathsize="0.800em">′</mo></msup></mrow></msub></mrow><mo maxsize="0.800em" minsize="0.800em">]</mo></mrow><annotation encoding="application/x-tex">[(A,A^{\prime}),Q_{A,A^{\prime}},\Delta_{A,A^{\prime}}]</annotation></semantics></m