</g></g></g><g stroke-width="0.4pt"><path style="fill:none" d="M 366.51 -288.19 L 398.01 -288.19 L 398.01 -295.98 L 372.37 -295.98"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 372.37 -295.98)"><path d="M -6.06 3.74 L 0.42 0 L -6.06 -3.74 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 379.28 -279.84)"><foreignObject style="--ltx-fo-width:4.88em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="67.5"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m12" class="ltx_Math" alttext="HS.Sign()" display="inline" intent=":literal"><semantics><mrow><mrow><mi>H</mi><mo lspace="0em" rspace="0em">​</mo><mi>S</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">HS.Sign()</annotation></semantics></math></span></span></foreignObject></g><path style="fill:none" d="M 48.75 -359.06 L 519.58 -359.06"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(1.0 0.0 0.0 1.0 519.58 -359.06)"><path d="M -6.06 3.74 L 0.42 0 L -6.06 -3.74 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 124.05 -350.71)"><foreignObject style="--ltx-fo-width:23.21em;--ltx-fo-height:0.85em;--ltx-fo-depth:0.25em;font-size:10pt;" height="15.21" overflow="visible" transform="matrix(1 0 0 -1 0 11.75)" width="321.19"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m13" class="ltx_Math" alttext="(M_{A},sk^{tls}_{A},sk_{A},CP_{A},\sigma^{U}_{ID},\sigma^{U}_{A},uid_{U},Cert^{ID}_{TA},cert^{ID}_{U})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>M</mi><mi>A</mi></msub><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>A</mi><mrow><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>l</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></msubsup></mrow><mo>,</mo><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>A</mi></msub></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>A</mi></msub></mrow><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><mi>U</mi></msubsup><mo>,</mo><msubsup><mi>σ</mi><mi>A</mi><mi>U</mi></msubsup><mo>,</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>U</mi></msub></mrow><mo>,</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mrow><mi>T</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup></mrow><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>t</mi><mi>U</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(M_{A},sk^{tls}_{A},sk_{A},CP_{A},\sigma^{U}_{ID},\sigma^{U}_{A},uid_{U},Cert^{ID}_{TA},cert^{ID}_{U})</annotation></semantics></math></span></span></foreignObject></g><g stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path style="fill:none" d="M 520.54 -406.3 L 49.58 -406.3"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linecap="round" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 49.58 -406.3)"><path style="fill:none" d="M -4.04 2.49 L 0.28 0 L -4.04 -2.49"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 255.82 -398.72)"><foreignObject style="--ltx-fo-width:4.17em;--ltx-fo-height:0.69em;--ltx-fo-depth:0.19em;font-size:10pt;" height="12.3" overflow="visible" transform="matrix(1 0 0 -1 0 9.61)" width="57.65"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><span id="S4.F3.pic1.13" class="ltx_text">Complete</span></span></span></foreignObject></g></g></g><g stroke-width="0.4pt"><path style="fill:none" d="M 542.13 -382.68 L 573.63 -382.68 L 573.63 -390.47 L 547.99 -390.47"></path><g stroke-dasharray="none" stroke-dashoffset="0.0pt" stroke-linejoin="miter" transform="matrix(-1.0 0.0 0.0 -1.0 547.99 -390.47)"><path d="M -6.06 3.74 L 0.42 0 L -6.06 -3.74 Z"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" transform="matrix(1.0 0.0 0.0 1.0 554.9 -374.33)"><foreignObject style="--ltx-fo-width:3.24em;--ltx-fo-height:0.75em;--ltx-fo-depth:0.25em;font-size:10pt;" height="13.84" overflow="visible" transform="matrix(1 0 0 -1 0 10.38)" width="44.82"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="S4.F3.pic1.m14" class="ltx_Math" alttext="Store()" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi><mo lspace="0em" rspace="0em">​</mo><mi>o</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Store()</annotation></semantics></math></span></span></foreignObject></g></g></g></svg></span>
</span></div>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="S4.F3.4" class="ltx_text" style="font-size:90%;">Figure 3</span>. </span><span id="S4.F3.5" class="ltx_text" style="font-size:90%;">Agent registration</span><span id="acmlabel3" class="ltx_acm_description ltx_centering ltx_nodisplay">To avoid warning.</span></figcaption>
</figure>
</section>
<section id="S4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">4.4. </span>Agent-to-Agent Intercommunication</h3>

<div id="S4.SS4.p1" class="ltx_para">
<p id="S4.SS4.p1.1" class="ltx_p">We use the <span id="S4.SS4.p1.1.1" class="ltx_text ltx_font_italic">following notations</span>
to describe the agent’s policies: (i) Contact Policy (CP) specifies, for each agent <math id="S4.SS4.p1.m1" class="ltx_Math" alttext="A_{i}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>i</mi></msub><annotation encoding="application/x-tex">A_{i}</annotation></semantics></math>, its authorized <math id="S4.SS4.p1.m2" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session peers and the maximum
number of <math id="S4.SS4.p1.m3" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session it may establish with them.
(ii) Initiator Contact Policy (ICP) declares the <math id="S4.SS4.p1.m4" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> <span id="S4.SS4.p1.1.2" class="ltx_text ltx_font_italic">task-msg</span> budget and time budget for interacting with an <math id="S4.SS4.p1.m5" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>(in the case of two-agent setting, ICP is defined for an <math id="S4.SS4.p1.m6" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session, and in the one-to-many setting ICP is defined as the total budget for the <math id="S4.SS4.p1.m7" class="ltx_Math" alttext="C" display="inline" intent=":literal"><semantics><mi>C</mi><annotation encoding="application/x-tex">C</annotation></semantics></math>-session), and (iii) Responder Contact Policy (RCP) defines the <math id="S4.SS4.p1.m8" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math> <span id="S4.SS4.p1.1.3" class="ltx_text ltx_font_italic">task-msg</span> budget and time budget for interacting with an <math id="S4.SS4.p1.m9" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> in a <math id="S4.SS4.p1.m10" class="ltx_Math" alttext="A" display="inline" intent=":literal"><semantics><mi>A</mi><annotation encoding="application/x-tex">A</annotation></semantics></math>-session.
Below we assume that all communication is over PQ-TLS and omit the details of secure channel establishment.</p>
</div>
<section id="S4.SS4.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">4.4.1. </span>Agent discovery.</h4>

<div id="S4.SS4.SSS1.p1" class="ltx_para">
<p id="S4.SS4.SSS1.p1.1" class="ltx_p">Before establishing an <span id="S4.SS4.SSS1.p1.1.1" class="ltx_text ltx_font_italic">A-session</span>, an <math id="S4.SS4.SSS1.p1.m1" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> must first obtain information about the responding agent <math id="S4.SS4.SSS1.p1.m2" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>  by contacting the <span id="S4.SS4.SSS1.p1.1.2" class="ltx_text ltx_font_typewriter">Provider</span>. The goal of this protocol is to allow <math id="S4.SS4.SSS1.p1.m3" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> to obtain authenticated information about the identity and the policies of <math id="S4.SS4.SSS1.p1.m4" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>. The <span id="S4.SS4.SSS1.p1.1.3" class="ltx_text ltx_font_typewriter">Provider</span> checks whether communication between <math id="S4.SS4.SSS1.p1.m5" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> and <math id="S4.SS4.SSS1.p1.m6" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math> is
authorized under <math id="S4.SS4.SSS1.p1.m7" class="ltx_Math" alttext="CP_{A_{I}}\cap CP_{A_{R}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><msub><mi>A</mi><mi>I</mi></msub></msub></mrow><mo>∩</mo><mrow><mi>C</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><msub><mi>A</mi><mi>R</mi></msub></msub></mrow></mrow><annotation encoding="application/x-tex">CP_{A_{I}}\cap CP_{A_{R}}</annotation></semantics></math> and, if eligible, returns signed
information for <math id="S4.SS4.SSS1.p1.m8" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math> (see Figure <a href="#S4.F4" title="Figure 4 ‣ 4.4.1. Agent discovery. ‣ 4.4. Agent-to-Agent Intercommunication ‣ 4. MAGIQ Design ‣ MAGIQ: A Post-Quantum Multi-Agentic AI Governance System with Provable Security" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>). The specific steps are:</p>
</div>
<div id="S4.SS4.SSS1.p2" class="ltx_para">
<p id="S4.SS4.SSS1.p2.1" class="ltx_p"><span id="S4.SS4.SSS1.p2.1.1" class="ltx_text ltx_font_bold">Step 1: Retrieval.</span>
Agent <math id="S4.SS4.SSS1.p2.m1" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> requests permission to contact agent <math id="S4.SS4.SSS1.p2.m2" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math> by sending
both identities, <math id="S4.SS4.SSS1.p2.m3" class="ltx_Math" alttext="\mathit{aid}_{A_{I}}" display="inline" intent=":literal"><semantics><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><annotation encoding="application/x-tex">\mathit{aid}_{A_{I}}</annotation></semantics></math> and <math id="S4.SS4.SSS1.p2.m4" class="ltx_Math" alttext="\mathit{aid}_{A_{R}}" display="inline" intent=":literal"><semantics><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><annotation encoding="application/x-tex">\mathit{aid}_{A_{R}}</annotation></semantics></math>, to the Provider.
The Provider verifies mutual authorization between the two agents and
checks that <math id="S4.SS4.SSS1.p2.m5" class="ltx_Math" alttext="\mathit{Counter}[\mathit{aid}_{A_{R}}][\mathit{aid}_{A_{I}}]&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝐶𝑜𝑢𝑛𝑡𝑒𝑟</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><mo stretchy="false">]</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathit{Counter}[\mathit{aid}_{A_{R}}][\mathit{aid}_{A_{I}}]&gt;0</annotation></semantics></math>.
If so, the Provider returns <math id="S4.SS4.SSS1.p2.m6" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s access information together with a
signature <math id="S4.SS4.SSS1.p2.m7" class="ltx_Math" alttext="\sigma^{\mathsf{TA}}_{\mathsf{ac}}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mi>𝖺𝖼</mi><mi>𝖳𝖠</mi></msubsup><annotation encoding="application/x-tex">\sigma^{\mathsf{TA}}_{\mathsf{ac}}</annotation></semantics></math> over both agents’ data.</p>
</div>
<div id="S4.SS4.SSS1.p3" class="ltx_para">
<p id="S4.SS4.SSS1.p3.1" class="ltx_p">The returned access information includes: user <math id="S4.SS4.SSS1.p3.m1" class="ltx_Math" alttext="U_{R}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>R</mi></msub><annotation encoding="application/x-tex">U_{R}</annotation></semantics></math>’s identity certificate
<math id="S4.SS4.SSS1.p3.m2" class="ltx_Math" alttext="\mathit{Cert}^{ID}_{U_{R}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>U</mi><mi>R</mi></msub><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathit{Cert}^{ID}_{U_{R}}</annotation></semantics></math>; agent <math id="S4.SS4.SSS1.p3.m3" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s device and network information
<math id="S4.SS4.SSS1.p3.m4" class="ltx_Math" alttext="\mathit{ED}_{A_{R}}" display="inline" intent=":literal"><semantics><msub><mi>𝐸𝐷</mi><msub><mi>A</mi><mi>R</mi></msub></msub><annotation encoding="application/x-tex">\mathit{ED}_{A_{R}}</annotation></semantics></math>; <math id="S4.SS4.SSS1.p3.m5" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s transport-layer key and certificate
<math id="S4.SS4.SSS1.p3.m6" class="ltx_Math" alttext="(\mathit{Cert}^{\mathsf{tls}}_{A_{R}},pk^{\mathsf{tls}}_{A_{R}})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>A</mi><mi>R</mi></msub><mi>𝗍𝗅𝗌</mi></msubsup><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><msub><mi>A</mi><mi>R</mi></msub><mi>𝗍𝗅𝗌</mi></msubsup></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathit{Cert}^{\mathsf{tls}}_{A_{R}},pk^{\mathsf{tls}}_{A_{R}})</annotation></semantics></math>;
<math id="S4.SS4.SSS1.p3.m7" class="ltx_Math" alttext="U_{R}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>R</mi></msub><annotation encoding="application/x-tex">U_{R}</annotation></semantics></math>’s signature on <math id="S4.SS4.SSS1.p3.m8" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s identity key <math id="S4.SS4.SSS1.p3.m9" class="ltx_Math" alttext="\sigma^{U_{R}}_{ID}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><msub><mi>U</mi><mi>R</mi></msub></msubsup><annotation encoding="application/x-tex">\sigma^{U_{R}}_{ID}</annotation></semantics></math>;
<math id="S4.SS4.SSS1.p3.m10" class="ltx_Math" alttext="U_{R}" display="inline" intent=":literal"><semantics><msub><mi>U</mi><mi>R</mi></msub><annotation encoding="application/x-tex">U_{R}</annotation></semantics></math>’s signature on <math id="S4.SS4.SSS1.p3.m11" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s full information <math id="S4.SS4.SSS1.p3.m12" class="ltx_Math" alttext="\sigma^{U_{R}}_{A_{R}}" display="inline" intent=":literal"><semantics><msubsup><mi>σ</mi><msub><mi>A</mi><mi>R</mi></msub><msub><mi>U</mi><mi>R</mi></msub></msubsup><annotation encoding="application/x-tex">\sigma^{U_{R}}_{A_{R}}</annotation></semantics></math>;
and the initiating agent’s identity <math id="S4.SS4.SSS1.p3.m13" class="ltx_Math" alttext="\mathit{aid}_{A_{I}}" display="inline" intent=":literal"><semantics><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><annotation encoding="application/x-tex">\mathit{aid}_{A_{I}}</annotation></semantics></math> and key <math id="S4.SS4.SSS1.p3.m14" class="ltx_Math" alttext="pk_{A_{I}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>A</mi><mi>I</mi></msub></msub></mrow><annotation encoding="application/x-tex">pk_{A_{I}}</annotation></semantics></math>.</p>
</div>
<div id="S4.SS4.SSS1.p4" class="ltx_para">
<p id="S4.SS4.SSS1.p4.1" class="ltx_p"><math id="S4.SS4.SSS1.p4.m1" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s metadata is defined as:</p>
<table id="S4.Ex14" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex14.m1" class="ltx_Math" alttext="M_{A_{R}}=\bigl\{\,\mathit{ED}_{A_{R}},\;\mathit{Cert}^{\mathsf{tls}}_{A_{R}},\;pk^{\mathsf{tls}}_{A_{R}},\;pk_{A_{R}}\,\bigr\}" display="block" intent=":literal"><semantics><mrow><msub><mi>M</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo>=</mo><mrow><mo rspace="0.170em" stretchy="false">{</mo><mrow><msub><mi>𝐸𝐷</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.447em">,</mo><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>A</mi><mi>R</mi></msub><mi>𝗍𝗅𝗌</mi></msubsup><mo rspace="0.447em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><msub><mi>A</mi><mi>R</mi></msub><mi>𝗍𝗅𝗌</mi></msubsup></mrow><mo rspace="0.447em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>A</mi><mi>R</mi></msub></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">M_{A_{R}}=\bigl\{\,\mathit{ED}_{A_{R}},\;\mathit{Cert}^{\mathsf{tls}}_{A_{R}},\;pk^{\mathsf{tls}}_{A_{R}},\;pk_{A_{R}}\,\bigr\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS1.p5" class="ltx_para">
<p id="S4.SS4.SSS1.p5.1" class="ltx_p">The Provider’s signature is computed as:</p>
<table id="S4.Ex15" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex15.m1" class="ltx_Math" alttext="\sigma^{\mathsf{TA}}_{\mathsf{ac}}=\mathsf{HS.Sign}_{sk_{\mathsf{TA}}}\!\bigl(\nu,\;\mathit{Cert}^{ID}_{U_{R}},\;\mathit{aid}_{A_{R}},\;M_{A_{R}},\;\sigma^{U_{R}}_{ID},\;\sigma^{U_{R}}_{A_{R}},\;\mathit{aid}_{A_{I}},\;pk_{A_{I}}\bigr)" display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi>σ</mi><mi>𝖺𝖼</mi><mi>𝖳𝖠</mi></msubsup><mo>=</mo><mi>𝖧𝖲</mi></mrow><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>𝖲𝗂𝗀𝗇</mi><mrow><mi>s</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>𝖳𝖠</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>ν</mi><mo>,</mo><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>U</mi><mi>R</mi></msub><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup><mo>,</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo>,</mo><msub><mi>M</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo>,</mo><msubsup><mi>σ</mi><msub><mi>A</mi><mi>R</mi></msub><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo>,</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><mo>,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>A</mi><mi>I</mi></msub></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{\mathsf{TA}}_{\mathsf{ac}}=\mathsf{HS.Sign}_{sk_{\mathsf{TA}}}\!\bigl(\nu,\;\mathit{Cert}^{ID}_{U_{R}},\;\mathit{aid}_{A_{R}},\;M_{A_{R}},\;\sigma^{U_{R}}_{ID},\;\sigma^{U_{R}}_{A_{R}},\;\mathit{aid}_{A_{I}},\;pk_{A_{I}}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="S4.SS4.SSS1.p6" class="ltx_para">
<p id="S4.SS4.SSS1.p6.1" class="ltx_p">Finally, the Provider decrements <math id="S4.SS4.SSS1.p6.m1" class="ltx_Math" alttext="\mathit{Counter}[\mathit{aid}_{A_{R}}][\mathit{aid}_{A_{I}}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝐶𝑜𝑢𝑛𝑡𝑒𝑟</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo stretchy="false">]</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\mathit{Counter}[\mathit{aid}_{A_{R}}][\mathit{aid}_{A_{I}}]</annotation></semantics></math> by one.</p>
</div>
<div id="S4.SS4.SSS1.p7" class="ltx_para">
<p id="S4.SS4.SSS1.p7.1" class="ltx_p"><span id="S4.SS4.SSS1.p7.1.1" class="ltx_text ltx_font_bold">Step 2: Verification.</span>
Agent <math id="S4.SS4.SSS1.p7.m1" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> verifies that <math id="S4.SS4.SSS1.p7.m2" class="ltx_Math" alttext="A_{R}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>R</mi></msub><annotation encoding="application/x-tex">A_{R}</annotation></semantics></math>’s user certificate <math id="S4.SS4.SSS1.p7.m3" class="ltx_Math" alttext="\mathit{Cert}^{ID}_{U_{R}}" display="inline" intent=":literal"><semantics><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>U</mi><mi>R</mi></msub><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup><annotation encoding="application/x-tex">\mathit{Cert}^{ID}_{U_{R}}</annotation></semantics></math>,
including the public key <math id="S4.SS4.SSS1.p7.m4" class="ltx_Math" alttext="pk_{U_{R}}" display="inline" intent=":literal"><semantics><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>U</mi><mi>R</mi></msub></msub></mrow><annotation encoding="application/x-tex">pk_{U_{R}}</annotation></semantics></math>, is valid. <math id="S4.SS4.SSS1.p7.m5" class="ltx_Math" alttext="A_{I}" display="inline" intent=":literal"><semantics><msub><mi>A</mi><mi>I</mi></msub><annotation encoding="application/x-tex">A_{I}</annotation></semantics></math> then verifies the
following three signatures:</p>
<table id="S4.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex16.m1" class="ltx_Math" alttext="\mathsf{HS.Verify}_{pk_{U_{R}}}\!\bigl(\langle\mathit{aid}_{A_{R}},\,\mathit{ED}_{A_{R}},\,pk^{\mathsf{tls}}_{A_{R}},\,pk^{\mathsf{tls}}_{\mathsf{TA}},\,pk_{\mathsf{TA}}\rangle,\;\sigma^{U_{R}}_{A_{R}}\bigr)" display="block" intent=":literal"><semantics><mrow><mi>𝖧𝖲</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>𝖵𝖾𝗋𝗂𝖿𝗒</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>U</mi><mi>R</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.337em">,</mo><msub><mi>𝐸𝐷</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.337em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><msub><mi>A</mi><mi>R</mi></msub><mi>𝗍𝗅𝗌</mi></msubsup></mrow><mo rspace="0.337em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>k</mi><mi>𝖳𝖠</mi><mi>𝗍𝗅𝗌</mi></msubsup></mrow><mo rspace="0.337em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>𝖳𝖠</mi></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msubsup><mi>σ</mi><msub><mi>A</mi><mi>R</mi></msub><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{HS.Verify}_{pk_{U_{R}}}\!\bigl(\langle\mathit{aid}_{A_{R}},\,\mathit{ED}_{A_{R}},\,pk^{\mathsf{tls}}_{A_{R}},\,pk^{\mathsf{tls}}_{\mathsf{TA}},\,pk_{\mathsf{TA}}\rangle,\;\sigma^{U_{R}}_{A_{R}}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S4.Ex17" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex17.m1" class="ltx_Math" alttext="\mathsf{HS.Verify}_{pk_{U_{R}}}\!\bigl(\langle\mathit{aid}_{A_{R}},\,pk_{A_{R}}\rangle,\;\sigma^{U_{R}}_{ID}\bigr)" display="block" intent=":literal"><semantics><mrow><mi>𝖧𝖲</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>𝖵𝖾𝗋𝗂𝖿𝗒</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>U</mi><mi>R</mi></msub></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.337em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>A</mi><mi>R</mi></msub></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msubsup><mi>σ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{HS.Verify}_{pk_{U_{R}}}\!\bigl(\langle\mathit{aid}_{A_{R}},\,pk_{A_{R}}\rangle,\;\sigma^{U_{R}}_{ID}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<table id="S4.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S4.Ex18.m1" class="ltx_Math" alttext="\mathsf{HS.Verify}_{pk_{\mathsf{TA}}}\!\bigl(\langle\mathit{Cert}^{ID}_{U_{R}},\,\mathit{aid}_{A_{R}},\,M_{A_{R}},\,\sigma^{U_{R}}_{ID},\,\sigma^{U_{R}}_{A_{R}},\,\mathit{aid}_{A_{I}},\,pk_{A_{I}}\rangle,\;\sigma^{\mathsf{TA}}_{\mathsf{ac}}\bigr)" display="block" intent=":literal"><semantics><mrow><mi>𝖧𝖲</mi><mo lspace="0em" rspace="0.167em">.</mo><mrow><msub><mi>𝖵𝖾𝗋𝗂𝖿𝗒</mi><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><mi>𝖳𝖠</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mo stretchy="false">⟨</mo><mrow><msubsup><mi>𝐶𝑒𝑟𝑡</mi><msub><mi>U</mi><mi>R</mi></msub><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow></msubsup><mo rspace="0.337em">,</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.337em">,</mo><msub><mi>M</mi><msub><mi>A</mi><mi>R</mi></msub></msub><mo rspace="0.337em">,</mo><msubsup><mi>σ</mi><mrow><mi>I</mi><mo lspace="0em" rspace="0em">​</mo><mi>D</mi></mrow><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo rspace="0.337em">,</mo><msubsup><mi>σ</mi><msub><mi>A</mi><mi>R</mi></msub><msub><mi>U</mi><mi>R</mi></msub></msubsup><mo rspace="0.337em">,</mo><msub><mi>𝑎𝑖𝑑</mi><msub><mi>A</mi><mi>I</mi></msub></msub><mo rspace="0.337em">,</mo><mrow><mi>p</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>k</mi><msub><mi>A</mi><mi>I</mi></msub></msub></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>,</mo><msubsup><mi>σ</mi><mi>𝖺𝖼</mi><mi>𝖳𝖠</mi></msubsup><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathsf{HS.Verify}_{pk_{\mathsf{TA}}}\!\bigl(\langle\mathit{Cert}^{ID}_{U_{R}},\,\mathit{aid}_{A_{R}},\,M_{A_{R}},\,\sigma^{U_{R}}_{ID},\,\sigma^{U_{R}}_{A_{R}},\,\mathit{aid}_{A_{I}},\,pk_{A_{I}}\rangle,\;\sigma^{\mathsf{TA}}_{\mathsf{ac}}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<figure id="S4.F4" class="ltx_figure" aria-describedby="acmlabel4">
