<span id="lstnumberx13" class="ltx_listingline"><span id="lstnumberx13.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">    </span><span id="lstnumberx13.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">injector</span><span id="lstnumberx13.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">.</span><span id="lstnumberx13.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">_inject</span><span id="lstnumberx13.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">(</span>
</span>
<span id="lstnumberx14" class="ltx_listingline"><span id="lstnumberx14.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">      </span><span id="lstnumberx14.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">fault_type</span><span id="lstnumberx14.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx14.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#A31515;">"port-misconfig"</span><span id="lstnumberx14.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">,</span>
</span>
<span id="lstnumberx15" class="ltx_listingline"><span id="lstnumberx15.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;">      </span><span id="lstnumberx15.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;">microservice</span><span id="lstnumberx15.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;">=</span><span id="lstnumberx15.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#A31515;">"user-service"</span><span id="lstnumberx15.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;">)</span><span id="lstnumberx15.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;"><span class="ltx_inline-block"><svg id="lstnumberx15.pic1" class="ltx_picture" height="1" overflow="visible" version="1.1" viewBox="0 0 1 1" width="1"><g transform="translate(0,1) matrix(1 0 0 -1 0 0)"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:8.5pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g style="--ltx-stroke-color:#000000;" stroke="#000000"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:8.5pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g style="--ltx-fill-color:#000000;" fill="#000000"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:8.5pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="5.88"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"></span></span></foreignObject><g stroke-width="0.4pt"><foreignObject style="--ltx-fo-width:0.5em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:8.5pt;