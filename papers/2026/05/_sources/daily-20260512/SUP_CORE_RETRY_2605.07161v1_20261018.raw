<td id="S3.T5.1.8.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T5.1.8.4.1" class="ltx_text" style="font-size:80%;">0.435</span></td></tr>
