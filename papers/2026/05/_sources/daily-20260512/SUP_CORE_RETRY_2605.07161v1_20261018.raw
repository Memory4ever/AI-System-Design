<td id="S3.T5.1.6.4" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S3.T5.1.6.4.1" class="ltx_text" style="font-size:80%;">0.500</span></td></tr>
<tr id="S3.T5.1.7" class="ltx_tr">
