<td id="S2.T2.5.2.4" class="ltx_td ltx_align_right ltx_border_t"><span id="S2.T2.5.2.4.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.90</span></td></tr>
<tr id="S2.T2.5.3" class="ltx_tr">
<td id="S2.T2.5.3.1" class="ltx_td ltx_align_left">
<span id="S2.T2.5.3.1.1" class="ltx_inline-block ltx_markedasmath ltx_align_bottom">
<span id="S2.T2.5.3.1.1.1" class="ltx_p"><img src="2605.07161v1/claude.png" id="S2.T2.m3.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:14/14;" width="14" height="14" alt="[Uncaptioned image]"></span>
</span><span id="S2.T2.5.3.1.2" class="ltx_text" style="font-size:90%;"> Sonnet-4.6</span></td>
<td id="S2.T2.5.3.2" class="ltx_td ltx_align_left">
<span id="S2.T2.5.3.2.1" class="ltx_inline-block ltx_markedasmath ltx_align_bottom">
<span id="S2.T2.5.3.2.1.1" class="ltx_p"><img src="2605.07161v1/openai.png" id="S2.T2.m4.g1" class="ltx_graphics ltx_img_square" style="aspect-ratio:14/14;" width="14" height="14" alt="[Uncaptioned image]"></span>
</span><span id="S2.T2.5.3.2.2" class="ltx_text" style="font-size:90%;"> GPT-5.4</span></td>
