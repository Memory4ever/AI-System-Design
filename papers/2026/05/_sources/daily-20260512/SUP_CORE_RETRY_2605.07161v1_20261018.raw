<td id="S2.T2.5.1.2" class="ltx_td ltx_align_left ltx_border_tt"><span id="S2.T2.5.1.2.1" class="ltx_text" style="font-size:90%;">Judge B</span></td>
<td id="S2.T2.5.1.3" class="ltx_td ltx_align_right ltx_border_tt"><span id="S2.T2.5.1.3.1" class="ltx_text" style="font-size:90%;">Agree</span></td>
<td id="S2.T2.5.1.4" class="ltx_td ltx_align_right ltx_border_tt"><math id="S2.T2.m1" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math></td></tr>
<tr id="S2.T2.5.2" class="ltx_tr">
