<td id="A5.T8.7.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;" rowspan="2"><span id="A5.T8.7.2.2.1" class="ltx_text" style="font-size:80%;">
