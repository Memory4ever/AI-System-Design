</span></span></span></span>
<span id="A8.p4.pic1.2.30" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.30.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.30.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p30" class="ltx_para ltx_noindent">
<span id="A8.p4.pic1.p30.1" class="ltx_p">crop_2 = img_0.crop((int(w*0.6), int(h*0.5), int(w*0.95), int(h*0.95)))</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.31" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.31.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.31.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
