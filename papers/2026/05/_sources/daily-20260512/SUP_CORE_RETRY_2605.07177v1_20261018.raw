<td id="A6.T11.8.2.1" class="ltx_td ltx_align_left" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A6.T11.8.2.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Benchmark</span></td>
