<td id="A6.T9.5.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T9.5.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HyperEyes-30B</span></td>
<td id="A6.T9.5.1.3" class="ltx_td ltx_align_center ltx_border_tt"><span id="A6.T9.5.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">HyperEyes-235B</span></td></tr>
