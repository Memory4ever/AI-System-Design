<td id="A6.T11.8.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A6.T11.8.2.3.1" class="ltx_text" style="font-size:90%;">Turns</span></td>
