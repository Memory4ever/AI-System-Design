<td id="A6.T11.8.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A6.T11.8.2.5.1" class="ltx_text" style="font-size:90%;">Turns</span></td></tr>
<tr id="A6.T11.8.3" class="ltx_tr">
<td id="A6.T11.8.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A6.T11.8.3.1.1" class="ltx_text" style="font-size:90%;">MMSearch</span></td>
<td id="A6.T11.8.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A6.T11.8.3.2.1" class="ltx_text" style="font-size:90%;">86.9</span></td>
