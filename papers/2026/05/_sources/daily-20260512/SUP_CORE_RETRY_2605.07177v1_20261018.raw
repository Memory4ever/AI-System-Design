<td id="A6.T11.8.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-left:5.0pt;padding-right:5.0pt;" colspan="2"><span id="A6.T11.8.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Mean <math id="A6.T11.m7" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> Std (3 seeds)</span></td></tr>
