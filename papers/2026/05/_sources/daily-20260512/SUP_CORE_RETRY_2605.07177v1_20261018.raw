<span id="A8.p4.pic1.p22.1" class="ltx_p">w, h = img_0.size</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.23" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.23.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.23.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p23" class="ltx_para ltx_noindent">
<span id="A8.p4.pic1.p23.1" class="ltx_p"># Crop the object in the upper-left area of the image</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.24" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.24.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.24.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p24" class="ltx_para ltx_noindent">
<span id="A8.p4.pic1.p24.1" class="ltx_p">crop_1 = img_0.crop((int(w*0.1), int(h*0.2), int(w*0.5), int(h*0.8)))</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.25" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.25.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.25.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p25" class="ltx_para ltx_noindent">
<span id="A8.p4.pic1.p25.1" class="ltx_p">plt.imshow(crop_1)</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.26" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.26.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.26.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p26" class="ltx_para ltx_noindent">
<span id="A8.p4.pic1.p26.1" class="ltx_p">plt.axis(’off’)</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.27" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.27.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.27.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
<span id="A8.p4.pic1.p27" class="ltx_para ltx_noindent">
