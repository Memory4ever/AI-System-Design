<td id="A6.T9.5.22.2" class="ltx_td ltx_align_center" colspan="2"><math id="A6.T9.m7" class="ltx_Math" alttext="1\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">1</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">1\times 10^{-3}</annotation></semantics></math></td></tr>
<tr id="A6.T9.5.23" class="ltx_tr">
<td id="A6.T9.5.23.1" class="ltx_td ltx_align_left ltx_border_t" colspan="3"><span id="A6.T9.5.23.1.1" class="ltx_text ltx_font_italic" style="font-size:90%;">Batching &amp; Sequence</span></td></tr>
<tr id="A6.T9.5.24" class="ltx_tr">
<td id="A6.T9.5.24.1" class="ltx_td ltx_align_left"><span id="A6.T9.5.24.1.1" class="ltx_text" style="font-size:90%;">Micro-batch size (per GPU)</span></td>
<td id="A6.T9.5.24.2" class="ltx_td ltx_align_center" colspan="2"><span id="A6.T9.5.24.2.1" class="ltx_text" style="font-size:90%;">1</span></td></tr>
<tr id="A6.T9.5.25" class="ltx_tr">
<td id="A6.T9.5.25.1" class="ltx_td ltx_align_left"><span id="A6.T9.5.25.1.1" class="ltx_text" style="font-size:90%;">Global batch size</span></td>
<td id="A6.T9.5.25.2" class="ltx_td ltx_align_center" colspan="2"><span id="A6.T9.5.25.2.1" class="ltx_text" style="font-size:90%;">64</span></td></tr>
