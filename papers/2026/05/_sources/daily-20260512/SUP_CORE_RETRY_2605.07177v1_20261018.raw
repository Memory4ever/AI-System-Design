<span id="alg1.l10.5" class="ltx_text" style="float:right;"><math id="alg1.l10.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l10.5.1" class="ltx_text" style="--ltx-fg-color:#008000;">If at least one guided trajectory succeeds</span>
</span>
</div>
<div id="alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
               <span id="alg1.l11.3" class="ltx_text ltx_font_bold">return</span> <math id="alg1.l11.m1" class="ltx_Math" alttext="\arg\min_{\tau\in\mathcal{T}_{b}^{+}}\mathrm{Turns}(\tau)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><msub><mi>min</mi><mrow><mi>τ</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>b</mi><mo>+</mo></msubsup></mrow></msub></mrow><mo lspace="0.167em" rspace="0em">​</mo><mi>Turns</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\arg\min_{\tau\in\mathcal{T}_{b}^{+}}\mathrm{Turns}(\tau)</annotation></semantics></math>
<span id="alg1.l11.4" class="ltx_text" style="float:right;"><math id="alg1.l11.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l11.4.1" class="ltx_text" style="--ltx-fg-color:#008000;">Return the shortest one to optimize efficiency</span>
</span>
</div>
