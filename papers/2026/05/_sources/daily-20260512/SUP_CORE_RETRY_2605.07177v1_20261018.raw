<td id="S4.T3.7.1.7.7" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T3.7.1.7.7.1" class="ltx_text" style="--ltx-bg-color:#E1EEE1;">3.13</span></td>
<td id="S4.T3.7.1.7.8" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T3.7.1.7.8.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E1EEE1;">46.7</span></td>
<td id="S4.T3.7.1.7.9" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:1.25pt;padding-bottom:1.25pt;"><span id="S4.T3.7.1.7.9.1" class="ltx_text ltx_font_bold" style="--ltx-bg-color:#E1EEE1;">0.910</span></td></tr>
