<tr id="A6.T9.5.19" class="ltx_tr">
<td id="A6.T9.5.19.1" class="ltx_td ltx_align_left"><span id="A6.T9.5.19.1.1" class="ltx_text" style="font-size:90%;">Grouped GEMM</span></td>
<td id="A6.T9.5.19.2" class="ltx_td ltx_align_center" colspan="2"><span id="A6.T9.5.19.2.1" class="ltx_text" style="font-size:90%;">enabled</span></td></tr>
<tr id="A6.T9.5.20" class="ltx_tr">
<td id="A6.T9.5.20.1" class="ltx_td ltx_align_left"><span id="A6.T9.5.20.1.1" class="ltx_text" style="font-size:90%;">Permute fusion</span></td>
<td id="A6.T9.5.20.2" class="ltx_td ltx_align_center" colspan="2"><span id="A6.T9.5.20.2.1" class="ltx_text" style="font-size:90%;">enabled</span></td></tr>
<tr id="A6.T9.5.21" class="ltx_tr">
<td id="A6.T9.5.21.1" class="ltx_td ltx_align_left"><span id="A6.T9.5.21.1.1" class="ltx_text" style="font-size:90%;">Shared-expert overlap</span></td>
<td id="A6.T9.5.21.2" class="ltx_td ltx_align_center" colspan="2"><span id="A6.T9.5.21.2.1" class="ltx_text" style="font-size:90%;">disabled</span></td></tr>
