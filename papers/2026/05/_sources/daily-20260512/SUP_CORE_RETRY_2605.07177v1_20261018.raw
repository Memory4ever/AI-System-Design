<span id="alg1.l8.3" class="ltx_text" style="float:right;"><math id="alg1.l8.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> <span id="alg1.l8.3.1" class="ltx_text" style="--ltx-fg-color:#008000;">Filter to keep only successful trajectories</span>
</span>
</div>
<div id="alg1.l9" class="ltx_listingline">
