<span id="A8.p4.pic1.p21.1" class="ltx_p">```python</span>
</span></span></span></span>
<span id="A8.p4.pic1.2.22" class="ltx_p" style="width:313.7pt;"><span id="A8.p4.pic1.2.22.1" class="ltx_text ltx_verbatim ltx_font_typewriter ltx_inline-block" style="font-size:70%;width:313.7pt;--ltx-fg-color:#000000;"><span id="A8.p4.pic1.2.22.1.1" class="ltx_inline-logical-block ltx_parbox ltx_align_top" style="width:313.7pt;">
