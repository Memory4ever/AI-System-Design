ntent"><math id="A3.F5.pic2.m4" class="ltx_Math" alttext="0.6" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#4D4D4D;" mathcolor="#4D4D4D" mathsize="0.700em">0.6</mn><annotation encoding="application/x-tex">0.6</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#4D4D4D;--ltx-fg-color:#4D4D4D;" color="#4D4D4D" fill="#4D4D4D" stroke="#4D4D4D" transform="matrix(1.0 0.0 0.0 1.0 -43.66 60.35)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.42em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="16.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic2.m5" class="ltx_Math" alttext="0.7" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#4D4D4D;" mathcolor="#4D4D4D" mathsize="0.700em">0.7</mn><annotation encoding="application/x-tex">0.7</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#4D4D4D;--ltx-fg-color:#4D4D4D;" color="#4D4D4D" fill="#4D4D4D" stroke="#4D4D4D" transform="matrix(1.0 0.0 0.0 1.0 -43.66 76.22)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.42em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="16.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic2.m6" class="ltx_Math" alttext="0.8" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#4D4D4D;" mathcolor="#4D4D4D" mathsize="0.700em">0.8</mn><annotation encoding="application/x-tex">0.8</annotation></semantics></math></span></span></foreignObject></g><g style="--ltx-stroke-color:#4D4D4D;--ltx-fill-color:#4D4D4D;--ltx-fg-color:#4D4D4D;" color="#4D4D4D" fill="#4D4D4D" stroke="#4D4D4D" transform="matrix(1.0 0.0 0.0 1.0 -43.66 92.09)"><foreignObject style="--ltx-fg-color:#000000;--ltx-fo-width:1.42em;--ltx-fo-height:0.55em;--ltx-fo-depth:0em;font-size:8.19pt;" color="#000000" height="6.24" overflow="visible" transform="matrix(1 0 0 -1 0 6.24)" width="16.05"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content"><math id="A3.F5.pic2.m7" class="ltx_Math" alttext="0.9" display="inline" intent=":literal"><semantics><mn style="--ltx-fg-color:#4D4D4D;" mathcolor="#4D4D4D" mathsize="0.700em">0.9</mn><annotation encoding="application/x-tex">0.9</annotation></semantics></math></span></span></foreignObject></g><clipPath id="pgfcp2"><path d="M -22.72 0 L 148.93 0 L 148.93 95.21 L -22.72 95.21 Z"></path></clipPath><g clip-path="url(#pgfcp2)"><g style="--ltx-stroke-color:#195F90;--ltx-fill-color:#1F77B4;" fill="#1F77B4" stroke="#195F90" stroke-width="0.3pt"><path d="M -10.24 0 h 3.04 v 84.26 h -3.04 Z M 31.83 0 h 3.04 v 61.41 h -3.04 Z M 73.9 0 h 3.04 v 42.53 h -3.04 Z M 115.97 0 h 3.04 v 26.18 h -3.04 Z"></path></g><g></g><g style="--ltx-stroke-color:#195F90;--ltx-fill-color:#A5C8E1;" fill="#A5C8E1" stroke="#195F90" stroke-width="0.3pt"><path d="M -4.43 0 h 3.04 v 76.81 h -3.04 Z M 37.64 0 h 3.04 v 55.38 h -3.04 Z M 79.71 0 h 3.04 v 39.04 h -3.04 Z M 121.78 0 h 3.04 v 23.8 h -3.04 Z"></path></g><g></g><g style="--ltx-stroke-color:#CC650B;--ltx-fill-color:#FF7F0E;" fill="#FF7F0E" stroke="#CC650B" stroke-width="0.3pt"><path d="M 1.38 0 h 3.04 v 79.82 h -3.04 Z M 43.45 0 h 3.04 v 54.27 h -3.04 Z M 85.53 0 h 3.04 v 33.96 h -3.04 Z M 127.6 0 h 3.04 v 16.98 h -3.04 Z"></path></g><g></g><g style="--ltx-stroke-color:#CC650B;--ltx-fill-color:#FFCC9F;" fill="#FFCC9F" stroke="#CC650B" stroke-width="0.3pt"><path d="M 7.2 0 h 3.04 v 71.09 h -3.04 Z M 49.27 0 h 3.04 v 46.65 h -3.04 Z M 91.34 0 h 3.04 v 28.88 h -3.04 Z M 133.41 0 h 3.04 v 13.17 h -3.04 Z"></path></g><g></g></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#0000