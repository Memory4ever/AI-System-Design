<th id="A2.T3.2.1.4" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">Recall</th>
<th id="A2.T3.2.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">F1</th></tr>
