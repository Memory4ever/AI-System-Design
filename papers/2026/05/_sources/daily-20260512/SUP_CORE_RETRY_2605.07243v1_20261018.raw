<td id="S4.T1.2.1.36.6" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T1.m209" class="ltx_math_unparsed" style="--ltx-bg-color:#EBFFFF;" alttext="\mathbf{2.06\times}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EBFFFF;" class="ltx_mathvariant_bold" mathbackground="#EBFFFF" mathvariant="bold">2.06</mn><mo style="--ltx-bg-color:#EBFFFF;" lspace="0.222em" mathbackground="#EBFFFF">×</mo></mrow><annotation encoding="application/x-tex">\mathbf{2.06\times}</annotation></semantics></math></td>
<td id="S4.T1.2.1.36.7" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.7.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">3.53</span></td>
<td id="S4.T1.2.1.36.8" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T1.m210" class="ltx_math_unparsed" style="--ltx-bg-color:#EBFFFF;" alttext="\mathbf{2.19\times}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EBFFFF;" class="ltx_mathvariant_bold" mathbackground="#EBFFFF" mathvariant="bold">2.19</mn><mo style="--ltx-bg-color:#EBFFFF;" lspace="0.222em" mathbackground="#EBFFFF">×</mo></mrow><annotation encoding="application/x-tex">\mathbf{2.19\times}</annotation></semantics></math></td>
<td id="S4.T1.2.1.36.9" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.9.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">3.40</span></td>
<td id="S4.T1.2.1.36.10" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.10.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">—</span></td>
<td id="S4.T1.2.1.36.11" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.11.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">—</span></td>
<td id="S4.T1.2.1.36.12" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T1.m211" class="ltx_math_unparsed" style="--ltx-bg-color:#EBFFFF;" alttext="\mathbf{2.14\times}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EBFFFF;" class="ltx_mathvariant_bold" mathbackground="#EBFFFF" mathvariant="bold">2.14</mn><mo style="--ltx-bg-color:#EBFFFF;" lspace="0.222em" mathbackground="#EBFFFF">×</mo></mrow><annotation encoding="application/x-tex">\mathbf{2.14\times}</annotation></semantics></math></td>
<td id="S4.T1.2.1.36.13" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.13.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">3.22</span></td>
<td id="S4.T1.2.1.36.14" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T1.m212" class="ltx_math_unparsed" style="--ltx-bg-color:#EBFFFF;" alttext="\mathbf{2.24\times}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EBFFFF;" class="ltx_mathvariant_bold" mathbackground="#EBFFFF" mathvariant="bold">2.24</mn><mo style="--ltx-bg-color:#EBFFFF;" lspace="0.222em" mathbackground="#EBFFFF">×</mo></mrow><annotation encoding="application/x-tex">\mathbf{2.24\times}</annotation></semantics></math></td>
<td id="S4.T1.2.1.36.15" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.15.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">3.45</span></td>
<td id="S4.T1.2.1.36.16" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.16.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">13</span></td></tr>
