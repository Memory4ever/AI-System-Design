<td id="A2.T3.2.3.3" class="ltx_td ltx_align_center">0.528</td>
<td id="A2.T3.2.3.4" class="ltx_td ltx_align_center">0.476</td>
<td id="A2.T3.2.3.5" class="ltx_td ltx_align_center">0.501</td></tr>
<tr id="A2.T3.2.4" class="ltx_tr">
<th id="A2.T3.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A2.T3.m7" class="ltx_Math" alttext="b_{2}" display="inline" intent=":literal"><semantics><msub><mi>b</mi><mn>2</mn></msub><annotation encoding="application/x-tex">b_{2}</annotation></semantics></math> (rank <math id="A2.T3.m8" class="ltx_Math" alttext="\in[5,10]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mn>5</mn><mo>,</mo><mn>10</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\in[5,10]</annotation></semantics></math>)</th>
