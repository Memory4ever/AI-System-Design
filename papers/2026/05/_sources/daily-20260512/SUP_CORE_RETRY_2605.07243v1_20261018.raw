<td id="S4.T1.2.1.36.2" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.2.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">—</span></td>
<td id="S4.T1.2.1.36.3" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><span id="S4.T1.2.1.36.3.1" class="ltx_text" style="--ltx-bg-color:#EBFFFF;">—</span></td>
<td id="S4.T1.2.1.36.4" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#EBFFFF;padding-left:3.0pt;padding-right:3.0pt;"><math id="S4.T1.m208" class="ltx_math_unparsed" style="--ltx-bg-color:#EBFFFF;" alttext="\mathbf{2.55\times}" display="inline" intent=":literal"><semantics><mrow><mn style="--ltx-bg-color:#EBFFFF;" class="ltx_mathvariant_bold" mathbackground="#EBFFFF" mathvariant="bold">2.55</mn><mo style="--ltx-bg-color:#EBFFFF;" lspace="0.222em" mathbackground="#EBFFFF">×</mo></mrow><annotation encoding="application/x-tex">\mathbf{2.55\times}</annotation></semantics></math></td>
