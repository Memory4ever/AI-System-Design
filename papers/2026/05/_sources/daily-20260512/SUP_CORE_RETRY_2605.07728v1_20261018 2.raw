<td id="S10.T7.2.1.2" class="ltx_td ltx_align_right ltx_border_tt"><span id="S10.T7.2.1.2.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Enforcement failure rate <math id="S10.T7.m2" class="ltx_Math" alttext="\epsilon_{\text{exec}}" display="inline" intent=":literal"><semantics><msub><mi>ϵ</mi><mtext class="ltx_mathvariant_bold">exec</mtext></msub><annotation encoding="application/x-tex">\epsilon_{\text{exec}}</annotation></semantics></math></span></td>
