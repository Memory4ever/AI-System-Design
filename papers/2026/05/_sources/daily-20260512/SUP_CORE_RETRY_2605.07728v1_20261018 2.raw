</div>
<div id="alg1.l34" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l34.1" class="ltx_text" style="font-size:80%;">34:</span></span>
            
            
            <span id="alg1.l34.3" class="ltx_text ltx_font_bold">end</span> <span id="alg1.l34.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="alg1.l35" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l35.1" class="ltx_text" style="font-size:80%;">35:</span></span>
            
            
            <math id="alg1.l35.m1" class="ltx_Math" alttext="r\leftarrow R(s,a,s^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo stretchy="false">←</mo><mrow><mi>R</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">r\leftarrow R(s,a,s^{\prime})</annotation></semantics></math>

</div>
<div id="alg1.l36" class="ltx_listingline">
            <span class="ltx_tag ltx_tag_listingline"><span id="alg1.l36.1" class="ltx_text" style="font-size:80%;">36:</span></span>
            
            
            <math id="alg1.l36.m1" class="ltx_Math" alttext="\text{trace}.\textsc{Append}\bigl(\textsc{EmitTrace}(\Sigma,s,a,s^{\prime},r,\text{obs},c\text{-events},\alpha)\bigr)" display="inline" intent=":literal"><semantics><mrow><mtext>trace</mtext><mo lspace="0em" rspace="0.167em">.</mo><mrow><mtext class="ltx_font_smallcaps">Append</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mtext class="ltx_font_smallcaps">EmitTrace</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi mathvariant="normal">Σ</mi><mo>,</mo><mi>s</mi><mo>,</mo><mi>a</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo>,</mo><mi>r</mi><mo>,</mo><mtext>obs</mtext><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-events</mtext></mrow><mo>,</mo><mi>α</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\text{trace}.\textsc{Append}\bigl(\textsc{EmitTrace}(\Sigma,s,a,s^{\prime},r,\text{obs},c\text{-events},\alpha)\bigr)</annotation></semantics></math> <span id="alg1.l36.3" class="ltx_text" style="float:right;"><math id="alg1.l36.m2" class="ltx_Math" alttext="\triangleright" display="inline" intent=":literal"><semantics><mo>⊳</mo><annotation encoding="application/x-tex">\triangleright</annotation></semantics></math> I3, I8; Art. 72
</span>
