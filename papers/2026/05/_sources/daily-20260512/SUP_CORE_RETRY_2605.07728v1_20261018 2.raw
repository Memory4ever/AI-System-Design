<td id="S10.T7.2.13.2" class="ltx_td ltx_align_right ltx_border_bb"><math id="S10.T7.m60" class="ltx_Math" alttext="0.05" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">0.05</mn><annotation encoding="application/x-tex">0.05</annotation></semantics></math></td>
<td id="S10.T7.2.13.3" class="ltx_td ltx_align_right ltx_border_bb"><math id="S10.T7.m61" class="ltx_Math" alttext="3.66" display="inline" intent=":literal"><semantics><mn mathsize="0.800em">3.66</mn><annotation encoding="application/x-tex">3.66</annotation></semantics></math></td>
