<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex9.m2" class="ltx_math_unparsed" alttext="\displaystyle-\frac{1}{T}\sum_{i=1}^{T}\log(\hat{p}_{M}(v_{i}|c_{i}))" display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>T</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>T</mi></munderover></mstyle><mi>log</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>M</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>i</mi></msub><mo fence="false" rspace="0.167em" stretchy="false">|</mo><msub><mi>c</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle-\frac{1}{T}\sum_{i=1}^{T}\log(\hat{p}_{M}(v_{i}|c_{i}))</annotation></semantics></math></td>
