<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex35.m2" class="ltx_Math" alttext="\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)-\log(\min(\beta_{i},1))+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><msub><mi>n</mi><mn>0</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>−</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)-\log(\min(\beta_{i},1))+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(39)</span></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.Ex36.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex36.m2" class="ltx_Math" alttext="\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)+\log\left(\frac{1}{\beta_{i}}\right)_{+}+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><msub><mi>n</mi><mn>0</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><msub><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>β</mi><mi>i</mi></msub></mfrac></mstyle><mo>)</mo></mrow><mo>+</mo></msub></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)+\log\left(\frac{1}{\beta_{i}}\right)_{+}+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.E39.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E39.m2" class="ltx_Math" alttext="\displaystyle\log\left(1+\frac{d_{0}}{n_{0}}\right)+\log\left(2\right)+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>d</mi><mn>0</mn></msub><msub><mi>n</mi><mn>0</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mn>2</mn><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log\left(1+\frac{d_{0}}{n_{0}}\right)+\log\left(2\right)+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS6.p2.3" class="ltx_p">where <math id="S8.SS6.p2.m8" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> uses <math id="S8.SS6.p2.m9" class="ltx_Math" alttext="N_{i}+\beta_{i}\geq(N_{i}+1)\min(\beta_{i},1)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><msub><mi>β</mi><mi>i</mi></msub></mrow><mo>≥</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>β</mi><mi>i</mi></msub><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">N_{i}+\beta_{i}\geq(N_{i}+1)\min(\beta_{i},1)</annotation></semantics></math>, and <math id="S8.SS6.p2.m10" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> uses <math id="S8.SS6.p2.m11" class="ltx_Math" alttext="\beta_{i}\geq\frac{1}{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>β</mi><mi>i</mi></msub><mo>≥</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\beta_{i}\geq\frac{1}{2}</annotation></semantics></math> and <math id="S8.SS6.p2.m12" class="ltx_Math" alttext="\gamma\leq d_{0}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>≤</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\gamma\leq d_{0}</annotation></semantics></math> for the optimal estimator from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">22</a>]</cite>.</p>
</div>
<div id="S8.SS6.p3" class="ltx_para">
<p id="S8.SS6.p3.1" class="ltx_p">We will finally prove <math id="S8.SS6.p3.m1" class="ltx_Math" alttext="\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]\leq 0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]\leq 0</annotation></semantics></math>.</p>
<table id="S8.EGx18" class="ltx_equationgroup ltx_eqn_eqnarray ltx_eqn_table">

<tbody id="S8.E40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="S8.E40.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}\right)\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.E40.m2" class="ltx_Math" alttext="\displaystyle\overset{(a)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">a</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(a)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E40.m3" class="ltx_Math" alttext="\displaystyle\mathbb{E}\left[\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}-1\right)\right]" display="inline" intent=":literal"><semantics><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E}\left[\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+1}-1\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(40)</span></td></tr></tbody>
<tbody id="S8.E41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.E41.m1" class="ltx_Math" alttext="\displaystyle\overset{(b)}{\leq}" display="inline" intent=":literal"><semantics><mover accent="true"><mo>≤</mo><mrow><mo maxsize="0.700em" minsize="0.700em">(</mo><mi mathsize="0.700em">b</mi><mo maxsize="0.700em" minsize="0.700em">)</mo></mrow></mover><annotation encoding="application/x-tex">\displaystyle\overset{(b)}{\leq}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E41.m2" class="ltx_Math" alttext="\displaystyle\left(\frac{\pi^{(0)}_{i}n_{0}}{(n_{0}+1)\pi^{(0)}_{i}}-1\right)\leq 0," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mstyle><mo>−</mo><mn>1</mn></mrow><mo>)</mo></mrow><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left(\frac{\pi^{(0)}_{i}n_{0}}{(n_{0}+1)\pi^{(0)}_{i}}-1\right)\leq 0,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="S8.SS6.p3.2" class="ltx_p">where <math id="S8.SS6.p3.m2" class="ltx_Math" alttext="(a)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(a)</annotation></semantics></math> follows since <math id="S8.SS6.p3.m3" class="ltx_Math" alttext="\log(x)\leq x-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">\log(x)\leq x-1</annotation></semantics></math> for <math id="S8.SS6.p3.m4" class="ltx_Math" alttext="x&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">x&gt;0</annotation></semantics></math>, and <math id="S8.SS6.p3.m5" class="ltx_Math" alttext="(b)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(b)</annotation></semantics></math> uses the standard result that <math id="S8.SS6.p3.m6" class="ltx_Math" alttext="\mathbb{E}\left[\frac{1}{N_{i}+1}\right]\leq\frac{1}{(n_{0}+1)\pi^{(0)}_{i}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mfrac><mn>1</mn><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><mn>1</mn></mrow></mfrac><mo>]</mo></mrow></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mfrac></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\frac{1}{N_{i}+1}\right]\leq\frac{1}{(n_{0}+1)\pi^{(0)}_{i}}</annotation></semantics></math>. So, we have</p>
<table id="S8.E42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="S8.E42.m1" class="ltx_Math" alttext="\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)\right]\leq\log\left(1+\frac{d_{0}}{n_{0}}\right)+\log\left(2\right)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mfrac><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_sans-serif">opt</mtext><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><msub><mi>n</mi><mn>0</mn></msub></mfrac></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mn>2</mn><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)\right]\leq\log\left(1+\frac{d_{0}}{n_{0}}\right)+\log\left(2\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(42)</span></td></tr></tbody>
</table>
<p id="S8.SS6.p3.3" class="ltx_p">Multiplying the above by <math id="S8.SS6.p3.m7" class="ltx_Math" alttext="\pi_{i}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\pi_{i}</annotation></semantics></math>, summing over all <math id="S8.SS6.p3.m8" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math> and picking <math id="S8.SS6.p3.m9" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> to be <math id="S8.SS6.p3.m10" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math> or <math id="S8.SS6.p3.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> in (<a href="#S8.E36" title="In VIII-F Proof of Theorem ‣ VIII Proofs of Theorems ‣ Semantic Smoothing for Language Models via Distribution Estimation and Embeddings" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>) appropriately gives us the desired result.</p>
</div>
</section>
</section>
