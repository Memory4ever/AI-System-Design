                      ^
                      
                        <span id="S8.E37.1.1.3.2.1.1" class="ltx_text ltx_font_italic">π</span>
                      
                    ^(0)_<span id="S8.E37.1.1.4" class="ltx_text ltx_font_sansserif">opt</span>)</td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.Ex31.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex31.m2" class="ltx_Math" alttext="\displaystyle\sum_{i\in[d_{0}]}\pi_{i}\log\left(\frac{\pi_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><msub><mi>π</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>π</mi><mi>i</mi></msub><mrow><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_sans-serif">opt</mtext><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i\in[d_{0}]}\pi_{i}\log\left(\frac{\pi_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr class="ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.E37.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.E37.m2" class="ltx_Math" alttext="\displaystyle\sum_{i\in[d_{0}]}\left(\pi_{i}\log\left(\frac{\pi_{i}}{\pi^{(0)}_{i}}\right)+\pi_{i}\log\left(\frac{\pi^{(0)}_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></munder></mstyle><mrow><mo>(</mo><mrow><mrow><msub><mi>π</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msub><mi>π</mi><mi>i</mi></msub><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>π</mi><mi>i</mi></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_sans-serif">opt</mtext><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>)</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{i\in[d_{0}]}\left(\pi_{i}\log\left(\frac{\pi_{i}}{\pi^{(0)}_{i}}\right)+\pi_{i}\log\left(\frac{\pi^{(0)}_{i}}{\hat{\pi}^{(0)}_{\textsf{opt}}(i)}\right)\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="S8.SS6.p2.2" class="ltx_p">The first term is <math id="S8.SS6.p2.m2" class="ltx_Math" alttext="d_{\textsf{KL}}(\pi,\pi^{(0)})\leq\Delta" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mtext class="ltx_mathvariant_sans-serif">KL</mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><msup><mi>π</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mi mathvariant="normal">Δ</mi></mrow><annotation encoding="application/x-tex">d_{\textsf{KL}}(\pi,\pi^{(0)})\leq\Delta</annotation></semantics></math>. We are left to bound the expected value of the second term. Note that for symbol counts <math id="S8.SS6.p2.m3" class="ltx_Math" alttext="N_{1},N_{2},\dots,N_{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>N</mi><mn>1</mn></msub><mo>,</mo><msub><mi>N</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>N</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><annotation encoding="application/x-tex">N_{1},N_{2},\dots,N_{d_{0}}</annotation></semantics></math> from the samples <math id="S8.SS6.p2.m4" class="ltx_Math" alttext="Y^{n_{0}}" display="inline" intent=":literal"><semantics><msup><mi>Y</mi><msub><mi>n</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">Y^{n_{0}}</annotation></semantics></math>, <math id="S8.SS6.p2.m5" class="ltx_Math" alttext="\hat{\pi}^{(0)}_{\textsf{opt}}(i)=\frac{N_{i}+\beta_{i}}{n_{0}+\gamma}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mover accent="true"><mi>π</mi><mo>^</mo></mover><mtext class="ltx_mathvariant_sans-serif">opt</mtext><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><msub><mi>β</mi><mi>i</mi></msub></mrow><mrow><msub><mi>n</mi><mn>0</mn></msub><mo>+</mo><mi>γ</mi></mrow></mfrac></mrow><annotation encoding="application/x-tex">\hat{\pi}^{(0)}_{\textsf{opt}}(i)=\frac{N_{i}+\beta_{i}}{n_{0}+\gamma}</annotation></semantics></math>, where <math id="S8.SS6.p2.m6" class="ltx_Math" alttext="\gamma=\sum_{i\in[d_{0}]}\beta_{i}" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo rspace="0.111em">=</mo><mrow><msub><mo>∑</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow></msub><msub><mi>β</mi><mi>i</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\gamma=\sum_{i\in[d_{0}]}\beta_{i}</annotation></semantics></math> for suitable <math id="S8.SS6.p2.m7" class="ltx_Math" alttext="\beta_{i}" display="inline" intent=":literal"><semantics><msub><mi>β</mi><mi>i</mi></msub><annotation encoding="application/x-tex">\beta_{i}</annotation></semantics></math> from <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib9" title="" class="ltx_ref">22</a>]</cite>. We have</p>
