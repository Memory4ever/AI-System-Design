<td class="ltx_td ltx_align_center ltx_eqn_cell"><math id="S8.Ex12.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex12.m2" class="ltx_Math" alttext="\displaystyle\sum_{(c,w)}p_{v}(c)p_{v}(w|c)\left[\log\left(\frac{1}{p_{v}(w|c)}\right)+\log\left(\frac{p_{v}(w|c)}{\hat{p}_{M}(w|c)}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo>,</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></munder></mstyle><mrow><msub><mi>p</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>p</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo lspace="0em" rspace="0em">|</mo><mi>c</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msub><mi>p</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo lspace="0em" rspace="0em">|</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>p</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo lspace="0em" rspace="0em">|</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow><mrow><msub><mover accent="true"><mi>p</mi><mo>^</mo></mover><mi>M</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo lspace="0em" rspace="0em">|</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{(c,w)}p_{v}(c)p_{v}(w|c)\left[\log\left(\frac{1}{p_{v}(w|c)}\right)+\log\left(\frac{p_{v}(w|c)}{\hat{p}_{M}(w|c)}\right)\right]</annotation></semantics></math></td>
