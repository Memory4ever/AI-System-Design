<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex21.m2" class="ltx_Math" alttext="\displaystyle\left(\sum_{x\in V}\text{Pr}(x|c)\right)\cdot\left(2\cdot L\|f_{c}-f_{\tilde{c}}\|+4\epsilon\right)" display="inline" intent=":literal"><semantics><mrow><mrow><mo>(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>V</mi></mrow></munder></mstyle><mrow><mtext>Pr</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo lspace="0em" rspace="0em">|</mo><mi>c</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo>(</mo><mrow><mrow><mrow><mn>2</mn><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>L</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>f</mi><mi>c</mi></msub><mo>−</mo><msub><mi>f</mi><mover accent="true"><mi>c</mi><mo>~</mo></mover></msub></mrow><mo stretchy="false">‖</mo></mrow></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>ϵ</mi></mrow></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\left(\sum_{x\in V}\text{Pr}(x|c)\right)\cdot\left(2\cdot L\|f_{c}-f_{\tilde{c}}\|+4\epsilon\right)</annotation></semantics></math></td>
