<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="S8.Ex34.m2" class="ltx_Math" alttext="\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+\beta_{i}}\right)\right]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mi>γ</mi><msub><mi>n</mi><mn>0</mn></msub></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><msubsup><mi>π</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>n</mi><mn>0</mn></msub></mrow><mrow><msub><mi>N</mi><mi>i</mi></msub><mo>+</mo><msub><mi>β</mi><mi>i</mi></msub></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\log\left(1+\frac{\gamma}{n_{0}}\right)+\mathbb{E}\left[\log\left(\frac{\pi^{(0)}_{i}n_{0}}{N_{i}+\beta_{i}}\right)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
