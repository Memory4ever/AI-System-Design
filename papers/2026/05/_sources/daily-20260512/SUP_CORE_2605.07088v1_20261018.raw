<td id="A1.T5.8.3.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.3pt 5.0pt;" rowspan="4"><span id="A1.T5.8.3.2.1" class="ltx_text" style="font-size:70%;">Sample</span></td>
<td id="A1.T5.8.3.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_t" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.3.3.1" class="ltx_text" style="font-size:70%;">Action-L1</span></td>
<td id="A1.T5.8.3.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.3.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.9453</span></td>
<td id="A1.T5.8.3.5" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.3.5.1" class="ltx_text" style="font-size:70%;">0.0631</span></td>
<td id="A1.T5.8.3.6" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.3.6.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.3741</span></td>
<td id="A1.T5.8.3.7" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.3.7.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.7468</span></td></tr>
<tr id="A1.T5.8.4" class="ltx_tr">
<td id="A1.T5.8.4.1" class="ltx_td ltx_align_left ltx_border_r" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.4.1.1" class="ltx_text" style="font-size:70%;">Action-MSE</span></td>
<td id="A1.T5.8.4.2" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.4.2.1" class="ltx_text" style="font-size:70%;">0.9115</span></td>
<td id="A1.T5.8.4.3" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.4.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">0.0882</span></td>
<td id="A1.T5.8.4.4" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.4.4.1" class="ltx_text" style="font-size:70%;">0.4267</span></td>
<td id="A1.T5.8.4.5" class="ltx_td ltx_align_center" style="padding:0.3pt 5.0pt;"><span id="A1.T5.8.4.5.1" class="ltx_text" style="font-size:70%;">0.7226</span></td></tr>
