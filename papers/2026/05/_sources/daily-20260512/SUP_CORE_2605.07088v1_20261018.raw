<td id="S4.T3.7.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding:-0.4pt 3.2pt;" colspan="4"><span id="S4.T3.7.1.4.1" class="ltx_text ltx_font_bold" style="font-size:70%;">OpenVLA</span></td></tr>
<tr id="S4.T3.7.2" class="ltx_tr">
<td id="S4.T3.7.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 3.2pt;" rowspan="2"><span id="S4.T3.7.2.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">AUC</span></td>
<td id="S4.T3.7.2.2" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding:-0.4pt 3.2pt;" colspan="3"><span id="S4.T3.7.2.2.1" class="ltx_text ltx_font_bold" style="font-size:70%;">TPR@FPR</span></td>
<td id="S4.T3.7.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding:-0.4pt 3.2pt;" rowspan="2"><span id="S4.T3.7.2.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">AUC</span></td>
