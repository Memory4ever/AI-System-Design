<td id="A1.T5.8.1.3" class="ltx_td ltx_align_left ltx_border_r ltx_border_tt" style="padding:0.3pt 5.0pt;" rowspan="2"><span id="A1.T5.8.1.3.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Attack Method</span></td>
