<tr id="A1.T1.3.7" class="ltx_tr">
<td id="A1.T1.3.7.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m6" class="ltx_Math" alttext="\pi_{r,\lambda}" display="inline" intent=":literal"><semantics><msub><mi>π</mi><mrow><mi>r</mi><mo>,</mo><mi>λ</mi></mrow></msub><annotation encoding="application/x-tex">\pi_{r,\lambda}</annotation></semantics></math></td>
<td id="A1.T1.3.7.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">optimally aligned language model policy for reward <math id="A1.T1.m7" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and penalty <math id="A1.T1.m8" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.8" class="ltx_tr">
<td id="A1.T1.3.8.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m9" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math></td>
<td id="A1.T1.3.8.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">general reward model function</td></tr>
<tr id="A1.T1.3.9" class="ltx_tr">
<td id="A1.T1.3.9.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m10" class="ltx_Math" alttext="r^{*}" display="inline" intent=":literal"><semantics><msup><mi>r</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">r^{*}</annotation></semantics></math></td>
<td id="A1.T1.3.9.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">ideal (gold) reward model</td></tr>
<tr id="A1.T1.3.10" class="ltx_tr">
<td id="A1.T1.3.10.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m11" class="ltx_Math" alttext="\tilde{r}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>r</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\tilde{r}</annotation></semantics></math></td>
<td id="A1.T1.3.10.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">proxy reward model</td></tr>
<tr id="A1.T1.3.11" class="ltx_tr">
<td id="A1.T1.3.11.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m12" class="ltx_math_unparsed" alttext="\texttt{KL}(P||Q)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">KL</mtext><mrow><mo stretchy="false">(</mo><mi>P</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{KL}(P||Q)</annotation></semantics></math></td>
<td id="A1.T1.3.11.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Kullback-Leibler divergence between distributions <math id="A1.T1.m13" class="ltx_Math" alttext="P" display="inline" intent=":literal"><semantics><mi>P</mi><annotation encoding="application/x-tex">P</annotation></semantics></math> and <math id="A1.T1.m14" class="ltx_Math" alttext="Q" display="inline" intent=":literal"><semantics><mi>Q</mi><annotation encoding="application/x-tex">Q</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.12" class="ltx_tr">
<td id="A1.T1.3.12.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m15" class="ltx_math_unparsed" alttext="\texttt{JD}(P||Q)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">JD</mtext><mrow><mo stretchy="false">(</mo><mi>P</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{JD}(P||Q)</annotation></semantics></math></td>
<td id="A1.T1.3.12.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Jeffreys divergence, i.e., <math id="A1.T1.m16" class="ltx_math_unparsed" alttext="\texttt{JD}(P||Q)\triangleq\texttt{KL}(P||Q)+\texttt{KL}(Q||P)" display="inline" intent=":literal"><semantics><mrow><mtext class="ltx_mathvariant_monospace">JD</mtext><mrow><mo stretchy="false">(</mo><mi>P</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow><mo>≜</mo><mtext class="ltx_mathvariant_monospace">KL</mtext><mrow><mo stretchy="false">(</mo><mi>P</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>Q</mi><mo stretchy="false">)</mo></mrow><mo>+</mo><mtext class="ltx_mathvariant_monospace">KL</mtext><mrow><mo stretchy="false">(</mo><mi>Q</mi><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>P</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\texttt{JD}(P||Q)\triangleq\texttt{KL}(P||Q)+\texttt{KL}(Q||P)</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.13" class="ltx_tr">
<td id="A1.T1.3.13.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m17" class="ltx_Math" alttext="\Delta(r,r^{\prime})" display="inline" intent=":literal"><semantics><mrow><mi mathvariant="normal">Δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><msup><mi>r</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\Delta(r,r^{\prime})</annotation></semantics></math></td>
<td id="A1.T1.3.13.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">expected reward gain measured with <math id="A1.T1.m18" class="ltx_Math" alttext="r^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>r</mi><mo>′</mo></msup><annotation encoding="application/x-tex">r^{\prime}</annotation></semantics></math> after aligning with <math id="A1.T1.m19" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.14" class="ltx_tr">
<td id="A1.T1.3.14.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m20" class="ltx_Math" alttext="\widehat{\Delta}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi mathvariant="normal">Δ</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widehat{\Delta}_{n}</annotation></semantics></math></td>
<td id="A1.T1.3.14.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">Monte Carlo estimator for the expected reward gain</td></tr>
<tr id="A1.T1.3.15" class="ltx_tr">
<td id="A1.T1.3.15.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m21" class="ltx_Math" alttext="\mathcal{N}(\mathbf{x},\mathbf{y})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mathbf{x},\mathbf{y})</annotation></semantics></math></td>
<td id="A1.T1.3.15.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">preference residual between gold and proxy rewards, i.e., <math id="A1.T1.m22" class="ltx_Math" alttext="\mathcal{N}(\mathbf{x},\mathbf{y})\triangleq\tilde{r}-r^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo>,</mo><mi>𝐲</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≜</mo><mrow><mover accent="true"><mi>r</mi><mo>~</mo></mover><mo>−</mo><msup><mi>r</mi><mo>∗</mo></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mathbf{x},\mathbf{y})\triangleq\tilde{r}-r^{*}</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.16" class="ltx_tr">
<td id="A1.T1.3.16.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m23" class="ltx_Math" alttext="Z_{r,\lambda}(\mathbf{x})" display="inline" intent=":literal"><semantics><mrow><msub><mi>Z</mi><mrow><mi>r</mi><mo>,</mo><mi>λ</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>𝐱</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">Z_{r,\lambda}(\mathbf{x})</annotation></semantics></math></td>
<td id="A1.T1.3.16.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">partition function for the tilted distribution</td></tr>
<tr id="A1.T1.3.17" class="ltx_tr">
<td id="A1.T1.3.17.1" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m24" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></td>
<td id="A1.T1.3.17.2" class="ltx_td ltx_align_left" style="padding-top:0.5pt;padding-bottom:0.5pt;">number of samples per query generated for best-of-<math id="A1.T1.m25" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math></td></tr>
<tr id="A1.T1.3.18" class="ltx_tr">
<td id="A1.T1.3.18.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="A1.T1.m26" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math></td>
<td id="A1.T1.3.18.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding-top:0.5pt;padding-bottom:0.5pt;">number of base model samples per query used for Monte Carlo estimation</td></tr>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table"><span id="A1.T1.4" class="ltx_text" style="font-size:90%;">Table 1</span>: </span><span id="A1.T1.5" class="ltx_text" style="font-size:90%;">Notation used throughout the main paper and appendix.</span></figcaption>
