<td id="A5.T2.st1.3.6.5" class="ltx_td ltx_align_center">2.066</td></tr>
<tr id="A5.T2.st1.3.7" class="ltx_tr">
<td id="A5.T2.st1.3.7.1" class="ltx_td ltx_align_left">1e-2</td>
