<td id="A4.T8.2.3.3" class="ltx_td ltx_align_center"><span id="A4.T8.2.3.3.1" class="ltx_text" style="font-size:90%;">0.0019</span></td>
<td id="A4.T8.2.3.4" class="ltx_td ltx_align_center"><span id="A4.T8.2.3.4.1" class="ltx_text" style="font-size:90%;">**</span></td></tr>
<tr id="A4.T8.2.4" class="ltx_tr">
<th id="A4.T8.2.4.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T8.2.4.1.1" class="ltx_text" style="font-size:90%;">KS test: bin 0 vs. bin 9</span></th>
<td id="A4.T8.2.4.2" class="ltx_td ltx_align_center"><math id="A4.T8.m4" class="ltx_Math" alttext="D=0.0456" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">D</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">0.0456</mn></mrow><annotation encoding="application/x-tex">D=0.0456</annotation></semantics></math></td>
<td id="A4.T8.2.4.3" class="ltx_td ltx_align_center"><math id="A4.T8.m5" class="ltx_Math" alttext="2.50\times 10^{-3}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">2.50</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">2.50\times 10^{-3}</annotation></semantics></math></td>
<td id="A4.T8.2.4.4" class="ltx_td ltx_align_center"><span id="A4.T8.2.4.4.1" class="ltx_text" style="font-size:90%;">**</span></td></tr>
<tr id="A4.T8.2.5" class="ltx_tr">
<th id="A4.T8.2.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A4.T8.2.5.1.1" class="ltx_text" style="font-size:90%;">Spearman trend (<math id="A4.T8.m6" class="ltx_Math" alttext="W_{1}" display="inline" intent=":literal"><semantics><msub><mi>W</mi><mn>1</mn></msub><annotation encoding="application/x-tex">W_{1}</annotation></semantics></math> vs. bin)</span></th>
