<td id="A1.T2.2.1.5.2" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.5.2.1" class="ltx_text" style="font-size:90%;">Weak, unidirectional</span></td>
<td id="A1.T2.2.1.5.3" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.5.3.1" class="ltx_text" style="font-size:90%;">Strong, recursive</span></td>
<td id="A1.T2.2.1.5.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.5.4.1" class="ltx_text" style="font-size:90%;">Co-evolution</span></td></tr>
