<td id="A1.T2.2.1.8.2" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.8.2.1" class="ltx_text" style="font-size:90%;">Independent, isolated</span></td>
<td id="A1.T2.2.1.8.3" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.8.3.1" class="ltx_text" style="font-size:90%;">Local neighborhood </span><math id="A1.T2.m4" class="ltx_Math" alttext="N(i)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">N</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">i</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">N(i)</annotation></semantics></math></td>
<td id="A1.T2.2.1.8.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.8.4.1" class="ltx_text" style="font-size:90%;">Network-constrained dependence</span></td></tr>
<tr id="A1.T2.2.1.9" class="ltx_tr">
<td id="A1.T2.2.1.9.1" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.9.1.1" class="ltx_text" style="font-size:90%;">Structure</span></td>
<td id="A1.T2.2.1.9.2" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.9.2.1" class="ltx_text" style="font-size:90%;">Fixed or absent</span></td>
<td id="A1.T2.2.1.9.3" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.9.3.1" class="ltx_text" style="font-size:90%;">Dynamic graph </span><math id="A1.T2.m5" class="ltx_Math" alttext="G(t)" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">G(t)</annotation></semantics></math></td>
<td id="A1.T2.2.1.9.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.9.4.1" class="ltx_text" style="font-size:90%;">Network-constrained dependence</span></td></tr>
<tr id="A1.T2.2.1.10" class="ltx_tr">
<td id="A1.T2.2.1.10.1" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.10.1.1" class="ltx_text" style="font-size:90%;">Unit of analysis</span></td>
<td id="A1.T2.2.1.10.2" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.10.2.1" class="ltx_text" style="font-size:90%;">Individual agents</span></td>
<td id="A1.T2.2.1.10.3" class="ltx_td ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.10.3.1" class="ltx_text" style="font-size:90%;">Interacting agents</span></td>
<td id="A1.T2.2.1.10.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.10.4.1" class="ltx_text" style="font-size:90%;">(overall)</span></td></tr>
<tr id="A1.T2.2.1.11" class="ltx_tr">
<td id="A1.T2.2.1.11.1" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.11.1.1" class="ltx_text" style="font-size:90%;">Evaluation target</span></td>
<td id="A1.T2.2.1.11.2" class="ltx_td ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.11.2.1" class="ltx_text" style="font-size:90%;">Task completion accuracy</span></td>
