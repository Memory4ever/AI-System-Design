<td id="A1.T2.2.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.2.3.1" class="ltx_text" style="font-size:90%;">Endogenous </span><math id="A1.T2.m2" class="ltx_Math" alttext="p_{t}(x\mid G(t),\{x_{i}(t)\})" display="inline" intent=":literal"><semantics><mrow><msub><mi mathsize="0.900em">p</mi><mi mathsize="0.900em">t</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">x</mi><mo fence="true" lspace="0em" mathsize="0.900em" rspace="0em">∣</mo><mrow><mrow><mi mathsize="0.900em">G</mi><mo>⁡</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo mathsize="0.900em">,</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mi mathsize="0.900em">x</mi><mi mathsize="0.900em">i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="0.900em" minsize="0.900em">(</mo><mi mathsize="0.900em">t</mi><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><mo maxsize="0.900em" minsize="0.900em">)</mo></mrow></mrow><annotation encoding="application/x-tex">p_{t}(x\mid G(t),\{x_{i}(t)\})</annotation></semantics></math></td>
