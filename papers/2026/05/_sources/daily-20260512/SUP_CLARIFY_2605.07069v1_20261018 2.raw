<td id="A4.T4.2.1.3.4" class="ltx_td ltx_align_center"><math id="A4.T4.m9" class="ltx_Math" alttext="0.00" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.00</mn><annotation encoding="application/x-tex">0.00</annotation></semantics></math></td>
