<th id="A4.T4.2.1.1.7" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><span id="A4.T4.2.1.1.7.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MWU <math id="A4.T4.m4" class="ltx_Math" alttext="p" display="inline" intent=":literal"><semantics><mi>p</mi><annotation encoding="application/x-tex">p</annotation></semantics></math></span></th>
