<td id="A1.T2.2.1.11.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.11.4.1" class="ltx_text" style="font-size:90%;">(overall)</span></td></tr>
