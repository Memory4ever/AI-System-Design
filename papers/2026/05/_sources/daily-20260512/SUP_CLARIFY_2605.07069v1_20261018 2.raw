<td id="A1.T2.2.1.7.4" class="ltx_td ltx_nopad_r ltx_align_left" style="padding:0.45pt 4.0pt;"><span id="A1.T2.2.1.7.4.1" class="ltx_text" style="font-size:90%;">Strategic heterogeneity</span></td></tr>
