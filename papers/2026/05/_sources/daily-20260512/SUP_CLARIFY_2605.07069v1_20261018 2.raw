<td id="A4.T4.2.1.2.6" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T4.2.1.2.6.1" class="ltx_text" style="font-size:90%;">183917</span></td>
<td id="A4.T4.2.1.2.7" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T4.m7" class="ltx_Math" alttext="8.91\times 10^{-126}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">8.91</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">126</mn></mrow></msup></mrow><annotation encoding="application/x-tex">8.91\times 10^{-126}</annotation></semantics></math></td>
