<td id="A4.T4.2.1.3.7" class="ltx_td ltx_align_center"><math id="A4.T4.m10" class="ltx_Math" alttext="5.74\times 10^{-281}" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">5.74</mn><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><msup><mn mathsize="0.900em">10</mn><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">281</mn></mrow></msup></mrow><annotation encoding="application/x-tex">5.74\times 10^{-281}</annotation></semantics></math></td>
<td id="A4.T4.2.1.3.8" class="ltx_td ltx_align_center"><span id="A4.T4.2.1.3.8.1" class="ltx_text" style="font-size:90%;">Yes</span></td>
<td id="A4.T4.2.1.3.9" class="ltx_td ltx_align_center"><math id="A4.T4.m11" class="ltx_Math" alttext="-0.949" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">−</mo><mn mathsize="0.900em">0.949</mn></mrow><annotation encoding="application/x-tex">-0.949</annotation></semantics></math></td></tr>
