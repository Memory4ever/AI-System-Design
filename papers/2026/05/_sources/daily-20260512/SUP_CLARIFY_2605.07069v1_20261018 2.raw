<td id="A4.T8.2.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A4.T8.m1" class="ltx_Math" alttext="W=36.0" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">W</mi><mo mathsize="0.900em">=</mo><mn mathsize="0.900em">36.0</mn></mrow><annotation encoding="application/x-tex">W=36.0</annotation></semantics></math></td>
<td id="A4.T8.2.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T8.2.2.3.1" class="ltx_text" style="font-size:90%;">0.0039</span></td>
<td id="A4.T8.2.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T8.2.2.4.1" class="ltx_text" style="font-size:90%;">**</span></td></tr>
<tr id="A4.T8.2.3" class="ltx_tr">
<th id="A4.T8.2.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T8.2.3.1.1" class="ltx_text" style="font-size:90%;">One-sample <math id="A4.T8.m2" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math>-test vs. 0 (one-tailed)</span></th>
