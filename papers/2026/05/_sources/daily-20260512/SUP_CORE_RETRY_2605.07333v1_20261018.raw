<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E50.m1" class="ltx_Math" alttext="\displaystyle\leq{}" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq{}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E50.m2" class="ltx_Math" alttext="\displaystyle C_{\ref{lem:concentration-Mn},5}\,\|\hat{\mu}_{n}-\mu_{\pi}\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><msub><mi>μ</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle C_{\ref{lem:concentration-Mn},5}\,\|\hat{\mu}_{n}-\mu_{\pi}\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.3" class="ltx_p"><span id="A4.SS1.p2.3.1" class="ltx_text">where <math id="A4.SS1.p2.m3" class="ltx_Math" alttext="C_{\ref{lem:concentration-Mn},5}\doteq 2\exp(4C_x^2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>5</mn></mrow></msub><mo>≐</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>x</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lem:concentration-Mn},5}\doteq 2\exp(4C_x^2)</annotation></semantics></math>.
Summing over <math id="A4.SS1.p2.m4" class="ltx_Math" alttext="s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in\mathcal{S}</annotation></semantics></math> and taking the maximum over <math id="A4.SS1.p2.m5" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> gives</span></p>
<table id="A4.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E51.m1" class="ltx_Math" alttext="\|\widehat{M}_{n}-M_{\pi}\|_{\infty}\leq|\mathcal{S}|\,C_{\ref{lem:concentration-Mn},5}\,C_{\ref{lem:concentration-Mn},3}\sqrt{\frac{\log(C_{\ref{lem:concentration-Mn},4}/\delta)}{n}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><msub><mi>M</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\widehat{M}_{n}-M_{\pi}\|_{\infty}\leq|\mathcal{S}|\,C_{\ref{lem:concentration-Mn},5}\,C_{\ref{lem:concentration-Mn},3}\sqrt{\frac{\log(C_{\ref{lem:concentration-Mn},4}/\delta)}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.4" class="ltx_p"><span id="A4.SS1.p2.4.1" class="ltx_text">Setting
<math id="A4.SS1.p2.m6" class="ltx_Math" alttext="C_{\ref{lem:concentration-Mn},1}\doteq|\mathcal{S}|\,C_{\ref{lem:concentration-Mn},3}\,C_{\ref{lem:concentration-Mn},5}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>5</mn></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lem:concentration-Mn},1}\doteq|\mathcal{S}|\,C_{\ref{lem:concentration-Mn},3}\,C_{\ref{lem:concentration-Mn},5}</annotation></semantics></math>
and
<math id="A4.SS1.p2.m7" class="ltx_Math" alttext="C_{\ref{lem:concentration-Mn},2}\doteq C_{\ref{lem:concentration-Mn},4}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\ref{lem:concentration-Mn},2}\doteq C_{\ref{lem:concentration-Mn},4}</annotation></semantics></math>
completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Proof of Lemma <span id="A4.SS2.2" class="ltx_text"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a></span></h3>

<div id="Thmlemma5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma5.2" class="ltx_text ltx_font_bold">Lemma 5</span></span><span id="Thmlemma5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma5.p1" class="ltx_para">
<p id="Thmlemma5.p1.1" class="ltx_p"><span id="Thmlemma5.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>,
for any <math id="Thmlemma5.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>,
there exist a constant <math id="Thmlemma5.p1.m2" class="ltx_Math" alttext="C_{\ref{lem:contraction}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{\ref{lem:contraction}}&gt;0</annotation></semantics></math> such that
if <math id="Thmlemma5.p1.m3" class="ltx_Math" alttext="n\geq C_{\ref{lem:contraction}}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\ref{lem:contraction}}\log(1/\delta)</annotation></semantics></math>,
then with probability at least <math id="Thmlemma5.p1.m4" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A4.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E52.m1" class="ltx_Math" alttext="\|\widehat{\mathcal{T}}_{\widetilde{K}}(v)-\widehat{\mathcal{T}}_{\widetilde{K}}(u)\|_{\infty}\leq(1-C_{\ref{ass:diagonal-margin}})\|v-u\|_{\infty}\quad\forall\,u,v\in\mathbb{R}^{|\mathcal{S}|}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mspace style="width:1.167em;" width="1.167em"></mspace><mrow><mo rspace="0.337em">∀</mo><mi>u</mi></mrow><mo>,</mo><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\widehat{\mathcal{T}}_{\widetilde{K}}(v)-\widehat{\mathcal{T}}_{\widetilde{K}}(u)\|_{\infty}\leq(1-C_{\ref{ass:diagonal-margin}})\|v-u\|_{\infty}\quad\forall\,u,v\in\mathbb{R}^{|\mathcal{S}|}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p"><span id="A4.SS2.p1.1.1" class="ltx_text">By (<a href="#S5.E25" title="In 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>), for any <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="u,v\in\mathbb{R}^{|\mathcal{S}|}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>u</mi><mo>,</mo><mi>v</mi></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow></msup></mrow><annotation encoding="application/x-tex">u,v\in\mathbb{R}^{|\mathcal{S}|}</annotation></semantics></math>,</span></p>
<table id="A4.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E53.m1" class="ltx_Math" alttext="\widehat{\mathcal{T}}_{\widetilde{K}}(v)-\widehat{\mathcal{T}}_{\widetilde{K}}(u)=(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(v-u)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>v</mi><mo>−</mo><mi>u</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{T}}_{\widetilde{K}}(v)-\widehat{\mathcal{T}}_{\widetilde{K}}(u)=(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(v-u).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.2" class="ltx_p"><span id="A4.SS2.p1.2.1" class="ltx_text">Since <math id="A4.SS2.p1.m2" class="ltx_Math" alttext="\widehat{M}_{n}(s,s^{\prime})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{M}_{n}(s,s^{\prime})\geq 0</annotation></semantics></math> with <math id="A4.SS2.p1.m3" class="ltx_Math" alttext="\sum_{s^{\prime}}\widehat{M}_{n}(s,s^{\prime})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><msup><mi>s</mi><mo>′</mo></msup></msub><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{s^{\prime}}\widehat{M}_{n}(s,s^{\prime})=1</annotation></semantics></math>,
and <math id="A4.SS2.p1.m4" class="ltx_Math" alttext="\widehat{P}_{n}(s,s^{\prime})\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widehat{P}_{n}(s,s^{\prime})\geq 0</annotation></semantics></math> with <math id="A4.SS2.p1.m5" class="ltx_Math" alttext="\sum_{s^{\prime}}\widehat{P}_{n}(s,s^{\prime})=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><msup><mi>s</mi><mo>′</mo></msup></msub><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{s^{\prime}}\widehat{P}_{n}(s,s^{\prime})=1</annotation></semantics></math>,
the <math id="A4.SS2.p1.m6" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math>-norm of row <math id="A4.SS2.p1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math> satisfies</span></p>
<table id="A4.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex19"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex19.m1" class="ltx_Math" alttext="\displaystyle\sum_{s^{\prime}}\big|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(s,s^{\prime})\big|" display="inline" intent=":literal"><semantics><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>s</mi><mo>′</mo></msup></munder></mstyle><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{s^{\prime}}\big|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(s,s^{\prime})\big|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex19.m2" class="ltx_Math" alttext="\displaystyle\leq\big(1-\widehat{M}_{n}(s,s)\big)+\sum_{s^{\prime}\neq s}\widehat{M}_{n}(s,s^{\prime})+\gamma\sum_{s^{\prime}}\widehat{P}_{n}(s,s^{\prime})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>≠</mo><mi>s</mi></mrow></munder></mstyle><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><msup><mi>s</mi><mo>′</mo></msup></munder></mstyle><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\big(1-\widehat{M}_{n}(s,s)\big)+\sum_{s^{\prime}\neq s}\widehat{M}_{n}(s,s^{\prime})+\gamma\sum_{s^{\prime}}\widehat{P}_{n}(s,s^{\prime})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E54.m1" class="ltx_Math" alttext="\displaystyle=2\big(1-\widehat{M}_{n}(s,s)\big)+\gamma." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>+</mo><mi>γ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2\big(1-\widehat{M}_{n}(s,s)\big)+\gamma.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.3" class="ltx_p"><span id="A4.SS2.p1.3.1" class="ltx_text">Choosing
<math id="A4.SS2.p1.m8" class="ltx_Math" alttext="C_{\ref{lem:contraction}}\doteq(2C_{\ref{lem:concentration-Mn}}/C_{\ref{ass:diagonal-margin}})^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub><mo>≐</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext></msub></mrow><mo>/</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">C_{\ref{lem:contraction}}\doteq(2C_{\ref{lem:concentration-Mn}}/C_{\ref{ass:diagonal-margin}})^{2}</annotation></semantics></math>,
then by Lemma <a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>,
with probability at least <math id="A4.SS2.p1.m9" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A4.E55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E55.m1" class="ltx_Math" alttext="\|\widehat{M}_{n}-M_{\pi}\|_{\infty}\leq C_{\ref{lem:concentration-Mn},1}\sqrt{\frac{\log(2C_{\ref{lem:concentration-Mn},2}/\delta)}{n}}\leq\frac{C_{\ref{ass:diagonal-margin}}}{2}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><msub><mi>M</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma4" title="Lemma 4. ‣ D.1 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">4</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub></mrow><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow><mo>≤</mo><mfrac><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub><mn>2</mn></mfrac></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|\widehat{M}_{n}-M_{\pi}\|_{\infty}\leq C_{\ref{lem:concentration-Mn},1}\sqrt{\frac{\log(2C_{\ref{lem:concentration-Mn},2}/\delta)}{n}}\leq\frac{C_{\ref{ass:diagonal-margin}}}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.4" class="ltx_p"><span id="A4.SS2.p1.4.1" class="ltx_text">On this event, Assumption <a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a> gives</span></p>
<table id="A4.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E56.m1" class="ltx_Math" alttext="\widehat{M}_{n}(s,s)\geq M_{\pi}(s,s)-\frac{C_{\ref{ass:diagonal-margin}}}{2}\geq\frac{1+\gamma}{2}+C_{\ref{ass:diagonal-margin}}-\frac{C_{\ref{ass:diagonal-margin}}}{2}=\frac{1+\gamma}{2}+\frac{C_{\ref{ass:diagonal-margin}}}{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>M</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mfrac><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub><mn>2</mn></mfrac></mrow><mo>≥</mo><mrow><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mn>2</mn></mfrac><mo>+</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo>−</mo><mfrac><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub><mn>2</mn></mfrac></mrow><mo>=</mo><mrow><mfrac><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mn>2</mn></mfrac><mo>+</mo><mfrac><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub><mn>2</mn></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\widehat{M}_{n}(s,s)\geq M_{\pi}(s,s)-\frac{C_{\ref{ass:diagonal-margin}}}{2}\geq\frac{1+\gamma}{2}+C_{\ref{ass:diagonal-margin}}-\frac{C_{\ref{ass:diagonal-margin}}}{2}=\frac{1+\gamma}{2}+\frac{C_{\ref{ass:diagonal-margin}}}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.5" class="ltx_p"><span id="A4.SS2.p1.5.1" class="ltx_text">Therefore,</span></p>
<table id="A4.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E57.m1" class="ltx_Math" alttext="\|I-\widehat{M}_{n}+\gamma\widehat{P}_{n}\|_{\infty}=\max_{s\in\mathcal{S}}\sum_{s^{\prime}}\big|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(s,s^{\prime})\big|\leq 2\bigg(1-\frac{1+\gamma}{2}-\frac{C_{\ref{ass:diagonal-margin}}}{2}\bigg)+\gamma=1-C_{\ref{ass:diagonal-margin}}," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mmultiscripts><munder><mo movablelimits="false">∑</mo><msup><mi>s</mi><mo>′</mo></msup></munder><mprescripts></mprescripts><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mrow></mrow></mmultiscripts><mo lspace="0em">⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo>,</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="2.100em" minsize="2.100em">(</mo><mrow><mn>1</mn><mo>−</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mn>2</mn></mfrac><mo>−</mo><mfrac><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub><mn>2</mn></mfrac></mrow><mo maxsize="2.100em" minsize="2.100em">)</mo></mrow></mrow><mo>+</mo><mi>γ</mi></mrow><mo>=</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|I-\widehat{M}_{n}+\gamma\widehat{P}_{n}\|_{\infty}=\max_{s\in\mathcal{S}}\sum_{s^{\prime}}\big|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(s,s^{\prime})\big|\leq 2\bigg(1-\frac{1+\gamma}{2}-\frac{C_{\ref{ass:diagonal-margin}}}{2}\bigg)+\gamma=1-C_{\ref{ass:diagonal-margin}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p1.6" class="ltx_p"><span id="A4.SS2.p1.6.1" class="ltx_text">which completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Proof of Lemma <span id="A4.SS3.2" class="ltx_text"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></span></h3>

<div id="Thmlemma6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma6.2" class="ltx_text ltx_font_bold">Lemma 6</span></span><span id="Thmlemma6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma6.p1" class="ltx_para">
<p id="Thmlemma6.p1.1" class="ltx_p"><span id="Thmlemma6.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma6.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>,
there exists a constant <math id="Thmlemma6.p1.m2" class="ltx_Math" alttext="C_{\ref{lem:bias},1},C_{\ref{lem:bias},2}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>,</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lem:bias},1},C_{\ref{lem:bias},2}&gt;0</annotation></semantics></math> such that with probability at least <math id="Thmlemma6.p1.m3" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A4.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E58.m1" class="ltx_Math" alttext="T_{2}\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{2}\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS3.p1" class="ltx_para">
<p id="A4.SS3.p1.1" class="ltx_p"><span id="A4.SS3.p1.1.1" class="ltx_text">For each <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math>, expanding <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="\widehat{P}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widehat{P}_{n}</annotation></semantics></math> and <math id="A4.SS3.p1.m3" class="ltx_Math" alttext="\widehat{M}_{n}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><annotation encoding="application/x-tex">\widehat{M}_{n}</annotation></semantics></math> in (<a href="#S5.E24" title="In 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) gives</span></p>
<table id="A4.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex20"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex20.m1" class="ltx_Math" alttext="\displaystyle\absolutevalue{[(\wP_n - \wM_n P_\pi)\,v_\pi](s)}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{[(\wP_n - \wM_n P_\pi)\,v_\pi](s)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex20.m2" class="ltx_Math" alttext="\displaystyle=\absolutevalue{\sum_{k=1}^n K(S_{k-1}, s)
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(S_{k-1})\bigr]}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><mrow><mi>K</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>v</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\absolutevalue{\sum_{k=1}^n K(S_{k-1}, s)
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(S_{k-1})\bigr]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex21"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex21.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\sum_{s^{\prime}\in\mathcal{S}}\exp(\langle x(s), x(s')\rangle)\absolutevalue{\sum_{k=1}^n \ind\{S_{k-1}=s'\}
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(s')\bigr]}}{\sum_{m=1}^{n}\exp(\langle x(s), x(S_{m-1})\rangle)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mo>∑</mo><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="false">|</mo><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>v</mi><msub><mrow></mrow><mi>π</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>π</mi></msub><mi>v</mi><msub><mrow></mrow><mi>π</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo fence="false">|</mo></mrow></mrow></mrow><mrow><msubsup><mo>∑</mo><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>m</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\sum_{s^{\prime}\in\mathcal{S}}\exp(\langle x(s), x(s')\rangle)\absolutevalue{\sum_{k=1}^n \ind\{S_{k-1}=s'\}
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(s')\bigr]}}{\sum_{m=1}^{n}\exp(\langle x(s), x(S_{m-1})\rangle)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E59"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E59.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{C_{\ref{lem:bias},3}}{n}\;\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\sum_{k=1}^n \ind\{S_{k-1}=s'\}
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(s')\bigr]}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mi>n</mi></mfrac></mstyle><mo lspace="0.447em" rspace="0em">​</mo><munder><mi>max</mi><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mn>𝟙</mn><mo stretchy="false">{</mo><mi>S</mi><msub><mrow></mrow><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>=</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">}</mo><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>v</mi><msub><mrow></mrow><mi>π</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>k</mi></msub><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mi>P</mi><msub><mrow></mrow><mi>π</mi></msub><mi>v</mi><msub><mrow></mrow><mi>π</mi></msub><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mi>s</mi><msup><mrow></mrow><mo>′</mo></msup><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo fence="false" rspace="0.167em">|</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{C_{\ref{lem:bias},3}}{n}\;\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\sum_{k=1}^n \ind\{S_{k-1}=s'\}
\bigl[v_\pi(S_k) - (P_\pi v_\pi)(s')\bigr]},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(59)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.2" class="ltx_p"><span id="A4.SS3.p1.2.1" class="ltx_text">where <math id="A4.SS3.p1.m4" class="ltx_Math" alttext="C_{\ref{lem:bias},3}\doteq|\mathcal{S}|\exp(2C_x^2)" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo>≐</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mi>x</mi><mn>2</mn></msubsup></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lem:bias},3}\doteq|\mathcal{S}|\exp(2C_x^2)</annotation></semantics></math>.
For each <math id="A4.SS3.p1.m5" class="ltx_Math" alttext="s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in\mathcal{S}</annotation></semantics></math>, define
<math id="A4.SS3.p1.m6" class="ltx_Math" alttext="g_{s^{\prime}}\colon\mathcal{S}\times\mathcal{S}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">g_{s^{\prime}}\colon\mathcal{S}\times\mathcal{S}\to\mathbb{R}</annotation></semantics></math> by</span></p>
<table id="A4.E60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E60.m1" class="ltx_math_unparsed" alttext="g_{s^{\prime}}(a,b)\doteq\mathbbm{1}\{a=s^{\prime}\}\bigl[v_{\pi}(b)-(P_{\pi}v_{\pi})(s^{\prime})\bigr]," display="block" intent=":literal"><semantics><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>≐</mo><mn>𝟙</mn><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>=</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>v</mi><mi>π</mi></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>π</mi></msub><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">g_{s^{\prime}}(a,b)\doteq\mathbbm{1}\{a=s^{\prime}\}\bigl[v_{\pi}(b)-(P_{\pi}v_{\pi})(s^{\prime})\bigr],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.3" class="ltx_p"><span id="A4.SS3.p1.3.1" class="ltx_text">so that <math id="A4.SS3.p1.m7" class="ltx_Math" alttext="g_{s^{\prime}}\in[-2\|v_{\pi}\|_{\infty},\;2\|v_{\pi}\|_{\infty}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo>,</mo><mrow><mn> 2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">g_{s^{\prime}}\in[-2\|v_{\pi}\|_{\infty},\;2\|v_{\pi}\|_{\infty}]</annotation></semantics></math>
and the inner sum in (<a href="#A4.Ex20" title="In Proof. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">59</span></a>) equals
<math id="A4.SS3.p1.m8" class="ltx_Math" alttext="\sum_{k=1}^{n}g_{s^{\prime}}(S_{k-1},S_{k})" display="inline" intent=":literal"><semantics><mrow><msubsup><mo>∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{n}g_{s^{\prime}}(S_{k-1},S_{k})</annotation></semantics></math>.
The pair process <math id="A4.SS3.p1.m9" class="ltx_Math" alttext="(S_{k-1},S_{k})_{k\geq 1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mi>k</mi><mo>≥</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">(S_{k-1},S_{k})_{k\geq 1}</annotation></semantics></math> is a Markov chain
on the support <math id="A4.SS3.p1.m10" class="ltx_Math" alttext="E\doteq\{(a,b)\in\mathcal{S}\times\mathcal{S}:P_{\pi}(a,b)&gt;0\}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>≐</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></mrow><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mrow><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">E\doteq\{(a,b)\in\mathcal{S}\times\mathcal{S}:P_{\pi}(a,b)&gt;0\}</annotation></semantics></math>.
Since <math id="A4.SS3.p1.m11" class="ltx_Math" alttext="P_{\pi}" display="inline" intent=":literal"><semantics><msub><mi>P</mi><mi>π</mi></msub><annotation encoding="application/x-tex">P_{\pi}</annotation></semantics></math> is ergodic on <math id="A4.SS3.p1.m12" class="ltx_Math" alttext="\mathcal{S}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒮</mi><annotation encoding="application/x-tex">\mathcal{S}</annotation></semantics></math>, the pair chain is ergodic on <math id="A4.SS3.p1.m13" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>
with stationary distribution
<math id="A4.SS3.p1.m14" class="ltx_Math" alttext="\widetilde{\pi}(a,b)=\mu_{\pi}(a)\,P_{\pi}(a,b)" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>π</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>μ</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\pi}(a,b)=\mu_{\pi}(a)\,P_{\pi}(a,b)</annotation></semantics></math>, under which</span></p>
<table id="A4.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex22"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex22.m1" class="ltx_Math" alttext="\displaystyle\widetilde{\pi}(g_{s^{\prime}})" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>π</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\widetilde{\pi}(g_{s^{\prime}})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex22.m2" class="ltx_math_unparsed" alttext="\displaystyle=\sum_{a,b}\mu_{\pi}(a)\,P_{\pi}(a,b)\,\mathbbm{1}\{a=s^{\prime}\}\bigl[v_{\pi}(b)-(P_{\pi}v_{\pi})(s^{\prime})\bigr]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>a</mi><mo>,</mo><mi>b</mi></mrow></munder></mstyle><msub><mi>μ</mi><mi>π</mi></msub><mrow><mo stretchy="false">(</mo><mi>a</mi><mo rspace="0.170em" stretchy="false">)</mo></mrow><msub><mi>P</mi><mi>π</mi></msub><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mn class="ltx_mathvariant_double-struck" mathvariant="double-struck"> 1</mn><mrow><mo stretchy="false">{</mo><mi>a</mi><mo>=</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">}</mo></mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><msub><mi>v</mi><mi>π</mi></msub><mrow><mo stretchy="false">(</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>π</mi></msub><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{a,b}\mu_{\pi}(a)\,P_{\pi}(a,b)\,\mathbbm{1}\{a=s^{\prime}\}\bigl[v_{\pi}(b)-(P_{\pi}v_{\pi})(s^{\prime})\bigr]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E61"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E61.m1" class="ltx_Math" alttext="\displaystyle=\mu_{\pi}(s^{\prime})\bigl[(P_{\pi}v_{\pi})(s^{\prime})-(P_{\pi}v_{\pi})(s^{\prime})\bigr]=0." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>μ</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mu_{\pi}(s^{\prime})\bigl[(P_{\pi}v_{\pi})(s^{\prime})-(P_{\pi}v_{\pi})(s^{\prime})\bigr]=0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(61)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.4" class="ltx_p"><span id="A4.SS3.p1.4.1" class="ltx_text">Let <math id="A4.SS3.p1.m15" class="ltx_Math" alttext="\widetilde{\lambda}_{r}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>r</mi></msub><annotation encoding="application/x-tex">\widetilde{\lambda}_{r}</annotation></semantics></math> denote the right spectral gap parameter
of the pair chain as defined in Lemma <a href="#Thmlemma2" title="Lemma 2 (Theorem 12 of ( ) ). ‣ Appendix A Auxiliary Lemmas ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a> and
<math id="A4.SS3.p1.m16" class="ltx_Math" alttext="\widetilde{\mu}_{\min}\doteq\min_{(a,b)\in E}\,\mu_{\pi}(a)\,P_{\pi}(a,b)&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>min</mi></msub><mo>≐</mo><mrow><mrow><msub><mi>min</mi><mrow><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow><mo>∈</mo><mi>E</mi></mrow></msub><mo lspace="0.167em">⁡</mo><msub><mi>μ</mi><mi>π</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo>,</mo><mi>b</mi><mo stretchy="false">)</mo></mrow></mrow><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\widetilde{\mu}_{\min}\doteq\min_{(a,b)\in E}\,\mu_{\pi}(a)\,P_{\pi}(a,b)&gt;0</annotation></semantics></math>.
Applying Lemma <a href="#Thmlemma2" title="Lemma 2 (Theorem 12 of ( ) ). ‣ Appendix A Auxiliary Lemmas ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>
to the pair chain with function <math id="A4.SS3.p1.m17" class="ltx_Math" alttext="g_{s^{\prime}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><annotation encoding="application/x-tex">g_{s^{\prime}}</annotation></semantics></math>
and a union bound over <math id="A4.SS3.p1.m18" class="ltx_Math" alttext="s^{\prime}\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s^{\prime}\in\mathcal{S}</annotation></semantics></math>,
with probability at least <math id="A4.SS3.p1.m19" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A4.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E62.m1" class="ltx_Math" alttext="\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\frac{1}{n}\sum_{k=1}^n g_{s'}(S_{k-1}, S_k)}\leq 2\|v_{\pi}\|_{\infty}\sqrt{\frac{2(1+\max\{\widetilde{\lambda}_{r},0\})}{1-\max\{\widetilde{\lambda}_{r},0\}}}\sqrt{\frac{\log(4|\fS|/(\widetilde\mu_{\min}\,\delta))}{n}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><munder><mi>max</mi><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mo lspace="0.280em">⁡</mo><mrow><mo>|</mo><mrow><mfrac><mn>1</mn><mi>n</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>r</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>r</mi></msub><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow></mrow><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\frac{1}{n}\sum_{k=1}^n g_{s'}(S_{k-1}, S_k)}\leq 2\|v_{\pi}\|_{\infty}\sqrt{\frac{2(1+\max\{\widetilde{\lambda}_{r},0\})}{1-\max\{\widetilde{\lambda}_{r},0\}}}\sqrt{\frac{\log(4|\fS|/(\widetilde\mu_{\min}\,\delta))}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.5" class="ltx_p"><span id="A4.SS3.p1.5.1" class="ltx_text">Substituting (<a href="#A4.E62" title="In Proof. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">62</span></a>) into (<a href="#A4.Ex20" title="In Proof. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">59</span></a>)
and taking the max over <math id="A4.SS3.p1.m20" class="ltx_Math" alttext="s\in\mathcal{S}" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow><annotation encoding="application/x-tex">s\in\mathcal{S}</annotation></semantics></math> gives</span></p>
<table id="A4.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.E63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E63.m1" class="ltx_Math" alttext="\displaystyle T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle T_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E63.m2" class="ltx_Math" alttext="\displaystyle=\gamma\,\max_{s\in\mathcal{S}}\;\absolutevalue{[(\wP_n - \wM_n P_\pi)\,v_\pi](s)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>γ</mi><mo lspace="0.337em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\gamma\,\max_{s\in\mathcal{S}}\;\absolutevalue{[(\wP_n - \wM_n P_\pi)\,v_\pi](s)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(63)</span></td></tr></tbody>
<tbody id="A4.E64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E64.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{\gamma C_{\ref{lem:bias},3}}{n}\;\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\sum_{k=1}^n g_{s'}(S_{k-1}, S_k)}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub></mrow><mi>n</mi></mfrac></mstyle><mo lspace="0.447em" rspace="0em">​</mo><munder><mi>max</mi><mrow><msup><mi>s</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>g</mi><msup><mi>s</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{\gamma C_{\ref{lem:bias},3}}{n}\;\max_{s^{\prime}\in\mathcal{S}}\;\absolutevalue{\sum_{k=1}^n g_{s'}(S_{k-1}, S_k)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(64)</span></td></tr></tbody>
<tbody id="A4.E65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E65.m1" class="ltx_Math" alttext="\displaystyle\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(65)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.6" class="ltx_p"><span id="A4.SS3.p1.6.1" class="ltx_text">where</span></p>
<table id="A4.E66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E66.m1" class="ltx_Math" alttext="C_{\ref{lem:bias},1}\doteq 2\gamma\|v_{\pi}\|_{\infty}\sqrt{\frac{2(1+\max\{\widetilde{\lambda}_{r},0\})}{1-\max\{\widetilde{\lambda}_{r},0\}}}C_{\ref{lem:bias},3},\quad C_{\ref{lem:bias},2}\doteq\frac{4|\mathcal{S}|}{\widetilde{\mu}_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>r</mi></msub><mo>,</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>1</mn><mo>−</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mover accent="true"><mi>λ</mi><mo>~</mo></mover><mi>r</mi></msub><mo>,</mo><mn>0</mn></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub></mrow></mrow><mo rspace="1.167em">,</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>≐</mo><mfrac><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi><mo stretchy="false">|</mo></mrow></mrow><msub><mover accent="true"><mi>μ</mi><mo>~</mo></mover><mi>min</mi></msub></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{\ref{lem:bias},1}\doteq 2\gamma\|v_{\pi}\|_{\infty}\sqrt{\frac{2(1+\max\{\widetilde{\lambda}_{r},0\})}{1-\max\{\widetilde{\lambda}_{r},0\}}}C_{\ref{lem:bias},3},\quad C_{\ref{lem:bias},2}\doteq\frac{4|\mathcal{S}|}{\widetilde{\mu}_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(66)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p1.7" class="ltx_p"><span id="A4.SS3.p1.7.1" class="ltx_text">This completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.4 </span>Proof of Theorem <span id="A4.SS4.2" class="ltx_text"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></span></h3>

<div id="A4.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A4.SS4.p1" class="ltx_para">
<p id="A4.SS4.p1.1" class="ltx_p"><span id="A4.SS4.p1.1.1" class="ltx_text">We decompose the error at each layer as</span></p>
<table id="A4.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex23"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex23.m1" class="ltx_Math" alttext="\displaystyle\|v_{l+1}-v_{\pi}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|v_{l+1}-v_{\pi}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex23.m2" class="ltx_Math" alttext="\displaystyle=\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{l})-v_{\pi}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{l})-v_{\pi}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex24.m1" class="ltx_Math" alttext="\displaystyle\leq\underbrace{\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{l})-\widehat{\mathcal{T}}_{\widetilde{K}}(v_{\pi})\|_{\infty}}_{T_{1}}+\underbrace{\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{\pi})-v_{\pi}\|_{\infty}}_{T_{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder><munder accentunder="true"><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="true">⏟</mo></munder><msub><mi>T</mi><mn>1</mn></msub></munder><mo>+</mo><munder><munder accentunder="true"><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="true">⏟</mo></munder><msub><mi>T</mi><mn>2</mn></msub></munder></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\underbrace{\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{l})-\widehat{\mathcal{T}}_{\widetilde{K}}(v_{\pi})\|_{\infty}}_{T_{1}}+\underbrace{\|\widehat{\mathcal{T}}_{\widetilde{K}}(v_{\pi})-v_{\pi}\|_{\infty}}_{T_{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E67"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E67.m1" class="ltx_Math" alttext="\displaystyle\leq\underbrace{\|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(v_{l}-v_{\pi})\|_{\infty}}_{T_{1}}+\underbrace{\|\gamma(\widehat{P}_{n}-\widehat{M}_{n}P_{\pi})\,v_{\pi}\|_{\infty}}_{T_{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><munder><munder accentunder="true"><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>l</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="true">⏟</mo></munder><msub><mi>T</mi><mn>1</mn></msub></munder><mo>+</mo><munder><munder accentunder="true"><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub><mo>−</mo><mrow><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="true">⏟</mo></munder><msub><mi>T</mi><mn>2</mn></msub></munder></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\underbrace{\|(I-\widehat{M}_{n}+\gamma\widehat{P}_{n})(v_{l}-v_{\pi})\|_{\infty}}_{T_{1}}+\underbrace{\|\gamma(\widehat{P}_{n}-\widehat{M}_{n}P_{\pi})\,v_{\pi}\|_{\infty}}_{T_{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(67)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.2" class="ltx_p"><span id="A4.SS4.p1.2.1" class="ltx_text">where the second inequality uses (<a href="#S5.E25" title="In 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>) for <math id="A4.SS4.p1.m1" class="ltx_Math" alttext="T_{1}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>1</mn></msub><annotation encoding="application/x-tex">T_{1}</annotation></semantics></math>
and the Bellman equation <math id="A4.SS4.p1.m2" class="ltx_Math" alttext="r+\gamma P_{\pi}v_{\pi}=v_{\pi}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub></mrow></mrow><mo>=</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><annotation encoding="application/x-tex">r+\gamma P_{\pi}v_{\pi}=v_{\pi}</annotation></semantics></math> for <math id="A4.SS4.p1.m3" class="ltx_Math" alttext="T_{2}" display="inline" intent=":literal"><semantics><msub><mi>T</mi><mn>2</mn></msub><annotation encoding="application/x-tex">T_{2}</annotation></semantics></math>.
with probability at least <math id="A4.SS4.p1.m4" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,
if <math id="A4.SS4.p1.m5" class="ltx_Math" alttext="n\geq C_{\ref{lem:contraction}}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\ref{lem:contraction}}\log(1/\delta)</annotation></semantics></math>,
then for all <math id="A4.SS4.p1.m6" class="ltx_Math" alttext="v_{l}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>l</mi></msub><annotation encoding="application/x-tex">v_{l}</annotation></semantics></math>,</span></p>
<table id="A4.E68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E68.m1" class="ltx_Math" alttext="T_{1}\leq(1-C_{\ref{ass:diagonal-margin}})\|v_{l}-v_{\pi}\|_{\infty}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>1</mn></msub><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mi>l</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{1}\leq(1-C_{\ref{ass:diagonal-margin}})\|v_{l}-v_{\pi}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(68)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.3" class="ltx_p"><span id="A4.SS4.p1.3.1" class="ltx_text">By Lemma <a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>,
with probability at least <math id="A4.SS4.p1.m7" class="ltx_Math" alttext="1-\delta/2" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mrow><mi>δ</mi><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">1-\delta/2</annotation></semantics></math>,</span></p>
<table id="A4.E69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E69.m1" class="ltx_Math" alttext="T_{2}\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>T</mi><mn>2</mn></msub><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">T_{2}\leq C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(69)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.4" class="ltx_p"><span id="A4.SS4.p1.4.1" class="ltx_text">A union bound ensures that (<a href="#A4.E68" title="In Proof. ‣ D.4 Proof of Theorem ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">68</span></a>) and (<a href="#A4.E69" title="In Proof. ‣ D.4 Proof of Theorem ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">69</span></a>)
hold simultaneously with probability at least <math id="A4.SS4.p1.m8" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>.
On this event, iterating over <math id="A4.SS4.p1.m9" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> layers gives</span></p>
<table id="A4.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex25.m1" class="ltx_Math" alttext="\displaystyle\|v_{L}-v_{\pi}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mi>L</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|v_{L}-v_{\pi}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex25.m2" class="ltx_Math" alttext="\displaystyle\leq(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\sum_{l=0}^{L-1}(1-C_{\ref{ass:diagonal-margin}})^{l}\cdot C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mrow><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>l</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mi>l</mi></msup></mrow><mo rspace="0.222em">⋅</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\sum_{l=0}^{L-1}(1-C_{\ref{ass:diagonal-margin}})^{l}\cdot C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex26.m1" class="ltx_Math" alttext="\displaystyle=(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\frac{1-(1-C_{\ref{ass:diagonal-margin}})^{L}}{C_{\ref{ass:diagonal-margin}}}\cdot C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\frac{1-(1-C_{\ref{ass:diagonal-margin}})^{L}}{C_{\ref{ass:diagonal-margin}}}\cdot C_{\ref{lem:bias},1}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.E70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E70.m1" class="ltx_Math" alttext="\displaystyle\leq(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\frac{C_{\ref{lem:bias},1}}{C_{\ref{ass:diagonal-margin}}}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{0}-v_{\pi}\|_{\infty}+\frac{C_{\ref{lem:bias},1}}{C_{\ref{ass:diagonal-margin}}}\sqrt{\frac{\log(C_{\ref{lem:bias},2}/\delta)}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(70)</span></td></tr></tbody>
</table>
<p id="A4.SS4.p1.5" class="ltx_p"><span id="A4.SS4.p1.5.1" class="ltx_text">Choosing
<math id="A4.SS4.p1.m10" class="ltx_Math" alttext="C_{\text{Thm}\ref{thm:finite-n},1}\doteq C_{\ref{lem:contraction}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext class="ltx_mathvariant_italic"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub></mrow><annotation encoding="application/x-tex">C_{\text{Thm}\ref{thm:finite-n},1}\doteq C_{\ref{lem:contraction}}</annotation></semantics></math>,
<math id="A4.SS4.p1.m11" class="ltx_Math" alttext="C_{\text{Thm}\ref{thm:finite-n},2}\doteq C_{\ref{lem:bias},1}/C_{\ref{ass:diagonal-margin}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext class="ltx_mathvariant_italic"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo>≐</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>/</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow></mrow><annotation encoding="application/x-tex">C_{\text{Thm}\ref{thm:finite-n},2}\doteq C_{\ref{lem:bias},1}/C_{\ref{ass:diagonal-margin}}</annotation></semantics></math>,
and <math id="A4.SS4.p1.m12" class="ltx_Math" alttext="C_{\text{Thm}\ref{thm:finite-n},3}\doteq C_{\ref{lem:bias},2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext class="ltx_mathvariant_italic"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma6" title="Lemma 6. ‣ D.3 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">6</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\text{Thm}\ref{thm:finite-n},3}\doteq C_{\ref{lem:bias},2}</annotation></semantics></math>
completes the proof.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A5" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix E </span>Proofs of Section <span id="A5.2" class="ltx_text"><a href="#S6" title="6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a></span></h2>

<section id="A5.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.1 </span>Proof of Lemma <span id="A5.SS1.2" class="ltx_text"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span></h3>

<div id="Thmlemma7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma7.2" class="ltx_text ltx_font_bold">Lemma 7</span></span><span id="Thmlemma7.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma7.p1" class="ltx_para">
<p id="Thmlemma7.p1.1" class="ltx_p"><span id="Thmlemma7.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, for any <math id="Thmlemma7.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>,
there exist constants <math id="Thmlemma7.p1.m2" class="ltx_Math" alttext="C_{\text{\ref{lem:decay}},1},\;C_{\text{\ref{lem:decay}},2},\;C_{\text{\ref{lem:decay}},3}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo rspace="0.447em">,</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.447em">,</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lem:decay}},1},\;C_{\text{\ref{lem:decay}},2},\;C_{\text{\ref{lem:decay}},3}&gt;0</annotation></semantics></math>
such that if <math id="Thmlemma7.p1.m3" class="ltx_Math" alttext="n\geq C_{\text{\ref{lem:decay}},1}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\text{\ref{lem:decay}},1}\log(1/\delta)</annotation></semantics></math>,
then with probability at least <math id="Thmlemma7.p1.m4" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,
for any <math id="Thmlemma7.p1.m5" class="ltx_Math" alttext="(p,r)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p,r)</annotation></semantics></math> and query state <math id="Thmlemma7.p1.m6" class="ltx_Math" alttext="S_{n}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>n</mi></msub><annotation encoding="application/x-tex">S_{n}</annotation></semantics></math>,</span></p>
<table id="A5.E71" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E71.m1" class="ltx_Math" alttext="\absolutevalue{\E_{S_{n+1}\sim p(\cdot\mid S_n)}\big[\delta_L(\theta_*)\big]}\leq(1+\gamma)\left[(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{\pi}\|_{\infty}\;+\;C_{\text{\ref{lem:decay}},2}\sqrt{\frac{\log(C_{\tref{lem:decay},3}/\delta)}{n}}\right]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>S</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>δ</mi><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">(</mo><mi>θ</mi><msub><mrow></mrow><mo>∗</mo></msub><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo fence="false">|</mo></mrow><mo lspace="0.167em">≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo rspace="0.502em">+</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\absolutevalue{\E_{S_{n+1}\sim p(\cdot\mid S_n)}\big[\delta_L(\theta_*)\big]}\leq(1+\gamma)\left[(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{\pi}\|_{\infty}\;+\;C_{\text{\ref{lem:decay}},2}\sqrt{\frac{\log(C_{\tref{lem:decay},3}/\delta)}{n}}\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(71)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p1" class="ltx_para">
<p id="A5.SS1.p1.1" class="ltx_p"><span id="A5.SS1.p1.1.1" class="ltx_text">By (<a href="#S6.E30" title="In 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) and the linearity of expectation we have</span></p>
<table id="A5.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex27.m2" class="ltx_Math" alttext="\displaystyle\absolutevalue{\mathbb{E}_{S_{n+1}\sim p(\cdot|S_n)}\Big[r(S_n)+\gamma v_L(S_{n+1}; \theta_*) - v_L(S_n; \theta_*)\Big]}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>S</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>r</mi><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo><mo>+</mo><mi>γ</mi><mi>v</mi><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>;</mo><mi>θ</mi><msub><mrow></mrow><mo>∗</mo></msub><mo stretchy="false">)</mo><mo>−</mo><mi>v</mi><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">(</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo>;</mo><mi>θ</mi><msub><mrow></mrow><mo>∗</mo></msub><mo stretchy="false">)</mo><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{\mathbb{E}_{S_{n+1}\sim p(\cdot|S_n)}\Big[r(S_n)+\gamma v_L(S_{n+1}; \theta_*) - v_L(S_n; \theta_*)\Big]}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex28.m1" class="ltx_Math" alttext="\displaystyle={}" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle={}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex28.m2" class="ltx_Math" alttext="\displaystyle\absolutevalue{\big(r + \gamma P_\pi v_L - v_L\big)(S_n)}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>r</mi><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>L</mi></msub></mrow></mrow><mo>−</mo><msub><mi>v</mi><mi>L</mi></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{\big(r + \gamma P_\pi v_L - v_L\big)(S_n)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex29"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex29.m1" class="ltx_Math" alttext="\displaystyle={}" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle={}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex29.m2" class="ltx_Math" alttext="\displaystyle\absolutevalue{\big( (I - \gamma P_\pi)(v_\pi- v_L) \big)(S_n)}\quad\text{(using }r=(I-\gamma P_{\pi})v_{\pi}\text{)}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>π</mi></msub><mo>−</mo><msub><mi>v</mi><mi>L</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mspace style="width:1em;" width="1em"></mspace><mrow><mrow><mtext>(using </mtext><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>=</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mtext>)</mtext></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{\big( (I - \gamma P_\pi)(v_\pi- v_L) \big)(S_n)}\quad\text{(using }r=(I-\gamma P_{\pi})v_{\pi}\text{)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex30"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex30.m1" class="ltx_Math" alttext="\displaystyle\leq{}" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq{}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex30.m2" class="ltx_Math" alttext="\displaystyle\|e_{q}^{\top}(I-\gamma P_{\pi})\|_{1}\|v_{L}-v_{\pi}\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msubsup><mi>e</mi><mi>q</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>I</mi><mo>−</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>P</mi><mi>π</mi></msub></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mi>L</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\|e_{q}^{\top}(I-\gamma P_{\pi})\|_{1}\|v_{L}-v_{\pi}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E72"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E72.m1" class="ltx_Math" alttext="\displaystyle\leq{}" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\displaystyle\leq{}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E72.m2" class="ltx_Math" alttext="\displaystyle(1+\gamma)\|v_{L}-v_{\pi}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mi>L</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle(1+\gamma)\|v_{L}-v_{\pi}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(72)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.2" class="ltx_p"><span id="A5.SS1.p1.2.1" class="ltx_text">By (<a href="#S5.E29" title="In Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>), on the event of probability at least <math id="A5.SS1.p1.m1" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>
with <math id="A5.SS1.p1.m2" class="ltx_Math" alttext="n\geq C_{\text{Thm}\text{\ref{thm:finite-n}},1}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\text{Thm}\text{\ref{thm:finite-n}},1}\log(1/\delta)</annotation></semantics></math>,
we have</span></p>
<table id="A5.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E73"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E73.m1" class="ltx_Math" alttext="\displaystyle\absolutevalue{\E_{S_{n+1}\sim p(\cdot\mid S_n)}\big[\delta_L(\theta_*)\big]}" display="inline" intent=":literal"><semantics><mrow><mo fence="false" rspace="0.167em">|</mo><mrow><mi>𝔼</mi><msub><mrow></mrow><mrow><mi>S</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo lspace="0em" rspace="0.167em">∣</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msub><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>δ</mi><msub><mrow></mrow><mi>L</mi></msub><mo stretchy="false">(</mo><mi>θ</mi><msub><mrow></mrow><mo>∗</mo></msub><mo stretchy="false">)</mo><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{\E_{S_{n+1}\sim p(\cdot\mid S_n)}\big[\delta_L(\theta_*)\big]}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E73.m2" class="ltx_Math" alttext="\displaystyle\leq(1+\gamma)\left[(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{\pi}\|_{\infty}+C_{\text{Thm}\text{\ref{thm:finite-n}},2}\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+\gamma)\left[(1-C_{\ref{ass:diagonal-margin}})^{L}\|v_{\pi}\|_{\infty}+C_{\text{Thm}\text{\ref{thm:finite-n}},2}\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(73)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p1.3" class="ltx_p"><span id="A5.SS1.p1.3.1" class="ltx_text">where we use <math id="A5.SS1.p1.m3" class="ltx_Math" alttext="v_{0}=0" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mn>0</mn></msub><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">v_{0}=0</annotation></semantics></math>.
Setting
<math id="A5.SS1.p1.m4" class="ltx_Math" alttext="C_{\text{\ref{lem:decay}},1}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lem:decay}},1}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},1}</annotation></semantics></math>,
<math id="A5.SS1.p1.m5" class="ltx_Math" alttext="C_{\text{\ref{lem:decay}},2}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>2</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lem:decay}},2}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},2}</annotation></semantics></math>,
and
<math id="A5.SS1.p1.m6" class="ltx_Math" alttext="C_{\text{\ref{lem:decay}},3}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lem:decay}},3}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},3}</annotation></semantics></math>
completes the proof.
∎</span></p>
</div>
</div>
<div id="Thmlemma8" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma8.2" class="ltx_text ltx_font_bold">Lemma 8</span></span><span id="Thmlemma8.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma8.p1" class="ltx_para">
<p id="Thmlemma8.p1.1" class="ltx_p"><span id="Thmlemma8.p1.1.1" class="ltx_text ltx_font_italic">For any <math id="Thmlemma8.p1.m1" class="ltx_Math" alttext="G,G^{\prime}\in\mathbb{R}^{(n+1)\times(n+1)}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>,</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">×</mo><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">G,G^{\prime}\in\mathbb{R}^{(n+1)\times(n+1)}</annotation></semantics></math>,</span></p>
<table id="A5.E74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E74.m1" class="ltx_math_unparsed" alttext="\max_{j\in[n+1]}\bigl\|\bigl[\mathrm{softmax}(G)-\mathrm{softmax}(G^{\prime})\bigr][:,j]\bigr\|_{1}\leq 2\max_{i,j}|G[i,j]-G^{\prime}[i,j]|." display="block" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mi>softmax</mi><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow><mo>−</mo><mi>softmax</mi><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mrow><mo stretchy="false">[</mo><mo rspace="0em">:</mo><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>1</mn></msub><mo lspace="0.0835em">≤</mo><mn>2</mn><munder><mi>max</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>G</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo>−</mo><msup><mi>G</mi><mo>′</mo></msup><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\max_{j\in[n+1]}\bigl\|\bigl[\mathrm{softmax}(G)-\mathrm{softmax}(G^{\prime})\bigr][:,j]\bigr\|_{1}\leq 2\max_{i,j}|G[i,j]-G^{\prime}[i,j]|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(74)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS1.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS1.p2" class="ltx_para">
<p id="A5.SS1.p2.1" class="ltx_p"><span id="A5.SS1.p2.1.1" class="ltx_text">Fix a column <math id="A5.SS1.p2.m1" class="ltx_Math" alttext="j\in[n+1]" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">j\in[n+1]</annotation></semantics></math>.
By (<a href="#S2.E4" title="In 2.1 Transformers and Softmax Self-Attention ‣ 2 Background ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>), the masked softmax acts on the
first <math id="A5.SS1.p2.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> entries of column <math id="A5.SS1.p2.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> via the standard softmax map
<math id="A5.SS1.p2.m4" class="ltx_Math" alttext="\sigma:\mathbb{R}^{n}\to\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>σ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mi>n</mi></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow></mrow><annotation encoding="application/x-tex">\sigma:\mathbb{R}^{n}\to\mathbb{R}^{n}</annotation></semantics></math> defined by
<math id="A5.SS1.p2.m5" class="ltx_Math" alttext="\sigma_{i}(w)=\frac{\exp(w_i)}{\sum_{k=1}^{n}\exp(w_k)}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>w</mi><mi>i</mi></msub><mo>)</mo></mrow></mrow><mrow><mstyle displaystyle="false"><msubsup><mo maxsize="0.700em" minsize="0.700em" stretchy="true">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup></mstyle><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>w</mi><mi>k</mi></msub><mo>)</mo></mrow></mrow></mrow></mfrac></mrow><annotation encoding="application/x-tex">\sigma_{i}(w)=\frac{\exp(w_i)}{\sum_{k=1}^{n}\exp(w_k)}</annotation></semantics></math>,
while the <math id="A5.SS1.p2.m6" class="ltx_Math" alttext="(n+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+1)</annotation></semantics></math>-th entry is fixed at zero.</span></p>
</div>
<div id="A5.SS1.p3" class="ltx_para">
<p id="A5.SS1.p3.1" class="ltx_p"><span id="A5.SS1.p3.1.1" class="ltx_text">The Jacobian <math id="A5.SS1.p3.m1" class="ltx_Math" alttext="J(w)\in\mathbb{R}^{n\times n}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>n</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow></msup></mrow><annotation encoding="application/x-tex">J(w)\in\mathbb{R}^{n\times n}</annotation></semantics></math> of <math id="A5.SS1.p3.m2" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> has entries</span></p>
<table id="A5.E75" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E75.m1" class="ltx_Math" alttext="J_{ik}(w)=\frac{\partial\sigma_{i}(w)}{\partial w_{k}}=\begin{cases}\sigma_{i}(w)(1-\sigma_{i}(w)),&amp;k=i,\\
-\sigma_{i}(w)\,\sigma_{k}(w),&amp;k\neq i.\end{cases}" display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>J</mi><mrow><mi>i</mi><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mfrac><mrow><mo>∂</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>∂</mo><msub><mi>w</mi><mi>k</mi></msub></mrow></mfrac><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>k</mi><mo>=</mo><mi>i</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>k</mi><mo>≠</mo><mi>i</mi></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">J_{ik}(w)=\frac{\partial\sigma_{i}(w)}{\partial w_{k}}=\begin{cases}\sigma_{i}(w)(1-\sigma_{i}(w)),&amp;k=i,\\
-\sigma_{i}(w)\,\sigma_{k}(w),&amp;k\neq i.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(75)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p3.2" class="ltx_p"><span id="A5.SS1.p3.2.1" class="ltx_text">For any direction <math id="A5.SS1.p3.m3" class="ltx_Math" alttext="h\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>h</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">h\in\mathbb{R}^{n}</annotation></semantics></math>,
the directional derivative of <math id="A5.SS1.p3.m4" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math> at <math id="A5.SS1.p3.m5" class="ltx_Math" alttext="w" display="inline" intent=":literal"><semantics><mi>w</mi><annotation encoding="application/x-tex">w</annotation></semantics></math> along <math id="A5.SS1.p3.m6" class="ltx_Math" alttext="h" display="inline" intent=":literal"><semantics><mi>h</mi><annotation encoding="application/x-tex">h</annotation></semantics></math> is</span></p>
<table id="A5.Ex31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex31.m1" class="ltx_Math" alttext="[J(w)\,h]_{i}=\sigma_{i}(w)\,h_{i}-\sigma_{i}(w)\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}=\sigma_{i}(w)\Bigl(h_{i}-\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr)." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">]</mo></mrow><mi>i</mi></msub><mo>=</mo><mrow><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>i</mi></msub></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow></mrow></mrow></mrow><mo>=</mo><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo rspace="0.055em">−</mo><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">[J(w)\,h]_{i}=\sigma_{i}(w)\,h_{i}-\sigma_{i}(w)\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}=\sigma_{i}(w)\Bigl(h_{i}-\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p3.3" class="ltx_p"><span id="A5.SS1.p3.3.1" class="ltx_text">Taking the <math id="A5.SS1.p3.m7" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math>-norm and using <math id="A5.SS1.p3.m8" class="ltx_Math" alttext="\sigma_{i}(w)\geq 0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\sigma_{i}(w)\geq 0</annotation></semantics></math>, <math id="A5.SS1.p3.m9" class="ltx_Math" alttext="\sum_{i}\sigma_{i}(w)=1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∑</mo><mi>i</mi></msub><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i}\sigma_{i}(w)=1</annotation></semantics></math>,</span></p>
<table id="A5.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex32.m1" class="ltx_Math" alttext="\displaystyle\|J(w)\,h\|_{1}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\|J(w)\,h\|_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex32.m2" class="ltx_Math" alttext="\displaystyle=\sum_{i=1}^{n}\sigma_{i}(w)\,\Bigl|h_{i}-\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><msub><mi>h</mi><mi>i</mi></msub><mo>−</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\sum_{i=1}^{n}\sigma_{i}(w)\,\Bigl|h_{i}-\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex33.m1" class="ltx_Math" alttext="\displaystyle\leq\sum_{i=1}^{n}\sigma_{i}(w)\,\Bigl(|h_{i}|+\Bigl|\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr|\Bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo stretchy="false">|</mo><msub><mi>h</mi><mi>i</mi></msub><mo stretchy="false">|</mo></mrow><mo>+</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover></mstyle><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{i=1}^{n}\sigma_{i}(w)\,\Bigl(|h_{i}|+\Bigl|\sum_{k=1}^{n}\sigma_{k}(w)\,h_{k}\Bigr|\Bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex34.m1" class="ltx_Math" alttext="\displaystyle\leq\|h\|_{\infty}+\|h\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\|h\|_{\infty}+\|h\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E76.m1" class="ltx_Math" alttext="\displaystyle=2\,\|h\|_{\infty}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2\,\|h\|_{\infty},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(76)</span></td></tr></tbody>
</table>
<p id="A5.SS1.p3.4" class="ltx_p"><span id="A5.SS1.p3.4.1" class="ltx_text">where the second inequality is obtained since <math id="A5.SS1.p3.m10" class="ltx_Math" alttext="\bigl|\sum_{k}\sigma_{k}(w)\,h_{k}\bigr|\leq\|h\|_{\infty}" display="inline" intent=":literal"><semantics><mrow><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo><mrow><msub><mo lspace="0em">∑</mo><mi>k</mi></msub><mrow><msub><mi>σ</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>h</mi><mi>k</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">|</mo></mrow><mo>≤</mo><msub><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\bigl|\sum_{k}\sigma_{k}(w)\,h_{k}\bigr|\leq\|h\|_{\infty}</annotation></semantics></math>.
Hence <math id="A5.SS1.p3.m11" class="ltx_Math" alttext="\sup_{\|h\|_{\infty}=1}\|J(w)\,h\|_{1}\leq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>sup</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>h</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mn>1</mn></mrow></msub><msub><mrow><mo lspace="0em" stretchy="false">‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>w</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>h</mi></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub></mrow><mo>≤</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\sup_{\|h\|_{\infty}=1}\|J(w)\,h\|_{1}\leq 2</annotation></semantics></math>
for all <math id="A5.SS1.p3.m12" class="ltx_Math" alttext="w\in\mathbb{R}^{n}" display="inline" intent=":literal"><semantics><mrow><mi>w</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>n</mi></msup></mrow><annotation encoding="application/x-tex">w\in\mathbb{R}^{n}</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS1.p4" class="ltx_para">
<p id="A5.SS1.p4.1" class="ltx_p"><span id="A5.SS1.p4.1.1" class="ltx_text">Let <math id="A5.SS1.p4.m1" class="ltx_Math" alttext="w_{j},w_{j}^{\prime}" display="inline" intent=":literal"><semantics><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>,</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><annotation encoding="application/x-tex">w_{j},w_{j}^{\prime}</annotation></semantics></math> denote the first <math id="A5.SS1.p4.m2" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> entries
of the <math id="A5.SS1.p4.m3" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math>-th columns of <math id="A5.SS1.p4.m4" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math> and <math id="A5.SS1.p4.m5" class="ltx_Math" alttext="G^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>′</mo></msup><annotation encoding="application/x-tex">G^{\prime}</annotation></semantics></math> respectively.
By the fundamental theorem of calculus,</span></p>
<table id="A5.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex35.m1" class="ltx_Math" alttext="\sigma(w_{j})-\sigma(w_{j}^{\prime})=\int_{0}^{1}J\bigl(w_{j}^{\prime}+t(w_{j}-w_{j}^{\prime})\bigr)\,(w_{j}-w_{j}^{\prime})\,dt." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.111em">=</mo><mrow><msubsup><mo>∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup><mo>+</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\sigma(w_{j})-\sigma(w_{j}^{\prime})=\int_{0}^{1}J\bigl(w_{j}^{\prime}+t(w_{j}-w_{j}^{\prime})\bigr)\,(w_{j}-w_{j}^{\prime})\,dt.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.2" class="ltx_p"><span id="A5.SS1.p4.2.1" class="ltx_text">Taking the <math id="A5.SS1.p4.m6" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math>-norm and applying (<a href="#A5.E76" title="In Proof. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">76</span></a>),</span></p>
<table id="A5.Ex36" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex36.m1" class="ltx_Math" alttext="\|\sigma(w_{j})-\sigma(w_{j}^{\prime})\|_{1}\leq\int_{0}^{1}\bigl\|J\bigl(w_{j}^{\prime}+t(w_{j}-w_{j}^{\prime})\bigr)\,(w_{j}-w_{j}^{\prime})\bigr\|_{1}\,dt\leq 2\,\|w_{j}-w_{j}^{\prime}\|_{\infty}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>w</mi><mi>j</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>σ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>1</mn></msub><mo rspace="0.111em">≤</mo><mrow><msubsup><mo rspace="0em">∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mi>J</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup><mo>+</mo><mrow><mi>t</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo lspace="0.170em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0.170em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\sigma(w_{j})-\sigma(w_{j}^{\prime})\|_{1}\leq\int_{0}^{1}\bigl\|J\bigl(w_{j}^{\prime}+t(w_{j}-w_{j}^{\prime})\bigr)\,(w_{j}-w_{j}^{\prime})\bigr\|_{1}\,dt\leq 2\,\|w_{j}-w_{j}^{\prime}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS1.p4.3" class="ltx_p"><span id="A5.SS1.p4.3.1" class="ltx_text">Since <math id="A5.SS1.p4.m7" class="ltx_Math" alttext="\|w_{j}-w_{j}^{\prime}\|_{\infty}\leq\max_{i,j}|G[i,j]-G^{\prime}[i,j]|" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>w</mi><mi>j</mi></msub><mo>−</mo><msubsup><mi>w</mi><mi>j</mi><mo>′</mo></msubsup></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>max</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>G</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|w_{j}-w_{j}^{\prime}\|_{\infty}\leq\max_{i,j}|G[i,j]-G^{\prime}[i,j]|</annotation></semantics></math>
and the <math id="A5.SS1.p4.m8" class="ltx_Math" alttext="(n+1)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(n+1)</annotation></semantics></math>-th entry contributes zero to the <math id="A5.SS1.p4.m9" class="ltx_Math" alttext="\ell_{1}" display="inline" intent=":literal"><semantics><msub><mi mathvariant="normal">ℓ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\ell_{1}</annotation></semantics></math> difference,
taking the maximum over <math id="A5.SS1.p4.m10" class="ltx_Math" alttext="j" display="inline" intent=":literal"><semantics><mi>j</mi><annotation encoding="application/x-tex">j</annotation></semantics></math> completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.2 </span>Proof of Lemma <span id="A5.SS2.2" class="ltx_text"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></span></h3>

<div id="Thmlemma9" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma9.2" class="ltx_text ltx_font_bold">Lemma 9</span></span><span id="Thmlemma9.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma9.p1" class="ltx_para">
<p id="Thmlemma9.p1.1" class="ltx_p"><span id="Thmlemma9.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="Thmlemma9.p1.m1" class="ltx_Math" alttext="D_{\theta}\doteq d^{2}+3" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mi>θ</mi></msub><mo>≐</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">D_{\theta}\doteq d^{2}+3</annotation></semantics></math> denote the number of free parameters
in (<a href="#S6.E32" title="In 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>).
There exists a constant <math id="Thmlemma9.p1.m2" class="ltx_Math" alttext="C_{\text{\ref{lemma:kernel_bound}}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lemma:kernel_bound}}}&gt;0</annotation></semantics></math> such that
for any <math id="Thmlemma9.p1.m3" class="ltx_Math" alttext="\theta\in\Theta^{\mathrm{Looped}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>Looped</mi></msup></mrow><annotation encoding="application/x-tex">\theta\in\Theta^{\mathrm{Looped}}</annotation></semantics></math>,</span></p>
<table id="A5.E77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E77.m1" class="ltx_math_unparsed" alttext="\max_{j\in[n+1]}\bigl\|(\nabla_{\theta_{m}}\widetilde{K}(\theta))[:,j]\bigr\|_{1}\leq C_{\text{\ref{lemma:kernel_bound}}},\qquad\forall\,m=1,\ldots,D_{\theta}." display="block" intent=":literal"><semantics><mrow><munder><mi>max</mi><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow></mrow></munder><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><mrow><mo stretchy="false">(</mo><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>m</mi></msub></msub><mover accent="true"><mi>K</mi><mo>~</mo></mover><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">[</mo><mo rspace="0em">:</mo><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>1</mn></msub><mo lspace="0.0835em">≤</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo rspace="2.167em">,</mo><mo rspace="0.337em">∀</mo><mi>m</mi><mo>=</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>D</mi><mi>θ</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\max_{j\in[n+1]}\bigl\|(\nabla_{\theta_{m}}\widetilde{K}(\theta))[:,j]\bigr\|_{1}\leq C_{\text{\ref{lemma:kernel_bound}}},\qquad\forall\,m=1,\ldots,D_{\theta}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(77)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS2.p1" class="ltx_para">
<p id="A5.SS2.p1.1" class="ltx_p"><span id="A5.SS2.p1.1.1" class="ltx_text">Recall <math id="A5.SS2.p1.m1" class="ltx_Math" alttext="C_{x}=\max_{s\in\mathcal{S}}\|x(s)\|_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>x</mi></msub><mo>=</mo><mrow><msub><mi>max</mi><mrow><mi>s</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒮</mi></mrow></msub><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">C_{x}=\max_{s\in\mathcal{S}}\|x(s)\|_{2}</annotation></semantics></math>
and define <math id="A5.SS2.p1.m2" class="ltx_Math" alttext="C_{R}\doteq\max_{s}|r(s)|" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mi>R</mi></msub><mo>≐</mo><mrow><msub><mi>max</mi><mi>s</mi></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mi>r</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">C_{R}\doteq\max_{s}|r(s)|</annotation></semantics></math>.
Constructing <math id="A5.SS2.p1.m3" class="ltx_Math" alttext="Z_{0}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>0</mn></msub><annotation encoding="application/x-tex">Z_{0}</annotation></semantics></math> as in (<a href="#S3.E13" title="In Weighted softmax TD. ‣ 3 Transformers Can Implement In-Context Weighted Softmax TD ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>),
each column of <math id="A5.SS2.p1.m4" class="ltx_Math" alttext="Z_{0}" display="inline" intent=":literal"><semantics><msub><mi>Z</mi><mn>0</mn></msub><annotation encoding="application/x-tex">Z_{0}</annotation></semantics></math> has at most <math id="A5.SS2.p1.m5" class="ltx_Math" alttext="d+3" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow><annotation encoding="application/x-tex">d+3</annotation></semantics></math> entries,
so for all <math id="A5.SS2.p1.m6" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math></span></p>
<table id="A5.E78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E78.m1" class="ltx_Math" alttext="\sum_{k=1}^{d+3}|Z_{0}[k,i]|\leq(d+3)\max(C_{x},C_{R})\doteq C_{\text{\ref{lemma:kernel_bound}},1}" display="block" intent=":literal"><semantics><mrow><mrow><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow></munderover><mrow><mo lspace="0em" stretchy="false">|</mo><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>C</mi><mi>x</mi></msub><mo>,</mo><msub><mi>C</mi><mi>R</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≐</mo><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">\sum_{k=1}^{d+3}|Z_{0}[k,i]|\leq(d+3)\max(C_{x},C_{R})\doteq C_{\text{\ref{lemma:kernel_bound}},1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(78)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.2" class="ltx_p"><span id="A5.SS2.p1.2.1" class="ltx_text">Define the intermediate matrix</span></p>
<table id="A5.Ex37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex37.m1" class="ltx_Math" alttext="G(\theta)\doteq Z_{0}^{\top}A(\theta)Z_{0},\qquad\widetilde{K}(\theta)=\mathrm{softmax}\big(G(\theta)\big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≐</mo><mrow><msubsup><mi>Z</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><mrow><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>softmax</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">G(\theta)\doteq Z_{0}^{\top}A(\theta)Z_{0},\qquad\widetilde{K}(\theta)=\mathrm{softmax}\big(G(\theta)\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS2.p1.3" class="ltx_p"><span id="A5.SS2.p1.3.1" class="ltx_text">For any perturbation <math id="A5.SS2.p1.m7" class="ltx_Math" alttext="dA" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><annotation encoding="application/x-tex">dA</annotation></semantics></math>, expanding <math id="A5.SS2.p1.m8" class="ltx_Math" alttext="dG=Z_{0}^{\top}(dA)Z_{0}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi></mrow><mo>=</mo><mrow><msubsup><mi>Z</mi><mn>0</mn><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub></mrow></mrow><annotation encoding="application/x-tex">dG=Z_{0}^{\top}(dA)Z_{0}</annotation></semantics></math> entrywise gives</span></p>
<table id="A5.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E79.m1" class="ltx_Math" alttext="\displaystyle|dG[i,j]|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle|dG[i,j]|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E79.m2" class="ltx_Math" alttext="\displaystyle=\Bigl|\sum_{k,l}Z_{0}[k,i]\,dA[k,l]\,Z_{0}[l,j]\Bigr|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder></mstyle><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo stretchy="false">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\Bigl|\sum_{k,l}Z_{0}[k,i]\,dA[k,l]\,Z_{0}[l,j]\Bigr|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(79)</span></td></tr></tbody>
<tbody id="A5.E80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E80.m1" class="ltx_Math" alttext="\displaystyle\leq\Bigl(\sum_{k}|Z_{0}[k,i]|\Bigr)\Bigl(\sum_{l}|Z_{0}[l,j]|\Bigr)\max_{k,l}|dA[k,l]|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>k</mi></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>i</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>l</mi></munder></mstyle><mrow><mo stretchy="false">|</mo><mrow><msub><mi>Z</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>l</mi><mo>,</mo><mi>j</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\Bigl(\sum_{k}|Z_{0}[k,i]|\Bigr)\Bigl(\sum_{l}|Z_{0}[l,j]|\Bigr)\max_{k,l}|dA[k,l]|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(80)</span></td></tr></tbody>
<tbody id="A5.E81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E81.m1" class="ltx_Math" alttext="\displaystyle\leq C_{\text{\ref{lemma:kernel_bound}},1}^{2}\,\max_{k,l}|dA[k,l]|." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msubsup><mi>C</mi><mrow><mtext><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext><mo>,</mo><mn>1</mn></mrow><mn>2</mn></msubsup><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>A</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{\text{\ref{lemma:kernel_bound}},1}^{2}\,\max_{k,l}|dA[k,l]|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(81)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.4" class="ltx_p"><span id="A5.SS2.p1.4.1" class="ltx_text">By (<a href="#A5.E74" title="In Lemma 8. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">74</span></a>),</span></p>
<table id="A5.E82" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E82.m1" class="ltx_math_unparsed" alttext="\max_{j}\|d\widetilde{K}[:,j]\|_{1}\leq 2\,\max_{i,j}|dG[i,j]|\leq 2C_{\text{\ref{lemma:kernel_bound}},1}^{2}\max_{k,l}|dA[k,l]|." display="block" intent=":literal"><semantics><mrow><munder><mi>max</mi><mi>j</mi></munder><mo lspace="0em" rspace="0.167em">∥</mo><mi>d</mi><mover accent="true"><mi>K</mi><mo>~</mo></mover><mrow><mo stretchy="false">[</mo><mo rspace="0em">:</mo><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><msub><mo lspace="0em" rspace="0.0835em">∥</mo><mn>1</mn></msub><mo lspace="0.0835em">≤</mo><mn>2</mn><munder><mi>max</mi><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>d</mi><mi>G</mi><mrow><mo stretchy="false">[</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo stretchy="false">]</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">≤</mo><mn>2</mn><msubsup><mi>C</mi><mrow><mtext><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext><mo>,</mo><mn>1</mn></mrow><mn>2</mn></msubsup><munder><mi>max</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></munder><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>d</mi><mi>A</mi><mrow><mo stretchy="false">[</mo><mi>k</mi><mo>,</mo><mi>l</mi><mo stretchy="false">]</mo></mrow><mo fence="false" stretchy="false">|</mo><mo lspace="0.167em">.</mo></mrow><annotation encoding="application/x-tex">\max_{j}\|d\widetilde{K}[:,j]\|_{1}\leq 2\,\max_{i,j}|dG[i,j]|\leq 2C_{\text{\ref{lemma:kernel_bound}},1}^{2}\max_{k,l}|dA[k,l]|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(82)</span></td></tr></tbody>
</table>
<p id="A5.SS2.p1.5" class="ltx_p"><span id="A5.SS2.p1.5.1" class="ltx_text">Finally, since <math id="A5.SS2.p1.m9" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> is a sub-block of <math id="A5.SS2.p1.m10" class="ltx_Math" alttext="A(\theta)" display="inline" intent=":literal"><semantics><mrow><mi>A</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">A(\theta)</annotation></semantics></math> by (<a href="#S6.E32" title="In 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>),
<math id="A5.SS2.p1.m11" class="ltx_Math" alttext="\max_{k,l}|(\nabla_{\theta_{m}}A)[k,l]|\leq 1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>max</mi><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow></msub><mo>⁡</mo><mrow><mo stretchy="false">|</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mo rspace="0.167em">∇</mo><msub><mi>θ</mi><mi>m</mi></msub></msub><mi>A</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo stretchy="false">]</mo></mrow></mrow><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\max_{k,l}|(\nabla_{\theta_{m}}A)[k,l]|\leq 1</annotation></semantics></math> for all <math id="A5.SS2.p1.m12" class="ltx_Math" alttext="m=1,\ldots,D_{\theta}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>D</mi><mi>θ</mi></msub></mrow><annotation encoding="application/x-tex">m=1,\ldots,D_{\theta}</annotation></semantics></math>.
Setting <math id="A5.SS2.p1.m13" class="ltx_Math" alttext="C_{\text{\ref{lemma:kernel_bound}}}\doteq 2C_{\text{\ref{lemma:kernel_bound}},1}^{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mtext><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo>≐</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>C</mi><mrow><mtext><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext><mo>,</mo><mn>1</mn></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lemma:kernel_bound}}}\doteq 2C_{\text{\ref{lemma:kernel_bound}},1}^{2}</annotation></semantics></math>
completes the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A5.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.3 </span>Proof of Lemma <span id="A5.SS3.2" class="ltx_text"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></span></h3>

<div id="Thmlemma10" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="Thmlemma10.2" class="ltx_text ltx_font_bold">Lemma 10</span></span><span id="Thmlemma10.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="Thmlemma10.p1" class="ltx_para">
<p id="Thmlemma10.p1.1" class="ltx_p"><span id="Thmlemma10.p1.1.1" class="ltx_text ltx_font_italic">Under Assumption <a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.1</span></a>, for any <math id="Thmlemma10.p1.m1" class="ltx_Math" alttext="\delta\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta\in(0,1)</annotation></semantics></math>, there exist constants
<math id="Thmlemma10.p1.m2" class="ltx_Math" alttext="C_{\text{\ref{lemma:grad_bound}},1},\;C_{\text{\ref{lemma:grad_bound}},2},\;C_{\text{\ref{lemma:grad_bound}},3},\;C_{\text{\ref{lemma:grad_bound}},4}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo rspace="0.447em">,</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.447em">,</mo><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo rspace="0.447em">,</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lemma:grad_bound}},1},\;C_{\text{\ref{lemma:grad_bound}},2},\;C_{\text{\ref{lemma:grad_bound}},3},\;C_{\text{\ref{lemma:grad_bound}},4}&gt;0</annotation></semantics></math>
such that if <math id="Thmlemma10.p1.m3" class="ltx_Math" alttext="n\geq C_{\text{\ref{lemma:grad_bound}},1}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\text{\ref{lemma:grad_bound}},1}\log(1/\delta)</annotation></semantics></math>, then with probability at least <math id="Thmlemma10.p1.m4" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A5.E83" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E83.m1" class="ltx_Math" alttext="\|\nabla_{\theta}v_{L}(S_{n};\theta_{*})\|_{\infty}\;\leq\;C_{\ref{lemma:grad_bound},2}\;+\;C_{\ref{lemma:grad_bound},3}\sqrt{\frac{\log(C_{\ref{lemma:grad_bound},4}/\delta)}{n}}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo>,</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo lspace="0.558em" rspace="0.558em">≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo rspace="0.502em">+</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></msqrt></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|\nabla_{\theta}v_{L}(S_{n};\theta_{*})\|_{\infty}\;\leq\;C_{\ref{lemma:grad_bound},2}\;+\;C_{\ref{lemma:grad_bound},3}\sqrt{\frac{\log(C_{\ref{lemma:grad_bound},4}/\delta)}{n}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(83)</span></td></tr></tbody>
</table>
</div>
</div>
<div id="A5.SS3.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS3.p1" class="ltx_para">
<p id="A5.SS3.p1.1" class="ltx_p"><span id="A5.SS3.p1.1.1" class="ltx_text">By (<a href="#S3.E20" title="In Theorem 1. ‣ Target-value head. ‣ 3 Transformers Can Implement In-Context Weighted Softmax TD ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">20</span></a>), the induced attention matrix <math id="A5.SS3.p1.m1" class="ltx_Math" alttext="\widetilde{K}(\theta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{K}(\theta)</annotation></semantics></math>
in (<a href="#S2.E4" title="In 2.1 Transformers and Softmax Self-Attention ‣ 2 Background ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>) depends on <math id="A5.SS3.p1.m2" class="ltx_Math" alttext="\theta" display="inline" intent=":literal"><semantics><mi>θ</mi><annotation encoding="application/x-tex">\theta</annotation></semantics></math> through <math id="A5.SS3.p1.m3" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>.
Moreover, for all <math id="A5.SS3.p1.m4" class="ltx_Math" alttext="\theta\in\Theta^{\text{Looped}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mtext>Looped</mtext></msup></mrow><annotation encoding="application/x-tex">\theta\in\Theta^{\text{Looped}}</annotation></semantics></math>,
<math id="A5.SS3.p1.m5" class="ltx_Math" alttext="\widetilde{K}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>K</mi><mo>~</mo></mover><annotation encoding="application/x-tex">\widetilde{K}</annotation></semantics></math> is invariant to layer <math id="A5.SS3.p1.m6" class="ltx_Math" alttext="l" display="inline" intent=":literal"><semantics><mi>l</mi><annotation encoding="application/x-tex">l</annotation></semantics></math>.
We first derive the one-step forward map for a general
<math id="A5.SS3.p1.m7" class="ltx_Math" alttext="\theta\in\Theta^{\mathrm{Looped}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mi mathvariant="normal">Θ</mi><mi>Looped</mi></msup></mrow><annotation encoding="application/x-tex">\theta\in\Theta^{\mathrm{Looped}}</annotation></semantics></math>.
Recall from (<a href="#S6.E32" title="In 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>) that the free parameters
are <math id="A5.SS3.p1.m8" class="ltx_Math" alttext="u\in\mathbb{R}^{1\times 3}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mn>1</mn><mo lspace="0.222em" rspace="0.222em">×</mo><mn>3</mn></mrow></msup></mrow><annotation encoding="application/x-tex">u\in\mathbb{R}^{1\times 3}</annotation></semantics></math> and <math id="A5.SS3.p1.m9" class="ltx_Math" alttext="B\in\mathbb{R}^{d\times d}" display="inline" intent=":literal"><semantics><mrow><mi>B</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">B\in\mathbb{R}^{d\times d}</annotation></semantics></math>.
Replacing <math id="A5.SS3.p1.m10" class="ltx_Math" alttext="[1,1,-1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,1,-1]</annotation></semantics></math> with <math id="A5.SS3.p1.m11" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math>
in (<a href="#A2.E40" title="In Proof. ‣ Appendix B Proof of Theorem ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>),
the layerwise update generalizes to</span></p>
<table id="A5.E84" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E84.m1" class="ltx_Math" alttext="F_{\theta}(v)(s)=v(s)+\sum_{k=1}^{n}\bigl[u_{1}R_{k}+u_{2}\gamma v(S_{k})+u_{3}v(S_{k-1})\bigr]\,\widetilde{K}(\theta)(S_{k-1},s)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>F</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>v</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.055em">+</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mrow><mrow><mo maxsize="1.200em" minsize="1.200em">[</mo><mrow><mrow><msub><mi>u</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>R</mi><mi>k</mi></msub></mrow><mo>+</mo><mrow><msub><mi>u</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>u</mi><mn>3</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>v</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">]</mo></mrow><mo lspace="0.170em" rspace="0em">​</mo><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow></msub><mo>,</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">F_{\theta}(v)(s)=v(s)+\sum_{k=1}^{n}\bigl[u_{1}R_{k}+u_{2}\gamma v(S_{k})+u_{3}v(S_{k-1})\bigr]\,\widetilde{K}(\theta)(S_{k-1},s),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(84)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p1.2" class="ltx_p"><span id="A5.SS3.p1.2.1" class="ltx_text">where <math id="A5.SS3.p1.m12" class="ltx_Math" alttext="\widetilde{K}(\theta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{K}(\theta)</annotation></semantics></math> is the attention matrix in (<a href="#S2.E4" title="In 2.1 Transformers and Softmax Self-Attention ‣ 2 Background ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>).
At <math id="A5.SS3.p1.m13" class="ltx_Math" alttext="\theta_{*}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\theta_{*}</annotation></semantics></math> with <math id="A5.SS3.p1.m14" class="ltx_Math" alttext="u^{*}=[1,1,-1]" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>∗</mo></msup><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mrow><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">u^{*}=[1,1,-1]</annotation></semantics></math>,
<math id="A5.SS3.p1.m15" class="ltx_Math" alttext="F_{\theta_{*}}(v)=\widehat{\mathcal{T}}_{\widetilde{K}}(v)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>F</mi><msub><mi>θ</mi><mo>∗</mo></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>^</mo></mover><mover accent="true"><mi>K</mi><mo>~</mo></mover></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">F_{\theta_{*}}(v)=\widehat{\mathcal{T}}_{\widetilde{K}}(v)</annotation></semantics></math>
as in (<a href="#S5.E25" title="In 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>).</span></p>
</div>
<div id="A5.SS3.p2" class="ltx_para">
<p id="A5.SS3.p2.1" class="ltx_p"><span id="A5.SS3.p2.1.1" class="ltx_text">The Jacobian of <math id="A5.SS3.p2.m1" class="ltx_Math" alttext="F_{\theta_{*}}" display="inline" intent=":literal"><semantics><msub><mi>F</mi><msub><mi>θ</mi><mo>∗</mo></msub></msub><annotation encoding="application/x-tex">F_{\theta_{*}}</annotation></semantics></math> with respect to <math id="A5.SS3.p2.m2" class="ltx_Math" alttext="v" display="inline" intent=":literal"><semantics><mi>v</mi><annotation encoding="application/x-tex">v</annotation></semantics></math> is</span></p>
<table id="A5.E85" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E85.m1" class="ltx_Math" alttext="J\doteq\nabla_{v}F_{\theta_{*}}(v)=I-\widehat{M}_{n}+\gamma\widehat{P}_{n}," display="block" intent=":literal"><semantics><mrow><mrow><mi>J</mi><mo>≐</mo><mrow><mrow><msub><mo rspace="0.167em">∇</mo><mi>v</mi></msub><msub><mi>F</mi><msub><mi>θ</mi><mo>∗</mo></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>v</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">J\doteq\nabla_{v}F_{\theta_{*}}(v)=I-\widehat{M}_{n}+\gamma\widehat{P}_{n},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(85)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.2" class="ltx_p"><span id="A5.SS3.p2.2.1" class="ltx_text">which is constant across layers.
By the chain rule,</span></p>
<table id="A5.E86" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E86.m1" class="ltx_Math" alttext="\nabla_{\theta}v_{l+1}=J\,\nabla_{\theta}v_{l}+g_{l}^{(B)}+g_{l}^{(u)}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mrow><mi>l</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow><mo>=</mo><mrow><mrow><mi>J</mi><mo lspace="0.337em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>l</mi></msub></mrow></mrow><mo>+</mo><msubsup><mi>g</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>g</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\nabla_{\theta}v_{l+1}=J\,\nabla_{\theta}v_{l}+g_{l}^{(B)}+g_{l}^{(u)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(86)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p2.3" class="ltx_p"><span id="A5.SS3.p2.3.1" class="ltx_text">where <math id="A5.SS3.p2.m3" class="ltx_Math" alttext="g_{l}^{(B)}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">g_{l}^{(B)}</annotation></semantics></math> and <math id="A5.SS3.p2.m4" class="ltx_Math" alttext="g_{l}^{(u)}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>l</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">g_{l}^{(u)}</annotation></semantics></math> are the partial derivatives of <math id="A5.SS3.p2.m5" class="ltx_Math" alttext="F_{\theta}(v_{l})" display="inline" intent=":literal"><semantics><mrow><msub><mi>F</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>l</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">F_{\theta}(v_{l})</annotation></semantics></math>
with respect to <math id="A5.SS3.p2.m6" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math> and <math id="A5.SS3.p2.m7" class="ltx_Math" alttext="u" display="inline" intent=":literal"><semantics><mi>u</mi><annotation encoding="application/x-tex">u</annotation></semantics></math> at <math id="A5.SS3.p2.m8" class="ltx_Math" alttext="\theta_{*}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\theta_{*}</annotation></semantics></math>, holding <math id="A5.SS3.p2.m9" class="ltx_Math" alttext="v_{l}" display="inline" intent=":literal"><semantics><msub><mi>v</mi><mi>l</mi></msub><annotation encoding="application/x-tex">v_{l}</annotation></semantics></math> fixed.</span></p>
</div>
<div id="A5.SS3.p3" class="ltx_para">
<p id="A5.SS3.p3.1" class="ltx_p"><span id="A5.SS3.p3.1.1" class="ltx_text">By Lemma <a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5</span></a>, choosing
<math id="A5.SS3.p3.m1" class="ltx_Math" alttext="C_{\text{\ref{lemma:grad_bound}},1}\doteq C_{\text{\ref{lem:contraction}}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mtext><a href="#Thmlemma5" title="Lemma 5. ‣ D.2 Proof of Lemma ‣ Appendix D Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5</span></a></mtext></msub></mrow><annotation encoding="application/x-tex">C_{\text{\ref{lemma:grad_bound}},1}\doteq C_{\text{\ref{lem:contraction}}}</annotation></semantics></math>,
then on the event of probability at least <math id="A5.SS3.p3.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>,</span></p>
<table id="A5.E87" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E87.m1" class="ltx_Math" alttext="\|J\|_{\infty}=\|I-\widehat{M}_{n}+\gamma\widehat{P}_{n}\|_{\infty}\leq 1-C_{\ref{ass:diagonal-margin}}&lt;1." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mi>J</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><msub><mrow><mo stretchy="false">‖</mo><mrow><mrow><mi>I</mi><mo>−</mo><msub><mover accent="true"><mi>M</mi><mo>^</mo></mover><mi>n</mi></msub></mrow><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>P</mi><mo>^</mo></mover><mi>n</mi></msub></mrow></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo>&lt;</mo><mn>1</mn></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|J\|_{\infty}=\|I-\widehat{M}_{n}+\gamma\widehat{P}_{n}\|_{\infty}\leq 1-C_{\ref{ass:diagonal-margin}}&lt;1.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(87)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.2" class="ltx_p"><span id="A5.SS3.p3.2.1" class="ltx_text">Unrolling (<a href="#A5.E86" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">86</span></a>)
with <math id="A5.SS3.p3.m3" class="ltx_Math" alttext="\nabla_{\theta}v_{0}=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mo>∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mn>0</mn></msub></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\nabla_{\theta}v_{0}=0</annotation></semantics></math> gives</span></p>
<table id="A5.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E88.m1" class="ltx_Math" alttext="\displaystyle\|\nabla_{\theta}v_{L}\|_{\infty}=\norm{\sum_{k=0}^{L-1} J^{L-1-k} g_k}_{\infty}\leq\sum_{k=0}^{L-1}(1-C_{\ref{ass:diagonal-margin}})^{L-1-k}\|g_{k}\|_{\infty}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mi>J</mi><mrow><mi>L</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>g</mi><mi>k</mi></msub></mrow></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn></mrow></munderover></mstyle><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mrow><mi>L</mi><mo>−</mo><mn>1</mn><mo>−</mo><mi>k</mi></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\|\nabla_{\theta}v_{L}\|_{\infty}=\norm{\sum_{k=0}^{L-1} J^{L-1-k} g_k}_{\infty}\leq\sum_{k=0}^{L-1}(1-C_{\ref{ass:diagonal-margin}})^{L-1-k}\|g_{k}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(88)</span></td></tr></tbody>
</table>
<p id="A5.SS3.p3.3" class="ltx_p"><span id="A5.SS3.p3.3.1" class="ltx_text">It remains to bound <math id="A5.SS3.p3.m4" class="ltx_Math" alttext="\|g_{k}\|_{\infty}=\max(\|g_{k}^{(B)}\|_{\infty},\|g_{k}^{(u)}\|_{\infty})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\|g_{k}\|_{\infty}=\max(\|g_{k}^{(B)}\|_{\infty},\|g_{k}^{(u)}\|_{\infty})</annotation></semantics></math>.</span></p>
</div>
</div>
<section id="A5.SS3.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bounding <math id="A5.SS3.SSS0.Px1.m1" class="ltx_Math" alttext="g_{k}^{(B)}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">g_{k}^{(B)}</annotation></semantics></math>.</h5>

<div id="A5.SS3.SSS0.Px1.p1" class="ltx_para">
<p id="A5.SS3.SSS0.Px1.p1.1" class="ltx_p">By (<a href="#A5.E84" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">84</span></a>),
at <math id="A5.SS3.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\theta_{*}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\theta_{*}</annotation></semantics></math> the <math id="A5.SS3.SSS0.Px1.p1.m2" class="ltx_Math" alttext="B" display="inline" intent=":literal"><semantics><mi>B</mi><annotation encoding="application/x-tex">B</annotation></semantics></math>-channel acts only through <math id="A5.SS3.SSS0.Px1.p1.m3" class="ltx_Math" alttext="\widetilde{K}(\theta)" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\widetilde{K}(\theta)</annotation></semantics></math>.
Applying Hölder’s inequality and Lemma <span id="A5.SS3.SSS0.Px1.p1.1.1" class="ltx_text"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">9</span></a></span>,</p>
<table id="A5.E89" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E89.m1" class="ltx_Math" alttext="\|g_{k}^{(B)}\|_{\infty}\leq C_{\ref{lemma:kernel_bound}}\max_{1\leq i\leq n}|\delta_{i}^{(v_{k})}|\leq C_{\ref{lemma:kernel_bound}}\bigl(C_{R}+(1+\gamma)\|v_{k}\|_{\infty}\bigr)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo lspace="0.167em" rspace="0em">​</mo><munder><mi>max</mi><mrow><mn>1</mn><mo>≤</mo><mi>i</mi><mo>≤</mo><mi>n</mi></mrow></munder><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">|</mo><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">|</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>C</mi><mi>R</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\|g_{k}^{(B)}\|_{\infty}\leq C_{\ref{lemma:kernel_bound}}\max_{1\leq i\leq n}|\delta_{i}^{(v_{k})}|\leq C_{\ref{lemma:kernel_bound}}\bigl(C_{R}+(1+\gamma)\|v_{k}\|_{\infty}\bigr),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(89)</span></td></tr></tbody>
</table>
<p id="A5.SS3.SSS0.Px1.p1.2" class="ltx_p">where <math id="A5.SS3.SSS0.Px1.p1.m4" class="ltx_Math" alttext="\delta_{i}^{(v_{k})}=R_{i}+\gamma v_{k}(S_{i})-v_{k}(S_{i-1})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>δ</mi><mi>i</mi><mrow><mo stretchy="false">(</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></msubsup><mo>=</mo><mrow><mrow><msub><mi>R</mi><mi>i</mi></msub><mo>+</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta_{i}^{(v_{k})}=R_{i}+\gamma v_{k}(S_{i})-v_{k}(S_{i-1})</annotation></semantics></math>
is the TD error at transition <math id="A5.SS3.SSS0.Px1.p1.m5" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>.</p>
</div>
</section>
<section id="A5.SS3.SSS0.Px2" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bounding <math id="A5.SS3.SSS0.Px2.m1" class="ltx_Math" alttext="g_{k}^{(u)}" display="inline" intent=":literal"><semantics><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">g_{k}^{(u)}</annotation></semantics></math>.</h5>

<div id="A5.SS3.SSS0.Px2.p1" class="ltx_para">
<p id="A5.SS3.SSS0.Px2.p1.1" class="ltx_p">By (<a href="#A5.E84" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">84</span></a>),
differentiating with respect to <math id="A5.SS3.SSS0.Px2.p1.m1" class="ltx_Math" alttext="u_{1},u_{2},u_{3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>u</mi><mn>1</mn></msub><mo>,</mo><msub><mi>u</mi><mn>2</mn></msub><mo>,</mo><msub><mi>u</mi><mn>3</mn></msub></mrow><annotation encoding="application/x-tex">u_{1},u_{2},u_{3}</annotation></semantics></math> at <math id="A5.SS3.SSS0.Px2.p1.m2" class="ltx_Math" alttext="\theta_{*}" display="inline" intent=":literal"><semantics><msub><mi>θ</mi><mo>∗</mo></msub><annotation encoding="application/x-tex">\theta_{*}</annotation></semantics></math> gives
coefficients <math id="A5.SS3.SSS0.Px2.p1.m3" class="ltx_Math" alttext="R_{i}" display="inline" intent=":literal"><semantics><msub><mi>R</mi><mi>i</mi></msub><annotation encoding="application/x-tex">R_{i}</annotation></semantics></math>, <math id="A5.SS3.SSS0.Px2.p1.m4" class="ltx_Math" alttext="\gamma v_{k}(S_{i})" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\gamma v_{k}(S_{i})</annotation></semantics></math>, and <math id="A5.SS3.SSS0.Px2.p1.m5" class="ltx_Math" alttext="v_{k}(S_{i-1})" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>k</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">v_{k}(S_{i-1})</annotation></semantics></math> respectively.
Since <math id="A5.SS3.SSS0.Px2.p1.m6" class="ltx_Math" alttext="\sum_{i=1}^{n}\widetilde{K}[i,s]=1" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></msubsup><mrow><mover accent="true"><mi>K</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>i</mi><mo>,</mo><mi>s</mi></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\sum_{i=1}^{n}\widetilde{K}[i,s]=1</annotation></semantics></math> for each <math id="A5.SS3.SSS0.Px2.p1.m7" class="ltx_Math" alttext="s" display="inline" intent=":literal"><semantics><mi>s</mi><annotation encoding="application/x-tex">s</annotation></semantics></math>,</p>
<table id="A5.E90" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E90.m1" class="ltx_Math" alttext="\|g_{k}^{(u)}\|_{\infty}\leq\max\bigl(C_{R},\;\gamma\|v_{k}\|_{\infty},\;\|v_{k}\|_{\infty}\bigr)\leq C_{R}+(1+\gamma)\|v_{k}\|_{\infty}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mi>C</mi><mi>R</mi></msub><mo>,</mo><mrow><mi>γ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>,</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>C</mi><mi>R</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\|g_{k}^{(u)}\|_{\infty}\leq\max\bigl(C_{R},\;\gamma\|v_{k}\|_{\infty},\;\|v_{k}\|_{\infty}\bigr)\leq C_{R}+(1+\gamma)\|v_{k}\|_{\infty}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(90)</span></td></tr></tbody>
</table>
</div>
</section>
<section id="A5.SS3.SSS0.Px3" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Combining.</h5>

<div id="A5.SS3.SSS0.Px3.p1" class="ltx_para">
<p id="A5.SS3.SSS0.Px3.p1.1" class="ltx_p">By (<a href="#A5.E89" title="In Bounding 𝑔_𝑘^(𝐵). ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">89</span></a>) and (<a href="#A5.E90" title="In Bounding 𝑔_𝑘^(𝑢). ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">90</span></a>),</p>
<table id="A5.EGx19" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E91.m1" class="ltx_Math" alttext="\displaystyle\|g_{k}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><msub><mi>g</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|g_{k}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E91.m2" class="ltx_Math" alttext="\displaystyle=\max\bigl(\|g_{k}^{(B)}\|_{\infty},\,\|g_{k}^{(u)}\|_{\infty}\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>B</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo rspace="0.337em">,</mo><msub><mrow><mo stretchy="false">‖</mo><msubsup><mi>g</mi><mi>k</mi><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max\bigl(\|g_{k}^{(B)}\|_{\infty},\,\|g_{k}^{(u)}\|_{\infty}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(91)</span></td></tr></tbody>
<tbody id="A5.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex38.m1" class="ltx_Math" alttext="\displaystyle\leq\max(1,C_{\ref{lemma:kernel_bound}})\bigl(C_{R}+(1+\gamma)\|v_{k}\|_{\infty}\bigr)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma9" title="Lemma 9. ‣ E.2 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">9</span></a></mtext></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>C</mi><mi>R</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>k</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max(1,C_{\ref{lemma:kernel_bound}})\bigl(C_{R}+(1+\gamma)\|v_{k}\|_{\infty}\bigr)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex39.m1" class="ltx_Math" alttext="\displaystyle\leq C_{\ref{lemma:grad_bound},5}(\|v_{k}-v_{\pi}\|_{\infty}+\|v_{\pi}\|_{\infty})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>5</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mi>v</mi><mi>k</mi></msub><mo>−</mo><msub><mi>v</mi><mi>π</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>+</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{\ref{lemma:grad_bound},5}(\|v_{k}-v_{\pi}\|_{\infty}+\|v_{\pi}\|_{\infty})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A5.E92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E92.m1" class="ltx_Math" alttext="\displaystyle\leq C_{\ref{lemma:grad_bound},6}+C_{\ref{lemma:grad_bound},7}\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>6</mn></mrow></msub><mo>+</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>7</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq C_{\ref{lemma:grad_bound},6}+C_{\ref{lemma:grad_bound},7}\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(92)</span></td></tr></tbody>
</table>
<p id="A5.SS3.SSS0.Px3.p1.2" class="ltx_p">where the last step applies Theorem <span id="A5.SS3.SSS0.Px3.p1.2.1" class="ltx_text"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></span> with <math id="A5.SS3.SSS0.Px3.p1.m1" class="ltx_Math" alttext="\theta=\theta_{*}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><msub><mi>θ</mi><mo>∗</mo></msub></mrow><annotation encoding="application/x-tex">\theta=\theta_{*}</annotation></semantics></math>
on the event of probability at least <math id="A5.SS3.SSS0.Px3.p1.m2" class="ltx_Math" alttext="1-\delta" display="inline" intent=":literal"><semantics><mrow><mn>1</mn><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">1-\delta</annotation></semantics></math>
with <math id="A5.SS3.SSS0.Px3.p1.m3" class="ltx_Math" alttext="n\geq C_{\text{Thm}\text{\ref{thm:finite-n}},1}\log(1/\delta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>1</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\text{Thm}\text{\ref{thm:finite-n}},1}\log(1/\delta)</annotation></semantics></math>.
Crucially, the right-hand side is independent of the layer index <math id="A5.SS3.SSS0.Px3.p1.m4" class="ltx_Math" alttext="k" display="inline" intent=":literal"><semantics><mi>k</mi><annotation encoding="application/x-tex">k</annotation></semantics></math>.
Substituting into (<a href="#A5.E88" title="In Proof. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">88</span></a>) gives</p>
<table id="A5.EGx20" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.E93"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.E93.m1" class="ltx_Math" alttext="\displaystyle\|\nabla_{\theta}v_{L}\|_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">‖</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\displaystyle\|\nabla_{\theta}v_{L}\|_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.E93.m2" class="ltx_Math" alttext="\displaystyle\leq\frac{1}{C_{\ref{ass:diagonal-margin}}}\quantity(C_{\ref{lemma:grad_bound},6}+C_{\ref{lemma:grad_bound},7}
\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>6</mn></mrow></msub><mo>+</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>7</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub><mo>/</mo><mi>δ</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{1}{C_{\ref{ass:diagonal-margin}}}\quantity(C_{\ref{lemma:grad_bound},6}+C_{\ref{lemma:grad_bound},7}
\sqrt{\frac{\log(C_{\text{Thm}\tref{thm:finite-n},3}/\delta)}{n}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(93)</span></td></tr></tbody>
</table>
<p id="A5.SS3.SSS0.Px3.p1.3" class="ltx_p">Setting
<math id="A5.SS3.SSS0.Px3.p1.m5" class="ltx_Math" alttext="C_{\ref{lemma:grad_bound},1}\doteq C_{\text{Thm}\ref{thm:finite-n},1}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext class="ltx_mathvariant_italic"><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>1</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\ref{lemma:grad_bound},1}\doteq C_{\text{Thm}\ref{thm:finite-n},1}</annotation></semantics></math>,
<math id="A5.SS3.SSS0.Px3.p1.m6" class="ltx_Math" alttext="C_{\ref{lemma:grad_bound},2}\doteq C_{\ref{lemma:grad_bound},6}/C_{\ref{ass:diagonal-margin}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo>≐</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>6</mn></mrow></msub><mo>/</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lemma:grad_bound},2}\doteq C_{\ref{lemma:grad_bound},6}/C_{\ref{ass:diagonal-margin}}</annotation></semantics></math>,
<math id="A5.SS3.SSS0.Px3.p1.m7" class="ltx_Math" alttext="C_{\ref{lemma:grad_bound},3}\doteq C_{\ref{lemma:grad_bound},7}/C_{\ref{ass:diagonal-margin}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo>≐</mo><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>7</mn></mrow></msub><mo>/</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow></mrow><annotation encoding="application/x-tex">C_{\ref{lemma:grad_bound},3}\doteq C_{\ref{lemma:grad_bound},7}/C_{\ref{ass:diagonal-margin}}</annotation></semantics></math>,
<math id="A5.SS3.SSS0.Px3.p1.m8" class="ltx_Math" alttext="C_{\ref{lemma:grad_bound},4}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},3}" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><mrow><mtext class="ltx_mathvariant_italic"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub><mo>≐</mo><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem2" title="Theorem 2. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a></mtext></mrow><mo>,</mo><mn>3</mn></mrow></msub></mrow><annotation encoding="application/x-tex">C_{\ref{lemma:grad_bound},4}\doteq C_{\text{Thm}\text{\ref{thm:finite-n}},3}</annotation></semantics></math>
completes the proof.
∎</p>
</div>
</section>
</section>
<section id="A5.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">E.4 </span>Proof of Theorem <span id="A5.SS4.2" class="ltx_text"><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></span></h3>

<div id="A5.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof">Proof.</h6>
<div id="A5.SS4.p1" class="ltx_para">
<p id="A5.SS4.p1.1" class="ltx_p"><span id="A5.SS4.p1.1.1" class="ltx_text">Let</span></p>
<table id="A5.Ex40" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex40.m1" class="ltx_Math" alttext="C_{R}\doteq\operatorname*{ess\,sup}_{(p,r)\sim\Delta}\|r\|_{\infty},\qquad C_{v}\doteq\operatorname*{ess\,sup}_{(p,r)\sim\Delta}\|v_{\pi}\|_{\infty}\leq\frac{C_{R}}{1-\gamma},\qquad D_{\theta}\doteq d^{2}+3." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mi>R</mi></msub><mo>≐</mo><mrow><munder><mrow><mi>ess</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>sup</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi mathvariant="normal">Δ</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><mi>r</mi><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>C</mi><mi>v</mi></msub><mo>≐</mo><mrow><munder><mrow><mi>ess</mi><mo lspace="0.170em" rspace="0em">​</mo><mi>sup</mi></mrow><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>∼</mo><mi mathvariant="normal">Δ</mi></mrow></munder><mo>⁡</mo><msub><mrow><mo stretchy="false">‖</mo><msub><mi>v</mi><mi>π</mi></msub><mo stretchy="false">‖</mo></mrow><mi mathvariant="normal">∞</mi></msub></mrow><mo>≤</mo><mfrac><msub><mi>C</mi><mi>R</mi></msub><mrow><mn>1</mn><mo>−</mo><mi>γ</mi></mrow></mfrac></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>D</mi><mi>θ</mi></msub><mo>≐</mo><mrow><msup><mi>d</mi><mn>2</mn></msup><mo>+</mo><mn>3</mn></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{R}\doteq\operatorname*{ess\,sup}_{(p,r)\sim\Delta}\|r\|_{\infty},\qquad C_{v}\doteq\operatorname*{ess\,sup}_{(p,r)\sim\Delta}\|v_{\pi}\|_{\infty}\leq\frac{C_{R}}{1-\gamma},\qquad D_{\theta}\doteq d^{2}+3.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A5.SS4.p2" class="ltx_para">
<p id="A5.SS4.p2.1" class="ltx_p"><span id="A5.SS4.p2.1.1" class="ltx_text">For <math id="A5.SS4.p2.m1" class="ltx_Math" alttext="\eta\in(0,1/2]" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\eta\in(0,1/2]</annotation></semantics></math>, let <math id="A5.SS4.p2.m2" class="ltx_Math" alttext="\mathcal{E}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\eta}</annotation></semantics></math> be the event on which Lemma <span id="A5.SS4.p2.1.1.1" class="ltx_text"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span> and Lemma <span id="A5.SS4.p2.1.1.2" class="ltx_text"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></span> both hold with confidence parameter <math id="A5.SS4.p2.m3" class="ltx_Math" alttext="\eta/2" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>/</mo><mn>2</mn></mrow><annotation encoding="application/x-tex">\eta/2</annotation></semantics></math>. Define</span></p>
<table id="A5.Ex41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex41.m1" class="ltx_Math" alttext="C_{\text{Thm}\text{\ref{thm:emergence}},4}\doteq 2\max\quantity{C_{\tref{lem:decay},1},\,C_{\tref{lemma:grad_bound},1}},\qquad C_{\text{Thm}\text{\ref{thm:emergence}},5}\doteq 2\max\quantity{e,\,C_{\tref{lem:decay},3},\,C_{\tref{lemma:grad_bound},4}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>4</mn></mrow></msub><mo>≐</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub><mo rspace="0.337em">,</mo><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>1</mn></mrow></msub></mrow><mo>}</mo></mrow></mrow></mrow></mrow><mo rspace="2.167em">,</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>5</mn></mrow></msub><mo>≐</mo><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mi>e</mi><mo rspace="0.337em">,</mo><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>3</mn></mrow></msub><mo rspace="0.337em">,</mo><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">10</span></a></mtext><mo>,</mo><mn>4</mn></mrow></msub></mrow><mo>}</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">C_{\text{Thm}\text{\ref{thm:emergence}},4}\doteq 2\max\quantity{C_{\tref{lem:decay},1},\,C_{\tref{lemma:grad_bound},1}},\qquad C_{\text{Thm}\text{\ref{thm:emergence}},5}\doteq 2\max\quantity{e,\,C_{\tref{lem:decay},3},\,C_{\tref{lemma:grad_bound},4}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p2.2" class="ltx_p"><span id="A5.SS4.p2.2.1" class="ltx_text">By a union bound, <math id="A5.SS4.p2.m4" class="ltx_Math" alttext="\Pr(\mathcal E_\eta)\geq 1-\eta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>Pr</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi></msub><mo>)</mo></mrow></mrow><mo>≥</mo><mrow><mn>1</mn><mo>−</mo><mi>η</mi></mrow></mrow><annotation encoding="application/x-tex">\Pr(\mathcal E_\eta)\geq 1-\eta</annotation></semantics></math> whenever <math id="A5.SS4.p2.m5" class="ltx_Math" alttext="n\geq C_{\text{Thm}\text{\ref{thm:emergence}},4}\log(1/\eta)" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>≥</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>4</mn></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mn>1</mn><mo>/</mo><mi>η</mi></mrow><mo>)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">n\geq C_{\text{Thm}\text{\ref{thm:emergence}},4}\log(1/\eta)</annotation></semantics></math>, and with this choice of <math id="A5.SS4.p2.m6" class="ltx_Math" alttext="C_{\text{Thm}\text{\ref{thm:emergence}},5}" display="inline" intent=":literal"><semantics><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>5</mn></mrow></msub><annotation encoding="application/x-tex">C_{\text{Thm}\text{\ref{thm:emergence}},5}</annotation></semantics></math>, the logarithmic terms in both lemmas are bounded by <math id="A5.SS4.p2.m7" class="ltx_Math" alttext="\log(C_{\text{Thm}\tref{thm:emergence},5}/\eta)" display="inline" intent=":literal"><semantics><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>5</mn></mrow></msub><mo>/</mo><mi>η</mi></mrow><mo>)</mo></mrow></mrow><annotation encoding="application/x-tex">\log(C_{\text{Thm}\tref{thm:emergence},5}/\eta)</annotation></semantics></math>.</span></p>
</div>
<div id="A5.SS4.p3" class="ltx_para">
<p id="A5.SS4.p3.1" class="ltx_p"><span id="A5.SS4.p3.1.1" class="ltx_text">Since <math id="A5.SS4.p3.m1" class="ltx_Math" alttext="\delta_{L}(\theta_{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\delta_{L}(\theta_{*})</annotation></semantics></math> in (<a href="#S6.E30" title="In 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">30</span></a>) depends on <math id="A5.SS4.p3.m2" class="ltx_Math" alttext="S_{n+1}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">S_{n+1}</annotation></semantics></math>, define</span></p>
<table id="A5.Ex42" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex42.m1" class="ltx_math_unparsed" alttext="\bar{\delta}_{L}(\theta_{*})\doteq\mathbb{E}_{S_{n+1}\sim p(\cdot|S_{n})}\quantity[\delta_L(\theta_*)]=r(S_{n})+\gamma(P_{\pi}v_{L})(S_{n})-v_{L}(S_{n})." display="block" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>δ</mi><mo>¯</mo></mover><mi>L</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo>≐</mo><msub><mi>𝔼</mi><mrow><mi>S</mi><msub><mrow></mrow><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub><mo>∼</mo><mi>p</mi><mo stretchy="false">(</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em" stretchy="false">|</mo><mi>S</mi><msub><mrow></mrow><mi>n</mi></msub><mo stretchy="false">)</mo></mrow></msub><mrow><mo>[</mo><mrow><msub><mi>δ</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow><mo>=</mo><mi>r</mi><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>γ</mi><mrow><mo stretchy="false">(</mo><msub><mi>P</mi><mi>π</mi></msub><msub><mi>v</mi><mi>L</mi></msub><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo>−</mo><msub><mi>v</mi><mi>L</mi></msub><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{\delta}_{L}(\theta_{*})\doteq\mathbb{E}_{S_{n+1}\sim p(\cdot|S_{n})}\quantity[\delta_L(\theta_*)]=r(S_{n})+\gamma(P_{\pi}v_{L})(S_{n})-v_{L}(S_{n}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p3.2" class="ltx_p"><span id="A5.SS4.p3.2.1" class="ltx_text">By the tower property,</span></p>
<table id="A5.Ex43" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.Ex43.m1" class="ltx_Math" alttext="\mathbb{E}_{(p,r),\tau_{n+1}}\quantity[\delta_L(\theta_*)\nabla_\theta v_L(S_n;\theta_*)]=\mathbb{E}_{(p,r),\tau_{n}}\quantity[\bar\delta_L(\theta_*)\nabla_\theta v_L(S_n;\theta_*)]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>τ</mi><mrow><mi>n</mi><mo>+</mo><mn>1</mn></mrow></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mi>δ</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo>,</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mrow><mrow><mo stretchy="false">(</mo><mi>p</mi><mo>,</mo><mi>r</mi><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>τ</mi><mi>n</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mover accent="true"><mi>δ</mi><mo>¯</mo></mover><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo>,</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E}_{(p,r),\tau_{n+1}}\quantity[\delta_L(\theta_*)\nabla_\theta v_L(S_n;\theta_*)]=\mathbb{E}_{(p,r),\tau_{n}}\quantity[\bar\delta_L(\theta_*)\nabla_\theta v_L(S_n;\theta_*)].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A5.SS4.p3.3" class="ltx_p"><span id="A5.SS4.p3.3.1" class="ltx_text">Let <math id="A5.SS4.p3.m3" class="ltx_Math" alttext="X_{L}\doteq\bar{\delta}_{L}(\theta_{*})\nabla_{\theta}v_{L}(S_{n};\theta_{*})" display="inline" intent=":literal"><semantics><mrow><msub><mi>X</mi><mi>L</mi></msub><mo>≐</mo><mrow><msub><mover accent="true"><mi>δ</mi><mo>¯</mo></mover><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">∇</mo><mi>θ</mi></msub><msub><mi>v</mi><mi>L</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>S</mi><mi>n</mi></msub><mo>,</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">X_{L}\doteq\bar{\delta}_{L}(\theta_{*})\nabla_{\theta}v_{L}(S_{n};\theta_{*})</annotation></semantics></math>. Decomposing the expectation over <math id="A5.SS4.p3.m4" class="ltx_Math" alttext="\mathcal{E}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\eta}</annotation></semantics></math> and <math id="A5.SS4.p3.m5" class="ltx_Math" alttext="\mathcal{E}_{\eta}^{c}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi><mi>c</mi></msubsup><annotation encoding="application/x-tex">\mathcal{E}_{\eta}^{c}</annotation></semantics></math>,</span></p>
<table id="A5.E94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A5.E94.m1" class="ltx_Math" alttext="J_{L}(\theta_{*})=\norm{\E[X_L]}_{1}\leq\mathbb{E}\quantity[\norm{X_L}_1\mathbf 1_{\mathcal E_\eta}]+\mathbb{E}\quantity[\norm{X_L}_1\mathbf 1_{\mathcal E_\eta^c}]." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>J</mi><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>X</mi><mi>L</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>‖</mo></mrow><mn>1</mn></msub><mo>≤</mo><mrow><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>X</mi><mi>L</mi></msub><mo>‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi></msub></msub></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mi>𝔼</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msub><mrow><mo>‖</mo><msub><mi>X</mi><mi>L</mi></msub><mo>‖</mo></mrow><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mn>𝟏</mn><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi><mi>c</mi></msubsup></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">J_{L}(\theta_{*})=\norm{\E[X_L]}_{1}\leq\mathbb{E}\quantity[\norm{X_L}_1\mathbf 1_{\mathcal E_\eta}]+\mathbb{E}\quantity[\norm{X_L}_1\mathbf 1_{\mathcal E_\eta^c}].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(94)</span></td></tr></tbody>
</table>
</div>
<div id="A5.SS4.p4" class="ltx_para">
<p id="A5.SS4.p4.1" class="ltx_p"><span id="A5.SS4.p4.1.1" class="ltx_text">On <math id="A5.SS4.p4.m1" class="ltx_Math" alttext="\mathcal{E}_{\eta}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>η</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\eta}</annotation></semantics></math>, Lemma <span id="A5.SS4.p4.1.1.1" class="ltx_text"><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">7</span></a></span> and Lemma <span id="A5.SS4.p4.1.1.2" class="ltx_text"><a href="#Thmlemma10" title="Lemma 10. ‣ E.3 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">10</span></a></span> give, respectively,</span></p>
<table id="A5.EGx21" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A5.Ex44"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A5.Ex44.m1" class="ltx_Math" alttext="\displaystyle\absolutevalue{\bar\delta_L(\theta_*)}" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><msub><mover accent="true"><mi>δ</mi><mo>¯</mo></mover><mi>L</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>θ</mi><mo>∗</mo></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\absolutevalue{\bar\delta_L(\theta_*)}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A5.Ex44.m2" class="ltx_Math" alttext="\displaystyle\leq(1+\gamma)\quantity[
C_v(1-C_{\ref{ass:diagonal-margin}})^L
+
C_{\tref{lem:decay},2}
\sqrt{
\frac{\log(C_{\text{Thm}\tref{thm:emergence},5}/\eta)}{n}
}
]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>+</mo><mi>γ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mi>C</mi><mi>v</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><msub><mi>C</mi><mtext class="ltx_mathvariant_italic"><a href="#S5.Thmassumption1" title="Assumption 5.1. ‣ 5 Inference-Time Convergence ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref ltx_font_italic" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">5.1</span></a></mtext></msub></mrow><mo stretchy="false">)</mo></mrow><mi>L</mi></msup></mrow><mo>+</mo><mrow><msub><mi>C</mi><mrow><mtext><a href="#Thmlemma7" title="Lemma 7. ‣ E.1 Proof of Lemma ‣ Appendix E Proofs of Section ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref" style="font-size:70%;"><span class="ltx_text ltx_ref_tag">7</span></a></mtext><mo>,</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><msqrt><mstyle displaystyle="true"><mfrac><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><msub><mi>C</mi><mrow><mrow><mtext>Thm</mtext><mtext><a href="#Thmtheorem3" title="Theorem 3. ‣ 6 Emergence of Softmax ICTD under Reinforcement Pretraining ‣ Beyond Linear Attention: Softmax Transformers Implement In-Context Reinforcement Learning" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3</span></a></mtext></mrow><mo>,</mo><mn>5</mn></mrow></msub><mo>/</mo><mi>η</mi></mrow><mo>)</mo></mrow></mrow><mi>n</mi></mfrac></mstyle></msqrt></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(1+\gamma)\quantity[
C_v(1-C_{\ref{ass:diagonal-margin}})^L
+
C_{\tref{lem:decay},2}
\sqrt{
\frac{\log(C_{\text{Thm}\tref{thm:emergence},5}/\eta)}{n}
}
]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
