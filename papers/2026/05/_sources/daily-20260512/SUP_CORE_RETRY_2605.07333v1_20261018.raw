<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex18.m2" class="ltx_Math" alttext="\displaystyle\exp(\langle x(s), x(s') \rangle)\left|\frac{\hat{\mu}_{n}(s^{\prime})\sum_{u}\mu_{\pi}(u)\,\exp(\langle x(s),x(u)\rangle)-\mu_{\pi}(s^{\prime})\sum_{u}\hat{\mu}_{n}(u)\,\exp(\langle x(s),x(u)\rangle)}{\sum_{u}\hat{\mu}_{n}(u)\,\exp(\langle x(s),x(u)\rangle)\cdot\sum_{u}\mu_{\pi}(u)\,\exp(\langle x(s),x(u)\rangle)}\right|" display="inline" intent=":literal"><semantics><mrow><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>u</mi></msub><mrow><msub><mi>μ</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow><mo>−</mo><mrow><msub><mi>μ</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>s</mi><mo>′</mo></msup><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><msub><mo>∑</mo><mi>u</mi></msub><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mrow><mrow><msub><mo>∑</mo><mi>u</mi></msub><mrow><msub><mover accent="true"><mi>μ</mi><mo>^</mo></mover><mi>n</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo rspace="0.055em">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.055em">⋅</mo><mrow><msub><mo>∑</mo><mi>u</mi></msub><mrow><msub><mi>μ</mi><mi>π</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow><mo lspace="0.337em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo stretchy="false">⟨</mo><mrow><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>s</mi><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>x</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>u</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">⟩</mo></mrow><mo>)</mo></mrow></mrow></mrow></mrow></mrow></mfrac></mstyle><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\exp(\langle x(s), x(s') \rangle)\left|\frac{\hat{\mu}_{n}(s^{\prime})\sum_{u}\mu_{\pi}(u)\,\exp(\langle x(s),x(u)\rangle)-\mu_{\pi}(s^{\prime})\sum_{u}\hat{\mu}_{n}(u)\,\exp(\langle x(s),x(u)\rangle)}{\sum_{u}\hat{\mu}_{n}(u)\,\exp(\langle x(s),x(u)\rangle)\cdot\sum_{u}\mu_{\pi}(u)\,\exp(\langle x(s),x(u)\rangle)}\right|</annotation></semantics></math></td>
