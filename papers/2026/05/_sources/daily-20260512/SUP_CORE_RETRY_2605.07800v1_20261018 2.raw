-fg-color:#004D4D;">"eye-level"</span><span id="lstnumberx31.17" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#808080;">,</span><span id="lstnumberx31.18" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx31.19" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#004D4D;">"shot_type"</span><span id="lstnumberx31.20" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#4D4D4D;">:</span><span id="lstnumberx31.21" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx31.22" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#004D4D;">"medium"</span><span id="lstnumberx31.23" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx31.24" class="ltx_text ltx_font_typewriter" style="font-size:70%;">}</span><span id="lstnumberx31.25" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#808080;">,</span>
</div>
<div id="lstnumberx32" class="ltx_listingline"><span id="lstnumberx32.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">        </span><span id="lstnumberx32.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#004D4D;">"visual_description"</span><span id="lstnumberx32.3" class="ltx_text ltx_lst_literate ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#4D4D4D;">:</span>
</div>
<div id="lstnumberx33" class="ltx_listingline"><span id="lstnumberx33.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;">          </span><span id="lstnumberx33.2" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:70%;--ltx-fg-color:#004D4D;">"In<span id="lstnumberx33.2.1" class="ltx_text ltx_lst_space"> </span>SCENE_1,<span id="lstnumberx33.2.2" class="ltx_text ltx_lst_space"> </span>PERSON_1<span id="lstnumberx33.2.3" class="ltx_text ltx_lst_space"> </span>leans<span id="lstnumberx33.2.4" class="ltx_text ltx_lst_space"> </span>over<span id="lstnumberx33.2.5" class="ltx_text ltx_lst_space"> </span>her<span id="lstnumberx33.2.6" class="ltx_text ltx_lst_space"> </span>desk<span id="lstnumberx33.2.7" class="ltx_text ltx_lst_space"> </span>holding<span id="lstnumberx33.2.8" class="ltx_text ltx_lst_space"> </span>OBJECT_1<span id="lstnumberx33.2.9" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx33.2.10" class="ltx_text ltx_lst_space"> </span>her<span id="lstnumberx33.2.11" class="ltx_text ltx_lst_space"> </span>right<span id="lstnumberx33.2.12" class="ltx_text ltx_lst_space"> </span>ear.<span id="lstnumberx33.2.13" class="ltx_text ltx_lst_space"> </span>Her<span id="lstnumberx33.2.14" class="ltx_text ltx_lst_space"> </span>expression<span id="lstnumberx33.2.15" class="ltx_text ltx_lst_space"> </span>shifts<span id="lstnumberx33.2.16" class="ltx_text ltx_lst_space"> </span>from<span id="lstnumberx33.2.17" class="ltx_text ltx_lst_space"> </span>tense<span id="lstnumberx33.2.18" class="ltx_text ltx_lst_space"> </span>concentration<span id="lstnumberx33.2.19" class="ltx_text ltx_lst_space"> </span>to<span id="lstnumberx33.2.20" class="ltx_text ltx_lst_space"> </span>deep<span id="lstnumberx33.2.21" class="ltx_text ltx_lst_space"> </span>anger;<span id="lstnumberx33.2.22" class="ltx_text ltx_lst_space"> </span>she<span id="lstnumberx33.2.23" class="ltx_text ltx_lst_space"> </span>bares<span id="lstnumberx33.2.24" class="ltx_text ltx_lst_space"> </span>her<span id="lstnumberx33.2.25" class="ltx_text ltx_lst_space"> </span>teeth<span id="lstnumberx33.2.26" class="ltx_text ltx_lst_space"> </span>in<span id="lstnumberx33.2.27" class="ltx_text ltx_lst_space"> </span>a<span id="lstnumberx33.2.28" class="ltx_text ltx_lst_space"> </span>snarl<span id="lstnumberx33.2.29" class="ltx_text ltx_lst_space"> </span>while<span id="lstnumberx33.2.30" class="ltx_text ltx_lst_space"> </span>glaring<span id="lstnumberx33.2.31" class="ltx_text ltx_lst_space"> </span>off-camera."</span><span id="lstnumberx33.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:70%;"> </span><span id="lstnumberx33.4" class="ltx_text ltx_font_typewriter" style="font-size:70%;">}</span>
</div>
