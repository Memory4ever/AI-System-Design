<td id="A2.T7.6.4.2" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A2.T7.m16" class="ltx_Math" alttext="128" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">128</mn><annotation encoding="application/x-tex">128</annotation></semantics></math></td></tr>
