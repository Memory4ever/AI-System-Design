<td id="S3.T1.2.5.3" class="ltx_td ltx_align_center"><math id="S3.T1.m7" class="ltx_Math" alttext="\leq" display="inline" intent=":literal"><semantics><mo>≤</mo><annotation encoding="application/x-tex">\leq</annotation></semantics></math>40</td>
<td id="S3.T1.2.5.4" class="ltx_td ltx_align_center">41–129</td>
