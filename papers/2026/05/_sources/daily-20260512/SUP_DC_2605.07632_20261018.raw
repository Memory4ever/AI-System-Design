fiers":[]},{"name":"Buschoff, Luca M. Schulze","nameType":"Personal","givenName":"Luca M. Schulze","familyName":"Buschoff","affiliation":[],"nameIdentifiers":[]},{"name":"Singhi, Nishad","nameType":"Personal","givenName":"Nishad","familyName":"Singhi","affiliation":[],"nameIdentifiers":[]},{"name":"Somerville, Leah H.","nameType":"Personal","givenName":"Leah H.","familyName":"Somerville","affiliation":[],"nameIdentifiers":[]},{"name":"Spektor, Mikhail S.","nameType":"Personal","givenName":"Mikhail S.","familyName":"Spektor","affiliation":[],"nameIdentifiers":[]},{"name":"Sui, Xin","nameType":"Personal","givenName":"Xin","familyName":"Sui","affiliation":[],"nameIdentifiers":[]},{"name":"Summerfield, Christopher","nameType":"Personal","givenName":"Christopher","familyName":"Summerfield","affiliation":[],"nameIdentifiers":[]},{"name":"Thalmann, Mirko","nameType":"Personal","givenName":"Mirko","familyName":"Thalmann","affiliation":[],"nameIdentifiers":[]},{"name":"Thoma, Anna I.","nameType":"Personal","givenName":"Anna I.","familyName":"Thoma","affiliation":[],"nameIdentifiers":[]},{"name":"Tikhomirova, Taisiia","nameType":"Personal","givenName":"Taisiia","familyName":"Tikhomirova","affiliation":[],"nameIdentifiers":[]},{"name":"Truong, Vuong","nameType":"Personal","givenName":"Vuong","familyName":"Truong","affiliation":[],"nameIdentifiers":[]},{"name":"Tsvilodub, Polina","nameType":"Personal","givenName":"Polina","familyName":"Tsvilodub","affiliation":[],"nameIdentifiers":[]},{"name":"Voudouris, Konstantinos","nameType":"Personal","givenName":"Konstantinos","familyName":"Voudouris","affiliation":[],"nameIdentifiers":[]},{"name":"Witte, Kristin","nameType":"Personal","givenName":"Kristin","familyName":"Witte","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Shuchen","nameType":"Personal","givenName":"Shuchen","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Wulff, Dirk U.","nameType":"Personal","givenName":"Dirk U.","familyName":"Wulff","affiliation":[],"nameIdentifiers":[]},{"name":"Xiong, Hua-Dong","nameType":"Personal","givenName":"Hua-Dong","familyName":"Xiong","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Songlin","nameType":"Personal","givenName":"Songlin","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Ying, Lance","nameType":"Personal","givenName":"Lance","familyName":"Ying","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Xinyu","nameType":"Personal","givenName":"Xinyu","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhu, Jian-Qiao","nameType":"Personal","givenName":"Jian-Qiao","familyName":"Zhu","affiliation":[],"nameIdentifiers":[]},{"name":"Schulz, Eric","nameType":"Personal","givenName":"Eric","familyName":"Schulz","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Post-training makes large language models less human-like"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T11:59:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:55:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-25T18:09:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-27T00:04:13Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language models (LLMs) are increasingly used as surrogates for human participants, but it remains unclear which models best capture human behavior and why. To address this, we introduce Psych-201, a novel dataset that enables us to measure behavioral alignment at scale. We find that post-training -- the stage that turns base models into useful assistants -- consistently reduces alignment with human behavior across model families, sizes, and objectives. Moreover, this misalignment widens in newer model generations even as base models continue to improve. Finally, we find that persona-induction -- a popular technique for eliciting human-like behavior by conditioning models on participant-specific information -- does not improve predictions at the level of individuals. Taken together, our results suggest that the very processes that are currently employed to turn LLMs into useful assistants also make them less accurate models of human behavior.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07632","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:24:43.000Z","registered":"2026-05-11T02:24:43.000Z","published":"2026","updated":"2026-05-27T02:44:02.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07632","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}