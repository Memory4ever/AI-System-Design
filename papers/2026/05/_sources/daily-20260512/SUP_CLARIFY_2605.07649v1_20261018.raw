<td id="S4.T1.2.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-top:0.5pt;padding-bottom:0.5pt;"><math id="S4.T1.m5" class="ltx_Math" alttext="24{,}460+5I" display="inline" intent=":literal"><semantics><mrow><mn>24,460</mn><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>I</mi></mrow></mrow><annotation encoding="application/x-tex">24{,}460+5I</annotation></semantics></math></td>
