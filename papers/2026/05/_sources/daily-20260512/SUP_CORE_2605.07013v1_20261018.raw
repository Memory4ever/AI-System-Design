<th id="S4.T2.3.1.5" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.1.5.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Throughput speedup</span></th></tr>
