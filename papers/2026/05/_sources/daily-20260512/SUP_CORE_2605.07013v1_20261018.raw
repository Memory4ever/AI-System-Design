<td id="A1.T4.3.5.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T4.m9" class="ltx_Math" alttext="\mathbb{R}^{B\times Tm}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ℝ</mi><mrow><mrow><mi mathsize="0.900em">B</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">T</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{B\times Tm}</annotation></semantics></math></td>
<td id="A1.T4.3.5.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T4.m10" class="ltx_Math" alttext="Tm" display="inline" intent=":literal"><semantics><mrow><mi mathsize="0.900em">T</mi><mo lspace="0em" rspace="0em">​</mo><mi mathsize="0.900em">m</mi></mrow><annotation encoding="application/x-tex">Tm</annotation></semantics></math></td>
<td id="A1.T4.3.5.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t">
