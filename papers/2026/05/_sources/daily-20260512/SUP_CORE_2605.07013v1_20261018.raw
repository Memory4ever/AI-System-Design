</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#FFD9B3;--ltx-fill-color:#FFF9F2;" fill="#FFF9F2" stroke="#FFD9B3" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path d="M 195.49 -382.28 L -195.49 -382.28 C -198.55 -382.28 -201.03 -384.76 -201.03 -387.82 L -201.03 -533.06 C -201.03 -536.12 -198.55 -538.6 -195.49 -538.6 L 195.49 -538.6 C 198.55 -538.6 201.03 -536.12 201.03 -533.06 L 201.03 -387.82 C 201.03 -384.76 198.55 -382.28 195.49 -382.28 Z M -201.03 -538.6"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -181.66 -460.44)"><foreignObject style="--ltx-fo-width:28.39em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="392.84"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
