</span></span></span></foreignObject></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000"><g stroke-width="0.4pt"><g style="--ltx-stroke-color:#D9D9D9;--ltx-fill-color:#F9F9F9;" fill="#F9F9F9" stroke="#D9D9D9" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt"><path d="M 188.79 -144.89 L -188.79 -144.89 C -191.85 -144.89 -194.32 -147.37 -194.32 -150.43 L -194.32 -341.86 C -194.32 -344.92 -191.85 -347.39 -188.79 -347.39 L 188.79 -347.39 C 191.85 -347.39 194.32 -344.92 194.32 -341.86 L 194.32 -150.43 C 194.32 -147.37 191.85 -144.89 188.79 -144.89 Z M -194.32 -347.39"></path></g><g style="--ltx-stroke-color:#000000;--ltx-fill-color:#000000;" fill="#000000" stroke="#000000" stroke-dasharray="3.0pt,3.0pt" stroke-dashoffset="0.0pt" transform="matrix(1.0 0.0 0.0 1.0 -177.72 -246.14)"><foreignObject style="--ltx-fo-width:27.77em;--ltx-fo-height:0em;--ltx-fo-depth:0em;font-size:10pt;" height="0" overflow="visible" transform="matrix(1 0 0 -1 0 0)" width="384.26"><span class="ltx_foreignobject_container"><span class="ltx_foreignobject_content">
