<tr id="S4.T2.3.2" class="ltx_tr">
<td id="S4.T2.3.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.2.1.1" class="ltx_text" style="font-size:90%;">LM1B (<math id="S4.T2.m1" class="ltx_Math" alttext="T=128" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>=</mo><mn>128</mn></mrow><annotation encoding="application/x-tex">T=128</annotation></semantics></math>, <math id="S4.T2.m2" class="ltx_Math" alttext="V=30\mathrm{k}" display="inline" intent=":literal"><semantics><mrow><mi>V</mi><mo>=</mo><mrow><mn>30</mn><mo lspace="0em" rspace="0em">​</mo><mi>k</mi></mrow></mrow><annotation encoding="application/x-tex">V=30\mathrm{k}</annotation></semantics></math>)</span></td>
<td id="S4.T2.3.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.2.2.1" class="ltx_text" style="font-size:90%;">Train</span></td>
<td id="S4.T2.3.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.2.3.1" class="ltx_text" style="font-size:90%;">512</span></td>
<td id="S4.T2.3.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S4.T2.m3" class="ltx_math_unparsed" alttext="1.64\times" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">1.64</mn><mo lspace="0.222em" mathsize="0.900em">×</mo></mrow><annotation encoding="application/x-tex">1.64\times</annotation></semantics></math></td>
<td id="S4.T2.3.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S4.T2.m4" class="ltx_math_unparsed" alttext="2.31\times" display="inline" intent=":literal"><semantics><mrow><mn mathsize="0.900em">2.31</mn><mo lspace="0.222em" mathsize="0.900em">×</mo></mrow><annotation encoding="application/x-tex">2.31\times</annotation></semantics></math></td></tr>
<tr id="S4.T2.3.3" class="ltx_tr">
