<span id="A1.T4.3.1.4.1" class="ltx_inline-block ltx_align_top" style="width:96.6pt;">
<span id="A1.T4.3.1.4.1.1" class="ltx_p ltx_align_left"><span id="A1.T4.3.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Output/Loss Boundary</span></span>
</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A1.T4.3.2" class="ltx_tr">
<td id="A1.T4.3.2.1" class="ltx_td ltx_align_left ltx_border_t"><span id="A1.T4.3.2.1.1" class="ltx_text" style="font-size:90%;">Continuous Simplex / One-Hot</span></td>
<td id="A1.T4.3.2.2" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T4.m1" class="ltx_Math" alttext="\mathbb{R}^{B\times T\times V}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ℝ</mi><mrow><mi mathsize="0.900em">B</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">T</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">V</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{B\times T\times V}</annotation></semantics></math></td>
<td id="A1.T4.3.2.3" class="ltx_td ltx_align_center ltx_border_t"><math id="A1.T4.m2" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
<td id="A1.T4.3.2.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T4.3.2.4.1" class="ltx_inline-block ltx_align_top" style="width:96.6pt;">
<span id="A1.T4.3.2.4.1.1" class="ltx_p ltx_align_left"><math id="A1.T4.m3" class="ltx_Math" alttext="\mathbb{R}^{B\times T\times V}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ℝ</mi><mrow><mi mathsize="0.900em">B</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">T</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">V</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{B\times T\times V}</annotation></semantics></math><span id="A1.T4.3.2.4.1.1.1" class="ltx_text" style="font-size:90%;"> logits</span></span>
</span></td></tr>
<tr id="A1.T4.3.3" class="ltx_tr">
<td id="A1.T4.3.3.1" class="ltx_td ltx_align_left"><span id="A1.T4.3.3.1.1" class="ltx_text" style="font-size:90%;">Continuous Embedding-Space</span></td>
<td id="A1.T4.3.3.2" class="ltx_td ltx_align_center"><math id="A1.T4.m4" class="ltx_Math" alttext="\mathbb{R}^{B\times T\times d}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ℝ</mi><mrow><mi mathsize="0.900em">B</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">T</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">d</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{B\times T\times d}</annotation></semantics></math></td>
<td id="A1.T4.3.3.3" class="ltx_td ltx_align_center"><math id="A1.T4.m5" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math></td>
<td id="A1.T4.3.3.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top">
<span id="A1.T4.3.3.4.1" class="ltx_inline-block ltx_align_top" style="width:96.6pt;">
<span id="A1.T4.3.3.4.1.1" class="ltx_p ltx_align_left"><math id="A1.T4.m6" class="ltx_Math" alttext="\mathbb{R}^{B\times T\times V}" display="inline" intent=":literal"><semantics><msup><mi mathsize="0.900em">ℝ</mi><mrow><mi mathsize="0.900em">B</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">T</mi><mo lspace="0.222em" mathsize="0.900em" rspace="0.222em">×</mo><mi mathsize="0.900em">V</mi></mrow></msup><annotation encoding="application/x-tex">\mathbb{R}^{B\times T\times V}</annotation></semantics></math><span id="A1.T4.3.3.4.1.1.1" class="ltx_text" style="font-size:90%;"> logits</span></span>
</span></td></tr>
<tr id="A1.T4.3.4" class="ltx_tr">
<td id="A1.T4.3.4.1" class="ltx_td ltx_align_left"><span id="A1.T4.3.4.1.1" class="ltx_text" style="font-size:90%;">Discrete Token-State</span></td>
