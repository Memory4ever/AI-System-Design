<th id="S4.T2.3.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Dataset scale</span></th>
<th id="S4.T2.3.1.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.1.2.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Mode</span></th>
<th id="S4.T2.3.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.3.1.3.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Batch</span></th>
