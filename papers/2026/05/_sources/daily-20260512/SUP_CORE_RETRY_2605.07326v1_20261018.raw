<td id="S4.T3.7.1.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.2.1" class="ltx_text" style="font-size:298%;">4D-Occ</span></td>
<td id="S4.T3.7.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.3.1" class="ltx_text" style="font-size:298%;">-</span></td>
<td id="S4.T3.7.1.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.4.1" class="ltx_text" style="font-size:298%;">30.4</span></td>
<td id="S4.T3.7.1.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.5.1" class="ltx_text" style="font-size:298%;">23.2</span></td>
<td id="S4.T3.7.1.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.6.1" class="ltx_text" style="font-size:298%;">0.308</span></td>
<td id="S4.T3.7.1.2.7" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:2.25pt;padding-bottom:2.25pt;"><span id="S4.T3.7.1.2.7.1" class="ltx_text" style="font-size:298%;">3.52</span></td></tr>
