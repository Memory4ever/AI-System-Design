<td id="S1.T1.5.1.3.5" class="ltx_td ltx_align_center ltx_border_t"><span id="S1.T1.5.1.3.5.1" class="ltx_text ltx_font_bold">0.043</span></td>
<td id="S1.T1.5.1.3.6" class="ltx_td ltx_align_center ltx_border_t"><span id="S1.T1.5.1.3.6.1" class="ltx_text ltx_font_bold">0.981</span></td>
