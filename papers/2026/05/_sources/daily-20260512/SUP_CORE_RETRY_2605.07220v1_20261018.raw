<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex90.m1" class="ltx_Math" alttext="\displaystyle\leq(e^{t-t_{k}}-1)\Big(\varepsilon_{\delta}+R_{0}+\frac{\gamma\big(\varepsilon_{\delta}+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}+\frac{(\gamma-1)\left|\mathcal{I}\right|(\varepsilon_{\delta}+D_{0})e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t_{k}}^{2})}}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>+</mo><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo fence="false" rspace="0.167em">|</mo><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>+</mo><mi>D</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>24</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq(e^{t-t_{k}}-1)\Big(\varepsilon_{\delta}+R_{0}+\frac{\gamma\big(\varepsilon_{\delta}+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}+\frac{(\gamma-1)\left|\mathcal{I}\right|(\varepsilon_{\delta}+D_{0})e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t_{k}}^{2})}}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big)</annotation></semantics></math></td>
