<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p2.3" class="ltx_p">Therefore, when <math id="A2.SS4.p2.m5" class="ltx_Math" alttext="\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\geq d_{0}/3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\geq d_{0}/3</annotation></semantics></math>, there exists <math id="A2.SS4.p2.m6" class="ltx_Math" alttext="\tau_{1}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>1</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau_{1}&gt;0</annotation></semantics></math> that depends only on <math id="A2.SS4.p2.m7" class="ltx_Math" alttext="(p_{0},\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{0},\gamma)</annotation></semantics></math>, such that for all <math id="A2.SS4.p2.m8" class="ltx_Math" alttext="t_{k}\in[\tau_{1},T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>τ</mi><mn>1</mn></msub><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t_{k}\in[\tau_{1},T)</annotation></semantics></math> and <math id="A2.SS4.p2.m9" class="ltx_Math" alttext="t\in[t_{k},t_{k+1})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{k},t_{k+1})</annotation></semantics></math>, it holds that</p>
<table id="A2.EGx79" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E50"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E50.m1" class="ltx_Math" alttext="\displaystyle\mathsf{F}_{2}(t)\leq-\frac{1}{4\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}+\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝖥</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝖽𝗂𝗌𝗍</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{F}_{2}(t)\leq-\frac{1}{4\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}+\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p2.4" class="ltx_p">Combining <a href="#A2.E46" title="In B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">46</span></a>, <a href="#A2.E48" title="Equation 48 ‣ B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">48</span></a> and <a href="#A2.E50" title="Equation 50 ‣ B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>, we conclude that under
Assumption <a href="#S3.Thmass2" title="Assumption 3.2. ‣ 3.1 Summary of main results ‣ 3 Results for DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, there exist <math id="A2.SS4.p2.m10" class="ltx_Math" alttext="\tau_{0},\kappa_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>0</mn></msub><mo>,</mo><mrow><msub><mi>κ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\tau_{0},\kappa_{0}&gt;0</annotation></semantics></math>, such that for all <math id="A2.SS4.p2.m11" class="ltx_Math" alttext="\tau_{0}\leq t&lt;T" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mn>0</mn></msub><mo>≤</mo><mi>t</mi><mo>&lt;</mo><mi>T</mi></mrow><annotation encoding="application/x-tex">\tau_{0}\leq t&lt;T</annotation></semantics></math> and <math id="A2.SS4.p2.m12" class="ltx_Math" alttext="\kappa\in(0,\kappa_{0}]" display="inline" intent=":literal"><semantics><mrow><mi>κ</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><msub><mi>κ</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa\in(0,\kappa_{0}]</annotation></semantics></math>,</p>
<table id="A2.EGx80" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E51"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E51.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\frac{1}{2}\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|^{2}\leq-\frac{1}{5\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2},\end{split}" display="inline" intent=":literal"><semantics><mtable><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝖽𝗂𝗌𝗍</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\frac{1}{2}\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|^{2}\leq-\frac{1}{5\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p2.5" class="ltx_p">completing the proof.</p>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Proof of Lemma <a href="#A2.Thmlem3" title="Lemma B.3. ‣ B.2 Proof of Theorem ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.3</span></a></h3>

<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p">For any <math id="A2.SS5.p1.m1" class="ltx_Math" alttext="z\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>z</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">z\in\mathbb{R}^{d}</annotation></semantics></math> that satisfies <math id="A2.SS5.p1.m2" class="ltx_Math" alttext="\mathsf{dist}(z,K_{\eta_{0}})\leq d_{0}/3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(z,K_{\eta_{0}})\leq d_{0}/3</annotation></semantics></math>, it holds that (recall <math id="A2.SS5.p1.m3" class="ltx_Math" alttext="\widetilde{\sigma}_{T-t}^{2}=\lambda_{T-t}^{-2}\sigma_{T-t}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup><mo>=</mo><mrow><msubsup><mi>λ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\sigma}_{T-t}^{2}=\lambda_{T-t}^{-2}\sigma_{T-t}^{2}</annotation></semantics></math>)</p>
<table id="A2.EGx81" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex76"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex76.m1" class="ltx_Math" alttext="\displaystyle\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t}(z)=" display="inline" intent=":literal"><semantics><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t}(z)=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex76.m2" class="ltx_Math" alttext="\displaystyle\,\frac{\sum_{\eta\neq\eta_{0}}w_{\eta}\int p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\mathrm{d}x}{\sum_{\eta\in\mathcal{I}}w_{\eta}\int p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\mathrm{d}x}" display="inline" intent=":literal"><semantics><mstyle displaystyle="true"><mfrac><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>η</mi></msub><mo>∫</mo><mi>p</mi><msub><mrow></mrow><mi>η</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mo>‖</mo><mi>x</mi><mo>−</mo><mi>z</mi><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup><mi>d</mi><mi>x</mi></mrow><mrow><mo>∑</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>η</mi></msub><mo>∫</mo><mi>p</mi><msub><mrow></mrow><mi>η</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mo>‖</mo><mi>x</mi><mo>−</mo><mi>z</mi><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup><mi>d</mi><mi>x</mi></mrow></mfrac></mstyle><annotation encoding="application/x-tex">\displaystyle\,\frac{\sum_{\eta\neq\eta_{0}}w_{\eta}\int p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\mathrm{d}x}{\sum_{\eta\in\mathcal{I}}w_{\eta}\int p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\mathrm{d}x}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex77"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex77.m1" class="ltx_Math" alttext="\displaystyle=" display="inline" intent=":literal"><semantics><mo>=</mo><annotation encoding="application/x-tex">\displaystyle=</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex77.m2" class="ltx_Math" alttext="\displaystyle\,\Bigg({1+\frac{w_{\eta_{0}}\int_{K_{\eta_{0}}}p_{\eta_{0}}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\,\mathrm{d}x}{\sum\limits_{\eta\neq\eta_{0}}w_{\eta}\int_{K_{\eta}}p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\,\mathrm{d}x}}\Bigg)^{-1}" display="inline" intent=":literal"><semantics><msup><mrow><mo maxsize="2.600em" minsize="2.600em">(</mo><mrow><mn>1</mn><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>w</mi><msub><mrow></mrow><msub><mi>η</mi><mn>0</mn></msub></msub><mo>∫</mo><msub><mrow></mrow><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mi>p</mi><msub><mrow></mrow><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mo>‖</mo><mi>x</mi><mo>−</mo><mi>z</mi><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup><mi>d</mi><mi>x</mi></mrow><mrow><mo movablelimits="false">∑</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></msub><mi>w</mi><msub><mrow></mrow><mi>η</mi></msub><mo>∫</mo><msub><mrow></mrow><msub><mi>K</mi><mi>η</mi></msub></msub><mi>p</mi><msub><mrow></mrow><mi>η</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mo>‖</mo><mi>x</mi><mo>−</mo><mi>z</mi><mo>‖</mo><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>2</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup><mi>d</mi><mi>x</mi></mrow></mfrac></mstyle></mrow><mo maxsize="2.600em" minsize="2.600em">)</mo></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">\displaystyle\,\Bigg({1+\frac{w_{\eta_{0}}\int_{K_{\eta_{0}}}p_{\eta_{0}}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\,\mathrm{d}x}{\sum\limits_{\eta\neq\eta_{0}}w_{\eta}\int_{K_{\eta}}p_{\eta}(x)e^{-\left\|x-z\right\|^{2}/(2\widetilde{\sigma}_{T-t}^{2})}\,\mathrm{d}x}}\Bigg)^{-1}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.p1.2" class="ltx_p">We next divide the proof into two parts based on the distance to <math id="A2.SS5.p1.m4" class="ltx_Math" alttext="K_{\eta_{0}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">K_{\eta_{0}}</annotation></semantics></math>.</p>
</div>
<section id="A2.SS5.SSSx1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Case I: <math id="A2.SS5.SSSx1.m1" class="ltx_Math" alttext="\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\in[\varepsilon,d_{0}/3)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>ε</mi><mo>,</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\in[\varepsilon,d_{0}/3)</annotation></semantics></math></h4>

<div id="A2.SS5.SSSx1.p1" class="ltx_para">
<p id="A2.SS5.SSSx1.p1.1" class="ltx_p">Recall that the three index sets are defined in <a href="#A2.E33" title="In B.3 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">33</span></a>.
When <math id="A2.SS5.SSSx1.p1.m1" class="ltx_Math" alttext="\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})&lt;d_{0}/3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>&lt;</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})&lt;d_{0}/3</annotation></semantics></math> and <math id="A2.SS5.SSSx1.p1.m2" class="ltx_Math" alttext="\tau_{\varepsilon}" display="inline" intent=":literal"><semantics><msub><mi>τ</mi><mi>ε</mi></msub><annotation encoding="application/x-tex">\tau_{\varepsilon}</annotation></semantics></math> is sufficiently close to <math id="A2.SS5.SSSx1.p1.m3" class="ltx_Math" alttext="T" display="inline" intent=":literal"><semantics><mi>T</mi><annotation encoding="application/x-tex">T</annotation></semantics></math> (threshold depending only on <math id="A2.SS5.SSSx1.p1.m4" class="ltx_Math" alttext="d_{0}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mn>0</mn></msub><annotation encoding="application/x-tex">d_{0}</annotation></semantics></math>), we have</p>
<table id="A2.Ex78" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex78.m1" class="ltx_Math" alttext="\mathsf{dist}(z_{t_{k}},K_{\eta})-\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\geq\frac{2d_{0}}{3}" display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><mi>η</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mn>3</mn></mfrac></mrow><annotation encoding="application/x-tex">\mathsf{dist}(z_{t_{k}},K_{\eta})-\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\geq\frac{2d_{0}}{3}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.2" class="ltx_p">for all <math id="A2.SS5.SSSx1.p1.m5" class="ltx_Math" alttext="\eta\neq\eta_{0}" display="inline" intent=":literal"><semantics><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">\eta\neq\eta_{0}</annotation></semantics></math>.
Therefore, via a similar calculation leading to <a href="#A2.E40" title="In B.3 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">40</span></a>, we have</p>
<table id="A2.EGx82" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E52"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E52.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t}(z)&amp;\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}\Xi_{T-t}^{d}}\cdot\exp\Big(-\frac{(\mathsf{dist}(z_{t},K_{\eta_{0}})+2/3\cdot d_{0})^{2}-(\mathsf{dist}(z_{t},K_{\eta_{0}})+\Xi_{T-t})^{2}}{2\widetilde{\sigma}_{T-t}^{2}}\Big)\\
&amp;\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\cdot\exp\left(-\frac{d_{0}^{2}}{24\widetilde{\sigma}_{T-t}^{2}}\right).\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>|</mo></mrow><mrow><mrow><mrow><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msubsup><mi mathvariant="normal">Ξ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mi>d</mi></msubsup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mrow><mn>2</mn><mo>/</mo><mn>3</mn></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>−</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>z</mi><mi>t</mi></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi mathvariant="normal">Ξ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>|</mo></mrow><mrow><mrow><mrow><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>d</mi><mn>0</mn><mn>2</mn></msubsup><mrow><mn>24</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t}(z)&amp;\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}\Xi_{T-t}^{d}}\cdot\exp\Big(-\frac{(\mathsf{dist}(z_{t},K_{\eta_{0}})+2/3\cdot d_{0})^{2}-(\mathsf{dist}(z_{t},K_{\eta_{0}})+\Xi_{T-t})^{2}}{2\widetilde{\sigma}_{T-t}^{2}}\Big)\\
&amp;\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\cdot\exp\left(-\frac{d_{0}^{2}}{24\widetilde{\sigma}_{T-t}^{2}}\right).\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.3" class="ltx_p">For all <math id="A2.SS5.SSSx1.p1.m6" class="ltx_Math" alttext="t\in[t_{k},t_{k+1})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{k},t_{k+1})</annotation></semantics></math>, recall that</p>
<table id="A2.EGx83" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex79.m1" class="ltx_Math" alttext="\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|=\frac{e^{t-t_{k}}}{\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|}\cdot\big(\mathsf{F}_{1}(t)+\mathsf{F}_{2}(t)\big)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><msub><mi>𝖥</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>𝖥</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|=\frac{e^{t-t_{k}}}{\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|}\cdot\big(\mathsf{F}_{1}(t)+\mathsf{F}_{2}(t)\big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.4" class="ltx_p">where <math id="A2.SS5.SSSx1.p1.m7" class="ltx_Math" alttext="\mathsf{F}_{1}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖥</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{F}_{1}(t)</annotation></semantics></math> and <math id="A2.SS5.SSSx1.p1.m8" class="ltx_Math" alttext="\mathsf{F}_{2}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖥</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{F}_{2}(t)</annotation></semantics></math> are defined in <a href="#A2.E47" title="In B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">47</span></a>.
By Lemma <a href="#A1.Thmlem2" title="Lemma A.2 (Projection is to close to a tilted mean). ‣ Appendix A Technical lemmas ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.2</span></a>,</p>
<table id="A2.EGx84" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E53"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E53.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\left\|F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|\leq&amp;\,\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+\left\|\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})-m_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|\\
\leq&amp;\,\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1},\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><mo>‖</mo><mrow><msub><mi>F</mi><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mo>≤</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mo>‖</mo><mrow><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>m</mi><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow></mtd></mtr><mtr><mtd class="ltx_align_right" columnalign="right"><mo>≤</mo></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo>,</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\left\|F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|\leq&amp;\,\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+\left\|\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})-m_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|\\
\leq&amp;\,\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1},\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.5" class="ltx_p">where <math id="A2.SS5.SSSx1.p1.m9" class="ltx_Math" alttext="C_{K_{\eta_{0}}}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">C_{K_{\eta_{0}}}&gt;0</annotation></semantics></math> is a constant that depends only on <math id="A2.SS5.SSSx1.p1.m10" class="ltx_Math" alttext="K_{\eta_{0}}" display="inline" intent=":literal"><semantics><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><annotation encoding="application/x-tex">K_{\eta_{0}}</annotation></semantics></math>.
Recall that <math id="A2.SS5.SSSx1.p1.m11" class="ltx_Math" alttext="d_{0}=\inf_{y\in K_{\eta},\,y^{\prime}\in K_{\eta^{\prime}},\,\eta\neq\eta^{\prime}}\left\|y-y^{\prime}\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">inf</mo><mrow><mrow><mi>y</mi><mo>∈</mo><msub><mi>K</mi><mi>η</mi></msub></mrow><mo rspace="0.337em">,</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>K</mi><msup><mi>η</mi><mo>′</mo></msup></msub></mrow><mo rspace="0.337em">,</mo><mrow><mi>η</mi><mo>≠</mo><msup><mi>η</mi><mo>′</mo></msup></mrow></mrow></msub><mrow><mo>‖</mo><mrow><mi>y</mi><mo>−</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{0}=\inf_{y\in K_{\eta},\,y^{\prime}\in K_{\eta^{\prime}},\,\eta\neq\eta^{\prime}}\left\|y-y^{\prime}\right\|</annotation></semantics></math>, <math id="A2.SS5.SSSx1.p1.m12" class="ltx_math_unparsed" alttext="D_{0}=\sup_{y,y^{\prime}\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y-y^{\prime}\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mi>y</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo rspace="0em">∈</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></msub><mi>K</mi><msub><mrow></mrow><mi>η</mi></msub></mrow></msub><mrow><mo>‖</mo><mi>y</mi><mo>−</mo><msup><mi>y</mi><mo>′</mo></msup><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">D_{0}=\sup_{y,y^{\prime}\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y-y^{\prime}\right\|</annotation></semantics></math> and <math id="A2.SS5.SSSx1.p1.m13" class="ltx_math_unparsed" alttext="R_{0}=\sup_{y\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mi>y</mi><mo rspace="0em">∈</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></msub><mi>K</mi><msub><mrow></mrow><mi>η</mi></msub></mrow></msub><mrow><mo>‖</mo><mi>y</mi><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">R_{0}=\sup_{y\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y\right\|</annotation></semantics></math>.
By <a href="#A2.E52" title="In Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">52</span></a> and <a href="#A2.E53" title="Equation 53 ‣ Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">53</span></a> and the triangle inequality, we see that</p>
<table id="A2.EGx85" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E54"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td colspan="2" class="ltx_td ltx_align_center ltx_eqn_cell"><math id="A2.E54.m1" class="ltx_Math" alttext="\displaystyle\begin{split}\mathsf{F}_{1}(t)=&amp;(e^{t-t_{k}}-1)\cdot\left\|\widehat{z}_{t_{k}}+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})-\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\in\mathcal{I}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\|^{2}\\
&amp;\leq(e^{t-t_{k}}-1)\cdot\Big(\left\|\widehat{z}_{t_{k}}\right\|+\frac{\gamma\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}\\
&amp;\qquad+\frac{(\gamma-1)\left|\mathcal{I}\right|e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t}^{2})}(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+D_{0})}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big)^{2}.\end{split}" display="inline" intent=":literal"><semantics><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd class="ltx_align_right" columnalign="right"><mrow><mrow><msub><mi>𝖥</mi><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mphantom></mphantom></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo>‖</mo><mrow><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>−</mo><mn>1</mn></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo>−</mo><mn>1</mn></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo>‖</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>‖</mo></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><msup><mrow><mo fence="true" rspace="0em">OPEN</mo><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo fence="false" rspace="0.167em">|</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>24</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>𝖽𝗂𝗌𝗍</mi><mo stretchy="false">(</mo><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mrow></mrow><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><mi>K</mi><msub><mrow></mrow><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo><mo>+</mo><mi>D</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mrow><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable><annotation encoding="application/x-tex">\displaystyle\begin{split}\mathsf{F}_{1}(t)=&amp;(e^{t-t_{k}}-1)\cdot\left\|\widehat{z}_{t_{k}}+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})-\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\in\mathcal{I}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\|^{2}\\
&amp;\leq(e^{t-t_{k}}-1)\cdot\Big(\left\|\widehat{z}_{t_{k}}\right\|+\frac{\gamma\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}\\
&amp;\qquad+\frac{(\gamma-1)\left|\mathcal{I}\right|e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t}^{2})}(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+D_{0})}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big)^{2}.\end{split}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.6" class="ltx_p">As for <math id="A2.SS5.SSSx1.p1.m14" class="ltx_Math" alttext="\mathsf{F}_{2}(t)" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝖥</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{F}_{2}(t)</annotation></semantics></math>, by the upper bound in <a href="#A2.E49" title="In B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">49</span></a>, there exists <math id="A2.SS5.SSSx1.p1.m15" class="ltx_Math" alttext="\overline{\tau}_{1,\varepsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>ε</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{\tau}_{1,\varepsilon}&gt;0</annotation></semantics></math> that depends only on <math id="A2.SS5.SSSx1.p1.m16" class="ltx_Math" alttext="(p_{0},\varepsilon,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><mi>ε</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{0},\varepsilon,\gamma)</annotation></semantics></math>, such that for all <math id="A2.SS5.SSSx1.p1.m17" class="ltx_Math" alttext="t_{k}\in(\overline{\tau}_{1,\varepsilon},T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mrow><mn>1</mn><mo>,</mo><mi>ε</mi></mrow></msub><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t_{k}\in(\overline{\tau}_{1,\varepsilon},T)</annotation></semantics></math> and <math id="A2.SS5.SSSx1.p1.m18" class="ltx_Math" alttext="t\in[t_{k},t_{k+1})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{k},t_{k+1})</annotation></semantics></math>,</p>
<table id="A2.EGx86" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.E55"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E55.m1" class="ltx_Math" alttext="\displaystyle\mathsf{F}_{2}(t)\leq-\frac{1}{4\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}+\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}\big)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝖥</mi><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝖽𝗂𝗌𝗍</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow><mo>+</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{F}_{2}(t)\leq-\frac{1}{4\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}+\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}\big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(55)</span></td></tr></tbody>
</table>
<p id="A2.SS5.SSSx1.p1.7" class="ltx_p">Putting together <a href="#A2.E54" title="In Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eqs.</span> <span class="ltx_text ltx_ref_tag">54</span></a> and <a href="#A2.E55" title="Equation 55 ‣ Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>, we conclude that there exists <math id="A2.SS5.SSSx1.p1.m19" class="ltx_Math" alttext="\tau_{1,\varepsilon}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>τ</mi><mrow><mn>1</mn><mo>,</mo><mi>ε</mi></mrow></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\tau_{1,\varepsilon}&gt;0</annotation></semantics></math> that depends only on <math id="A2.SS5.SSSx1.p1.m20" class="ltx_Math" alttext="(p_{0},\varepsilon,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><mi>ε</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(p_{0},\varepsilon,\gamma)</annotation></semantics></math>, such that for all <math id="A2.SS5.SSSx1.p1.m21" class="ltx_Math" alttext="t_{k}\in(\tau_{1,\varepsilon},T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><msub><mi>τ</mi><mrow><mn>1</mn><mo>,</mo><mi>ε</mi></mrow></msub><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t_{k}\in(\tau_{1,\varepsilon},T)</annotation></semantics></math> and <math id="A2.SS5.SSSx1.p1.m22" class="ltx_Math" alttext="t\in[t_{k},t_{k+1})" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t\in[t_{k},t_{k+1})</annotation></semantics></math>,</p>
<table id="A2.EGx87" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex80.m1" class="ltx_Math" alttext="\displaystyle\frac{1}{2}\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|^{2}\leq-\frac{1}{5\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msup></mrow><mo>≤</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>𝖽𝗂𝗌𝗍</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\frac{1}{2}\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|^{2}\leq-\frac{1}{5\sigma_{T-t_{k}}^{2}}\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})^{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</section>
<section id="A2.SS5.SSSx2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection">Case II: <math id="A2.SS5.SSSx2.m1" class="ltx_Math" alttext="\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\in[d_{0}/3,\infty)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow><mo>,</mo><mi mathvariant="normal">∞</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\in[d_{0}/3,\infty)</annotation></semantics></math></h4>

<div id="A2.SS5.SSSx2.p1" class="ltx_para">
<p id="A2.SS5.SSSx2.p1.1" class="ltx_p">This part follows immediately from Lemma <a href="#A2.Thmlem2" title="Lemma B.2. ‣ B.2 Proof of Theorem ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.2</span></a>.
We complete the proof by putting together results in these two cases.</p>
</div>
</section>
</section>
<section id="A2.SS6" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.6 </span>Proof of Lemma <a href="#A2.Thmlem4" title="Lemma B.4. ‣ B.2 Proof of Theorem ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a></h3>

<div id="A2.SS6.p1" class="ltx_para">
<p id="A2.SS6.p1.1" class="ltx_p">Recall that <math id="A2.SS6.p1.m1" class="ltx_Math" alttext="d_{0}=\inf_{y\in K_{\eta},\,y^{\prime}\in K_{\eta^{\prime}},\,\eta\neq\eta^{\prime}}\left\|y-y^{\prime}\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0em">inf</mo><mrow><mrow><mi>y</mi><mo>∈</mo><msub><mi>K</mi><mi>η</mi></msub></mrow><mo rspace="0.337em">,</mo><mrow><msup><mi>y</mi><mo>′</mo></msup><mo>∈</mo><msub><mi>K</mi><msup><mi>η</mi><mo>′</mo></msup></msub></mrow><mo rspace="0.337em">,</mo><mrow><mi>η</mi><mo>≠</mo><msup><mi>η</mi><mo>′</mo></msup></mrow></mrow></msub><mrow><mo>‖</mo><mrow><mi>y</mi><mo>−</mo><msup><mi>y</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{0}=\inf_{y\in K_{\eta},\,y^{\prime}\in K_{\eta^{\prime}},\,\eta\neq\eta^{\prime}}\left\|y-y^{\prime}\right\|</annotation></semantics></math>, <math id="A2.SS6.p1.m2" class="ltx_math_unparsed" alttext="R_{0}=\sup_{y\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>R</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mi>y</mi><mo rspace="0em">∈</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></msub><mi>K</mi><msub><mrow></mrow><mi>η</mi></msub></mrow></msub><mrow><mo>‖</mo><mi>y</mi><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">R_{0}=\sup_{y\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y\right\|</annotation></semantics></math>, <math id="A2.SS6.p1.m3" class="ltx_math_unparsed" alttext="D_{0}=\sup_{y,y^{\prime}\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y-y^{\prime}\right\|" display="inline" intent=":literal"><semantics><mrow><msub><mi>D</mi><mn>0</mn></msub><mo rspace="0.1389em">=</mo><msub><mo lspace="0.1389em" rspace="0em">sup</mo><mrow><mi>y</mi><mo>,</mo><mi>y</mi><msup><mrow></mrow><mo>′</mo></msup><mo rspace="0em">∈</mo><mo lspace="0em">∪</mo><msub><mrow></mrow><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></msub><mi>K</mi><msub><mrow></mrow><mi>η</mi></msub></mrow></msub><mrow><mo>‖</mo><mi>y</mi><mo>−</mo><msup><mi>y</mi><mo>′</mo></msup><mo>‖</mo></mrow></mrow><annotation encoding="application/x-tex">D_{0}=\sup_{y,y^{\prime}\in\cup_{\eta\in\mathcal{I}}K_{\eta}}\left\|y-y^{\prime}\right\|</annotation></semantics></math> and <math id="A2.SS6.p1.m4" class="ltx_Math" alttext="\widetilde{\sigma}_{T-t}^{2}=\lambda_{T-t}^{-2}\sigma_{T-t}^{2}" display="inline" intent=":literal"><semantics><mrow><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup><mo>=</mo><mrow><msubsup><mi>λ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mrow><mo>−</mo><mn>2</mn></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><mi>t</mi></mrow><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\widetilde{\sigma}_{T-t}^{2}=\lambda_{T-t}^{-2}\sigma_{T-t}^{2}</annotation></semantics></math>.
We choose <math id="A2.SS6.p1.m5" class="ltx_Math" alttext="\varepsilon_{\delta}&lt;d_{0}/3" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>&lt;</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\delta}&lt;d_{0}/3</annotation></semantics></math>.
Note that over <math id="A2.SS6.p1.m6" class="ltx_Math" alttext="[t_{k},t_{k+1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><msub><mi>t</mi><mi>k</mi></msub><mo>,</mo><msub><mi>t</mi><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">[t_{k},t_{k+1})</annotation></semantics></math>, by <a href="#A2.E45" title="In B.4 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">45</span></a> we have</p>
<table id="A2.EGx88" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex81.m1" class="ltx_Math" alttext="\displaystyle\Big|\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex82.m1" class="ltx_Math" alttext="\displaystyle=\left|e^{t-t_{k}}\left\langle\frac{\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})}{\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|},\,\widehat{z}_{t_{k}}+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})-\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\in\mathcal{I}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\rangle\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo>⟨</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mfrac></mstyle><mo rspace="0.337em">,</mo><mrow><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>−</mo><mn>1</mn></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>F</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow></mrow><mo>⟩</mo></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|e^{t-t_{k}}\left\langle\frac{\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})}{\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|},\,\widehat{z}_{t_{k}}+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})-\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\in\mathcal{I}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\rangle\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex83.m1" class="ltx_Math" alttext="\displaystyle\leq e^{t-t_{k}}\Big(\left\|\widehat{z}_{t_{k}}\right\|+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}\left\|F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|+\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\left\|F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\|\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mo>‖</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>‖</mo></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>F</mi><mrow><msub><mi>η</mi><mn>0</mn></msub><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>−</mo><mn>1</mn></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mi>F</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{t-t_{k}}\Big(\left\|\widehat{z}_{t_{k}}\right\|+\frac{\gamma}{\sigma_{T-t_{k}}^{2}}\left\|F_{\eta_{0},T-t_{k}}(\widehat{z}_{t_{k}})\right\|+\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\left\|F_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\right\|\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex84.m1" class="ltx_Math" alttext="\displaystyle\leq e^{t-t_{k}}\Big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}+\frac{\gamma\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle></mrow><mo fence="true" lspace="0em">CLOSE</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{t-t_{k}}\Big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+R_{0}+\frac{\gamma\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\qquad\qquad+\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+D_{0}\big)\Big)," display="inline" intent=":literal"><semantics><mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>−</mo><mn>1</mn></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></munder></mstyle><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mi>𝖽𝗂𝗌𝗍</mi><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow><mo>+</mo><msub><mi>D</mi><mn>0</mn></msub><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\qquad\qquad+\frac{\gamma-1}{\sigma_{T-t_{k}}^{2}}\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\big(\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})+D_{0}\big)\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p1.2" class="ltx_p">where the last inequality follows from triangle inequality and <a href="#A2.E53" title="In Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">53</span></a>. By assumption we know that <math id="A2.SS6.p1.m7" class="ltx_Math" alttext="\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\leq\varepsilon_{\delta}&lt;d_{0}/3" display="inline" intent=":literal"><semantics><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><msub><mi>ε</mi><mi>δ</mi></msub><mo>&lt;</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\leq\varepsilon_{\delta}&lt;d_{0}/3</annotation></semantics></math>.
In addition, similar to the derivation of <a href="#A2.E52" title="In Case I: 𝖽𝗂𝗌𝗍(𝑧̂_𝑡_𝑘,𝐾_𝜂_0)∈[𝜀,𝑑_0/3) ‣ B.5 Proof of Lemma ‣ Appendix B Proofs for guided DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">Eq.</span> <span class="ltx_text ltx_ref_tag">52</span></a> we know that</p>
<table id="A2.EGx89" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex86.m1" class="ltx_Math" alttext="\displaystyle\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\cdot\exp\left(-\frac{d_{0}^{2}}{24\widetilde{\sigma}_{T-t_{k}}^{2}}\right)." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mrow><mi>η</mi><mo>≠</mo><msub><mi>η</mi><mn>0</mn></msub></mrow></munder></mstyle><mrow><msub><mi>ζ</mi><mrow><mi>η</mi><mo>,</mo><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo>|</mo></mrow><mrow><mrow><mrow><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msubsup><mi>d</mi><mn>0</mn><mn>2</mn></msubsup><mrow><mn>24</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mrow></mfrac></mstyle></mrow><mo>)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sum_{\eta\neq\eta_{0}}\zeta_{\eta,T-t_{k}}(\widehat{z}_{t_{k}})\leq\frac{\left|\mathcal{I}\right|}{w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\cdot\exp\left(-\frac{d_{0}^{2}}{24\widetilde{\sigma}_{T-t_{k}}^{2}}\right).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p1.3" class="ltx_p">Leveraging these upper bounds, we further conclude that</p>
<table id="A2.EGx90" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex87.m1" class="ltx_Math" alttext="\displaystyle\Big|\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|" display="inline" intent=":literal"><semantics><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\Big|\frac{\mathrm{d}}{\mathrm{d}t}\left\|\widehat{z}_{t}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex88.m1" class="ltx_Math" alttext="\displaystyle\leq e^{t-t_{k}}\Big(\varepsilon_{\delta}+R_{0}+\frac{\gamma\big(\varepsilon_{\delta}+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}+\frac{(\gamma-1)\left|\mathcal{I}\right|(\varepsilon_{\delta}+D_{0})e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t_{k}}^{2})}}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mi>e</mi><mrow><mi>t</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>+</mo><msub><mi>R</mi><mn>0</mn></msub><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>γ</mi><mo>⁡</mo><mrow><mo maxsize="1.200em" minsize="1.200em">(</mo><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>+</mo><mrow><msub><mi>C</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo lspace="0em" rspace="0em">​</mo><msub><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msubsup><mover accent="true"><mi>σ</mi><mo>~</mo></mover><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mrow><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mrow></mrow><mo maxsize="1.200em" minsize="1.200em">)</mo></mrow></mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mo stretchy="false">(</mo><mi>γ</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo fence="false" rspace="0.167em">|</mo><mi class="ltx_font_mathcaligraphic">ℐ</mi><mo fence="false" rspace="0.167em">|</mo><mo stretchy="false">(</mo><mi>ε</mi><msub><mrow></mrow><mi>δ</mi></msub><mo>+</mo><mi>D</mi><msub><mrow></mrow><mn>0</mn></msub><mo stretchy="false">)</mo><mi>e</mi><msup><mrow></mrow><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><msup><mrow></mrow><mn>2</mn></msup><mo>/</mo><mo stretchy="false">(</mo><mn>24</mn><mover accent="true"><mi>σ</mi><mo>~</mo></mover><msub><mrow></mrow><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow></msub><msup><mrow></mrow><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></msup></mrow><mrow><mrow><mrow><msubsup><mi>σ</mi><mrow><mi>T</mi><mo>−</mo><msub><mi>t</mi><mi>k</mi></msub></mrow><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>w</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mo rspace="0.167em">inf</mo><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow></msub><mrow><msub><mi>p</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo rspace="0.222em">⋅</mo><msub><mi>ρ</mi><msub><mi>η</mi><mn>0</mn></msub></msub></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>6</mn></mrow><mo stretchy="false">)</mo></mrow><mi>d</mi></msup></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq e^{t-t_{k}}\Big(\varepsilon_{\delta}+R_{0}+\frac{\gamma\big(\varepsilon_{\delta}+C_{K_{\eta_{0}}}\widetilde{\sigma}_{T-t_{k}}\log\widetilde{\sigma}_{T-t_{k}}^{-1}\big)}{\sigma_{T-t_{k}}^{2}}+\frac{(\gamma-1)\left|\mathcal{I}\right|(\varepsilon_{\delta}+D_{0})e^{-{d_{0}^{2}}/(24\widetilde{\sigma}_{T-t_{k}}^{2})}}{\sigma_{T-t_{k}}^{2}w_{\eta_{0}}\inf_{x\in\mathbb{R}^{d}}p_{\eta_{0}}(x)\cdot\rho_{\eta_{0}}(d_{0}/6)^{d}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS6.p1.4" class="ltx_p">Under Assumption <a href="#S3.Thmass2" title="Assumption 3.2. ‣ 3.1 Summary of main results ‣ 3 Results for DDIM ‣ On the Robustness of Distribution Support under Diffusion Guidance" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.2</span></a>, we conclude that for any <math id="A2.SS6.p1.m8" class="ltx_Math" alttext="\kappa_{0}\in(0,1)" display="inline" intent=":literal"><semantics><mrow><msub><mi>κ</mi><mn>0</mn></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\kappa_{0}\in(0,1)</annotation></semantics></math>, there exist <math id="A2.SS6.p1.m9" class="ltx_Math" alttext="\overline{\tau}_{\delta}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mi>δ</mi></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\overline{\tau}_{\delta}&gt;0</annotation></semantics></math> and <math id="A2.SS6.p1.m10" class="ltx_Math" alttext="\varepsilon_{\delta}\in(0,\delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>ε</mi><mi>δ</mi></msub><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon_{\delta}\in(0,\delta)</annotation></semantics></math> that depend only on <math id="A2.SS6.p1.m11" class="ltx_Math" alttext="(\delta,p_{0},\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\delta,p_{0},\gamma)</annotation></semantics></math>, such that whenever <math id="A2.SS6.p1.m12" class="ltx_Math" alttext="t_{k}\in[\overline{\tau}_{\delta},T)" display="inline" intent=":literal"><semantics><mrow><msub><mi>t</mi><mi>k</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mover accent="true"><mi>τ</mi><mo stretchy="true">¯</mo></mover><mi>δ</mi></msub><mo>,</mo><mi>T</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">t_{k}\in[\overline{\tau}_{\delta},T)</annotation></semantics></math>,</p>
<table id="A2.EGx91" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
