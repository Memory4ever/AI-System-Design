<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex89.m1" class="ltx_Math" alttext="\displaystyle\mathsf{dist}(\widehat{z}_{t},K_{\eta_{0}})-\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\leq\int_{t_{k}}^{t}\Big|\frac{\mathrm{d}}{\mathrm{d}s}\left\|\widehat{z}_{s}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|\mathrm{d}s" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>t</mi></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>𝖽𝗂𝗌𝗍</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo>,</mo><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><msub><mi>t</mi><mi>k</mi></msub><mi>t</mi></msubsup></mstyle><mrow><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo><mrow><mstyle displaystyle="true"><mfrac><mi>d</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>s</mi></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><mi>s</mi></msub><mo>−</mo><mrow><msub><mi>𝖯𝗋𝗈𝗃</mi><msub><mi>K</mi><msub><mi>η</mi><mn>0</mn></msub></msub></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>z</mi><mo>^</mo></mover><msub><mi>t</mi><mi>k</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">|</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>s</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathsf{dist}(\widehat{z}_{t},K_{\eta_{0}})-\mathsf{dist}(\widehat{z}_{t_{k}},K_{\eta_{0}})\leq\int_{t_{k}}^{t}\Big|\frac{\mathrm{d}}{\mathrm{d}s}\left\|\widehat{z}_{s}-\Proj_{K_{\eta_{0}}}(\widehat{z}_{t_{k}})\right\|\Big|\mathrm{d}s</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
