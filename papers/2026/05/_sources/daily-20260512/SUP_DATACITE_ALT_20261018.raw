{"data":[{"id":"10.48550/arxiv.2605.07956","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07956","identifiers":[{"identifier":"2605.07956","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Javier","familyName":"Carvajal-Rojas","name":"Carvajal-Rojas, Javier","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Axel","familyName":"Stäbler","name":"Stäbler, Axel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Adjoint test modules along Cohen--Macaulay morphisms"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Algebraic Geometry (math.AG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Commutative Algebra (math.AC)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Mathematics","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"13A35, 14B05, 14G17","lang":"en","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-05-08T16:20:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:12:49Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-15T06:11:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-16T00:42:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We provide a transformation rule for adjoint test modules along Cohen--Macaulay maps between Cohen--Macaulay varieties that have $F$-rational geometric fibers. This is, in part, an effective version of Enescu's theorem on the ascent of $F$-rationality under local maps with $F$-rational geometric fibers."},{"descriptionType":"Other","description":"8 pages, comments are still welcome; v2: Weakened assumptions from a finite type base over an $F$-finite field to just $F$-finite thanks to recent work of Bhatt et al (2604.20005)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07956","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:32:17Z","registered":"2026-05-11T02:32:18Z","published":null,"updated":"2026-10-16T03:19:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07711","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07711","identifiers":[{"identifier":"2605.07711","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jie","familyName":"Sun","name":"Sun, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mao","familyName":"Zheng","name":"Zheng, Mao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mingyang","familyName":"Song","name":"Song, Mingyang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Qiyong","familyName":"Zhong","name":"Zhong, Qiyong","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yilin","familyName":"Cheng","name":"Cheng, Yilin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Bichuan","familyName":"Feng","name":"Feng, Bichuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Liu","name":"Liu, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Junfeng","familyName":"Fang","name":"Fang, Junfeng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiang","familyName":"Wang","name":"Wang, Xiang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SimCT: Recovering Lost Supervision for Cross-Tokenizer On-Policy Distillation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computation and Language (cs.CL)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T13:16:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:59:40Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-21T08:28:27Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-22T00:40:03Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-15T08:39:01Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-16T00:53:04Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"On-policy distillation (OPD) is a standard tool for transferring teacher behavior to a smaller student, but it implicitly assumes that teacher and student predictions are comparable token by token, an assumption that fails whenever the two models tokenize the same text differently. Under heterogeneous tokenizers, exact shared-token matching silently discards a large fraction of the teacher signal at precisely the positions where vocabularies disagree. We propose \\textbf{\\underline{Sim}ple \\underline{C}ross-\\underline{T}okenizer OPD (SimCT)}, which restores this signal by enlarging the supervision space: alongside shared tokens, SimCT compares teacher and student over short multi-token continuations that both tokenizers can realize, leaving the OPD loss form itself unchanged. We show that these units are the finest jointly tokenizable supervision interface, and that coarser alternatives remove teacher-student distinctions that are useful for on-policy learning. Across three heterogeneous teacher-student pairs on mathematical reasoning and code-generation benchmarks, SimCT shows consistent gains over shared-vocabulary OPD and representative cross-tokenizer baselines, with ablations confirming that the improvements come from recovering supervision discarded by exact shared-token matching. Code is available at \\href{https://github.com/sunjie279/SimCT-}{https://github.com/sunjie279/SimCT-}."},{"descriptionType":"Other","description":"Accepted by NeurIPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07711","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:26:39Z","registered":"2026-05-11T02:26:39Z","published":null,"updated":"2026-10-16T03:19:18Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07496","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07496","identifiers":[{"identifier":"2605.07496","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Yijin","familyName":"Wang","name":"Wang, Yijin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuru","familyName":"Tian","name":"Tian, Yuru","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xijie","familyName":"Huang","name":"Huang, Xijie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Weiqi","familyName":"Gai","name":"Gai, Weiqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Mo","familyName":"Zhu","name":"Zhu, Mo","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xin","familyName":"Zhou","name":"Zhou, Xin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yuze","familyName":"Wu","name":"Wu, Yuze","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Fei","familyName":"Gao","name":"Gao, Fei","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"PathPainter: Transferring the Generalization Ability of Image Generation Models to Embodied Navigation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Robotics (cs.RO)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T09:33:19Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:48:30Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-05T09:58:48Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-08T00:37:53Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-15T01:11:22Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-16T00:27:12Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Bird's-eye-view (BEV) images have been demonstrated to provide valuable prior information for navigation. Given the global information provided by such views, two key challenges remain: how to fully exploit this information and how to reliably use it during execution. In this paper, we propose a navigation system that uses BEV images as global priors and is designed for ground and near-ground robotic platforms. The system employs an image generation model to interpret human intent from natural language, identify the target destination, and generate traversability masks. During execution, we introduce cross-view localization to align the robot's odometry with the BEV map and mitigate long-term drift in conventional odometry. We conduct extensive benchmark experiments to evaluate the proposed method and further validate its effectiveness on both UAV and quadruped robot platforms. Using only a conventional local motion planner, the quadruped robot successfully completes a 285-meter outdoor long-range navigation task. This work demonstrates how the world-understanding capabilities of foundation models can be transferred to embodied navigation, enabling robots to benefit from the strong generalization ability of existing image generation models."},{"descriptionType":"Other","description":"17 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07496","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:21:21Z","registered":"2026-05-11T02:21:21Z","published":null,"updated":"2026-10-16T03:19:17Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07332","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07332","identifiers":[{"identifier":"2605.07332","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Basanta","familyName":"Mistri","name":"Mistri, Basanta","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vishal","familyName":"Ranjan","name":"Ranjan, Vishal","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siddharth","familyName":"Dhomkar","name":"Dhomkar, Siddharth","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Clock-transition-enabled long electron spin coherence of telecom emitters in CeO$_2$"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Quantum Physics (quant-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T06:36:32Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:39:25Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-11T16:05:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T01:34:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-15T05:31:05Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-16T00:41:15Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Rare-earth-ion-doped crystals has emerged as a promising platform for quantum technologies, owing to their narrow telecom-band optical emission, long spin memory, and compatibility with silicon integrated photonic architectures. However, the realization of scalable quantum devices requires host materials with intrinsically dilute spin environments to suppress decoherence. In this context, erbium (Er$^{3+}$) doped cerium oxide (CeO$_2$) is an attractive candidate due to the ultra-low concentration of nuclear spins in the host matrix and its compatibility with silicon-based technologies. Here we perform a comprehensive investigation of the coherence properties of Er$^{3+}$ electron spin qubit in CeO$_2$ via semiclassical as well as detailed cluster correlation expansion simulations. By systematically exploring magnetic field strength, pulse sequences, erbium concentration, and spin temperature, we identify regimes where decoherence from the spin bath is strongly suppressed. Our investigations illustrate that at dilute doping concentration (of the order of 10 ppb) and sub-Kelvin temperatures, operation near clock transitions enables Hahn-echo coherence times to approach the second timescale even at natural isotopic abundance. Importantly, from a practical standpoint, coherence times on the order of $\\sim 10$ ms are expected even at liquid helium temperature (about 2 K) for similar concentrations. Moreover, we demonstrate that an additional enhancement can be obtained with conventional multi-$π$-pulse dynamical decoupling protocols. Thus, our findings establish Er$^{3+}$ doped CeO$_2$ as a front-runner for realizing spin qubits, quantum memories, and integrated quantum networks."},{"descriptionType":"Other","description":"12 pages, 8 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07332","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:17:29Z","registered":"2026-05-11T02:17:29Z","published":null,"updated":"2026-10-16T03:19:16Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.06898","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.06898","identifiers":[{"identifier":"2605.06898","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Luke J.","familyName":"O'Connor","name":"O'Connor, Luke J.","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Self-Programmed Execution for Language-Model Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-07T19:58:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:11:09Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-15T15:37:58Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-16T01:27:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"At the heart of a language model agent is an orchestrator program which is responsible for the state transition between consecutive turns. In existing systems, this program is implemented in the harness. This paper introduces self-programmed execution (SPE), in which the model completion is itself the orchestrator program, and the harness evaluates this program but does not impose any fixed orchestration policy. Formally, an SPE state of an agentic machine is one from which a model completion can load any successor state up to an embedding, and an instance of an SPE state is one which executes the model completion as a program. In practice, the program requires a language with unusual features, as its source code doubles as the content of the model's context window. I therefore introduce Spell, a Lisp dialect in which programs can edit and re-evaluate themselves, and effectful expressions like model invocations are structured such that re-evaluating an edited program does not replay its side effects. Experiments with existing models, not trained for SPE or Spell, show that frontier models can learn Spell in-context and accomplish challenging agentic tasks. These results demonstrate how a LM can act as an agent without any fixed orchestration policy, and they raise the question of what self-orchestration strategies might be learned by a model trained for self-programmed execution. Code is available at https://github.com/lukejoconnor/spell."},{"descriptionType":"Other","description":"Camera-ready version; accepted at NeurIPS 2026. 77 pages, including appendices and checklist"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.06898","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:07:13Z","registered":"2026-05-11T02:07:13Z","published":null,"updated":"2026-10-16T03:19:15Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07618","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07618","identifiers":[{"identifier":"2605.07618","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Qing","familyName":"Yu","name":"Yu, Qing","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hua","familyName":"Zhou","name":"Zhou, Hua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xing-Gang","familyName":"Wu","name":"Wu, Xing-Gang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"New Determinations of the Charm and Bottom Quark Masses Using QCD Quarkonium Sum Rules"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"High Energy Physics - Phenomenology (hep-ph)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T11:45:52Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:54:52Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T09:10:28Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T00:58:15Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We reanalyze the perturbative QCD (pQCD) corrections to quarkonium QCD sum rules and extract the heavy quark masses $\\overline{m}_{q}(\\overline{m}_{q})$ ($q=c,b$). At present, the pQCD corrections to the correlation functions of two heavy-quark pseudoscalar and vector currents at zero momentum transfer, denoted as $M_{n,q}^{X,\\rm th}$ ($X = P, V$), are calculated up to the $\\mathcal{O}(α_s^3)$ order. These corrections exhibit significant renormalization scheme and scale dependence, which introduces large theoretical uncertainties and deteriorates the precision of heavy quark mass determinations. In this work, we eliminate the renormalization scheme and scale ambiguities in the perturbative part of $M_{n,q}^{X,\\rm th}$ by adopting the Principle of Maximum Conformality (PMC) within the characteristic operator (CO) approach. The CO approach, a novel extension of the standard PMC procedure, simultaneously determines the effective coupling $α_s(Q_*)$ and the effective quark mass $\\overline{m}_q(Q_*)$. It systematically absorbs the nonconformal $\\{β_i\\}$-terms and $\\{γ_i\\}$-terms via the renormalization group equations, yielding a strictly scheme- and scale-independent conformal perturbative series. Based on the improved PMC conformal series, we further provide reliable estimates for the unknown $\\mathrm{N^4LO}$ contributions using the Padé approximation method. {The final predicted heavy quark masses in the $\\overline{\\mathrm{MS}}$ scheme read: $\\overline{m}_c(\\overline{m}_c)=1278.8\\pm 3.9~\\text{MeV}$, extracted from the second moment of the charmed pseudoscalar correlator $M_{2,c}^{P}$; and $\\overline{m}_b(\\overline{m}_b) = 4161.0\\pm 9.0~\\text{MeV}$, extracted from the second moment of the bottom vector correlator $M_{2,b}^{V}$. Both results agree well with the PDG world averages with deviations smaller than $2σ$."},{"descriptionType":"Other","description":"34 pages, 15 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07618","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:24:23Z","registered":"2026-05-11T02:24:23Z","published":null,"updated":"2026-10-15T03:13:56Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07118","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07118","identifiers":[{"identifier":"2605.07118","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Shuhei","familyName":"Kanda","name":"Kanda, Shuhei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Satoru","familyName":"Hayami","name":"Hayami, Satoru","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Revisiting magnetoelectric response in collinear antiferromagnetic zigzag chains: A downfolding approach beyond conventional low-energy models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Strongly Correlated Electrons (cond-mat.str-el)","lang":"en","subjectScheme":"arXiv"},{"subject":"Materials Science (cond-mat.mtrl-sci)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Physical sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T01:50:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-10-14T02:07:10Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T07:09:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T00:49:17Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1103/m96k-8ndj","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Magnetoelectric (ME) effects in antiferromagnets provide a fertile platform for exploring symmetry-driven cross-correlated responses. However, their microscopic origin remains elusive and is often obscured in simplified low-energy descriptions. In this study, we revisit the microscopic mechanism of the ME effect in a collinear antiferromagnetic zigzag chain by employing a multi-orbital tight-binding model that explicitly includes both $s$- and $p$-orbital degrees of freedom. Using analytical and numerical calculations based on the Kubo formula, we demonstrate that the ME response is governed by orbital degrees of freedom activated through $s$--$p$ hybridization, while the spin contribution vanishes due to spin conservation. To elucidate the low-energy description, we derive an effective Hamiltonian projected onto the $s$-orbital subspace using the Schur complement. We show that a naive application of the Kubo formula within this effective model fails to capture the ME response. This issue is resolved by systematically incorporating vertex corrections in terms of orbital hybridization into the response functions. Furthermore, by introducing a quasiparticle renormalization scheme, we formulate a renormalized Kubo formula that preserves conservation laws and accurately reproduces the full multi-orbital results. Our analysis revisits the conventional low-energy perspective and reveals that the ME effect originates from virtual interorbital processes encoded in vertex corrections, rather than from the bare low-energy Hamiltonian. The effective framework developed here provides a unified microscopic understanding of orbital-driven ME responses and offers a systematic route to incorporate hybridization effects beyond simple low-energy models."},{"descriptionType":"Other","description":"16 pages, 7 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07118","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-05-11T02:12:24Z","registered":"2026-05-11T02:12:25Z","published":null,"updated":"2026-10-15T03:13:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07191","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07191","identifiers":[{"identifier":"2605.07191","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Huaiyuan","familyName":"Qin","name":"Qin, Huaiyuan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Muli","familyName":"Yang","name":"Yang, Muli","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel James","familyName":"Goenawan","name":"Goenawan, Gabriel James","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Peng","familyName":"Hu","name":"Hu, Peng","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Chen","familyName":"Gong","name":"Gong, Chen","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xi","familyName":"Peng","name":"Peng, Xi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Hongyuan","familyName":"Zhu","name":"Zhu, Hongyuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Attention Transfer Is Not Universally Effective for Vision Transformers"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T03:39:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:31:59Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T13:35:30Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T01:17:24Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"A recent work shows that Attention Transfer, which transfers only the attention patterns from a pre-trained teacher Vision Transformer (ViT) to a randomly initialized standard student ViT, is sufficient to recover the full benefit of the teacher's pre-trained weights. We revisit this finding on a comprehensive benchmark of 20 teachers from 11 well-known ViT families and reveal that Attention Transfer is not universally effective. While 7 families transfer successfully, 4 consistently fail, falling up to 5.1\\% below the from-scratch no-transfer baseline. Further results demonstrate that this failure is family-consistent across model sizes, and persists under extended training durations, different transfer datasets, and out-of-distribution evaluations. Controlled analyses then consistently localize the problem to the attention-routing channel, indicating that the key issue is not whether the student can match the teacher's attention patterns, but whether the matched patterns remain functional for the student. Crucially, we identify architectural mismatch between the pre-trained teacher and the standard student as the primary mechanism. By adding only the teacher's native architectural components to the student in a randomly initialized state, we completely reverse the failure for all 4 families. Notably, these components alone do not improve from-scratch training, confirming that they specifically unlock the usability of the teacher's attention. We further show that this failure is not explained by the inadequate choice of transfer loss, differences in pre-training recipes, or the intrinsic quality of attention maps. Our findings refine the prevailing understanding of attention in ViT representations: attention is sufficient \\textit{only} when the student architecture matches the teacher."},{"descriptionType":"Other","description":"Published in NeurIPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07191","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:14:10Z","registered":"2026-05-11T02:14:10Z","published":null,"updated":"2026-10-15T03:13:55Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07057","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07057","identifiers":[{"identifier":"2605.07057","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Jiamin","familyName":"Xu","name":"Xu, Jiamin","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jacqueline","familyName":"Maasch","name":"Maasch, Jacqueline","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Kyra","familyName":"Gan","name":"Gan, Kyra","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"From Causal Graphs to Markovian States: Multi-Order State Exposure for Deep RL"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T00:12:03Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:23:20Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T17:48:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T01:35:37Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"Online reinforcement learning (RL) relies on the Markov property for guaranteed performance, but real-world applications often lack well-defined states given raw observed variables. While causal RL has attracted growing interest, existing work typically assumes Markovian states are provided and uses causality only to accelerate learning. This leaves a fundamental gap: \\emph{given a longitudinal causal graph over observed variables, how does one construct MDP states that provably satisfy the Markov property?} We provide a procedure that constructs a provably minimal such state. In deep RL, the minimal representation alone empirically fails to improve performance, indicating that neural networks cannot automatically exploit Markovian minimality. We therefore propose \\textbf{MOSE} (Multi-Order State Exposure), which exposes a single shared Q-function to history-based state constructions of orders 1 through $W$ simultaneously. An attention-based selection layer scores the dimensions of this combined input by their estimated relevance to value-function estimation and selects the high-scoring ones. Causal MOSE further constrains the selection layer to retain every variable of the minimal state, guaranteeing sufficiency while leaving the model free to admit useful redundancy. MOSE consistently outperforms both the minimal state construction and single-window policies on common benchmarks and synthetic datasets. Including the minimal representation alongside MOSE can further improve performance. Our results establish a core principle for causal deep RL: minimal sufficiency is not enough. \\emph{Controlled redundancy} gives the model flexibility to learn its state representation end-to-end. Causal state information provides structural guidance that can make this learning more efficient."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07057","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:10:56Z","registered":"2026-05-11T02:10:57Z","published":null,"updated":"2026-10-15T03:13:54Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.06812","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.06812","identifiers":[{"identifier":"2605.06812","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chaofan","familyName":"Li","name":"Li, Chaofan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Lyuye","familyName":"Zhang","name":"Zhang, Lyuye","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jintao","familyName":"Zhai","name":"Zhai, Jintao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Siyue","familyName":"Feng","name":"Feng, Siyue","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xichun","familyName":"Yang","name":"Yang, Xichun","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Huahao","familyName":"Wang","name":"Wang, Huahao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Shihan","familyName":"Dou","name":"Dou, Shihan","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yu","familyName":"Ji","name":"Ji, Yu","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yutao","familyName":"Hu","name":"Hu, Yutao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueming","familyName":"Wu","name":"Wu, Yueming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yang","familyName":"Liu","name":"Liu, Yang","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Deqing","familyName":"Zou","name":"Zou, Deqing","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Towards Security-Auditable LLM Agents: A Unified Graph Representation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-07T18:14:29Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:05:01Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T08:40:11Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T00:56:07Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"LLM-based agentic systems are rapidly evolving to perform complex autonomous tasks through dynamic tool invocation, stateful memory management, and multi-agent collaboration. However, this semantics-driven execution paradigm creates a severe semantic gap between low-level physical events and high-level execution intent, making post-hoc security auditing fundamentally difficult. Existing representation mechanisms, including static SBOMs and runtime logs, provide only fragmented evidence and fail to capture cognitive-state evolution, capability bindings, persistent memory contamination, and cascading risk propagation across interacting agents. To bridge this gap, we propose Agent-BOM, a unified structural representation for agent security auditing. Agent-BOM models an agentic system as a hierarchical attributed directed graph that separates static capability bases, such as models, tools, and long-term memory, from dynamic runtime semantic states, such as goals, reasoning trajectories, and actions. These layers are connected through semantic edges and security attributes, transforming fragmented execution traces into queryable audit paths. Building on Agent-BOM, we develop a graph-query-based paradigm for path-level risk assessment and instantiate it with the OWASP Agentic Top 10. We further implement an auditing plugin in the OpenClaw environment to construct Agent-BOM from live executions. Evaluation on representative real-world agentic attack scenarios shows that Agent-BOM can reconstruct stealthy attack chains, including cross-session memory poisoning and tool misuse, capability supply-chain hijacking and unexpected code execution, multi-agent ecosystem hijacking, and privilege and trust abuse. These results demonstrate that Agent-BOM provides a unified and auditable foundation for root-cause analysis and security adjudication in complex agentic ecosystems."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.06812","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:05:09Z","registered":"2026-05-11T02:05:10Z","published":null,"updated":"2026-10-15T03:13:53Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.06727","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.06727","identifiers":[{"identifier":"2605.06727","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Nuno","familyName":"Batista","name":"Batista, Nuno","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Ana","familyName":"Morgado","name":"Morgado, Ana","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Oscar","familyName":"Ferraz","name":"Ferraz, Oscar","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Sagar Silva","familyName":"Pratapsi","name":"Pratapsi, Sagar Silva","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jorge","familyName":"Lobo","name":"Lobo, Jorge","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Gabriel","familyName":"Falcao","name":"Falcao, Gabriel","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Medical Imaging Classification with Cold-Atom Reservoir Computing using Auto-Encoders and Surrogate-Driven Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"Emerging Technologies (cs.ET)","lang":"en","subjectScheme":"arXiv"},{"subject":"Image and Video Processing (eess.IV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-07T11:26:09Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:01:53Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-14T15:02:17Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-15T01:24:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1109/qai63978.2025.00064","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We introduce a hybrid quantum-classical pipeline, based on neutral-atom reservoir computing, for medical image classification, focusing on the binary classification task of polyp detection. To deal effectively with the high dimensionality, we integrate a guided auto-encoder. This pipeline learns compact and discriminative representations of image data that are also well-suited for quantum reservoir computing. A key challenge in such systems is the non-differentiable nature of quantum measurements, which creates a 'gradient barrier' for standard training. We overcome this barrier by incorporating a differentiable surrogate model that emulates the quantum layer, enabling end-to-end backpropagation through the entire system. This guided training process is jointly optimized for classification accuracy and for faithful image recovery from the auto-encoder. The learned latent representations are encoded as pulse detuning parameters within a Rydberg Hamiltonian, and quantum embeddings are subsequently obtained through expectation values. These embeddings are then passed to a linear classifier. Our simulations show that this method outperforms some traditional approaches that use PCA or unguided autoencoders. We also conduct ablation studies to assess the impact of various quantum and training parameters, demonstrating the robustness and flexibility of our proposed pipeline for real-world medical imaging applications, even in the current NISQ era."},{"descriptionType":"Other","description":"8 pages, 6 figures. Accepted to the 2025 IEEE International Conference on Quantum AI (IEEE QAI). Supported by FCT and the Open Quantum Institute (OQI). v2: corrects the stated Rabi frequency to $\\Omega = 2\\pi$ rad/$\\mu$s"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.06727","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-05-11T02:03:06Z","registered":"2026-05-11T02:03:06Z","published":null,"updated":"2026-10-15T03:13:52Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07950","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07950","identifiers":[{"identifier":"2605.07950","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Atsushi","familyName":"Nitanda","name":"Nitanda, Atsushi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Dake","familyName":"Bu","name":"Bu, Dake","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Yueming","familyName":"Lyu","name":"Lyu, Yueming","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Tanya","familyName":"Veeravalli","name":"Veeravalli, Tanya","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Slowly Annealed Langevin Dynamics: Theory and Applications to Training-Free Guided Generation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Machine Learning (cs.LG)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T16:17:34Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:12:35Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-11T02:09:19Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T01:10:21Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"We study Slowly Annealed Langevin Dynamics (SALD), a sampler for tracking a path of moving target distributions and approximating the terminal target through time slowdown. We establish non-asymptotic convergence guarantees via a KL differential inequality, showing that slowdown improves tracking through contraction of intermediate targets and the complexity of the path. Motivated by training-free guided generation with pretrained score-based generative models, we further introduce Velocity-Aware SALD (VA-SALD), which explicitly incorporates the underlying marginal distributions of the pretrained model and uses slowdown to correct the additional deviation induced by guidance. This yields a principled framework for training-free guided generation for diffusion-based and related generative model families, together with convergence guarantees that clarify the roles of intermediate functional inequalities and guidance bias. Code is available at https://github.com/anitan0925/sald."},{"descriptionType":"Other","description":"Accepted at NeurIPS 2026"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07950","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:32:09Z","registered":"2026-05-11T02:32:10Z","published":null,"updated":"2026-10-14T08:33:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.08003","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.08003","identifiers":[{"identifier":"2605.08003","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Chao","familyName":"Huang","name":"Huang, Chao","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Pengfei","familyName":"Wei","name":"Wei, Pengfei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wei","familyName":"Wang","name":"Wang, Wei","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jie","familyName":"Wen","name":"Wen, Jie","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Zhihua","familyName":"Wang","name":"Wang, Zhihua","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Li","familyName":"Shen","name":"Shen, Li","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Wenqi","familyName":"Ren","name":"Ren, Wenqi","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Xiaochun","familyName":"Cao","name":"Cao, Xiaochun","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SphereVAD: Training-Free Video Anomaly Detection via Geodesic Inference on the Unit Hypersphere"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T16:57:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:15:02Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-11T10:58:13Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T01:24:08Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/","rights":"arXiv.org perpetual, non-exclusive license"}],"descriptions":[{"descriptionType":"Abstract","description":"Video anomaly detection (VAD) aims to automatically identify events that deviate from normal patterns in untrimmed surveillance videos. Existing methods universally depend on large-scale annotations or task-specific training procedures, severely limiting their rapid deployment to novel scenes. We observe that intermediate-layer features of pre-trained multimodal large language models (MLLMs) already encode rich anomaly semantics, yet existing approaches rely on the language output pathway and fail to exploit the geometric discriminability latent in these representations. Based on this finding, we propose SphereVAD, a fully training-free, zero-shot VAD framework that recasts anomaly discrimination as von Mises-Fisher (vMF) likelihood-ratio geodesic inference on the unit hypersphere, unleashing latent discriminability through principled geometric reasoning rather than learning new representations. Specifically, SphereVAD first applies Frechet mean centering to unfold feature distributions and eliminate domain biases, then employs Holistic Scene Attention (HSA) to reinforce feature consistency using cross-video priors, and finally performs vMF-guided Spherical Geodesic Pulling (SGP) to align ambiguous segments with directional prototypes on the spherical manifold. This training-free pipeline requires only minimal synthetic images for calibration. SphereVAD establishes new state-of-the-art results among training-free approaches on three major benchmarks and remains competitive with fully supervised baselines. Code will be available upon acceptance."},{"descriptionType":"Other","description":"48 pages, 25 figures"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.08003","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:33:21Z","registered":"2026-05-11T02:33:22Z","published":null,"updated":"2026-10-14T08:33:02Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07936","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07936","identifiers":[{"identifier":"2605.07936","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Arthur","familyName":"Fyon","name":"Fyon, Arthur","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Loris","familyName":"Mendolia","name":"Mendolia, Loris","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Jean-Michel","familyName":"Redouté","name":"Redouté, Jean-Michel","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Alessio","familyName":"Franci","name":"Franci, Alessio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Guillaume","familyName":"Drion","name":"Drion, Guillaume","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Fully Tunable Ultra-Low Power Current-Mode Memory Cell in Standard CMOS Technology"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Signal Processing (eess.SP)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T16:05:46Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:11:37Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-18T10:52:05Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T03:19:00Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[{"relationType":"IsVersionOf","relatedIdentifier":"10.1088/2631-8695/aeb35c","relatedIdentifierType":"DOI"}],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsIdentifier":"cc-by-nc-sa-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"This work introduces a fully tunable, ultra-low power unipolar memory cell inspired by the Schmitt-trigger comparator and designed in CMOS using only nine transistors. The proposed circuit operates entirely in the current domain and exploits a novel feedback configuration between two interdependent Heaviside-like thresholding elements to produce tunable bistable switching behavior. Its three key parameters-threshold current, hysteresis width, and output gain-are independently tunable via programmable bias currents, enabling flexibility across diverse analog computing applications. Unlike prior Schmitt-trigger designs, it simultaneously achieves current-mode operation, nanowatt-range power consumption, temperature stability, and full tunability, solely using standard MOSFET elements. Schematic-level simulations in a 180 nm CMOS process confirm robust hysteresis and resilience to device mismatch. Building on this circuit, we develop a complete family of spike-based logic gates using three-level current encoding, where the bistable memory retains the polarity of the last spike on each input indefinitely, enabling asynchronous logic operations without temporal windowing or refresh mechanisms. The same circuit also serves as the primitive for Bistable Memory Recurrent Units in analog neural networks, where the quantized hidden states provide inherent noise immunity. Together, these capabilities position the design as a versatile building block for next-generation neuromorphic processors integrating memory, logic, and recurrent computation."},{"descriptionType":"Other","description":"Arthur Fyon and Loris Mendolia contributed equally to this work. This work has been the subject of two patent applications (Numbers: EP26175243.0 and EP26175248.9)"}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07936","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":1,"created":"2026-05-11T02:31:50Z","registered":"2026-05-11T02:31:50Z","published":null,"updated":"2026-10-14T08:33:01Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07786","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07786","identifiers":[{"identifier":"2605.07786","identifierType":"arXiv"}],"creators":[{"nameType":"Personal","givenName":"Caterina","familyName":"Gallegati","name":"Gallegati, Caterina","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Monica","familyName":"Bianchini","name":"Bianchini, Monica","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Franco","familyName":"Scarselli","name":"Scarselli, Franco","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Vittorio","familyName":"Murino","name":"Murino, Vittorio","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"Barbara Toniella","familyName":"Corradini","name":"Corradini, Barbara Toniella","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"APEX: Assumption-free Projection-based Embedding eXamination Metric for Generative Distribution Evaluation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"subject":"Computer Vision and Pattern Recognition (cs.CV)","lang":"en","subjectScheme":"arXiv"},{"subject":"Artificial Intelligence (cs.AI)","lang":"en","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T14:21:51Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:03:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-11T08:25:22Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-12T01:52:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-10-08T15:57:32Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-10-09T01:24:41Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-10-09T21:30:33Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-10-14T00:16:12Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"schemaOrg":"CreativeWork","resourceTypeGeneral":"Preprint","citeproc":"article","bibtex":"misc","ris":"GEN","resourceType":"Article"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"4","rightsList":[{"rightsIdentifierScheme":"SPDX","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rights":"Creative Commons Attribution 4.0 International","rightsIdentifier":"cc-by-4.0"}],"descriptions":[{"descriptionType":"Abstract","description":"As generative models achieve unprecedented visual quality, the gold standard for image evaluation remains traditional feature-distribution metrics. However, these metrics are provably hindered by the closed-vocabulary bottleneck of outdated features and the assumptive bias of rigid parametric formulations. Recent alternatives exploit modern backbones to solve the feature bottleneck, yet continue to suffer from parametric limitations. To close this gap, we introduce APEX (Assumption-free Projection-based Embedding eXamination), a novel evaluation framework leveraging two open-vocabulary foundation models (CLIP and DINOv2) as feature extractors and the Sliced Wasserstein Distance (SWD) as similarity measure. Since SWD requires no assumptions about the compared data distributions, APEX operates as an assumption-free metric. Moreover, we prove with theoretical and empirical evidences that it inherits effective scalability to high-dimensional spaces. Benchmarking APEX metrics against established baselines, we show that they exhibit strong robustness to visual degradations, intra- and cross-dataset stability, ensuring highly stable evaluations on out-of-domain datasets."}],"geoLocations":[],"fundingReferences":[],"url":"https://arxiv.org/abs/2605.07786","contentUrl":null,"metadataVersion":3,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"downloadCount":0,"referenceCount":0,"citationCount":0,"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:28:22Z","registered":"2026-05-11T02:28:23Z","published":null,"updated":"2026-10-14T08:33:00Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}}}},{"id":"10.48550/arxiv.2605.07586","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07586","identifiers":[{"identifier":"2605.07586","identifierType":"arXiv"}],"creators":[{"nameType":"Organizational","name":"LHCb collaboration","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"R.","familyName":"Aaij","name":"Aaij, R.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"M.","familyName":"Abdelfatah","name":"Abdelfatah, M.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"A. S. W.","familyName":"Abdelmotteleb","name":"Abdelmotteleb, A. S. W.","affiliation":[],"nameIdentifiers":[]},{"nameType":"Personal","givenName":"C. Abellan","familyName":"Beteta","name":"Beteta, C. Abella