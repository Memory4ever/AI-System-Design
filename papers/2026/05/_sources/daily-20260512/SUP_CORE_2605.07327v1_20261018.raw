<p id="S3.SS2.p2.4" class="ltx_p">where <math id="S3.SS2.p2.m4" class="ltx_Math" alttext="x=f_{\theta}(\epsilon,c)" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>=</mo><mrow><msub><mi>f</mi><mi>θ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>ϵ</mi><mo>,</mo><mi>c</mi><mo stretchy="false">)</mo>