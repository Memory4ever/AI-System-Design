<th id="S4.T1.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><math id="S4.T1.m2" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math></th>
