<span id="S0.F1.pic1.2.3.1.2" class="ltx_td ltx_align_left"><span id="S0.F1.pic1.2.3.1.2.1" class="ltx_text" style="font-size:90%;--ltx-fg-color:#000000;">You press <span id="S0.F1.pic1.2.3.1.2.1.1" class="ltx_text ltx_font_typewriter">&lt;&lt;R&gt;&gt;</span>.</span></span></span>
