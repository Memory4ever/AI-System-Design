<td id="S4.T1.2.1.9.11" class="ltx_td ltx_align_center" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S4.T1.2.1.9.11.1" class="ltx_text" style="font-size:90%;">7.93</span></td></tr>
