<td id="S4.T2.4.1.3.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:2.5pt;padding-right:2.5pt;"><span id="S4.T2.4.1.3.2.1" class="ltx_text" style="font-size:90%;">0.0126</span></td>
