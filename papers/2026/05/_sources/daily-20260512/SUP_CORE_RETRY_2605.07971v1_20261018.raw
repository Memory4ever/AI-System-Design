<td id="S4.T1.2.1.2.10" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S4.T1.2.1.2.10.1" class="ltx_text" style="font-size:90%;">FID</span><math id="S4.T1.m16" class="ltx_Math" alttext="{}_{\text{V}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext mathsize="0.900em">V</mtext></msub><annotation encoding="application/x-tex">{}_{\text{V}}</annotation></semantics></math><span id="S4.T1.2.1.2.10.2" class="ltx_text" style="font-size:90%;"> </span><math id="S4.T1.m17" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td></tr>
<tr id="S4.T1.2.1.3" class="ltx_tr">
<td id="S4.T1.2.1.3.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;" rowspan="4"><span id="S4.T1.2.1.3.1.1" class="ltx_text" style="font-size:90%;"><span id="S4.T1.2.1.3.1.1.1" class="ltx_text"></span> <span id="S4.T1.2.1.3.1.1.2" class="ltx_text">
