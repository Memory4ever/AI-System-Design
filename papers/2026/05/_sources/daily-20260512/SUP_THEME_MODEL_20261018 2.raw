    <category term="math.ST" scheme="http://arxiv.org/schemas/atom"/>
    <published>2026-05-08T01:26:25Z</published>
    <arxiv:primary_category term="stat.ML"/>
    <author>
      <name>Anastasis Kratsios</name>
    </author>
    <author>
      <name>Gregory Cousins</name>
    </author>
    <author>
      <name>Haitz Sáez de Ocáriz Borde</name>
    </author>
