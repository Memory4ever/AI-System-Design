    <category term="cs.SD" scheme="http://arxiv.org/schemas/atom"/>
    <category term="eess.AS" scheme="http://arxiv.org/schemas/atom"/>
    <published>2026-05-07T19:57:39Z</published>
    <arxiv:comment>Project Page: https://billyzhang24kobe.github.io/mist-smarthome/</arxiv:comment>
    <arxiv:primary_category term="cs.CL"/>
    <author>
      <name>Maximillian Chen</name>
    </author>
    <author>
      <name>Xuanming Zhang</name>
    </author>
    <author>
      <name>Michael Peng</name>
    </author>
    <author>
      <name>Zhou Yu</name>
    </author>
    <author>
      <name>Alexandros Papangelis</name>
    </author>
    <author>
      <name>Yohan Jo</name>
    </author>
