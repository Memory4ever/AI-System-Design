</span></span></td>
<td id="A2.T3.5.9.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="A2.T3.5.9.2.1" class="ltx_text" style="font-size:90%;"><cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Yun et al., 2020</a>)</cite></span></td>
<td id="A2.T3.5.9.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.9.3.1" class="ltx_text" style="font-size:90%;">Designed discontinuous</span></td>
<td id="A2.T3.5.9.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="A2.T3.5.9.4.1" class="ltx_text" style="font-size:90%;"><math id="A2.T3.m7" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo>√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></span></td>
<td id="A2.T3.5.9.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.9.5.1" class="ltx_text" style="font-size:90%;">Transformations</span></td></tr>
