<td id="A2.T3.5.1.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.1.1.1" class="ltx_text" style="font-size:90%;">Part</span></td>
<td id="A2.T3.5.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.1.2.1" class="ltx_text" style="font-size:90%;">Paper</span></td>
<td id="A2.T3.5.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.1.3.1" class="ltx_text" style="font-size:90%;">Operator</span></td>
<td id="A2.T3.5.1.4" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.1.4.1" class="ltx_text" style="font-size:90%;">​​​​ Residual</span></td>
<td id="A2.T3.5.1.5" class="ltx_td ltx_align_center ltx_border_tt" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.1.5.1" class="ltx_text" style="font-size:90%;">Remark</span></td></tr>
<tr id="A2.T3.5.2" class="ltx_tr">
<td id="A2.T3.5.2.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="4"><span id="A2.T3.5.2.1.1" class="ltx_text" style="font-size:90%;">​<span id="A2.T3.5.2.1.1.1" class="ltx_text">
<span id="A2.T3.5.2.1.1.1.1" class="ltx_inline-block">
<span id="A2.T3.5.2.1.1.1.1.1" class="ltx_p">Quantization</span>
<span id="A2.T3.5.2.1.1.1.1.2" class="ltx_p">Mapping</span>
</span></span></span></td>
<td id="A2.T3.5.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="A2.T3.5.2.2.1" class="ltx_text" style="font-size:90%;"><cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Yun et al., 2020</a>)</cite></span></td>
<td id="A2.T3.5.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.2.3.1" class="ltx_text" style="font-size:90%;">Designed discontinuous</span></td>
<td id="A2.T3.5.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="2"><span id="A2.T3.5.2.4.1" class="ltx_text" style="font-size:90%;"><math id="A2.T3.m1" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo>√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></span></td>
<td id="A2.T3.5.2.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.2.5.1" class="ltx_text" style="font-size:90%;">Transformations</span></td></tr>
<tr id="A2.T3.5.3" class="ltx_tr">
<td id="A2.T3.5.3.1" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.3.1.1" class="ltx_text" style="font-size:90%;">piece-wise linear</span></td>
<td id="A2.T3.5.3.2" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.3.2.1" class="ltx_text" style="font-size:90%;">between operators</span></td></tr>
<tr id="A2.T3.5.4" class="ltx_tr">
<td id="A2.T3.5.4.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.4.1.1" class="ltx_text" style="font-size:90%;">​​<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Kajitsuka &amp; Sato, 2024</a>; <a href="#bib.bib13" title="" class="ltx_ref">Hu et al., 2025a</a>; <a href="#bib.bib14" title="" class="ltx_ref">Hu et al., 2025b</a>; <a href="#bib.bib17" title="" class="ltx_ref">Jiao et al., 2025</a>)</cite></span></td>
<td id="A2.T3.5.4.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.4.2.1" class="ltx_text" style="font-size:90%;">ReLU</span></td>
<td id="A2.T3.5.4.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m2" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="A2.T3.5.4.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.4.4.1" class="ltx_text" style="font-size:90%;">Variant</span></td></tr>
<tr id="A2.T3.5.5" class="ltx_tr">
<td id="A2.T3.5.5.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Ours</span></td>
<td id="A2.T3.5.5.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.5.2.1" class="ltx_text" style="font-size:90%;">ReLU</span></td>
<td id="A2.T3.5.5.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m3" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="A2.T3.5.5.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.5.4.1" class="ltx_text" style="font-size:90%;">Standard structure</span></td></tr>
<tr id="A2.T3.5.6" class="ltx_tr">
<td id="A2.T3.5.6.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;" rowspan="3"><span id="A2.T3.5.6.1.1" class="ltx_text" style="font-size:90%;">
<span id="A2.T3.5.6.1.1.1" class="ltx_inline-block">
<span id="A2.T3.5.6.1.1.1.1" class="ltx_p">Contextual</span>
<span id="A2.T3.5.6.1.1.1.2" class="ltx_p">Mapping</span>
</span></span></td>
<td id="A2.T3.5.6.2" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><cite class="ltx_cite ltx_citemacro_citep"><span id="A2.T3.5.6.2.1" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib40" title="" class="ltx_ref">Yun et al., 2020</a><span id="A2.T3.5.6.2.3" class="ltx_text" style="font-size:90%;">)</span></cite></td>
<td id="A2.T3.5.6.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.6.3.1" class="ltx_text" style="font-size:90%;">Hardmax</span></td>
<td id="A2.T3.5.6.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m4" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="A2.T3.5.6.5" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.6.5.1" class="ltx_text" style="font-size:90%;">Transformations</span></td></tr>
<tr id="A2.T3.5.7" class="ltx_tr">
