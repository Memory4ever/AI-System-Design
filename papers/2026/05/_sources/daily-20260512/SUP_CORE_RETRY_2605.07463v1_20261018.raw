<div id="A3.SS1.p2" class="ltx_para">
<p id="A3.SS1.p2.1" class="ltx_p"><span id="A3.SS1.p2.1.1" class="ltx_text ltx_font_bold">As a result</span>, we have the following total <math id="A3.SS1.p2.m1" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> operations and <math id="A3.SS1.p2.m2" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> parameters of <math id="A3.SS1.p2.m3" class="ltx_Math" alttext="f_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">f_{\mathcal{T}}</annotation></semantics></math></p>
<table id="A3.Ex54" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A3.Ex54X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex54X.m2" class="ltx_Math" alttext="\displaystyle t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">\displaystyle t</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54X.m3" class="ltx_Math" alttext="\displaystyle=(25dL+6d+5L)LM^{dL}+13d^{2}L^{2}M+8d^{2}L+4dL^{2}+2L^{2}+5LM-2dL-L+17," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>25</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>6</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo>+</mo><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mi>L</mi></mrow><mo>+</mo><mn>17</mn></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=(25dL+6d+5L)LM^{dL}+13d^{2}L^{2}M+8d^{2}L+4dL^{2}+2L^{2}+5LM-2dL-L+17,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex54Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex54Xa.m2" class="ltx_Math" alttext="\displaystyle\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\displaystyle\omega</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex54Xa.m3" class="ltx_Math" alttext="\displaystyle=2dLM^{dL}+4d^{2}+M+10." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><mo>+</mo><mi>M</mi><mo>+</mo><mn>10</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=2dLM^{dL}+4d^{2}+M+10.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.p2.2" class="ltx_p">Further from Section <a href="#A2.SS4" title="B.4 Verification for the Approximation Error Upper Bound ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>, the Transformer function class <math id="A3.SS1.p2.m4" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math> which approximates Hölder class <math id="A3.SS1.p2.m5" class="ltx_Math" alttext="\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)</annotation></semantics></math> under the accuracy <math id="A3.SS1.p2.m6" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> has <math id="A3.SS1.p2.m7" class="ltx_Math" alttext="dLM+2LM^{dL}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">dLM+2LM^{dL}+1</annotation></semantics></math> blocks. Therefore, it is rational to assume <math id="A3.SS1.p2.m8" class="ltx_Math" alttext="t,\omega" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>,</mo><mi>ω</mi></mrow><annotation encoding="application/x-tex">t,\omega</annotation></semantics></math> and <math id="A3.SS1.p2.m9" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> share the same order, that is, <math id="A3.SS1.p2.m10" class="ltx_Math" alttext="t\sim\omega\sim D" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>∼</mo><mi>ω</mi><mo>∼</mo><mi>D</mi></mrow><annotation encoding="application/x-tex">t\sim\omega\sim D</annotation></semantics></math>. Immediately, we obtain</p>
<table id="A3.E45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E45.m1" class="ltx_Math" alttext="\mathrm{VCdim}(\mathcal{T}_{R}^{D})\leq t^{2}\omega(\omega+19\log_{2}(9\omega))\lesssim D^{4}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ω</mi><mo>+</mo><mrow><mn>19</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><msup><mi>D</mi><mn>4</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{VCdim}(\mathcal{T}_{R}^{D})\leq t^{2}\omega(\omega+19\log_{2}(9\omega))\lesssim D^{4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(45)</span></td></tr></tbody>
</table>
</div>
<section id="A3.SS1.SSS1" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">C.1.1 </span>Details of Computation</h4>

<div id="A3.SS1.SSS1.p1" class="ltx_para">
<p id="A3.SS1.SSS1.p1.1" class="ltx_p">The following are details of computations of total number of parameters and operations, which serves as reference if needed.</p>
</div>
<div id="A3.SS1.SSS1.p2" class="ltx_para">
<p id="A3.SS1.SSS1.p2.1" class="ltx_p"><span id="A3.SS1.SSS1.p2.1.1" class="ltx_text ltx_font_bold">Quantization Module.</span> <math id="A3.SS1.SSS1.p2.m1" class="ltx_Math" alttext="f_{\mathcal{T}1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}1}</annotation></semantics></math> is
composed of <math id="A3.SS1.SSS1.p2.m2" class="ltx_Math" alttext="d_{0}M" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">d_{0}M</annotation></semantics></math> feed-forward layers and the positional encoding <math id="A3.SS1.SSS1.p2.m3" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math>. The positional encoding <math id="A3.SS1.SSS1.p2.m4" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> defined in (<a href="#A2.E23" title="Equation 23 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) involves <math id="A3.SS1.SSS1.p2.m5" class="ltx_Math" alttext="dL" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">dL</annotation></semantics></math> addition operations and the subsequent feed-forward layer is briefly like</p>
<table id="A3.E46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E46.m1" class="ltx_Math" alttext="\mathrm{FF}^{(i,j,k+1)}_{1}(X)=X+e_{i}\Big(-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]\Big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msubsup><mi>FF</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo>+</mo><mrow><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><msup><mi>δ</mi><mo>∗</mo></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mi>δ</mi><msup><mi>δ</mi><mo>∗</mo></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,j,k+1)}_{1}(X)=X+e_{i}\Big(-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(46)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p2.2" class="ltx_p">where <math id="A3.SS1.SSS1.p2.m6" class="ltx_Math" alttext="i\in[d],j\in[L],k+1\in[M]," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>d</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>M</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i\in[d],j\in[L],k+1\in[M],</annotation></semantics></math> and <math id="A3.SS1.SSS1.p2.m7" class="ltx_Math" alttext="t=X-(j+k(\delta+\delta^{*}))\cdot\mathds{1}_{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>X</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">t=X-(j+k(\delta+\delta^{*}))\cdot\mathds{1}_{d\times L}</annotation></semantics></math>. This module has <math id="A3.SS1.SSS1.p2.m8" class="ltx_Math" alttext="M+4" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>+</mo><mn>4</mn></mrow><annotation encoding="application/x-tex">M+4</annotation></semantics></math> total parameters “<math id="A3.SS1.SSS1.p2.m9" class="ltx_Math" alttext="-1,0,\ldots,M,\delta,\delta^{*}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>0</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>M</mi><mo>,</mo><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><annotation encoding="application/x-tex">-1,0,\ldots,M,\delta,\delta^{*}</annotation></semantics></math>”.</p>
</div>
<div id="A3.SS1.SSS1.p3" class="ltx_para">
<p id="A3.SS1.SSS1.p3.1" class="ltx_p">In the case of number of operations, there are <math id="A3.SS1.SSS1.p3.m1" class="ltx_Math" alttext="3" display="inline" intent=":literal"><semantics><mn>3</mn><annotation encoding="application/x-tex">3</annotation></semantics></math> ground operations for preparing “<math id="A3.SS1.SSS1.p3.m2" class="ltx_Math" alttext="\delta+\delta^{*},\frac{\delta}{\delta^{*}},\frac{\delta+\delta^{*}}{\delta^{*}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo>,</mo><mfrac><mi>δ</mi><msup><mi>δ</mi><mo>∗</mo></msup></mfrac><mo>,</mo><mfrac><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><msup><mi>δ</mi><mo>∗</mo></msup></mfrac></mrow><annotation encoding="application/x-tex">\delta+\delta^{*},\frac{\delta}{\delta^{*}},\frac{\delta+\delta^{*}}{\delta^{*}}</annotation></semantics></math>” and <math id="A3.SS1.SSS1.p3.m3" class="ltx_Math" alttext="5LM" display="inline" intent=":literal"><semantics><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">5LM</annotation></semantics></math> operations for getting “<math id="A3.SS1.SSS1.p3.m4" class="ltx_Math" alttext="j+k(\delta+\delta^{*})-\delta" display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>−</mo><mi>δ</mi></mrow><annotation encoding="application/x-tex">j+k(\delta+\delta^{*})-\delta</annotation></semantics></math>” and “<math id="A3.SS1.SSS1.p3.m5" class="ltx_Math" alttext="j+(k-1)(\delta+\delta^{*})" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j+(k-1)(\delta+\delta^{*})</annotation></semantics></math>”. Besides, one such feed-forward layer needs at most <math id="A3.SS1.SSS1.p3.m6" class="ltx_Math" alttext="10dL" display="inline" intent=":literal"><semantics><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">10dL</annotation></semantics></math> element-wise arithmetic operations and <math id="A3.SS1.SSS1.p3.m7" class="ltx_Math" alttext="3dL" display="inline" intent=":literal"><semantics><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">3dL</annotation></semantics></math> jump comparisons from <math id="A3.SS1.SSS1.p3.m8" class="ltx_Math" alttext="\sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\sigma_{R}</annotation></semantics></math>. Consequently, there are <math id="A3.SS1.SSS1.p3.m9" class="ltx_Math" alttext="dLM\cdot 13dL+5LM+3=13(dL)^{2}M+5LM+3" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>13</mn></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mn>3</mn></mrow><mo>=</mo><mrow><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">dLM\cdot 13dL+5LM+3=13(dL)^{2}M+5LM+3</annotation></semantics></math> operations in total.</p>
</div>
<div id="A3.SS1.SSS1.p4" class="ltx_para">
<p id="A3.SS1.SSS1.p4.1" class="ltx_p"><span id="A3.SS1.SSS1.p4.1.1" class="ltx_text ltx_font_bold">Contextual Mapping.</span> <math id="A3.SS1.SSS1.p4.m1" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math> takes the form</p>
<table id="A3.Ex55" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex55.m1" class="ltx_Math" alttext="\mathrm{Attn}(X)=X+W_{O}W_{V}X\sigma_{S}\left[(W_{K}X)^{\top}W_{Q}X\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Attn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo>+</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Attn}(X)=X+W_{O}W_{V}X\sigma_{S}\left[(W_{K}X)^{\top}W_{Q}X\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p4.2" class="ltx_p">where <math id="A3.SS1.SSS1.p4.m2" class="ltx_Math" alttext="W_{O},W_{K},W_{Q},W_{V}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>O</mi></msub><mo>,</mo><msub><mi>W</mi><mi>K</mi></msub><mo>,</mo><msub><mi>W</mi><mi>Q</mi></msub><mo>,</mo><mrow><msub><mi>W</mi><mi>V</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">W_{O},W_{K},W_{Q},W_{V}\in\mathbb{R}^{m\times d}</annotation></semantics></math>. Here, we set <math id="A3.SS1.SSS1.p4.m3" class="ltx_Math" alttext="m=d" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">m=d</annotation></semantics></math> for simplicity since the head size <math id="A3.SS1.SSS1.p4.m4" class="ltx_Math" alttext="m" display="inline" intent=":literal"><semantics><mi>m</mi><annotation encoding="application/x-tex">m</annotation></semantics></math> can be arbitrary. There are <math id="A3.SS1.SSS1.p4.m5" class="ltx_Math" alttext="4d^{2}" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4d^{2}</annotation></semantics></math> parameters.</p>
</div>
<div id="A3.SS1.SSS1.p5" class="ltx_para">
<p id="A3.SS1.SSS1.p5.1" class="ltx_p">Now we consider the number of operations in this single-layer contextual mapping. Suppose we have a single vector <math id="A3.SS1.SSS1.p5.m1" class="ltx_Math" alttext="x\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow><annotation encoding="application/x-tex">x\in\mathbb{R}^{L}</annotation></semantics></math>, the Softmax operator <math id="A3.SS1.SSS1.p5.m2" class="ltx_Math" alttext="\sigma_{S}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\sigma_{S}</annotation></semantics></math> needs <math id="A3.SS1.SSS1.p5.m3" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> exponential <math id="A3.SS1.SSS1.p5.m4" class="ltx_Math" alttext="\alpha\mapsto e^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo stretchy="false">↦</mo><msup><mi>e</mi><mi>α</mi></msup></mrow><annotation encoding="application/x-tex">\alpha\mapsto e^{\alpha}</annotation></semantics></math> operations and <math id="A3.SS1.SSS1.p5.m5" class="ltx_Math" alttext="2L-1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2L-1</annotation></semantics></math> arithmetic operations on <math id="A3.SS1.SSS1.p5.m6" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math>. Further for <math id="A3.SS1.SSS1.p5.m7" class="ltx_Math" alttext="L" display="inline" intent=":literal"><semantics><mi>L</mi><annotation encoding="application/x-tex">L</annotation></semantics></math> columns input, <math id="A3.SS1.SSS1.p5.m8" class="ltx_Math" alttext="\sigma_{S}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\sigma_{S}</annotation></semantics></math> needs <math id="A3.SS1.SSS1.p5.m9" class="ltx_Math" alttext="L(3L-1)" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">L(3L-1)</annotation></semantics></math> operations. As a result, <math id="A3.SS1.SSS1.p5.m10" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math> has total <math id="A3.SS1.SSS1.p5.m11" class="ltx_Math" alttext="dL(8d+4L-4)+2L^{2}-L" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><mo>−</mo><mn>4</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">dL(8d+4L-4)+2L^{2}-L</annotation></semantics></math> operations, including <math id="A3.SS1.SSS1.p5.m12" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> exponential, <math id="A3.SS1.SSS1.p5.m13" class="ltx_Math" alttext="4d^{2}L+2dL^{2}+L^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><mo>+</mo><msup><mi>L</mi><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">4d^{2}L+2dL^{2}+L^{2}</annotation></semantics></math> of “<math id="A3.SS1.SSS1.p5.m14" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math>” and “<math id="A3.SS1.SSS1.p5.m15" class="ltx_Math" alttext="/" display="inline" intent=":literal"><semantics><mo>/</mo><annotation encoding="application/x-tex">/</annotation></semantics></math>”, and <math id="A3.SS1.SSS1.p5.m16" class="ltx_Math" alttext="4d^{2}L+2dL^{2}-4dL-L" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>d</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>L</mi><mn>2</mn></msup></mrow></mrow><mo>−</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>−</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">4d^{2}L+2dL^{2}-4dL-L</annotation></semantics></math> of “<math id="A3.SS1.SSS1.p5.m17" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math>” and “<math id="A3.SS1.SSS1.p5.m18" class="ltx_Math" alttext="-" display="inline" intent=":literal"><semantics><mo>−</mo><annotation encoding="application/x-tex">-</annotation></semantics></math>”.</p>
</div>
<div id="A3.SS1.SSS1.p6" class="ltx_para">
<p id="A3.SS1.SSS1.p6.1" class="ltx_p"><span id="A3.SS1.SSS1.p6.1.1" class="ltx_text ltx_font_bold">Value Mapping.</span> <math id="A3.SS1.SSS1.p6.m1" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math> consists of <math id="A3.SS1.SSS1.p6.m2" class="ltx_Math" alttext="LM^{dL}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">LM^{dL}</annotation></semantics></math> subunits and an extra feed-forward layer. For any <math id="A3.SS1.SSS1.p6.m3" class="ltx_Math" alttext="i\in[M^{dL}]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[M^{dL}]</annotation></semantics></math> and <math id="A3.SS1.SSS1.p6.m4" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math>, every subunit has <math id="A3.SS1.SSS1.p6.m5" class="ltx_Math" alttext="\mathrm{FF}^{(i,k,1)}_{2}" display="inline" intent=":literal"><semantics><msubsup><mi>FF</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}_{2}</annotation></semantics></math> and <math id="A3.SS1.SSS1.p6.m6" class="ltx_Math" alttext="\mathrm{FF}^{(i,k,2)}_{3}" display="inline" intent=":literal"><semantics><msubsup><mi>FF</mi><mn>3</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,2)}_{3}</annotation></semantics></math> defined by</p>
<table id="A3.E47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E47.m1" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,1)}_{2}(\bar{X})=\bar{X}+\sigma_{\zeta 1}[\bar{X}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\cdot\mathds{1}_{L}^{\top}]\coloneq Z," display="block" intent=":literal"><semantics><mrow><msubsup><mi>FF</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>+</mo><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">[</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.222em">⋅</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup><mo stretchy="false">]</mo></mrow><mo>≔</mo><mi>Z</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}_{2}(\bar{X})=\bar{X}+\sigma_{\zeta 1}[\bar{X}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\cdot\mathds{1}_{L}^{\top}]\coloneq Z,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(47)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p6.2" class="ltx_p">where</p>
<table id="A3.Ex56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex56.m1" class="ltx_Math" alttext="\sigma_{\zeta 1}[t]=\frac{2dr}{\gamma_{2}}\Big(\sigma_{R}\Big[t+\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t+\frac{\gamma_{1}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t-\frac{\gamma_{1}}{2\sqrt{d}}\Big]+\sigma_{R}\Big[t-\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]\Big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>+</mo><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>+</mo><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>−</mo><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>−</mo><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\sigma_{\zeta 1}[t]=\frac{2dr}{\gamma_{2}}\Big(\sigma_{R}\Big[t+\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t+\frac{\gamma_{1}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t-\frac{\gamma_{1}}{2\sqrt{d}}\Big]+\sigma_{R}\Big[t-\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p6.3" class="ltx_p">and</p>
<table id="A3.E48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E48.m1" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,2)}_{3}(Z)=Z+(Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}-f_{\mathcal{T}2}(G^{(i)})_{:,k})\sigma_{\zeta 2}\left[\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}\right]-\sigma_{\zeta 3}\left[Z-\sqrt{d}r\mathds{1}_{d}\cdot\mathds{1}_{L}^{\top}\right]," display="block" intent=":literal"><semantics><mrow><msubsup><mi>FF</mi><mn>3</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>Z</mi><mo>+</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo stretchy="false">)</mo></mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mrow><mo>[</mo><msubsup><mn>𝟙</mn><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>Z</mi><mo>−</mo><mi>d</mi><msqrt><mi>d</mi></msqrt><mi>r</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup><mo>]</mo></mrow><mo>−</mo><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mrow><mo>[</mo><mi>Z</mi><mo>−</mo><msqrt><mi>d</mi></msqrt><mi>r</mi><msub><mn>𝟙</mn><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup><mo>]</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,2)}_{3}(Z)=Z+(Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}-f_{\mathcal{T}2}(G^{(i)})_{:,k})\sigma_{\zeta 2}\left[\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}\right]-\sigma_{\zeta 3}\left[Z-\sqrt{d}r\mathds{1}_{d}\cdot\mathds{1}_{L}^{\top}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(48)</span></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p6.4" class="ltx_p">where</p>
<table id="A3.EGx11" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex57"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex57.m1" class="ltx_Math" alttext="\displaystyle\sigma_{\zeta 2}[t]=\frac{1}{\gamma_{2}}\sigma_{R}\left[t\right]-\frac{1}{\gamma_{2}}\sigma_{R}\left[t-\gamma_{2}\right],~\mathrm{and}~\sigma_{\zeta 3}[t]=\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t+\gamma_{2}\right]-\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>t</mi><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mrow><mi>and</mi><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>t</mi><mo>]</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\zeta 2}[t]=\frac{1}{\gamma_{2}}\sigma_{R}\left[t\right]-\frac{1}{\gamma_{2}}\sigma_{R}\left[t-\gamma_{2}\right],~\mathrm{and}~\sigma_{\zeta 3}[t]=\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t+\gamma_{2}\right]-\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS1.SSS1.p6.5" class="ltx_p">In a nut, there are <math id="A3.SS1.SSS1.p6.m7" class="ltx_Math" alttext="6" display="inline" intent=":literal"><semantics><mn>6</mn><annotation encoding="application/x-tex">6</annotation></semantics></math> additional global parameters “<math id="A3.SS1.SSS1.p6.m8" class="ltx_Math" alttext="\gamma_{1},\gamma_{2},r,K,d,\sqrt{d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>γ</mi><mn>2</mn></msub><mo>,</mo><mi>r</mi><mo>,</mo><mi>K</mi><mo>,</mo><mi>d</mi><mo>,</mo><msqrt><mi>d</mi></msqrt></mrow><annotation encoding="application/x-tex">\gamma_{1},\gamma_{2},r,K,d,\sqrt{d}</annotation></semantics></math>” and <math id="A3.SS1.SSS1.p6.m9" class="ltx_Math" alttext="2d" display="inline" intent=":literal"><semantics><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">2d</annotation></semantics></math> temporary parameters “<math id="A3.SS1.SSS1.p6.m10" class="ltx_math_unparsed" alttext="Y_{G:,k}^{(i)},f_{\mathcal{T}2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">Y_{G:,k}^{(i)},f_{\mathcal{T}2}(G^{(i)})_{:,k}</annotation></semantics></math>” in every two layers, resulting in <math id="A3.SS1.SSS1.p6.m11" class="ltx_Math" alttext="2dLM^{dL}+6" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo>+</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">2dLM^{dL}+6</annotation></semantics></math> total parameters.</p>
</div>
<div id="A3.SS1.SSS1.p7" class="ltx_para">
<p id="A3.SS1.SSS1.p7.1" class="ltx_p">Moreover, these two layers need <math id="A3.SS1.SSS1.p7.m1" class="ltx_Math" alttext="14" display="inline" intent=":literal"><semantics><mn>14</mn><annotation encoding="application/x-tex">14</annotation></semantics></math> operations to prepare “<math id="A3.SS1.SSS1.p7.m2" class="ltx_Math" alttext="\frac{2dr}{\gamma_{2}},2\sqrt{d},\frac{\gamma_{1}}{2\sqrt{d}},\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\sqrt{d}r,d\sqrt{d}r,r+K,\frac{1}{\gamma_{2}},\frac{\sqrt{d}r}{\gamma_{2}},d\sqrt{d}r+\gamma_{2},\gamma_{2}-\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>,</mo><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>,</mo><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo>,</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo>,</mo><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>,</mo><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac><mo>,</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>,</mo><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>−</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\frac{2dr}{\gamma_{2}},2\sqrt{d},\frac{\gamma_{1}}{2\sqrt{d}},\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\sqrt{d}r,d\sqrt{d}r,r+K,\frac{1}{\gamma_{2}},\frac{\sqrt{d}r}{\gamma_{2}},d\sqrt{d}r+\gamma_{2},\gamma_{2}-\sqrt{d}r</annotation></semantics></math>”. Layer <math id="A3.SS1.SSS1.p7.m3" class="ltx_Math" alttext="\mathrm{FF}_{2}^{(i,k,1)}(\bar{X})" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>FF</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{FF}_{2}^{(i,k,1)}(\bar{X})</annotation></semantics></math> needs <math id="A3.SS1.SSS1.p7.m4" class="ltx_Math" alttext="9dL+4d" display="inline" intent=":literal"><semantics><mrow><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">9dL+4d</annotation></semantics></math> arithmetic operations (where <math id="A3.SS1.SSS1.p7.m5" class="ltx_Math" alttext="4d" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">4d</annotation></semantics></math> steps are for linear operations between <math id="A3.SS1.SSS1.p7.m6" class="ltx_math_unparsed" alttext="f_{\mathcal{T}2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}2}(G^{(i)})_{:,k}</annotation></semantics></math> and <math id="A3.SS1.SSS1.p7.m7" class="ltx_Math" alttext="4" display="inline" intent=":literal"><semantics><mn>4</mn><annotation encoding="application/x-tex">4</annotation></semantics></math> constants in <math id="A3.SS1.SSS1.p7.m8" class="ltx_Math" alttext="\sigma_{R}[\cdot]" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{R}[\cdot]</annotation></semantics></math>) and <math id="A3.SS1.SSS1.p7.m9" class="ltx_Math" alttext="4dL" display="inline" intent=":literal"><semantics><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">4dL</annotation></semantics></math> jumps of <math id="A3.SS1.SSS1.p7.m10" class="ltx_Math" alttext="\sigma_{R}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mi>R</mi></msub><annotation encoding="application/x-tex">\sigma_{R}</annotation></semantics></math>. On the other hand, <math id="A3.SS1.SSS1.p7.m11" class="ltx_Math" alttext="\mathrm{FF}_{3}^{(i,k,2)}(Z)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>FF</mi><mn>3</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{FF}_{3}^{(i,k,2)}(Z)</annotation></semantics></math> needs <math id="A3.SS1.SSS1.p7.m12" class="ltx_Math" alttext="10dL+3L+2d" display="inline" intent=":literal"><semantics><mrow><mrow><mn>10</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">10dL+3L+2d</annotation></semantics></math> arithmetic operations and <math id="A3.SS1.SSS1.p7.m13" class="ltx_Math" alttext="2dL+2L" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">2dL+2L</annotation></semantics></math> jumps. Due to <math id="A3.SS1.SSS1.p7.m14" class="ltx_Math" alttext="LM^{dL}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">LM^{dL}</annotation></semantics></math> sets, we get <math id="A3.SS1.SSS1.p7.m15" class="ltx_Math" alttext="(13dL+4d)LM^{dL}+(12dL+5L+2d)LM^{dL}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>13</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>12</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>5</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">(13dL+4d)LM^{dL}+(12dL+5L+2d)LM^{dL}</annotation></semantics></math> total operations. The last layer <math id="A3.SS1.SSS1.p7.m16" class="ltx_Math" alttext="\mathrm{FF}_{4}" display="inline" intent=":literal"><semantics><msub><mi>FF</mi><mn>4</mn></msub><annotation encoding="application/x-tex">\mathrm{FF}_{4}</annotation></semantics></math> of subtracting the constant <math id="A3.SS1.SSS1.p7.m17" class="ltx_Math" alttext="r+K" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">r+K</annotation></semantics></math> element-wisely, needs <math id="A3.SS1.SSS1.p7.m18" class="ltx_Math" alttext="dL" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">dL</annotation></semantics></math> operations.</p>
</div>
</section>
</section>
<section id="A3.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.2 </span>Lower Bound of the Approximation Error</h3>

<div id="A3.SS2.p1" class="ltx_para ltx_noindent">
<p id="A3.SS2.p1.1" class="ltx_p"><span id="A3.SS2.p1.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#S5.Thmtheorem3" title="Theorem 5.3 (Lower Bound of Approximation Error). ‣ 5 Approximation Lower Bound with VC-dimension ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> </span>(Lower Bound of Approximation Error; Restatement)<span id="A3.SS2.p1.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A3.SS2.p1.1.3" class="ltx_text ltx_font_italic">
For any <math id="A3.SS2.p1.m1" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>, a Transformer architecture <math id="A3.SS2.p1.m2" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math> with <math id="A3.SS2.p1.m3" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> blocks, which is capable of approximating any function <math id="A3.SS2.p1.m4" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)</annotation></semantics></math> with smooth index <math id="A3.SS2.p1.m5" class="ltx_Math" alttext="\alpha\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1]</annotation></semantics></math> under error <math id="A3.SS2.p1.m6" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>, must possess <math id="A3.SS2.p1.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> operations, <math id="A3.SS2.p1.m8" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> parameters and <math id="A3.SS2.p1.m9" class="ltx_Math" alttext="D" display="inline" intent=":literal"><semantics><mi>D</mi><annotation encoding="application/x-tex">D</annotation></semantics></math> blocks satisfying</span></p>
<table id="A3.Ex58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex58.m1" class="ltx_Math" alttext="D^{4}\gtrsim t^{2}\omega(\omega+19\log_{2}(9\omega))\geq\mathrm{VCdim}(\mathcal{T}_{R}^{D})\gtrsim\varepsilon^{-\frac{d_{0}}{\alpha}}." display="block" intent=":literal"><semantics><mrow><mrow><msup><mi>D</mi><mn>4</mn></msup><mo>≳</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ω</mi><mo>+</mo><mrow><mn>19</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≥</mo><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≳</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">D^{4}\gtrsim t^{2}\omega(\omega+19\log_{2}(9\omega))\geq\mathrm{VCdim}(\mathcal{T}_{R}^{D})\gtrsim\varepsilon^{-\frac{d_{0}}{\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p1.2" class="ltx_p"><span id="A3.SS2.p1.2.1" class="ltx_text ltx_font_italic">Equivalently, the block number <math id="A3.SS2.p1.m10" class="ltx_Math" alttext="D\gtrsim\varepsilon^{-\frac{d_{0}}{4\alpha}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>≳</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">D\gtrsim\varepsilon^{-\frac{d_{0}}{4\alpha}}</annotation></semantics></math>.
</span></p>
</div>
<div id="A3.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A3.SS2.2.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#S5.Thmtheorem3" title="Theorem 5.3 (Lower Bound of Approximation Error). ‣ 5 Approximation Lower Bound with VC-dimension ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a></span>.</h6>
<div id="A3.SS2.p2" class="ltx_para">
<p id="A3.SS2.p2.1" class="ltx_p"><span id="A3.SS2.p2.1.1" class="ltx_text">Our proof strategy adapts the technique developed by <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib29" title="" class="ltx_ref">Shen et al., 2022</a>)</cite>, extending it to handle the analysis of Transformers. As the VC-dimension roots in the scalar function class, we degenerate the output dimension of the Hölder class into one, that is, <math id="A3.SS2.p2.m1" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0}}^{\alpha}:\mathbb{R}^{d_{0}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0}}^{\alpha}:\mathbb{R}^{d_{0}}\to\mathbb{R}</annotation></semantics></math> with <math id="A3.SS2.p2.m2" class="ltx_Math" alttext="d_{x}=d_{0}" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>x</mi></msub><mo>=</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><annotation encoding="application/x-tex">d_{x}=d_{0}</annotation></semantics></math> and <math id="A3.SS2.p2.m3" class="ltx_Math" alttext="d_{y}=1" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mi>y</mi></msub><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{y}=1</annotation></semantics></math>. This degeneration won’t influence the main structure of Transformer network <math id="A3.SS2.p2.m4" class="ltx_Math" alttext="\mathcal{T}^{D}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>D</mi></msup><annotation encoding="application/x-tex">\mathcal{T}^{D}</annotation></semantics></math> since we apply the proper <math id="A3.SS2.p2.m5" class="ltx_Math" alttext="\mathcal{E}_{\rm in}=\mathds{1}_{d_{0}}:\mathbb{R}^{d_{0}}\to\mathbb{R}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>in</mi></msub><mo>=</mo><msub><mn>𝟙</mn><msub><mi>d</mi><mn>0</mn></msub></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\rm in}=\mathds{1}_{d_{0}}:\mathbb{R}^{d_{0}}\to\mathbb{R}^{d_{0}}</annotation></semantics></math> and <math id="A3.SS2.p2.m6" class="ltx_Math" alttext="\mathcal{E}_{\rm out}=e_{1}:\mathbb{R}^{d_{0}}\to\mathbb{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>out</mi></msub><mo>=</mo><msub><mi>e</mi><mn>1</mn></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\rm out}=e_{1}:\mathbb{R}^{d_{0}}\to\mathbb{R}</annotation></semantics></math>.
Let</span></p>
<table id="A3.Ex59" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex59.m1" class="ltx_math_unparsed" alttext="\mathcal{T}_{R}^{D}=\left\{g=\mathcal{E}_{\mathrm{out}}\circ R^{-1}\circ f_{\mathcal{T}}\circ R\circ\mathcal{E}_{\mathrm{in}}:\mathbb{R}^{d_{0}}\to\mathbb{R}~\mid~f_{\mathcal{T}}\in\mathcal{T}^{D},d_{0}=dL\right\}." display="block" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>=</mo><mrow><mo>{</mo><mi>g</mi><mo>=</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>out</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>R</mi><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>in</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">→</mo><mi>ℝ</mi><mo lspace="0.330em" rspace="0.497em">∣</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>D</mi></msup><mo>,</mo><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><mi>d</mi><mi>L</mi><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}=\left\{g=\mathcal{E}_{\mathrm{out}}\circ R^{-1}\circ f_{\mathcal{T}}\circ R\circ\mathcal{E}_{\mathrm{in}}:\mathbb{R}^{d_{0}}\to\mathbb{R}~\mid~f_{\mathcal{T}}\in\mathcal{T}^{D},d_{0}=dL\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p2.2" class="ltx_p"><span id="A3.SS2.p2.2.1" class="ltx_text">Then Theorem <a href="#S5.Thmtheorem2" title="Theorem 5.2 ( , , Theorem 8.14). ‣ 5 Approximation Lower Bound with VC-dimension ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.2</span></a> demonstrates that</span></p>
<table id="A3.E49" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E49.m1" class="ltx_Math" alttext="\mathrm{VCdim}({\mathcal{T}_{R}^{D}})\leq t^{2}\omega(\omega+19\log_{2}(9\omega))," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msup><mi>t</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>ω</mi><mo>+</mo><mrow><mn>19</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><msub><mi>log</mi><mn>2</mn></msub><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>ω</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{VCdim}({\mathcal{T}_{R}^{D}})\leq t^{2}\omega(\omega+19\log_{2}(9\omega)),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(49)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p2.3" class="ltx_p"><span id="A3.SS2.p2.3.1" class="ltx_text">where <math id="A3.SS2.p2.m7" class="ltx_Math" alttext="t" display="inline" intent=":literal"><semantics><mi>t</mi><annotation encoding="application/x-tex">t</annotation></semantics></math> and <math id="A3.SS2.p2.m8" class="ltx_Math" alttext="\omega" display="inline" intent=":literal"><semantics><mi>ω</mi><annotation encoding="application/x-tex">\omega</annotation></semantics></math> are the total numbers of operations and parameters of <math id="A3.SS2.p2.m9" class="ltx_Math" alttext="\mathcal{M}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℳ</mi><annotation encoding="application/x-tex">\mathcal{M}</annotation></semantics></math> respectively.</span></p>
</div>
<div id="A3.SS2.p3" class="ltx_para">
<p id="A3.SS2.p3.1" class="ltx_p"><span id="A3.SS2.p3.1.1" class="ltx_text">Given a positive integer <math id="A3.SS2.p3.m1" class="ltx_Math" alttext="M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor</annotation></semantics></math> to be defined later, we divide <math id="A3.SS2.p3.m2" class="ltx_Math" alttext="[0,1]^{d_{0}}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">[0,1]^{d_{0}}</annotation></semantics></math> into <math id="A3.SS2.p3.m3" class="ltx_Math" alttext="M^{d_{0}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">M^{d_{0}}</annotation></semantics></math> non-overlapping sub-cubes <math id="A3.SS2.p3.m4" class="ltx_Math" alttext="\{S_{\theta}\}_{\theta}" display="inline" intent=":literal"><semantics><msub><mrow><mo stretchy="false">{</mo><msub><mi>S</mi><mi>θ</mi></msub><mo stretchy="false">}</mo></mrow><mi>θ</mi></msub><annotation encoding="application/x-tex">\{S_{\theta}\}_{\theta}</annotation></semantics></math>, and set</span></p>
<table id="A3.Ex60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex60.m1" class="ltx_math_unparsed" alttext="S_{\theta}=\left\{x=[x_{1},x_{2},\ldots,x_{d_{0}}]^{\top}\mid x_{j}\in[\theta_{j}(\delta+\delta^{*}),\theta_{j}(\delta+\delta^{*})+\delta],j\in[d_{0}]\right\}," display="block" intent=":literal"><semantics><mrow><msub><mi>S</mi><mi>θ</mi></msub><mo>=</mo><mrow><mo>{</mo><mi>x</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><msub><mi>x</mi><mn>1</mn></msub><mo>,</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>x</mi><msub><mi>d</mi><mn>0</mn></msub></msub><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0.167em">∣</mo><msub><mi>x</mi><mi>j</mi></msub><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>θ</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>θ</mi><mi>j</mi></msub><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mo>+</mo><mi>δ</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>d</mi><mn>0</mn></msub><mo stretchy="false">]</mo></mrow><mo>}</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">S_{\theta}=\left\{x=[x_{1},x_{2},\ldots,x_{d_{0}}]^{\top}\mid x_{j}\in[\theta_{j}(\delta+\delta^{*}),\theta_{j}(\delta+\delta^{*})+\delta],j\in[d_{0}]\right\},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p3.2" class="ltx_p"><span id="A3.SS2.p3.2.1" class="ltx_text">for any index vector <math id="A3.SS2.p3.m5" class="ltx_Math" alttext="\theta=[\theta_{1},\theta_{2},\ldots,\theta_{d_{0}}]^{\top}=\{0,1,\ldots,M-1\}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mrow><msub><mi>θ</mi><mn>1</mn></msub><mo>,</mo><msub><mi>θ</mi><mn>2</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>θ</mi><msub><mi>d</mi><mn>0</mn></msub></msub></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup><mo>=</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\theta=[\theta_{1},\theta_{2},\ldots,\theta_{d_{0}}]^{\top}=\{0,1,\ldots,M-1\}^{d_{0}}</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p4" class="ltx_para">
<p id="A3.SS2.p4.1" class="ltx_p"><span id="A3.SS2.p4.1.1" class="ltx_text">Let <math id="A3.SS2.p4.m1" class="ltx_Math" alttext="S\coloneq S(\hat{x},\mu)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>≔</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">S\coloneq S(\hat{x},\mu)</annotation></semantics></math> denote the closed cube with center <math id="A3.SS2.p4.m2" class="ltx_Math" alttext="\hat{x}\in\mathbb{R}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo>∈</mo><msup><mi>ℝ</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\hat{x}\in\mathbb{R}^{d_{0}}</annotation></semantics></math> and side-length <math id="A3.SS2.p4.m3" class="ltx_Math" alttext="l&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">l&gt;0</annotation></semantics></math>. Define <math id="A3.SS2.p4.m4" class="ltx_Math" alttext="\zeta_{S}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\zeta_{S}</annotation></semantics></math> on <math id="A3.SS2.p4.m5" class="ltx_Math" alttext="[0,1]^{d}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mi>d</mi></msup><annotation encoding="application/x-tex">[0,1]^{d}</annotation></semantics></math> corresponding to <math id="A3.SS2.p4.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>, satisfying i) <math id="A3.SS2.p4.m7" class="ltx_Math" alttext="\zeta_{S}(\hat{x})=(l/2)^{\alpha}/2" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>l</mi><mo>/</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup><mo>/</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">\zeta_{S}(\hat{x})=(l/2)^{\alpha}/2</annotation></semantics></math>; ii) <math id="A3.SS2.p4.m8" class="ltx_Math" alttext="\zeta_{S}(x)=0" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>ζ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\zeta_{S}(x)=0</annotation></semantics></math> for any <math id="A3.SS2.p4.m9" class="ltx_Math" alttext="x\notin S\backslash\partial S," display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>∉</mo><mrow><mi>S</mi><mo lspace="0.222em" rspace="0.055em">\</mo><mrow><mo>∂</mo><mi>S</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">x\notin S\backslash\partial S,</annotation></semantics></math> where <math id="A3.SS2.p4.m10" class="ltx_Math" alttext="\partial S" display="inline" intent=":literal"><semantics><mrow><mo>∂</mo><mi>S</mi></mrow><annotation encoding="application/x-tex">\partial S</annotation></semantics></math> is the boundary of <math id="A3.SS2.p4.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math>; iii) <math id="A3.SS2.p4.m12" class="ltx_Math" alttext="\zeta_{S}" display="inline" intent=":literal"><semantics><msub><mi>ζ</mi><mi>S</mi></msub><annotation encoding="application/x-tex">\zeta_{S}</annotation></semantics></math> is linear on the line that connects <math id="A3.SS2.p4.m13" class="ltx_Math" alttext="\hat{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{x}</annotation></semantics></math> and <math id="A3.SS2.p4.m14" class="ltx_Math" alttext="x" display="inline" intent=":literal"><semantics><mi>x</mi><annotation encoding="application/x-tex">x</annotation></semantics></math> for any <math id="A3.SS2.p4.m15" class="ltx_Math" alttext="x\in\partial S" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo rspace="0.111em">∈</mo><mrow><mo>∂</mo><mi>S</mi></mrow></mrow><annotation encoding="application/x-tex">x\in\partial S</annotation></semantics></math>.</span></p>
</div>
<div id="A3.SS2.p5" class="ltx_para">
<p id="A3.SS2.p5.1" class="ltx_p"><span id="A3.SS2.p5.1.1" class="ltx_text">Define</span></p>
<table id="A3.Ex61" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex61.m1" class="ltx_Math" alttext="{\Phi}\coloneq\left\{\phi:\phi\mathrm{~is~a~map~from~}\{0,(\delta+\delta^{*}),2(\delta+\delta^{*}),\ldots,(M-1)(\delta+\delta^{*})\}^{d_{0}}~\mathrm{to}~\{-1,1\}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mi mathvariant="normal">Φ</mi><mo>≔</mo><mrow><mo>{</mo><mi>ϕ</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ϕ</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>is</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>map</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>from</mi><mo lspace="0.330em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo lspace="0em" rspace="0em">​</mo><mi>to</mi><mo lspace="0.330em" rspace="0em">​</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><mo>−</mo><mn>1</mn></mrow><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">}</mo></mrow></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">{\Phi}\coloneq\left\{\phi:\phi\mathrm{~is~a~map~from~}\{0,(\delta+\delta^{*}),2(\delta+\delta^{*}),\ldots,(M-1)(\delta+\delta^{*})\}^{d_{0}}~\mathrm{to}~\{-1,1\}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p5.2" class="ltx_p"><span id="A3.SS2.p5.2.1" class="ltx_text">For each <math id="A3.SS2.p5.m1" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math>, we define</span></p>
<table id="A3.Ex62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex62.m1" class="ltx_Math" alttext="f_{\phi}(x)\coloneq\sum_{\theta\in\{0,1,\ldots,M-1\}^{d_{0}}}\phi(\theta)\zeta_{S_{\theta}}(x)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≔</mo><mrow><munder><mo movablelimits="false">∑</mo><mrow><mi>θ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow></munder><mrow><mrow><mi>ϕ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\phi}(x)\coloneq\sum_{\theta\in\{0,1,\ldots,M-1\}^{d_{0}}}\phi(\theta)\zeta_{S_{\theta}}(x).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p5.3" class="ltx_p"><span id="A3.SS2.p5.3.1" class="ltx_text">We can directly obtain that <math id="A3.SS2.p5.m2" class="ltx_Math" alttext="\{f_{\phi}:\phi\in\Phi\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{f_{\phi}:\phi\in\Phi\}</annotation></semantics></math> shatters <math id="A3.SS2.p5.m3" class="ltx_math_unparsed" alttext="M^{d_{0}}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})" display="inline" intent=":literal"><semantics><mrow><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">M^{d_{0}}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})</annotation></semantics></math> points based on the definition.</span></p>
</div>
<div id="A3.SS2.p6" class="ltx_para">
<p id="A3.SS2.p6.1" class="ltx_p"><span id="A3.SS2.p6.1.1" class="ltx_text">Furthermore, we demonstrate that <math id="A3.SS2.p6.m1" class="ltx_Math" alttext="\{f_{\phi}:\phi\in\Phi\}\subseteq\mathcal{H}^{\alpha}_{d_{0}}(\mathcal{X},1)" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><mo stretchy="false">}</mo></mrow><mo>⊆</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\{f_{\phi}:\phi\in\Phi\}\subseteq\mathcal{H}^{\alpha}_{d_{0}}(\mathcal{X},1)</annotation></semantics></math> with <math id="A3.SS2.p6.m2" class="ltx_Math" alttext="\alpha\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1]</annotation></semantics></math>. For any defined <math id="A3.SS2.p6.m3" class="ltx_Math" alttext="f_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">f_{\phi}</annotation></semantics></math> and <math id="A3.SS2.p6.m4" class="ltx_Math" alttext="x,y\in[0,1]^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><mo>∈</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">x,y\in[0,1]^{d_{0}}</annotation></semantics></math>, if <math id="A3.SS2.p6.m5" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math> are in a same cube of center <math id="A3.SS2.p6.m6" class="ltx_Math" alttext="\hat{x}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>x</mi><mo>^</mo></mover><annotation encoding="application/x-tex">\hat{x}</annotation></semantics></math> with <math id="A3.SS2.p6.m7" class="ltx_Math" alttext="\left\lVert x-y\right\rVert\leq l" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mo>≤</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">\left\lVert x-y\right\rVert\leq l</annotation></semantics></math>,</span></p>
<table id="A3.EGx12" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex63"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex63.m1" class="ltx_Math" alttext="\displaystyle\left|f_{\phi}(x)-f_{\phi}(y)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{\phi}(x)-f_{\phi}(y)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex63.m2" class="ltx_Math" alttext="\displaystyle=\left|\zeta_{S_{\theta}}(x)-\zeta_{S_{\theta}}(y)\right|=\left|\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert x-\hat{x}\right\rVert-\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert y-\hat{x}\right\rVert\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><msup><mi>l</mi><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mn>2</mn><mi>α</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover></mrow><mo>‖</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>l</mi><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mn>2</mn><mi>α</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo>‖</mo><mrow><mi>y</mi><mo>−</mo><mover accent="true"><mi>x</mi><mo>^</mo></mover></mrow><mo>‖</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\zeta_{S_{\theta}}(x)-\zeta_{S_{\theta}}(y)\right|=\left|\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert x-\hat{x}\right\rVert-\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert y-\hat{x}\right\rVert\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A3.Ex64"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex64.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert x-y\right\rVert^{1-\alpha+\alpha}\leq\frac{1}{2^{\alpha}}\left\lVert x-y\right\rVert^{\alpha}\leq\left\lVert x-y\right\rVert^{\alpha}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><msup><mi>l</mi><mrow><mi>α</mi><mo>−</mo><mn>1</mn></mrow></msup><msup><mn>2</mn><mi>α</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mrow><mrow><mn>1</mn><mo>−</mo><mi>α</mi></mrow><mo>+</mo><mi>α</mi></mrow></msup></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msup><mn>2</mn><mi>α</mi></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mi>α</mi></msup></mrow><mo>≤</mo><msup><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mi>α</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{l^{\alpha-1}}{2^{\alpha}}\left\lVert x-y\right\rVert^{1-\alpha+\alpha}\leq\frac{1}{2^{\alpha}}\left\lVert x-y\right\rVert^{\alpha}\leq\left\lVert x-y\right\rVert^{\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.2" class="ltx_p"><span id="A3.SS2.p6.2.1" class="ltx_text">If <math id="A3.SS2.p6.m8" class="ltx_Math" alttext="x,y" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>,</mo><mi>y</mi></mrow><annotation encoding="application/x-tex">x,y</annotation></semantics></math> are in different cubes with <math id="A3.SS2.p6.m9" class="ltx_Math" alttext="\left\lVert x-y\right\rVert\geq\frac{l}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mo>≥</mo><mfrac><mi>l</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\left\lVert x-y\right\rVert\geq\frac{l}{2}</annotation></semantics></math>,</span></p>
<table id="A3.EGx13" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A3.Ex65"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A3.Ex65.m1" class="ltx_Math" alttext="\displaystyle\left|f_{\phi}(x)-f_{\phi}(y)\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|f_{\phi}(x)-f_{\phi}(y)\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A3.Ex65.m2" class="ltx_Math" alttext="\displaystyle\leq\left|\zeta_{S_{\theta}}(x)\right|+\left|\zeta_{S_{\theta^{\prime}}}(y)\right|\leq\frac{1}{2}\cdot\left(\frac{l}{2}\right)^{\alpha}+\frac{1}{2}\cdot\left(\frac{l}{2}\right)^{\alpha}\leq\left\lVert x-y\right\rVert^{\alpha}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mo>|</mo><mrow><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>+</mo><mrow><mo>|</mo><mrow><msub><mi>ζ</mi><msub><mi>S</mi><msup><mi>θ</mi><mo>′</mo></msup></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>l</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mi>α</mi></msup></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mi>l</mi><mn>2</mn></mfrac></mstyle><mo>)</mo></mrow><mi>α</mi></msup></mrow></mrow><mo>≤</mo><msup><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><mi>y</mi></mrow><mo>‖</mo></mrow><mi>α</mi></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left|\zeta_{S_{\theta}}(x)\right|+\left|\zeta_{S_{\theta^{\prime}}}(y)\right|\leq\frac{1}{2}\cdot\left(\frac{l}{2}\right)^{\alpha}+\frac{1}{2}\cdot\left(\frac{l}{2}\right)^{\alpha}\leq\left\lVert x-y\right\rVert^{\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.3" class="ltx_p"><span id="A3.SS2.p6.3.1" class="ltx_text">For any accuracy <math id="A3.SS2.p6.m10" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> and each <math id="A3.SS2.p6.m11" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math>, based on Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>, there is a Transformer function <math id="A3.SS2.p6.m12" class="ltx_Math" alttext="g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}\in\mathcal{T}^{D}_{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow><annotation encoding="application/x-tex">g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}\in\mathcal{T}^{D}_{R}</annotation></semantics></math> with <math id="A3.SS2.p6.m13" class="ltx_Math" alttext="t_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">t_{\mathcal{T}}</annotation></semantics></math> operations and <math id="A3.SS2.p6.m14" class="ltx_Math" alttext="\omega_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">\omega_{\mathcal{T}}</annotation></semantics></math> properly adjusted parameters, which can approximate the <math id="A3.SS2.p6.m15" class="ltx_Math" alttext="f_{\phi}\in\mathcal{H}_{d_{0}}^{\alpha}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup></mrow><annotation encoding="application/x-tex">f_{\phi}\in\mathcal{H}_{d_{0}}^{\alpha}</annotation></semantics></math> such that</span></p>
<table id="A3.Ex66" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex66.m1" class="ltx_Math" alttext="\left\lVert g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}-f_{\phi}\right\rVert_{2}\leq\varepsilon." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo>−</mo><msub><mi>f</mi><mi>ϕ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}-f_{\phi}\right\rVert_{2}\leq\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.4" class="ltx_p"><span id="A3.SS2.p6.4.1" class="ltx_text">As <math id="A3.SS2.p6.m16" class="ltx_Math" alttext="g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><annotation encoding="application/x-tex">g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}</annotation></semantics></math> and <math id="A3.SS2.p6.m17" class="ltx_Math" alttext="f_{\phi}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>ϕ</mi></msub><annotation encoding="application/x-tex">f_{\phi}</annotation></semantics></math> are both bounded and defined on the compact domain <math id="A3.SS2.p6.m18" class="ltx_Math" alttext="[0,1]^{d_{0}}" display="inline" intent=":literal"><semantics><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">[0,1]^{d_{0}}</annotation></semantics></math>, the metrics <math id="A3.SS2.p6.m19" class="ltx_Math" alttext="L^{2}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mn>2</mn></msup><annotation encoding="application/x-tex">L^{2}</annotation></semantics></math> and <math id="A3.SS2.p6.m20" class="ltx_Math" alttext="L^{\infty}" display="inline" intent=":literal"><semantics><msup><mi>L</mi><mi mathvariant="normal">∞</mi></msup><annotation encoding="application/x-tex">L^{\infty}</annotation></semantics></math> are equal. Consequently, we can also have</span></p>
<table id="A3.Ex67" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex67.m1" class="ltx_Math" alttext="\left\lVert g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}-f_{\phi}\right\rVert_{\infty}\leq\varepsilon+\varepsilon/81." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo>−</mo><msub><mi>f</mi><mi>ϕ</mi></msub></mrow><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><mrow><mi>ε</mi><mo>+</mo><mrow><mi>ε</mi><mo>/</mo><mn>81</mn></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}-f_{\phi}\right\rVert_{\infty}\leq\varepsilon+\varepsilon/81.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.5" class="ltx_p"><span id="A3.SS2.p6.5.1" class="ltx_text">Therefore, we obtain for each <math id="A3.SS2.p6.m21" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math>,</span></p>
<table id="A3.Ex68" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex68.m1" class="ltx_Math" alttext="\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x)-f_{\phi}(x)\right|\leq\frac{82}{81}\varepsilon,\mathrm{~~~for~any~}x\in[0,1]^{d_{0}}\backslash\mathcal{X}_{\phi,\mathrm{zero}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><mn>82</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><mo rspace="1.157em">,</mo><mrow><mrow><mi>for</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>any</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∈</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.222em" stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>zero</mi></mrow></msub></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x)-f_{\phi}(x)\right|\leq\frac{82}{81}\varepsilon,\mathrm{~~~for~any~}x\in[0,1]^{d_{0}}\backslash\mathcal{X}_{\phi,\mathrm{zero}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.6" class="ltx_p"><span id="A3.SS2.p6.6.1" class="ltx_text">where <math id="A3.SS2.p6.m22" class="ltx_Math" alttext="\mathcal{X}_{\phi,\mathrm{zero}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>zero</mi></mrow></msub><annotation encoding="application/x-tex">\mathcal{X}_{\phi,\mathrm{zero}}</annotation></semantics></math> is a null set under the Lebesgue measure. And <math id="A3.SS2.p6.m23" class="ltx_Math" alttext="\mathcal{X}_{\mathrm{zero}}\coloneq\bigcup_{\phi}\mathcal{X}_{\phi,\mathrm{zero}}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>zero</mi></msub><mo rspace="0.111em">≔</mo><mrow><msub><mo>⋃</mo><mi>ϕ</mi></msub><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mrow><mi>ϕ</mi><mo>,</mo><mi>zero</mi></mrow></msub></mrow></mrow><annotation encoding="application/x-tex">\mathcal{X}_{\mathrm{zero}}\coloneq\bigcup_{\phi}\mathcal{X}_{\phi,\mathrm{zero}}</annotation></semantics></math> is also a null set. So</span></p>
<table id="A3.E50" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E50.m1" class="ltx_Math" alttext="\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x)-f_{\phi}(x)\right|\leq\frac{82}{81}\varepsilon,\mathrm{~~~for~any~}\phi\in\Phi\mathrm{~and~}x\in[0,1]^{d_{0}}\backslash\mathcal{X}_{\mathrm{zero}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mfrac><mn>82</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><mo rspace="1.157em">,</mo><mrow><mrow><mi>for</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>any</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>ϕ</mi></mrow><mo>∈</mo><mrow><mi mathvariant="normal">Φ</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>and</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>x</mi></mrow><mo>∈</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo rspace="0.222em" stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>zero</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x)-f_{\phi}(x)\right|\leq\frac{82}{81}\varepsilon,\mathrm{~~~for~any~}\phi\in\Phi\mathrm{~and~}x\in[0,1]^{d_{0}}\backslash\mathcal{X}_{\mathrm{zero}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(50)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p6.7" class="ltx_p"><span id="A3.SS2.p6.7.1" class="ltx_text">Now set <math id="A3.SS2.p6.m24" class="ltx_Math" alttext="\frac{1}{\delta+\delta^{*}}=(\frac{9\varepsilon}{2})^{-\frac{1}{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mrow><mn>9</mn><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mn>2</mn></mfrac><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mfrac><mn>1</mn><mi>α</mi></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\frac{1}{\delta+\delta^{*}}=(\frac{9\varepsilon}{2})^{-\frac{1}{\alpha}}</annotation></semantics></math>, and the side-length of <math id="A3.SS2.p6.m25" class="ltx_Math" alttext="S_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">S_{\theta}</annotation></semantics></math> is <math id="A3.SS2.p6.m26" class="ltx_Math" alttext="\frac{1}{M}=\frac{1}{\lfloor(9\varepsilon/2)^{-1/\alpha}\rfloor}" display="inline" intent=":literal"><semantics><mrow><mfrac><mn>1</mn><mi>M</mi></mfrac><mo>=</mo><mfrac><mn>1</mn><mrow><mo stretchy="false">⌊</mo><mo stretchy="false">(</mo><mn>9</mn><mi>ε</mi><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">⌋</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\frac{1}{M}=\frac{1}{\lfloor(9\varepsilon/2)^{-1/\alpha}\rfloor}</annotation></semantics></math>. We have for each <math id="A3.SS2.p6.m27" class="ltx_Math" alttext="\theta\in\{0,1,\ldots,M-1\}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\theta\in\{0,1,\ldots,M-1\}^{d_{0}}</annotation></semantics></math> and any <math id="A3.SS2.p6.m28" class="ltx_Math" alttext="x\in\frac{1}{10}S_{\theta}" display="inline" intent=":literal"><semantics><mrow><mi>x</mi><mo>∈</mo><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>θ</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x\in\frac{1}{10}S_{\theta}</annotation></semantics></math> (the closed cube shares <math id="A3.SS2.p6.m29" class="ltx_Math" alttext="\frac{1}{10}" display="inline" intent=":literal"><semantics><mfrac><mn>1</mn><mn>10</mn></mfrac><annotation encoding="application/x-tex">\frac{1}{10}</annotation></semantics></math> of side-length and same center <math id="A3.SS2.p6.m30" class="ltx_Math" alttext="x_{S_{\theta}}" display="inline" intent=":literal"><semantics><msub><mi>x</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><annotation encoding="application/x-tex">x_{S_{\theta}}</annotation></semantics></math> of <math id="A3.SS2.p6.m31" class="ltx_Math" alttext="S_{\theta}" display="inline" intent=":literal"><semantics><msub><mi>S</mi><mi>θ</mi></msub><annotation encoding="application/x-tex">S_{\theta}</annotation></semantics></math>),</span></p>
<table id="A3.E51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E51.m1" class="ltx_Math" alttext="\left|f_{\phi}(x)\right|=\left|\zeta_{S_{\theta}}(x)\right|\geq\frac{9}{10}\left|\zeta_{S_{\theta}}(x_{S_{\theta}})\right|=\frac{9}{10}\cdot\frac{1}{2}\frac{1}{(2M)^{\alpha}}\geq\frac{81}{80}\varepsilon." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mrow><mfrac><mn>9</mn><mn>10</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><msub><mi>ζ</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><msub><mi>S</mi><mi>θ</mi></msub></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow></mrow><mo>=</mo><mrow><mrow><mfrac><mn>9</mn><mn>10</mn></mfrac><mo lspace="0.222em" rspace="0.222em">⋅</mo><mfrac><mn>1</mn><mn>2</mn></mfrac></mrow><mo lspace="0em" rspace="0em">​</mo><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow><mi>α</mi></msup></mfrac></mrow><mo>≥</mo><mrow><mfrac><mn>81</mn><mn>80</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|f_{\phi}(x)\right|=\left|\zeta_{S_{\theta}}(x)\right|\geq\frac{9}{10}\left|\zeta_{S_{\theta}}(x_{S_{\theta}})\right|=\frac{9}{10}\cdot\frac{1}{2}\frac{1}{(2M)^{\alpha}}\geq\frac{81}{80}\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(51)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p6.8" class="ltx_p"><span id="A3.SS2.p6.8.1" class="ltx_text">Since <math id="A3.SS2.p6.m32" class="ltx_Math" alttext="(\frac{1}{10}S_{\theta})\backslash\mathcal{X}_{\mathrm{zero}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>θ</mi></msub></mrow><mo rspace="0.222em" stretchy="false">)</mo></mrow><mo rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>zero</mi></msub></mrow><annotation encoding="application/x-tex">(\frac{1}{10}S_{\theta})\backslash\mathcal{X}_{\mathrm{zero}}</annotation></semantics></math> is not empty, for each <math id="A3.SS2.p6.m33" class="ltx_Math" alttext="\theta\in\{0,1,\ldots,M-1\}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\theta\in\{0,1,\ldots,M-1\}^{d_{0}}</annotation></semantics></math> and each <math id="A3.SS2.p6.m34" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math>, with (<a href="#A3.E50" title="Equation 50 ‣ Proof of Theorem . ‣ C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">50</span></a>) and (<a href="#A3.E51" title="Equation 51 ‣ Proof of Theorem . ‣ C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">51</span></a>) there exists a point <math id="A3.SS2.p6.m35" class="ltx_Math" alttext="x_{\theta}\in(\frac{1}{10}S_{\theta})\backslash\mathcal{X}_{\mathrm{zero}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mi>θ</mi></msub><mo>∈</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mfrac><mn>1</mn><mn>10</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>S</mi><mi>θ</mi></msub></mrow><mo rspace="0.222em" stretchy="false">)</mo></mrow><mo rspace="0.222em">\</mo><msub><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>zero</mi></msub></mrow></mrow><annotation encoding="application/x-tex">x_{\theta}\in(\frac{1}{10}S_{\theta})\backslash\mathcal{X}_{\mathrm{zero}}</annotation></semantics></math> such that</span></p>
<table id="A3.E52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E52.m1" class="ltx_Math" alttext="\left|f_{\phi}(x_{\theta})\right|\geq\frac{81}{80}\varepsilon&gt;\frac{82}{81}\varepsilon\geq\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})-f_{\phi}(x_{\theta})\right|." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mrow><mfrac><mn>81</mn><mn>80</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mo>&gt;</mo><mrow><mfrac><mn>82</mn><mn>81</mn></mfrac><mo lspace="0em" rspace="0em">​</mo><mi>ε</mi></mrow><mo>≥</mo><mrow><mo>|</mo><mrow><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|f_{\phi}(x_{\theta})\right|\geq\frac{81}{80}\varepsilon&gt;\frac{82}{81}\varepsilon\geq\left|g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})-f_{\phi}(x_{\theta})\right|.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(52)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p6.9" class="ltx_p"><span id="A3.SS2.p6.9.1" class="ltx_text">(<a href="#A3.E52" title="Equation 52 ‣ Proof of Theorem . ‣ C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">52</span></a>) means <math id="A3.SS2.p6.m36" class="ltx_Math" alttext="g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})</annotation></semantics></math> and <math id="A3.SS2.p6.m37" class="ltx_Math" alttext="f_{\phi}(x_{\theta})" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>ϕ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\phi}(x_{\theta})</annotation></semantics></math> have the same sign for each <math id="A3.SS2.p6.m38" class="ltx_Math" alttext="\theta\in\{0,1,\ldots,M-1\}^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mi>θ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">\theta\in\{0,1,\ldots,M-1\}^{d_{0}}</annotation></semantics></math> and <math id="A3.SS2.p6.m39" class="ltx_Math" alttext="\phi\in\Phi" display="inline" intent=":literal"><semantics><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><annotation encoding="application/x-tex">\phi\in\Phi</annotation></semantics></math>. This demonstrates <math id="A3.SS2.p6.m40" class="ltx_Math" alttext="\{g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})\mid\phi\in\Phi\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><mrow><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})\mid\phi\in\Phi\}</annotation></semantics></math> shatters <math id="A3.SS2.p6.m41" class="ltx_Math" alttext="\{x_{\theta}\mid\theta\in\{0,1,\ldots,M-1\}^{d_{0}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>x</mi><mi>θ</mi></msub><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>θ</mi><mo>∈</mo><msup><mrow><mo stretchy="false">{</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><mo stretchy="false">}</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{x_{\theta}\mid\theta\in\{0,1,\ldots,M-1\}^{d_{0}}\}</annotation></semantics></math>. Consequently,</span></p>
<table id="A3.Ex69" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.Ex69.m1" class="ltx_math_unparsed" alttext="\mathrm{VCdim}(\mathcal{T}_{R}^{D})\geq\mathrm{VCdim}(\{g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})\mid\phi\in\Phi\})\geq M^{d_{0}}=\lfloor(9\varepsilon/2)^{-1/\alpha}\rfloor^{d_{0}}\gtrsim\varepsilon^{-d_{0}/\alpha}." display="block" intent=":literal"><semantics><mrow><mi>VCdim</mi><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>VCdim</mi><mrow><mo stretchy="false">(</mo><mrow><mo stretchy="false">{</mo><msub><mi>g</mi><mrow><mi>ϕ</mi><mo>,</mo><msub><mi>t</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>,</mo><msub><mi>ω</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>θ</mi></msub><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>ϕ</mi><mo>∈</mo><mi mathvariant="normal">Φ</mi><mo stretchy="false">}</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≥</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo>=</mo><msup><mrow><mo stretchy="false">⌊</mo><msup><mrow><mo stretchy="false">(</mo><mn>9</mn><mi>ε</mi><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">⌋</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>≳</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{VCdim}(\mathcal{T}_{R}^{D})\geq\mathrm{VCdim}(\{g_{\phi,t_{\mathcal{T}},\omega_{\mathcal{T}}}(x_{\theta})\mid\phi\in\Phi\})\geq M^{d_{0}}=\lfloor(9\varepsilon/2)^{-1/\alpha}\rfloor^{d_{0}}\gtrsim\varepsilon^{-d_{0}/\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A3.SS2.p6.10" class="ltx_p"><span id="A3.SS2.p6.10.1" class="ltx_text">With (<a href="#A3.E49" title="Equation 49 ‣ Proof of Theorem . ‣ C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">49</span></a>), there exists</span></p>
<table id="A3.E53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A3.E53.m1" class="ltx_math_unparsed" alttext="t^{2}\omega(\omega+19\log_{2}(9\omega))\geq\mathrm{VCdim}(\mathcal{T}_{R}^{D})\gtrsim\varepsilon^{-d_{0}/\alpha}." display="block" intent=":literal"><semantics><mrow><msup><mi>t</mi><mn>2</mn></msup><mi>ω</mi><mrow><mo stretchy="false">(</mo><mi>ω</mi><mo>+</mo><mn>19</mn><msub><mi>log</mi><mn>2</mn></msub><mrow><mo stretchy="false">(</mo><mn>9</mn><mi>ω</mi><mo stretchy="false">)</mo></mrow><mo stretchy="false">)</mo></mrow><mo>≥</mo><mi>VCdim</mi><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow><mo>≳</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">t^{2}\omega(\omega+19\log_{2}(9\omega))\geq\mathrm{VCdim}(\mathcal{T}_{R}^{D})\gtrsim\varepsilon^{-d_{0}/\alpha}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(53)</span></td></tr></tbody>
</table>
<p id="A3.SS2.p6.11" class="ltx_p"><span id="A3.SS2.p6.11.1" class="ltx_text">Further with (<a href="#A3.E45" title="Equation 45 ‣ C.1 Total Numbers of Operations and Parameters ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), the main result of Theorem <a href="#S5.Thmtheorem3" title="Theorem 5.3 (Lower Bound of Approximation Error). ‣ 5 Approximation Lower Bound with VC-dimension ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> is derived.
∎</span></p>
</div>
</div>
</section>
</section>
<section id="A4" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix D </span>Details of Applications in the Regression Task</h2>

<section id="A4.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Roadmap.</h5>

<div id="A4.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS0.SSS0.Px1.p1.1" class="ltx_p">This section details the application of our theory to the general regression task.</p>
<ul id="A4.I1" class="ltx_itemize">
<li id="A4.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i1.p1" class="ltx_para">
<p id="A4.I1.i1.p1.1" class="ltx_p"><span id="A4.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Background</span> (Section <a href="#A4.SS1" title="D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>): Provides the basic knowledge of the error decomposition of excess risk.</p>
</div></li>
<li id="A4.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i2.p1" class="ltx_para">
<p id="A4.I1.i2.p1.1" class="ltx_p"><span id="A4.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Statistical Analysis</span> (Section <a href="#A4.SS2" title="D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>): Establishes the upper bound of the statistical error.</p>
</div></li>
<li id="A4.I1.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A4.I1.i3.p1" class="ltx_para">
<p id="A4.I1.i3.p1.1" class="ltx_p"><span id="A4.I1.i3.p1.1.1" class="ltx_text ltx_font_bold">Main Result</span> (Section <a href="#A4.SS3" title="D.3 Convergence Rate of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.3</span></a>): Combines above results and derives the final convergence rate of the excess risk.</p>
</div></li>
</ul>
</div>
</section>
<section id="A4.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.1 </span>Error Decomposition of Excess Risk</h3>

<figure id="A4.F2" class="ltx_figure"><object type="image/svg+xml" data="2605.07463v1/error-decomposition.svg" id="A4.F2.g1" class="ltx_graphics ltx_centering ltx_img_landscape" style="aspect-ratio:262/157;" width="262" height="157"></object>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A4.F2.3" class="ltx_text" style="font-size:90%;">Figure 2</span>: </span><span id="A4.F2.4" class="ltx_text" style="font-size:90%;">Diagram: Error decomposition of the excess risk.</span></figcaption>
</figure>
<div id="A4.SS1.p1" class="ltx_para">
<p id="A4.SS1.p1.1" class="ltx_p">Via the statistical learning, the total error between any obtainable estimator <math id="A4.SS1.p1.m1" class="ltx_Math" alttext="f_{s(\tau)}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">f_{s(\tau)}</annotation></semantics></math> and the target function <math id="A4.SS1.p1.m2" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> can be measured by the expectation of the excess risk,. The error can be decompose into three parts.</p>
</div>
<div id="A4.Thmtheorem1" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem1.2" class="ltx_text ltx_font_bold">Lemma D.1</span></span><span id="A4.Thmtheorem1.3" class="ltx_text ltx_font_bold"> </span>(Error Decomposition of Excess Risk)<span id="A4.Thmtheorem1.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem1.p1" class="ltx_para">
<p id="A4.Thmtheorem1.p1.1" class="ltx_p"><span id="A4.Thmtheorem1.p1.1.1" class="ltx_text ltx_font_italic">Given an i.i.d sample set <math id="A4.Thmtheorem1.p1.m1" class="ltx_math_unparsed" alttext="\mathbb{D}=\{z^{(i)}=(x^{(i)},y^{(i)})\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo>=</mo><msubsup><mrow><mo stretchy="false">{</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathbb{D}=\{z^{(i)}=(x^{(i)},y^{(i)})\}_{i=1}^{N}</annotation></semantics></math>, the target function space <math id="A4.Thmtheorem1.p1.m2" class="ltx_Math" alttext="\mathcal{H}_{d_{0},1}^{\alpha}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mn>1</mn></mrow><mi>α</mi></msubsup><annotation encoding="application/x-tex">\mathcal{H}_{d_{0},1}^{\alpha}</annotation></semantics></math> and the model space <math id="A4.Thmtheorem1.p1.m3" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math>, for the actual estimator <math id="A4.Thmtheorem1.p1.m4" class="ltx_Math" alttext="f_{s(\tau)}\in\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f_{s(\tau)}\in\mathcal{F}</annotation></semantics></math> obtained via minimizing the empirical loss <math id="A4.Thmtheorem1.p1.m5" class="ltx_Math" alttext="\widehat{\mathcal{L}}(f)=\frac{1}{N}\sum_{i=1}^{N}\left(f(x^{(i)}-y^{(i)})\right)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><msup><mrow><mo>(</mo><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>−</mo><msup><mi>y</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><mn>2</mn></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\widehat{\mathcal{L}}(f)=\frac{1}{N}\sum_{i=1}^{N}\left(f(x^{(i)}-y^{(i)})\right)^{2}</annotation></semantics></math> by a solver <math id="A4.Thmtheorem1.p1.m6" class="ltx_Math" alttext="s(\tau)" display="inline" intent=":literal"><semantics><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">s(\tau)</annotation></semantics></math>, the excess risk has the following decomposition</span></p>
<table id="A4.E54" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E54.m1" class="ltx_Math" alttext="\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})\right]\leq\mathcal{E}_{\mathrm{sta}}+2\mathcal{E}_{\mathrm{app}}^{2}+2\tau," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi><mn>2</mn></msubsup></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})\right]\leq\mathcal{E}_{\mathrm{sta}}+2\mathcal{E}_{\mathrm{app}}^{2}+2\tau,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(54)</span></td></tr></tbody>
</table>
<p id="A4.Thmtheorem1.p1.2" class="ltx_p"><span id="A4.Thmtheorem1.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A4.Thmtheorem1.p1.m7" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> is the population risk, <math id="A4.Thmtheorem1.p1.m8" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{app}}=\sup_{p\in\mathcal{H}_{d_{0},1}^{\alpha}}\!\!\inf_{f\in\mathcal{T}_{R}^{D}}\left\lVert f-p\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi></msub><mo rspace="0.1389em">=</mo><mrow><msub><mo lspace="0.1389em" rspace="0.0835em">sup</mo><mrow><mi>p</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mn>1</mn></mrow><mi>α</mi></msubsup></mrow></msub><mrow><msub><mo lspace="0.0835em" rspace="0em">inf</mo><mrow><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow></msub><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>p</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{app}}=\sup_{p\in\mathcal{H}_{d_{0},1}^{\alpha}}\!\!\inf_{f\in\mathcal{T}_{R}^{D}}\left\lVert f-p\right\rVert_{2}</annotation></semantics></math> is the approximation error, <math id="A4.Thmtheorem1.p1.m9" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}\coloneq\mathbb{E_{D}}[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>≔</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}\coloneq\mathbb{E_{D}}[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})]</annotation></semantics></math> is the statistical error, and the optimization error <math id="A4.Thmtheorem1.p1.m10" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.Thmtheorem2" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem2.2" class="ltx_text ltx_font_bold">Remark D.2</span></span><span id="A4.Thmtheorem2.3" class="ltx_text ltx_font_bold"> </span>(<span id="A4.Thmtheorem2.4" class="ltx_text ltx_font_bold">Roles of Each Error</span>)<span id="A4.Thmtheorem2.5" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem2.p1" class="ltx_para">
<p id="A4.Thmtheorem2.p1.1" class="ltx_p">Before the proof of Lemma <a href="#A4.Thmtheorem1" title="Lemma D.1 (Error Decomposition of Excess Risk). ‣ D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a>, we discuss the intuitions behind this decomposition. For an intuitive grasp of the error decomposition, consider the illustration in Figure <a href="#A4.F2" title="Figure 2 ‣ D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">2</span></a>.</p>
<ol id="A4.I2" class="ltx_enumerate">
<li id="A4.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A4.I2.i1.p1" class="ltx_para">
<p id="A4.I2.i1.p1.1" class="ltx_p"><span id="A4.I2.i1.p1.1.1" class="ltx_text ltx_align_left ltx_inline-block" style="width:21.3pt;"><math id="A4.I2.i1.p1.m1" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{app}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{app}}</annotation></semantics></math>:</span> The approximation error serves as a measure of the bias induced by the choice of the model architecture. Even with infinite training samples (i.e., the oracle setting), the model cannot further reduce the total error below the approximation error, thus characterizing the fundamental limit of the model’s expressivity.</p>
</div></li>
<li id="A4.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A4.I2.i2.p1" class="ltx_para">
<p id="A4.I2.i2.p1.1" class="ltx_p"><span id="A4.I2.i2.p1.1.1" class="ltx_text ltx_align_left ltx_inline-block" style="width:21.3pt;"><math id="A4.I2.i2.p1.m1" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}</annotation></semantics></math>:</span> The statistical error serves as a measure of the variance induced by the finiteness of training data in the real-word settings. This error can be mitigated by increasing sample size, thus characterizing the generalization capability of the model.</p>
</div></li>
<li id="A4.I2.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A4.I2.i3.p1" class="ltx_para">
<p id="A4.I2.i3.p1.1" class="ltx_p"><span id="A4.I2.i3.p1.1.1" class="ltx_text ltx_align_left ltx_inline-block" style="width:21.3pt;"><math id="A4.I2.i3.p1.m1" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math>:</span> The optimization error serves as a measure of the discrepancy between the numerical solution returned by the training algorithm (or solver) and the best empirical solution. It characterizes the computational difficulty of finding the best model parameter sets within the hypothesis space.</p>
</div></li>
</ol>
</div>
</div>
<div id="A4.SS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A4.SS1.2.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#A4.Thmtheorem1" title="Lemma D.1 (Error Decomposition of Excess Risk). ‣ D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.1</span></a></span>.</h6>
<div id="A4.SS1.p2" class="ltx_para">
<p id="A4.SS1.p2.2" class="ltx_p"><span id="A4.SS1.p2.2.1" class="ltx_text">Consider the expectation of the excess risk</span></p>
<table id="A4.E55" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E55X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E55X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(55)</span></td></tr>
<tr id="A4.E55Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]+2\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]+2\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E55Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E55Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathcal{E}_{\rm sta}+2\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathcal{E}_{\rm sta}+2\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p2.3" class="ltx_p"><span id="A4.SS1.p2.3.1" class="ltx_text">For the second part, define the best approximator</span></p>
<table id="A4.E56" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E56.m1" class="ltx_Math" alttext="f_{\rm app}\in\arg\min\nolimits_{f\in\mathcal{T}_{R}^{D}}\mathcal{L}(f)," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi>app</mi></msub><mo>∈</mo><mrow><mi>arg</mi><mo lspace="0.167em">⁡</mo><mrow><msub><mi>min</mi><mrow><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow></msub><mo lspace="0.167em">⁡</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{\rm app}\in\arg\min\nolimits_{f\in\mathcal{T}_{R}^{D}}\mathcal{L}(f),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(56)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.4" class="ltx_p"><span id="A4.SS1.p2.4.1" class="ltx_text">and we have</span></p>
<table id="A4.EGx14" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex70"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex70.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{app}}^{2}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi><mn>2</mn></msubsup><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{app}}^{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex70.m2" class="ltx_Math" alttext="\displaystyle=\underset{p\in\mathcal{H}_{d_{0},1}^{\alpha}}{\sup}\underset{f\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-p\right\rVert_{2}^{2}\geq\underset{f\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-f^{*}\right\rVert_{2}^{2}={\mathcal{L}}({f}_{\rm app})-{\mathcal{L}}(f^{*})" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo rspace="0.1389em">=</mo><mrow><munder accentunder="true"><mo lspace="0.1389em" movablelimits="false">sup</mo><mrow><mi mathsize="0.700em">p</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℋ</mi><mrow><msub><mi mathsize="0.710em">d</mi><mn>0</mn></msub><mo mathsize="0.710em">,</mo><mn mathsize="0.710em">1</mn></mrow><mi mathsize="0.710em">α</mi></msubsup></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mo movablelimits="false">inf</mo><mrow><mi mathsize="0.700em">f</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">R</mi><mi mathsize="0.710em">D</mi></msubsup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>p</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo rspace="0.1389em">≥</mo><mrow><munder accentunder="true"><mo lspace="0.1389em" movablelimits="false">inf</mo><mrow><mi mathsize="0.700em">f</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">R</mi><mi mathsize="0.710em">D</mi></msubsup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>=</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>app</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\underset{p\in\mathcal{H}_{d_{0},1}^{\alpha}}{\sup}\underset{f\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-p\right\rVert_{2}^{2}\geq\underset{f\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-f^{*}\right\rVert_{2}^{2}={\mathcal{L}}({f}_{\rm app})-{\mathcal{L}}(f^{*})</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex71"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex71.m1" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[\widehat{\mathcal{L}}({f}_{\rm app})-{\mathcal{L}}(f^{*})\right]\geq\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(\hat{f})-{\mathcal{L}}(f^{*})\right]\geq\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]-\tau," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mi>app</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>^</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mi>τ</mi></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[\widehat{\mathcal{L}}({f}_{\rm app})-{\mathcal{L}}(f^{*})\right]\geq\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(\hat{f})-{\mathcal{L}}(f^{*})\right]\geq\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]-\tau,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS1.p2.5" class="ltx_p"><span id="A4.SS1.p2.5.1" class="ltx_text">where the third equation comes from the independence of <math id="A4.SS1.p2.m1" class="ltx_Math" alttext="{f}_{\rm app}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi>app</mi></msub><annotation encoding="application/x-tex">{f}_{\rm app}</annotation></semantics></math> on the samples. Equivalently,</span></p>
<table id="A4.E57" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E57.m1" class="ltx_Math" alttext="\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]\leq\mathcal{E}_{\rm app}^{2}+\tau." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi><mn>2</mn></msubsup><mo>+</mo><mi>τ</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{E_{D}}\left[\widehat{\mathcal{L}}(f_{s(\tau)})-{\mathcal{L}}(f^{*})\right]\leq\mathcal{E}_{\rm app}^{2}+\tau.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(57)</span></td></tr></tbody>
</table>
<p id="A4.SS1.p2.6" class="ltx_p"><span id="A4.SS1.p2.6.1" class="ltx_text">Combine (<a href="#A4.E55" title="Equation 55 ‣ Proof of Lemma . ‣ D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">55</span></a>) and (<a href="#A4.E57" title="Equation 57 ‣ Proof of Lemma . ‣ D.1 Error Decomposition of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">57</span></a>), we finish the proof.
∎</span></p>
</div>
</div>
</section>
<section id="A4.SS2" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.2 </span>Upper Bound of the Statistical Error</h3>

<div id="A4.SS2.p1" class="ltx_para">
<p id="A4.SS2.p1.1" class="ltx_p">To bound a possible infinite function class <math id="A4.SS2.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>, we first introduce the covering number.</p>
</div>
<div id="A4.Thmtheorem3" class="ltx_theorem ltx_theorem_definition">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem3.2" class="ltx_text ltx_font_bold">Definition D.3</span></span><span id="A4.Thmtheorem3.3" class="ltx_text ltx_font_bold"> </span>(Covering Number)<span id="A4.Thmtheorem3.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem3.p1" class="ltx_para">
<p id="A4.Thmtheorem3.p1.1" class="ltx_p">Given a metric space <math id="A4.Thmtheorem3.p1.m1" class="ltx_Math" alttext="(\mathcal{X},\rho)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\mathcal{X},\rho)</annotation></semantics></math> and a subset <math id="A4.Thmtheorem3.p1.m2" class="ltx_Math" alttext="S\subseteq\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo>⊆</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">S\subseteq\mathcal{X}</annotation></semantics></math>. Let the radius <math id="A4.Thmtheorem3.p1.m3" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math>, a set <math id="A4.Thmtheorem3.p1.m4" class="ltx_Math" alttext="T\subseteq\mathcal{X}" display="inline" intent=":literal"><semantics><mrow><mi>T</mi><mo>⊆</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow><annotation encoding="application/x-tex">T\subseteq\mathcal{X}</annotation></semantics></math> is called a <math id="A4.Thmtheorem3.p1.m5" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-covering of <math id="A4.Thmtheorem3.p1.m6" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> if <math id="A4.Thmtheorem3.p1.m7" class="ltx_Math" alttext="S\subseteq\bigcup_{y\in T}B_{\rho}(y,\mu)" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo rspace="0.111em">⊆</mo><mrow><msub><mo>⋃</mo><mrow><mi>y</mi><mo>∈</mo><mi>T</mi></mrow></msub><mrow><msub><mi>B</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">S\subseteq\bigcup_{y\in T}B_{\rho}(y,\mu)</annotation></semantics></math>, where <math id="A4.Thmtheorem3.p1.m8" class="ltx_Math" alttext="B_{\rho}(y,\mu)" display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi>ρ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>μ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">B_{\rho}(y,\mu)</annotation></semantics></math> is the ball centered at <math id="A4.Thmtheorem3.p1.m9" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math>. The <math id="A4.Thmtheorem3.p1.m10" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math>-covering number of <math id="A4.Thmtheorem3.p1.m11" class="ltx_Math" alttext="S" display="inline" intent=":literal"><semantics><mi>S</mi><annotation encoding="application/x-tex">S</annotation></semantics></math> is denoted by</p>
<table id="A4.Ex72" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex72.m1" class="ltx_Math" alttext="\mathcal{N}(\mu,S,\rho)=\min\left\{\left|T\right|~\mid~T~\mathrm{is~a~\mu}\text{-}\mathrm{covering~of~}S\right\}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi>S</mi><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>min</mi><mo>⁡</mo><mrow><mo>{</mo><mrow><mo>|</mo><mi>T</mi><mo rspace="0.052em">|</mo></mrow><mo fence="true" rspace="0.330em">∣</mo><mrow><mi>T</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>is</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>a</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mtext>-</mtext><mo lspace="0em" rspace="0em">​</mo><mi>covering</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>of</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>S</mi></mrow><mo>}</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{N}(\mu,S,\rho)=\min\left\{\left|T\right|~\mid~T~\mathrm{is~a~\mu}\text{-}\mathrm{covering~of~}S\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.Thmtheorem3.p1.2" class="ltx_p">For a function class <math id="A4.Thmtheorem3.p1.m12" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> from <math id="A4.Thmtheorem3.p1.m13" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> to <math id="A4.Thmtheorem3.p1.m14" class="ltx_Math" alttext="\mathbb{R}" display="inline" intent=":literal"><semantics><mi>ℝ</mi><annotation encoding="application/x-tex">\mathbb{R}</annotation></semantics></math>. Given a sample sequence <math id="A4.Thmtheorem3.p1.m15" class="ltx_math_unparsed" alttext="x_{1:n}=(x^{(1)},x^{(2)},\ldots,x^{(n)})" display="inline" intent=":literal"><semantics><mrow><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>=</mo><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">x_{1:n}=(x^{(1)},x^{(2)},\ldots,x^{(n)})</annotation></semantics></math> for <math id="A4.Thmtheorem3.p1.m16" class="ltx_Math" alttext="n\in\mathbb{N}" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>∈</mo><mi>ℕ</mi></mrow><annotation encoding="application/x-tex">n\in\mathbb{N}</annotation></semantics></math>, let <math id="A4.Thmtheorem3.p1.m17" class="ltx_math_unparsed" alttext="\mathcal{F}(x_{1:n})=\left\{(f(x^{(1)}),f(x^{(2)}),\ldots,f(x^{(n)})~\mid~f\in\mathcal{F}\right\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><mrow><mo>{</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>f</mi><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.052em" stretchy="false">)</mo></mrow><mo rspace="0.497em">∣</mo><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>}</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{F}(x_{1:n})=\left\{(f(x^{(1)}),f(x^{(2)}),\ldots,f(x^{(n)})~\mid~f\in\mathcal{F}\right\}</annotation></semantics></math>. The uniform covering number of <math id="A4.Thmtheorem3.p1.m18" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is denoted by</p>
<table id="A4.Ex73" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex73.m1" class="ltx_math_unparsed" alttext="\mathcal{N}_{\rho}(\mu,\mathcal{F},n)=\max\left\{\mathcal{N}(\mu,\mathcal{F}(x_{1:n}),\rho)~\mid~x_{1:n}\in\mathcal{X}^{n}\right\}." display="block" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi>ρ</mi></msub><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><mi>max</mi><mrow><mo>{</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mi>ρ</mi><mo rspace="0.052em" stretchy="false">)</mo></mrow><mo rspace="0.497em">∣</mo><msub><mi>x</mi><mrow><mn>1</mn><mo lspace="0.278em" rspace="0.278em">:</mo><mi>n</mi></mrow></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒳</mi><mi>n</mi></msup><mo>}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{N}_{\rho}(\mu,\mathcal{F},n)=\max\left\{\mathcal{N}(\mu,\mathcal{F}(x_{1:n}),\rho)~\mid~x_{1:n}\in\mathcal{X}^{n}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS2.p2" class="ltx_para">
<p id="A4.SS2.p2.1" class="ltx_p">We prove Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1 (Upper Bound of Statistical Error). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a> based on the following two lemmas.</p>
</div>
<div id="A4.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma D.4</span></span><span id="A4.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Bounding Statistical Error via Covering Numbers)<span id="A4.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem4.p1" class="ltx_para">
<p id="A4.Thmtheorem4.p1.1" class="ltx_p"><span id="A4.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A4.Thmtheorem4.p1.m1" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> be the number of samples. Suppose that <math id="A4.Thmtheorem4.p1.m2" class="ltx_Math" alttext="\left\lVert f\right\rVert\leq B" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><mo>≤</mo><mi>B</mi></mrow><annotation encoding="application/x-tex">\left\lVert f\right\rVert\leq B</annotation></semantics></math> for any <math id="A4.Thmtheorem4.p1.m3" class="ltx_Math" alttext="f\in\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f\in\mathcal{F}</annotation></semantics></math>, the loss function <math id="A4.Thmtheorem4.p1.m4" class="ltx_Math" alttext="l(f,z)" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l(f,z)</annotation></semantics></math> is a <math id="A4.Thmtheorem4.p1.m5" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>-Lipschitz function on <math id="A4.Thmtheorem4.p1.m6" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math>, and <math id="A4.Thmtheorem4.p1.m7" class="ltx_Math" alttext="\mathcal{L}(f)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(f)</annotation></semantics></math> is locally strong convex with parameter
<math id="A4.Thmtheorem4.p1.m8" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math> around the target function <math id="A4.Thmtheorem4.p1.m9" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math>, i.e., <math id="A4.Thmtheorem4.p1.m10" class="ltx_Math" alttext="\mathcal{L}(f)-\mathcal{L}(f^{*})\geq c\left\lVert f-f^{*}\right\rVert^{2}_{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>≥</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(f)-\mathcal{L}(f^{*})\geq c\left\lVert f-f^{*}\right\rVert^{2}_{2}</annotation></semantics></math>. We have</span></p>
<table id="A4.E58" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E58.m1" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}\leq\frac{(8\lambda^{2}/c+16\lambda B)(\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)+1)}{N}+3\lambda\mu," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>≤</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>N</mi></mfrac><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}\leq\frac{(8\lambda^{2}/c+16\lambda B)(\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)+1)}{N}+3\lambda\mu,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(58)</span></td></tr></tbody>
</table>
<p id="A4.Thmtheorem4.p1.2" class="ltx_p"><span id="A4.Thmtheorem4.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A4.Thmtheorem4.p1.m11" class="ltx_Math" alttext="\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\coloneq\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\coloneq\mathcal{N}</annotation></semantics></math> is the covering number of <math id="A4.Thmtheorem4.p1.m12" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math> with <math id="A4.Thmtheorem4.p1.m13" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> samples and the covering <math id="A4.Thmtheorem4.p1.m14" class="ltx_math_unparsed" alttext="\mathcal{C}=\left\{f_{1},\ldots,f_{\mathcal{N}}\mid f\in\mathcal{T}_{R}^{D}\right\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒞</mi><mo>=</mo><mrow><mo>{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi></msub><mo lspace="0em" rspace="0.167em">∣</mo><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{C}=\left\{f_{1},\ldots,f_{\mathcal{N}}\mid f\in\mathcal{T}_{R}^{D}\right\}</annotation></semantics></math> under radius <math id="A4.Thmtheorem4.p1.m15" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> and metric <math id="A4.Thmtheorem4.p1.m16" class="ltx_Math" alttext="\left\lVert\cdot\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mo lspace="0em" rspace="0em">⋅</mo><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><annotation encoding="application/x-tex">\left\lVert\cdot\right\rVert_{\infty}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A4.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma D.5</span></span><span id="A4.Thmtheorem5.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem5.p1" class="ltx_para">
<p id="A4.Thmtheorem5.p1.1" class="ltx_p"><span id="A4.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A4.Thmtheorem5.p1.m1" class="ltx_Math" alttext="\mu&gt;0," display="inline" intent=":literal"><semantics><mrow><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mu&gt;0,</annotation></semantics></math> and <math id="A4.Thmtheorem5.p1.m2" class="ltx_Math" alttext="N\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{+}</annotation></semantics></math>. For the designed Transformer function class <math id="A4.Thmtheorem5.p1.m3" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math>, the covering number can be bounded, i.e., <math id="A4.Thmtheorem5.p1.m4" class="ltx_Math" alttext="\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\lesssim D^{4}\log({eKND^{-4}}/{\mu})," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><mrow><msup><mi>D</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>/</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\lesssim D^{4}\log({eKND^{-4}}/{\mu}),</annotation></semantics></math></span></p>
</div>
</div>
<div id="A4.SS2.p3" class="ltx_para ltx_noindent">
<p id="A4.SS2.p3.1" class="ltx_p"><span id="A4.SS2.p3.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1 (Upper Bound of Statistical Error). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a></span> (Upper Bound of Statistical Error; Restatement)<span id="A4.SS2.p3.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A4.SS2.p3.1.3" class="ltx_text ltx_font_italic">
Let <math id="A4.SS2.p3.m1" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and dataset size <math id="A4.SS2.p3.m2" class="ltx_Math" alttext="N\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>N</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">N\in\mathbb{N}_{+}</annotation></semantics></math>. For the Transformer function class <math id="A4.SS2.p3.m3" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math> and target <math id="A4.SS2.p3.m4" class="ltx_Math" alttext="f^{*}\in\mathcal{H}^{\alpha}_{d_{0},1}([0,1]^{d_{0}},K)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mn>1</mn></mrow><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in\mathcal{H}^{\alpha}_{d_{0},1}([0,1]^{d_{0}},K)</annotation></semantics></math>, the statistical error <math id="A4.SS2.p3.m5" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}=\mathbb{E_{D}}[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})]" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}=\mathbb{E_{D}}[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})]</annotation></semantics></math> is upper bounded by</span></p>
<table id="A4.Ex74" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex74.m1" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}\lesssim\frac{(16K+8)(D^{4}\log(eKND^{-4}/\mu)+1)}{N}+3\mu," display="block" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>≲</mo><mrow><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>D</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>/</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>N</mi></mfrac><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}\lesssim\frac{(16K+8)(D^{4}\log(eKND^{-4}/\mu)+1)}{N}+3\mu,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p3.2" class="ltx_p"><span id="A4.SS2.p3.2.1" class="ltx_text ltx_font_italic">where <math id="A4.SS2.p3.m6" class="ltx_Math" alttext="\mu" display="inline" intent=":literal"><semantics><mi>μ</mi><annotation encoding="application/x-tex">\mu</annotation></semantics></math> is the adjustable radius parameter.
</span></p>
</div>
<div id="A4.SS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A4.SS2.2.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#S6.Thmtheorem1" title="Theorem 6.1 (Upper Bound of Statistical Error). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.1</span></a></span>.</h6>
<div id="A4.SS2.p4" class="ltx_para">
<p id="A4.SS2.p4.1" class="ltx_p"><span id="A4.SS2.p4.1.1" class="ltx_text">We can derive that all <math id="A4.SS2.p4.m1" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0},1}^{\alpha}(\mathcal{X},K)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mn>1</mn></mrow><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0},1}^{\alpha}(\mathcal{X},K)</annotation></semantics></math> holds <math id="A4.SS2.p4.m2" class="ltx_Math" alttext="\left\lVert f\right\rVert\leq K" display="inline" intent=":literal"><semantics><mrow><mrow><mo>‖</mo><mi>f</mi><mo>‖</mo></mrow><mo>≤</mo><mi>K</mi></mrow><annotation encoding="application/x-tex">\left\lVert f\right\rVert\leq K</annotation></semantics></math> and <math id="A4.SS2.p4.m3" class="ltx_Math" alttext="l(f,z)=(f(x)-y)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">l(f,z)=(f(x)-y)^{2}</annotation></semantics></math> is a <math id="A4.SS2.p4.m4" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math>-Lipschitz function, along with local strong convexity <math id="A4.SS2.p4.m5" class="ltx_Math" alttext="c=1" display="inline" intent=":literal"><semantics><mrow><mi>c</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">c=1</annotation></semantics></math> of <math id="A4.SS2.p4.m6" class="ltx_Math" alttext="\mathcal{L}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℒ</mi><annotation encoding="application/x-tex">\mathcal{L}</annotation></semantics></math> at <math id="A4.SS2.p4.m7" class="ltx_Math" alttext="f^{*}" display="inline" intent=":literal"><semantics><msup><mi>f</mi><mo>∗</mo></msup><annotation encoding="application/x-tex">f^{*}</annotation></semantics></math> as</span></p>
<table id="A4.Ex75" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex75X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex75X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{L}(f)-\mathcal{L}(f^{*})" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathcal{L}(f)-\mathcal{L}(f^{*})</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right]+2\mathbb{E}_{z}\left[(f(y)-f^{*}(x))(f^{*}(x)-y)\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right]+2\mathbb{E}_{z}\left[(f(y)-f^{*}(x))(f^{*}(x)-y)\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex75Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right]+2\mathbb{E}_{y}\mathbb{E}_{x}\left[(f(x)-f^{*}(x))(f^{*}(x)-y)\mid x\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msub><mi>𝔼</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>y</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>x</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo>]</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right]+2\mathbb{E}_{y}\mathbb{E}_{x}\left[(f(x)-f^{*}(x))(f^{*}(x)-y)\mid x\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex75Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex75Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>z</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E}_{z}\left[(f(x)-f^{*}(x))^{2}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p4.2" class="ltx_p"><span id="A4.SS2.p4.2.1" class="ltx_text">where the last equation comes from <math id="A4.SS2.p4.m8" class="ltx_Math" alttext="f^{*}=\mathbb{E}\left[y\mid x\right]" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>=</mo><mrow><mi>𝔼</mi><mo>⁡</mo><mrow><mo>[</mo><mrow><mi>y</mi><mo lspace="0em" rspace="0.167em">∣</mo><mi>x</mi></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}=\mathbb{E}\left[y\mid x\right]</annotation></semantics></math> under the loss function <math id="A4.SS2.p4.m9" class="ltx_Math" alttext="l(f,z)=(f(x)-y)^{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><annotation encoding="application/x-tex">l(f,z)=(f(x)-y)^{2}</annotation></semantics></math>. Consequently, we can derive the result based on Lemma <a href="#A4.Thmtheorem4" title="Lemma D.4 (Bounding Statistical Error via Covering Numbers). ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4</span></a>,</span></p>
<table id="A4.E59" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E59X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E59X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{sta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{sta}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E59X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]\leq\frac{(16K+8)(\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)+1)}{N}+3\mu." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>N</mi></mfrac></mstyle><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]\leq\frac{(16K+8)(\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)+1)}{N}+3\mu.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(59)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p4.3" class="ltx_p"><span id="A4.SS2.p4.3.1" class="ltx_text">Further with Lemma <a href="#A4.Thmtheorem5" title="Lemma D.5. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a>, we can obtain
<math id="A4.SS2.p4.m10" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{sta}}\lesssim{(16K+8)(D^{4}\log(eKND^{-4}/\mu)+1)}/{N}+3\mu" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>≲</mo><mrow><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>D</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>/</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>/</mo><mi>N</mi></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{sta}}\lesssim{(16K+8)(D^{4}\log(eKND^{-4}/\mu)+1)}/{N}+3\mu</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A4.SS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A4.SS2.3.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#A4.Thmtheorem4" title="Lemma D.4 (Bounding Statistical Error via Covering Numbers). ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.4</span></a></span>.</h6>
<div id="A4.SS2.p5" class="ltx_para">
<p id="A4.SS2.p5.1" class="ltx_p"><span id="A4.SS2.p5.1.1" class="ltx_text">Let <math id="A4.SS2.p5.m1" class="ltx_Math" alttext="\mathbb{D}^{\prime}=\{z_{g}^{(1)},\ldots,z^{(N)}_{g}\}" display="inline" intent=":literal"><semantics><mrow><msup><mi>𝔻</mi><mo>′</mo></msup><mo>=</mo><mrow><mo stretchy="false">{</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{D}^{\prime}=\{z_{g}^{(1)},\ldots,z^{(N)}_{g}\}</annotation></semantics></math> be an i.i.d. ghost sample set independent of <math id="A4.SS2.p5.m2" class="ltx_Math" alttext="\mathbb{D}=\{z^{(1)},\ldots,z^{(N)}\}" display="inline" intent=":literal"><semantics><mrow><mi>𝔻</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathbb{D}=\{z^{(1)},\ldots,z^{(N)}\}</annotation></semantics></math>. For the sake of simplicity, denote <math id="A4.SS2.p5.m3" class="ltx_Math" alttext="g(f,z)=l(f,z)-l(f^{*},z)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">g(f,z)=l(f,z)-l(f^{*},z)</annotation></semantics></math> and <math id="A4.SS2.p5.m4" class="ltx_Math" alttext="G(f,z)=\mathbb{E_{D^{\prime}}}[g(f,z_{g})-2g(f,z)]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msup><mi>𝔻</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msub><mi>z</mi><mi>g</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G(f,z)=\mathbb{E_{D^{\prime}}}[g(f,z_{g})-2g(f,z)]</annotation></semantics></math> in this proof, and we have for the statistical error</span></p>
<table id="A4.Ex76" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex76X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex76X.m2" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\mathrm{sta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\mathrm{sta}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex76X.m3" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})-2(\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*}))\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-2\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*})\right]=\mathbb{E_{D}}\left[\mathcal{L}(f_{s(\tau)})-\mathcal{L}(f^{*})-2(\widehat{\mathcal{L}}(f_{s(\tau)})+\mathcal{L}(f^{*}))\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex76Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex76Xa.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\Big[\mathbb{E_{D^{\prime}}}\Big[\frac{1}{N}\sum_{i=1}^{N}g(f_{s(\tau)},z_{g}^{(i)})\Big]-\frac{2}{N}\sum_{i=1}^{N}g(f_{s(\tau)},z^{(i)})\Big]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><msub><mi>𝔼</mi><msup><mi>𝔻</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo mathsize="1.600em">,</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo mathsize="1.600em">,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\Big[\mathbb{E_{D^{\prime}}}\Big[\frac{1}{N}\sum_{i=1}^{N}g(f_{s(\tau)},z_{g}^{(i)})\Big]-\frac{2}{N}\sum_{i=1}^{N}g(f_{s(\tau)},z^{(i)})\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex76Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex76Xb.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}\mathbb{E_{D^{\prime}}}\Big[g(f_{s(\tau)},z_{g}^{(i)})-2g(f_{s(\tau)},z^{(i)})\Big]\Big]=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}G(f_{s(\tau)},z^{(i)})\Big]," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><msub><mi>𝔼</mi><msup><mi>𝔻</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}\mathbb{E_{D^{\prime}}}\Big[g(f_{s(\tau)},z_{g}^{(i)})-2g(f_{s(\tau)},z^{(i)})\Big]\Big]=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}G(f_{s(\tau)},z^{(i)})\Big],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p5.2" class="ltx_p"><span id="A4.SS2.p5.2.1" class="ltx_text">where we use the fact that <math id="A4.SS2.p5.m5" class="ltx_Math" alttext="\mathcal{L}(f)=\mathbb{E_{D}}[\widehat{\mathcal{L}}(f)]=\mathbb{E_{D}}[\frac{1}{N}\sum_{i=1}^{N}l(f,z^{(i)})]=\mathbb{E_{D^{\prime}}}[\frac{1}{N}\sum_{i=1}^{N}l(f,z_{g}^{(i)})]" display="inline" intent=":literal"><semantics><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>^</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>𝔼</mi><msup><mi>𝔻</mi><mo>′</mo></msup></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mfrac><mn>1</mn><mi>N</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><msubsup><mo>∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(f)=\mathbb{E_{D}}[\widehat{\mathcal{L}}(f)]=\mathbb{E_{D}}[\frac{1}{N}\sum_{i=1}^{N}l(f,z^{(i)})]=\mathbb{E_{D^{\prime}}}[\frac{1}{N}\sum_{i=1}^{N}l(f,z_{g}^{(i)})]</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS2.p6" class="ltx_para">
<p id="A4.SS2.p6.1" class="ltx_p"><span id="A4.SS2.p6.1.1" class="ltx_text">Suppose the covering <math id="A4.SS2.p6.m1" class="ltx_Math" alttext="\mathcal{C}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒞</mi><annotation encoding="application/x-tex">\mathcal{C}</annotation></semantics></math> of <math id="A4.SS2.p6.m2" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is <math id="A4.SS2.p6.m3" class="ltx_Math" alttext="\{f_{1},\ldots,f_{\mathcal{N}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒩</mi></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{f_{1},\ldots,f_{\mathcal{N}}\}</annotation></semantics></math> with the covering number <math id="A4.SS2.p6.m4" class="ltx_Math" alttext="\mathcal{N}_{\infty}(\mu,\mathcal{F},N)\coloneq\mathcal{N}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><annotation encoding="application/x-tex">\mathcal{N}_{\infty}(\mu,\mathcal{F},N)\coloneq\mathcal{N}</annotation></semantics></math>. For any <math id="A4.SS2.p6.m5" class="ltx_Math" alttext="f\in\mathcal{F}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><annotation encoding="application/x-tex">f\in\mathcal{F}</annotation></semantics></math>, there exists a <math id="A4.SS2.p6.m6" class="ltx_Math" alttext="\tilde{f}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\tilde{f}\in\mathcal{C}</annotation></semantics></math> such that</span></p>
<table id="A4.Ex77" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex77.m1" class="ltx_Math" alttext="\left|g(f,z)-g(\tilde{f},z)\right|=\left|l({f},z)-l(\tilde{f},z)\right|\leq\lambda\left|{f}(z)-\tilde{f}(z)\right|\leq\lambda\mu,\text{ and }G(f,z)\leq G(\tilde{f},z)+3\lambda\mu," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo>,</mo><mrow><mrow><mtext> and </mtext><mo lspace="0em" rspace="0em">​</mo><mi>G</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|g(f,z)-g(\tilde{f},z)\right|=\left|l({f},z)-l(\tilde{f},z)\right|\leq\lambda\left|{f}(z)-\tilde{f}(z)\right|\leq\lambda\mu,\text{ and }G(f,z)\leq G(\tilde{f},z)+3\lambda\mu,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p6.2" class="ltx_p"><span id="A4.SS2.p6.2.1" class="ltx_text">resulting in that for any <math id="A4.SS2.p6.m7" class="ltx_Math" alttext="t&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">t&gt;0</annotation></semantics></math></span></p>
<table id="A4.Ex78" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A4.Ex78X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex78X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(f_{s(\tau)},z^{(i)})&gt;t\Big]\leq\mathbb{P}\Big[\max_{{f}\in\mathcal{F}}\frac{1}{N}\sum_{i}G({f},z^{(i)})&gt;t\Big]\leq\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t-3\lambda\mu\Big]." display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mi>G</mi><mo stretchy="false">(</mo><mi>f</mi><msub><mrow></mrow><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo><mo>≤</mo><mi>ℙ</mi><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mi>G</mi><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo><mo>≤</mo><mi>ℙ</mi><mo maxsize="1.600em" minsize="1.600em">[</mo><mi>max</mi><msub><mrow></mrow><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></msub><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mi>i</mi></msub><mi>G</mi><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><mi>z</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><mo>&gt;</mo><mi>t</mi><mo>−</mo><mn>3</mn><mi>λ</mi><mi>μ</mi><mo maxsize="1.600em" minsize="1.600em">]</mo><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(f_{s(\tau)},z^{(i)})&gt;t\Big]\leq\mathbb{P}\Big[\max_{{f}\in\mathcal{F}}\frac{1}{N}\sum_{i}G({f},z^{(i)})&gt;t\Big]\leq\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t-3\lambda\mu\Big].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p6.3" class="ltx_p"><span id="A4.SS2.p6.3.1" class="ltx_text">Further, for any <math id="A4.SS2.p6.m8" class="ltx_Math" alttext="\tilde{f}\in\mathcal{C}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><annotation encoding="application/x-tex">\tilde{f}\in\mathcal{C}</annotation></semantics></math>, we clarify that <math id="A4.SS2.p6.m9" class="ltx_Math" alttext="g(\tilde{f},z^{(i)})" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">g(\tilde{f},z^{(i)})</annotation></semantics></math> is a bounded random variable since</span></p>
<table id="A4.EGx15" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex79"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex79.m1" class="ltx_Math" alttext="\displaystyle\left|g(\tilde{f},z^{(i)})\right|=\left|l(\tilde{f},z^{(i)})-l(f^{*},z^{(i)})\right|\leq 2\lambda B,~\mathrm{and}~\left|g(\tilde{f},z^{(i)})-\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})\right]\right|\leq 4\lambda B," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mo>|</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mrow><mi>and</mi><mo lspace="0.330em" rspace="0em">​</mo><mrow><mo>|</mo><mrow><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow><mo>≤</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|g(\tilde{f},z^{(i)})\right|=\left|l(\tilde{f},z^{(i)})-l(f^{*},z^{(i)})\right|\leq 2\lambda B,~\mathrm{and}~\left|g(\tilde{f},z^{(i)})-\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})\right]\right|\leq 4\lambda B,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p6.4" class="ltx_p"><span id="A4.SS2.p6.4.1" class="ltx_text">with the expectation satisfying</span></p>
<table id="A4.EGx16" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex80"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex80.m1" class="ltx_Math" alttext="\displaystyle\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})\right]" display="inline" intent=":literal"><semantics><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})\right]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex80.m2" class="ltx_Math" alttext="\displaystyle=\mathbb{E_{D}}\left[l(\tilde{f},z^{(i)})-l(f^{*},z^{(i)})\right]=\left[\mathcal{L}(\tilde{f})-\mathcal{L}(f^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><mo>=</mo><mrow><mo>[</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>f</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\left[l(\tilde{f},z^{(i)})-l(f^{*},z^{(i)})\right]=\left[\mathcal{L}(\tilde{f})-\mathcal{L}(f^{*})\right]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex81"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex81.m1" class="ltx_Math" alttext="\displaystyle\geq c\cdot\mathbb{E_{D}}\left[|{\tilde{f}-f^{*}}|^{2}\right]\geq\frac{c}{\lambda^{2}}\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})^{2}\right]\geq\frac{c}{\lambda^{2}}\mathrm{Var}\left[g(\tilde{f},z^{(i)})^{2}\right]\coloneq\frac{c\sigma^{2}}{\lambda^{2}}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mi>c</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><msup><mrow><mo stretchy="false">|</mo><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>−</mo><msup><mi>f</mi><mo>∗</mo></msup></mrow><mo stretchy="false">|</mo></mrow><mn>2</mn></msup><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mi>c</mi><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mi>c</mi><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>Var</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>g</mi><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mo>]</mo></mrow></mrow><mo>≔</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><msup><mi>λ</mi><mn>2</mn></msup></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq c\cdot\mathbb{E_{D}}\left[|{\tilde{f}-f^{*}}|^{2}\right]\geq\frac{c}{\lambda^{2}}\mathbb{E_{D}}\left[g(\tilde{f},z^{(i)})^{2}\right]\geq\frac{c}{\lambda^{2}}\mathrm{Var}\left[g(\tilde{f},z^{(i)})^{2}\right]\coloneq\frac{c\sigma^{2}}{\lambda^{2}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p6.5" class="ltx_p"><span id="A4.SS2.p6.5.1" class="ltx_text">where we use the <math id="A4.SS2.p6.m10" class="ltx_Math" alttext="\lambda" display="inline" intent=":literal"><semantics><mi>λ</mi><annotation encoding="application/x-tex">\lambda</annotation></semantics></math>-Lipschitz continuity of <math id="A4.SS2.p6.m11" class="ltx_Math" alttext="l(f,z)" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">l(f,z)</annotation></semantics></math> on <math id="A4.SS2.p6.m12" class="ltx_Math" alttext="f" display="inline" intent=":literal"><semantics><mi>f</mi><annotation encoding="application/x-tex">f</annotation></semantics></math> and the locally strong convexity of <math id="A4.SS2.p6.m13" class="ltx_Math" alttext="\mathcal{L}(f)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℒ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>f</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{L}(f)</annotation></semantics></math> with parameter <math id="A4.SS2.p6.m14" class="ltx_Math" alttext="c" display="inline" intent=":literal"><semantics><mi>c</mi><annotation encoding="application/x-tex">c</annotation></semantics></math>. Therefore, for any <math id="A4.SS2.p6.m15" class="ltx_Math" alttext="\tilde{f}\in\mathcal{C}," display="inline" intent=":literal"><semantics><mrow><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\tilde{f}\in\mathcal{C},</annotation></semantics></math></span></p>
<table id="A4.EGx17" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex82"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex82.m1" class="ltx_math_unparsed" alttext="\displaystyle\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t\Big]" display="inline" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>G</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t\Big]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex82.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{P}\Big[\frac{1}{N}\sum_{i}\mathbb{E}_{\mathbb{D}^{\prime}}\left[g(\tilde{f},z^{(i)}_{g})\right]-\frac{2}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;t\Big]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><msub><mi>𝔼</mi><msup><mi>𝔻</mi><mo>′</mo></msup></msub><mrow><mo>[</mo><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msubsup><mi>z</mi><mi>g</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo>]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>2</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\Big[\frac{1}{N}\sum_{i}\mathbb{E}_{\mathbb{D}^{\prime}}\left[g(\tilde{f},z^{(i)}_{g})\right]-\frac{2}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;t\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex83"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex83.m1" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{P}\Big[\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]-\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;\frac{t}{2}+\frac{1}{2}\cdot\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]\Big]" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{P}\Big[\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]-\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;\frac{t}{2}+\frac{1}{2}\cdot\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex84"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex84.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\mathbb{P}\Big[\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]-\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big]" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>g</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathbb{P}\Big[\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})\Big]-\frac{1}{N}\sum_{i}g(\tilde{f},z^{(i)})&gt;\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big]</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex85"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex85.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\Big(-\frac{N}{2(\sigma^{2}+4\lambda B(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}))}\cdot\Big(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big)^{2}\Big)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>+</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mi>t</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mn>2</mn></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\Big(-\frac{N}{2(\sigma^{2}+4\lambda B(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}))}\cdot\Big(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big)^{2}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex86"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex86.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq\exp\Big(-\frac{N}{4(\lambda^{2}/c+2\lambda B)}\cdot\Big(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big)\Big)" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>exp</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mstyle displaystyle="true"><mfrac><mi>N</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>λ</mi><mn>2</mn></msup><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mstyle displaystyle="true"><mfrac><mi>t</mi><mn>2</mn></mfrac></mstyle><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mstyle><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\Big(-\frac{N}{4(\lambda^{2}/c+2\lambda B)}\cdot\Big(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\Big)\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex87"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex87.m1" class="ltx_Math" alttext="\displaystyle\leq\exp\Big(-\frac{Nt}{8\lambda^{2}/c+16\lambda B}\Big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\exp\Big(-\frac{Nt}{8\lambda^{2}/c+16\lambda B}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p6.6" class="ltx_p"><span id="A4.SS2.p6.6.1" class="ltx_text">where the second inequality comes from the Bernstein’s inequality for bounded random variables, the third inequality comes from <math id="A4.SS2.p6.m16" class="ltx_Math" alttext="\sigma^{2}\leq\frac{2\lambda^{2}}{c}(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>σ</mi><mn>2</mn></msup><mo>≤</mo><mrow><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mi>c</mi></mfrac><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mfrac><mi>t</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\sigma^{2}\leq\frac{2\lambda^{2}}{c}(\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}})</annotation></semantics></math> and the last result is obtained by <math id="A4.SS2.p6.m17" class="ltx_Math" alttext="\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\leq\frac{t}{2}" display="inline" intent=":literal"><semantics><mrow><mrow><mfrac><mi>t</mi><mn>2</mn></mfrac><mo>+</mo><mfrac><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>σ</mi><mn>2</mn></msup></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow></mfrac></mrow><mo>≤</mo><mfrac><mi>t</mi><mn>2</mn></mfrac></mrow><annotation encoding="application/x-tex">\frac{t}{2}+\frac{c\sigma^{2}}{2\lambda^{2}}\leq\frac{t}{2}</annotation></semantics></math>.</span></p>
</div>
<div id="A4.SS2.p7" class="ltx_para">
<p id="A4.SS2.p7.1" class="ltx_p"><span id="A4.SS2.p7.1.1" class="ltx_text">It is noticeable that for any <math id="A4.SS2.p7.m1" class="ltx_Math" alttext="t&gt;3\lambda\mu" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>&gt;</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><annotation encoding="application/x-tex">t&gt;3\lambda\mu</annotation></semantics></math>, with assistance of the <math id="A4.SS2.p7.m2" class="ltx_Math" alttext="\mu-" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>−</mo></mrow><annotation encoding="application/x-tex">\mu-</annotation></semantics></math>covering, we have</span></p>
<table id="A4.E60" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E60.m1" class="ltx_math_unparsed" alttext="\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t-3\lambda\mu\Big]\leq\mathcal{N}\cdot\exp\Big(-\frac{N(t-3\lambda\mu)}{8\lambda^{2}/c+16\lambda B}\Big)." display="block" intent=":literal"><semantics><mrow><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><munder><mi>max</mi><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></munder><mfrac><mn>1</mn><mi>N</mi></mfrac><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder><mi>G</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo>−</mo><mn>3</mn><mi>λ</mi><mi>μ</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>≤</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>exp</mi><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mo lspace="0em">−</mo><mfrac><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mfrac><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t-3\lambda\mu\Big]\leq\mathcal{N}\cdot\exp\Big(-\frac{N(t-3\lambda\mu)}{8\lambda^{2}/c+16\lambda B}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(60)</span></td></tr></tbody>
</table>
<p id="A4.SS2.p7.2" class="ltx_p"><span id="A4.SS2.p7.2.1" class="ltx_text">Further with (<a href="#A4.E60" title="Equation 60 ‣ Proof of Lemma . ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">60</span></a>), we choose <math id="A4.SS2.p7.m3" class="ltx_Math" alttext="c_{0}=(8\lambda^{2}/c+16\lambda B)\log\mathcal{N}/N" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow></mrow><mo>/</mo><mi>N</mi></mrow></mrow><annotation encoding="application/x-tex">c_{0}=(8\lambda^{2}/c+16\lambda B)\log\mathcal{N}/N</annotation></semantics></math> and get</span></p>
<table id="A4.EGx18" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A4.Ex88"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.Ex88.m1" class="ltx_Math" alttext="\displaystyle\mathcal{E}_{\text{sta}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mtext>sta</mtext></msub><annotation encoding="application/x-tex">\displaystyle\mathcal{E}_{\text{sta}}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex88.m2" class="ltx_math_unparsed" alttext="\displaystyle=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}G(f_{s(\tau)},z^{(i)})\Big]=\int_{0}^{+\infty}\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(f_{s(\tau)},z^{(i)})&gt;t\Big]\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munderover><mo movablelimits="false">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></munderover></mstyle><mi>G</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mo>=</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mn>0</mn><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>G</mi><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle=\mathbb{E_{D}}\Big[\frac{1}{N}\sum_{i=1}^{N}G(f_{s(\tau)},z^{(i)})\Big]=\int_{0}^{+\infty}\mathbb{P}\Big[\frac{1}{N}\sum_{i}G(f_{s(\tau)},z^{(i)})&gt;t\Big]\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex89"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex89.m1" class="ltx_math_unparsed" alttext="\displaystyle\leq 3\lambda\mu+c_{0}+\int_{3\lambda\mu+c_{0}}^{+\infty}\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t\Big]\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mn>3</mn><mi>λ</mi><mi>μ</mi><mo>+</mo><msub><mi>c</mi><mn>0</mn></msub><mo>+</mo><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>+</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mi>ℙ</mi><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><munder><mi>max</mi><mrow><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒞</mi></mrow></munder><mstyle displaystyle="true"><mfrac><mn>1</mn><mi>N</mi></mfrac></mstyle><mstyle displaystyle="true"><munder><mo movablelimits="false">∑</mo><mi>i</mi></munder></mstyle><mi>G</mi><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>f</mi><mo>~</mo></mover><mo>,</mo><msup><mi>z</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>&gt;</mo><mi>t</mi><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow><mi>d</mi><mi>t</mi></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3\lambda\mu+c_{0}+\int_{3\lambda\mu+c_{0}}^{+\infty}\mathbb{P}\Big[\max_{\tilde{f}\in\mathcal{C}}\frac{1}{N}\sum_{i}G(\tilde{f},z^{(i)})&gt;t\Big]\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex90"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex90.m1" class="ltx_Math" alttext="\displaystyle\leq 3\lambda\mu+c_{0}+\int_{3\lambda\mu+c_{0}}^{+\infty}\mathcal{N}\cdot\exp\Big(-\frac{N(t-3\lambda\mu)}{8\lambda^{2}/c+16\lambda B}\Big)\mathrm{d}t" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>+</mo><msub><mi>c</mi><mn>0</mn></msub><mo>+</mo><mrow><mrow><mrow><mstyle displaystyle="true"><msubsup><mo>∫</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>+</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></msubsup></mstyle><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>N</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>t</mi><mo>−</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">𝑑</mo><mi>t</mi></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3\lambda\mu+c_{0}+\int_{3\lambda\mu+c_{0}}^{+\infty}\mathcal{N}\cdot\exp\Big(-\frac{N(t-3\lambda\mu)}{8\lambda^{2}/c+16\lambda B}\Big)\mathrm{d}t</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex91"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex91.m1" class="ltx_Math" alttext="\displaystyle\leq 3\lambda\mu+c_{0}+\mathcal{N}\cdot\frac{8\lambda^{2}/c+16\lambda B}{N}\exp\Big(-\frac{Nc_{0}}{8\lambda^{2}/c+16\lambda B}\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>+</mo><msub><mi>c</mi><mn>0</mn></msub><mo>+</mo><mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mi>N</mi></mfrac></mstyle></mrow><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>c</mi><mn>0</mn></msub></mrow><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq 3\lambda\mu+c_{0}+\mathcal{N}\cdot\frac{8\lambda^{2}/c+16\lambda B}{N}\exp\Big(-\frac{Nc_{0}}{8\lambda^{2}/c+16\lambda B}\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A4.Ex92"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.Ex92.m1" class="ltx_Math" alttext="\displaystyle\leq\frac{(8\lambda^{2}/c+16\lambda B)(\log\mathcal{N}+1)}{N}+3\lambda\mu." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mrow><mn>8</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>λ</mi><mn>2</mn></msup></mrow><mo>/</mo><mi>c</mi></mrow><mo>+</mo><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>B</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi class="ltx_font_mathcaligraphic">𝒩</mi></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mi>N</mi></mfrac></mstyle><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>λ</mi><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\frac{(8\lambda^{2}/c+16\lambda B)(\log\mathcal{N}+1)}{N}+3\lambda\mu.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.p7.3" class="ltx_p"><span id="A4.SS2.p7.3.1" class="ltx_text">The bound is proved.
∎</span></p>
</div>
</div>
<section id="A4.SS2.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Bounding the Covering Number.</h5>

<div id="A4.SS2.SSS0.Px1.p1" class="ltx_para">
<p id="A4.SS2.SSS0.Px1.p1.1" class="ltx_p">The current proof of Lemma <a href="#A4.Thmtheorem5" title="Lemma D.5. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a> turns to bound the uniform covering number <math id="A4.SS2.SSS0.Px1.p1.m1" class="ltx_Math" alttext="\mathcal{N}=\mathcal{N}_{\infty}(\mu,\mathcal{F},n)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒩</mi><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}=\mathcal{N}_{\infty}(\mu,\mathcal{F},n)</annotation></semantics></math> with <math id="A4.SS2.SSS0.Px1.p1.m2" class="ltx_Math" alttext="\mathcal{F}=\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>=</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow><annotation encoding="application/x-tex">\mathcal{F}=\mathcal{T}_{R}^{D}</annotation></semantics></math> and <math id="A4.SS2.SSS0.Px1.p1.m3" class="ltx_Math" alttext="n=N" display="inline" intent=":literal"><semantics><mrow><mi>n</mi><mo>=</mo><mi>N</mi></mrow><annotation encoding="application/x-tex">n=N</annotation></semantics></math>. We rely on the following theorem.</p>
</div>
<div id="A4.Thmtheorem6" class="ltx_theorem ltx_theorem_theorem">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem6.2" class="ltx_text ltx_font_bold">Theorem D.6</span></span><span id="A4.Thmtheorem6.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_citep"><a href="#bib.bib2" title="" class="ltx_ref">Anthony &amp; Bartlett, 2009</a>, Theorem 12.2</cite>)<span id="A4.Thmtheorem6.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem6.p1" class="ltx_para">
<p id="A4.Thmtheorem6.p1.1" class="ltx_p"><span id="A4.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A4.Thmtheorem6.p1.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> be a set of real functions from a domain <math id="A4.Thmtheorem6.p1.m2" class="ltx_Math" alttext="\mathcal{X}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒳</mi><annotation encoding="application/x-tex">\mathcal{X}</annotation></semantics></math> to the bounded interval <math id="A4.Thmtheorem6.p1.m3" class="ltx_Math" alttext="[0,K]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mi>K</mi><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[0,K]</annotation></semantics></math>. Let <math id="A4.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\mu&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\mu&gt;0</annotation></semantics></math> and suppose that the pseudo-dimension of <math id="A4.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math> is <math id="A4.Thmtheorem6.p1.m6" class="ltx_Math" alttext="d_{\rm p}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi mathvariant="normal">p</mi></msub><annotation encoding="application/x-tex">d_{\rm p}</annotation></semantics></math>. For <math id="A4.Thmtheorem6.p1.m7" class="ltx_Math" alttext="m\geq d_{\rm p}" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>≥</mo><msub><mi>d</mi><mi mathvariant="normal">p</mi></msub></mrow><annotation encoding="application/x-tex">m\geq d_{\rm p}</annotation></semantics></math>,</span></p>
<table id="A4.Ex93" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex93.m1" class="ltx_Math" alttext="\mathcal{N}_{\infty}(\mu,\mathcal{F},n)\leq\sum_{i=1}^{d_{\rm p}}\binom{n}{i}\left(\frac{K}{\mu}\right)^{i}\leq\left(\frac{enK}{\mu d_{\rm p}}\right)^{d_{\rm p}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi><mo>,</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></mrow><mo rspace="0.111em">≤</mo><mrow><munderover><mo movablelimits="false" rspace="0em">∑</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><msub><mi>d</mi><mi>p</mi></msub></munderover><mrow><mrow><mo>(</mo><mfrac linethickness="0pt"><mi>n</mi><mi>i</mi></mfrac><mo>)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo>(</mo><mfrac><mi>K</mi><mi>μ</mi></mfrac><mo>)</mo></mrow><mi>i</mi></msup></mrow></mrow><mo>≤</mo><msup><mrow><mo>(</mo><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mi>p</mi></msub></mrow></mfrac><mo>)</mo></mrow><msub><mi>d</mi><mi>p</mi></msub></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{N}_{\infty}(\mu,\mathcal{F},n)\leq\sum_{i=1}^{d_{\rm p}}\binom{n}{i}\left(\frac{K}{\mu}\right)^{i}\leq\left(\frac{enK}{\mu d_{\rm p}}\right)^{d_{\rm p}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A4.SS2.SSS0.Px1.1" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A4.SS2.SSS0.Px1.1.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#A4.Thmtheorem5" title="Lemma D.5. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a></span>.</h6>
<div id="A4.SS2.SSS0.Px1.p2" class="ltx_para">
<p id="A4.SS2.SSS0.Px1.p2.1" class="ltx_p"><span id="A4.SS2.SSS0.Px1.p2.1.1" class="ltx_text">As for any real function class <math id="A4.SS2.SSS0.Px1.p2.m1" class="ltx_Math" alttext="\mathcal{F}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">ℱ</mi><annotation encoding="application/x-tex">\mathcal{F}</annotation></semantics></math>, its pseudo-dimension is equal to the VC-dimension of the relative subgraph class defined as</span></p>
<table id="A4.Ex94" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex94.m1" class="ltx_Math" alttext="B_{\mathcal{F}}=\left\{B_{f}(x,y)=\mathrm{sgn}(f(x)-y):f\in\mathcal{F}\right\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">ℱ</mi></msub><mo>=</mo><mrow><mo>{</mo><mrow><mrow><msub><mi>B</mi><mi>f</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>sgn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>f</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mi>y</mi></mrow><mo rspace="0.278em" stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.278em">:</mo><mrow><mi>f</mi><mo>∈</mo><mi class="ltx_font_mathcaligraphic">ℱ</mi></mrow><mo>}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{\mathcal{F}}=\left\{B_{f}(x,y)=\mathrm{sgn}(f(x)-y):f\in\mathcal{F}\right\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px1.p2.2" class="ltx_p"><span id="A4.SS2.SSS0.Px1.p2.2.1" class="ltx_text">Therefore, for the Transformer function class <math id="A4.SS2.SSS0.Px1.p2.m2" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math>, we have <math id="A4.SS2.SSS0.Px1.p2.m3" class="ltx_Math" alttext="\mathrm{Pdim}(\mathcal{T}_{R}^{D})=\mathrm{VCdim}(B_{\mathcal{T}})." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>Pdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{Pdim}(\mathcal{T}_{R}^{D})=\mathrm{VCdim}(B_{\mathcal{T}}).</annotation></semantics></math>
Bounding <math id="A4.SS2.SSS0.Px1.p2.m4" class="ltx_Math" alttext="\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)</annotation></semantics></math> now turns to bound the VC-dimension of <math id="A4.SS2.SSS0.Px1.p2.m5" class="ltx_Math" alttext="B_{\mathcal{T}}." display="inline" intent=":literal"><semantics><mrow><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">B_{\mathcal{T}}.</annotation></semantics></math></span></p>
</div>
<div id="A4.SS2.SSS0.Px1.p3" class="ltx_para">
<p id="A4.SS2.SSS0.Px1.p3.2" class="ltx_p"><span id="A4.SS2.SSS0.Px1.p3.2.1" class="ltx_text">Considering <math id="A4.SS2.SSS0.Px1.p3.m1" class="ltx_Math" alttext="y" display="inline" intent=":literal"><semantics><mi>y</mi><annotation encoding="application/x-tex">y</annotation></semantics></math> as an extra input variable, for any <math id="A4.SS2.SSS0.Px1.p3.m2" class="ltx_Math" alttext="f\in\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow><annotation encoding="application/x-tex">f\in\mathcal{T}_{R}^{D}</annotation></semantics></math>, <math id="A4.SS2.SSS0.Px1.p3.m3" class="ltx_Math" alttext="B_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">B_{\mathcal{T}}</annotation></semantics></math> only requires two more operations than that of <math id="A4.SS2.SSS0.Px1.p3.m4" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math>. Based on (<a href="#A3.E45" title="Equation 45 ‣ C.1 Total Numbers of Operations and Parameters ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>), this also leads to <math id="A4.SS2.SSS0.Px1.p3.m5" class="ltx_Math" alttext="\mathrm{VCdim}(B_{\mathcal{T}})\lesssim D^{4}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo>≲</mo><msup><mi>D</mi><mn>4</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{VCdim}(B_{\mathcal{T}})\lesssim D^{4}.</annotation></semantics></math> With Theorem <a href="#A4.Thmtheorem6" title="Theorem D.6 ( , , Theorem 12.2). ‣ Bounding the Covering Number. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.6</span></a>, we get the bound of covering number</span></p>
<table id="A4.E61" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E61X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E61X.m2" class="ltx_Math" alttext="\displaystyle\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\leq\mathrm{VCdim}\left(B_{\mathcal{T}}\right)\cdot\log\left(\frac{2eKN}{\mu\mathrm{VCdim}\left(B_{\mathcal{T}}\right)}\right)\lesssim D^{4}\log\left(\frac{eKND^{-4}}{\mu}\right)," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><msub><mi class="ltx_font_mathcaligraphic">𝒩</mi><mi mathvariant="normal">∞</mi></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>μ</mi><mo>,</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><mo>,</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mrow><mi>VCdim</mi><mo>⁡</mo><mrow><mo>(</mo><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo rspace="0.055em">)</mo></mrow></mrow><mo rspace="0.222em">⋅</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi></mrow><mrow><mi>μ</mi><mo lspace="0em" rspace="0em">​</mo><mi>VCdim</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><msub><mi>B</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>)</mo></mrow></mrow></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow><mo>≲</mo><mrow><msup><mi>D</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo>(</mo><mstyle displaystyle="true"><mfrac><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mi>μ</mi></mfrac></mstyle><mo>)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\log\mathcal{N}_{\infty}(\mu,\mathcal{T}_{R}^{D},N)\leq\mathrm{VCdim}\left(B_{\mathcal{T}}\right)\cdot\log\left(\frac{2eKN}{\mu\mathrm{VCdim}\left(B_{\mathcal{T}}\right)}\right)\lesssim D^{4}\log\left(\frac{eKND^{-4}}{\mu}\right),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(61)</span></td></tr></tbody>
</table>
<p id="A4.SS2.SSS0.Px1.p3.3" class="ltx_p"><span id="A4.SS2.SSS0.Px1.p3.3.1" class="ltx_text">where the second inequality is valid when <math id="A4.SS2.SSS0.Px1.p3.m6" class="ltx_Math" alttext="N\gtrsim D^{4}." display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>≳</mo><msup><mi>D</mi><mn>4</mn></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">N\gtrsim D^{4}.</annotation></semantics></math> And we also omit the constant “<math id="A4.SS2.SSS0.Px1.p3.m7" class="ltx_Math" alttext="2" display="inline" intent=":literal"><semantics><mn>2</mn><annotation encoding="application/x-tex">2</annotation></semantics></math>” in <math id="A4.SS2.SSS0.Px1.p3.m8" class="ltx_Math" alttext="\lesssim" display="inline" intent=":literal"><semantics><mo>≲</mo><annotation encoding="application/x-tex">\lesssim</annotation></semantics></math>. The proof is complete.
∎</span></p>
</div>
</div>
<div id="A4.Thmtheorem7" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A4.Thmtheorem7.2" class="ltx_text ltx_font_bold">Remark D.7</span></span><span id="A4.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(Novelty of Proof)<span id="A4.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A4.Thmtheorem7.p1" class="ltx_para">
<p id="A4.Thmtheorem7.p1.1" class="ltx_p">The proof of statistical error upper bound amounts to bounding the uniform covering number of Transformers given a finite sample size. The derivation of (<a href="#A4.E61" title="Equation 61 ‣ Proof of Lemma . ‣ Bounding the Covering Number. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">61</span></a>) utilizes our novel VC-dimension upper bound (<a href="#A3.E45" title="Equation 45 ‣ C.1 Total Numbers of Operations and Parameters ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">45</span></a>). Besides, this approach avoids the need to estimate the uniform covering number by computing the Lipschitz constants of Transformer layers. Instead, it relies on the VC-dimension of the model parameter space to circumvent the exponentially exploding matrix norm term in the covering number upper bound found in <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib12" title="" class="ltx_ref">Hu et al., 2024</a>, Lemma F.6)</cite> and <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib8" title="" class="ltx_ref">Edelman et al., 2022</a>, Theorem 4.7)</cite>.</p>
</div>
</div>
</section>
</section>
<section id="A4.SS3" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">D.3 </span>Convergence Rate of Excess Risk</h3>

<div id="A4.SS3.p1" class="ltx_para ltx_noindent">
<p id="A4.SS3.p1.1" class="ltx_p"><span id="A4.SS3.p1.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#S6.Thmtheorem2" title="Theorem 6.2 (Convergence Rate of Excess Risk). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a></span> (Convergence Rate of Excess Risk; Restatement)<span id="A4.SS3.p1.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A4.SS3.p1.1.3" class="ltx_text ltx_font_italic">
Assume the regression function <math id="A4.SS3.p1.m1" class="ltx_Math" alttext="f^{*}\in\mathcal{H}^{\alpha}_{d_{0},1}([0,1]^{d_{0}},K)" display="inline" intent=":literal"><semantics><mrow><msup><mi>f</mi><mo>∗</mo></msup><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><mn>1</mn></mrow><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f^{*}\in\mathcal{H}^{\alpha}_{d_{0},1}([0,1]^{d_{0}},K)</annotation></semantics></math> for some <math id="A4.SS3.p1.m2" class="ltx_Math" alttext="\alpha\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1]</annotation></semantics></math> and <math id="A4.SS3.p1.m3" class="ltx_Math" alttext="K&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">K&gt;0</annotation></semantics></math>. Let <math id="A4.SS3.p1.m4" class="ltx_Math" alttext="f_{s(\tau)}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><annotation encoding="application/x-tex">f_{s(\tau)}</annotation></semantics></math> be the estimator over the i.i.d samples <math id="A4.SS3.p1.m5" class="ltx_Math" alttext="\{(x_{i},y_{i})\}_{i=1}^{N}" display="inline" intent=":literal"><semantics><msubsup><mrow><mo stretchy="false">{</mo><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mi>i</mi></msub><mo>,</mo><msub><mi>y</mi><mi>i</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">}</mo></mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>N</mi></msubsup><annotation encoding="application/x-tex">\{(x_{i},y_{i})\}_{i=1}^{N}</annotation></semantics></math>, the excess risk bound holds,</span></p>
<table id="A4.Ex95" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.Ex95.m1" class="ltx_Math" alttext="\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]-2\tau\lesssim N^{-\frac{\alpha}{2d_{0}+\alpha}}\log(N)+N^{-\frac{\alpha}{2d_{0}+\alpha}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><mo>≲</mo><mrow><mrow><msup><mi>N</mi><mrow><mo>−</mo><mfrac><mi>α</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>α</mi></mrow></mfrac></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msup><mi>N</mi><mrow><mo>−</mo><mfrac><mi>α</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>α</mi></mrow></mfrac></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]-2\tau\lesssim N^{-\frac{\alpha}{2d_{0}+\alpha}}\log(N)+N^{-\frac{\alpha}{2d_{0}+\alpha}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p1.2" class="ltx_p"><span id="A4.SS3.p1.2.1" class="ltx_text ltx_font_italic">where <math id="A4.SS3.p1.m6" class="ltx_Math" alttext="\tau" display="inline" intent=":literal"><semantics><mi>τ</mi><annotation encoding="application/x-tex">\tau</annotation></semantics></math> is the optimization error.
</span></p>
</div>
<div id="A4.SS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A4.SS3.2.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#S6.Thmtheorem2" title="Theorem 6.2 (Convergence Rate of Excess Risk). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6.2</span></a></span>.</h6>
<div id="A4.SS3.p2" class="ltx_para">
<p id="A4.SS3.p2.2" class="ltx_p"><span id="A4.SS3.p2.2.1" class="ltx_text">The approximation upper bound of Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> equivalently reveals that</span></p>
<table id="A4.E62" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A4.E62.m1" class="ltx_Math" alttext="\mathcal{E}_{\rm app}^{2}=\underset{f\in\mathcal{H}_{d_{x},d_{y}}^{\alpha}}{\sup}\underset{g\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-g\right\rVert_{2}^{2}\lesssim D^{-\frac{2\alpha}{d_{0}}}." display="block" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi><mn>2</mn></msubsup><mo rspace="0.1389em">=</mo><mrow><munder accentunder="true"><mo lspace="0.1389em" movablelimits="false">sup</mo><mrow><mi mathsize="0.700em">f</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℋ</mi><mrow><msub><mi mathsize="0.710em">d</mi><mi>x</mi></msub><mo mathsize="0.710em">,</mo><msub><mi mathsize="0.710em">d</mi><mi>y</mi></msub></mrow><mi mathsize="0.710em">α</mi></msubsup></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mo movablelimits="false">inf</mo><mrow><mi mathsize="0.700em">g</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">R</mi><mi mathsize="0.710em">D</mi></msubsup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msubsup><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>g</mi></mrow><mo>‖</mo></mrow><mn>2</mn><mn>2</mn></msubsup></mrow><mo>≲</mo><msup><mi>D</mi><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><msub><mi>d</mi><mn>0</mn></msub></mfrac></mrow></msup></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\rm app}^{2}=\underset{f\in\mathcal{H}_{d_{x},d_{y}}^{\alpha}}{\sup}\underset{g\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-g\right\rVert_{2}^{2}\lesssim D^{-\frac{2\alpha}{d_{0}}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(62)</span></td></tr></tbody>
</table>
<p id="A4.SS3.p2.3" class="ltx_p"><span id="A4.SS3.p2.3.1" class="ltx_text">Further with (<a href="#S6.E13" title="Equation 13 ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">13</span></a>), (<a href="#S6.E15" title="Equation 15 ‣ Theorem 6.1 (Upper Bound of Statistical Error). ‣ Regression Tasks. ‣ 6 Applications in a General Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">15</span></a>) and (<a href="#A4.E62" title="Equation 62 ‣ Proof of Theorem . ‣ D.3 Convergence Rate of Excess Risk ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">62</span></a>), let <math id="A4.SS3.p2.m1" class="ltx_Math" alttext="\mu=D^{-\frac{2\alpha}{d_{0}}}" display="inline" intent=":literal"><semantics><mrow><mi>μ</mi><mo>=</mo><msup><mi>D</mi><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><msub><mi>d</mi><mn>0</mn></msub></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">\mu=D^{-\frac{2\alpha}{d_{0}}}</annotation></semantics></math> and <math id="A4.SS3.p2.m2" class="ltx_Math" alttext="D=N^{\frac{d_{0}}{4d_{0}+2\alpha}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><msup><mi>N</mi><mfrac><msub><mi>d</mi><mn>0</mn></msub><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></mfrac></msup></mrow><annotation encoding="application/x-tex">D=N^{\frac{d_{0}}{4d_{0}+2\alpha}}</annotation></semantics></math>, we can derive the excess risk rate</span></p>
<table id="A4.E63" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A4.E63X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A4.E63X.m2" class="ltx_Math" alttext="\displaystyle\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]-2\tau" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>𝔼</mi><mi>𝔻</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi class="ltx_font_mathcaligraphic">ℰ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>f</mi><mrow><mi>s</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>τ</mi><mo stretchy="false">)</mo></mrow></mrow></msub><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>τ</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\mathbb{E_{D}}\left[\mathcal{E}(f_{s(\tau)})\right]-2\tau</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E63X.m3" class="ltx_Math" alttext="\displaystyle\leq\mathcal{E}_{\mathrm{sta}}+2\mathcal{E}_{\mathrm{app}}^{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>sta</mi></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi><mn>2</mn></msubsup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\mathcal{E}_{\mathrm{sta}}+2\mathcal{E}_{\mathrm{app}}^{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(63)</span></td></tr>
<tr id="A4.E63Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E63Xa.m2" class="ltx_Math" alttext="\displaystyle\lesssim{(16K+8)N^{-1}(D^{4}\log(eKND^{-4}/\mu)+1)}+3\mu+2D^{-\frac{2\alpha}{d_{0}}}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>16</mn><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mn>8</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mi>N</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msup><mi>D</mi><mn>4</mn></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>e</mi><mo lspace="0em" rspace="0em">​</mo><mi>K</mi><mo lspace="0em" rspace="0em">​</mo><mi>N</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mn>4</mn></mrow></msup></mrow><mo>/</mo><mi>μ</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>3</mn><mo lspace="0em" rspace="0em">​</mo><mi>μ</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msup><mi>D</mi><mrow><mo>−</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow><msub><mi>d</mi><mn>0</mn></msub></mfrac></mrow></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim{(16K+8)N^{-1}(D^{4}\log(eKND^{-4}/\mu)+1)}+3\mu+2D^{-\frac{2\alpha}{d_{0}}}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A4.E63Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A4.E63Xb.m2" class="ltx_Math" alttext="\displaystyle\lesssim N^{-\frac{\alpha}{2d_{0}+\alpha}}\log(N)+N^{-\frac{\alpha}{2d_{0}+\alpha}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≲</mo><mrow><mrow><msup><mi>N</mi><mrow><mo>−</mo><mfrac><mi>α</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>α</mi></mrow></mfrac></mrow></msup><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>+</mo><msup><mi>N</mi><mrow><mo>−</mo><mfrac><mi>α</mi><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>α</mi></mrow></mfrac></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\lesssim N^{-\frac{\alpha}{2d_{0}+\alpha}}\log(N)+N^{-\frac{\alpha}{2d_{0}+\alpha}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A4.SS3.p2.4" class="ltx_p"><span id="A4.SS3.p2.4.1" class="ltx_text">The result is proved.
∎</span></p>
