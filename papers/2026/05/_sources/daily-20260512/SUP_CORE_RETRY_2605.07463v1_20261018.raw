<td id="A2.T3.5.11.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m8" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math></td>
<td id="A2.T3.5.11.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.11.4.1" class="ltx_text" style="font-size:90%;">Variant</span></td></tr>
<tr id="A2.T3.5.12" class="ltx_tr">
<td id="A2.T3.5.12.1" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.12.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Ours</span></td>
<td id="A2.T3.5.12.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.12.2.1" class="ltx_text" style="font-size:90%;">ReLU</span></td>
<td id="A2.T3.5.12.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m9" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="A2.T3.5.12.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.12.4.1" class="ltx_text" style="font-size:90%;">Standard structure</span></td></tr>
</tbody>
</table>
</figure>
<div id="A2.SS3.SSS1.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS1.2.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#S4.Thmtheorem7" title="Lemma 4.7 (Quantization Module 𝑓_{𝒯⁢1}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a></span>.</h6>
<div id="A2.SS3.SSS1.p2" class="ltx_para">
<p id="A2.SS3.SSS1.p2.1" class="ltx_p"><span id="A2.SS3.SSS1.p2.1.1" class="ltx_text">Since it will be required in the subsequent constructions of contextual mapping composed of a self-attention layer, we first introduce the following positional encoding <math id="A2.SS3.SSS1.p2.m1" class="ltx_Math" alttext="E\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>E</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">E\in\mathbb{R}^{d\times L}</annotation></semantics></math>,</span></p>
<table id="A2.E23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E23.m1" class="ltx_Math" alttext="\mathrm{PoE}:X\mapsto X+E,~~\mathrm{where}~~E=\mathds{1}_{d}\cdot[1,2,\ldots,L]^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>PoE</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><mi>X</mi><mo stretchy="false">↦</mo><mrow><mi>X</mi><mo>+</mo><mi>E</mi></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.660em" rspace="0em">​</mo><mi>E</mi></mrow><mo>=</mo><mrow><msub><mn>𝟙</mn><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo stretchy="false">]</mo></mrow><mo>⊤</mo></msup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\mathrm{PoE}:X\mapsto X+E,~~\mathrm{where}~~E=\mathds{1}_{d}\cdot[1,2,\ldots,L]^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(23)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.2" class="ltx_p"><span id="A2.SS3.SSS1.p2.2.1" class="ltx_text">Suppose <math id="A2.SS3.SSS1.p2.m2" class="ltx_Math" alttext="\delta&gt;0,\delta^{*}&gt;0" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">\delta&gt;0,\delta^{*}&gt;0</annotation></semantics></math>. For any <math id="A2.SS3.SSS1.p2.m3" class="ltx_Math" alttext="j\in[L]," display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">j\in[L],</annotation></semantics></math> we create the grid <math id="A2.SS3.SSS1.p2.m4" class="ltx_Math" alttext="\mathcal{G}_{\delta,\delta^{*}}^{p}=\mathcal{G}_{\delta,\delta^{*}}+E" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></msub><mo>+</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{\delta,\delta^{*}}^{p}=\mathcal{G}_{\delta,\delta^{*}}+E</annotation></semantics></math> by mapping all the elements in <math id="A2.SS3.SSS1.p2.m5" class="ltx_Math" alttext="[j,j+1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mi>j</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[j,j+1]</annotation></semantics></math> to <math id="A2.SS3.SSS1.p2.m6" class="ltx_Math" alttext="\left\{j,j+\delta+\delta^{*},\ldots,j+(M-1)(\delta+\delta^{*})\right\}" display="inline" intent=":literal"><semantics><mrow><mo>{</mo><mrow><mi>j</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>}</mo></mrow><annotation encoding="application/x-tex">\left\{j,j+\delta+\delta^{*},\ldots,j+(M-1)(\delta+\delta^{*})\right\}</annotation></semantics></math>. Specifically, take <math id="A2.SS3.SSS1.p2.m7" class="ltx_Math" alttext="i=1,2,\ldots,d;j=1,2,\ldots,L," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>d</mi><mo>;</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">i=1,2,\ldots,d;j=1,2,\ldots,L,</annotation></semantics></math> and <math id="A2.SS3.SSS1.p2.m8" class="ltx_Math" alttext="k=0,1,\ldots,M-1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>0</mn></mrow><mo>,</mo><mn>1</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mi>M</mi><mo>−</mo><mn>1</mn></mrow></mrow><annotation encoding="application/x-tex">k=0,1,\ldots,M-1</annotation></semantics></math> respectively with <math id="A2.SS3.SSS1.p2.m9" class="ltx_Math" alttext="t=X-(j+k(\delta+\delta^{*}))\cdot\mathds{1}_{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>t</mi><mo>=</mo><mrow><mi>X</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">t=X-(j+k(\delta+\delta^{*}))\cdot\mathds{1}_{d\times L}</annotation></semantics></math>, and we design the following feed-forward layer,</span></p>
<table id="A2.E24" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E24.m1" class="ltx_Math" alttext="\!\!\mathrm{FF}^{(i,j,k+1)}(X)=X+e_{i}\Big(-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]\Big)," display="block" intent=":literal"><semantics><mrow><mrow><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo>+</mo><mrow><msub><mi>e</mi><mi>i</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><mfrac><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><msup><mi>δ</mi><mo>∗</mo></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mrow><mi>t</mi><mo>−</mo><mrow><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>−</mo><mrow><mfrac><mi>δ</mi><msup><mi>δ</mi><mo>∗</mo></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>−</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow><mo>]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\!\!\mathrm{FF}^{(i,j,k+1)}(X)=X+e_{i}\Big(-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(24)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.3" class="ltx_p"><span id="A2.SS3.SSS1.p2.3.1" class="ltx_text">where</span></p>
<table id="A2.Ex15" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex15X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex15X.m2" class="ltx_Math" alttext="\displaystyle-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]=\left\{\begin{aligned} &amp;0,&amp;&amp;t&lt;0~\mathrm{or}~t\geq\delta+\delta^{*},\\
&amp;-t,&amp;&amp;0\leq t\leq\delta,\\
&amp;\frac{\delta}{\delta^{*}}t-\frac{\delta(\delta+\delta^{*})}{\delta^{*}},&amp;&amp;\delta\leq t\leq\delta+\delta^{*}.\end{aligned}\right." display="inline" intent=":literal"><semantics><mrow><mo>−</mo><mi>σ</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><msup><mi>δ</mi><mo>∗</mo></msup></mfrac></mstyle><mi>σ</mi><msub><mrow></mrow><mi>R</mi></msub><mo stretchy="false">[</mo><mi>t</mi><mo>−</mo><mi>δ</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn><msub><mrow></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub><mo stretchy="false">]</mo><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>δ</mi><msup><mi>δ</mi><mo>∗</mo></msup></mfrac></mstyle><mi>σ</mi><msub><mrow></mrow><mi>R</mi></msub><mo>[</mo><mi>t</mi><mo>−</mo><mo stretchy="false">(</mo><mi>δ</mi><mo>+</mo><mi>δ</mi><msup><mrow></mrow><mo>∗</mo></msup><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟙</mn><msub><mrow></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub><mo>]</mo><mo>=</mo><mo>{</mo><mtable columnspacing="0pt" rowspacing="0pt"><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>&lt;</mo><mrow><mn>0</mn><mo lspace="0.330em" rspace="0em">​</mo><mi>or</mi><mo lspace="0.330em" rspace="0em">​</mo><mi>t</mi></mrow><mo>≥</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mo>−</mo><mi>t</mi></mrow><mo>,</mo></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mi>δ</mi></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mi>δ</mi><msup><mi>δ</mi><mo>∗</mo></msup></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><mi>δ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><msup><mi>δ</mi><mo>∗</mo></msup></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>δ</mi><mo>≤</mo><mi>t</mi><mo>≤</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow><annotation encoding="application/x-tex">\displaystyle-\sigma_{R}[t]+\frac{\delta+\delta^{*}}{\delta^{*}}\sigma_{R}[t-\delta\cdot\mathds{1}_{d\times L}]-\frac{\delta}{\delta^{*}}\sigma_{R}\left[t-(\delta+\delta^{*})\cdot\mathds{1}_{d\times L}\right]=\left\{\begin{aligned} &amp;0,&amp;&amp;t&lt;0~\mathrm{or}~t\geq\delta+\delta^{*},\\
&amp;-t,&amp;&amp;0\leq t\leq\delta,\\
&amp;\frac{\delta}{\delta^{*}}t-\frac{\delta(\delta+\delta^{*})}{\delta^{*}},&amp;&amp;\delta\leq t\leq\delta+\delta^{*}.\end{aligned}\right.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<ul id="A2.I2" class="ltx_itemize">
<li id="A2.I2.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i1.p1" class="ltx_para">
<p id="A2.I2.i1.p1.1" class="ltx_p">Layer <math id="A2.I2.i1.p1.m1" class="ltx_Math" alttext="\mathrm{FF}^{(i,j,k+1)}" display="inline" intent=":literal"><semantics><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>j</mi><mo>,</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathrm{FF}^{(i,j,k+1)}</annotation></semantics></math> maps the elements of <math id="A2.I2.i1.p1.m2" class="ltx_Math" alttext="i" display="inline" intent=":literal"><semantics><mi>i</mi><annotation encoding="application/x-tex">i</annotation></semantics></math>-row of <math id="A2.I2.i1.p1.m3" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> into <math id="A2.I2.i1.p1.m4" class="ltx_Math" alttext="j+k(\delta+\delta^{*})" display="inline" intent=":literal"><semantics><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">j+k(\delta+\delta^{*})</annotation></semantics></math>, if those elements are in the target cube <math id="A2.I2.i1.p1.m5" class="ltx_Math" alttext="[j+k(\delta+\delta^{*}),j+k(\delta+\delta^{*})+\delta]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>δ</mi></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[j+k(\delta+\delta^{*}),j+k(\delta+\delta^{*})+\delta]</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I2.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I2.i2.p1" class="ltx_para">
<p id="A2.I2.i2.p1.1" class="ltx_p">For the remaining elements in the separation gap cube <math id="A2.I2.i2.p1.m1" class="ltx_Math" alttext="\left[j+k(\delta+\delta^{*})+\delta,j+(k+1)(\delta+\delta^{*})\right]" display="inline" intent=":literal"><semantics><mrow><mo>[</mo><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mi>δ</mi></mrow><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo>]</mo></mrow><annotation encoding="application/x-tex">\left[j+k(\delta+\delta^{*})+\delta,j+(k+1)(\delta+\delta^{*})\right]</annotation></semantics></math>, although they are mapped to random values in <math id="A2.I2.i2.p1.m2" class="ltx_Math" alttext="[j+k(\delta+\delta^{*}),j+(k+1)(\delta+\delta^{*})]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo><mrow><mi>j</mi><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>k</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[j+k(\delta+\delta^{*}),j+(k+1)(\delta+\delta^{*})]</annotation></semantics></math>, the measure of those points is small and won’t cause much disturbance to the final conclusion of approximation upper bound, which will be checked carefully in the subsequent verification part.</p>
</div></li>
</ul>
<p id="A2.SS3.SSS1.p2.4" class="ltx_p"><span id="A2.SS3.SSS1.p2.4.1" class="ltx_text">Stack all above <math id="A2.SS3.SSS1.p2.m10" class="ltx_Math" alttext="dLM=d_{0}M" display="inline" intent=":literal"><semantics><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>=</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow></mrow><annotation encoding="application/x-tex">dLM=d_{0}M</annotation></semantics></math> layers, and we construct</span></p>
<table id="A2.E25" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E25.m1" class="ltx_math_unparsed" alttext="f_{\mathcal{T}1}(X)=\mathrm{FF}^{(d,L,M)}\circ\cdots\circ\mathrm{FF}^{(1,1,1)}(X+E)." display="block" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo>=</mo><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>d</mi><mo>,</mo><mi>L</mi><mo>,</mo><mi>M</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mi>X</mi><mo>+</mo><mi>E</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}1}(X)=\mathrm{FF}^{(d,L,M)}\circ\cdots\circ\mathrm{FF}^{(1,1,1)}(X+E).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(25)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS1.p2.5" class="ltx_p"><span id="A2.SS3.SSS1.p2.5.1" class="ltx_text">The quantization module <math id="A2.SS3.SSS1.p2.m11" class="ltx_Math" alttext="f_{\mathcal{T}1}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}1}</annotation></semantics></math> maps elements of <math id="A2.SS3.SSS1.p2.m12" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math> in <math id="A2.SS3.SSS1.p2.m13" class="ltx_Math" alttext="\bigcup_{G}\mathcal{S}_{G}" display="inline" intent=":literal"><semantics><mrow><msub><mo>⋃</mo><mi>G</mi></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow><annotation encoding="application/x-tex">\bigcup_{G}\mathcal{S}_{G}</annotation></semantics></math> to the left-hand end points of their target cubes with a form of <math id="A2.SS3.SSS1.p2.m14" class="ltx_Math" alttext="j+k(\delta+\delta^{*})," display="inline" intent=":literal"><semantics><mrow><mrow><mi>j</mi><mo>+</mo><mrow><mi>k</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">j+k(\delta+\delta^{*}),</annotation></semantics></math> as these elements must be in one of the target cubes. Therefore, we create the clean grid <math id="A2.SS3.SSS1.p2.m15" class="ltx_Math" alttext="\mathcal{G}_{\delta,\delta^{*}}^{p}=\mathcal{G}_{\delta,\delta^{*}}+E" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup><mo>=</mo><mrow><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></msub><mo>+</mo><mi>E</mi></mrow></mrow><annotation encoding="application/x-tex">\mathcal{G}_{\delta,\delta^{*}}^{p}=\mathcal{G}_{\delta,\delta^{*}}+E</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem3" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem3.2" class="ltx_text ltx_font_bold">Remark B.3</span></span><span id="A2.Thmtheorem3.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem3.p1" class="ltx_para">
<p id="A2.Thmtheorem3.p1.1" class="ltx_p">Further dive into (<a href="#A2.E25" title="Equation 25 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">25</span></a>), we can just combine all ReLU units of the <math id="A2.Thmtheorem3.p1.m1" class="ltx_Math" alttext="dLM" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><annotation encoding="application/x-tex">dLM</annotation></semantics></math> layers into a single feed-forward layer by boosting the layer width instead of increasing the depth, which makes room for a simple and flexible trade-off between the depth and width.</p>
</div>
</div>
</section>
<section id="A2.SS3.SSS2" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.3.2 </span>Contextual Mapping <math id="A2.SS3.SSS2.m1" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math></h4>

<div id="A2.SS3.SSS2.p1" class="ltx_para">
<p id="A2.SS3.SSS2.p1.1" class="ltx_p"><cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib40" title="" class="ltx_ref">Yun et al. (2020)</a></cite> pointed out that
sequence models like Transformers should distinguish between different input sequences sharing same tokens, and then proposed an essential module called the contextual mapping which is composed of numerous self-attention layers with Hardmax operators. Furthermore, <cite class="ltx_cite ltx_citemacro_citet"><a href="#bib.bib19" title="" class="ltx_ref">Kajitsuka &amp; Sato (2024)</a></cite> simplified <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib40" title="" class="ltx_ref">Yun et al., 2020</a>)</cite>’s methodology by designing a single self-attention layer contextual mapping based only on the Softmax operator. We utilize this essential contextual mapping in the approximation upper bound tasks.</p>
</div>
<div id="A2.Thmtheorem4" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem4.2" class="ltx_text ltx_font_bold">Lemma B.4</span></span><span id="A2.Thmtheorem4.3" class="ltx_text ltx_font_bold"> </span>(Modified Version of <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Kajitsuka &amp; Sato, 2024</a>, Lemma 2.2)</cite>)<span id="A2.Thmtheorem4.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem4.p1" class="ltx_para">
<p id="A2.Thmtheorem4.p1.1" class="ltx_p"><span id="A2.Thmtheorem4.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem4.p1.m1" class="ltx_Math" alttext="X^{(1)},\ldots,X^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">X^{(1)},\ldots,X^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math> be <math id="A2.Thmtheorem4.p1.m2" class="ltx_Math" alttext="N" display="inline" intent=":literal"><semantics><mi>N</mi><annotation encoding="application/x-tex">N</annotation></semantics></math> input sequences with no duplicate word token in each sequence, that is, <math id="A2.Thmtheorem4.p1.m3" class="ltx_math_unparsed" alttext="X^{(i)}_{:,k}\neq X^{(i)}_{:,l}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≠</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">X^{(i)}_{:,k}\neq X^{(i)}_{:,l}</annotation></semantics></math>
for any <math id="A2.Thmtheorem4.p1.m4" class="ltx_Math" alttext="i\in[N]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[N]</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m5" class="ltx_Math" alttext="k,l\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[L]</annotation></semantics></math> with <math id="A2.Thmtheorem4.p1.m6" class="ltx_Math" alttext="k\neq l" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow><annotation encoding="application/x-tex">k\neq l</annotation></semantics></math>. Further assume <math id="A2.Thmtheorem4.p1.m7" class="ltx_Math" alttext="X^{(1)},\ldots,X^{(N)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X^{(1)},\ldots,X^{(N)}</annotation></semantics></math> are token-wise <math id="A2.Thmtheorem4.p1.m8" class="ltx_Math" alttext="(r_{\min},r_{\max},\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>min</mi></msub><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{\min},r_{\max},\beta)</annotation></semantics></math>-separated. Then, there exists a Softmax self-attention layer which is an <math id="A2.Thmtheorem4.p1.m9" class="ltx_Math" alttext="(r,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\gamma)</annotation></semantics></math>-contextual mapping for the input sequences <math id="A2.Thmtheorem4.p1.m10" class="ltx_Math" alttext="X^{(1)},\ldots,X^{(N)}\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>N</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">X^{(1)},\ldots,X^{(N)}\in\mathbb{R}^{d\times L}</annotation></semantics></math> with <math id="A2.Thmtheorem4.p1.m11" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and <math id="A2.Thmtheorem4.p1.m12" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> defined by</span></p>
<table id="A2.Ex16" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex16.m1" class="ltx_Math" alttext="r=r_{\max}+\frac{\beta}{4},~~\mathrm{and}~~\gamma=\frac{r_{\min}(\beta\log L)^{2}}{4dr_{\max}^{2}(2\log L+3)(\left|\mathcal{V}\right|+1)^{4}}\exp\Big(-(\left|\mathcal{V}\right|+1)^{4}\frac{2dr_{\max}^{2}(2\log L+3)}{\beta r_{\min}}\Big)." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>r</mi><mo>=</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mfrac><mi>β</mi><mn>4</mn></mfrac></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mi>and</mi><mo lspace="0.660em" rspace="0em">​</mo><mi>γ</mi></mrow><mo>=</mo><mrow><mfrac><mrow><msub><mi>r</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>β</mi><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r=r_{\max}+\frac{\beta}{4},~~\mathrm{and}~~\gamma=\frac{r_{\min}(\beta\log L)^{2}}{4dr_{\max}^{2}(2\log L+3)(\left|\mathcal{V}\right|+1)^{4}}\exp\Big(-(\left|\mathcal{V}\right|+1)^{4}\frac{2dr_{\max}^{2}(2\log L+3)}{\beta r_{\min}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.SS3.SSS2.p2" class="ltx_para">
<p id="A2.SS3.SSS2.p2.1" class="ltx_p"><span id="A2.SS3.SSS2.p2.1.1" class="ltx_text ltx_font_bold">Based on Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4 (Modified Version of ( , , Lemma 2.2)). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a></span>, we can prove the following lemma for our constructed contextual mapping <math id="A2.SS3.SSS2.p2.m1" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math>.</p>
</div>
<div id="A2.SS3.SSS2.p3" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS2.p3.1" class="ltx_p"><span id="A2.SS3.SSS2.p3.1.1" class="ltx_text ltx_font_bold">Lemma <a href="#S4.Thmtheorem10" title="Lemma 4.10 (Contextual Mapping 𝑓_{𝒯⁢2}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a></span> (Contextual Mapping <math id="A2.SS3.SSS2.p3.m1" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math>; Restatement)<span id="A2.SS3.SSS2.p3.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A2.SS3.SSS2.p3.1.3" class="ltx_text ltx_font_italic">All the <math id="A2.SS3.SSS2.p3.m2" class="ltx_Math" alttext="M^{d_{0}}" display="inline" intent=":literal"><semantics><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><annotation encoding="application/x-tex">M^{d_{0}}</annotation></semantics></math> grid points <math id="A2.SS3.SSS2.p3.m3" class="ltx_Math" alttext="G\in\mathcal{G}_{\delta,\delta^{*}}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow><annotation encoding="application/x-tex">G\in\mathcal{G}_{\delta,\delta^{*}}^{p}</annotation></semantics></math> are <math id="A2.SS3.SSS2.p3.m4" class="ltx_Math" alttext="(\sqrt{d},\sqrt{d}(L+1),\sqrt{d}(\delta+\delta^{*}))" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msqrt><mi>d</mi></msqrt><mo>,</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\sqrt{d},\sqrt{d}(L+1),\sqrt{d}(\delta+\delta^{*}))</annotation></semantics></math>-separated. A single self-attention layer equipped with one Softmax head, can be an <math id="A2.SS3.SSS2.p3.m5" class="ltx_Math" alttext="(r,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\gamma)</annotation></semantics></math>-contextual mapping <math id="A2.SS3.SSS2.p3.m6" class="ltx_Math" alttext="f_{\mathcal{T}2}:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}2}:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> for the input sequences <math id="A2.SS3.SSS2.p3.m7" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>, satisfying</span></p>
<ol id="A2.I3" class="ltx_enumerate">
<li id="A2.I3.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I3.i1.p1" class="ltx_para">
<p id="A2.I3.i1.p1.1" class="ltx_p"><span id="A2.I3.i1.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A2.I3.i1.p1.m1" class="ltx_Math" alttext="i\in[M^{d_{0}}]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[M^{d_{0}}]</annotation></semantics></math><span id="A2.I3.i1.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A2.I3.i1.p1.m2" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math><span id="A2.I3.i1.p1.1.3" class="ltx_text ltx_font_italic">, the boundedness </span><math id="A2.I3.i1.p1.m3" class="ltx_math_unparsed" alttext="\big\|{f_{\mathcal{T}2}(G^{(i)})_{:,k}}\big\|_{2}\leq r" display="inline" intent=":literal"><semantics><mrow><mo mathsize="1.200em" rspace="0.167em">∥</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\big\|{f_{\mathcal{T}2}(G^{(i)})_{:,k}}\big\|_{2}\leq r</annotation></semantics></math><span id="A2.I3.i1.p1.1.4" class="ltx_text ltx_font_italic"> holds.</span></p>
</div></li>
<li id="A2.I3.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I3.i2.p1" class="ltx_para">
<p id="A2.I3.i2.p1.1" class="ltx_p"><span id="A2.I3.i2.p1.1.1" class="ltx_text ltx_font_italic">For any </span><math id="A2.I3.i2.p1.m1" class="ltx_Math" alttext="i,j\in[M^{d_{0}}]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[M^{d_{0}}]</annotation></semantics></math><span id="A2.I3.i2.p1.1.2" class="ltx_text ltx_font_italic"> and </span><math id="A2.I3.i2.p1.m2" class="ltx_Math" alttext="k,l\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[L]</annotation></semantics></math><span id="A2.I3.i2.p1.1.3" class="ltx_text ltx_font_italic"> such that either </span><math id="A2.I3.i2.p1.m3" class="ltx_Math" alttext="\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}</annotation></semantics></math><span id="A2.I3.i2.p1.1.4" class="ltx_text ltx_font_italic"> or </span><math id="A2.I3.i2.p1.m4" class="ltx_math_unparsed" alttext="G_{:,k}^{(i)}\neq G_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">G_{:,k}^{(i)}\neq G_{:,l}^{(j)}</annotation></semantics></math><span id="A2.I3.i2.p1.1.5" class="ltx_text ltx_font_italic">, the separatedness </span><math id="A2.I3.i2.p1.m5" class="ltx_math_unparsed" alttext="\left\lVert f_{\mathcal{T}2}(G^{(~i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}\geq\gamma" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo rspace="0.270em" stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mi>γ</mi></mrow><annotation encoding="application/x-tex">\left\lVert f_{\mathcal{T}2}(G^{(~i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}\geq\gamma</annotation></semantics></math><span id="A2.I3.i2.p1.1.6" class="ltx_text ltx_font_italic"> holds.</span></p>
</div></li>
</ol>
<p id="A2.SS3.SSS2.p3.2" class="ltx_p"><span id="A2.SS3.SSS2.p3.2.1" class="ltx_text ltx_font_italic">with <math id="A2.SS3.SSS2.p3.m8" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> and <math id="A2.SS3.SSS2.p3.m9" class="ltx_Math" alttext="\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\gamma</annotation></semantics></math> defined by <math id="A2.SS3.SSS2.p3.m10" class="ltx_Math" alttext="r=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">r=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p3.m11" class="ltx_Math" alttext="\gamma=\tilde{\mathcal{O}}\left(\exp\left(-\frac{L^{6}M^{4d_{0}}}{\delta+\delta^{*}}\right)\right)" display="inline" intent=":literal"><semantics><mrow><mi>γ</mi><mo>=</mo><mrow><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo>(</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo>(</mo><mrow><mo>−</mo><mfrac><mrow><msup><mi>L</mi><mn>6</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msup></mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac></mrow><mo>)</mo></mrow></mrow><mo>)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\gamma=\tilde{\mathcal{O}}\left(\exp\left(-\frac{L^{6}M^{4d_{0}}}{\delta+\delta^{*}}\right)\right)</annotation></semantics></math>. </span></p>
</div>
<div id="A2.SS3.SSS2.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS2.2.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#S4.Thmtheorem10" title="Lemma 4.10 (Contextual Mapping 𝑓_{𝒯⁢2}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.10</span></a></span>.</h6>
<div id="A2.SS3.SSS2.p4" class="ltx_para">
<p id="A2.SS3.SSS2.p4.2" class="ltx_p"><span id="A2.SS3.SSS2.p4.2.1" class="ltx_text">The positional encoding <math id="A2.SS3.SSS2.p4.m1" class="ltx_Math" alttext="E" display="inline" intent=":literal"><semantics><mi>E</mi><annotation encoding="application/x-tex">E</annotation></semantics></math> helps any grid point <math id="A2.SS3.SSS2.p4.m2" class="ltx_Math" alttext="G\in\mathcal{G}_{\delta,\delta^{*}}^{p}" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow><annotation encoding="application/x-tex">G\in\mathcal{G}_{\delta,\delta^{*}}^{p}</annotation></semantics></math> meet the no duplicate token condition. It’s easy to check that <math id="A2.SS3.SSS2.p4.m3" class="ltx_Math" alttext="|{\mathcal{G}_{\delta,\delta^{*}}^{p}}|=M^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">|</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup><mo stretchy="false">|</mo></mrow><mo>=</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">|{\mathcal{G}_{\delta,\delta^{*}}^{p}}|=M^{d_{0}}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p4.m4" class="ltx_Math" alttext="\left|\mathcal{V}_{\mathcal{G}}\right|=LM^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><msub><mi class="ltx_font_mathcaligraphic">𝒱</mi><mi class="ltx_font_mathcaligraphic">𝒢</mi></msub><mo>|</mo></mrow><mo>=</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">\left|\mathcal{V}_{\mathcal{G}}\right|=LM^{d_{0}}</annotation></semantics></math> with <math id="A2.SS3.SSS2.p4.m5" class="ltx_Math" alttext="M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor." display="inline" intent=":literal"><semantics><mrow><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor.</annotation></semantics></math>
Furthermore, all grid points of <math id="A2.SS3.SSS2.p4.m6" class="ltx_Math" alttext="\mathcal{G}^{p}_{\delta,\delta^{*}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup><annotation encoding="application/x-tex">\mathcal{G}^{p}_{\delta,\delta^{*}}</annotation></semantics></math> are <math id="A2.SS3.SSS2.p4.m7" class="ltx_Math" alttext="\left(\sqrt{d},\sqrt{d}(L+1),\sqrt{d}(\delta+\delta^{*})\right)" display="inline" intent=":literal"><semantics><mrow><mo>(</mo><msqrt><mi>d</mi></msqrt><mo>,</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>)</mo></mrow><annotation encoding="application/x-tex">\left(\sqrt{d},\sqrt{d}(L+1),\sqrt{d}(\delta+\delta^{*})\right)</annotation></semantics></math>-separated, that is, for any <math id="A2.SS3.SSS2.p4.m8" class="ltx_Math" alttext="k,l\in[L],k\neq l" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>≠</mo><mi>l</mi></mrow></mrow><annotation encoding="application/x-tex">k,l\in[L],k\neq l</annotation></semantics></math>,</span></p>
<table id="A2.Ex17" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex17X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert G_{:,k}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\lVert G_{:,k}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17X.m3" class="ltx_Math" alttext="\displaystyle\geq\sqrt{d}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><msqrt><mi>d</mi></msqrt></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sqrt{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17Xa.m2" class="ltx_Math" alttext="\displaystyle\left\lVert G_{:,k}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\lVert G_{:,k}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17Xa.m3" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d}(L+1-(\delta+\delta^{*}))\leq\sqrt{d}(L+1)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo>−</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d}(L+1-(\delta+\delta^{*}))\leq\sqrt{d}(L+1),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex17Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex17Xb.m2" class="ltx_Math" alttext="\displaystyle\left\lVert G_{:,k}-G_{:,l}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>G</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\lVert G_{:,k}-G_{:,l}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex17Xb.m3" class="ltx_Math" alttext="\displaystyle\geq\sqrt{d}(\delta+\delta^{*})." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\sqrt{d}(\delta+\delta^{*}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p4.3" class="ltx_p"><span id="A2.SS3.SSS2.p4.3.1" class="ltx_text">Directly apply Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4 (Modified Version of ( , , Lemma 2.2)). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a> to the grid set <math id="A2.SS3.SSS2.p4.m9" class="ltx_Math" alttext="\mathcal{G}^{p}_{\delta,\delta^{*}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup><annotation encoding="application/x-tex">\mathcal{G}^{p}_{\delta,\delta^{*}}</annotation></semantics></math>, and we can get the <math id="A2.SS3.SSS2.p4.m10" class="ltx_Math" alttext="(r,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\gamma)</annotation></semantics></math>-contextual mapping <math id="A2.SS3.SSS2.p4.m11" class="ltx_Math" alttext="f_{\mathcal{T}2}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}2}</annotation></semantics></math> composed of a single self-attention layer
where</span></p>
<table id="A2.E26" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E26X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E26X.m2" class="ltx_Math" alttext="\displaystyle r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">\displaystyle r</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E26X.m3" class="ltx_Math" alttext="\displaystyle=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(26)</span></td></tr>
<tr id="A2.E26Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E26Xa.m2" class="ltx_Math" alttext="\displaystyle\gamma" display="inline" intent=":literal"><semantics><mi>γ</mi><annotation encoding="application/x-tex">\displaystyle\gamma</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E26Xa.m3" class="ltx_Math" alttext="\displaystyle=\frac{(\delta+\delta^{*})^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac></mstyle></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(\delta+\delta^{*})^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p4.4" class="ltx_p"><span id="A2.SS3.SSS2.p4.4.1" class="ltx_text">We have obtained the main results.
∎</span></p>
</div>
</div>
<div id="A2.SS3.SSS2.p5" class="ltx_para">
<p id="A2.SS3.SSS2.p5.1" class="ltx_p">Now it is crucial to ensure the correctness of Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4 (Modified Version of ( , , Lemma 2.2)). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>. We restate several lemmas first.</p>
</div>
<div id="A2.Thmtheorem5" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem5.2" class="ltx_text ltx_font_bold">Lemma B.5</span></span><span id="A2.Thmtheorem5.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_citep"><a href="#bib.bib26" title="" class="ltx_ref">Park et al., 2021</a>, Lemma 13</cite>)<span id="A2.Thmtheorem5.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem5.p1" class="ltx_para">
<p id="A2.Thmtheorem5.p1.1" class="ltx_p"><span id="A2.Thmtheorem5.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem5.p1.m1" class="ltx_Math" alttext="N,d\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>N</mi><mo>,</mo><mi>d</mi></mrow><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">N,d\in\mathbb{N}_{+}</annotation></semantics></math>. For any <math id="A2.Thmtheorem5.p1.m2" class="ltx_math_unparsed" alttext="\mathcal{X}=\{x^{(i)}\mid x^{(i)}\in\mathbb{R}^{d},i=1,2,\ldots,N\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>=</mo><mrow><mo stretchy="false">{</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0.167em">∣</mo><msup><mi>x</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup><mo>,</mo><mi>i</mi><mo>=</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>N</mi><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{X}=\{x^{(i)}\mid x^{(i)}\in\mathbb{R}^{d},i=1,2,\ldots,N\}</annotation></semantics></math>, there exists a unit vector <math id="A2.Thmtheorem5.p1.m3" class="ltx_Math" alttext="u\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">u\in\mathbb{R}^{d}</annotation></semantics></math> such that</span></p>
<table id="A2.Ex18" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex18.m1" class="ltx_Math" alttext="\frac{1}{N^{2}}\sqrt{\frac{8}{\pi d}}\left\lVert x-x^{\prime}\right\rVert_{2}\leq\left|u^{\top}(x-x^{\prime})\right|\leq\left\lVert x-x^{\prime}\right\rVert_{2},~\text{ for all }x,x^{\prime}\in\mathcal{X}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mfrac><mn>1</mn><msup><mi>N</mi><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mn>8</mn><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo>|</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><mi>x</mi><mo>−</mo><msup><mi>x</mi><mo>′</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo rspace="0.497em">,</mo><mrow><mtext class="ltx_mathvariant_italic"> for all </mtext><mo lspace="0em" rspace="0em">​</mo><mi>x</mi></mrow><mo>,</mo><mrow><msup><mi>x</mi><mo>′</mo></msup><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{N^{2}}\sqrt{\frac{8}{\pi d}}\left\lVert x-x^{\prime}\right\rVert_{2}\leq\left|u^{\top}(x-x^{\prime})\right|\leq\left\lVert x-x^{\prime}\right\rVert_{2},~\text{ for all }x,x^{\prime}\in\mathcal{X}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
</div>
<div id="A2.Thmtheorem6" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem6.2" class="ltx_text ltx_font_bold">Lemma B.6</span></span><span id="A2.Thmtheorem6.3" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem6.p1" class="ltx_para">
<p id="A2.Thmtheorem6.p1.1" class="ltx_p"><span id="A2.Thmtheorem6.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem6.p1.m1" class="ltx_Math" alttext="r_{\min},r_{\max},\beta&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>r</mi><mi>min</mi></msub><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub><mo>,</mo><mrow><mi>β</mi><mo>&gt;</mo><mn>0</mn></mrow></mrow><annotation encoding="application/x-tex">r_{\min},r_{\max},\beta&gt;0</annotation></semantics></math>. Given an <math id="A2.Thmtheorem6.p1.m2" class="ltx_Math" alttext="(r_{\min},r_{\max},\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>min</mi></msub><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{\min},r_{\max},\beta)</annotation></semantics></math>-separated vocabulary <math id="A2.Thmtheorem6.p1.m3" class="ltx_Math" alttext="\mathcal{V}\subset\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>⊂</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}\subset\mathbb{R}^{d}</annotation></semantics></math> with <math id="A2.Thmtheorem6.p1.m4" class="ltx_Math" alttext="\left|\mathcal{V}\right|&lt;+\infty" display="inline" intent=":literal"><semantics><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>&lt;</mo><mrow><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mrow><annotation encoding="application/x-tex">\left|\mathcal{V}\right|&lt;+\infty</annotation></semantics></math>. For any <math id="A2.Thmtheorem6.p1.m5" class="ltx_Math" alttext="\delta_{0}&gt;0" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>0</mn></msub><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\delta_{0}&gt;0</annotation></semantics></math>, there exists a unit vector <math id="A2.Thmtheorem6.p1.m6" class="ltx_Math" alttext="{v}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{v}\in\mathbb{R}^{d}</annotation></semantics></math> such that for any vectors <math id="A2.Thmtheorem6.p1.m7" class="ltx_Math" alttext="{u},{u}^{\prime}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>,</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{u},{u}^{\prime}\in\mathbb{R}^{m}</annotation></semantics></math> with</span></p>
<table id="A2.Ex19" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex19.m1" class="ltx_Math" alttext="\left|u^{\top}u^{\prime}\right|=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo>|</mo></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|u^{\top}u^{\prime}\right|=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem6.p1.2" class="ltx_p"><span id="A2.Thmtheorem6.p1.2.1" class="ltx_text ltx_font_italic">we have</span></p>
<table id="A2.Ex20" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex20.m1" class="ltx_Math" alttext="\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|\geq\delta_{0},~~\mathrm{and}~~~\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>a</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mi>and</mi><mo lspace="0.990em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|\geq\delta_{0},~~\mathrm{and}~~~\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem6.p1.3" class="ltx_p"><span id="A2.Thmtheorem6.p1.3.1" class="ltx_text ltx_font_italic">for any <math id="A2.Thmtheorem6.p1.m8" class="ltx_Math" alttext="{v}_{a},{v}_{b},{v}_{c}\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>,</mo><msub><mi>v</mi><mi>b</mi></msub><mo>,</mo><mrow><msub><mi>v</mi><mi>c</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow><annotation encoding="application/x-tex">{v}_{a},{v}_{b},{v}_{c}\in\mathcal{V}</annotation></semantics></math> with <math id="A2.Thmtheorem6.p1.m9" class="ltx_Math" alttext="{v}_{a}\neq{v}_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>≠</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">{v}_{a}\neq{v}_{b}</annotation></semantics></math>, where <math id="A2.Thmtheorem6.p1.m10" class="ltx_Math" alttext="{W}_{K}={u}{v}^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{W}_{K}={u}{v}^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math> and <math id="A2.Thmtheorem6.p1.m11" class="ltx_Math" alttext="{W}_{Q}={u}^{\prime}{v}^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>Q</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{W}_{Q}={u}^{\prime}{v}^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.SSS2.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS2.3.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#A2.Thmtheorem6" title="Lemma B.6. ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a></span>.</h6>
<div id="A2.SS3.SSS2.p6" class="ltx_para">
<p id="A2.SS3.SSS2.p6.1" class="ltx_p"><span id="A2.SS3.SSS2.p6.1.1" class="ltx_text">By applying Lemma <a href="#A2.Thmtheorem5" title="Lemma B.5 ( , , Lemma 13). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.5</span></a> to <math id="A2.SS3.SSS2.p6.m1" class="ltx_Math" alttext="\mathcal{V}\cup\{0\}" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{V}\cup\{0\}</annotation></semantics></math>, we know that there exists a unit vector <math id="A2.SS3.SSS2.p6.m2" class="ltx_Math" alttext="{v}\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">{v}\in\mathbb{R}^{d}</annotation></semantics></math> such that for any <math id="A2.SS3.SSS2.p6.m3" class="ltx_Math" alttext="{v}_{a},{v}_{b}\in\mathcal{V}\cup\{0\}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>,</mo><mrow><msub><mi>v</mi><mi>b</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>∪</mo><mrow><mo stretchy="false">{</mo><mn>0</mn><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">{v}_{a},{v}_{b}\in\mathcal{V}\cup\{0\}</annotation></semantics></math> with <math id="A2.SS3.SSS2.p6.m4" class="ltx_Math" alttext="{v}_{a}\neq{v}_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>≠</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">{v}_{a}\neq{v}_{b}</annotation></semantics></math>, we have</span></p>
<table id="A2.E27" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E27.m1" class="ltx_Math" alttext="\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\leq\frac{1}{(|\mathcal{V}|+1)^{2}}\sqrt{\frac{8}{\pi d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\leq|{v}^{\top}({v}_{a}-{v}_{b})|\leq\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mfrac><mn>1</mn><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mfrac><mo lspace="0em" rspace="0em">​</mo><msqrt><mfrac><mn>8</mn><mrow><mi>π</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mfrac></msqrt><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\leq\frac{1}{(|\mathcal{V}|+1)^{2}}\sqrt{\frac{8}{\pi d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\leq|{v}^{\top}({v}_{a}-{v}_{b})|\leq\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(27)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p6.2" class="ltx_p"><span id="A2.SS3.SSS2.p6.2.1" class="ltx_text">In particular, (<a href="#A2.E27" title="Equation 27 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) also means that for any <math id="A2.SS3.SSS2.p6.m5" class="ltx_Math" alttext="{v}_{c}\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>c</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow><annotation encoding="application/x-tex">{v}_{c}\in\mathcal{V}</annotation></semantics></math>, we have by setting the other vector equal to zero</span></p>
<table id="A2.E28" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E28.m1" class="ltx_Math" alttext="\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(28)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p6.3" class="ltx_p"><span id="A2.SS3.SSS2.p6.3.1" class="ltx_text">Furthermore, pick up two arbitrary vectors <math id="A2.SS3.SSS2.p6.m6" class="ltx_Math" alttext="{u},{u}^{\prime}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>,</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{u},{u}^{\prime}\in\mathbb{R}^{m}</annotation></semantics></math> satisfying</span></p>
<table id="A2.Ex21" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex21.m1" class="ltx_Math" alttext="|{u}^{\top}{u}^{\prime}|=(|\mathcal{V}|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo stretchy="false">|</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo stretchy="false">|</mo></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">|{u}^{\top}{u}^{\prime}|=(|\mathcal{V}|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p6.4" class="ltx_p"><span id="A2.SS3.SSS2.p6.4.1" class="ltx_text">Setting <math id="A2.SS3.SSS2.p6.m7" class="ltx_Math" alttext="{W}_{K}={u}{v}^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{W}_{K}={u}{v}^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p6.m8" class="ltx_Math" alttext="{W}_{Q}={u}^{\prime}{v}^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>Q</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">{W}_{Q}={u}^{\prime}{v}^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math>, with
(<a href="#A2.E27" title="Equation 27 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">27</span></a>) and (<a href="#A2.E28" title="Equation 28 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">28</span></a>), we have</span></p>
<table id="A2.Ex22" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex22X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22X.m2" class="ltx_Math" alttext="\displaystyle\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>a</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22Xa.m2" class="ltx_Math" alttext="\displaystyle=\left|\left({v}_{a}-{v}_{b}\right)^{\top}{W}_{K}^{\top}{W}_{Q}{v}_{c}\right|=\left|\left({v}_{a}-{v}_{b}\right)^{\top}{v}\right|\cdot|{u}^{\top}{u}^{\prime}|\cdot|{v}^{\top}{v}_{c}|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>W</mi><mi>K</mi><mo>⊤</mo></msubsup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo>|</mo></mrow><mo>=</mo><mrow><mrow><mo>|</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><mi>v</mi></mrow><mo rspace="0.055em">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo rspace="0.055em" stretchy="false">|</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo stretchy="false">|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\left({v}_{a}-{v}_{b}\right)^{\top}{W}_{K}^{\top}{W}_{Q}{v}_{c}\right|=\left|\left({v}_{a}-{v}_{b}\right)^{\top}{v}\right|\cdot|{u}^{\top}{u}^{\prime}|\cdot|{v}^{\top}{v}_{c}|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex22Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex22Xb.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\cdot(|\mathcal{V}|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}\cdot\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\geq\delta_{0}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mrow><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>−</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo rspace="0.055em">‖</mo></mrow><mn>2</mn></msub></mrow><mo rspace="0.222em">⋅</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≥</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{a}-{v}_{b}\right\rVert_{2}\cdot(|\mathcal{V}|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}\cdot\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\geq\delta_{0},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p6.5" class="ltx_p"><span id="A2.SS3.SSS2.p6.5.1" class="ltx_text">where the last inequality comes from the <math id="A2.SS3.SSS2.p6.m9" class="ltx_Math" alttext="(r_{\min},r_{\max},\beta)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><msub><mi>r</mi><mi>min</mi></msub><mo>,</mo><msub><mi>r</mi><mi>max</mi></msub><mo>,</mo><mi>β</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r_{\min},r_{\max},\beta)</annotation></semantics></math>-separatedness of <math id="A2.SS3.SSS2.p6.m10" class="ltx_Math" alttext="\mathcal{V}" display="inline" intent=":literal"><semantics><mi class="ltx_font_mathcaligraphic">𝒱</mi><annotation encoding="application/x-tex">\mathcal{V}</annotation></semantics></math>.
∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem7" class="ltx_theorem ltx_theorem_lemma">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem7.2" class="ltx_text ltx_font_bold">Lemma B.7</span></span><span id="A2.Thmtheorem7.3" class="ltx_text ltx_font_bold"> </span>(<cite class="ltx_cite ltx_citemacro_citep"><a href="#bib.bib19" title="" class="ltx_ref">Kajitsuka &amp; Sato, 2024</a>, Lemma 1</cite>)<span id="A2.Thmtheorem7.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem7.p1" class="ltx_para">
<p id="A2.Thmtheorem7.p1.1" class="ltx_p"><span id="A2.Thmtheorem7.p1.1.1" class="ltx_text ltx_font_italic">Let <math id="A2.Thmtheorem7.p1.m1" class="ltx_Math" alttext="{a}^{(1)},\ldots,{a}^{(m)}\in\mathbb{R}^{L}" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>m</mi><mo stretchy="false">)</mo></mrow></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup></mrow></mrow><annotation encoding="application/x-tex">{a}^{(1)},\ldots,{a}^{(m)}\in\mathbb{R}^{L}</annotation></semantics></math> be token-wise <math id="A2.Thmtheorem7.p1.m2" class="ltx_Math" alttext="(\kappa,\delta_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><msub><mi>δ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\kappa,\delta_{0})</annotation></semantics></math>-separated vectors with no duplicate element in each vector and</span></p>
<table id="A2.Ex23" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex23.m1" class="ltx_Math" alttext="\delta_{0}\geq 2\log L+3." display="block" intent=":literal"><semantics><mrow><mrow><msub><mi>δ</mi><mn>0</mn></msub><mo>≥</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\delta_{0}\geq 2\log L+3.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem7.p1.2" class="ltx_p"><span id="A2.Thmtheorem7.p1.2.1" class="ltx_text ltx_font_italic">Then, the outputs of Boltzmann operator with the form <math id="A2.Thmtheorem7.p1.m3" class="ltx_Math" alttext="\mathrm{boltz}(a)=a^{\top}\sigma_{S}(a)" display="inline" intent=":literal"><semantics><mrow><mrow><mi>boltz</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msup><mi>a</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>a</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathrm{boltz}(a)=a^{\top}\sigma_{S}(a)</annotation></semantics></math> are <math id="A2.Thmtheorem7.p1.m4" class="ltx_Math" alttext="(\kappa,\delta_{1})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><msub><mi>δ</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\kappa,\delta_{1})</annotation></semantics></math>-separated, that is,</span></p>
<table id="A2.EGx5" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex24"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex24.m1" class="ltx_Math" alttext="\displaystyle\left\lVert\mathrm{boltz}({a}^{(i)})\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>boltz</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\mathrm{boltz}({a}^{(i)})\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex24.m2" class="ltx_Math" alttext="\displaystyle\leq\kappa," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mi>κ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\kappa,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex25"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex25.m1" class="ltx_Math" alttext="\displaystyle\left\lVert\mathrm{boltz}({a}^{(i)})-\mathrm{boltz}({a}^{(j)})\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mrow><mi>boltz</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mi>boltz</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\mathrm{boltz}({a}^{(i)})-\mathrm{boltz}({a}^{(j)})\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex25.m2" class="ltx_Math" alttext="\displaystyle&gt;\delta_{1}=(\log L)^{2}e^{-2\kappa}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>&gt;</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow></msup></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle&gt;\delta_{1}=(\log L)^{2}e^{-2\kappa},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem7.p1.3" class="ltx_p"><span id="A2.Thmtheorem7.p1.3.1" class="ltx_text ltx_font_italic">hold for each <math id="A2.Thmtheorem7.p1.m5" class="ltx_Math" alttext="i,j\in[m]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>m</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[m]</annotation></semantics></math> with <math id="A2.Thmtheorem7.p1.m6" class="ltx_Math" alttext="{a}^{(i)}\neq{a}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">{a}^{(i)}\neq{a}^{(j)}</annotation></semantics></math>.</span></p>
</div>
</div>
<div id="A2.SS3.SSS2.p7" class="ltx_para">
<p id="A2.SS3.SSS2.p7.1" class="ltx_p">Based on the core results of Lemma <a href="#A2.Thmtheorem6" title="Lemma B.6. ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a> and <a href="#A2.Thmtheorem7" title="Lemma B.7 ( , , Lemma 1). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a>, we now can prove Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4 (Modified Version of ( , , Lemma 2.2)). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a>.</p>
</div>
<div id="A2.SS3.SSS2.4" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS2.4.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#A2.Thmtheorem4" title="Lemma B.4 (Modified Version of ( , , Lemma 2.2)). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.4</span></a></span>.</h6>
<div id="A2.SS3.SSS2.p8" class="ltx_para">
<p id="A2.SS3.SSS2.p8.2" class="ltx_p"><span id="A2.SS3.SSS2.p8.2.1" class="ltx_text">There are three main targets,</span></p>
<ol id="A2.I4" class="ltx_enumerate">
<li id="A2.I4.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">1.</span> 
<div id="A2.I4.i1.p1" class="ltx_para">
<p id="A2.I4.i1.p1.1" class="ltx_p">Show that the upper bound of the contextual mapping is <math id="A2.I4.i1.p1.m1" class="ltx_Math" alttext="r=r_{\max}+\frac{\beta}{4}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mfrac><mi>β</mi><mn>4</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">r=r_{\max}+\frac{\beta}{4}</annotation></semantics></math>.</p>
</div></li>
<li id="A2.I4.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">2.</span> 
<div id="A2.I4.i2.p1" class="ltx_para">
<p id="A2.I4.i2.p1.1" class="ltx_p">Prove that the constructed self-attention head maps the different tokens to unique ids.</p>
</div></li>
<li id="A2.I4.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">3.</span> 
<div id="A2.I4.i3.p1" class="ltx_para">
<p id="A2.I4.i3.p1.1" class="ltx_p">Demonstrate that the self-attention layer distinguishes between the duplicate input tokens within different contexts.</p>
</div></li>
</ol>
<p id="A2.SS3.SSS2.p8.3" class="ltx_p"><span id="A2.SS3.SSS2.p8.3.1" class="ltx_text">For the first target, since the self-attention layer with one Softmax-head <math id="A2.SS3.SSS2.p8.m1" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> is represented as</span></p>
<table id="A2.E29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E29.m1" class="ltx_Math" alttext="\mathrm{Attn}(X)=X+H=X+W_{O}W_{V}X\sigma_{S}\left[(W_{K}X)^{\top}W_{Q}X\right]," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>Attn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mi>X</mi><mo>+</mo><mi>H</mi></mrow><mo>=</mo><mrow><mi>X</mi><mo>+</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><mo>]</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{Attn}(X)=X+H=X+W_{O}W_{V}X\sigma_{S}\left[(W_{K}X)^{\top}W_{Q}X\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(29)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.4" class="ltx_p"><span id="A2.SS3.SSS2.p8.4.1" class="ltx_text">we can construct a head satisfying <math id="A2.SS3.SSS2.p8.m2" class="ltx_Math" alttext="\left\lVert H\right\rVert_{2}\leq{\beta}/{4}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mi>H</mi><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><mi>β</mi><mo>/</mo><mn>4</mn></mrow></mrow><annotation encoding="application/x-tex">\left\lVert H\right\rVert_{2}\leq{\beta}/{4}</annotation></semantics></math> such that</span></p>
<table id="A2.E30" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E30.m1" class="ltx_math_unparsed" alttext="\big\|{\mathrm{Attn}(X^{(i)})_{:,k}}\big\|_{2}\leq\big\|{X_{:,k}^{(i)}}\big\|_{2}+\big\|{H_{:,k}^{(i)}}\big\|_{2}\leq r_{\max}+\frac{\beta}{4}\coloneq r,~~\mathrm{for~all}~i\in[N],k\in[L]." display="block" intent=":literal"><semantics><mrow><mo mathsize="1.200em" rspace="0.167em">∥</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≤</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mo lspace="0em" mathsize="1.200em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em" rspace="0em">+</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≤</mo><msub><mi>r</mi><mi>max</mi></msub><mo>+</mo><mfrac><mi>β</mi><mn>4</mn></mfrac><mo>≔</mo><mi>r</mi><mo rspace="0.827em">,</mo><mi>for</mi><mi>all</mi><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\|{\mathrm{Attn}(X^{(i)})_{:,k}}\big\|_{2}\leq\big\|{X_{:,k}^{(i)}}\big\|_{2}+\big\|{H_{:,k}^{(i)}}\big\|_{2}\leq r_{\max}+\frac{\beta}{4}\coloneq r,~~\mathrm{for~all}~i\in[N],k\in[L].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(30)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.5" class="ltx_p"><span id="A2.SS3.SSS2.p8.5.1" class="ltx_text">It is obvious that we can also have the lower bound</span></p>
<table id="A2.E31" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E31.m1" class="ltx_math_unparsed" alttext="\big\|{\mathrm{Attn}(X^{(i)})_{:,k}}\big\|_{2}\geq\big\|{X_{:,k}^{(i)}}\big\|_{2}-\big\|{H_{:,k}^{(i)}}\big\|_{2}\geq r_{\min}-\frac{\beta}{4}\coloneq r_{2},~~\mathrm{for~all}~i\in[N],k\in[L]." display="block" intent=":literal"><semantics><mrow><mo mathsize="1.200em" rspace="0.167em">∥</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">≥</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mo lspace="0em" mathsize="1.200em" rspace="0em">∥</mo><mn>2</mn></msub><mo lspace="0em" rspace="0em">−</mo><mo lspace="0em" mathsize="1.200em" rspace="0.167em">∥</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><msub><mo lspace="0em" mathsize="1.200em" rspace="0.0835em">∥</mo><mn>2</mn></msub><mo lspace="0.0835em">≥</mo><msub><mi>r</mi><mi>min</mi></msub><mo>−</mo><mfrac><mi>β</mi><mn>4</mn></mfrac><mo>≔</mo><msub><mi>r</mi><mn>2</mn></msub><mo rspace="0.827em">,</mo><mi>for</mi><mi>all</mi><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\big\|{\mathrm{Attn}(X^{(i)})_{:,k}}\big\|_{2}\geq\big\|{X_{:,k}^{(i)}}\big\|_{2}-\big\|{H_{:,k}^{(i)}}\big\|_{2}\geq r_{\min}-\frac{\beta}{4}\coloneq r_{2},~~\mathrm{for~all}~i\in[N],k\in[L].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(31)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.6" class="ltx_p"><span id="A2.SS3.SSS2.p8.6.1" class="ltx_text">For the second target, based on Lemma <a href="#A2.Thmtheorem6" title="Lemma B.6. ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.6</span></a>, we set <math id="A2.SS3.SSS2.p8.m3" class="ltx_Math" alttext="W_{K}=uv^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W_{K}=uv^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p8.m4" class="ltx_Math" alttext="W_{Q}=u^{\prime}v^{\top}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>Q</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W_{Q}=u^{\prime}v^{\top}\in\mathbb{R}^{m\times d}</annotation></semantics></math> with <math id="A2.SS3.SSS2.p8.m5" class="ltx_Math" alttext="u,u^{\prime}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>,</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow></mrow><annotation encoding="application/x-tex">u,u^{\prime}\in\mathbb{R}^{m}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p8.m6" class="ltx_Math" alttext="v\in\mathbb{R}^{d}" display="inline" intent=":literal"><semantics><mrow><mi>v</mi><mo>∈</mo><msup><mi>ℝ</mi><mi>d</mi></msup></mrow><annotation encoding="application/x-tex">v\in\mathbb{R}^{d}</annotation></semantics></math>. Let <math id="A2.SS3.SSS2.p8.m7" class="ltx_Math" alttext="\delta_{0}=2\log L+3" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\delta_{0}=2\log L+3</annotation></semantics></math> and fix these <math id="A2.SS3.SSS2.p8.m8" class="ltx_Math" alttext="u,u^{\prime}" display="inline" intent=":literal"><semantics><mrow><mi>u</mi><mo>,</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><annotation encoding="application/x-tex">u,u^{\prime}</annotation></semantics></math> by</span></p>
<table id="A2.E32" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E32.m1" class="ltx_Math" alttext="\left|u^{\top}u^{\prime}\right|=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}}," display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><msup><mi>u</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′</mo></msup></mrow><mo>|</mo></mrow><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\left|u^{\top}u^{\prime}\right|=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}}{\beta r_{\min}},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(32)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.7" class="ltx_p"><span id="A2.SS3.SSS2.p8.7.1" class="ltx_text">so we have for any <math id="A2.SS3.SSS2.p8.m9" class="ltx_Math" alttext="v_{a},v_{b},v_{c}\in\mathcal{V}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>,</mo><msub><mi>v</mi><mi>b</mi></msub><mo>,</mo><mrow><msub><mi>v</mi><mi>c</mi></msub><mo>∈</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi></mrow></mrow><annotation encoding="application/x-tex">v_{a},v_{b},v_{c}\in\mathcal{V}</annotation></semantics></math> with <math id="A2.SS3.SSS2.p8.m10" class="ltx_Math" alttext="v_{a}\neq v_{b}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>a</mi></msub><mo>≠</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><annotation encoding="application/x-tex">v_{a}\neq v_{b}</annotation></semantics></math>,</span></p>
<table id="A2.E33" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E33.m1" class="ltx_Math" alttext="\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|\geq\delta_{0}~~\text{and}~~\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>a</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo>−</mo><mrow><msup><mrow><mo>(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>b</mi></msub></mrow><mo>)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow></mrow><mo>|</mo></mrow><mo>≥</mo><mrow><msub><mi>δ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.660em" rspace="0em">​</mo><mfrac><mn>1</mn><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>≤</mo><mrow><mo stretchy="false">|</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>v</mi><mi>c</mi></msub></mrow><mo stretchy="false">|</mo></mrow><mo>≤</mo><msub><mrow><mo>‖</mo><msub><mi>v</mi><mi>c</mi></msub><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left|\left({W}_{K}{v}_{a}\right)^{\top}{W}_{Q}{v}_{c}-\left({W}_{K}{v}_{b}\right)^{\top}{W}_{Q}{v}_{c}\right|\geq\delta_{0}~~\text{and}~~\frac{1}{(|\mathcal{V}|+1)^{2}\sqrt{d}}\left\lVert{v}_{c}\right\rVert_{2}\leq|{v}^{\top}{v}_{c}|\leq\left\lVert{v}_{c}\right\rVert_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(33)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.8" class="ltx_p"><span id="A2.SS3.SSS2.p8.8.1" class="ltx_text">Furthermore, let the other two weight matrices <math id="A2.SS3.SSS2.p8.m11" class="ltx_Math" alttext="W_{V}\in\mathbb{R}^{m\times d}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>V</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>m</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W_{V}\in\mathbb{R}^{m\times d}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p8.m12" class="ltx_Math" alttext="W_{O}\in\mathbb{R}^{d\times m}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>O</mi></msub><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>m</mi></mrow></msup></mrow><annotation encoding="application/x-tex">W_{O}\in\mathbb{R}^{d\times m}</annotation></semantics></math> satisfy <math id="A2.SS3.SSS2.p8.m13" class="ltx_Math" alttext="W_{V}=u^{\prime\prime}v^{\top}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>V</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><annotation encoding="application/x-tex">W_{V}=u^{\prime\prime}v^{\top}</annotation></semantics></math> for any nonzero vector <math id="A2.SS3.SSS2.p8.m14" class="ltx_Math" alttext="u^{\prime\prime}\in\mathbb{R}^{m}" display="inline" intent=":literal"><semantics><mrow><msup><mi>u</mi><mo>′′</mo></msup><mo>∈</mo><msup><mi>ℝ</mi><mi>m</mi></msup></mrow><annotation encoding="application/x-tex">u^{\prime\prime}\in\mathbb{R}^{m}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p8.m15" class="ltx_Math" alttext="\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}=\frac{\beta}{4r_{\max}}" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′′</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mfrac><mi>β</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mrow><annotation encoding="application/x-tex">\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}=\frac{\beta}{4r_{\max}}</annotation></semantics></math>. As a result, the self-attention head <math id="A2.SS3.SSS2.p8.m16" class="ltx_Math" alttext="H" display="inline" intent=":literal"><semantics><mi>H</mi><annotation encoding="application/x-tex">H</annotation></semantics></math> can be bounded, since for any <math id="A2.SS3.SSS2.p8.m17" class="ltx_Math" alttext="k\in[L]" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k\in[L]</annotation></semantics></math></span></p>
<table id="A2.E34" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E34X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E34X.m2" class="ltx_Math" alttext="\displaystyle\Big\|{H_{:,k}^{(i)}}\Big\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo mathsize="1.600em" rspace="0.167em">∥</mo><mi>H</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" mathsize="1.600em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\Big\|{H_{:,k}^{(i)}}\Big\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34X.m3" class="ltx_Math" alttext="\displaystyle=\Big\|W_{O}W_{V}X^{(i)}\sigma_{S}\Big[\Big(W_{K}X^{(i)}\Big)^{\top}\Big(W_{Q}X_{:,k}^{(i)}\Big)\Big]\Big\|_{2}=\Big\|\sum_{k^{\prime}=1}^{n}\sigma_{S}[\cdot]_{k^{\prime}}W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\Big\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>W</mi><msub><mrow></mrow><mi>V</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo maxsize="1.600em" minsize="1.600em">[</mo><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>W</mi><msub><mrow></mrow><mi>K</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mo maxsize="1.600em" minsize="1.600em">(</mo><mi>W</mi><msub><mrow></mrow><mi>Q</mi></msub><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo><mo maxsize="1.600em" minsize="1.600em">]</mo><mo lspace="0em" mathsize="1.600em" rspace="0.0835em">∥</mo><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0.0835em" rspace="0em">=</mo><mo lspace="0em" mathsize="1.600em" rspace="0.167em">∥</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>W</mi><msub><mrow></mrow><mi>V</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo lspace="0em" mathsize="1.600em">∥</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\Big\|W_{O}W_{V}X^{(i)}\sigma_{S}\Big[\Big(W_{K}X^{(i)}\Big)^{\top}\Big(W_{Q}X_{:,k}^{(i)}\Big)\Big]\Big\|_{2}=\Big\|\sum_{k^{\prime}=1}^{n}\sigma_{S}[\cdot]_{k^{\prime}}W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\Big\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(34)</span></td></tr>
<tr id="A2.E34Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\sum_{k^{\prime}=1}^{n}\sigma_{S}[\cdot]_{k^{\prime}}\left\|W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\right\|_{2}\leq\max_{k^{\prime}\in[L]}\left\|W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mstyle displaystyle="true"><mo movablelimits="false">∑</mo></mstyle><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>=</mo><mn>1</mn></mrow></msub><msup><mrow></mrow><mi>n</mi></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo><msub><mrow></mrow><msup><mi>k</mi><mo>′</mo></msup></msub><mo>‖</mo><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>W</mi><msub><mrow></mrow><mi>V</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>≤</mo><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>W</mi><msub><mrow></mrow><mi>V</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sum_{k^{\prime}=1}^{n}\sigma_{S}[\cdot]_{k^{\prime}}\left\|W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\right\|_{2}\leq\max_{k^{\prime}\in[L]}\left\|W_{O}W_{V}X^{(i)}_{:,k^{\prime}}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E34Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34Xb.m2" class="ltx_Math" alttext="\displaystyle=\max_{k^{\prime}\in[L]}\left\lVert W_{O}u^{\prime\prime}v^{\top}X^{(i)}_{:,k^{\prime}}\right\rVert_{2}=\max_{k^{\prime}\in[L]}\left|v^{\top}X^{(i)}_{:,k^{\prime}}\right|\cdot\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>u</mi><msup><mrow></mrow><mo>′′</mo></msup><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>=</mo><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo fence="false" rspace="0.167em">|</mo><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo fence="false">|</mo><mo lspace="0em" rspace="0.222em">⋅</mo><mo>‖</mo><mi>W</mi><msub><mrow></mrow><mi>O</mi></msub><mi>u</mi><msup><mrow></mrow><mo>′′</mo></msup><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{k^{\prime}\in[L]}\left\lVert W_{O}u^{\prime\prime}v^{\top}X^{(i)}_{:,k^{\prime}}\right\rVert_{2}=\max_{k^{\prime}\in[L]}\left|v^{\top}X^{(i)}_{:,k^{\prime}}\right|\cdot\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E34Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E34Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{k^{\prime}\in[L]}\left\lVert X^{(i)}_{:,k^{\prime}}\right\rVert_{2}\cdot\frac{\beta}{4r_{\max}}\leq\frac{\beta}{4}," display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo rspace="0.055em">‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mstyle><mo>≤</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>4</mn></mfrac></mstyle><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{k^{\prime}\in[L]}\left\lVert X^{(i)}_{:,k^{\prime}}\right\rVert_{2}\cdot\frac{\beta}{4r_{\max}}\leq\frac{\beta}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p8.9" class="ltx_p"><span id="A2.SS3.SSS2.p8.9.1" class="ltx_text">where <math id="A2.SS3.SSS2.p8.m18" class="ltx_Math" alttext="\sigma_{S}[\cdot]_{k^{\prime}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo stretchy="false">[</mo><mo lspace="0em" rspace="0em">⋅</mo><mo stretchy="false">]</mo></mrow><msup><mi>k</mi><mo>′</mo></msup></msub></mrow><annotation encoding="application/x-tex">\sigma_{S}[\cdot]_{k^{\prime}}</annotation></semantics></math> represents the <math id="A2.SS3.SSS2.p8.m19" class="ltx_Math" alttext="k^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>k</mi><mo>′</mo></msup><annotation encoding="application/x-tex">k^{\prime}</annotation></semantics></math> element of <math id="A2.SS3.SSS2.p8.m20" class="ltx_math_unparsed" alttext="\sigma_{S}[(W_{K}X^{(i)})^{\top}(W_{Q}X_{:,k}^{(i)})]" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mi>S</mi></msub><mrow><mo stretchy="false">[</mo><msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>K</mi></msub><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mrow><mo stretchy="false">(</mo><msub><mi>W</mi><mi>Q</mi></msub><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\sigma_{S}[(W_{K}X^{(i)})^{\top}(W_{Q}X_{:,k}^{(i)})]</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS2.p9" class="ltx_para">
<p id="A2.SS3.SSS2.p9.1" class="ltx_p"><span id="A2.SS3.SSS2.p9.1.1" class="ltx_text">With (<a href="#A2.E34" title="Equation 34 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) and the <math id="A2.SS3.SSS2.p9.m1" class="ltx_Math" alttext="\beta" display="inline" intent=":literal"><semantics><mi>β</mi><annotation encoding="application/x-tex">\beta</annotation></semantics></math>-separatedness of <math id="A2.SS3.SSS2.p9.m2" class="ltx_Math" alttext="X" display="inline" intent=":literal"><semantics><mi>X</mi><annotation encoding="application/x-tex">X</annotation></semantics></math>, it is easy to show that</span></p>
<table id="A2.EGx6" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex26"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex26.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathrm{Attn}(X^{(i)})_{:,k}-\mathrm{Attn}(X^{(j)})_{:,l}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathrm{Attn}(X^{(i)})_{:,k}-\mathrm{Attn}(X^{(j)})_{:,l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex26.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left\|X_{:,k}^{(i)}-X_{:,l}^{(j)}+H^{(i)}_{:,k}-H^{(j)}_{:,l}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mrow><mo>‖</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|X_{:,k}^{(i)}-X_{:,l}^{(j)}+H^{(i)}_{:,k}-H^{(j)}_{:,l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex27"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex27.m1" class="ltx_math_unparsed" alttext="\displaystyle\geq\left\|X_{:,k}^{(i)}-X_{:,l}^{(j)}\right\|_{2}-\left\|H^{(i)}_{:,k}\right\|_{2}-\left\|H^{(j)}_{:,l}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><msub><mrow><mo>‖</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub><mo>−</mo><msub><mrow><mo>‖</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left\|X_{:,k}^{(i)}-X_{:,l}^{(j)}\right\|_{2}-\left\|H^{(i)}_{:,k}\right\|_{2}-\left\|H^{(j)}_{:,l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex28"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex28.m1" class="ltx_Math" alttext="\displaystyle\geq\beta-\frac{\beta}{4}-\frac{\beta}{4}=\frac{\beta}{2}," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mi>β</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>4</mn></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>4</mn></mfrac></mstyle></mrow><mo>=</mo><mstyle displaystyle="true"><mfrac><mi>β</mi><mn>2</mn></mfrac></mstyle></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\beta-\frac{\beta}{4}-\frac{\beta}{4}=\frac{\beta}{2},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p9.2" class="ltx_p"><span id="A2.SS3.SSS2.p9.2.1" class="ltx_text">for any <math id="A2.SS3.SSS2.p9.m3" class="ltx_Math" alttext="i,j\in[N]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>,</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>N</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i,j\in[N]</annotation></semantics></math> and <math id="A2.SS3.SSS2.p9.m4" class="ltx_Math" alttext="k,l\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>,</mo><mi>l</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k,l\in[L]</annotation></semantics></math> such that <math id="A2.SS3.SSS2.p9.m5" class="ltx_math_unparsed" alttext="X_{:,k}^{(i)}\neq X_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X_{:,k}^{(i)}\neq X_{:,l}^{(j)}</annotation></semantics></math>. Till now we have already shown that this constructed self-attention layer can distinguish different tokens.</span></p>
</div>
<div id="A2.SS3.SSS2.p10" class="ltx_para">
<p id="A2.SS3.SSS2.p10.1" class="ltx_p"><span id="A2.SS3.SSS2.p10.1.1" class="ltx_text">For the last and most essential target that the designed self-attention layer <math id="A2.SS3.SSS2.p10.m1" class="ltx_Math" alttext="\mathrm{Attn}(X)" display="inline" intent=":literal"><semantics><mrow><mi>Attn</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{Attn}(X)</annotation></semantics></math> can distinguish <math id="A2.SS3.SSS2.p10.m2" class="ltx_math_unparsed" alttext="X^{(i)}_{:,k}=X^{(j)}_{:,l}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>=</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">X^{(i)}_{:,k}=X^{(j)}_{:,l}</annotation></semantics></math> with <math id="A2.SS3.SSS2.p10.m3" class="ltx_Math" alttext="\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}</annotation></semantics></math>, we first define <math id="A2.SS3.SSS2.p10.m4" class="ltx_Math" alttext="a^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">a^{(i)}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p10.m5" class="ltx_Math" alttext="a^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">a^{(j)}</annotation></semantics></math> as</span></p>
<table id="A2.Ex29" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex29.m1" class="ltx_math_unparsed" alttext="a^{(i)}=\Big(W_{K}X^{(i)}\Big)^{\top}W_{Q}X_{:,k}^{(i)}\in\mathbb{R}^{L}~\text{and}~~a^{(j)}=\Big(W_{K}X^{(j)}\Big)^{\top}W_{Q}X_{:,l}^{(j)}\in\mathbb{R}^{L}," display="block" intent=":literal"><semantics><mrow><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>W</mi><mi>K</mi></msub><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>⊤</mo></msup><msub><mi>W</mi><mi>Q</mi></msub><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup><mtext>and</mtext><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><msub><mi>W</mi><mi>K</mi></msub><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mo>⊤</mo></msup><msub><mi>W</mi><mi>Q</mi></msub><msubsup><mi>X</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>∈</mo><msup><mi>ℝ</mi><mi>L</mi></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">a^{(i)}=\Big(W_{K}X^{(i)}\Big)^{\top}W_{Q}X_{:,k}^{(i)}\in\mathbb{R}^{L}~\text{and}~~a^{(j)}=\Big(W_{K}X^{(j)}\Big)^{\top}W_{Q}X_{:,l}^{(j)}\in\mathbb{R}^{L},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p10.2" class="ltx_p"><span id="A2.SS3.SSS2.p10.2.1" class="ltx_text">with the weight matrices <math id="A2.SS3.SSS2.p10.m6" class="ltx_Math" alttext="W_{O},W_{V},W_{K},W_{Q}" display="inline" intent=":literal"><semantics><mrow><msub><mi>W</mi><mi>O</mi></msub><mo>,</mo><msub><mi>W</mi><mi>V</mi></msub><mo>,</mo><msub><mi>W</mi><mi>K</mi></msub><mo>,</mo><msub><mi>W</mi><mi>Q</mi></msub></mrow><annotation encoding="application/x-tex">W_{O},W_{V},W_{K},W_{Q}</annotation></semantics></math> defined in the former targets.</span></p>
</div>
<div id="A2.SS3.SSS2.p11" class="ltx_para">
<p id="A2.SS3.SSS2.p11.3" class="ltx_p"><span id="A2.SS3.SSS2.p11.3.1" class="ltx_text">From (<a href="#A2.E32" title="Equation 32 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>)-(<a href="#A2.E33" title="Equation 33 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>), we have that <math id="A2.SS3.SSS2.p11.m1" class="ltx_Math" alttext="a^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">a^{(i)}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p11.m2" class="ltx_Math" alttext="a^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">a^{(j)}</annotation></semantics></math> are token-wise <math id="A2.SS3.SSS2.p11.m3" class="ltx_Math" alttext="(\kappa,\delta_{0})" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>κ</mi><mo>,</mo><msub><mi>δ</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(\kappa,\delta_{0})</annotation></semantics></math>-separated where <math id="A2.SS3.SSS2.p11.m4" class="ltx_Math" alttext="\kappa" display="inline" intent=":literal"><semantics><mi>κ</mi><annotation encoding="application/x-tex">\kappa</annotation></semantics></math> is computed by for any <math id="A2.SS3.SSS2.p11.m5" class="ltx_Math" alttext="k^{\prime}\in[L]" display="inline" intent=":literal"><semantics><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">k^{\prime}\in[L]</annotation></semantics></math>,</span></p>
<table id="A2.Ex30" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex30X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex30X.m2" class="ltx_Math" alttext="\displaystyle\left|a_{k^{\prime}}^{(i)}\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><msubsup><mi>a</mi><msup><mi>k</mi><mo>′</mo></msup><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|a_{k^{\prime}}^{(i)}\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30X.m3" class="ltx_Math" alttext="\displaystyle=\left|\left(W_{K}X^{(i)}_{:,k^{\prime}}\right)^{\top}W_{Q}X_{:,k}^{(i)}\right|=\left|\left(X^{(i)}_{:,k^{\prime}}\right)^{\top}v\right|\cdot\left|u^{\top}u^{\prime}\right|\cdot\left|v^{\top}X^{(i)}_{:,k}\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><mo>(</mo><mi>W</mi><msub><mrow></mrow><mi>K</mi></msub><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>W</mi><msub><mrow></mrow><mi>Q</mi></msub><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo fence="false">|</mo><mo lspace="0.167em" rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><mo>(</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>v</mi><mo fence="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em">|</mo><mi>u</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>u</mi><msup><mrow></mrow><mo>′</mo></msup><mo fence="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em">|</mo><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\left(W_{K}X^{(i)}_{:,k^{\prime}}\right)^{\top}W_{Q}X_{:,k}^{(i)}\right|=\left|\left(X^{(i)}_{:,k^{\prime}}\right)^{\top}v\right|\cdot\left|u^{\top}u^{\prime}\right|\cdot\left|v^{\top}X^{(i)}_{:,k}\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex30Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex30Xa.m2" class="ltx_Math" alttext="\displaystyle\leq(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}^{2}}{\beta r_{\min}}\coloneq\kappa." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow><mo>≔</mo><mi>κ</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}^{2}}{\beta r_{\min}}\coloneq\kappa.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p11.4" class="ltx_p"><span id="A2.SS3.SSS2.p11.4.1" class="ltx_text">Since <math id="A2.SS3.SSS2.p11.m6" class="ltx_Math" alttext="\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}" display="inline" intent=":literal"><semantics><mrow><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>≠</mo><msup><mi class="ltx_font_mathcaligraphic">𝒱</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">\mathcal{V}^{(i)}\neq\mathcal{V}^{(j)}</annotation></semantics></math> and there is no duplicate token in <math id="A2.SS3.SSS2.p11.m7" class="ltx_Math" alttext="X^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">X^{(i)}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p11.m8" class="ltx_Math" alttext="X^{(j)}" display="inline" intent=":literal"><semantics><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">X^{(j)}</annotation></semantics></math> respectively, we obtain from Lemma <a href="#A2.Thmtheorem7" title="Lemma B.7 ( , , Lemma 1). ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">B.7</span></a> that</span></p>
<table id="A2.E35" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E35X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E35X.m2" class="ltx_Math" alttext="\displaystyle\left|\text{boltz}(a^{(i)})-\text{boltz}(a^{(j)})\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><mtext>boltz</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><mtext>boltz</mtext><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|\text{boltz}(a^{(i)})-\text{boltz}(a^{(j)})\right|</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E35X.m3" class="ltx_Math" alttext="\displaystyle=\left|(a^{(i)})^{\top}\sigma_{S}[a^{(i)}]-(a^{(j)})^{\top}\sigma_{S}[a^{(j)}]\right|&gt;\delta_{1}=(\log L)^{2}e^{-2\kappa}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><mo>&gt;</mo><msub><mi>δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow></msup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|(a^{(i)})^{\top}\sigma_{S}[a^{(i)}]-(a^{(j)})^{\top}\sigma_{S}[a^{(j)}]\right|&gt;\delta_{1}=(\log L)^{2}e^{-2\kappa}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(35)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p11.5" class="ltx_p"><span id="A2.SS3.SSS2.p11.5.1" class="ltx_text">For the assumed <math id="A2.SS3.SSS2.p11.m9" class="ltx_math_unparsed" alttext="X_{:,k}^{(i)}=X_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X_{:,k}^{(i)}=X_{:,l}^{(j)}</annotation></semantics></math>, we have</span></p>
<table id="A2.E36" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E36X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E36X.m2" class="ltx_Math" alttext="\displaystyle\left|(a^{(i)})^{\top}\sigma_{S}[a^{(i)}]-(a^{(j)})^{\top}\sigma_{S}[a^{(j)}]\right|" display="inline" intent=":literal"><semantics><mrow><mo>|</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left|(a^{(i)})^{\top}\sigma_{S}[a^{(i)}]-(a^{(j)})^{\top}\sigma_{S}[a^{(j)}]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="5" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(36)</span></td></tr>
<tr id="A2.E36Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E36Xa.m2" class="ltx_Math" alttext="\displaystyle=\left|\left(W_{Q}X_{:,k}^{(i)}\right)^{\top}W_{K}\left(X^{(i)}\sigma_{S}[a^{(i)}]-X^{(j)}\sigma_{S}[a^{(j)}]\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><mo>(</mo><mi>W</mi><msub><mrow></mrow><mi>Q</mi></msub><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>W</mi><msub><mrow></mrow><mi>K</mi></msub><mo>(</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>−</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>)</mo><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\left(W_{Q}X_{:,k}^{(i)}\right)^{\top}W_{K}\left(X^{(i)}\sigma_{S}[a^{(i)}]-X^{(j)}\sigma_{S}[a^{(j)}]\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E36Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E36Xb.m2" class="ltx_Math" alttext="\displaystyle=\left|\left(X_{:,k}^{(i)}\right)^{\top}vu^{\prime\top}uv^{\top}\left(X^{(i)}\sigma_{S}[a^{(i)}]-X^{(j)}\sigma_{S}[a^{(j)}]\right)\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><mo>(</mo><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>v</mi><mi>u</mi><msup><mrow></mrow><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msup><mi>u</mi><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mo>(</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>−</mo><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>)</mo><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\left(X_{:,k}^{(i)}\right)^{\top}vu^{\prime\top}uv^{\top}\left(X^{(i)}\sigma_{S}[a^{(i)}]-X^{(j)}\sigma_{S}[a^{(j)}]\right)\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E36Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E36Xc.m2" class="ltx_Math" alttext="\displaystyle=\left|\left(X_{:,k}^{(i)}\right)^{\top}v\right|\cdot\left|u^{\prime\top}u\right|\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|" display="inline" intent=":literal"><semantics><mrow><mo rspace="0em">=</mo><mo fence="false" rspace="0.167em">|</mo><mo>(</mo><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>)</mo><msup><mrow></mrow><mo>⊤</mo></msup><mi>v</mi><mo fence="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em">|</mo><mi>u</mi><msup><mrow></mrow><mrow><mo>′</mo><mo lspace="0.222em">⁣</mo><mo>⊤</mo></mrow></msup><mi>u</mi><mo fence="false">|</mo><mo lspace="0em" rspace="0em">⋅</mo><mo fence="false" rspace="0.167em">|</mo><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo>−</mo><mi>v</mi><msup><mrow></mrow><mo>⊤</mo></msup><mi>X</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mi>σ</mi><msub><mrow></mrow><mi>S</mi></msub><mo stretchy="false">[</mo><mi>a</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo><mo fence="false">|</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left|\left(X_{:,k}^{(i)}\right)^{\top}v\right|\cdot\left|u^{\prime\top}u\right|\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E36Xd" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E36Xd.m2" class="ltx_Math" alttext="\displaystyle\leq(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}}{\beta r_{\min}}\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mstyle></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}}{\beta r_{\min}}\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p11.6" class="ltx_p"><span id="A2.SS3.SSS2.p11.6.1" class="ltx_text">where the last inequality follows from (<a href="#A2.E32" title="Equation 32 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">32</span></a>)-(<a href="#A2.E33" title="Equation 33 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">33</span></a>). Therefore, we have when <math id="A2.SS3.SSS2.p11.m10" class="ltx_math_unparsed" alttext="X_{:,k}^{(i)}=X_{:,l}^{(j)}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>=</mo><mi>X</mi><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup></mrow><annotation encoding="application/x-tex">X_{:,k}^{(i)}=X_{:,l}^{(j)}</annotation></semantics></math>,</span></p>
<table id="A2.EGx7" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex31"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex31.m1" class="ltx_math_unparsed" alttext="\displaystyle\left\|\mathrm{Attn}(X^{(i)})_{:,k}-\mathrm{Attn}(X^{(j)})_{:,l}\right\|_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>Attn</mi><msub><mrow><mo stretchy="false">(</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\|\mathrm{Attn}(X^{(i)})_{:,k}-\mathrm{Attn}(X^{(j)})_{:,l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex31.m2" class="ltx_math_unparsed" alttext="\displaystyle=\left\|H^{(i)}_{:,k}-H^{(j)}_{:,l}\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mo>=</mo><msub><mrow><mo>‖</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>−</mo><msubsup><mi>H</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|H^{(i)}_{:,k}-H^{(j)}_{:,l}\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex32"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex32.m1" class="ltx_Math" alttext="\displaystyle=\left\|W_{O}W_{V}X^{(i)}\sigma_{S}[a^{(i)}]-W_{O}W_{V}X^{(j)}\sigma_{S}[a^{(j)}]\right\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\|W_{O}W_{V}X^{(i)}\sigma_{S}[a^{(i)}]-W_{O}W_{V}X^{(j)}\sigma_{S}[a^{(j)}]\right\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex33"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex33.m1" class="ltx_Math" alttext="\displaystyle=\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′′</mo></msup></mrow><mo rspace="0.055em">‖</mo></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><mrow><mo>|</mo><mrow><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow><mo>−</mo><mrow><msup><mi>v</mi><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>X</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><msup><mi>a</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">]</mo></mrow></mrow></mrow><mo>|</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}\cdot\left|v^{\top}X^{(i)}\sigma_{S}[a^{(i)}]-v^{\top}X^{(j)}\sigma_{S}[a^{(j)}]\right|</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex34"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex34.m1" class="ltx_Math" alttext="\displaystyle\geq\frac{\beta^{2}r_{\min}\delta_{1}}{4(\left|\mathcal{V}\right|+1)^{4}d\delta_{0}r_{\max}^{2}}\coloneq\gamma," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mstyle displaystyle="true"><mfrac><mrow><msup><mi>β</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>1</mn></msub></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup></mrow></mfrac></mstyle><mo>≔</mo><mi>γ</mi></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\beta^{2}r_{\min}\delta_{1}}{4(\left|\mathcal{V}\right|+1)^{4}d\delta_{0}r_{\max}^{2}}\coloneq\gamma,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p11.7" class="ltx_p"><span id="A2.SS3.SSS2.p11.7.1" class="ltx_text">where the last inequality gains from (<a href="#A2.E35" title="Equation 35 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">35</span></a>)-(<a href="#A2.E36" title="Equation 36 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">36</span></a>), <math id="A2.SS3.SSS2.p11.m11" class="ltx_Math" alttext="\delta_{0}=2\log L+3" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>0</mn></msub><mo>=</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">\delta_{0}=2\log L+3</annotation></semantics></math> and <math id="A2.SS3.SSS2.p11.m12" class="ltx_Math" alttext="\delta_{1}=(\log L)^{2}e^{-2\kappa}" display="inline" intent=":literal"><semantics><mrow><msub><mi>δ</mi><mn>1</mn></msub><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>e</mi><mrow><mo>−</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>κ</mi></mrow></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">\delta_{1}=(\log L)^{2}e^{-2\kappa}</annotation></semantics></math> with</span></p>
<table id="A2.Ex35" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex35.m1" class="ltx_Math" alttext="\kappa=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}^{2}}{\beta r_{\min}}." display="block" intent=":literal"><semantics><mrow><mrow><mi>κ</mi><mo>=</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mo>|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo>|</mo></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mfrac><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>δ</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mi>r</mi><mi>max</mi><mn>2</mn></msubsup></mrow><mrow><mi>β</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>min</mi></msub></mrow></mfrac></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\kappa=(\left|\mathcal{V}\right|+1)^{4}\frac{d\delta_{0}r_{\max}^{2}}{\beta r_{\min}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS2.p11.8" class="ltx_p"><span id="A2.SS3.SSS2.p11.8.1" class="ltx_text">Until now we have proved that the constructed single self-attention layer (<a href="#A2.E29" title="Equation 29 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">29</span></a>) is an <math id="A2.SS3.SSS2.p11.m13" class="ltx_Math" alttext="(r,\gamma)" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>,</mo><mi>γ</mi><mo stretchy="false">)</mo></mrow><annotation encoding="application/x-tex">(r,\gamma)</annotation></semantics></math>-contextual mapping, where <math id="A2.SS3.SSS2.p11.m14" class="ltx_Math" alttext="W_{V}=u^{\prime\prime}v^{\top},W_{K}=uv^{\top},W_{Q}=u^{\prime}v^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>W</mi><mi>V</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><mo>,</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo>=</mo><mrow><mi>u</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow><mo>,</mo><mrow><msub><mi>W</mi><mi>Q</mi></msub><mo>=</mo><mrow><msup><mi>u</mi><mo>′</mo></msup><mo lspace="0em" rspace="0em">​</mo><msup><mi>v</mi><mo>⊤</mo></msup></mrow></mrow></mrow><annotation encoding="application/x-tex">W_{V}=u^{\prime\prime}v^{\top},W_{K}=uv^{\top},W_{Q}=u^{\prime}v^{\top}</annotation></semantics></math> and <math id="A2.SS3.SSS2.p11.m15" class="ltx_Math" alttext="\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}=\frac{\beta}{4r_{\max}}." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msup><mi>u</mi><mo>′′</mo></msup></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>=</mo><mfrac><mi>β</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>r</mi><mi>max</mi></msub></mrow></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert W_{O}u^{\prime\prime}\right\rVert_{2}=\frac{\beta}{4r_{\max}}.</annotation></semantics></math>
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS3.SSS3" class="ltx_subsubsection">
<h4 class="ltx_title ltx_title_subsubsection"><span class="ltx_tag ltx_tag_subsubsection">B.3.3 </span>Value Mapping <math id="A2.SS3.SSS3.m1" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math></h4>

<div id="A2.SS3.SSS3.p1" class="ltx_para ltx_noindent">
<p id="A2.SS3.SSS3.p1.1" class="ltx_p"><span id="A2.SS3.SSS3.p1.1.1" class="ltx_text ltx_font_bold">Lemma <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a></span> (Value Mapping <math id="A2.SS3.SSS3.p1.m1" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math>; Restatement)<span id="A2.SS3.SSS3.p1.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A2.SS3.SSS3.p1.1.3" class="ltx_text ltx_font_italic">Suppose <math id="A2.SS3.SSS3.p1.m2" class="ltx_Math" alttext="Y_{G}" display="inline" intent=":literal"><semantics><msub><mi>Y</mi><mi>G</mi></msub><annotation encoding="application/x-tex">Y_{G}</annotation></semantics></math> is the output matrix of <math id="A2.SS3.SSS3.p1.m3" class="ltx_Math" alttext="G" display="inline" intent=":literal"><semantics><mi>G</mi><annotation encoding="application/x-tex">G</annotation></semantics></math>. Let <math id="A2.SS3.SSS3.p1.m4" class="ltx_Math" alttext="\delta,\delta^{*}\in(0,1),M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor,d,L\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>,</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><mo>,</mo><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><mo>,</mo><mi>d</mi><mo>,</mo><mrow><mi>L</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">\delta,\delta^{*}\in(0,1),M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor,d,L\in\mathbb{N}_{+}</annotation></semantics></math> and <math id="A2.SS3.SSS3.p1.m5" class="ltx_Math" alttext="d_{0}=dL" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">d_{0}=dL</annotation></semantics></math>, there exists a value mapping <math id="A2.SS3.SSS3.p1.m6" class="ltx_Math" alttext="f_{\mathcal{T}3}:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0.278em" rspace="0.278em">:</mo><mrow><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo stretchy="false">→</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}3}:\mathbb{R}^{d\times L}\to\mathbb{R}^{d\times L}</annotation></semantics></math> composed of <math id="A2.SS3.SSS3.p1.m7" class="ltx_Math" alttext="2LM^{d_{0}}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2LM^{d_{0}}+1</annotation></semantics></math> feed-forward layers such that <math id="A2.SS3.SSS3.p1.m8" class="ltx_Math" alttext="f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)=Y_{G},\forall G\in\mathcal{G}_{\delta,\delta^{*}}^{p}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>Y</mi><mi>G</mi></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>G</mi></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)=Y_{G},\forall G\in\mathcal{G}_{\delta,\delta^{*}}^{p}.</annotation></semantics></math></span></p>
</div>
<div id="A2.SS3.SSS3.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS3.SSS3.2.1" class="ltx_text ltx_font_bold">Proof of Lemma <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a></span>.</h6>
<div id="A2.SS3.SSS3.p2" class="ltx_para">
<p id="A2.SS3.SSS3.p2.1" class="ltx_p"><span id="A2.SS3.SSS3.p2.1.1" class="ltx_text">For the sake of convenience, we denote</span></p>
<table id="A2.EGx8" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex36"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex36.m1" class="ltx_Math" alttext="\displaystyle r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">\displaystyle r</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex36.m2" class="ltx_Math" alttext="\displaystyle=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4},~\mathrm{and}~r_{2}=\sqrt{d}-\frac{\sqrt{d}(\delta+\delta^{*})}{4}," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow></mrow><mo rspace="0.497em">,</mo><mrow><mrow><mi>and</mi><mo lspace="0.330em" rspace="0em">​</mo><msub><mi>r</mi><mn>2</mn></msub></mrow><mo>=</mo><mrow><msqrt><mi>d</mi></msqrt><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4},~\mathrm{and}~r_{2}=\sqrt{d}-\frac{\sqrt{d}(\delta+\delta^{*})}{4},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex37"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex37.m1" class="ltx_Math" alttext="\displaystyle\gamma_{1}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mn>1</mn></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{1}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex37.m2" class="ltx_Math" alttext="\displaystyle=\frac{\delta^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mi>δ</mi><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac></mstyle></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{\delta^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex38"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex38.m1" class="ltx_Math" alttext="\displaystyle\gamma_{2}" display="inline" intent=":literal"><semantics><msub><mi>γ</mi><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\gamma_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex38.m2" class="ltx_Math" alttext="\displaystyle=\frac{(\delta^{*})^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msup><mrow><mo stretchy="false">(</mo><msup><mi>δ</mi><mo>∗</mo></msup><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup></mrow></mfrac></mstyle><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>exp</mi><mo>⁡</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mo>−</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>4</mn></msup><mo lspace="0em" rspace="0em">​</mo><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>2</mn><mo lspace="0.167em" rspace="0em">​</mo><mrow><mi>log</mi><mo lspace="0.167em">⁡</mo><mi>L</mi></mrow></mrow><mo lspace="0.052em">+</mo><mn>3</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msup><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0.052em">+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mn>2</mn></msup></mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac></mstyle></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{(\delta^{*})^{2}(\log L)^{2}}{4\sqrt{d}(2\log L\!+\!3)(L\!+\!1)^{2}(LM^{d_{0}}\!+\!1)^{4}}\exp\Big(-(LM^{d_{0}}\!+\!1)^{4}\frac{2d(2\log L\!+\!3)(L\!+\!1)^{2}}{\delta+\delta^{*}}\Big).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p2.2" class="ltx_p"><span id="A2.SS3.SSS3.p2.2.1" class="ltx_text">Based on (<a href="#A2.E26" title="Equation 26 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">26</span></a>), for any two different grid points <math id="A2.SS3.SSS3.p2.m1" class="ltx_Math" alttext="G^{(i)},G^{(j)},i\neq j" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo>,</mo><mrow><mi>i</mi><mo>≠</mo><mi>j</mi></mrow></mrow><annotation encoding="application/x-tex">G^{(i)},G^{(j)},i\neq j</annotation></semantics></math>, we have</span></p>
<table id="A2.E37" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E37.m1" class="ltx_math_unparsed" alttext="\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}\geq\gamma&gt;\gamma_{1}+\gamma_{2},~\mathrm{for~all}~k\neq l,k\in[L],l\in[L]." display="block" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo></mrow><mn>2</mn></msub><mo>≥</mo><mi>γ</mi><mo>&gt;</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub><mo rspace="0.497em">,</mo><mi>for</mi><mi>all</mi><mi>k</mi><mo>≠</mo><mi>l</mi><mo>,</mo><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo>,</mo><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}\geq\gamma&gt;\gamma_{1}+\gamma_{2},~\mathrm{for~all}~k\neq l,k\in[L],l\in[L].</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(37)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p2.3" class="ltx_p"><span id="A2.SS3.SSS3.p2.3.1" class="ltx_text">Recall that <math id="A2.SS3.SSS3.p2.m2" class="ltx_Math" alttext="M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow></mrow><annotation encoding="application/x-tex">M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor</annotation></semantics></math> is the number of grid points per dimension. We denote the total grid points as <math id="A2.SS3.SSS3.p2.m3" class="ltx_Math" alttext="M_{\mathrm{all}}=M^{dL}=M^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>M</mi><mi>all</mi></msub><mo>=</mo><msup><mi>M</mi><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></msup><mo>=</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><annotation encoding="application/x-tex">M_{\mathrm{all}}=M^{dL}=M^{d_{0}}</annotation></semantics></math>, arrange all the grid points in a certain order, and assign the serial number <math id="A2.SS3.SSS3.p2.m4" class="ltx_Math" alttext="i\in[M_{\mathrm{all}}]" display="inline" intent=":literal"><semantics><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>all</mi></msub><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">i\in[M_{\mathrm{all}}]</annotation></semantics></math> to each of the point and its output, i.e., <math id="A2.SS3.SSS3.p2.m5" class="ltx_Math" alttext="G^{(i)}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">G^{(i)}</annotation></semantics></math> and <math id="A2.SS3.SSS3.p2.m6" class="ltx_Math" alttext="Y_{G}^{(i)}" display="inline" intent=":literal"><semantics><msubsup><mi>Y</mi><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><annotation encoding="application/x-tex">Y_{G}^{(i)}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS3.SSS3.p3" class="ltx_para">
<p id="A2.SS3.SSS3.p3.3" class="ltx_p"><span id="A2.SS3.SSS3.p3.3.1" class="ltx_text">In this proof, we are considering the current input <math id="A2.SS3.SSS3.p3.m1" class="ltx_Math" alttext="\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>X</mi><mo rspace="0.111em">∈</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}\}</annotation></semantics></math>. Now take <math id="A2.SS3.SSS3.p3.m2" class="ltx_Math" alttext="i=1,2,\ldots,M_{\mathrm{all}}" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>M</mi><mi>all</mi></msub></mrow><annotation encoding="application/x-tex">i=1,2,\ldots,M_{\mathrm{all}}</annotation></semantics></math> and <math id="A2.SS3.SSS3.p3.m3" class="ltx_Math" alttext="k=1,2,\ldots,L" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mn>2</mn><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mi>L</mi></mrow><annotation encoding="application/x-tex">k=1,2,\ldots,L</annotation></semantics></math> respectively, and we design a subunit composed of two following feed-forward layers,</span></p>
<table id="A2.E38" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E38.m1" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,1)}(\bar{X})=\bar{X}+\sigma_{\zeta 1}\left[\bar{X}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\cdot\mathds{1}_{L}^{\top}\right]\coloneq Z," display="block" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow><mo>=</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>+</mo><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo>[</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo rspace="0.222em">⋅</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup><mo>]</mo></mrow><mo>≔</mo><mi>Z</mi><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}(\bar{X})=\bar{X}+\sigma_{\zeta 1}\left[\bar{X}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\cdot\mathds{1}_{L}^{\top}\right]\coloneq Z,</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(38)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p3.4" class="ltx_p"><span id="A2.SS3.SSS3.p3.4.1" class="ltx_text">where</span></p>
<table id="A2.EGx9" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex39"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex39.m1" class="ltx_Math" alttext="\displaystyle\sigma_{\zeta 1}[t]" display="inline" intent=":literal"><semantics><mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\zeta 1}[t]</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex39.m2" class="ltx_Math" alttext="\displaystyle=\frac{2dr}{\gamma_{2}}\Big(\sigma_{R}\Big[t+\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t+\frac{\gamma_{1}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t-\frac{\gamma_{1}}{2\sqrt{d}}\Big]+\sigma_{R}\Big[t-\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]\Big)" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>+</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo>+</mo><mrow><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo maxsize="1.600em" minsize="1.600em">[</mo><mrow><mi>t</mi><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo maxsize="1.600em" minsize="1.600em">]</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\frac{2dr}{\gamma_{2}}\Big(\sigma_{R}\Big[t+\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t+\frac{\gamma_{1}}{2\sqrt{d}}\Big]-\sigma_{R}\Big[t-\frac{\gamma_{1}}{2\sqrt{d}}\Big]+\sigma_{R}\Big[t-\frac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\Big]\Big)</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex40"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex40.m1" class="ltx_Math" alttext="\displaystyle=\begin{cases}0,&amp;t&lt;-\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}~~\mathrm{or}~~t&gt;\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\\
\dfrac{2dr}{\gamma_{2}}t+\dfrac{\sqrt{d}r(\gamma_{1}+\gamma_{2})}{\gamma_{2}},&amp;-\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\leq t\leq-\dfrac{\gamma_{1}}{2\sqrt{d}},\\
\sqrt{d}r,&amp;-\dfrac{\gamma_{1}}{2\sqrt{d}}\leq t\leq\dfrac{\gamma_{1}}{2\sqrt{d}},\\
-\dfrac{2{d}r}{\gamma_{2}}t+\dfrac{\sqrt{d}r(\gamma_{1}+\gamma_{2})}{\gamma_{2}},&amp;\dfrac{\gamma_{1}}{2\sqrt{d}}\leq t\leq\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\\
\end{cases}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>&lt;</mo><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo lspace="0.660em" rspace="0em">​</mo><mi>or</mi><mo lspace="0.660em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo stretchy="false">)</mo></mrow></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>≤</mo><mi>t</mi><mo>≤</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\begin{cases}0,&amp;t&lt;-\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}~~\mathrm{or}~~t&gt;\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\\
\dfrac{2dr}{\gamma_{2}}t+\dfrac{\sqrt{d}r(\gamma_{1}+\gamma_{2})}{\gamma_{2}},&amp;-\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}}\leq t\leq-\dfrac{\gamma_{1}}{2\sqrt{d}},\\
\sqrt{d}r,&amp;-\dfrac{\gamma_{1}}{2\sqrt{d}}\leq t\leq\dfrac{\gamma_{1}}{2\sqrt{d}},\\
-\dfrac{2{d}r}{\gamma_{2}}t+\dfrac{\sqrt{d}r(\gamma_{1}+\gamma_{2})}{\gamma_{2}},&amp;\dfrac{\gamma_{1}}{2\sqrt{d}}\leq t\leq\dfrac{\gamma_{1}+\gamma_{2}}{2\sqrt{d}},\\
\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p3.5" class="ltx_p"><span id="A2.SS3.SSS3.p3.5.1" class="ltx_text">and</span></p>
<table id="A2.E39" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E39X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E39X.m2" class="ltx_Math" alttext="\displaystyle\!\!\!\!\mathrm{FF}^{(i,k,2)}(Z)=Z+\left(Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right)\sigma_{\zeta 2}\left[\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}\right]-\sigma_{\zeta 3}\left[Z-\sqrt{d}r\mathds{1}_{d}\cdot\mathds{1}_{L}^{\top}\right]," display="inline" intent=":literal"><semantics><mrow><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>Z</mi><mo>+</mo><mo>(</mo><mi>Y</mi><msub><mrow></mrow><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow></msub><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo>+</mo><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo><mo rspace="0.222em">⋅</mo><mn>𝟙</mn><msub><mrow></mrow><mi>d</mi></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>)</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo>[</mo><mn>𝟙</mn><msub><mrow></mrow><mi>d</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>Z</mi><mo>−</mo><mi>d</mi><msqrt><mi>d</mi></msqrt><mi>r</mi><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn><msub><mrow></mrow><mi>L</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo><mo>−</mo><mi>σ</mi><msub><mrow></mrow><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo>[</mo><mi>Z</mi><mo>−</mo><msqrt><mi>d</mi></msqrt><mi>r</mi><mn>𝟙</mn><msub><mrow></mrow><mi>d</mi></msub><mo lspace="0.222em" rspace="0.222em">⋅</mo><mn>𝟙</mn><msub><mrow></mrow><mi>L</mi></msub><msup><mrow></mrow><mo>⊤</mo></msup><mo>]</mo><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\!\!\!\!\mathrm{FF}^{(i,k,2)}(Z)=Z+\left(Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right)\sigma_{\zeta 2}\left[\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}\right]-\sigma_{\zeta 3}\left[Z-\sqrt{d}r\mathds{1}_{d}\cdot\mathds{1}_{L}^{\top}\right],</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(39)</span></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p3.6" class="ltx_p"><span id="A2.SS3.SSS3.p3.6.1" class="ltx_text">where</span></p>
<table id="A2.EGx10" class="ltx_equationgroup ltx_eqn_align ltx_eqn_table">

<tbody id="A2.Ex41"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex41.m1" class="ltx_Math" alttext="\displaystyle\sigma_{\zeta 2}[t]=\dfrac{1}{\gamma_{2}}\sigma_{R}\left[t\right]-\dfrac{1}{\gamma_{2}}\sigma_{R}\left[t-\gamma_{2}\right]=\begin{cases}0,&amp;t\leq 0,\\
\dfrac{1}{\gamma_{2}}t,&amp;0\leq t\leq\gamma_{2},\\
1,&amp;t\geq\gamma_{2},\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>t</mi><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>−</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>1</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>≥</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>,</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\zeta 2}[t]=\dfrac{1}{\gamma_{2}}\sigma_{R}\left[t\right]-\dfrac{1}{\gamma_{2}}\sigma_{R}\left[t-\gamma_{2}\right]=\begin{cases}0,&amp;t\leq 0,\\
\dfrac{1}{\gamma_{2}}t,&amp;0\leq t\leq\gamma_{2},\\
1,&amp;t\geq\gamma_{2},\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex42"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex42.m1" class="ltx_Math" alttext="\displaystyle\sigma_{\zeta 3}[t]=\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t+\gamma_{2}\right]-\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t\right]=\begin{cases}0,&amp;t\leq-\gamma_{2},\\
\dfrac{\sqrt{d}r}{\gamma_{2}}t+\sqrt{d}r,&amp;-\gamma_{2}\leq t\leq 0,\\
\sqrt{d}r,&amp;t\geq 0.\end{cases}" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">[</mo><mi>t</mi><mo stretchy="false">]</mo></mrow></mrow><mo>=</mo><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mi>t</mi><mo>+</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>]</mo></mrow></mrow><mo>−</mo><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mi>t</mi><mo>]</mo></mrow></mrow></mrow><mo>=</mo><mrow><mo>{</mo><mtable columnspacing="5pt" rowspacing="0pt"><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mn>0</mn><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>≤</mo><mrow><mo>−</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><msub><mi>γ</mi><mn>2</mn></msub></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mi>t</mi></mrow><mo>+</mo><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mrow><mo>−</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow><mo>≤</mo><mi>t</mi><mo>≤</mo><mn>0</mn></mrow><mo>,</mo></mrow></mtd></mtr><mtr><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo>,</mo></mrow></mtd><mtd class="ltx_align_left" columnalign="left"><mrow><mrow><mi>t</mi><mo>≥</mo><mn>0</mn></mrow><mo lspace="0em">.</mo></mrow></mtd></mtr></mtable></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\sigma_{\zeta 3}[t]=\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t+\gamma_{2}\right]-\frac{\sqrt{d}r}{\gamma_{2}}\sigma_{R}\left[t\right]=\begin{cases}0,&amp;t\leq-\gamma_{2},\\
\dfrac{\sqrt{d}r}{\gamma_{2}}t+\sqrt{d}r,&amp;-\gamma_{2}\leq t\leq 0,\\
\sqrt{d}r,&amp;t\geq 0.\end{cases}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p3.7" class="ltx_p"><math id="A2.SS3.SSS3.p3.m4" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math><span id="A2.SS3.SSS3.p3.7.1" class="ltx_text"> Layer <math id="A2.SS3.SSS3.p3.m5" class="ltx_Math" alttext="\mathrm{FF}^{(i,k,1)}(\bar{X})" display="inline" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}(\bar{X})</annotation></semantics></math> aims to endow the label <math id="A2.SS3.SSS3.p3.m6" class="ltx_Math" alttext="\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\sqrt{d}r</annotation></semantics></math> to those elements of <math id="A2.SS3.SSS3.p3.m7" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> in <math id="A2.SS3.SSS3.p3.m8" class="ltx_math_unparsed" alttext="[-\gamma_{1}/(2\sqrt{d}),\gamma_{1}/(2\sqrt{d})]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mo lspace="0em">−</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msqrt><mi>d</mi></msqrt><mo stretchy="false">)</mo></mrow><mo>,</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msqrt><mi>d</mi></msqrt><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[-\gamma_{1}/(2\sqrt{d}),\gamma_{1}/(2\sqrt{d})]</annotation></semantics></math> and to output results with a form of “<math id="A2.SS3.SSS3.p3.m9" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> + label”. Specifically, suppose we have the target column <math id="A2.SS3.SSS3.p3.m10" class="ltx_math_unparsed" alttext="\bar{X}_{:,p}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{X}_{:,p}</annotation></semantics></math> close to <math id="A2.SS3.SSS3.p3.m11" class="ltx_math_unparsed" alttext="f_{\mathcal{T},c2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{\mathcal{T},c2}(G^{(i)})_{:,k}</annotation></semantics></math> under the criterion <math id="A2.SS3.SSS3.p3.m12" class="ltx_math_unparsed" alttext="\left\lVert\bar{X}_{:,p}-f_{\mathcal{T},c2}(G^{(i)})_{:,k}\right\rVert_{\infty}\leq{\gamma_{1}}/({2\sqrt{d}})" display="inline" intent=":literal"><semantics><mrow><msub><mrow><mo>‖</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo></mrow><mi mathvariant="normal">∞</mi></msub><mo>≤</mo><msub><mi>γ</mi><mn>1</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mn>2</mn><msqrt><mi>d</mi></msqrt><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\left\lVert\bar{X}_{:,p}-f_{\mathcal{T},c2}(G^{(i)})_{:,k}\right\rVert_{\infty}\leq{\gamma_{1}}/({2\sqrt{d}})</annotation></semantics></math>, every element of <math id="A2.SS3.SSS3.p3.m13" class="ltx_math_unparsed" alttext="\bar{X}_{:,p}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{X}_{:,p}</annotation></semantics></math> will be added with the label <math id="A2.SS3.SSS3.p3.m14" class="ltx_Math" alttext="\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\sqrt{d}r</annotation></semantics></math>. Based on (<a href="#A2.E37" title="Equation 37 ‣ Proof of Lemma . ‣ B.3.3 Value Mapping 𝑓_{𝒯⁢3} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">37</span></a>), this criterion takes effects as</span></p>
<table id="A2.E40" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E40X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E40X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E40X.m3" class="ltx_Math" alttext="\displaystyle\geq\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{\infty}-\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mo>‖</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub><mo>−</mo><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\geq\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{\infty}-\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="3" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(40)</span></td></tr>
<tr id="A2.E40Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E40Xa.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{1}{\sqrt{d}}\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}-\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right\rVert_{\infty}" display="inline" intent=":literal"><semantics><mrow><mo>≥</mo><mstyle displaystyle="true"><mfrac><mn>1</mn><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo>‖</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>j</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>−</mo><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>−</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo stretchy="false">(</mo><mi>G</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mi mathvariant="normal">∞</mi></msub></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{1}{\sqrt{d}}\left\lVert f_{\mathcal{T}2}(G^{(i)})_{:,k}-f_{\mathcal{T}2}(G^{(j)})_{:,l}\right\rVert_{2}-\left\lVert\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\right\rVert_{\infty}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E40Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E40Xb.m2" class="ltx_Math" alttext="\displaystyle\geq\frac{\gamma}{\sqrt{d}}-\frac{\gamma_{1}}{2\sqrt{d}}&gt;\frac{\gamma_{1}+2\gamma_{2}}{2\sqrt{d}}&gt;\frac{\gamma_{2}}{2\sqrt{d}}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≥</mo><mrow><mstyle displaystyle="true"><mfrac><mi>γ</mi><msqrt><mi>d</mi></msqrt></mfrac></mstyle><mo>−</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>1</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><mrow><msub><mi>γ</mi><mn>1</mn></msub><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>γ</mi><mn>2</mn></msub></mrow></mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle><mo>&gt;</mo><mstyle displaystyle="true"><mfrac><msub><mi>γ</mi><mn>2</mn></msub><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow></mfrac></mstyle></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\geq\frac{\gamma}{\sqrt{d}}-\frac{\gamma_{1}}{2\sqrt{d}}&gt;\frac{\gamma_{1}+2\gamma_{2}}{2\sqrt{d}}&gt;\frac{\gamma_{2}}{2\sqrt{d}}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p3.8" class="ltx_p"><span id="A2.SS3.SSS3.p3.8.1" class="ltx_text">(<a href="#A2.E40" title="Equation 40 ‣ Proof of Lemma . ‣ B.3.3 Value Mapping 𝑓_{𝒯⁢3} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">40</span></a>) also indicates that <math id="A2.SS3.SSS3.p3.m15" class="ltx_Math" alttext="\sigma_{\zeta 1}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">\sigma_{\zeta 1}</annotation></semantics></math> won’t endow labels to the non-target columns because of the smooth gap <math id="A2.SS3.SSS3.p3.m16" class="ltx_Math" alttext="{\gamma_{2}}/({2\sqrt{d}})" display="inline" intent=":literal"><semantics><mrow><msub><mi>γ</mi><mn>2</mn></msub><mo>/</mo><mrow><mo stretchy="false">(</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">{\gamma_{2}}/({2\sqrt{d}})</annotation></semantics></math>. After layer <math id="A2.SS3.SSS3.p3.m17" class="ltx_Math" alttext="\mathrm{FF}^{(i,k,1)}(\bar{X})" display="inline" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}(\bar{X})</annotation></semantics></math>, only the target column is added with the complete label vector <math id="A2.SS3.SSS3.p3.m18" class="ltx_Math" alttext="\sqrt{d}r\cdot\mathds{1}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\sqrt{d}r\cdot\mathds{1}_{d}</annotation></semantics></math>, while the labels of other columns are incomplete.</span></p>
</div>
<div id="A2.SS3.SSS3.p4" class="ltx_para">
<p id="A2.SS3.SSS3.p4.1" class="ltx_p"><math id="A2.SS3.SSS3.p4.m1" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math><span id="A2.SS3.SSS3.p4.1.1" class="ltx_text"> As for layer <math id="A2.SS3.SSS3.p4.m2" class="ltx_Math" alttext="\mathrm{FF}^{(i,k,2)}(Z)" display="inline" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>Z</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,2)}(Z)</annotation></semantics></math>, the part “<math id="A2.SS3.SSS3.p4.m3" class="ltx_Math" alttext="\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mn>𝟙</mn><mi>d</mi><mo>⊤</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><mi>Z</mi></mrow><mo>−</mo><mrow><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup></mrow></mrow><annotation encoding="application/x-tex">\mathds{1}_{d}^{\top}\cdot Z-d\sqrt{d}r\cdot\mathds{1}_{L}^{\top}</annotation></semantics></math>” first calculates the column-wise sum of elements in <math id="A2.SS3.SSS3.p4.m4" class="ltx_Math" alttext="Z" display="inline" intent=":literal"><semantics><mi>Z</mi><annotation encoding="application/x-tex">Z</annotation></semantics></math> and then subtracts <math id="A2.SS3.SSS3.p4.m5" class="ltx_Math" alttext="d\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">d\sqrt{d}r</annotation></semantics></math> element-wisely. Results of all the non-target columns <math id="A2.SS3.SSS3.p4.m6" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,l})=Z_{:,l}" display="inline" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msub><mi>Z</mi><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,l})=Z_{:,l}</annotation></semantics></math> with <math id="A2.SS3.SSS3.p4.m7" class="ltx_Math" alttext="l\neq p" display="inline" intent=":literal"><semantics><mrow><mi>l</mi><mo>≠</mo><mi>p</mi></mrow><annotation encoding="application/x-tex">l\neq p</annotation></semantics></math> will not be greater than <math id="A2.SS3.SSS3.p4.m8" class="ltx_Math" alttext="0" display="inline" intent=":literal"><semantics><mn>0</mn><annotation encoding="application/x-tex">0</annotation></semantics></math>, since they have at most <math id="A2.SS3.SSS3.p4.m9" class="ltx_Math" alttext="d-1" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d-1</annotation></semantics></math> labels and</span></p>
<table id="A2.Ex43" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex43X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex43X.m2" class="ltx_Math" alttext="\displaystyle\max_{l\in[L],l\neq p}\sum_{j=1}^{d}Z_{j,l}-d\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mprescripts></mprescripts><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>l</mi><mo>≠</mo><mi>p</mi></mrow></mrow><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msub><mi>Z</mi><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\max_{l\in[L],l\neq p}\sum_{j=1}^{d}Z_{j,l}-d\sqrt{d}r</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43X.m3" class="ltx_Math" alttext="\displaystyle=\max_{l\in[L],l\neq p}\sum_{j=1}^{d}\bar{X}_{j,l}+(d-1)\sqrt{d}r-d\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mi>max</mi><mo lspace="0.167em">⁡</mo><mrow><mstyle displaystyle="true"><mmultiscripts><munderover><mo movablelimits="false">∑</mo><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>d</mi></munderover><mprescripts></mprescripts><mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>l</mi><mo>≠</mo><mi>p</mi></mrow></mrow><mrow></mrow></mmultiscripts></mstyle><mo>⁡</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mi>j</mi><mo>,</mo><mi>l</mi></mrow></msub></mrow></mrow><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>d</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow><mo>−</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=\max_{l\in[L],l\neq p}\sum_{j=1}^{d}\bar{X}_{j,l}+(d-1)\sqrt{d}r-d\sqrt{d}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex43Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex43Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\max_{l\in[L]}\left\lVert\bar{X}_{:,l}\right\rVert_{1}-\sqrt{d}r\leq\sqrt{d}\max_{l\in[L]}\left\lVert\bar{X}_{:,l}\right\rVert_{2}-\sqrt{d}r\leq 0." display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mi>max</mi><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>1</mn></msub><mo>−</mo><msqrt><mi>d</mi></msqrt><mi>r</mi><mo>≤</mo><msqrt><mi>d</mi></msqrt><mi>max</mi><msub><mrow></mrow><mrow><mi>l</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>l</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>−</mo><msqrt><mi>d</mi></msqrt><mi>r</mi><mo>≤</mo><mn>0</mn><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\max_{l\in[L]}\left\lVert\bar{X}_{:,l}\right\rVert_{1}-\sqrt{d}r\leq\sqrt{d}\max_{l\in[L]}\left\lVert\bar{X}_{:,l}\right\rVert_{2}-\sqrt{d}r\leq 0.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p4.2" class="ltx_p"><span id="A2.SS3.SSS3.p4.2.1" class="ltx_text">Furthermore, <math id="A2.SS3.SSS3.p4.m10" class="ltx_Math" alttext="\sigma_{\zeta 2}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><annotation encoding="application/x-tex">\sigma_{\zeta 2}</annotation></semantics></math> maps the target column to <math id="A2.SS3.SSS3.p4.m11" class="ltx_Math" alttext="1" display="inline" intent=":literal"><semantics><mn>1</mn><annotation encoding="application/x-tex">1</annotation></semantics></math> successfully, since for the target column, based on (<a href="#A2.E31" title="Equation 31 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">31</span></a>) we have</span></p>
<table id="A2.Ex44" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex44X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex44X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert\bar{X}_{:,p}\right\rVert_{1}\geq\left\lVert\bar{X}_{:,p}\right\rVert_{2}\geq r_{2}&gt;\gamma_{2}." display="inline" intent=":literal"><semantics><mrow><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>1</mn></msub><mo>≥</mo><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>≥</mo><mi>r</mi><msub><mrow></mrow><mn>2</mn></msub><mo>&gt;</mo><mi>γ</mi><msub><mrow></mrow><mn>2</mn></msub><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\left\lVert\bar{X}_{:,p}\right\rVert_{1}\geq\left\lVert\bar{X}_{:,p}\right\rVert_{2}\geq r_{2}&gt;\gamma_{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p4.3" class="ltx_p"><span id="A2.SS3.SSS3.p4.3.1" class="ltx_text">The part <math id="A2.SS3.SSS3.p4.m12" class="ltx_Math" alttext="\sigma_{\zeta 3}" display="inline" intent=":literal"><semantics><msub><mi>σ</mi><mrow><mi>ζ</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">\sigma_{\zeta 3}</annotation></semantics></math> just eliminates the temporary labels remaining in other non-target columns. Remind that we suppose the target column <math id="A2.SS3.SSS3.p4.m13" class="ltx_math_unparsed" alttext="\bar{X}_{:,p}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{X}_{:,p}</annotation></semantics></math> is close to <math id="A2.SS3.SSS3.p4.m14" class="ltx_math_unparsed" alttext="f_{\mathcal{T},c2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{\mathcal{T},c2}(G^{(i)})_{:,k}</annotation></semantics></math>. Thus for this current input <math id="A2.SS3.SSS3.p4.m15" class="ltx_Math" alttext="\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}\}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mo stretchy="false">{</mo><mrow><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo fence="true" lspace="0em" rspace="0em">∣</mo><mrow><mi>X</mi><mo rspace="0.111em">∈</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow><mo stretchy="false">}</mo></mrow></mrow><annotation encoding="application/x-tex">\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}\}</annotation></semantics></math>, we have <math id="A2.SS3.SSS3.p4.m16" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,2)}\circ\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,p})=Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}" display="inline" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,2)}\circ\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,p})=Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}</annotation></semantics></math> and other columns remain unchanged. Result of this subunit will not involve in the calculations of other subunits due to the existence of <math id="A2.SS3.SSS3.p4.m17" class="ltx_Math" alttext="r+K." display="inline" intent=":literal"><semantics><mrow><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">r+K.</annotation></semantics></math></span></p>
</div>
<div id="A2.SS3.SSS3.p5" class="ltx_para">
<p id="A2.SS3.SSS3.p5.1" class="ltx_p"><math id="A2.SS3.SSS3.p5.m1" class="ltx_Math" alttext="\bullet" display="inline" intent=":literal"><semantics><mo>∙</mo><annotation encoding="application/x-tex">\bullet</annotation></semantics></math><span id="A2.SS3.SSS3.p5.1.1" class="ltx_text"> We have at most <math id="A2.SS3.SSS3.p5.m2" class="ltx_Math" alttext="LM_{\mathrm{all}}" display="inline" intent=":literal"><semantics><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>all</mi></msub></mrow><annotation encoding="application/x-tex">LM_{\mathrm{all}}</annotation></semantics></math> such subunits with anchor vectors <math id="A2.SS3.SSS3.p5.m3" class="ltx_math_unparsed" alttext="f_{\mathcal{T}2}(G^{(i)})_{:,k}," display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}2}(G^{(i)})_{:,k},</annotation></semantics></math> for all <math id="A2.SS3.SSS3.p5.m4" class="ltx_Math" alttext="i\in[M_{\mathrm{all}}],k\in[L]" display="inline" intent=":literal"><semantics><mrow><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><msub><mi>M</mi><mi>all</mi></msub><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><mi>k</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">i\in[M_{\mathrm{all}}],k\in[L]</annotation></semantics></math>. Stacking these <math id="A2.SS3.SSS3.p5.m5" class="ltx_Math" alttext="2LM_{\mathrm{all}}=2LM^{d_{0}}" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msub><mi>M</mi><mi>all</mi></msub></mrow><mo>=</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow></mrow><annotation encoding="application/x-tex">2LM_{\mathrm{all}}=2LM^{d_{0}}</annotation></semantics></math> feed-forward layers, any contextual grid column <math id="A2.SS3.SSS3.p5.m6" class="ltx_math_unparsed" alttext="f_{\mathcal{T}2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}2}(G^{(i)})_{:,k}</annotation></semantics></math> is mapped to the target value vector <math id="A2.SS3.SSS3.p5.m7" class="ltx_math_unparsed" alttext="Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}</annotation></semantics></math>. We only require an extra feed-forward layer <math id="A2.SS3.SSS3.p5.m8" class="ltx_Math" alttext="\mathrm{FF^{(extra)}}" display="inline" intent=":literal"><semantics><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>extra</mi><mo stretchy="false">)</mo></mrow></msup><annotation encoding="application/x-tex">\mathrm{FF^{(extra)}}</annotation></semantics></math> to subtract the redundant <math id="A2.SS3.SSS3.p5.m9" class="ltx_Math" alttext="(r+K)\cdot\mathds{1}_{d}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub></mrow><annotation encoding="application/x-tex">(r+K)\cdot\mathds{1}_{d}</annotation></semantics></math> vector in each column. Therefore, we construct the value mapping composed of <math id="A2.SS3.SSS3.p5.m10" class="ltx_Math" alttext="2LM^{d_{0}}+1" display="inline" intent=":literal"><semantics><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">2LM^{d_{0}}+1</annotation></semantics></math> feed-forward layers</span></p>
<table id="A2.Ex45" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex45.m1" class="ltx_math_unparsed" alttext="f_{\mathcal{T}3}=\mathrm{FF}^{(\rm extra)}\circ\mathrm{FF}^{(M^{d_{0}},L,2)}\circ\mathrm{FF}^{(M^{d_{0}},L,1)}\circ\cdots\circ\mathrm{FF}^{(1,1,2)}\circ\mathrm{FF}^{(1,1,1)}," display="block" intent=":literal"><semantics><mrow><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo>=</mo><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mi>extra</mi><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>L</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>L</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em">∘</mo><mo lspace="0.055em" rspace="0.055em">⋯</mo><mo rspace="0.222em">∘</mo><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>FF</mi><msup><mrow></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mo>,</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}3}=\mathrm{FF}^{(\rm extra)}\circ\mathrm{FF}^{(M^{d_{0}},L,2)}\circ\mathrm{FF}^{(M^{d_{0}},L,1)}\circ\cdots\circ\mathrm{FF}^{(1,1,2)}\circ\mathrm{FF}^{(1,1,1)},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS3.SSS3.p5.2" class="ltx_p"><span id="A2.SS3.SSS3.p5.2.1" class="ltx_text">such that <math id="A2.SS3.SSS3.p5.m11" class="ltx_Math" alttext="f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)=Y_{G},\forall G\in\mathcal{G}_{\delta,\delta^{*}}^{p}." display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mrow><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><msub><mi>Y</mi><mi>G</mi></msub></mrow><mo>,</mo><mrow><mrow><mo rspace="0.167em">∀</mo><mi>G</mi></mrow><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)=Y_{G},\forall G\in\mathcal{G}_{\delta,\delta^{*}}^{p}.</annotation></semantics></math> Till now, we have already proven Lemma <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a>.
∎</span></p>
</div>
</div>
<div id="A2.Thmtheorem8" class="ltx_theorem ltx_theorem_remark">
<h6 class="ltx_title ltx_runin ltx_title_theorem"><span class="ltx_tag ltx_tag_theorem"><span id="A2.Thmtheorem8.2" class="ltx_text ltx_font_bold">Remark B.8</span></span><span id="A2.Thmtheorem8.3" class="ltx_text ltx_font_bold"> </span>(Extensions)<span id="A2.Thmtheorem8.4" class="ltx_text ltx_font_bold">.</span></h6>
<div id="A2.Thmtheorem8.p1" class="ltx_para">
<p id="A2.Thmtheorem8.p1.1" class="ltx_p">Actually, we can discuss a more general conclusion for the value mapping <math id="A2.Thmtheorem8.p1.m1" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math> applied on</p>
<table id="A2.Ex46" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex46.m1" class="ltx_math_unparsed" alttext="\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bar{\mathcal{X}}^{p}=[0,1]^{d\times L}+E,E\mathrm{~is~defined~in~}\eqref{eq:Positional-encoding}\}." display="block" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>∈</mo><mrow><mo stretchy="false">{</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0.167em">∣</mo><mi>X</mi><mo>∈</mo><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>¯</mo></mover><mi>p</mi></msup><mo>=</mo><msup><mrow><mo stretchy="false">[</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo>+</mo><mi>E</mi><mo>,</mo><mi>E</mi><mi>is</mi><mi>defined</mi><mi>in</mi><mrow><mtext>(</mtext><mtext><a href="#A2.E23" title="Equation 23 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a></mtext><mtext>)</mtext></mrow><mo stretchy="false">}</mo></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\bar{X}\in\{f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X)\mid X\in\bar{\mathcal{X}}^{p}=[0,1]^{d\times L}+E,E\mathrm{~is~defined~in~}\eqref{eq:Positional-encoding}\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem8.p1.2" class="ltx_p">Lemma <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a> corresponds to the case when <math id="A2.Thmtheorem8.p1.m2" class="ltx_Math" alttext="X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo rspace="0.111em">∈</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow><annotation encoding="application/x-tex">X\in\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}</annotation></semantics></math>. For completeness, now we discuss the case when <math id="A2.Thmtheorem8.p1.m3" class="ltx_Math" alttext="{X}\in\bar{\mathcal{X}}^{p}\setminus\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><msup><mover accent="true"><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>¯</mo></mover><mi>p</mi></msup><mo rspace="0.055em">∖</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mi>p</mi></msubsup></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">{X}\in\bar{\mathcal{X}}^{p}\setminus\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}^{p}}\mathcal{S}_{G}</annotation></semantics></math>. If the column <math id="A2.Thmtheorem8.p1.m4" class="ltx_math_unparsed" alttext="\bar{X}_{:,p}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>¯</mo></mover><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub></mrow><annotation encoding="application/x-tex">\bar{X}_{:,p}</annotation></semantics></math> is close to <math id="A2.Thmtheorem8.p1.m5" class="ltx_math_unparsed" alttext="f_{\mathcal{T},c2}(G^{(i)})_{:,k}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo>,</mo><mrow><mi>c</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub></mrow><annotation encoding="application/x-tex">f_{\mathcal{T},c2}(G^{(i)})_{:,k}</annotation></semantics></math>, we will still obtain the calculation results as the following</p>
<table id="A2.Ex47" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex47.m1" class="ltx_math_unparsed" alttext="\mathrm{FF}^{(i,k,2)}\circ\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,p})=Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}+\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\approx Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}," display="block" intent=":literal"><semantics><mrow><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msup><mi>FF</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo>,</mo><mi>k</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msup><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>=</mo><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub><mo>+</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo>−</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><msub><mrow><mo stretchy="false">(</mo><msup><mi>G</mi><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msup><mo stretchy="false">)</mo></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi></mrow></msub><mo>≈</mo><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><mrow><mo stretchy="false">(</mo><mi>r</mi><mo>+</mo><mi>K</mi><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mi>d</mi></msub><mo>,</mo></mrow><annotation encoding="application/x-tex">\mathrm{FF}^{(i,k,2)}\circ\mathrm{FF}^{(i,k,1)}(\bar{X}_{:,p})=Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d}+\bar{X}_{:,p}-f_{\mathcal{T}2}(G^{(i)})_{:,k}\approx Y_{G:,k}^{(i)}+(r+K)\cdot\mathds{1}_{d},</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.Thmtheorem8.p1.3" class="ltx_p">and <math id="A2.Thmtheorem8.p1.m6" class="ltx_math_unparsed" alttext="f_{\mathcal{T}3}(\bar{X}_{:,p})\approx Y_{G:,k}^{(i)}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mrow><mo stretchy="false">(</mo><msub><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>p</mi></mrow></msub><mo stretchy="false">)</mo></mrow><mo>≈</mo><msubsup><mi>Y</mi><mrow><mrow><mi>G</mi><mo lspace="0.278em" rspace="0.278em">:</mo><mphantom></mphantom></mrow><mo>,</mo><mi>k</mi></mrow><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}3}(\bar{X}_{:,p})\approx Y_{G:,k}^{(i)}</annotation></semantics></math>. On the other hand, the set of non-target <math id="A2.Thmtheorem8.p1.m7" class="ltx_Math" alttext="\bar{X}" display="inline" intent=":literal"><semantics><mover accent="true"><mi>X</mi><mo>¯</mo></mover><annotation encoding="application/x-tex">\bar{X}</annotation></semantics></math> whose columns are not close to any columns of the anchor values will remain unchanged. This corresponding part of the value mapping <math id="A2.Thmtheorem8.p1.m8" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math> can be controlled since the measure of complementary set is bounded, which will be important and useful in the subsequent verification part.</p>
</div>
</div>
</section>
</section>
<section id="A2.SS4" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.4 </span>Verification for the Approximation Error Upper Bound</h3>

<div id="A2.SS4.p1" class="ltx_para ltx_noindent">
<p id="A2.SS4.p1.1" class="ltx_p"><span id="A2.SS4.p1.1.1" class="ltx_text ltx_font_bold">Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a></span> (Upper Bound of Approximation Error; Restatement)<span id="A2.SS4.p1.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A2.SS4.p1.1.3" class="ltx_text ltx_font_italic">Let <math id="A2.SS4.p1.m1" class="ltx_Math" alttext="\alpha\in(0,1],d_{0}\in\mathbb{N}_{+},d_{0}&gt;2\alpha," display="inline" intent=":literal"><semantics><mrow><mrow><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><mo>,</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><mo>,</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>&gt;</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>α</mi></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\alpha\in(0,1],d_{0}\in\mathbb{N}_{+},d_{0}&gt;2\alpha,</annotation></semantics></math> and <math id="A2.SS4.p1.m2" class="ltx_Math" alttext="K\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow><annotation encoding="application/x-tex">K\in\mathbb{N}_{+}</annotation></semantics></math>. For any target function <math id="A2.SS4.p1.m3" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0}}^{\alpha}([0,1]^{d_{0}},K)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0}}^{\alpha}([0,1]^{d_{0}},K)</annotation></semantics></math> and any error criterion <math id="A2.SS4.p1.m4" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>, there exists a Transformer function <math id="A2.SS4.p1.m5" class="ltx_Math" alttext="g\in\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow><annotation encoding="application/x-tex">g\in\mathcal{T}_{R}^{D}</annotation></semantics></math> composed of at most <math id="A2.SS4.p1.m6" class="ltx_Math" alttext="\mathcal{O}(\varepsilon^{-\frac{d_{0}}{\alpha}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(\varepsilon^{-\frac{d_{0}}{\alpha}})</annotation></semantics></math> blocks such that <math id="A2.SS4.p1.m7" class="ltx_Math" alttext="\left\lVert f-g\right\rVert_{2}&lt;\varepsilon." display="inline" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>g</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert f-g\right\rVert_{2}&lt;\varepsilon.</annotation></semantics></math></span></p>
</div>
<div id="A2.SS4.2" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS4.2.1" class="ltx_text ltx_font_bold">Proof of Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a></span>.</h6>
<div id="A2.SS4.p2" class="ltx_para">
<p id="A2.SS4.p2.1" class="ltx_p"><span id="A2.SS4.p2.1.1" class="ltx_text">The Transformer network <math id="A2.SS4.p2.m1" class="ltx_Math" alttext="f_{\mathcal{T}}(X)=f_{\mathcal{T}3}\circ f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X+E)" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>X</mi><mo>+</mo><mi>E</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}}(X)=f_{\mathcal{T}3}\circ f_{\mathcal{T}2}\circ f_{\mathcal{T}1}(X+E)</annotation></semantics></math> is composed of <math id="A2.SS4.p2.m2" class="ltx_Math" alttext="d_{0}M+2LM^{d_{0}}+1" display="inline" intent=":literal"><semantics><mrow><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">d_{0}M+2LM^{d_{0}}+1</annotation></semantics></math> feed-forward layers and one self-attention layer, i.e., <math id="A2.SS4.p2.m3" class="ltx_Math" alttext="d_{0}M+2LM^{d_{0}}+2=\mathcal{O}(\varepsilon^{-\frac{d_{0}}{\alpha}})" display="inline" intent=":literal"><semantics><mrow><mrow><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo>+</mo><mn>2</mn></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">d_{0}M+2LM^{d_{0}}+2=\mathcal{O}(\varepsilon^{-\frac{d_{0}}{\alpha}})</annotation></semantics></math> blocks, since</span></p>
<table id="A2.E41" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.E41.m1" class="ltx_Math" alttext="M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor\leq\frac{1}{\delta+\delta^{*}}&lt;\frac{1}{\delta}\lesssim\varepsilon^{-\frac{1}{\alpha}},~~\mathrm{where}~~\delta=\mathcal{O}(\varepsilon^{\frac{1}{\alpha}})." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow><mo>≤</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo>&lt;</mo><mfrac><mn>1</mn><mi>δ</mi></mfrac><mo>≲</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><mn>1</mn><mi>α</mi></mfrac></mrow></msup></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mi>where</mi><mo lspace="0.660em" rspace="0em">​</mo><mi>δ</mi></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mfrac><mn>1</mn><mi>α</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor\leq\frac{1}{\delta+\delta^{*}}&lt;\frac{1}{\delta}\lesssim\varepsilon^{-\frac{1}{\alpha}},~~\mathrm{where}~~\delta=\mathcal{O}(\varepsilon^{\frac{1}{\alpha}}).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equation ltx_align_right">(41)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p2.2" class="ltx_p"><span id="A2.SS4.p2.2.1" class="ltx_text">Now we first verify the upper bound of approximation error between the piece-wise constant function class <math id="A2.SS4.p2.m4" class="ltx_Math" alttext="\mathcal{H}(\delta)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}(\delta)</annotation></semantics></math> and the Transformer network class <math id="A2.SS4.p2.m5" class="ltx_Math" alttext="\mathcal{T}^{D}" display="inline" intent=":literal"><semantics><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>D</mi></msup><annotation encoding="application/x-tex">\mathcal{T}^{D}</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.p3" class="ltx_para">
<p id="A2.SS4.p3.1" class="ltx_p"><span id="A2.SS4.p3.1.1" class="ltx_text">Based on Lemmas from <a href="#S4.Thmtheorem7" title="Lemma 4.7 (Quantization Module 𝑓_{𝒯⁢1}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a> to <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a>, for any <math id="A2.SS4.p3.m1" class="ltx_Math" alttext="f_{\delta}\in\mathcal{H}(\delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\delta}\in\mathcal{H}(\delta)</annotation></semantics></math>, there exists an <math id="A2.SS4.p3.m2" class="ltx_Math" alttext="f_{\mathcal{T}}\in\mathcal{T}^{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}}\in\mathcal{T}^{D}</annotation></semantics></math> such that</span></p>
<table id="A2.Ex48" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex48.m1" class="ltx_Math" alttext="f_{\mathcal{T}}(X)=f_{\delta}(X),~~\mathrm{for}~~X\in\bigcup\nolimits_{G\in\mathcal{G}_{\delta,\delta^{*}}}\mathcal{S}_{G}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo rspace="0.827em">,</mo><mrow><mrow><mi>for</mi><mo lspace="0.660em" rspace="0em">​</mo><mi>X</mi></mrow><mo rspace="0.111em">∈</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></msub></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}}(X)=f_{\delta}(X),~~\mathrm{for}~~X\in\bigcup\nolimits_{G\in\mathcal{G}_{\delta,\delta^{*}}}\mathcal{S}_{G}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.2" class="ltx_p"><span id="A2.SS4.p3.2.1" class="ltx_text">For <math id="A2.SS4.p3.m3" class="ltx_Math" alttext="X\in[0,1]^{d\times L}\setminus\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}}\mathcal{S}_{G}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo rspace="0.055em">∖</mo><mrow><msub><mo>⋃</mo><mrow><mi>G</mi><mo>∈</mo><msub><mi class="ltx_font_mathcaligraphic">𝒢</mi><mrow><mi>δ</mi><mo>,</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></msub></mrow></msub><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">X\in[0,1]^{d\times L}\setminus\bigcup_{G\in\mathcal{G}_{\delta,\delta^{*}}}\mathcal{S}_{G}</annotation></semantics></math>, every element of <math id="A2.SS4.p3.m4" class="ltx_Math" alttext="f_{\mathcal{T}1}(X)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}1}(X)</annotation></semantics></math> is in <math id="A2.SS4.p3.m5" class="ltx_Math" alttext="[1,L+1]" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">[</mo><mrow><mn>1</mn><mo>,</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow></mrow><mo stretchy="false">]</mo></mrow><annotation encoding="application/x-tex">[1,L+1]</annotation></semantics></math> based on (<a href="#A2.E23" title="Equation 23 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">23</span></a>) and (<a href="#A2.E24" title="Equation 24 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>). Furthermore, based on (<a href="#A2.E34" title="Equation 34 ‣ Proof of Lemma . ‣ B.3.2 Contextual Mapping 𝑓_{𝒯⁢2} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a>) we have</span></p>
<table id="A2.Ex49" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex49X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex49X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert\bar{X}\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\bar{X}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49X.m3" class="ltx_Math" alttext="\displaystyle\coloneq\left\lVert f_{\mathcal{T}2}(f_{\mathcal{T}1}(X))\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≔</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle\coloneq\left\lVert f_{\mathcal{T}2}(f_{\mathcal{T}1}(X))\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lVert f_{\mathcal{T}1}(X)\right\rVert_{2}+\left\lVert W_{O}W_{V}f_{\mathcal{T}1}(X)\sigma_{S}\left[(W_{K}f_{\mathcal{T}1}(X))^{\top}W_{Q}f_{\mathcal{T}1}(X)\right]\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>W</mi><mi>O</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>V</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>S</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><msub><mi>W</mi><mi>K</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">)</mo></mrow><mo>⊤</mo></msup><mo lspace="0em" rspace="0em">​</mo><msub><mi>W</mi><mi>Q</mi></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>]</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert f_{\mathcal{T}1}(X)\right\rVert_{2}+\left\lVert W_{O}W_{V}f_{\mathcal{T}1}(X)\sigma_{S}\left[(W_{K}f_{\mathcal{T}1}(X))^{\top}W_{Q}f_{\mathcal{T}1}(X)\right]\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lVert f_{\mathcal{T}1}(X)\right\rVert_{2}+\sqrt{L}\max_{k^{\prime}\in[L]}\left\lVert f_{\mathcal{T}1}(X)_{:,k^{\prime}}\right\rVert_{2}\cdot\frac{\sqrt{d}(\delta+\delta^{*})}{4\sqrt{d}(L+1)}" display="inline" intent=":literal"><semantics><mrow><mo>≤</mo><mo>‖</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo><mo>‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo>+</mo><msqrt><mi>L</mi></msqrt><mi>max</mi><msub><mrow></mrow><mrow><msup><mi>k</mi><mo>′</mo></msup><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>L</mi><mo stretchy="false">]</mo></mrow></mrow></msub><mo>‖</mo><mi>f</mi><msub><mrow></mrow><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>1</mn></mrow></msub><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo><msub><mrow></mrow><mrow><mo rspace="0em">:</mo><mo>,</mo><mi>k</mi><msup><mrow></mrow><mo>′</mo></msup></mrow></msub><mo rspace="0.055em">‖</mo><msub><mrow></mrow><mn>2</mn></msub><mo rspace="0.222em">⋅</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac></mstyle></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert f_{\mathcal{T}1}(X)\right\rVert_{2}+\sqrt{L}\max_{k^{\prime}\in[L]}\left\lVert f_{\mathcal{T}1}(X)_{:,k^{\prime}}\right\rVert_{2}\cdot\frac{\sqrt{d}(\delta+\delta^{*})}{4\sqrt{d}(L+1)}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex49Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex49Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4}." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.3" class="ltx_p"><span id="A2.SS4.p3.3.1" class="ltx_text">Then for the last value mapping <math id="A2.SS4.p3.m6" class="ltx_Math" alttext="f_{\mathcal{T}3}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><annotation encoding="application/x-tex">f_{\mathcal{T}3}</annotation></semantics></math>,</span></p>
<table id="A2.Ex50" class="ltx_equationgroup ltx_eqn_table">

<tbody id="A2.Ex50X"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.Ex50X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert f_{\mathcal{T}}({X})\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert f_{\mathcal{T}}({X})\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50X.m3" class="ltx_Math" alttext="\displaystyle=\left\lVert f_{\mathcal{T}3}(\bar{X})\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\lVert f_{\mathcal{T}3}(\bar{X})\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50Xa"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50Xa.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lVert\bar{X}\right\rVert_{2}+\max_{G}\Big\|Y_{G}+(r+K)\cdot\mathds{1}_{d\times L}-f_{\mathcal{T}2}(G)\Big\|_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><munder><mi>max</mi><mi>G</mi></munder><mo>⁡</mo><msub><mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo><mrow><mrow><msub><mi>Y</mi><mi>G</mi></msub><mo>+</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\bar{X}\right\rVert_{2}+\max_{G}\Big\|Y_{G}+(r+K)\cdot\mathds{1}_{d\times L}-f_{\mathcal{T}2}(G)\Big\|_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50Xb"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50Xb.m2" class="ltx_Math" alttext="\displaystyle\leq\left\lVert\bar{X}\right\rVert_{2}+\big\|(r+K)\cdot\mathds{1}_{d\times L}\big\|_{2}+\max_{G}\{\big\|Y_{G}\big\|_{2}+\big\|f_{\mathcal{T}2}(G)\big\|_{2}\}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mover accent="true"><mi>X</mi><mo>¯</mo></mover><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><msub><mn>𝟙</mn><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msub></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><mrow><munder><mi>max</mi><mi>G</mi></munder><mo>⁡</mo><mrow><mo stretchy="false">{</mo><mrow><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><msub><mi>Y</mi><mi>G</mi></msub><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow><mo maxsize="1.200em" minsize="1.200em" stretchy="true">‖</mo></mrow><mn>2</mn></msub></mrow><mo stretchy="false">}</mo></mrow></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\bar{X}\right\rVert_{2}+\big\|(r+K)\cdot\mathds{1}_{d\times L}\big\|_{2}+\max_{G}\{\big\|Y_{G}\big\|_{2}+\big\|f_{\mathcal{T}2}(G)\big\|_{2}\}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50Xc"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50Xc.m2" class="ltx_Math" alttext="\displaystyle\leq\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4}+\sqrt{d_{0}}(r+K)+\sqrt{d_{0}}K+\sqrt{L}r" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>≤</mo><mrow><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle><mo>+</mo><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>r</mi><mo>+</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow><mo>+</mo><mrow><msqrt><mi>L</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle\leq\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4}+\sqrt{d_{0}}(r+K)+\sqrt{d_{0}}K+\sqrt{L}r</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50Xd"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50Xd.m2" class="ltx_Math" alttext="\displaystyle=(\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4})\cdot(\sqrt{d}+2)+2\sqrt{d_{0}}K" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><mrow><mrow><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mrow><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mstyle></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mo rspace="0.222em">⋅</mo><mrow><mo stretchy="false">(</mo><mrow><msqrt><mi>d</mi></msqrt><mo>+</mo><mn>2</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>K</mi></mrow></mrow></mrow><annotation encoding="application/x-tex">\displaystyle=(\sqrt{d_{0}}(L+1)+\frac{\sqrt{d_{0}}(\delta+\delta^{*})}{4})\cdot(\sqrt{d}+2)+2\sqrt{d_{0}}K</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
<tbody id="A2.Ex50Xe"><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.Ex50Xe.m2" class="ltx_Math" alttext="\displaystyle\leq 2\sqrt{d_{0}}(K+\frac{1}{2}(\sqrt{d}L+2L+\frac{5}{4}\sqrt{d}+\frac{5}{2}))\leq 2\sqrt{d_{0}}(4d_{0}+K)," display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>K</mi><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>1</mn><mn>2</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><mfrac><mn>5</mn><mn>4</mn></mfrac></mstyle><mo lspace="0em" rspace="0em">​</mo><msqrt><mi>d</mi></msqrt></mrow><mo>+</mo><mstyle displaystyle="true"><mfrac><mn>5</mn><mn>2</mn></mfrac></mstyle></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>≤</mo><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq 2\sqrt{d_{0}}(K+\frac{1}{2}(\sqrt{d}L+2L+\frac{5}{4}\sqrt{d}+\frac{5}{2}))\leq 2\sqrt{d_{0}}(4d_{0}+K),</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p3.4" class="ltx_p"><span id="A2.SS4.p3.4.1" class="ltx_text">where the first inequality comes from that the label <math id="A2.SS4.p3.m7" class="ltx_Math" alttext="\sqrt{d}r" display="inline" intent=":literal"><semantics><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mi>r</mi></mrow><annotation encoding="application/x-tex">\sqrt{d}r</annotation></semantics></math> will be eliminated in every subunit once being gotten. And
the final result is with <math id="A2.SS4.p3.m8" class="ltx_Math" alttext="r=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4}" display="inline" intent=":literal"><semantics><mrow><mi>r</mi><mo>=</mo><mrow><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo>+</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow></mrow><mo>+</mo><mfrac><mrow><msqrt><mi>d</mi></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><mn>4</mn></mfrac></mrow></mrow><annotation encoding="application/x-tex">r=\sqrt{d}(L+1)+\frac{\sqrt{d}(\delta+\delta^{*})}{4}</annotation></semantics></math> and <math id="A2.SS4.p3.m9" class="ltx_Math" alttext="\delta+\delta^{*}&lt;1" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow><mo>&lt;</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">\delta+\delta^{*}&lt;1</annotation></semantics></math>.</span></p>
</div>
<div id="A2.SS4.p4" class="ltx_para">
<p id="A2.SS4.p4.2" class="ltx_p"><span id="A2.SS4.p4.2.1" class="ltx_text">In a nut, the approximation error for <math id="A2.SS4.p4.m1" class="ltx_Math" alttext="f_{\delta}\in\mathcal{H}(\delta)" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>∈</mo><mrow><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>δ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f_{\delta}\in\mathcal{H}(\delta)</annotation></semantics></math> by Transformer <math id="A2.SS4.p4.m2" class="ltx_Math" alttext="f_{\mathcal{T}}\in\mathcal{T}^{D}" display="inline" intent=":literal"><semantics><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo>∈</mo><msup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>D</mi></msup></mrow><annotation encoding="application/x-tex">f_{\mathcal{T}}\in\mathcal{T}^{D}</annotation></semantics></math> is</span></p>
<table id="A2.E42" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E42X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E42X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="4" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(42)</span></td></tr>
<tr id="A2.E42Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E42Xa.m2" class="ltx_Math" alttext="\displaystyle=\Big(\int_{\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X+\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>G</mi></msub></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></msub></mstyle><mrow><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>X</mi></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo>∖</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>G</mi></msub></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></msub></mstyle><mrow><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>X</mi></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\Big(\int_{\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X+\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E42Xb" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E42Xb.m2" class="ltx_Math" alttext="\displaystyle=\Big(\int_{\bigcup_{G}\mathcal{S}_{G}}\left\lVert Y_{G}-f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)\right\rVert_{F}^{2}\mathrm{d}X+\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>G</mi></msub></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></msub></mstyle><mrow><msubsup><mrow><mo>‖</mo><mrow><msub><mi>Y</mi><mi>G</mi></msub><mo>−</mo><mrow><mrow><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>3</mn></mrow></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mrow><mi class="ltx_font_mathcaligraphic">𝒯</mi><mo lspace="0em" rspace="0em">​</mo><mn>2</mn></mrow></msub></mrow><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>G</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>X</mi></mrow></mrow></mrow><mo>+</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo>∖</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>G</mi></msub></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></msub></mstyle><mrow><msubsup><mrow><mo>‖</mo><mrow><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>−</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo mathsize="0.700em" rspace="0em">𝑑</mo><mi>X</mi></mrow></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><annotation encoding="application/x-tex">\displaystyle=\Big(\int_{\bigcup_{G}\mathcal{S}_{G}}\left\lVert Y_{G}-f_{\mathcal{T}3}\circ f_{\mathcal{T}2}(G)\right\rVert_{F}^{2}\mathrm{d}X+\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\delta}(X)-f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr>
<tr id="A2.E42Xc" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E42Xc.m2" class="ltx_Math" alttext="\displaystyle=\Big(\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}\leq(1-M\delta)^{d_{0}/2}\cdot 2\sqrt{d_{0}}(4d_{0}+K)." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msup><mrow><mo maxsize="1.600em" minsize="1.600em">(</mo><mrow><mstyle displaystyle="true"><msub><mo>∫</mo><mrow><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup><mo>∖</mo><mrow><mstyle displaystyle="false"><msub><mo maxsize="0.700em" minsize="0.700em" stretchy="true">⋃</mo><mi>G</mi></msub></mstyle><msub><mi class="ltx_font_mathcaligraphic">𝒮</mi><mi>G</mi></msub></mrow></mrow></msub></mstyle><mrow><msubsup><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mrow><mo>‖</mo></mrow><mi>F</mi><mn>2</mn></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo rspace="0em">d</mo><mi>X</mi></mrow></mrow></mrow><mo maxsize="1.600em" minsize="1.600em">)</mo></mrow><mrow><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>≤</mo><mrow><mrow><msup><mrow><mo stretchy="false">(</mo><mrow><mn>1</mn><mo>−</mo><mrow><mi>M</mi><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow></mrow><mo rspace="0.055em" stretchy="false">)</mo></mrow><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>/</mo><mn>2</mn></mrow></msup><mo rspace="0.222em">⋅</mo><mn>2</mn></mrow><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\Big(\int_{[0,1]^{d\times L}\setminus\bigcup_{G}\mathcal{S}_{G}}\left\lVert f_{\mathcal{T}}(X)\right\rVert_{F}^{2}\mathrm{d}X\Big)^{1/2}\leq(1-M\delta)^{d_{0}/2}\cdot 2\sqrt{d_{0}}(4d_{0}+K).</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p4.3" class="ltx_p"><span id="A2.SS4.p4.3.1" class="ltx_text">Furthermore, denote <math id="A2.SS4.p4.m3" class="ltx_Math" alttext="c_{3}=(\frac{\varepsilon}{4\sqrt{d_{0}}(4d_{0}+K)})^{2/d_{0}}" display="inline" intent=":literal"><semantics><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>=</mo><msup><mrow><mo stretchy="false">(</mo><mfrac><mi>ε</mi><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msqrt><msub><mi>d</mi><mn>0</mn></msub></msqrt><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mrow><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mo>+</mo><mi>K</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mfrac><mo stretchy="false">)</mo></mrow><mrow><mn>2</mn><mo>/</mo><msub><mi>d</mi><mn>0</mn></msub></mrow></msup></mrow><annotation encoding="application/x-tex">c_{3}=(\frac{\varepsilon}{4\sqrt{d_{0}}(4d_{0}+K)})^{2/d_{0}}</annotation></semantics></math> and let <math id="A2.SS4.p4.m4" class="ltx_Math" alttext="\delta^{*}&lt;\frac{(c_{3}-\delta)\delta}{2}=\mathcal{O}(\varepsilon^{\frac{2}{d_{0}}+\frac{1}{\alpha}})" display="inline" intent=":literal"><semantics><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>&lt;</mo><mfrac><mrow><mrow><mo stretchy="false">(</mo><mrow><msub><mi>c</mi><mn>3</mn></msub><mo>−</mo><mi>δ</mi></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>δ</mi></mrow><mn>2</mn></mfrac><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mfrac><mn>2</mn><msub><mi>d</mi><mn>0</mn></msub></mfrac><mo>+</mo><mfrac><mn>1</mn><mi>α</mi></mfrac></mrow></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta^{*}&lt;\frac{(c_{3}-\delta)\delta}{2}=\mathcal{O}(\varepsilon^{\frac{2}{d_{0}}+\frac{1}{\alpha}})</annotation></semantics></math> and <math id="A2.SS4.p4.m5" class="ltx_Math" alttext="\delta=\mathcal{O}(\varepsilon^{\frac{1}{\alpha}})" display="inline" intent=":literal"><semantics><mrow><mi>δ</mi><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mfrac><mn>1</mn><mi>α</mi></mfrac></msup><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta=\mathcal{O}(\varepsilon^{\frac{1}{\alpha}})</annotation></semantics></math>. Similar to (<a href="#A2.E22" title="Equation 22 ‣ Proof of Lemma . ‣ B.2 Approximation Error Between Hölder Class and Piece-wise Constant Function Class ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">22</span></a>), we have</span></p>
<table id="A2.Ex51" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex51.m1" class="ltx_Math" alttext="\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\frac{\varepsilon}{2}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>&lt;</mo><mfrac><mi>ε</mi><mn>2</mn></mfrac></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\frac{\varepsilon}{2}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p4.4" class="ltx_p"><span id="A2.SS4.p4.4.1" class="ltx_text">Directly with Lemma <a href="#S4.Thmtheorem6" title="Lemma 4.6 (Approximation Error between ℋ̄_{𝑑,𝐿}^𝛼 and ℋ(𝛿)). ‣ 4.1 Approximation for Hölder Class by Piece-wise Constant Function Class ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.6</span></a> and above results, we get the approximation upper bound for any <math id="A2.SS4.p4.m6" class="ltx_Math" alttext="\bar{f}\in\bar{\mathcal{H}}_{d,L}^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>∈</mo><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic">ℋ</mi><mo>¯</mo></mover><mrow><mi>d</mi><mo>,</mo><mi>L</mi></mrow><mi>α</mi></msubsup></mrow><annotation encoding="application/x-tex">\bar{f}\in\bar{\mathcal{H}}_{d,L}^{\alpha}</annotation></semantics></math> by Transformer <math id="A2.SS4.p4.m7" class="ltx_Math" alttext="f_{\mathcal{T}}" display="inline" intent=":literal"><semantics><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><annotation encoding="application/x-tex">f_{\mathcal{T}}</annotation></semantics></math> under accuracy <math id="A2.SS4.p4.m8" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math>,</span></p>
<table id="A2.E43" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E43X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E43X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert\bar{f}-f_{\mathcal{T}}\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert\bar{f}-f_{\mathcal{T}}\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E43X.m3" class="ltx_Math" alttext="\displaystyle\leq\left\lVert\bar{f}-f_{\delta}\right\rVert_{2}+\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\varepsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mi>δ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle\leq\left\lVert\bar{f}-f_{\delta}\right\rVert_{2}+\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="1" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(43)</span></td></tr></tbody>
</table>
<p id="A2.SS4.p4.5" class="ltx_p"><span id="A2.SS4.p4.5.1" class="ltx_text">Now we have proved the Proposition <a href="#S4.Thmtheorem12" title="Proposition 4.12 (Verification). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.12</span></a>.</span></p>
</div>
<div id="A2.SS4.p5" class="ltx_para">
<p id="A2.SS4.p5.2" class="ltx_p"><span id="A2.SS4.p5.2.1" class="ltx_text">Further with the reshape layer <math id="A2.SS4.p5.m1" class="ltx_Math" alttext="R" display="inline" intent=":literal"><semantics><mi>R</mi><annotation encoding="application/x-tex">R</annotation></semantics></math> and its inverse <math id="A2.SS4.p5.m2" class="ltx_Math" alttext="R^{-1}" display="inline" intent=":literal"><semantics><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><annotation encoding="application/x-tex">R^{-1}</annotation></semantics></math>, we can get the approximation error upper bound for any <math id="A2.SS4.p5.m3" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0}}^{\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0}}^{\alpha}</annotation></semantics></math> by a Transformer function <math id="A2.SS4.p5.m4" class="ltx_Math" alttext="g\in\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><mrow><mi>g</mi><mo>∈</mo><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup></mrow><annotation encoding="application/x-tex">g\in\mathcal{T}_{R}^{D}</annotation></semantics></math>,</span></p>
<table id="A2.E44" class="ltx_equationgroup ltx_eqn_table">
<tbody>
<tr id="A2.E44X" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_align_right ltx_eqn_cell"><math id="A2.E44X.m2" class="ltx_Math" alttext="\displaystyle\left\lVert f-g\right\rVert_{2}" display="inline" intent=":literal"><semantics><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>g</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub><annotation encoding="application/x-tex">\displaystyle\left\lVert f-g\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E44X.m3" class="ltx_Math" alttext="\displaystyle=\left\lVert R^{-1}\circ\bar{f}\circ R-R^{-1}\circ f_{\mathcal{T}}\circ R\right\rVert_{2}" display="inline" intent=":literal"><semantics><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mrow><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>R</mi></mrow><mo>−</mo><mrow><msup><mi>R</mi><mrow><mo>−</mo><mn>1</mn></mrow></msup><mo lspace="0.222em" rspace="0.222em">∘</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub><mo lspace="0.222em" rspace="0.222em">∘</mo><mi>R</mi></mrow></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><annotation encoding="application/x-tex">\displaystyle=\left\lVert R^{-1}\circ\bar{f}\circ R-R^{-1}\circ f_{\mathcal{T}}\circ R\right\rVert_{2}</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td>
<td rowspan="2" class="ltx_eqn_cell ltx_eqn_eqno ltx_align_middle ltx_align_right"><span class="ltx_tag ltx_tag_equationgroup ltx_align_right">(44)</span></td></tr>
<tr id="A2.E44Xa" class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_td ltx_eqn_cell"></td>
<td class="ltx_td ltx_align_left ltx_eqn_cell"><math id="A2.E44Xa.m2" class="ltx_Math" alttext="\displaystyle=\left\lVert\bar{f}-f_{\mathcal{T}}\right\rVert_{2}\leq\left\lVert\bar{f}-f_{\delta}\right\rVert_{2}+\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\varepsilon." display="inline" intent=":literal"><semantics><mrow><mrow><mphantom></mphantom><mo>=</mo><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>≤</mo><mrow><msub><mrow><mo>‖</mo><mrow><mover accent="true"><mi>f</mi><mo>¯</mo></mover><mo>−</mo><msub><mi>f</mi><mi>δ</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub><mo>+</mo><msub><mrow><mo>‖</mo><mrow><msub><mi>f</mi><mi>δ</mi></msub><mo>−</mo><msub><mi>f</mi><mi class="ltx_font_mathcaligraphic">𝒯</mi></msub></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mi>ε</mi></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\displaystyle=\left\lVert\bar{f}-f_{\mathcal{T}}\right\rVert_{2}\leq\left\lVert\bar{f}-f_{\delta}\right\rVert_{2}+\left\lVert f_{\delta}-f_{\mathcal{T}}\right\rVert_{2}&lt;\varepsilon.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p5.3" class="ltx_p"><span id="A2.SS4.p5.3.1" class="ltx_text">And (<a href="#A2.E44" title="Equation 44 ‣ Proof of Theorem . ‣ B.4 Verification for the Approximation Error Upper Bound ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">44</span></a>) means <math id="A2.SS4.p5.m5" class="ltx_Math" alttext="\mathcal{E}_{\mathrm{app}}\coloneq\underset{f\in\mathcal{H}_{d_{0}}^{\alpha}}{\sup}\underset{g\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-g\right\rVert_{2}&lt;\varepsilon" display="inline" intent=":literal"><semantics><mrow><msub><mi class="ltx_font_mathcaligraphic">ℰ</mi><mi>app</mi></msub><mo rspace="0.1389em">≔</mo><mrow><munder accentunder="true"><mo lspace="0.1389em">sup</mo><mrow><mi mathsize="0.700em">f</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">ℋ</mi><msub><mi mathsize="0.710em">d</mi><mn>0</mn></msub><mi mathsize="0.710em">α</mi></msubsup></mrow></munder><mo lspace="0.167em" rspace="0em">​</mo><munder accentunder="true"><mo>inf</mo><mrow><mi mathsize="0.700em">g</mi><mo mathsize="0.700em">∈</mo><msubsup><mi class="ltx_font_mathcaligraphic" mathsize="0.700em">𝒯</mi><mi mathsize="0.710em">R</mi><mi mathsize="0.710em">D</mi></msubsup></mrow></munder><mo lspace="0em" rspace="0em">​</mo><msub><mrow><mo>‖</mo><mrow><mi>f</mi><mo>−</mo><mi>g</mi></mrow><mo>‖</mo></mrow><mn>2</mn></msub></mrow><mo>&lt;</mo><mi>ε</mi></mrow><annotation encoding="application/x-tex">\mathcal{E}_{\mathrm{app}}\coloneq\underset{f\in\mathcal{H}_{d_{0}}^{\alpha}}{\sup}\underset{g\in\mathcal{T}_{R}^{D}}{\inf}\left\lVert f-g\right\rVert_{2}&lt;\varepsilon</annotation></semantics></math> with <math id="A2.SS4.p5.m6" class="ltx_Math" alttext="D\lesssim\varepsilon^{-\frac{d_{0}}{\alpha}}" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>≲</mo><msup><mi>ε</mi><mrow><mo>−</mo><mfrac><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></mfrac></mrow></msup></mrow><annotation encoding="application/x-tex">D\lesssim\varepsilon^{-\frac{d_{0}}{\alpha}}</annotation></semantics></math> for any <math id="A2.SS4.p5.m7" class="ltx_Math" alttext="\varepsilon\in(0,1)" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\varepsilon\in(0,1)</annotation></semantics></math>. Now we prove Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a>.
∎</span></p>
</div>
</div>
<div id="A2.SS4.p6" class="ltx_para ltx_noindent">
<p id="A2.SS4.p6.1" class="ltx_p"><span id="A2.SS4.p6.1.1" class="ltx_text ltx_font_bold">Corollary <a href="#S4.Thmtheorem3" title="Corollary 4.3 (Depth-width Trade-off). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a></span> (Depth-width Trade-off; Restatement)<span id="A2.SS4.p6.1.2" class="ltx_text ltx_font_bold">.</span> <span id="A2.SS4.p6.1.3" class="ltx_text ltx_font_italic">For any <math id="A2.SS4.p6.m1" class="ltx_Math" alttext="\varepsilon&gt;0" display="inline" intent=":literal"><semantics><mrow><mi>ε</mi><mo>&gt;</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">\varepsilon&gt;0</annotation></semantics></math> and <math id="A2.SS4.p6.m2" class="ltx_Math" alttext="d_{0}=dL" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">d_{0}=dL</annotation></semantics></math>, a Transformer architecture <math id="A2.SS4.p6.m3" class="ltx_Math" alttext="\mathcal{T}_{R}^{D}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mi>D</mi></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D}</annotation></semantics></math> with <math id="A2.SS4.p6.m4" class="ltx_math_unparsed" alttext="D=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})" display="inline" intent=":literal"><semantics><mrow><mi>D</mi><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})</annotation></semantics></math> blocks and fixed width <math id="A2.SS4.p6.m5" class="ltx_Math" alttext="W=4d" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">W=4d</annotation></semantics></math>, which is capable of approximating any function <math id="A2.SS4.p6.m6" class="ltx_Math" alttext="f\in\mathcal{H}_{d_{0}}^{\alpha}([0,1]^{d_{0}},K)" display="inline" intent=":literal"><semantics><mrow><mi>f</mi><mo>∈</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><msup><mrow><mo stretchy="false">[</mo><mrow><mn>0</mn><mo>,</mo><mn>1</mn></mrow><mo stretchy="false">]</mo></mrow><msub><mi>d</mi><mn>0</mn></msub></msup><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">f\in\mathcal{H}_{d_{0}}^{\alpha}([0,1]^{d_{0}},K)</annotation></semantics></math> with smooth index <math id="A2.SS4.p6.m7" class="ltx_Math" alttext="\alpha\in(0,1]" display="inline" intent=":literal"><semantics><mrow><mi>α</mi><mo>∈</mo><mrow><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">\alpha\in(0,1]</annotation></semantics></math> under error <math id="A2.SS4.p6.m8" class="ltx_Math" alttext="\varepsilon" display="inline" intent=":literal"><semantics><mi>ε</mi><annotation encoding="application/x-tex">\varepsilon</annotation></semantics></math>, can be realized by a Transformer <math id="A2.SS4.p6.m9" class="ltx_Math" alttext="\mathcal{T}_{R}^{D^{\prime},W^{\prime}}" display="inline" intent=":literal"><semantics><msubsup><mi class="ltx_font_mathcaligraphic">𝒯</mi><mi>R</mi><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>,</mo><msup><mi>W</mi><mo>′</mo></msup></mrow></msubsup><annotation encoding="application/x-tex">\mathcal{T}_{R}^{D^{\prime},W^{\prime}}</annotation></semantics></math> comprising variable blocks <math id="A2.SS4.p6.m10" class="ltx_Math" alttext="D^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>D</mi><mo>′</mo></msup><annotation encoding="application/x-tex">D^{\prime}</annotation></semantics></math>, width <math id="A2.SS4.p6.m11" class="ltx_Math" alttext="W^{\prime}" display="inline" intent=":literal"><semantics><msup><mi>W</mi><mo>′</mo></msup><annotation encoding="application/x-tex">W^{\prime}</annotation></semantics></math>, and two additional linear embedding layers, satisfying the condition <math id="A2.SS4.p6.m12" class="ltx_math_unparsed" alttext="D^{\prime}\cdot W^{\prime}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})," display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>W</mi><mo>′</mo></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">)</mo></mrow><mo>,</mo></mrow><annotation encoding="application/x-tex">D^{\prime}\cdot W^{\prime}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha}),</annotation></semantics></math> where <math id="A2.SS4.p6.m13" class="ltx_Math" alttext="D^{\prime}\geq 6" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">D^{\prime}\geq 6</annotation></semantics></math> and <math id="A2.SS4.p6.m14" class="ltx_Math" alttext="W^{\prime}\geq 4d" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>≥</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">W^{\prime}\geq 4d</annotation></semantics></math>. </span></p>
</div>
<div id="A2.SS4.3" class="ltx_proof">
<h6 class="ltx_title ltx_runin ltx_font_italic ltx_title_proof"><span id="A2.SS4.3.1" class="ltx_text ltx_font_bold">Proof of Corollary <a href="#S4.Thmtheorem3" title="Corollary 4.3 (Depth-width Trade-off). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.3</span></a></span>.</h6>
<div id="A2.SS4.p7" class="ltx_para">
<p id="A2.SS4.p7.1" class="ltx_p"><span id="A2.SS4.p7.1.1" class="ltx_text">Our construction in Theorem <a href="#S4.Thmtheorem1" title="Theorem 4.1 (Upper Bound of Approximation Error). ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.1</span></a> utilizes three key components: the quantization module, contextual mapping, and value mapping. From the proofs of Lemma <a href="#S4.Thmtheorem7" title="Lemma 4.7 (Quantization Module 𝑓_{𝒯⁢1}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.7</span></a> (quantization module) and Lemma <a href="#S4.Thmtheorem11" title="Lemma 4.11 (Value Mapping 𝑓_{𝒯⁢3}). ‣ 4.2 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4.11</span></a> (value mapping), the sequential construction requires <math id="A2.SS4.p7.m1" class="ltx_Math" alttext="\mathcal{O}(d_{0}M)" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(d_{0}M)</annotation></semantics></math> and <math id="A2.SS4.p7.m2" class="ltx_Math" alttext="\mathcal{O}(LM^{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{O}(LM^{d_{0}})</annotation></semantics></math> total neurons, respectively. Crucially, subunits composed of these neurons operate on disjoint indices and do not interfere with one another (See items below (<a href="#A2.E24" title="Equation 24 ‣ Proof of Lemma . ‣ B.3.1 Quantization Module 𝑓_{𝒯⁢1} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">24</span></a>) &amp; (<a href="#A2.E39" title="Equation 39 ‣ Proof of Lemma . ‣ B.3.3 Value Mapping 𝑓_{𝒯⁢3} ‣ B.3 Approximation for Piece-wise Constant Function Class by Standard Transformers ‣ Appendix B Approximation Error Upper Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">39</span></a>)).</span></p>
</div>
<div id="A2.SS4.p8" class="ltx_para">
<p id="A2.SS4.p8.1" class="ltx_p"><span id="A2.SS4.p8.1.1" class="ltx_text">Leveraging the additive nature of neurons in the quantization module and value mapping, we can transform sequential depth into parallel width. Specifically, the weight matrices of the original modules are embedded into a block-diagonal structure within wider layers. For instance, to compress <math id="A2.SS4.p8.m1" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> sequential FNN layers, parameterized by weight matrices <math id="A2.SS4.p8.m2" class="ltx_Math" alttext="W_{1}^{(i)},W_{2}^{(i)}" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>W</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>W</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow><annotation encoding="application/x-tex">W_{1}^{(i)},W_{2}^{(i)}</annotation></semantics></math> and bias terms <math id="A2.SS4.p8.m3" class="ltx_Math" alttext="b_{1}^{(i)},b_{2}^{(i)},i\in[n]" display="inline" intent=":literal"><semantics><mrow><msubsup><mi>b</mi><mn>1</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><msubsup><mi>b</mi><mn>2</mn><mrow><mo stretchy="false">(</mo><mi>i</mi><mo stretchy="false">)</mo></mrow></msubsup><mo>,</mo><mrow><mi>i</mi><mo>∈</mo><mrow><mo stretchy="false">[</mo><mi>n</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">b_{1}^{(i)},b_{2}^{(i)},i\in[n]</annotation></semantics></math>, into a single wider layer, we can construct as following,</span></p>
<table id="A2.Ex52" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex52.m1" class="ltx_Math" alttext="\tilde{W}_{j}=\begin{bmatrix}W_{j}^{(1)}&amp;0&amp;\cdots&amp;0\\
0&amp;W_{j}^{(2)}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;W_{j}^{(n)}\end{bmatrix}~\text{and}~\tilde{b}_{j}=\begin{bmatrix}b_{j}^{(1)}\\
b_{j}^{(2)}\\
\vdots\\
b_{j}^{(n)}\end{bmatrix}\text{for}~j\in\{1,2\}." display="block" intent=":literal"><semantics><mrow><mrow><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mi>j</mi></msub><mo>=</mo><mrow><mrow><mo>[</mo><mtable columnspacing="5pt" displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi>W</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><msubsup><mi>W</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd><mtd><mo>⋯</mo></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd></mtd><mtd></mtd><mtd><mi mathvariant="normal">⋱</mi></mtd><mtd></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mo>⋯</mo></mtd><mtd><msubsup><mi>W</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>and</mtext><mo lspace="0.330em" rspace="0em">​</mo><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mi>j</mi></msub></mrow><mo>=</mo><mrow><mrow><mo>[</mo><mtable displaystyle="true" rowspacing="0pt"><mtr><mtd><msubsup><mi>b</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd><msubsup><mi>b</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr><mtr><mtd></mtd></mtr><mtr><mtd><msubsup><mi>b</mi><mi>j</mi><mrow><mo stretchy="false">(</mo><mi>n</mi><mo stretchy="false">)</mo></mrow></msubsup></mtd></mtr></mtable><mo>]</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mtext>for</mtext><mo lspace="0.330em" rspace="0em">​</mo><mi>j</mi></mrow><mo>∈</mo><mrow><mo stretchy="false">{</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo stretchy="false">}</mo></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{W}_{j}=\begin{bmatrix}W_{j}^{(1)}&amp;0&amp;\cdots&amp;0\\
0&amp;W_{j}^{(2)}&amp;\cdots&amp;0\\
\vdots&amp;\vdots&amp;\ddots&amp;\vdots\\
0&amp;0&amp;\cdots&amp;W_{j}^{(n)}\end{bmatrix}~\text{and}~\tilde{b}_{j}=\begin{bmatrix}b_{j}^{(1)}\\
b_{j}^{(2)}\\
\vdots\\
b_{j}^{(n)}\end{bmatrix}\text{for}~j\in\{1,2\}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
</div>
<div id="A2.SS4.p9" class="ltx_para">
<p id="A2.SS4.p9.1" class="ltx_p"><span id="A2.SS4.p9.1.1" class="ltx_text">To satisfy the Transformer’s requirement for equal input and output dimensions, we employ an input replication scheme: expanding the input <math id="A2.SS4.p9.m1" class="ltx_Math" alttext="X\in\mathbb{R}^{d\times L}" display="inline" intent=":literal"><semantics><mrow><mi>X</mi><mo>∈</mo><msup><mi>ℝ</mi><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">X\in\mathbb{R}^{d\times L}</annotation></semantics></math> to <math id="A2.SS4.p9.m2" class="ltx_Math" alttext="\tilde{X}=[X;X;\dots;X]\in\mathbb{R}^{nd\times L}" display="inline" intent=":literal"><semantics><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>=</mo><mrow><mo stretchy="false">[</mo><mrow><mi>X</mi><mo>;</mo><mi>X</mi><mo>;</mo><mi mathvariant="normal">…</mi><mo>;</mo><mi>X</mi></mrow><mo stretchy="false">]</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mi>n</mi><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow><mo lspace="0.222em" rspace="0.222em">×</mo><mi>L</mi></mrow></msup></mrow><annotation encoding="application/x-tex">\tilde{X}=[X;X;\dots;X]\in\mathbb{R}^{nd\times L}</annotation></semantics></math>. This allows the wide layer to process <math id="A2.SS4.p9.m3" class="ltx_Math" alttext="n" display="inline" intent=":literal"><semantics><mi>n</mi><annotation encoding="application/x-tex">n</annotation></semantics></math> independent functional channels simultaneously, i.e.,</span></p>
<table id="A2.Ex53" class="ltx_equation ltx_eqn_table">

<tbody><tr class="ltx_equation ltx_eqn_row ltx_align_baseline">
<td class="ltx_eqn_cell ltx_eqn_center_padleft"></td>
<td class="ltx_eqn_cell ltx_align_center"><math id="A2.Ex53.m1" class="ltx_Math" alttext="\tilde{\mathrm{FF}}(\tilde{X})=\tilde{X}+\tilde{W}_{2}\sigma_{R}\left[\tilde{W}_{1}\tilde{X}+\tilde{b}_{1}\mathds{1}_{L}^{\top}\right]+\tilde{b}_{2}\mathds{1}_{L}^{\top}." display="block" intent=":literal"><semantics><mrow><mrow><mrow><mover accent="true"><mi>FF</mi><mo>~</mo></mover><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo stretchy="false">)</mo></mrow></mrow><mo>=</mo><mrow><mover accent="true"><mi>X</mi><mo>~</mo></mover><mo>+</mo><mrow><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msub><mi>σ</mi><mi>R</mi></msub><mo lspace="0em" rspace="0em">​</mo><mrow><mo>[</mo><mrow><mrow><msub><mover accent="true"><mi>W</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><mover accent="true"><mi>X</mi><mo>~</mo></mover></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mn>1</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup></mrow></mrow><mo>]</mo></mrow></mrow><mo>+</mo><mrow><msub><mover accent="true"><mi>b</mi><mo>~</mo></mover><mn>2</mn></msub><mo lspace="0em" rspace="0em">​</mo><msubsup><mn>𝟙</mn><mi>L</mi><mo>⊤</mo></msubsup></mrow></mrow></mrow><mo lspace="0em">.</mo></mrow><annotation encoding="application/x-tex">\tilde{\mathrm{FF}}(\tilde{X})=\tilde{X}+\tilde{W}_{2}\sigma_{R}\left[\tilde{W}_{1}\tilde{X}+\tilde{b}_{1}\mathds{1}_{L}^{\top}\right]+\tilde{b}_{2}\mathds{1}_{L}^{\top}.</annotation></semantics></math></td>
<td class="ltx_eqn_cell ltx_eqn_center_padright"></td></tr></tbody>
</table>
<p id="A2.SS4.p9.2" class="ltx_p"><span id="A2.SS4.p9.2.1" class="ltx_text">By redistributing the total neuron budget, we obtain a parallel quantization module and value mapping satisfying <math id="A2.SS4.p9.m4" class="ltx_Math" alttext="D^{\prime}_{1}\cdot W_{1}^{\prime}=\mathcal{O}(d_{0}M)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>D</mi><mn>1</mn><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>W</mi><mn>1</mn><mo>′</mo></msubsup></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo lspace="0em" rspace="0em">​</mo><mi>M</mi></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D^{\prime}_{1}\cdot W_{1}^{\prime}=\mathcal{O}(d_{0}M)</annotation></semantics></math> and <math id="A2.SS4.p9.m5" class="ltx_Math" alttext="D_{2}^{\prime}\cdot W_{2}^{\prime}=\mathcal{O}(LM^{d_{0}})" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>D</mi><mn>2</mn><mo>′</mo></msubsup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msubsup><mi>W</mi><mn>2</mn><mo>′</mo></msubsup></mrow><mo>=</mo><mrow><mi class="ltx_font_mathcaligraphic">𝒪</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mrow><mi>L</mi><mo lspace="0em" rspace="0em">​</mo><msup><mi>M</mi><msub><mi>d</mi><mn>0</mn></msub></msup></mrow><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">D_{2}^{\prime}\cdot W_{2}^{\prime}=\mathcal{O}(LM^{d_{0}})</annotation></semantics></math>, respectively. To aggregate the independent channels after the parallel quantization, we introduce an additional linear embedding layer of <math id="A2.SS4.p9.m6" class="ltx_Math" alttext="(I_{d},I_{d},\ldots,I_{d})\in\mathbb{R}^{d\times nd}" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>I</mi><mi>d</mi></msub><mo>,</mo><msub><mi>I</mi><mi>d</mi></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>I</mi><mi>d</mi></msub><mo stretchy="false">)</mo></mrow><mo>∈</mo><msup><mi>ℝ</mi><mrow><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>n</mi></mrow><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></msup></mrow><annotation encoding="application/x-tex">(I_{d},I_{d},\ldots,I_{d})\in\mathbb{R}^{d\times nd}</annotation></semantics></math> (<math id="A2.SS4.p9.m7" class="ltx_Math" alttext="I_{d}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mi>d</mi></msub><annotation encoding="application/x-tex">I_{d}</annotation></semantics></math> denotes the <math id="A2.SS4.p9.m8" class="ltx_Math" alttext="d\times d" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo lspace="0.222em" rspace="0.222em">×</mo><mi>d</mi></mrow><annotation encoding="application/x-tex">d\times d</annotation></semantics></math> identity matrix), followed by the subtraction of the residual term <math id="A2.SS4.p9.m9" class="ltx_Math" alttext="(n-1)X" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mo stretchy="false">)</mo></mrow><mo lspace="0em" rspace="0em">​</mo><mi>X</mi></mrow><annotation encoding="application/x-tex">(n-1)X</annotation></semantics></math>. The intermediate result is then processed by the contextual mapping. Similarly, for the parallel value mapping, we expand the input and aggregate the outputs. Through these structural alignments, the constructed parallel Transformer exactly recovers the output of the initial sequential model.</span></p>
</div>
<div id="A2.SS4.p10" class="ltx_para">
<p id="A2.SS4.p10.1" class="ltx_p"><span id="A2.SS4.p10.1.1" class="ltx_text">Accounting the two additional embedding layers and setting <math id="A2.SS4.p10.m1" class="ltx_math_unparsed" alttext="M\lesssim\varepsilon^{-1/\alpha}" display="inline" intent=":literal"><semantics><mrow><mi>M</mi><mo>≲</mo><mi>ε</mi><msup><mrow></mrow><mrow><mo>−</mo><mn>1</mn><mo>/</mo><mi>α</mi></mrow></msup></mrow><annotation encoding="application/x-tex">M\lesssim\varepsilon^{-1/\alpha}</annotation></semantics></math> yields the final trade-off relation <math id="A2.SS4.p10.m2" class="ltx_math_unparsed" alttext="D^{\prime}\cdot W^{\prime}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo lspace="0.222em" rspace="0.222em">⋅</mo><msup><mi>W</mi><mo>′</mo></msup><mo>=</mo><mi class="ltx_font_mathcaligraphic">𝒪</mi><mrow><mo stretchy="false">(</mo><msup><mi>ε</mi><mrow><mo>−</mo><mi>d</mi><msub><mrow></mrow><mn>0</mn></msub><mo>/</mo><mi>α</mi></mrow></msup><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">D^{\prime}\cdot W^{\prime}=\mathcal{O}(\varepsilon^{-d_{0}/\alpha})</annotation></semantics></math>, where the effective depth is <math id="A2.SS4.p10.m3" class="ltx_Math" alttext="D^{\prime}=D_{1}^{\prime}+D_{2}^{\prime}+3" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>=</mo><mrow><msubsup><mi>D</mi><mn>1</mn><mo>′</mo></msubsup><mo>+</mo><msubsup><mi>D</mi><mn>2</mn><mo>′</mo></msubsup><mo>+</mo><mn>3</mn></mrow></mrow><annotation encoding="application/x-tex">D^{\prime}=D_{1}^{\prime}+D_{2}^{\prime}+3</annotation></semantics></math> and width <math id="A2.SS4.p10.m4" class="ltx_Math" alttext="W^{\prime}=\max(W_{1}^{\prime},W_{2}^{\prime},d)" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>=</mo><mrow><mi>max</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msubsup><mi>W</mi><mn>1</mn><mo>′</mo></msubsup><mo>,</mo><msubsup><mi>W</mi><mn>2</mn><mo>′</mo></msubsup><mo>,</mo><mi>d</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">W^{\prime}=\max(W_{1}^{\prime},W_{2}^{\prime},d)</annotation></semantics></math>. Since <math id="A2.SS4.p10.m5" class="ltx_Math" alttext="D_{1}^{\prime}\geq 1,D_{2}^{\prime}\geq 2" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi>D</mi><mn>1</mn><mo>′</mo></msubsup><mo>≥</mo><mn>1</mn></mrow><mo>,</mo><mrow><msubsup><mi>D</mi><mn>2</mn><mo>′</mo></msubsup><mo>≥</mo><mn>2</mn></mrow></mrow><annotation encoding="application/x-tex">D_{1}^{\prime}\geq 1,D_{2}^{\prime}\geq 2</annotation></semantics></math> and <math id="A2.SS4.p10.m6" class="ltx_Math" alttext="W=4d" display="inline" intent=":literal"><semantics><mrow><mi>W</mi><mo>=</mo><mrow><mn>4</mn><mo lspace="0em" rspace="0em">​</mo><mi>d</mi></mrow></mrow><annotation encoding="application/x-tex">W=4d</annotation></semantics></math>, the constraints <math id="A2.SS4.p10.m7" class="ltx_Math" alttext="D^{\prime}\geq 6" display="inline" intent=":literal"><semantics><mrow><msup><mi>D</mi><mo>′</mo></msup><mo>≥</mo><mn>6</mn></mrow><annotation encoding="application/x-tex">D^{\prime}\geq 6</annotation></semantics></math> and <math id="A2.SS4.p10.m8" class="ltx_Math" alttext="W^{\prime}\geq W" display="inline" intent=":literal"><semantics><mrow><msup><mi>W</mi><mo>′</mo></msup><mo>≥</mo><mi>W</mi></mrow><annotation encoding="application/x-tex">W^{\prime}\geq W</annotation></semantics></math> ensure the minimal architectural budget.
∎</span></p>
</div>
</div>
</section>
<section id="A2.SS5" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">B.5 </span>Further Discussions: Assumptions, Implications, and Practical Architectures</h3>

<div id="A2.SS5.p1" class="ltx_para">
<p id="A2.SS5.p1.1" class="ltx_p">To rigorously establish the approximation bounds, we introduce structural simplifications that isolate the network’s fundamental mechanisms. Below, we bridge the gap between theory and practice by clarifying the connections between these mathematical assumptions and the empirical design of modern Transformers:</p>
<ul id="A2.I5" class="ltx_itemize">
<li id="A2.I5.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I5.i1.p1" class="ltx_para">
<p id="A2.I5.i1.p1.1" class="ltx_p"><span id="A2.I5.i1.p1.1.1" class="ltx_text ltx_font_bold">Activation Functions.</span> We adopt ReLU activation to establish a rigorous theoretical baseline, supported by the fact that any continuous piecewise linear activation function can be exactly realized by ReLU combinations <cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib37" title="" class="ltx_ref">Yarotsky, 2017</a>)</cite>. Besides, real-world models frequently employ smoother variants, such as GELU or SwiGLU, to facilitate better gradient flow and enhance local expressivity. Our ReLU-based analysis defines the fundamental limits of approximation power, theoretically justifying the use of these advanced and smoother activations.</p>
</div></li>
<li id="A2.I5.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I5.i2.p1" class="ltx_para">
<p id="A2.I5.i2.p1.1" class="ltx_p"><span id="A2.I5.i2.p1.1.1" class="ltx_text ltx_font_bold">Normalization.</span> Normalization techniques, such as LayerNorm, are omitted to cleanly isolate and analyze the core approximation power of the self-attention and feed-forward part. While practically essential for stabilizing deep network optimization, normalization does not expand the theoretical approximation capacity. Mathematically, its magnitude adjustments can be effectively absorbed by appropriately scaling the adjacent weight parameters.</p>
</div></li>
<li id="A2.I5.i3" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A2.I5.i3.p1" class="ltx_para">
<p id="A2.I5.i3.p1.1" class="ltx_p"><span id="A2.I5.i3.p1.1.1" class="ltx_text ltx_font_bold">Attention Depth.</span> Our analysis focuses on a single attention layer, demonstrating it as the minimal structural requirement to achieve contextual mapping. Since stacking attention layers strictly preserves or improves the overall approximation power, our single-layer framework provides a baseline guarantee for the expressive capacity of more complex architectures. Deriving bounds for deep Transformers introduces significant theoretical complexity due to their highly compositional nature, making multiple attention layer extensions a natural direction for future work.</p>
</div></li>
</ul>
</div>
</section>
</section>
<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Approximation Error Lower Bound</h2>

<section id="A3.SS0.SSS0.Px1" class="ltx_paragraph">
<h5 class="ltx_title ltx_title_paragraph">Roadmap.</h5>

<div id="A3.SS0.SSS0.Px1.p1" class="ltx_para">
<p id="A3.SS0.SSS0.Px1.p1.1" class="ltx_p">This section establishes the error lower bound by analyzing the VC-dimension upper bound of Transformers.</p>
<ul id="A3.I1" class="ltx_itemize">
<li id="A3.I1.i1" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i1.p1" class="ltx_para">
<p id="A3.I1.i1.p1.1" class="ltx_p"><span id="A3.I1.i1.p1.1.1" class="ltx_text ltx_font_bold">Bounding the VC-dimension</span> (Section <a href="#A3.SS1" title="C.1 Total Numbers of Operations and Parameters ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.1</span></a>): quantifies the total number of operations and parameters of proposed Transformers to derive the VC-dimension upper bound.</p>
</div></li>
<li id="A3.I1.i2" class="ltx_item" style="list-style-type:none;"><span class="ltx_tag ltx_tag_item">•</span> 
<div id="A3.I1.i2.p1" class="ltx_para">
<p id="A3.I1.i2.p1.1" class="ltx_p"><span id="A3.I1.i2.p1.1.1" class="ltx_text ltx_font_bold">Main Result</span> (Section <a href="#A3.SS2" title="C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>): Derives the final approximation error lower bound based on above results.</p>
</div></li>
</ul>
</div>
</section>
<section id="A3.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">C.1 </span>Total Numbers of Operations and Parameters</h3>

<div id="A3.SS1.p1" class="ltx_para">
<p id="A3.SS1.p1.1" class="ltx_p">A detail-oriented structure of Transformer is used for obtaining the approximation upper bound in this paper. Therefore, we can calculate the number of operations and parameters part by part. Derived results will be utilized in the subsequent applications of general regression tasks in the proof of Theorem <a href="#S5.Thmtheorem3" title="Theorem 5.3 (Lower Bound of Approximation Error). ‣ 5 Approximation Lower Bound with VC-dimension ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">5.3</span></a> (Section <a href="#A3.SS2" title="C.2 Lower Bound of the Approximation Error ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">C.2</span></a>) and Lemma <a href="#A4.Thmtheorem5" title="Lemma D.5. ‣ D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.5</span></a> (Section <a href="#A4.SS2" title="D.2 Upper Bound of the Statistical Error ‣ Appendix D Details of Applications in the Regression Task ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">D.2</span></a>). Set <math id="A3.SS1.p1.m1" class="ltx_Math" alttext="\delta&gt;0,\delta^{*}&gt;0,M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor" display="inline" intent=":literal"><semantics><mrow><mrow><mi>δ</mi><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><msup><mi>δ</mi><mo>∗</mo></msup><mo>&gt;</mo><mn>0</mn></mrow><mo>,</mo><mrow><mi>M</mi><mo>=</mo><mrow><mo stretchy="false">⌊</mo><mfrac><mn>1</mn><mrow><mi>δ</mi><mo>+</mo><msup><mi>δ</mi><mo>∗</mo></msup></mrow></mfrac><mo stretchy="false">⌋</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\delta&gt;0,\delta^{*}&gt;0,M=\lfloor\frac{1}{\delta+\delta^{*}}\rfloor</annotation></semantics></math>, and <math id="A3.SS1.p1.m2" class="ltx_Math" alttext="d,L,d_{0}=dL\in\mathbb{N}_{+}" display="inline" intent=":literal"><semantics><mrow><mi>d</mi><mo>,</mo><mi>L</mi><mo>,</mo><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow><mo>∈</mo><msub><mi>ℕ</mi><mo>+</mo></msub></mrow></mrow><annotation encoding="application/x-tex">d,L,d_{0}=dL\in\mathbb{N}_{+}</annotation></semantics></math>. See the final results in Table <a href="#A3.T4" title="Table 4 ‣ C.1 Total Numbers of Operations and Parameters ‣ Appendix C Approximation Error Lower Bound ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">4</span></a>.</p>
</div>
