<td id="A2.T3.5.8.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><math id="A2.T3.m6" class="ltx_Math" alttext="\surd" display="inline" intent=":literal"><semantics><mo mathsize="0.900em">√</mo><annotation encoding="application/x-tex">\surd</annotation></semantics></math></td>
<td id="A2.T3.5.8.4" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.8.4.1" class="ltx_text" style="font-size:90%;">Single layer</span></td></tr>
