<td id="A1.T2.5.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding-top:1.4pt;padding-bottom:1.4pt;"><span id="A1.T2.5.2.2.1" class="ltx_text" style="font-size:90%;">The Hölder class with smoothness <math id="A1.T2.m2" class="ltx_Math" alttext="\alpha" display="inline" intent=":literal"><semantics><mi>α</mi><annotation encoding="application/x-tex">\alpha</annotation></semantics></math> in Definition <a href="#S3.Thmtheorem1" title="Definition 3.1 (Hölder Class). ‣ Target Function Space. ‣ 3 Preliminaries ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">3.1</span></a> and <math id="A1.T2.m3" class="ltx_Math" alttext="\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)\coloneq\mathcal{H}_{d_{0},d_{0}}^{\alpha}(\mathcal{X},K)" display="inline" intent=":literal"><semantics><mrow><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><mo>≔</mo><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>,</mo><msub><mi>d</mi><mn>0</mn></msub></mrow><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)\coloneq\mathcal{H}_{d_{0},d_{0}}^{\alpha}(\mathcal{X},K)</annotation></semantics></math>.</span></td></tr>
<tr id="A1.T2.5.3" class="ltx_tr">
<th id="A1.T2.5.3.1" class="ltx_td ltx_align_center ltx_th ltx_th_row" style="padding-top:1.4pt;padding-bottom:1.4pt;"><math id="A1.T2.m4" class="ltx_Math" alttext="\bar{\mathcal{H}}_{d,L}^{\alpha}" display="inline" intent=":literal"><semantics><msubsup><mover accent="true"><mi class="ltx_font_mathcaligraphic" mathsize="0.900em">ℋ</mi><mo>¯</mo></mover><mrow><mi mathsize="0.900em">d</mi><mo mathsize="0.900em">,</mo><mi mathsize="0.900em">L</mi></mrow><mi mathsize="0.900em">α</mi></msubsup><annotation encoding="application/x-tex">\bar{\mathcal{H}}_{d,L}^{\alpha}</annotation></semantics></math></th>
<td id="A1.T2.5.3.2" class="ltx_td ltx_align_left" style="padding-top:1.4pt;padding-bottom:1.4pt;"><span id="A1.T2.5.3.2.1" class="ltx_text" style="font-size:90%;">Reshaped sequence form of <math id="A1.T2.m5" class="ltx_Math" alttext="\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)" display="inline" intent=":literal"><semantics><mrow><msubsup><mi class="ltx_font_mathcaligraphic">ℋ</mi><msub><mi>d</mi><mn>0</mn></msub><mi>α</mi></msubsup><mo lspace="0em" rspace="0em">​</mo><mrow><mo stretchy="false">(</mo><mi class="ltx_font_mathcaligraphic">𝒳</mi><mo>,</mo><mi>K</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">\mathcal{H}_{d_{0}}^{\alpha}(\mathcal{X},K)</annotation></semantics></math> defined in (<a href="#S4.E6" title="Equation 6 ‣ 4.1 Approximation for Hölder Class by Piece-wise Constant Function Class ‣ 4 Approximation Error Upper Bound for Hölder Class with Transformers ‣ Approximation Error Upper and Lower Bounds for Hölder Class with Transformers" class="ltx_ref"><span class="ltx_text ltx_ref_tag">6</span></a>) with <math id="A1.T2.m6" class="ltx_Math" alttext="d_{0}=dL" display="inline" intent=":literal"><semantics><mrow><msub><mi>d</mi><mn>0</mn></msub><mo>=</mo><mrow><mi>d</mi><mo lspace="0em" rspace="0em">​</mo><mi>L</mi></mrow></mrow><annotation encoding="application/x-tex">d_{0}=dL</annotation></semantics></math>.</span></td></tr>
