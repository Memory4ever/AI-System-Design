<td id="A2.T3.5.10.1" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.10.1.1" class="ltx_text" style="font-size:90%;">piece-wise linear</span></td>
<td id="A2.T3.5.10.2" class="ltx_td ltx_align_center" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.10.2.1" class="ltx_text" style="font-size:90%;">between operators</span></td></tr>
<tr id="A2.T3.5.11" class="ltx_tr">
<td id="A2.T3.5.11.1" class="ltx_td ltx_align_center ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><span id="A2.T3.5.11.1.1" class="ltx_text" style="font-size:90%;">​​<cite class="ltx_cite ltx_citemacro_citep">(<a href="#bib.bib19" title="" class="ltx_ref">Kajitsuka &amp; Sato, 2024</a>; <a href="#bib.bib13" title="" class="ltx_ref">Hu et al., 2025a</a>; <a href="#bib.bib14" title="" class="ltx_ref">Hu et al., 2025b</a>; <a href="#bib.bib17" title="" class="ltx_ref">Jiao et al., 2025</a>)</cite></span></td>
