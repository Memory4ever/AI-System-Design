{"data":{"id":"10.48550/arxiv.2605.07725","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07725","prefix":"10.48550","suffix":"arxiv.2605.07725","identifiers":[{"identifier":"2605.07725","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.07725"}],"creators":[{"name":"Zhong, Qiyong","nameType":"Personal","givenName":"Qiyong","familyName":"Zhong","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Mao","nameType":"Personal","givenName":"Mao","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Mingyang","nameType":"Personal","givenName":"Mingyang","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Lin, Xin","nameType":"Personal","givenName":"Xin","familyName":"Lin","affiliation":[],"nameIdentifiers":[]},{"name":"Sun, Jie","nameType":"Personal","givenName":"Jie","familyName":"Sun","affiliation":[],"nameIdentifiers":[]},{"name":"Jiang, Houcheng","nameType":"Personal","givenName":"Houcheng","familyName":"Jiang","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Xiang","nameType":"Personal","givenName":"Xiang","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Fang, Junfeng","nameType":"Personal","givenName":"Junfeng","familyName":"Fang","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SOD: Step-wise On-policy Distillation for Small Language Model Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T13:30:42Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:00:43Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-03T03:33:59Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T01:26:55Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-18T09:21:07Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-19T00:41:42Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Tool-integrated reasoning (TIR) is difficult to scale to small language models due to instability in long-horizon tool interactions and limited model capacity. While reinforcement learning methods like group relative policy optimization provide only sparse outcome-level rewards. Recently, on-policy distillation (OPD) has gained popularity by supplying dense token-level supervision from a teacher on student-generated trajectories. However, our experiments indicate that applying OPD to TIR leads to a critical failure mode: erroneous tool calls tend to cascade across subsequent reasoning steps, progressively amplifying student-teacher divergence and rendering the teacher's token-level supervision increasingly unreliable. To address this, we propose SOD, a step-wise on-policy distillation framework for small language model agents, which adaptively reweights distillation strength at each step based on step-level divergence. Therefore, SOD can attenuate potentially misleading teacher signals in high-divergence regions while preserving dense guidance in well-aligned states. Experiments on challenging math, science, and code benchmarks show that SOD achieves up to 20.86% improvement over the second-best baseline. Notably, our 0.6B student achieves 26.13% on AIME 2025, demonstrating effective transfer of agentic reasoning to lightweight models. Our code is available at https://github.com/YoungZ365/SOD.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07725","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:26:58.000Z","registered":"2026-05-11T02:26:59.000Z","published":"2026","updated":"2026-08-19T02:27:53.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07725","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}