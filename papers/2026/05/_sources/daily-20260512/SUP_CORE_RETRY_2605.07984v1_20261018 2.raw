<tr id="A4.T3.3.12" class="ltx_tr">
<th id="A4.T3.3.12.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t" rowspan="4"><span id="A4.T3.3.12.1.1" class="ltx_text" style="font-size:90%;">Llama-3</span></th>
<th id="A4.T3.3.12.2" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><span id="A4.T3.3.12.2.1" class="ltx_text" style="font-size:90%;">1B</span></th>
<td id="A4.T3.3.12.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T3.3.12.3.1" class="ltx_text" style="font-size:90%;">59 [49, 68]</span></td>
<td id="A4.T3.3.12.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A4.T3.3.12.4.1" class="ltx_text" style="font-size:90%;">2 [1, 7]</span></td></tr>
<tr id="A4.T3.3.13" class="ltx_tr">
<th id="A4.T3.3.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T3.3.13.1.1" class="ltx_text" style="font-size:90%;">3B</span></th>
<td id="A4.T3.3.13.2" class="ltx_td ltx_align_center"><span id="A4.T3.3.13.2.1" class="ltx_text" style="font-size:90%;">87 [79, 92]</span></td>
<td id="A4.T3.3.13.3" class="ltx_td ltx_align_center"><span id="A4.T3.3.13.3.1" class="ltx_text" style="font-size:90%;">0 [0, 4]</span></td></tr>
<tr id="A4.T3.3.14" class="ltx_tr">
<th id="A4.T3.3.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><span id="A4.T3.3.14.1.1" class="ltx_text" style="font-size:90%;">8B</span></th>
<td id="A4.T3.3.14.2" class="ltx_td ltx_align_center"><span id="A4.T3.3.14.2.1" class="ltx_text" style="font-size:90%;">79 [70, 86]</span></td>
<td id="A4.T3.3.14.3" class="ltx_td ltx_align_center"><span id="A4.T3.3.14.3.1" class="ltx_text" style="font-size:90%;">0 [0, 4]</span></td></tr>
