<th id="A4.T3.3.15.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb"><span id="A4.T3.3.15.1.1" class="ltx_text" style="font-size:90%;">70B</span></th>
<td id="A4.T3.3.15.2" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T3.3.15.2.1" class="ltx_text" style="font-size:90%;">75 [66, 82]</span></td>
<td id="A4.T3.3.15.3" class="ltx_td ltx_align_center ltx_border_bb"><span id="A4.T3.3.15.3.1" class="ltx_text" style="font-size:90%;">2 [1, 7]</span></td></tr>
