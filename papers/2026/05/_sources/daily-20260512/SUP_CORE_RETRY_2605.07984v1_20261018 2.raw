<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>Model Configurations</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">For reference, we report details of the architectural differences between models.</p>
</div>
<figure id="A1.T1" class="ltx_table">
<table id="A1.T1.3" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<tbody class="ltx_tbody">
<tr id="A1.T1.3.1" class="ltx_tr">
<th id="A1.T1.3.1.1" class="ltx_td ltx_th ltx_th_row ltx_border_tt"></th>
<td id="A1.T1.3.1.2" class="ltx_td ltx_align_center ltx_border_tt">Qwen3-32B</td>
<td id="A1.T1.3.1.3" class="ltx_td ltx_align_center ltx_border_tt">Gemma-3-27B</td>
<td id="A1.T1.3.1.4" class="ltx_td ltx_align_center ltx_border_tt">Llama-3.1-70B</td></tr>
<tr id="A1.T1.3.2" class="ltx_tr">
<th id="A1.T1.3.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t"><math id="A1.T1.m1" class="ltx_Math" alttext="|\mathcal{V}|" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">|</mo><mi class="ltx_font_mathcaligraphic">𝒱</mi><mo stretchy="false">|</mo></mrow><annotation encoding="application/x-tex">|\mathcal{V}|</annotation></semantics></math></th>
<td id="A1.T1.3.2.2" class="ltx_td ltx_align_center ltx_border_t">151,936</td>
<td id="A1.T1.3.2.3" class="ltx_td ltx_align_center ltx_border_t">262,208</td>
<td id="A1.T1.3.2.4" class="ltx_td ltx_align_center ltx_border_t">128,256</td></tr>
<tr id="A1.T1.3.3" class="ltx_tr">
<th id="A1.T1.3.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row"><math id="A1.T1.m2" class="ltx_Math" alttext="d" display="inline" intent=":literal"><semantics><mi>d</mi><annotation encoding="application/x-tex">d</annotation></semantics></math></th>
<td id="A1.T1.3.3.2" class="ltx_td ltx_align_center">5,120</td>
<td id="A1.T1.3.3.3" class="ltx_td ltx_align_center">5,376</td>
<td id="A1.T1.3.3.4" class="ltx_td ltx_align_center">8,192</td></tr>
