<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F12.sf1.3" class="ltx_text" style="font-size:90%;">(a)</span> </span><span id="A3.F12.sf1.4" class="ltx_text" style="font-size:90%;">Qwen3-32B</span></figcaption><img src="2605.07984v1/media/results-poem/qwen-top1.png" id="A3.F12.sf1.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/387;" width="476" height="387" alt="Refer to caption">
</figure></div><div class="ltx_flex_cell ltx_flex_size_2">
<figure id="A3.F12.sf2" class="ltx_figure ltx_figure_panel ltx_align_center">
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_figure"><span id="A3.F12.sf2.3" class="ltx_text" style="font-size:90%;">(b)</span> </span><span id="A3.F12.sf2.4" class="ltx_text" style="font-size:90%;">Gemma-3-27B</span></figcaption><img src="2605.07984v1/media/results-poem/gemma-top1.png" id="A3.F12.sf2.g1" class="ltx_graphics ltx_centering ltx_img_square" style="aspect-ratio:476/387;" width="476" height="387" alt="Refer to caption">
</figure></div><div class="ltx_flex_break"></div><div class="ltx_flex_cell ltx_flex_size_1">
