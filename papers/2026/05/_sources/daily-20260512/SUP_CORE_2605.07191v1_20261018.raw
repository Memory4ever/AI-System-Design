<td id="S5.T5.7.2.4" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.1pt 3.6pt;"><span id="S5.T5.7.2.4.1" class="ltx_text" style="font-size:80%;">69.0</span></td></tr>
<tr id="S5.T5.7.3" class="ltx_tr">
