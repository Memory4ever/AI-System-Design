<td id="S5.T5.7.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.1pt 3.6pt;"><span id="S5.T5.7.2.2.1" class="ltx_text" style="font-size:80%;">63.1</span></td>
