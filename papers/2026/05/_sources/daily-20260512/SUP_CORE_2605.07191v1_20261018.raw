<td id="A1.T1.10.4.4" class="ltx_td ltx_align_left" style="padding:0.1pt 5.0pt;"><span id="A1.T1.10.4.4.1" class="ltx_text" style="font-size:80%;">Self-Distillation</span></td>
<td id="A1.T1.10.4.5" class="ltx_td ltx_align_center" style="padding:0.1pt 5.0pt;"><span id="A1.T1.10.4.5.1" class="ltx_text" style="font-size:80%;">–</span></td></tr>
<tr id="A1.T1.10.5" class="ltx_tr">
<td id="A1.T1.10.5.1" class="ltx_td ltx_align_left" style="padding:0.1pt 5.0pt;"><span id="A1.T1.10.5.1.1" class="ltx_text" style="font-size:80%;">MoCov3 <cite class="ltx_cite ltx_citemacro_cite">[<a href="#bib.bib11" title="" class="ltx_ref">11</a>]</cite></span></td>
