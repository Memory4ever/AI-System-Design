<td id="A1.T1.10.1.5" class="ltx_td ltx_align_center" style="padding:0.1pt 5.0pt;"><span id="A1.T1.10.1.5.1" class="ltx_text ltx_font_bold" style="font-size:80%;">Native-Arch Components</span></td></tr>
