{"data":{"id":"10.48550/arxiv.2605.06835","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.06835","prefix":"10.48550","suffix":"arxiv.2605.06835","identifiers":[{"identifier":"2605.06835","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.06835"}],"creators":[{"name":"Zamanlooy, Behnoosh","nameType":"Personal","givenName":"Behnoosh","familyName":"Zamanlooy","affiliation":[],"nameIdentifiers":[]},{"name":"Bassak, Elaheh","nameType":"Personal","givenName":"Elaheh","familyName":"Bassak","affiliation":[],"nameIdentifiers":[]},{"name":"Tavakoli, Fatemeh","nameType":"Personal","givenName":"Fatemeh","familyName":"Tavakoli","affiliation":[],"nameIdentifiers":[]},{"name":"Kodeiri, Sara","nameType":"Personal","givenName":"Sara","familyName":"Kodeiri","affiliation":[],"nameIdentifiers":[]},{"name":"Lotif, Marcelo","nameType":"Personal","givenName":"Marcelo","familyName":"Lotif","affiliation":[],"nameIdentifiers":[]},{"name":"He, Xi","nameType":"Personal","givenName":"Xi","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Shafieinejad, Masoumeh","nameType":"Personal","givenName":"Masoumeh","familyName":"Shafieinejad","affiliation":[],"nameIdentifiers":[]},{"name":"Emerson, D. B.","nameType":"Personal","givenName":"D. B.","familyName":"Emerson","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"On Privacy in Data-Space Tabular Diffusion Models: Influential Factors, Attacker Knowledge, and Metrics"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"lang":"en","subject":"I.2.0; I.2.6","subjectScheme":"ACM"},{"lang":"en","subject":"68T01, 68T07","subjectScheme":"MSC"}],"contributors":[],"dates":[{"date":"2026-05-07T18:42:35Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:06:39Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-09-25T19:58:14Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-09-29T00:11:36Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Tabular data plays an important role in many fields and industries, including those with elevated privacy considerations and risks. As such, there is a rising interest in generating high-quality synthetic proxies for real tabular data as a means of reducing privacy risk and proprietary data exposure. With data-space tabular diffusion models (TDMs) demonstrating leading performance in synthesizing such data, understanding and measuring the privacy risks associated with these models is imperative. Leveraging state-of-the-art membership inference attacks for such TDMs in both black- and white-box settings, this work quantifies the impact of training setup, synthesis choices, and attacker knowledge on privacy leakage. Moreover, the results demonstrate that adversaries need not have perfect knowledge of the training setup, identical data distributions, or massive compute resources to construct successful attacks. Finally, the substantial pitfalls associated with heuristic privacy metrics, such as distance-to-closest record, are identified.","descriptionType":"Abstract"},{"description":"28 pages, 10 Figures, 14 Tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.06835","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:05:44.000Z","registered":"2026-05-11T02:05:44.000Z","published":"2026","updated":"2026-09-29T07:06:43.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.06835","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}