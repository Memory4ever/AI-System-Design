</span>
<span id="lstnumberx12" class="ltx_listingline"><span id="lstnumberx12.1" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:80%;--ltx-fg-color:#6A737D;">#<span id="lstnumberx12.1.1" class="ltx_text ltx_lst_space"> </span>So<span id="lstnumberx12.1.2" class="ltx_text ltx_lst_space"> </span>‘break‘<span id="lstnumberx12.1.3" class="ltx_text ltx_lst_space"> </span>is<span id="lstnumberx12.1.4" class="ltx_text ltx_lst_space"> </span>justified<span id="lstnumberx12.1.5" class="ltx_text ltx_lst_space"> </span>--<span id="lstnumberx12.1.6" class="ltx_text ltx_lst_space"> </span>but<span id="lstnumberx12.1.7" class="ltx_text ltx_lst_space"> </span>only<span id="lstnumberx12.1.8" class="ltx_text ltx_lst_space"> </span>after<span id="lstnumberx12.1.9" class="ltx_text ltx_lst_space"> </span>we<span id="lstnumberx12.1.10" class="ltx_text ltx_lst_space"> </span>hit<span id="lstnumberx12.1.11" class="ltx_text ltx_lst_space"> </span>n<span id="lstnumberx12.1.12" class="ltx_text ltx_lst_space"> </span>&gt;<span id="lstnumberx12.1.13" class="ltx_text ltx_lst_space"> </span>100,<span id="lstnumberx12.1.14" class="ltx_text ltx_lst_space"> </span>not<span id="lstnumberx12.1.15" class="ltx_text ltx_lst_space"> </span>earlier.</span>
