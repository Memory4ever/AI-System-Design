</span>
<span id="lstnumberx315" class="ltx_listingline"><span id="lstnumberx315.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">area</span><span id="lstnumberx315.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx315.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">PQR</span><span id="lstnumberx315.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx315.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx315.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx315.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">10</span>
</span>
<span id="lstnumberx316" class="ltx_listingline"><span id="lstnumberx316.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&lt;/</span><span id="lstnumberx316.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">result</span><span id="lstnumberx316.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&gt;</span>
</span>
<span id="lstnumberx317" class="ltx_listingline"><span id="lstnumberx317.1" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&lt;</span><span id="lstnumberx317.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">answer</span><span id="lstnumberx317.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&gt;</span><span id="lstnumberx317.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">The</span><span id="lstnumberx317.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">final</span><span id="lstnumberx317.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">answer</span><span id="lstnumberx317.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">is</span><span id="lstnumberx317.12" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">\\</span><span id="lstnumberx317.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">boxed</span><span id="lstnumberx317.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">{10}</span><span id="lstnumberx317.16" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx317.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&lt;/</span><span id="lstnumberx317.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">answer</span><span id="lstnumberx317.19" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&gt;</span>
