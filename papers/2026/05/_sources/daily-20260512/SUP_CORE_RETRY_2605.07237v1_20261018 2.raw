class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">b</span>
</span>
<span id="lstnumberx6" class="ltx_listingline"><span id="lstnumberx6.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">        </span><span id="lstnumberx6.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;--ltx-fg-color:#8959A8;">if</span><span id="lstnumberx6.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx6.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx6.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx6.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&lt;=</span><span id="lstnumberx6.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx6.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">100:</span>
</span>
<span id="lstnumberx7" class="ltx_listingline"><span id="lstnumberx7.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">            </span><span id="lstnumberx7.2" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">results</span><span id="lstnumberx7.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx7.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">add</span><span id="lstnumberx7.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx7.6" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx7.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">)</span>
</span>
<span id="lstnumberx8" class="ltx_listingline"><span id="lstnumberx8.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">        </span><span id="lstnumberx8.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;--ltx-fg-color:#8959A8;">elif</span><span id="lstnumberx8.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx8.4" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">n</span><span id="lstnumberx8.5" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx8.6" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">&gt;</span><span id="lstnumberx8.7" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx8.8" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">100:</span>
</span>
<span id="lstnumberx9" class="ltx_listingline"><span id="lstnumberx9.1" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">            </span><span id="lstnumberx9.2" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;--ltx-fg-color:#8959A8;">break</span><span id="lstnumberx9.3" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">                 </span><span id="lstnumberx9.4" class="ltx_text ltx_lst_comment ltx_font_typewriter ltx_font_italic" style="font-size:80%;--ltx-fg-color:#6A737D;">#<span id="lstnumberx9.4.1" class="ltx_text ltx_lst_space"> </span>potentially<span id="lstnumberx9.4.2" class="ltx_text ltx_lst_space"> </span>premature<span id="lstnumberx9.4.3" class="ltx_text ltx_lst_space"> </span>--<span id="lstnumberx9.4.4" class="ltx_text ltx_lst_space"> </span>revisited<span id="lstnumberx9.4.5" class="ltx_text ltx_lst_space"> </span>next<span id="lstnumberx9.4.6" class="ltx_text ltx_lst_space"> </span>turn</span>
</span>
<span id="lstnumberx10" class="ltx_listingline"><span id="lstnumberx10.1" class="ltx_text ltx_lst_keyword ltx_font_typewriter ltx_font_bold" style="font-size:80%;--ltx-fg-color:#8959A8;">print</span><span id="lstnumberx10.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx10.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">f</span><span id="lstnumberx10.4" class="ltx_text ltx_lst_string ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#718C00;">"Number<span id="lstnumberx10.4.1" class="ltx_text ltx_lst_space"> </span>of<span id="lstnumberx10.4.2" class="ltx_text ltx_lst_space"> </span>distinct<span id="lstnumberx10.4.3" class="ltx_text ltx_lst_space"> </span>values:<span id="lstnumberx10.4.4" class="ltx_text ltx_lst_space"> </span>{len(results)}"</span><span id="lstnumberx10.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">)</span>
</span>
</span>
</span></span></span></foreignObject></g></g></svg></span>
</div>
