span><span id="lstnumberx309.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">the</span><span id="lstnumberx309.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx309.18" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">first</span><span id="lstnumberx309.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx309.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">step</span>
</span>
<span id="lstnumberx310" class="ltx_listingline"><span id="lstnumberx310.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">import</span><span id="lstnumberx310.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx310.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sympy</span><span id="lstnumberx310.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx310.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">as</span><span id="lstnumberx310.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx310.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sp</span>
</span>
<span id="lstnumberx311" class="ltx_listingline"><span id="lstnumberx311.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">area_PQR</span><span id="lstnumberx311.2" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.3" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx311.4" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.5" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">5</span><span id="lstnumberx311.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.7" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">*</span><span id="lstnumberx311.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.9" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sp</span><span id="lstnumberx311.10" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx311.11" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sqrt</span><span id="lstnumberx311.12" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(3)</span><span id="lstnumberx311.13" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.14" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">*</span><span id="lstnumberx311.15" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.16" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">48</span><span id="lstnumberx311.17" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.18" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">*</span><span id="lstnumberx311.19" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.20" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sp</span><span id="lstnumberx311.21" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx311.22" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sqrt</span><span id="lstnumberx311.23" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(3)</span><span id="lstnumberx311.24" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.25" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">/</span><span id="lstnumberx311.26" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx311.27" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">72</span>
</span>
<span id="lstnumberx312" class="ltx_listingline"><span id="lstnumberx312.1" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">print</span><span id="lstnumberx312.2" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx312.3" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">f</span><span id="lstnumberx312.4" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">"</span><span id="lstnumberx312.5" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">area</span><span id="lstnumberx312.6" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx312.7" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">PQR</span><span id="lstnumberx312.8" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx312.9" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">=</span><span id="lstnumberx312.10" class="ltx_text ltx_lst_space ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;"> </span><span id="lstnumberx312.11" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">{</span><span id="lstnumberx312.12" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">sp</span><span id="lstnumberx312.13" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">.</span><span id="lstnumberx312.14" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">simplify</span><span id="lstnumberx312.15" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">(</span><span id="lstnumberx312.16" class="ltx_text ltx_lst_identifier ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">area_PQR</span><span id="lstnumberx312.17" class="ltx_text ltx_font_typewriter" style="font-size:80%;--ltx-fg-color:#000000;">)}")</span>
</span>
