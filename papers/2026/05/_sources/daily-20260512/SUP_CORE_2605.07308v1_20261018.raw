<td id="S4.T1.6.1.5.6" class="ltx_td ltx_align_center ltx_border_r" style="padding:1pt 4.0pt;"><span id="S4.T1.6.1.5.6.1" class="ltx_text ltx_font_bold">0.33</span></td>
<td id="S4.T1.6.1.5.7" class="ltx_td ltx_align_center" style="padding:1pt 4.0pt;">0.90</td>
