<td id="A2.T10.9.4.8" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.4.8.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.4699</span></td></tr>
<tr id="A2.T10.9.5" class="ltx_tr">
<th id="A2.T10.9.5.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.1.1" class="ltx_text" style="font-size:90%;">L4</span></th>
<td id="A2.T10.9.5.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.2.1" class="ltx_text" style="font-size:90%;">1.0</span></td>
<td id="A2.T10.9.5.3" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.3.1" class="ltx_text" style="font-size:90%;">0.25</span></td>
<td id="A2.T10.9.5.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.4.1" class="ltx_text" style="font-size:90%;">0.6332</span></td>
<td id="A2.T10.9.5.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.5.1" class="ltx_text" style="font-size:90%;">0.6369</span></td>
<td id="A2.T10.9.5.6" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.6.1" class="ltx_text" style="font-size:90%;">0.4899</span></td>
<td id="A2.T10.9.5.7" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.7.1" class="ltx_text" style="font-size:90%;">0.7677</span></td>
<td id="A2.T10.9.5.8" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.5.8.1" class="ltx_text" style="font-size:90%;">0.4533</span></td></tr>
<tr id="A2.T10.9.6" class="ltx_tr">
<th id="A2.T10.9.6.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.1.1" class="ltx_text" style="font-size:90%;">L5</span></th>
<td id="A2.T10.9.6.2" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.2.1" class="ltx_text" style="font-size:90%;">1.0</span></td>
<td id="A2.T10.9.6.3" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.3.1" class="ltx_text" style="font-size:90%;">1.0</span></td>
<td id="A2.T10.9.6.4" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.4.1" class="ltx_text" style="font-size:90%;">0.6324</span></td>
<td id="A2.T10.9.6.5" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.5.1" class="ltx_text" style="font-size:90%;">0.6349</span></td>
<td id="A2.T10.9.6.6" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.6.1" class="ltx_text" style="font-size:90%;">0.4915</span></td>
<td id="A2.T10.9.6.7" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.7.1" class="ltx_text" style="font-size:90%;">0.7698</span></td>
<td id="A2.T10.9.6.8" class="ltx_td ltx_align_center ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A2.T10.9.6.8.1" class="ltx_text" style="font-size:90%;">0.4572</span></td></tr>
