<td id="A2.T7.18.2.6" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T7.18.2.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">0.4741</span></td></tr>
<tr id="A2.T7.18.3" class="ltx_tr">
<th id="A2.T7.18.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:5.0pt;padding-right:5.0pt;"><math id="A2.T7.m19" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi mathsize="0.900em">σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math><span id="A2.T7.18.3.1.1" class="ltx_text" style="font-size:90%;">-conflict only</span></th>
<td id="A2.T7.18.3.2" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T7.18.3.2.1" class="ltx_text" style="font-size:90%;">0.6337</span></td>
<td id="A2.T7.18.3.3" class="ltx_td ltx_align_center" style="padding-left:5.0pt;padding-right:5.0pt;"><span id="A2.T7.18.3.3.1" class="ltx_text" style="font-size:90%;">0.6381</span></td>
