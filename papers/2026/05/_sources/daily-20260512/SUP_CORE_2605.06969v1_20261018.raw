<td id="A2.T8.29.5.1" class="ltx_td ltx_align_left"><span id="A2.T8.29.5.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Ours<span id="A2.T8.29.5.1.1.1" class="ltx_text ltx_font_medium"> (<math id="A2.T8.m54" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>-conflict <math id="A2.T8.m55" class="ltx_Math" alttext="+\,\mathcal{L}_{\mathrm{xfid}}" display="inline" intent=":literal"><semantics><mrow><mo>+</mo><msub><mi class="ltx_font_mathcaligraphic">ℒ</mi><mi>xfid</mi></msub></mrow><annotation encoding="application/x-tex">+\,\mathcal{L}_{\mathrm{xfid}}</annotation></semantics></math>)</span></span></td>
<td id="A2.T8.29.5.2" class="ltx_td ltx_align_center"><span id="A2.T8.29.5.2.1" class="ltx_text" style="font-size:90%;">0.022</span></td>
<td id="A2.T8.29.5.3" class="ltx_td ltx_align_center"><span id="A2.T8.29.5.3.1" class="ltx_text" style="font-size:90%;">0.021</span></td>
<td id="A2.T8.29.5.4" class="ltx_td ltx_align_center"><math id="A2.T8.m56" class="ltx_Math" alttext="\phantom{+}0.00" display="inline" intent=":literal"><semantics><mn mathsize="0.900em">0.00</mn><annotation encoding="application/x-tex">\phantom{+}0.00</annotation></semantics></math></td>
<td id="A2.T8.29.5.5" class="ltx_td ltx_align_center"><span id="A2.T8.29.5.5.1" class="ltx_text" style="font-size:90%;">0.694</span></td>
<td id="A2.T8.29.5.6" class="ltx_td ltx_align_center"><math id="A2.T8.m57" class="ltx_Math" alttext="\boldsymbol{+0.409}" display="inline" intent=":literal"><semantics><mrow><mo class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">+</mo><mn class="ltx_mathvariant_bold" mathsize="0.900em" mathvariant="bold">0.409</mn></mrow><annotation encoding="application/x-tex">\boldsymbol{+0.409}</annotation></semantics></math></td></tr>
<tr id="A2.T8.29.6" class="ltx_tr">
<td id="A2.T8.29.6.1" class="ltx_td ltx_align_left ltx_border_bb ltx_border_t"><span id="A2.T8.29.6.1.1" class="ltx_text" style="font-size:90%;">Ours <math id="A2.T8.m58" class="ltx_Math" alttext="+" display="inline" intent=":literal"><semantics><mo>+</mo><annotation encoding="application/x-tex">+</annotation></semantics></math> <math id="A2.T8.m59" class="ltx_Math" alttext="\sigma" display="inline" intent=":literal"><semantics><mi>σ</mi><annotation encoding="application/x-tex">\sigma</annotation></semantics></math>-blind PL<math id="A2.T8.m60" class="ltx_Math" alttext="{}^{\dagger\,\ddagger}" display="inline" intent=":literal"><semantics><msup><mrow></mrow><mrow><mo>†</mo><mo lspace="0.170em">⁣</mo><mo>‡</mo></mrow></msup><annotation encoding="application/x-tex">{}^{\dagger\,\ddagger}</annotation></semantics></math></span></td>
<td id="A2.T8.29.6.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A2.T8.29.6.2.1" class="ltx_text" style="font-size:90%;">0.032</span></td>
<td id="A2.T8.29.6.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A2.T8.29.6.3.1" class="ltx_text" style="font-size:90%;">0.027</span></td>
<td id="A2.T8.29.6.4" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A2.T8.m61" class="ltx_Math" alttext="+0.53" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">0.53</mn></mrow><annotation encoding="application/x-tex">+0.53</annotation></semantics></math></td>
<td id="A2.T8.29.6.5" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><span id="A2.T8.29.6.5.1" class="ltx_text" style="font-size:90%;">0.815</span></td>
<td id="A2.T8.29.6.6" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t"><math id="A2.T8.m62" class="ltx_Math" alttext="+0.358" display="inline" intent=":literal"><semantics><mrow><mo mathsize="0.900em">+</mo><mn mathsize="0.900em">0.358</mn></mrow><annotation encoding="application/x-tex">+0.358</annotation></semantics></math></td></tr>
