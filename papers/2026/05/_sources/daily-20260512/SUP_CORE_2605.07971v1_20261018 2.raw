<td id="S4.T1.2.1.1.2" class="ltx_td ltx_align_left ltx_border_tt" style="padding-left:3.5pt;padding-right:3.5pt;" rowspan="2"><span id="S4.T1.2.1.1.2.1" class="ltx_text" style="font-size:90%;">Method</span></td>
