<td id="S4.T1.2.1.2.8" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S4.T1.2.1.2.8.1" class="ltx_text" style="font-size:90%;">FID</span><math id="S4.T1.m12" class="ltx_Math" alttext="{}_{\text{D}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext mathsize="0.900em">D</mtext></msub><annotation encoding="application/x-tex">{}_{\text{D}}</annotation></semantics></math><span id="S4.T1.2.1.2.8.2" class="ltx_text" style="font-size:90%;"> </span><math id="S4.T1.m13" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downa