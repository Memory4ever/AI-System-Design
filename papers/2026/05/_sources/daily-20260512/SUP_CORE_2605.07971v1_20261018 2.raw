<td id="S4.T1.2.1.2.3" class="ltx_td ltx_align_center ltx_border_t" style="padding-left:3.5pt;padding-right:3.5pt;"><span id="S4.T1.2.1.2.3.1" class="ltx_text" style="font-size:90%;">FID</span><math id="S4.T1.m4" class="ltx_Math" alttext="{}_{\text{PC}}" display="inline" intent=":literal"><semantics><msub><mrow></mrow><mtext mathsize="0.900em">PC</mtext></msub><annotation encoding="application/x-tex">{}_{\text{PC}}</annotation></semantics></math><span id="S4.T1.2.1.2.3.2" class="ltx_text" style="font-size:90%;"> </span><math id="S4.T1.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo mathsize="0.900em" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></td>
