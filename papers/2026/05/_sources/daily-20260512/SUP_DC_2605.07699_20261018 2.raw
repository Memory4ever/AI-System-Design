{"data":{"id":"10.48550/arxiv.2605.07699","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07699","prefix":"10.48550","suffix":"arxiv.2605.07699","identifiers":[{"identifier":"2605.07699","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.07699"}],"creators":[{"name":"Borkakoty, Hsuvas","nameType":"Personal","givenName":"Hsuvas","familyName":"Borkakoty","affiliation":[],"nameIdentifiers":[]},{"name":"Pohl, Sebastian","nameType":"Personal","givenName":"Sebastian","familyName":"Pohl","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Cheng","nameType":"Personal","givenName":"Cheng","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Bei","nameType":"Personal","givenName":"Bei","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Yufang","nameType":"Personal","givenName":"Yufang","familyName":"Hou","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"DRIP-R: A Benchmark for Decision-Making and Reasoning Under Real-World Policy Ambiguity in the Retail Domain"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T13:10:49Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:59:15Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-07-31T14:41:42Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-03T00:51:23Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-31T11:51:33Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-01T01:59:08Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"LLM-based agents are increasingly deployed for routine but consequential tasks in real-world domains, where their behavior is governed by inherently ambiguous domain policies that admit multiple valid interpretations. Despite the prevalence of such ambiguities in practice, existing agent benchmarks largely assume unambiguous, well-specified policies, leaving a critical evaluation gap. We introduce DRIP-R, a benchmark that systematically exploits real-world retail policy ambiguities to construct scenarios in which no single correct resolution exists. DRIP-R comprises a curated set of policy-ambiguous return scenarios paired with a realistic customer personas, a full-duplex conversational simulation with tool-calling capabilities and a multi-judge evaluation framework covering policy adherence, dialogue quality, behavioral alignment, and resolution quality. Our experiments show that frontier models fundamentally disagree on identical policy-ambiguous scenarios, confirming that ambiguity poses a genuine and systematic challenge to LLM decision-making.","descriptionType":"Abstract"},{"description":"Accepted to EMNLP Findings","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07699","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:26:22.000Z","registered":"2026-05-11T02:26:23.000Z","published":"2026","updated":"2026-09-01T05:11:42.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07699","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}