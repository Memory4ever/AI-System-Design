<td id="A23.T25.2.13.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="2"><span id="A23.T25.2.13.4.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">—</span></td></tr>
