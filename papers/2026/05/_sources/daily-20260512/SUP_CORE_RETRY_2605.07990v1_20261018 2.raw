<td id="S4.T1.2.5.5" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T1.2.5.5.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">11%</span></td></tr>
