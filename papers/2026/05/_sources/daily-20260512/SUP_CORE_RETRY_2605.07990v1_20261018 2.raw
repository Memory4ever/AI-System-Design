<div id="A21.T23.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:154.9pt;vertical-align:-75.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-17.2pt,7.7pt) scale(0.909259739308158,0.909259739308158) ;">
