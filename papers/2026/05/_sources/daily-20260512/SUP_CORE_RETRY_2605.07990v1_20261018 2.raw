<td id="A30.T33.2.12.3" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">29</span></td>
<td id="A30.T33.2.12.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">55</span></td>
<td id="A30.T33.2.12.5" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">89</span></td>
<td id="A30.T33.2.12.6" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">171</span></td>
<td id="A30.T33.2.12.7" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.7.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">171</span></td>
<td id="A30.T33.2.12.8" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.12.8.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">184</span></td></tr>
<tr id="A30.T33.2.13" class="ltx_tr" style="--ltx-bg-color:#EDEDED;">
<th id="A30.T33.2.13.1" class="ltx_td ltx_align_left ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.1.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">Qwen 2.5 7B</span></th>
<td id="A30.T33.2.13.2" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.2.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">28</span></td>
<td id="A30.T33.2.13.3" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.3.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">29</span></td>
<td id="A30.T33.2.13.4" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.4.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">55</span></td>
<td id="A30.T33.2.13.5" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.5.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">89</span></td>
<td id="A30.T33.2.13.6" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.6.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">173</span></td>
<td id="A30.T33.2.13.7" class="ltx_td ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.7.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">179</span></td>
<td id="A30.T33.2.13.8" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.13.8.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">178</span></td></tr>
<tr id="A30.T33.2.14" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<th id="A30.T33.2.14.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Llama 3.1 8B</span></th>
<td id="A30.T33.2.14.2" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">32</span></td>
<td id="A30.T33.2.14.3" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">29</span></td>
<td id="A30.T33.2.14.4" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">51</span></td>
<td id="A30.T33.2.14.5" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">72</span></td>
<td id="A30.T33.2.14.6" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.6.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">127</span></td>
<td id="A30.T33.2.14.7" class="ltx_td ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.7.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">147</span></td>
<td id="A30.T33.2.14.8" class="ltx_td ltx_nopad_r ltx_align_right ltx_border_bb" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.14.8.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">127<math id="A30.T33.m5" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo style="--ltx-bg-color:#FFFFFF;" mathbackground="#FFFFFF" stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td></tr>
</tbody>
</table>
<figcaption class="ltx_caption ltx_centering"><span class="ltx_tag ltx_tag_table">Table 33: </span>PCA scaling across all 12 IT models (4 families). H = attention heads. Within Gemma 3, the 4B (8 heads) collapses at <math id="A30.T33.m14" class="ltx_Math" alttext="K{\geq}750" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>≥</mo><mn>750</mn></mrow><annotation encoding="application/x-tex">K{\geq}750</annotation></semantics></math> but the larger 12B/27B (16 heads) recover. Sub-1B Gemma models (270M, 1B; 4 heads) are noisy with low absolute <math id="A30.T33.m15" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math>. 16-32 head Qwen and Llama models keep growing or stay stable through <math id="A30.T33.m16" class="ltx_Math" alttext="K{=}1000" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">K{=}1000</annotation></semantics></math>. Qwen 3 4B reaches <math id="A30.T33.m17" class="ltx_Math" alttext="K{=}2000" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>2000</mn></mrow><annotation encoding="application/x-tex">K{=}2000</annotation></semantics></math> with <math id="A30.T33.m18" class="ltx_Math" alttext="k_{90}{=}182" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>90</mn></msub><mo>=</mo><mn>182</mn></mrow><annotation encoding="application/x-tex">k_{90}{=}182</annotation></semantics></math>; Qwen 2.5 7B and Qwen 3 1.7B reach <math id="A30.T33.m19" class="ltx_Math" alttext="K{=}1500" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>1500</mn></mrow><annotation encoding="application/x-tex">K{=}1500</annotation></semantics></math> with <math id="A30.T33.m20" class="ltx_Math" alttext="k_{90}{=}279" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>90</mn></msub><mo>=</mo><mn>279</mn></mrow><annotation encoding="application/x-tex">k_{90}{=}279</annotation></semantics></math> and <math id="A30.T33.m21" class="ltx_Math" alttext="230" display="inline" intent=":literal"><semantics><mn>230</mn><annotation encoding="application/x-tex">230</annotation></semantics></math> respectively.</figcaption>
</figure>
<div id="A30.SS0.SSS0.Px2.p2" class="ltx_para">
<p id="A30.SS0.SSS0.Px2.p2.1" class="ltx_p">The pattern is clear: at K=50, sub-1B Gemma (4 heads) needs 17–20, 8-head Gemma 4B needs 17, 16-head models (Gemma 12B/27B, Qwen 0.6B/1.7B) need 24–29, and 28–40 head models (Qwen 8B/14B/2.5-7B, Llama 8B) need 24–29. At larger K, the gap widens dramatically: at K=500, Gemma 4B (8 heads) needs 57, Gemma 12B/27B (16 heads) need 129/131, Qwen 0.6B/1.7B (16 heads) reach 138/133, Llama 8B and Qwen 8B (32 heads) need 127/147, and the highest-head Qwen 14B (40 heads) needs 171. Within the Gemma family, scale + heads buys both compression and stability: 4B collapses past <math id="A30.SS0.SSS0.Px2.p2.m1" class="ltx_Math" alttext="K{=}500" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">K{=}500</annotation></semantics></math>, but 12B and 27B both stay near <math id="A30.SS0.SSS0.Px2.p2.m2" class="ltx_Math" alttext="k_{90}{=}130" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>90</mn></msub><mo>=</mo><mn>130</mn></mrow><annotation encoding="application/x-tex">k_{90}{=}130</annotation></semantics></math> through <math id="A30.SS0.SSS0.Px2.p2.m3" class="ltx_Math" alttext="K{=}1000" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">K{=}1000</annotation></semantics></math>, and 27B briefly dips at <math id="A30.SS0.SSS0.Px2.p2.m4" class="ltx_Math" alttext="K{=}750" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>750</mn></mrow><annotation encoding="application/x-tex">K{=}750</annotation></semantics></math> (108) before recovering. Sub-1B Gemma models (270M, 1B) are noisier and never reach the same absolute <math id="A30.SS0.SSS0.Px2.p2.m5" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> as larger ones, but they avoid the catastrophic collapse pattern that Gemma 4B shows. Qwen also shows stronger cross-lingual tool alignment (Section <a href="#A22" title="Appendix A.22 Cross-lingual tool space alignment ‣ Tool Calling is Linearly Readable and Steerable in Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">A.22</span></a>): its tool-specific gap is 3<math id="A30.SS0.SSS0.Px2.p2.m6" class="ltx_Math" alttext="\times" display="inline" intent=":literal"><semantics><mo>×</mo><annotation encoding="application/x-tex">\times</annotation></semantics></math> larger (0.167 vs. 0.054) and it classifies Korean queries at 93% vs. Gemma’s 60%. The extra dimensions may provide room for richer, more language-invariant tool representations, though we cannot rule out that the difference comes from pretraining data rather than architecture.</p>
</div>
<div id="A30.SS0.SSS0.Px2.p3" class="ltx_para">
<p id="A30.SS0.SSS0.Px2.p3.1" class="ltx_p">The 32+ head models also handle long tool lists best: at <math id="A30.SS0.SSS0.Px2.p3.m1" class="ltx_Math" alttext="K{=}750" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>750</mn></mrow><annotation encoding="application/x-tex">K{=}750</annotation></semantics></math> ( 16K tokens), Gemma 4B’s representations collapse (<math id="A30.SS0.SSS0.Px2.p3.m2" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> drops from 57 to 27), while Qwen 8B/14B/2.5-7B stay stable (147–179) and scale through <math id="A30.SS0.SSS0.Px2.p3.m3" class="ltx_Math" alttext="K{=}1000" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>1000</mn></mrow><annotation encoding="application/x-tex">K{=}1000</annotation></semantics></math>. Qwen 4B keeps growing all the way to <math id="A30.SS0.SSS0.Px2.p3.m4" class="ltx_Math" alttext="K{=}2000" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>2000</mn></mrow><annotation encoding="application/x-tex">K{=}2000</annotation></semantics></math> (<math id="A30.SS0.SSS0.Px2.p3.m5" class="ltx_Math" alttext="k_{90}{=}182" display="inline" intent=":literal"><semantics><mrow><msub><mi>k</mi><mn>90</mn></msub><mo>=</mo><mn>182</mn></mrow><annotation encoding="application/x-tex">k_{90}{=}182</annotation></semantics></math>). Larger Gemma variants (12B/27B) also recover their compression after the brief <math id="A30.SS0.SSS0.Px2.p3.m6" class="ltx_Math" alttext="K{=}750" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>750</mn></mrow><annotation encoding="application/x-tex">K{=}750</annotation></semantics></math> dip. Combining heads, <math id="A30.SS0.SSS0.Px2.p3.m7" class="ltx_Math" alttext="d_{\text{model}}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mtext>model</mtext></msub><annotation encoding="application/x-tex">d_{\text{model}}</annotation></semantics></math>, and parameter count, the picture is: scale buys an effective context budget; once a model’s combined capacity is exceeded, <math id="A30.SS0.SSS0.Px2.p3.m8" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> collapses (Gemma 4B at <math id="A30.SS0.SSS0.Px2.p3.m9" class="ltx_Math" alttext="K{=}750" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>750</mn></mrow><annotation encoding="application/x-tex">K{=}750</annotation></semantics></math>); larger models only delay this point.</p>
</div>
</section>
<section id="A30.SS0.SSS0.Px3" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Sampling sensitivity.</h4>

<div id="A30.SS0.SSS0.Px3.p1" class="ltx_para">
<p id="A30.SS0.SSS0.Px3.p1.1" class="ltx_p">We also tested a max-diversity sampling strategy (within each domain, prioritize APIs with different name prefixes). The curve shape changes (<math id="A30.SS0.SSS0.Px3.p1.m1" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> at <math id="A30.SS0.SSS0.Px3.p1.m2" class="ltx_Math" alttext="K{=}500" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">K{=}500</annotation></semantics></math>: 30 with max-diversity vs. 57 with stratified), suggesting that the non-monotonic pattern reflects the real semantic structure of the API pool rather than a fixed property of the model.</p>
</div>
</section>
<section id="A30.SS0.SSS0.Px4" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Same-domain vs. cross-domain.</h4>

<div id="A30.SS0.SSS0.Px4.p1" class="ltx_para">
<p id="A30.SS0.SSS0.Px4.p1.1" class="ltx_p">When all tools come from a single domain (Finance, 500 APIs), the model needs only 32 dimensions at <math id="A30.SS0.SSS0.Px4.p1.m1" class="ltx_Math" alttext="K{=}500" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>500</mn></mrow><annotation encoding="application/x-tex">K{=}500</annotation></semantics></math>, compared to 57 for the cross-domain stratified set. Within-domain tools are more similar to each other, so they pack into fewer directions. The Finance curve also shows an early plateau: <math id="A30.SS0.SSS0.Px4.p1.m2" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> stays at 15 from <math id="A30.SS0.SSS0.Px4.p1.m3" class="ltx_Math" alttext="K{=}50" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>50</mn></mrow><annotation encoding="application/x-tex">K{=}50</annotation></semantics></math> to <math id="A30.SS0.SSS0.Px4.p1.m4" class="ltx_Math" alttext="K{=}75" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mn>75</mn></mrow><annotation encoding="application/x-tex">K{=}75</annotation></semantics></math>, meaning the first 50 finance tools already span most of the “finance region” and adding more barely changes the subspace. This explains the non-monotonic dips in the main scaling curve: when a batch of new tools falls into a well-represented domain, <math id="A30.SS0.SSS0.Px4.p1.m5" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math> can stay flat or even dip.</p>
</div>
</section>
<section id="A30.SS0.SSS0.Px5" class="ltx_paragraph">
<h4 class="ltx_title ltx_title_paragraph">Multi-domain comparison.</h4>

<div id="A30.SS0.SSS0.Px5.p1" class="ltx_para">
<p id="A30.SS0.SSS0.Px5.p1.1" class="ltx_p">We run the same analysis on individual domains to see how within-domain similarity affects compression. Table <a href="#A30.T34" title="Table 34 ‣ Multi-domain comparison. ‣ Appendix A.30 PCA scaling with ToolBench APIs ‣ Tool Calling is Linearly Readable and Steerable in Language Models" class="ltx_ref"><span class="ltx_text ltx_ref_tag">34</span></a> shows the results.</p>
</div>
<figure id="A30.T34" class="ltx_table">
<table id="A30.T34.2" class="ltx_tabular ltx_centering ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A30.T34.2.1" class="ltx_tr">
<th id="A30.T34.2.1.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.1.1" class="ltx_text ltx_font_smallcaps">Domain</span></th>
<th id="A30.T34.2.1.2" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.2.1" class="ltx_text ltx_font_smallcaps">5</span></th>
<th id="A30.T34.2.1.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.3.1" class="ltx_text ltx_font_smallcaps">15</span></th>
<th id="A30.T34.2.1.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.4.1" class="ltx_text ltx_font_smallcaps">50</span></th>
<th id="A30.T34.2.1.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.5.1" class="ltx_text ltx_font_smallcaps">100</span></th>
<th id="A30.T34.2.1.6" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.6.1" class="ltx_text ltx_font_smallcaps">200</span></th>
<th id="A30.T34.2.1.7" class="ltx_td ltx_nopad_r ltx_align_right ltx_th ltx_th_column ltx_border_tt" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.1.7.1" class="ltx_text ltx_font_smallcaps">500</span></th></tr>
</thead>
<tbody class="ltx_tbody">
<tr id="A30.T34.2.2" class="ltx_tr" style="--ltx-bg-color:#FFFFFF;">
<td id="A30.T34.2.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.2.1.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">Stratified (49)</span></td>
<td id="A30.T34.2.2.2" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.2.2.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">2</span></td>
<td id="A30.T34.2.2.3" class="ltx_td ltx_align_right ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T34.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">7</span></td>
