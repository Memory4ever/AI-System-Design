<td id="A30.T32.2.3.5" class="ltx_td ltx_nopad_r ltx_align_right" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="A30.T32.2.3.5.1" class="ltx_text" style="--ltx-bg-color:#EDEDED;">56%</span></td></tr>
