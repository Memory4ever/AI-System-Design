</section>
<section id="A11" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A.11 </span>Cross-model PCA comparison</h2>

<figure id="A11.T15" class="ltx_table">
<div id="A11.T15.2" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:345.0pt;height:142.5pt;vertical-align:-66.4pt;"><span class="ltx_transformed_inner" style="transform:translate(83.9pt,-34.6pt) scale(1.94601941653983,1.94601941653983) ;">
<table id="A11.T15.2.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
<thead class="ltx_thead">
<tr id="A11.T15.2.1.1" class="ltx_tr">
