<th id="A30.T33.2.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt" style="padding-left:3.0pt;padding-right:3.0pt;" colspan="6"><math id="A30.T33.m1" class="ltx_Math" alttext="k_{90}" display="inline" intent=":literal"><semantics><msub><mi>k</mi><mn>90</mn></msub><annotation encoding="application/x-tex">k_{90}</annotation></semantics></math><span id="A30.T33.2.1.3.1" class="ltx_text ltx_font_smallcaps"> at <math id="A30.T33.m2" class="ltx_Math" alttext="K=" display="inline" intent=":literal"><semantics><mrow><mi>K</mi><mo>=</mo><mphantom></mphantom></mrow><annotation encoding="application/x-tex">K=</annotation></semantics></math></span></th></tr>
<tr id="A30.T33.2.2" class="ltx_tr">
<th id="A30.T33.2.2.1" class="ltx_td ltx_th ltx_th_row" style="padding-left:3.0pt;padding-right:3.0pt;"></th>
<th id="A30.T33.2.2.2" class="ltx_td ltx_th ltx_th_column" style="padding-left:3.0pt;padding-right:3.0pt;"></th>
<th id="A30.T33.2.2.3" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.2.3.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">50</span></th>
<th id="A30.T33.2.2.4" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.2.4.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">100</span></th>
<th id="A30.T33.2.2.5" class="ltx_td ltx_align_right ltx_th ltx_th_column ltx_border_t" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="A30.T33.2.2.5.1" class="ltx_text" style="--ltx-bg-color:#FFFFFF;">200</span></th>
