<tr id="S1.T1.5.3" class="ltx_tr">
<td id="S1.T1.5.3.1" class="ltx_td ltx_align_center ltx_border_r ltx_border_t" style="padding-top:0.9pt;padding-bottom:0.9pt;"><cite class="ltx_cite ltx_citemacro_citep"><span id="S1.T1.5.3.1.1" class="ltx_text" style="font-size:90%;">(</span><a href="#bib.bib27" title="" class="ltx_ref">Petrov et al., 2024</a>; <a href="#bib.bib22" title="" class="ltx_ref">Kratsios, 2023</a><span id="S1.T1.5.3.1.3" class="ltx_text" style="font-size:90%;">)</span></cite></td>
