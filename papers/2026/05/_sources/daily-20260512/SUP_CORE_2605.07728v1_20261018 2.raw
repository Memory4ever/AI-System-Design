<span id="S3.T2.2.2.1.1.1" class="ltx_p"><span id="S3.T2.2.2.1.1.1.1" class="ltx_text" style="font-size:90%;">Completeness</span></span>
</span></td>
<td id="S3.T2.2.2.2" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.2.2.2.1" class="ltx_inline-block ltx_align_top" style="width:113.8pt;">
<span id="S3.T2.2.2.2.1.1" class="ltx_p"><span id="S3.T2.2.2.2.1.1.1" class="ltx_text" style="font-size:90%;">I7 (Enforcement completeness)</span></span>
</span></td>
<td id="S3.T2.2.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_t">
<span id="S3.T2.2.2.3.1" class="ltx_inline-block ltx_align_top" style="width:184.9pt;">
