<td id="S5.T11.4.5.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T11.4.5.3.1" class="ltx_text" style="font-size:70%;">98.5%</span></td></tr>
