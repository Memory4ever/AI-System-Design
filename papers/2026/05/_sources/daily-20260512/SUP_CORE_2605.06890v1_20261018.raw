</span></th>
<td id="S4.T2.4.6.2" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.4.6.2.1" class="ltx_text" style="font-size:70%;">0.64</span></td>
<td id="S4.T2.4.6.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.4.6.3.1" class="ltx_text" style="font-size:70%;">0.62</span></td></tr>
