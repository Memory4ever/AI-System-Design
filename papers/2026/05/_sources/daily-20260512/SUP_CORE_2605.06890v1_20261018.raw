<figure id="S4.T6.fig2" class="ltx_figure ltx_figure_panel ltx_minipage ltx_align_center ltx_align_top" style="width:165.6pt;">
<figcaption class="ltx_caption ltx_centering" style="font-size:70%;"><span class="ltx_tag ltx_tag_figure">Table 6: </span>Layer concentration of top-20 Probe-1 features by model.</figcaption>
<div id="S4.T6.fig2.3" class="ltx_inline-block ltx_align_center ltx_transformed_outer" style="width:165.6pt;height:39.2pt;vertical-align:-18.2pt;"><span class="ltx_transformed_inner" style="transform:translate(-21.1pt,5.0pt) scale(0.796561592596923,0.796561592596923) ;">
<table id="S4.T6.fig2.3.1" class="ltx_tabular ltx_guessed_headers ltx_align_middle">
