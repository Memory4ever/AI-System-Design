<th id="S4.T2.4.7.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;" colspan="3"><span id="S4.T2.4.7.1.1" class="ltx_text ltx_font_italic" style="font-size:70%;">Layer concentration</span></th></tr>
