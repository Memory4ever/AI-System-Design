<span id="S5.T11.4.6.1.1" class="ltx_inline-block ltx_align_top">
<span id="S5.T11.4.6.1.1.1" class="ltx_p"><span id="S5.T11.4.6.1.1.1.1" class="ltx_text" style="font-size:70%;">Episode success (all steps correct)</span></span>
</span></th>
<td id="S5.T11.4.6.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T11.4.6.2.1" class="ltx_text" style="font-size:70%;">49.2%</span></td>
