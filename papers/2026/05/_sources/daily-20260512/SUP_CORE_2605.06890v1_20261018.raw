<tr id="A1.T12.4.2" class="ltx_tr">
<td id="A1.T12.4.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t">
<span id="A1.T12.4.2.1.1" class="ltx_inline-block ltx_align_top" style="width:62.1pt;">
<span id="A1.T12.4.2.1.1.1" class="ltx_p"><span id="A1.T12.4.2.1.1.1.1" class="ltx_text" style="font-size:90%;">Feature specification</span></span>
</span></td>
