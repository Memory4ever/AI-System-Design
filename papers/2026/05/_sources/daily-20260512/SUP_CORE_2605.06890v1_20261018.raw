</span></th>
<td id="S5.T11.4.4.2" class="ltx_td ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T11.4.4.2.1" class="ltx_text" style="font-size:70%;">10.8%</span></td>
<td id="S5.T11.4.4.3" class="ltx_td ltx_nopad_r ltx_align_center" style="padding-left:3.0pt;padding-right:3.0pt;"><span id="S5.T11.4.4.3.1" class="ltx_text" style="font-size:70%;">0.2%</span></td></tr>
