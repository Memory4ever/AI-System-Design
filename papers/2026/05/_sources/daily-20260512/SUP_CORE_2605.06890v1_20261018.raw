<span id="A1.T12.4.1.3.1" class="ltx_inline-block ltx_align_top">
<span id="A1.T12.4.1.3.1.1" class="ltx_p"><span id="A1.T12.4.1.3.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Technical role</span></span>
</span></th></tr>
</thead>
