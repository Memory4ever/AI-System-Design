{"data":{"id":"10.48550/arxiv.2605.30359","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.30359","prefix":"10.48550","suffix":"arxiv.2605.30359","identifiers":[{"identifier":"2605.30359","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.30359"}],"creators":[{"name":"Huang, Zixuan","nameType":"Personal","givenName":"Zixuan","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Da","nameType":"Personal","givenName":"Da","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Huang, Kecheng","nameType":"Personal","givenName":"Kecheng","familyName":"Huang","affiliation":[],"nameIdentifiers":[]},{"name":"Yin, Lihao","nameType":"Personal","givenName":"Lihao","familyName":"Yin","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Xing","nameType":"Personal","givenName":"Xing","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhen, Huiling","nameType":"Personal","givenName":"Huiling","familyName":"Zhen","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Mingxuan","nameType":"Personal","givenName":"Mingxuan","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]},{"name":"Shao, Zili","nameType":"Personal","givenName":"Zili","familyName":"Shao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Kernel Foundry: A Diagnosis-driven Evolutionary Kernel Optimizer with Multi-Experts"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Neural and Evolutionary Computing (cs.NE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Performance (cs.PF)","subjectScheme":"arXiv"},{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"lang":"en","subject":"Systems and Control (eess.SY)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Electrical engineering, electronic engineering, information engineering","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T03:41:54Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-06-01T00:00:11Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-08-03T01:31:45Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-08-04T01:22:56Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Generating high-performance GPU kernels remains challenging due to the need for both correctness and hardware-aware optimization. While large language models (LLMs) show promise in code generation, they often fail to produce kernels that are both correct and efficient.\n We propose Kernel Foundry, a diagnosis-driven evolutionary framework for automatic GPU kernel optimization. Our method combines expert-guided, retrieval-augmented initialization with a multi-island evolutionary search, where candidate kernels are iteratively refined using structured diagnostic feedback. A centralized experience library accumulates reusable optimization knowledge to guide subsequent evolution, while explicit mechanisms prevent cheating behaviors that bypass kernel-level computation.\n Experiments on KernelBench show that our method consistently improves both correctness and performance over strong baselines, achieving up to 100% correctness on Level~2.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.30359","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-06-01T01:59:43.000Z","registered":"2026-06-01T01:59:44.000Z","published":"2026","updated":"2026-08-04T04:45:41.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.30359","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}