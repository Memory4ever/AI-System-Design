<span id="S5.T1.8.1.1.1.30.4" class="ltx_td ltx_align_center ltx_border_bb" style="--ltx-bg-color:#FFEDC7;"><span id="S5.T1.8.1.1.1.30.4.1" class="ltx_text" style="--ltx-bg-color:#FFEDC7;">467.4k</span></span>
