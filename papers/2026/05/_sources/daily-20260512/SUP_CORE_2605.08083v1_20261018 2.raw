<span id="S5.T1.8.1.1.1.29.4" class="ltx_td ltx_align_center" style="--ltx-bg-color:#FFEDC7;"><span id="S5.T1.8.1.1.1.29.4.1" class="ltx_text" style="--ltx-bg-color:#FFEDC7;">255.3k</span></span>
<span id="S5.T1.8.1.1.1.29.5" class="ltx_td ltx_align_center">74.1</span>
