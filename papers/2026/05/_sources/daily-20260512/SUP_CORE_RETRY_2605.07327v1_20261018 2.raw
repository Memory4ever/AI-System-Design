<td id="A3.T7.5.2.1" class="ltx_td ltx_align_center ltx_border_t">D2 + Mid + U0</td>
<td id="A3.T7.5.2.2" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T7.5.2.2.1" class="ltx_text ltx_font_bold">134.94</span></td>
<td id="A3.T7.5.2.3" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T7.5.2.3.1" class="ltx_text ltx_font_bold">53.64</span></td>
<td id="A3.T7.5.2.4" class="ltx_td ltx_align_center ltx_border_t"><span id="A3.T7.5.2.4.1" class="ltx_text ltx_font_bold">37.03</span></td></tr>
