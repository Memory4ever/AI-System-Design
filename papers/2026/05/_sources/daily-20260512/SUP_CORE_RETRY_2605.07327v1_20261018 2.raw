<th id="S4.T2.1.7.2" class="ltx_td ltx_align_center ltx_th ltx_th_row">1</th>
<td id="S4.T2.1.7.3" class="ltx_td ltx_align_center"><span id="S4.T2.1.7.3.1" class="ltx_text ltx_underline">19.01</span></td>
<td id="S4.T2.1.7.4" class="ltx_td ltx_align_center"><span id="S4.T2.1.7.4.1" class="ltx_text ltx_underline">0.336</span></td></tr>
<tr id="S4.T2.1.8" class="ltx_tr">
<th id="S4.T2.1.8.1" class="ltx_td ltx_align_left ltx_th ltx_th_row ltx_border_bb ltx_border_t">TFD (Ours)</th>
