<th id="A2.T5.5.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt"><math id="A2.T5.m6" class="ltx_Math" alttext="50" display="inline" intent=":literal"><semantics><mn>50</mn><annotation encoding="application/x-tex">50</annotation></semantics></math>K</th>
