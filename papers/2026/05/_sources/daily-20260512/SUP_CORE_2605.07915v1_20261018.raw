<tr id="A4.T8.6.1" class="ltx_tr">
<td id="A4.T8.6.1.1" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="A4.T8.6.1.1.1" class="ltx_text ltx_font_bold" style="font-size:90%;">Metric</span></td>
