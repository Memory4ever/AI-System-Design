<td id="A4.T8.6.1.6" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_tt" style="padding:0.25pt 3.0pt;"><span id="A4.T8.6.1.6.1" class="ltx_text ltx_font_bold" style="font-size:90%;">MAE</span></td></tr>
<tr id="A4.T8.6.2" class="ltx_tr">
<td id="A4.T8.6.2.1" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;" rowspan="2"><span id="A4.T8.6.2.1.1" class="ltx_text" style="font-size:90%;">gFID<math id="A4.T8.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="A4.T8.6.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.25pt 3.0pt;"><span id="A4.T8.6.2.2.1" class="ltx_text" style="font-size:90%;">w/o <math id="A4.T8.m4" class="ltx_Math" alttext="L_{\mathrm{p}}" display="inline" intent=":literal"><semantics><msub><mi>L</mi><mi>p</mi></msub><annotation encoding="application/x-tex">L_{\mathrm{p}}</annotation></semantics></math></span></td>
