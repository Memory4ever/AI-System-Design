<span id="A5.T6.7.1.4.1" class="ltx_inline-block ltx_align_top" style="width:141.5pt;">
<span id="A5.T6.7.1.4.1.1" class="ltx_p"><span id="A5.T6.7.1.4.1.1.1" class="ltx_text ltx_font_bold" style="font-size:70%;">Design intent</span></span>
</span></th></tr>
</thead>
