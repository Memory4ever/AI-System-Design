<span id="A5.T6.7.4.3.1.1" class="ltx_p"><span id="A5.T6.7.4.3.1.1.1" class="ltx_text" style="font-size:70%;">Low: HOW</span></span>
</span></td>
<td id="A5.T6.7.4.4" class="ltx_td ltx_nopad_r ltx_align_left ltx_align_top ltx_border_bb" style="padding:0.2pt 4.0pt;">
