<tr id="A5.T6.7.2" class="ltx_tr">
<td id="A5.T6.7.2.1" class="ltx_td ltx_align_left ltx_align_top ltx_border_t" style="padding:0.2pt 4.0pt;">
<span id="A5.T6.7.2.1.1" class="ltx_inline-block ltx_align_top" style="width:41.4pt;">
<span id="A5.T6.7.2.1.1.1" class="ltx_p"><span id="A5.T6.7.2.1.1.1.1" class="ltx_text" style="font-size:70%;">Type A</span>
<br class="ltx_break"><span id="A5.T6.7.2.1.1.1.2" class="ltx_text" style="font-size:70%;">(GT Diff)</span></span>
</span></td>
