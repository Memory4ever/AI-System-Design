<td id="S5.T4.2.1.1.2" class="ltx_td ltx_align_center ltx_border_tt"><span id="S5.T4.2.1.1.2.1" class="ltx_text ltx_font_bold">Overall Suc. <math id="S5.T4.m3" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td>
