{"data":{"id":"10.48550/arxiv.2605.07161","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07161","prefix":"10.48550","suffix":"arxiv.2605.07161","identifiers":[{"identifier":"2605.07161","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.07161"}],"creators":[{"name":"Clark, Jackson","nameType":"Personal","givenName":"Jackson","familyName":"Clark","affiliation":[],"nameIdentifiers":[]},{"name":"Su, Yiming","nameType":"Personal","givenName":"Yiming","familyName":"Su","affiliation":[],"nameIdentifiers":[]},{"name":"Pial, Saad Mohammad Rafid","nameType":"Personal","givenName":"Saad Mohammad Rafid","familyName":"Pial","affiliation":[],"nameIdentifiers":[]},{"name":"Tian, Yifang","nameType":"Personal","givenName":"Yifang","familyName":"Tian","affiliation":[],"nameIdentifiers":[]},{"name":"Gniedziejko, Lily","nameType":"Personal","givenName":"Lily","familyName":"Gniedziejko","affiliation":[],"nameIdentifiers":[]},{"name":"Jacobsen, Hans-Arno","nameType":"Personal","givenName":"Hans-Arno","familyName":"Jacobsen","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Yinfang","nameType":"Personal","givenName":"Yinfang","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Tianyin","nameType":"Personal","givenName":"Tianyin","familyName":"Xu","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"SREGym: A Live Benchmark for AI SRE Agents with High-Fidelity Failure Scenarios"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T02:47:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T00:30:03Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-13T05:21:47Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-14T00:37:14Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-07-30T18:34:51Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-03T00:04:22Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"AI agents are increasingly used to diagnose and mitigate failures in production systems, known as agentic Site Reliability Engineering (SRE). Current SRE benchmarks are limited to oversimplistic SRE tasks and are unfortunately hard to extend due to bespoke designs. We present SREGym, a high-fidelity benchmark for SRE agents. SREGym exposes a live system environment built atop real-world cloud-native system stacks, where high-fidelity failure scenarios are simulated through fault injectors. SREGym models the complexity of production environments by simulating (1) a wide range of faults at different layers, (2) various ambient noises, and (3) diverse failure modes such as metastable failures and correlated failures. SREGym is architected as a modular, extensible framework that orchestrates fault and noise injectors across stacks. SREGym currently includes 90 realistic, challenging SRE problems. We use SREGym to evaluate frontier agents and show that their capabilities varies significantly in addressing different kinds of failures, with up to 40% differences in end-to-end results. SREGym is actively maintained as an open-source project and has been used by researchers and practitioners.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07161","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:13:24.000Z","registered":"2026-05-11T02:13:25.000Z","published":"2026","updated":"2026-08-03T02:11:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07161","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}