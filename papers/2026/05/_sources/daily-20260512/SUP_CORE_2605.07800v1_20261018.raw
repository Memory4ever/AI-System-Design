<th id="S4.T2.7.1.2.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_t" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S4.T2.7.1.2.3.1" class="ltx