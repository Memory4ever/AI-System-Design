{"data":{"id":"10.48550/arxiv.2605.07721","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.07721","prefix":"10.48550","suffix":"arxiv.2605.07721","identifiers":[{"identifier":"2605.07721","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.07721"}],"creators":[{"name":"Vendrell, Victor Conchello","nameType":"Personal","givenName":"Victor Conchello","familyName":"Vendrell","affiliation":[],"nameIdentifiers":[]},{"name":"Masdemont, Arnau Padres","nameType":"Personal","givenName":"Arnau Padres","familyName":"Masdemont","affiliation":[],"nameIdentifiers":[]},{"name":"Grillo, Niccolò","nameType":"Personal","givenName":"Niccolò","familyName":"Grillo","affiliation":[],"nameIdentifiers":[]},{"name":"Ros-Giralt, Jordi","nameType":"Personal","givenName":"Jordi","familyName":"Ros-Giralt","affiliation":[],"nameIdentifiers":[]},{"name":"Behboodi, Arash","nameType":"Personal","givenName":"Arash","familyName":"Behboodi","affiliation":[],"nameIdentifiers":[]},{"name":"Massoli, Fabio Valerio","nameType":"Personal","givenName":"Fabio Valerio","familyName":"Massoli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Memory-Efficient Looped Transformer: Decoupling Compute from Memory in Looped Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-08T13:25:27Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-11T01:00:19Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-19T08:08:32Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-20T00:42:46Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-09-28T17:44:40Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-09-29T03:26:13Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"3","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Recurrent LLM architectures have emerged as a promising approach for improving reasoning, as they enable multi-step computation in the embedding space without generating intermediate tokens. Models such as Ouro perform reasoning by iteratively updating internal representations while retaining a standard Key-Value (KV) cache across iterations, causing memory consumption to grow linearly with reasoning depth. Consequently, increasing the number of reasoning iterations can lead to prohibitive memory usage, limiting the practical scalability of such architectures. In this work, we propose Memory-Efficient Looped Transformer (MELT), a novel architecture that decouples reasoning depth from memory consumption. Instead of using a standard KV cache per layer and loop, MELT maintains a single KV cache per layer that is shared across reasoning loops. This cache is updated over time via a learnable gating mechanism. To enable stable and efficient training under this architecture, we propose to train MELT using chunk-wise training in a two phase procedure: interpolated transition, followed by attention-aligned distillation, both from the LoopLM starting model to MELT. Empirically, we show that MELT models fine-tuned from pretrained Ouro parameters outperform standard LLMs of comparable size, while maintaining a memory footprint comparable to those models and dramatically smaller than Ouro's. Overall, MELT achieves constant-memory iterative reasoning without sacrificing LoopLM performance, using only a lightweight post-training procedure.","descriptionType":"Abstract"},{"description":"22 pages, 5 figures, 11 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.07721","contentUrl":null,"metadataVersion":2,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-11T02:26:52.000Z","registered":"2026-05-11T02:26:53.000Z","published":"2026","updated":"2026-09-29T07:06:58.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.07721","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}