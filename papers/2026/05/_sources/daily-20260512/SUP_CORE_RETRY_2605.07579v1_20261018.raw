<td id="A5.T12.6.1.2" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.35pt 5.0pt;"><span id="A5.T12.6.1.2.1" class="ltx_text" style="font-size:90%;">MAE <math id="A5.T12.m3" class="ltx_Math" alttext="\downarrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↓</mo><annotation encoding="application/x-tex">\downarrow</annotation></semantics></math></span></td>
<td id="A5.T12.6.1.3" class="ltx_td ltx_align_center ltx_border_tt" style="padding:0.35pt 5.0pt;"><span id="A5.T12.6.1.3.1" class="ltx_text" style="font-size:90%;">Pearson <math id="A5.T12.m4" class="ltx_Math" alttext="r" display="inline" intent=":literal"><semantics><mi>r</mi><annotation encoding="application/x-tex">r</annotation></semantics></math> <math id="A5.T12.m5" class="ltx_Math" alttext="\uparrow" display="inline" intent=":literal"><semantics><mo stretchy="false">↑</mo><annotation encoding="application/x-tex">\uparrow</annotation></semantics></math></span></td></tr>
<tr id="A5.T12.6.2" class="ltx_tr">
<td id="A5.T12.6.2.1" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.35pt 5.0pt;"><span id="A5.T12.6.2.1.1" class="ltx_text" style="font-size:90%;">Linear ridge</span></td>
<td id="A5.T12.6.2.2" class="ltx_td ltx_align_center ltx_border_t" style="padding:0.35pt 5.0pt;"><span id="A5.T12.6.2.2.1" class="ltx_text" style="font-size:90%;">0.124</span></td>
