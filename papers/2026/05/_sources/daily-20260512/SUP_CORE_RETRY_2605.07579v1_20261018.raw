<td id="A5.T9.5.13.2" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;"><span id="A5.T9.5.13.2.1" class="ltx_text" style="font-size:90%;">0.135</span></td>
<td id="A5.T9.5.13.3" class="ltx_td ltx_align_center" style="padding:0.25pt 5.0pt;"><span id="A5.T9.5.13.3.1" class="ltx_text" style="font-size:90%;">0.332</span></td></tr>
