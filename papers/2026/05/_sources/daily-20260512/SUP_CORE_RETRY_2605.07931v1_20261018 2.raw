<td id="S5.T1.2.20.4" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.2.20.4.1" class="ltx_text" style="font-size:80%;">31.82</span></td>
<td id="S5.T1.2.20.5" class="ltx_td ltx_align_center" style="padding-left:4.0pt;padding-right:4.0pt;"><span id="S5.T1.2.20.5.1" class="ltx_text" style="font-size:80%;">8.00</span></td>
