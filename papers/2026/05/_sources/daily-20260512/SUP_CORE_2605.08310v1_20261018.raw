            <span id="A1.alg1.l35.3" class="ltx_text ltx_font_bold">end</span> <span id="A1.alg1.l35.4" class="ltx_text ltx_font_bold">for</span>
</div>
<div id="A1.alg1.l36" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l36.1" class="ltx_text" style="font-size:80%;">36:</span></span>
              
              
            <span id="A1.alg1.l36.3" class="ltx_text ltx_font_bold">return</span> <math id="A1.alg1.l36.m1" class="ltx_Math" alttext="G^{+}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>+</mo></msup><annotation encoding="application/x-tex">G^{+}</annotation></semantics></math>

