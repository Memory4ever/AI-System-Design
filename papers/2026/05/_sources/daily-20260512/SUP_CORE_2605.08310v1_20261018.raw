<td id="A2.T6.5.1.3.1" class="ltx_td ltx_align_left" style="--ltx-bg-color:#EEF2F6;padding:0.3pt 4.0pt;"><span id="A2.T6.5.1.3.1.1" class="ltx_text" style="--ltx-bg-color:#EEF2F6;">Environment</span></td>
<td id="A2.T6.5.1.3.2" class="ltx_td ltx_align_left" style="padding:0.3pt 4.0pt;">Large Docker</td>
<td id="A2.T6.5.1.3.3" class="ltx_td ltx_align_left" style="padding:0.3pt 4.0pt;">Simulated outputs</td>
<td id="A2.T6.5.1.3.4" class="ltx_td ltx_align_left" style="--ltx-bg-color:#D8F6E2;padding:0.3pt 4.0pt;"><span id="A2.T6.5.1.3.4.1" class="ltx_text" style="--ltx-bg-color:#D8F6E2;">Static interactive setup</span></td></tr>
