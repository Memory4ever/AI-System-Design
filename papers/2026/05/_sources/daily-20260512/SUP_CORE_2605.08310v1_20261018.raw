<section id="A1" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix A </span>WebTrap algorithm and prompts</h2>

<div id="A1.p1" class="ltx_para">
<p id="A1.p1.1" class="ltx_p">This section provides the complete implementation workflow of WebTrap, the prompt templates, and practical generation examples.</p>
</div>
<section id="A1.SS1" class="ltx_subsection">
<h3 class="ltx_title ltx_title_subsection"><span class="ltx_tag ltx_tag_subsection">A.1 </span>Full attack algorithm</h3>

<figure id="A1.alg1" class="ltx_float ltx_float_algorithm ltx_framed ltx_framed_top">
<figcaption class="ltx_caption"><span class="ltx_tag ltx_tag_float"><span id="A1.alg1.3" class="ltx_text ltx_font_bold">Algorithm A.1</span> </span> WebTrap injection</figcaption>
<div id="A1.alg1.4" class="ltx_listing ltx_framed ltx_framed_topbottom ltx_listing">
<div id="A1.alg1.l1" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l1.1" class="ltx_text" style="font-size:80%;">1:</span></span>
              
              
            Navigation graph <math id="A1.alg1.l1.m1" class="ltx_Math" alttext="G=(V,E)" display="inline" intent=":literal"><semantics><mrow><mi>G</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><mi>V</mi><mo>,</mo><mi>E</mi><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">G=(V,E)</annotation></semantics></math> partitioned into user area <math id="A1.alg1.l1.m2" class="ltx_Math" alttext="V_{U}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>U</mi></msub><annotation encoding="application/x-tex">V_{U}</annotation></semantics></math> and restricted area <math id="A1.alg1.l1.m3" class="ltx_Math" alttext="V_{R}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>R</mi></msub><annotation encoding="application/x-tex">V_{R}</annotation></semantics></math>; attacker-visible user-area graph <math id="A1.alg1.l1.m4" class="ltx_Math" alttext="G_{U}=G[V_{U}]" display="inline" intent=":literal"><semantics><mrow><msub><mi>G</mi><mi>U</mi></msub><mo>=</mo><mrow><mi>G</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><msub><mi>V</mi><mi>U</mi></msub><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">G_{U}=G[V_{U}]</annotation></semantics></math>; injection start node <math id="A1.alg1.l1.m5" class="ltx_Math" alttext="v_{s}\in V_{U}" display="inline" intent=":literal"><semantics><mrow><msub><mi>v</mi><mi>s</mi></msub><mo>∈</mo><msub><mi>V</mi><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">v_{s}\in V_{U}</annotation></semantics></math>; restricted-area anchor node <math id="A1.alg1.l1.m6" class="ltx_Math" alttext="a_{R}\in V_{U}" display="inline" intent=":literal"><semantics><mrow><msub><mi>a</mi><mi>R</mi></msub><mo>∈</mo><msub><mi>V</mi><mi>U</mi></msub></mrow><annotation encoding="application/x-tex">a_{R}\in V_{U}</annotation></semantics></math>; visible entrance descriptor <math id="A1.alg1.l1.m7" class="ltx_Math" alttext="d_{e}" display="inline" intent=":literal"><semantics><msub><mi>d</mi><mi>e</mi></msub><annotation encoding="application/x-tex">d_{e}</annotation></semantics></math>; attacker goal <math id="A1.alg1.l1.m8" class="ltx_Math" alttext="g_{a}" display="inline" intent=":literal"><semantics><msub><mi>g</mi><mi>a</mi></msub><annotation encoding="application/x-tex">g_{a}</annotation></semantics></math>; environment type <math id="A1.alg1.l1.m9" class="ltx_Math" alttext="\rho" display="inline" intent=":literal"><semantics><mi>ρ</mi><annotation encoding="application/x-tex">\rho</annotation></semantics></math>; stage generators <math id="A1.alg1.l1.m10" class="ltx_Math" alttext="\{G_{\text{lure}},G_{\text{inertia}},G_{\text{payload}}\}" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">{</mo><msub><mi>G</mi><mtext>lure</mtext></msub><mo>,</mo><msub><mi>G</mi><mtext>inertia</mtext></msub><mo>,</mo><msub><mi>G</mi><mtext>payload</mtext></msub><mo stretchy="false">}</mo></mrow><annotation encoding="application/x-tex">\{G_{\text{lure}},G_{\text{inertia}},G_{\text{payload}}\}</annotation></semantics></math>; system-style constraint <math id="A1.alg1.l1.m11" class="ltx_Math" alttext="\mathcal{C}_{\text{sys}}" display="inline" intent=":literal"><semantics><msub><mi class="ltx_font_mathcaligraphic">𝒞</mi><mtext>sys</mtext></msub><annotation encoding="application/x-tex">\mathcal{C}_{\text{sys}}</annotation></semantics></math>

</div>
<div id="A1.alg1.l2" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l2.1" class="ltx_text" style="font-size:80%;">2:</span></span>
              
              
            Injected environment <math id="A1.alg1.l2.m1" class="ltx_Math" alttext="G^{+}" display="inline" intent=":literal"><semantics><msup><mi>G</mi><mo>+</mo></msup><annotation encoding="application/x-tex">G^{+}</annotation></semantics></math>

</div>
<div id="A1.alg1.l3" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l3.1" class="ltx_text" style="font-size:80%;">3:</span></span>
              
              
            <math id="A1.alg1.l3.m1" class="ltx_Math" alttext="P\leftarrow\operatorname{ShortestPath}(G_{U},v_{s},a_{R})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo stretchy="false">←</mo><mrow><mi>ShortestPath</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>U</mi></msub><mo>,</mo><msub><mi>v</mi><mi>s</mi></msub><mo>,</mo><msub><mi>a</mi><mi>R</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">P\leftarrow\operatorname{ShortestPath}(G_{U},v_{s},a_{R})</annotation></semantics></math>

</div>
<div id="A1.alg1.l4" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l4.1" class="ltx_text" style="font-size:80%;">4:</span></span>
              
              
              <span id="A1.alg1.l4.3" class="ltx_text ltx_font_italic">The planner uses only the attacker-visible user area and does not inspect internal nodes, edges, or observations in <math id="A1.alg1.l4.m1" class="ltx_Math" alttext="V_{R}" display="inline" intent=":literal"><semantics><msub><mi>V</mi><mi>R</mi></msub><annotation encoding="application/x-tex">V_{R}</annotation></semantics></math>.</span>

</div>
<div id="A1.alg1.l5" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l5.1" class="ltx_text" style="font-size:80%;">5:</span></span>
              
              
              <span id="A1.alg1.l5.3" class="ltx_text ltx_font_italic">Let <math id="A1.alg1.l5.m1" class="ltx_Math" alttext="P=(p_{0},p_{1},\ldots,p_{m})" display="inline" intent=":literal"><semantics><mrow><mi>P</mi><mo>=</mo><mrow><mo stretchy="false">(</mo><msub><mi>p</mi><mn>0</mn></msub><mo>,</mo><msub><mi>p</mi><mn>1</mn></msub><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><annotation encoding="application/x-tex">P=(p_{0},p_{1},\ldots,p_{m})</annotation></semantics></math>, where <math id="A1.alg1.l5.m2" class="ltx_Math" alttext="p_{0}=v_{s}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mn>0</mn></msub><mo>=</mo><msub><mi>v</mi><mi>s</mi></msub></mrow><annotation encoding="application/x-tex">p_{0}=v_{s}</annotation></semantics></math> and <math id="A1.alg1.l5.m3" class="ltx_Math" alttext="p_{m}=a_{R}" display="inline" intent=":literal"><semantics><mrow><msub><mi>p</mi><mi>m</mi></msub><mo>=</mo><msub><mi>a</mi><mi>R</mi></msub></mrow><annotation encoding="application/x-tex">p_{m}=a_{R}</annotation></semantics></math>.</span>

</div>
<div id="A1.alg1.l6" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l6.1" class="ltx_text" style="font-size:80%;">6:</span></span>
              
              
            <math id="A1.alg1.l6.m1" class="ltx_Math" alttext="\hat{g}_{u}\leftarrow\operatorname{CoarseUserGoal}(\rho)" display="inline" intent=":literal"><semantics><mrow><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>u</mi></msub><mo stretchy="false">←</mo><mrow><mi>CoarseUserGoal</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\hat{g}_{u}\leftarrow\operatorname{CoarseUserGoal}(\rho)</annotation></semantics></math>

</div>
<div id="A1.alg1.l7" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l7.1" class="ltx_text" style="font-size:80%;">7:</span></span>
              
              
              <math id="A1.alg1.l7.m1" class="ltx_Math" alttext="\hat{g}_{u}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>g</mi><mo>^</mo></mover><mi>u</mi></msub><annotation encoding="application/x-tex">\hat{g}_{u}</annotation></semantics></math><span id="A1.alg1.l7.3" class="ltx_text ltx_font_italic"> is a generic approximation of the ongoing user workflow and does not use the hidden user goal.</span>

</div>
<div id="A1.alg1.l8" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l8.1" class="ltx_text" style="font-size:80%;">8:</span></span>
              
              
            <span id="A1.alg1.l8.3" class="ltx_text ltx_font_bold">if</span> <math id="A1.alg1.l8.m1" class="ltx_Math" alttext="m=0" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>0</mn></mrow><annotation encoding="application/x-tex">m=0</annotation></semantics></math> <span id="A1.alg1.l8.4" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="A1.alg1.l9" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l9.1" class="ltx_text" style="font-size:80%;">9:</span></span>
              
              
              <math id="A1.alg1.l9.m1" class="ltx_Math" alttext="S\leftarrow[(\text{payload},p_{0})]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mo stretchy="false">(</mo><mtext>payload</mtext><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow[(\text{payload},p_{0})]</annotation></semantics></math>

</div>
<div id="A1.alg1.l10" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l10.1" class="ltx_text" style="font-size:80%;">10:</span></span>
              
              
            <span id="A1.alg1.l10.3" class="ltx_text ltx_font_bold">else</span> <span id="A1.alg1.l10.4" class="ltx_text ltx_font_bold">if</span> <math id="A1.alg1.l10.m1" class="ltx_Math" alttext="m=1" display="inline" intent=":literal"><semantics><mrow><mi>m</mi><mo>=</mo><mn>1</mn></mrow><annotation encoding="application/x-tex">m=1</annotation></semantics></math> <span id="A1.alg1.l10.5" class="ltx_text ltx_font_bold">then</span>

</div>
<div id="A1.alg1.l11" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l11.1" class="ltx_text" style="font-size:80%;">11:</span></span>
              
              
              <math id="A1.alg1.l11.m1" class="ltx_Math" alttext="S\leftarrow[(\text{lure},p_{0}),(\text{payload},p_{1})]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mtext>lure</mtext><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mtext>payload</mtext><mo>,</mo><msub><mi>p</mi><mn>1</mn></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow[(\text{lure},p_{0}),(\text{payload},p_{1})]</annotation></semantics></math>

</div>
<div id="A1.alg1.l12" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l12.1" class="ltx_text" style="font-size:80%;">12:</span></span>
              
              
            <span id="A1.alg1.l12.3" class="ltx_text ltx_font_bold">else</span>
</div>
<div id="A1.alg1.l13" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l13.1" class="ltx_text" style="font-size:80%;">13:</span></span>
              
              
              <math id="A1.alg1.l13.m1" class="ltx_Math" alttext="S\leftarrow[(\text{lure},p_{0}),(\text{inertia},p_{\lfloor 2m/3\rfloor}),(\text{payload},p_{m})]" display="inline" intent=":literal"><semantics><mrow><mi>S</mi><mo stretchy="false">←</mo><mrow><mo stretchy="false">[</mo><mrow><mrow><mo stretchy="false">(</mo><mtext>lure</mtext><mo>,</mo><msub><mi>p</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mtext>inertia</mtext><mo>,</mo><msub><mi>p</mi><mrow><mo stretchy="false">⌊</mo><mrow><mrow><mn>2</mn><mo lspace="0em" rspace="0em">​</mo><mi>m</mi></mrow><mo>/</mo><mn>3</mn></mrow><mo stretchy="false">⌋</mo></mrow></msub><mo stretchy="false">)</mo></mrow><mo>,</mo><mrow><mo stretchy="false">(</mo><mtext>payload</mtext><mo>,</mo><msub><mi>p</mi><mi>m</mi></msub><mo stretchy="false">)</mo></mrow></mrow><mo stretchy="false">]</mo></mrow></mrow><annotation encoding="application/x-tex">S\leftarrow[(\text{lure},p_{0}),(\text{inertia},p_{\lfloor 2m/3\rfloor}),(\text{payload},p_{m})]</annotation></semantics></math>

</div>
<div id="A1.alg1.l14" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l14.1" class="ltx_text" style="font-size:80%;">14:</span></span>
              
              
            <span id="A1.alg1.l14.3" class="ltx_text ltx_font_bold">end</span> <span id="A1.alg1.l14.4" class="ltx_text ltx_font_bold">if</span>
</div>
<div id="A1.alg1.l15" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l15.1" class="ltx_text" style="font-size:80%;">15:</span></span>
              
              
            <math id="A1.alg1.l15.m1" class="ltx_Math" alttext="G^{+}\leftarrow G" display="inline" intent=":literal"><semantics><mrow><msup><mi>G</mi><mo>+</mo></msup><mo stretchy="false">←</mo><mi>G</mi></mrow><annotation encoding="application/x-tex">G^{+}\leftarrow G</annotation></semantics></math>

</div>
<div id="A1.alg1.l16" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l16.1" class="ltx_text" style="font-size:80%;">16:</span></span>
              
              
            <span id="A1.alg1.l16.3" class="ltx_text ltx_font_bold">for</span> <math id="A1.alg1.l16.m1" class="ltx_Math" alttext="k=1,\ldots,|S|" display="inline" intent=":literal"><semantics><mrow><mrow><mi>k</mi><mo>=</mo><mn>1</mn></mrow><mo>,</mo><mi mathvariant="normal">…</mi><mo>,</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">k=1,\ldots,|S|</annotation></semantics></math> <span id="A1.alg1.l16.4" class="ltx_text ltx_font_bold">do</span>

</div>
<div id="A1.alg1.l17" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l17.1" class="ltx_text" style="font-size:80%;">17:</span></span>
              
              
              <math id="A1.alg1.l17.m1" class="ltx_Math" alttext="(s_{k},p_{k})\leftarrow S[k]" display="inline" intent=":literal"><semantics><mrow><mrow><mo stretchy="false">(</mo><msub><mi>s</mi><mi>k</mi></msub><mo>,</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow><mo stretchy="false">←</mo><mrow><mi>S</mi><mo>⁡</mo><mrow><mo stretchy="false">[</mo><mi>k</mi><mo stretchy="false">]</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">(s_{k},p_{k})\leftarrow S[k]</annotation></semantics></math>

</div>
<div id="A1.alg1.l18" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l18.1" class="ltx_text" style="font-size:80%;">18:</span></span>
              
              
              <math id="A1.alg1.l18.m1" class="ltx_Math" alttext="o_{k}\leftarrow\operatorname{Observe}(G_{U},p_{k})" display="inline" intent=":literal"><semantics><mrow><msub><mi>o</mi><mi>k</mi></msub><mo stretchy="false">←</mo><mrow><mi>Observe</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>G</mi><mi>U</mi></msub><mo>,</mo><msub><mi>p</mi><mi>k</mi></msub><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">o_{k}\leftarrow\operatorname{Observe}(G_{U},p_{k})</annotation></semantics></math>

</div>
<div id="A1.alg1.l19" class="ltx_listingline">
              <span class="ltx_tag ltx_tag_listingline"><span id="A1.alg1.l19.1" class="ltx_text" style="font-size:80%;">19:</span></span>
              
              
              <span id="A1.alg1.l19.3" class="ltx_text ltx_font_bold">if</span> <math id="A1.alg1.l19.m1" class="ltx_Math" alttext="k&lt;|S|" display="inline" intent=":literal"><semantics><mrow><mi>k</mi><mo>&lt;</mo><mrow><mo stretchy="false">|</mo><mi>S</mi><mo stretchy="false">|</mo></mrow></mrow><annotation encoding="application/x-tex">k&lt;|S|</annotation></semantics></math> <span id="A1.alg1.l19.4" class="ltx_text ltx_font_bold">then</span>

</div>
