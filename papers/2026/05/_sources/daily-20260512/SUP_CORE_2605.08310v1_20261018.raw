pan><span id="lstnumberx16.29" class="ltx_text ltx_lst_identifier">only</span><span id="lstnumberx16.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.31" class="ltx_text ltx_lst_identifier">redirects</span><span id="lstnumberx16.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.33" class="ltx_text ltx_lst_identifier">navigation</span><span id="lstnumberx16.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.35" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx16.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.37" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx16.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.39" class="ltx_text ltx_lst_identifier">next</span><span id="lstnumberx16.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.41" class="ltx_text ltx_lst_identifier">injection</span><span id="lstnumberx16.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.43" class="ltx_text ltx_lst_identifier">point</span>.<span id="lstnumberx16.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.45" class="ltx_text ltx_lst_identifier">It</span><span id="lstnumberx16.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.47" class="ltx_text ltx_lst_identifier">must</span><span id="lstnumberx16.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.49" class="ltx_text ltx_lst_identifier">not</span><span id="lstnumberx16.50" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.51" class="ltx_text ltx_lst_identifier">reveal</span><span id="lstnumberx16.52" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.53" class="ltx_text ltx_lst_identifier">any</span><span id="lstnumberx16.54" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.55" class="ltx_text ltx_lst_identifier">hidden</span><span id="lstnumberx16.56" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.57" class="ltx_text ltx_lst_identifier">task</span><span id="lstnumberx16.58" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.59" class="ltx_text ltx_lst_identifier">or</span><span id="lstnumberx16.60" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.61" class="ltx_text ltx_lst_identifier">secondary</span><span id="lstnumberx16.62" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx16.63" class="ltx_text ltx_lst_identifier">objective</span>.
