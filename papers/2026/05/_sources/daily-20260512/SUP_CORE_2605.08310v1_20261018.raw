</thead>
<tbody class="ltx_tbody">
<tr id="A2.T6.5.1.2" class="ltx_tr">
<td id="A2.T6.5.1.2.1" class="ltx_td ltx_align_left ltx_border_t" style="--ltx-bg-color:#EEF2F6;padding:0.3pt 4.0pt;"><span id="A2.T6.5.1.2.1.1" class="ltx_text" style="--ltx-bg-color:#EEF2F6;">Agent Scenario</span></td>
<td id="A2.T6.5.1.2.2" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.3pt 4.0pt;">Web agent</td>
<td id="A2.T6.5.1.2.3" class="ltx_td ltx_align_left ltx_border_t" style="padding:0.3pt 4.0pt;">Tool agent</td>
<td id="A2.T6.5.1.2.4" class="ltx_td ltx_align_left ltx_border_t" style="--ltx-bg-color:#D8F6E2;padding:0.3pt 4.0pt;"><span id="A2.T6.5.1.2.4.1" class="ltx_text" style="--ltx-bg-color:#D8F6E2;">General navigation agent</span></td></tr>
