               <math id="A1.alg1.l29.m1" class="ltx_Math" alttext="\omega\leftarrow\operatorname{InferOperationHint}(g_{a},d_{e},\rho)" display="inline" intent=":literal"><semantics><mrow><mi>ω</mi><mo stretchy="false">←</mo><mrow><mi>InferOperationHint</mi><mo>⁡</mo><mrow><mo stretchy="false">(</mo><msub><mi>g</mi><mi>a</mi></msub><mo>,</mo><msub><mi>d</mi><mi>e</mi></msub><mo>,</mo><mi>ρ</mi><mo stretchy="false">)</mo></mrow></mrow></mrow><annotation encoding="application/x-tex">\omega\leftarrow\operatorname{InferOperationHint}(g_{a},d_{e},\rho)</annotation></semantics></math>

