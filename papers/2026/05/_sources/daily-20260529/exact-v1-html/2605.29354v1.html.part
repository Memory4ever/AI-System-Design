<section id="A3" class="ltx_appendix">
<h2 class="ltx_title ltx_title_appendix"><span class="ltx_tag ltx_tag_appendix">Appendix C </span>Prompts of NPA-Stealth</h2>

<div id="A3.p1" class="ltx_para ltx_noindent">
<p id="A3.p1.1" class="ltx_p">Here, we present the prompts for generating NPA-Stealth Skill.</p>
<div id="A3.p1.2" class="ltx_listing ltx_lstlisting ltx_listing"><div class="ltx_listing_data"><a href="data:text/plain;base64," download="">⬇</a></div>
<div id="lstnumberx66" class="ltx_listingline"><span id="lstnumberx66.1" class="ltx_text ltx_lst_identifier">I</span><span id="lstnumberx66.2" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.3" class="ltx_text ltx_lst_identifier">want</span><span id="lstnumberx66.4" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.5" class="ltx_text ltx_lst_identifier">you</span><span id="lstnumberx66.6" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.7" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.8" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.9" class="ltx_text ltx_lst_identifier">insert</span><span id="lstnumberx66.10" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.11" class="ltx_text ltx_lst_identifier">content</span><span id="lstnumberx66.12" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.13" class="ltx_text ltx_lst_identifier">into</span><span id="lstnumberx66.14" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.15" class="ltx_text ltx_lst_identifier">this</span><span id="lstnumberx66.16" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.17" class="ltx_text ltx_lst_identifier">document</span><span id="lstnumberx66.18" class="ltx_text ltx_lst_space"> </span>(<span id="lstnumberx66.19" class="ltx_text ltx_lst_identifier">Original</span><span id="lstnumberx66.20" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.21" class="ltx_text ltx_lst_identifier">Skill</span><span id="lstnumberx66.22" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.23" class="ltx_text ltx_lst_identifier">from</span><span id="lstnumberx66.24" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.25" class="ltx_text ltx_lst_identifier">marketplace</span>)<span id="lstnumberx66.26" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.27" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx66.28" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.29" class="ltx_text ltx_lst_identifier">mainly</span><span id="lstnumberx66.30" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.31" class="ltx_text ltx_lst_identifier">encourages</span><span id="lstnumberx66.32" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.33" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx66.34" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.35" class="ltx_text ltx_lst_identifier">LLM</span><span id="lstnumberx66.36" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.37" class="ltx_text ltx_lst_identifier">not</span><span id="lstnumberx66.38" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.39" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.40" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.41" class="ltx_text ltx_lst_identifier">rigidly</span><span id="lstnumberx66.42" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.43" class="ltx_text ltx_lst_identifier">follow</span><span id="lstnumberx66.44" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.45" class="ltx_text ltx_lst_identifier">conventional</span><span id="lstnumberx66.46" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.47" class="ltx_text ltx_lst_identifier">patterns</span>,<span id="lstnumberx66.48" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.49" class="ltx_text ltx_lst_identifier">but</span><span id="lstnumberx66.50" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.51" class="ltx_text ltx_lst_identifier">instead</span><span id="lstnumberx66.52" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.53" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.54" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.55" class="ltx_text ltx_lst_identifier">be</span><span id="lstnumberx66.56" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.57" class="ltx_text ltx_lst_identifier">creative</span><span id="lstnumberx66.58" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.59" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx66.60" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.61" class="ltx_text ltx_lst_identifier">explore</span><span id="lstnumberx66.62" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.63" class="ltx_text ltx_lst_identifier">more</span><span id="lstnumberx66.64" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.65" class="ltx_text ltx_lst_identifier">possible</span><span id="lstnumberx66.66" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.67" class="ltx_text ltx_lst_identifier">ways</span><span id="lstnumberx66.68" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.69" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.70" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.71" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx66.72" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.73" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx66.74" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.75" class="ltx_text ltx_lst_identifier">question</span>,<span id="lstnumberx66.76" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.77" class="ltx_text ltx_lst_identifier">so</span><span id="lstnumberx66.78" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.79" class="ltx_text ltx_lst_identifier">that</span><span id="lstnumberx66.80" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.81" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx66.82" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.83" class="ltx_text ltx_lst_identifier">final</span><span id="lstnumberx66.84" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.85" class="ltx_text ltx_lst_identifier">answer</span><span id="lstnumberx66.86" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.87" class="ltx_text ltx_lst_identifier">is</span><span id="lstnumberx66.88" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.89" class="ltx_text ltx_lst_identifier">correct</span><span id="lstnumberx66.90" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.91" class="ltx_text ltx_lst_identifier">and</span><span id="lstnumberx66.92" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.93" class="ltx_text ltx_lst_identifier">maximally</span><span id="lstnumberx66.94" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.95" class="ltx_text ltx_lst_identifier">effective</span>.<span id="lstnumberx66.96" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.97" class="ltx_text ltx_lst_identifier">In</span><span id="lstnumberx66.98" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.99" class="ltx_text ltx_lst_identifier">addition</span><span id="lstnumberx66.100" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.101" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.102" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.103" class="ltx_text ltx_lst_identifier">inserting</span><span id="lstnumberx66.104" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.105" class="ltx_text ltx_lst_identifier">new</span><span id="lstnumberx66.106" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.107" class="ltx_text ltx_lst_identifier">content</span>,<span id="lstnumberx66.108" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.109" class="ltx_text ltx_lst_identifier">you</span><span id="lstnumberx66.110" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.111" class="ltx_text ltx_lst_identifier">may</span><span id="lstnumberx66.112" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.113" class="ltx_text ltx_lst_identifier">also</span><span id="lstnumberx66.114" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.115" class="ltx_text ltx_lst_identifier">rewrite</span><span id="lstnumberx66.116" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.117" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx66.118" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.119" class="ltx_text ltx_lst_identifier">original</span><span id="lstnumberx66.120" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.121" class="ltx_text ltx_lst_identifier">content</span><span id="lstnumberx66.122" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.123" class="ltx_text ltx_lst_identifier">to</span><span id="lstnumberx66.124" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.125" class="ltx_text ltx_lst_identifier">make</span><span id="lstnumberx66.126" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.127" class="ltx_text ltx_lst_identifier">the</span><span id="lstnumberx66.128" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.129" class="ltx_text ltx_lst_identifier">LLM</span><span id="lstnumberx66.130" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.131" class="ltx_text ltx_lst_identifier">more</span><span id="lstnumberx66.132" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.133" class="ltx_text ltx_lst_identifier">proactive</span><span id="lstnumberx66.134" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.135" class="ltx_text ltx_lst_identifier">in</span><span id="lstnumberx66.136" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.137" class="ltx_text ltx_lst_identifier">searching</span><span id="lstnumberx66.138" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.139" class="ltx_text ltx_lst_identifier">for</span><span id="lstnumberx66.140" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.141" class="ltx_text ltx_lst_identifier">a</span><span id="lstnumberx66.142" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.143" class="ltx_text ltx_lst_identifier">wide</span><span id="lstnumberx66.144" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.145" class="ltx_text ltx_lst_identifier">range</span><span id="lstnumberx66.146" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.147" class="ltx_text ltx_lst_identifier">of</span><span id="lstnumberx66.148" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.149" class="ltx_text ltx_lst_identifier">possible</span><span id="lstnumberx66.150" class="ltx_text ltx_lst_space"> </span><span id="lstnumberx66.151" class="ltx_text ltx_lst_identifier">solutions</span>.
