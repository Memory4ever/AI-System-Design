{"data":{"id":"10.48550/arxiv.2604.26963","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.26963","prefix":"10.48550","suffix":"arxiv.2604.26963","identifiers":[{"identifier":"2604.26963","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.26963"}],"creators":[{"name":"Wang, Yifei","nameType":"Personal","givenName":"Yifei","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Ye, Hancheng","nameType":"Personal","givenName":"Hancheng","familyName":"Ye","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Yechen","nameType":"Personal","givenName":"Yechen","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Guo, Cong","nameType":"Personal","givenName":"Cong","familyName":"Guo","affiliation":[],"nameIdentifiers":[]},{"name":"Wei, Chiyue","nameType":"Personal","givenName":"Chiyue","familyName":"Wei","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Qinsi","nameType":"Personal","givenName":"Qinsi","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Dongting","nameType":"Personal","givenName":"Dongting","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Tingjun","nameType":"Personal","givenName":"Tingjun","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Hai \"Helen\"","nameType":"Personal","givenName":"Hai \"Helen\"","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"Zhuo, Danyang","nameType":"Personal","givenName":"Danyang","familyName":"Zhuo","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Yiran","nameType":"Personal","givenName":"Yiran","familyName":"Chen","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"MARS: Efficient, Adaptive Co-Scheduling for Heterogeneous Agentic Systems"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Operating Systems (cs.OS)","subjectScheme":"arXiv"},{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"lang":"en","subject":"Machine Learning (cs.LG)","subjectScheme":"arXiv"},{"lang":"en","subject":"Multiagent Systems (cs.MA)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-14T05:15:28Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-01T00:00:17Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-06-15T01:55:49Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-06-16T01:14:38Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Large language models (LLMs) are increasingly deployed as the execution core of autonomous agents rather than as standalone text generators. Agentic workloads induce a temporal shift from single-turn inference to multi-turn LLM-tool loops, and a spatial shift from chat-scale, GPU-only execution to repository-scale, GPU-CPU co-located execution. Consequently, coordinating heterogeneous resource demands of agentic execution has emerged as a critical system challenge.\n We design and implement MARS, an efficient and adaptive co-scheduling system that globally coordinates heterogeneous agentic workloads under coupled GPU-CPU resource pressure. By establishing holistic visibility across GPU inference and CPU tool execution via a unified information stream, an external control plane in MARS decouples admission from execution to prevent heterogeneous resource oversubscription. An internal agent-centric scheduler further minimizes the end-to-end critical path by prioritizing latency-sensitive continuations and adaptively retaining KV cache state only when warm resumption yields a latency benefit. Our evaluations show that MARS reduces end-to-end latency by up to 5.94x while maintaining nearly maximal system throughput. We further integrate MARS as the serving backend for the OpenHands coding agent framework, demonstrating its real-world effectiveness by accelerating end-to-end task completion time by up to 1.87x.\n Our source code is publicly available at https://github.com/Afterglow231/MARS_preview .","descriptionType":"Abstract"},{"description":"14 pages, 13 figures. Preprint","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.26963","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-01T01:47:14.000Z","registered":"2026-05-01T01:47:15.000Z","published":"2026","updated":"2026-06-16T04:16:07.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.26963","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}