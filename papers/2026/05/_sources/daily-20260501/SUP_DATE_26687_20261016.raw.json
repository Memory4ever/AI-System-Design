{"data":{"id":"10.48550/arxiv.2604.26687","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.26687","prefix":"10.48550","suffix":"arxiv.2604.26687","identifiers":[{"identifier":"2604.26687","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.26687"}],"creators":[{"name":"Sakip, Akhmed","nameType":"Personal","givenName":"Akhmed","familyName":"Sakip","affiliation":[],"nameIdentifiers":[]},{"name":"Fuadi, Erland Hilman","nameType":"Personal","givenName":"Erland Hilman","familyName":"Fuadi","affiliation":[],"nameIdentifiers":[]},{"name":"Sayedelahl, Omar","nameType":"Personal","givenName":"Omar","familyName":"Sayedelahl","affiliation":[],"nameIdentifiers":[]},{"name":"Li, Zonghang","nameType":"Personal","givenName":"Zonghang","familyName":"Li","affiliation":[],"nameIdentifiers":[]},{"name":"She, Jianshu","nameType":"Personal","givenName":"Jianshu","familyName":"She","affiliation":[],"nameIdentifiers":[]},{"name":"Aji, Alham Fikri","nameType":"Personal","givenName":"Alham Fikri","familyName":"Aji","affiliation":[],"nameIdentifiers":[]},{"name":"Liu, Steve","nameType":"Personal","givenName":"Steve","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Xing, Eric","nameType":"Personal","givenName":"Eric","familyName":"Xing","affiliation":[],"nameIdentifiers":[]},{"name":"Ho, Qirong","nameType":"Personal","givenName":"Qirong","familyName":"Ho","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"COPUS: Co-adaptive Parallelism and Batch Size Selection in Large Language Model Training"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Distributed, Parallel, and Cluster Computing (cs.DC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-04-29T13:52:38Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-04-30T00:50:22Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"arXiv.org perpetual, non-exclusive license","rightsUri":"http://arxiv.org/licenses/nonexclusive-distrib/1.0/"}],"descriptions":[{"description":"Training large language models requires jointly configuring two interdependent aspects of the system: the global batch size, which governs statistical efficiency, and the 3D parallelism strategy, which governs hardware throughput. Existing approaches make these decisions independently: optimization work adapts the batch size to track the evolving critical batch size while keeping parallelism fixed, and systems work selects the fastest parallelism for a given fixed batch size without anticipating that the optimal batch size could change. We show that these decisions are tightly coupled: the throughput-optimal parallelism strategy may shift as the global batch size changes, so any method that fixes one while adapting the other operates with a suboptimal configuration for part of the training run.\n We present COPUS, a system that adaptively tunes the global batch size, parallelism strategy, and micro-batch size as training evolves. COPUS is guided by Goodput, the product of throughput and statistical efficiency, which models both hardware and statistical effects jointly and directly measures useful convergence per unit of wall-clock time. The system combines online gradient noise scale estimation under 3D parallelism with throughput-aware evaluation of candidate configurations, and supports efficient reconfiguration of both batch size and parallelism during training. We evaluate COPUS on LLM pre-training workloads across 1-4 nodes of 8xH100 and 8xMI210 GPUs and model sizes from 3B to 32B parameters, demonstrating average time-to-convergence speedups of 3.9-8.0% over the fastest baseline across four configurations, with peak gains up to 11.1%, including system overheads.","descriptionType":"Abstract"},{"description":"22 pages, 13 figures, 2 tables","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.26687","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-04-30T02:04:02.000Z","registered":"2026-04-30T02:04:03.000Z","published":"2026","updated":"2026-04-30T02:04:03.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.26687","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}