{"data":{"id":"10.48550/arxiv.2604.26953","type":"dois","attributes":{"doi":"10.48550/arxiv.2604.26953","prefix":"10.48550","suffix":"arxiv.2604.26953","identifiers":[{"identifier":"2604.26953","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2604.26953"}],"creators":[{"name":"Gao, Michael","nameType":"Personal","givenName":"Michael","familyName":"Gao","affiliation":[],"nameIdentifiers":[]},{"name":"Balu, Suresh","nameType":"Personal","givenName":"Suresh","familyName":"Balu","affiliation":[],"nameIdentifiers":[]},{"name":"Knechtle, William","nameType":"Personal","givenName":"William","familyName":"Knechtle","affiliation":[],"nameIdentifiers":[]},{"name":"Pejavara, Kartik","nameType":"Personal","givenName":"Kartik","familyName":"Pejavara","affiliation":[],"nameIdentifiers":[]},{"name":"Jeck, William","nameType":"Personal","givenName":"William","familyName":"Jeck","affiliation":[],"nameIdentifiers":[]},{"name":"Ellis, Matthew","nameType":"Personal","givenName":"Matthew","familyName":"Ellis","affiliation":[],"nameIdentifiers":[]},{"name":"Thieling, Jason","nameType":"Personal","givenName":"Jason","familyName":"Thieling","affiliation":[],"nameIdentifiers":[]},{"name":"Cameron, Blake","nameType":"Personal","givenName":"Blake","familyName":"Cameron","affiliation":[],"nameIdentifiers":[]},{"name":"Tatreau, Jason","nameType":"Personal","givenName":"Jason","familyName":"Tatreau","affiliation":[],"nameIdentifiers":[]},{"name":"Aljurf, Tareq","nameType":"Personal","givenName":"Tareq","familyName":"Aljurf","affiliation":[],"nameIdentifiers":[]},{"name":"Foote, Henry","nameType":"Personal","givenName":"Henry","familyName":"Foote","affiliation":[],"nameIdentifiers":[]},{"name":"Revoir, Michael","nameType":"Personal","givenName":"Michael","familyName":"Revoir","affiliation":[],"nameIdentifiers":[]},{"name":"Nichols, Marshall","nameType":"Personal","givenName":"Marshall","familyName":"Nichols","affiliation":[],"nameIdentifiers":[]},{"name":"Gardner, Matthew","nameType":"Personal","givenName":"Matthew","familyName":"Gardner","affiliation":[],"nameIdentifiers":[]},{"name":"Ratliff, William","nameType":"Personal","givenName":"William","familyName":"Ratliff","affiliation":[],"nameIdentifiers":[]},{"name":"Hintze, Bradley","nameType":"Personal","givenName":"Bradley","familyName":"Hintze","affiliation":[],"nameIdentifiers":[]},{"name":"Milazzo, Angelo","nameType":"Personal","givenName":"Angelo","familyName":"Milazzo","affiliation":[],"nameIdentifiers":[]},{"name":"Vemulapalli, Sreekanth","nameType":"Personal","givenName":"Sreekanth","familyName":"Vemulapalli","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"A Randomized Controlled Trial and Pilot of Scout: an LLM-Based EHR Search and Synthesis Platform"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Information Retrieval (cs.IR)","subjectScheme":"arXiv"},{"lang":"en","subject":"Computers and Society (cs.CY)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-03-07T22:28:53Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-01T00:00:05Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-04","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Clinical documentation and data retrieval within Electronic Health Records (EHRs) contribute substantially to clinician workload and burnout. To address this, we developed Scout, an LLM-based EHR search and synthesis platform that enables clinicians to query EHR data using natural language. Each response includes citations linking each claim to the original data source, facilitating easy verification of generated content. We conducted a prospective randomized, evaluator-blinded crossover trial across seven clinical specialties (20 participants, 200 structured cases). Participants completed realistic clinical tasks using either Scout or the EHR alone, with outcomes including time to completion, NASA Task Load Index workload scores, and blinded expert adjudication of accuracy, completeness, and relevance. Scout reduced task completion time by 37.6% and significantly decreased perceived workload, with the largest reductions in mental demand, effort, and temporal demand. Non-inferiority analyses showed that tasks completed with Scout maintained accuracy, completeness, and relevance relative to tasks completed with the EHR-only. A concurrent pilot deployment across over 200 users and more than 20 specialties generated over 6,600 interactions in three months, revealing diverse clinical and administrative use cases. Automated evaluation using an LLM-as-judge framework identified errors at low rates. Subsequent manual review of a subset of outputs revealed that most claims flagged by the automated judge as errors were in fact supported by the patient chart, demonstrating the importance of human validation. These findings provide early trial-based evidence that LLM-powered EHR tools can meaningfully reduce clinical and administrative workloads while maintaining output quality.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2604.26953","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-01T01:46:57.000Z","registered":"2026-05-01T01:46:57.000Z","published":"2026","updated":"2026-05-01T01:46:58.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2604.26953","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}