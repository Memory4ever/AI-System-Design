<td id="A1.T2.6.1.8.5.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A1.T2.m22" class="ltx_Math" alttext="I_{0},\{T_{j}\}_{j=1}^{i}" display="inline" intent=":literal"><semantics><mrow><msub><mi>I</mi><mn>0</mn></msub><mo>,</mo><msubsup><mrow><mo stretchy="false">{</mo><msub><mi>T</mi><mi>j</mi></msub><mo stretchy="false">}</mo></mrow><mrow><mi>j</mi><mo>=</mo><mn>1</mn></mrow><mi>i</mi></msubsup></mrow><annotation encoding="application/x-tex">I_{0},\{T_{j}\}_{j=1}^{i}</annotation></semantics></math>,</td></tr>
