<th id="A1.T2.6.1.1.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt">CFG_TEXT</th>
<th id="A1.T2.6.1.1.4" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt">ST_INPUT</th>
<th id="A1.T2.6.1.1.5" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_tt">CTX_INPUT</th>
<th id="A1.T2.6.1.1.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_tt">Guidance Computation</th></tr>
<tr id="A1.T2.6.1.2" class="ltx_tr">
<th id="A1.T2.6.1.2.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">INPUT: <math id="A1.T2.m1" class="ltx_Math" alttext="\langle I_{0},\hat{T}_{c}\rangle" display="inline" intent=":literal"><semantics><mrow><mo stretchy="false">⟨</mo><mrow><msub><mi>I</mi><mn>0</mn></msub><mo>,</mo><msub><mover accent="true"><mi>T</mi><mo>^</mo></mover><mi>c</mi></msub></mrow><mo stretchy="false">⟩</mo></mrow><annotation encoding="application/x-tex">\langle I_{0},\hat{T}_{c}\rangle</annotation></semantics></math></th>
<th id="A1.T2.6.1.2.2" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.2.3" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.2.4" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.2.5" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.2.6" class="ltx_td ltx_nopad_r ltx_th ltx_th_column ltx_border_t"></th></tr>
<tr id="A1.T2.6.1.3" class="ltx_tr">
<th id="A1.T2.6.1.3.1" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t">Single-Turn Editing</th>
<th id="A1.T2.6.1.3.2" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="A1.T2.m2" class="ltx_Math" alttext="\hat{T}_{c}" display="inline" intent=":literal"><semantics><msub><mover accent="true"><mi>T</mi><mo>^</mo></mover><mi>c</mi></msub><annotation encoding="application/x-tex">\hat{T}_{c}</annotation></semantics></math></th>
<th id="A1.T2.6.1.3.3" class="ltx_td ltx_align_left ltx_th ltx_th_column ltx_border_r ltx_border_t"><math id="A1.T2.m3" class="ltx_Math" alttext="I_{0}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mn>0</mn></msub><annotation encoding="application/x-tex">I_{0}</annotation></semantics></math></th>
<th id="A1.T2.6.1.3.4" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.3.5" class="ltx_td ltx_th ltx_th_column ltx_border_r ltx_border_t"></th>
<th id="A1.T2.6.1.3.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_th ltx_th_column ltx_border_t">
<table id="A1.T2.6.1.3.6.1" class="ltx_tabular ltx_align_middle">
<tr id="A1.T2.6.1.3.6.1.1" class="ltx_tr">
