<td id="A3.T10.6.1.2.2" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">43.2 <math id="A3.T10.m1" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.5</td>
<td id="A3.T10.6.1.2.3" class="ltx_td ltx_align_center ltx_border_bb ltx_border_t">112.1 <math id="A3.T10.m2" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.6</td>
<td id="A3.T10.6.1.2.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_border_bb ltx_border_t">182.0 <math id="A3.T10.m3" class="ltx_Math" alttext="\pm" display="inline" intent=":literal"><semantics><mo>±</mo><annotation encoding="application/x-tex">\pm</annotation></semantics></math> 1.4</td></tr>
</tbody>
