<td id="A1.T2.6.1.8.5.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A1.T2.m23" class="ltx_Math" alttext="I_{i-1}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>i</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">I_{i-1}</annotation></semantics></math> or other context composition</td></tr>
</table></td>
<td id="A1.T2.6.1.8.6" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_bb ltx_border_t">
