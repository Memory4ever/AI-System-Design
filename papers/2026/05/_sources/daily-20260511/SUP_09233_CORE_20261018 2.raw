<th id="A3.T10.6.1.1.2" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">1</th>
<th id="A3.T10.6.1.1.3" class="ltx_td ltx_align_center ltx_th ltx_th_column ltx_border_tt">3</th>
<th id="A3.T10.6.1.1.4" class="ltx_td ltx_nopad_r ltx_align_center ltx_th ltx_th_column ltx_border_tt">5</th></tr>
