<td id="A3.T5.6.1.2.3" class="ltx_td ltx_nopad_r ltx_align_left ltx_border_t"><span id="A3.T5.6.1.2.3.1" class="ltx_text ltx_font_bold">4.35</span></td></tr>
<tr id="A3.T5.6.1.3" class="ltx_tr">
