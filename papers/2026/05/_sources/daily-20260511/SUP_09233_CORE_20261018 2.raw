<table id="A3.T5.6.1.1.3.1" class="ltx_tabular ltx_align_middle">
<tr id="A3.T5.6.1.1.3.1.1" class="ltx_tr">
<td id="A3.T5.6.1.1.3.1.1.1" class="ltx_td ltx_nopad_r ltx_align_left">Last Editing Result</td></tr>
<tr id="A3.T5.6.1.1.3.1.2" class="ltx_tr">
<td id="A3.T5.6.1.1.3.1.2.1" class="ltx_td ltx_nopad_r ltx_align_left"><math id="A3.T5.m5" class="ltx_Math" alttext="I_{j-1}" display="inline" intent=":literal"><semantics><msub><mi>I</mi><mrow><mi>j</mi><mo>−</mo><mn>1</mn></mrow></msub><annotation encoding="application/x-tex">I_{j-1}</annotation></semantics></math></td></tr>
