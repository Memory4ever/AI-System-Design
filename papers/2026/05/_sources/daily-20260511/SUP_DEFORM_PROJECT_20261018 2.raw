<!-- ============================== TEASER ============================== -->
<section class="hero teaser">
    <div class="container is-max-desktop">
        <div class="hero-body" style="padding-top: 0;">
            <figure class="method-figure">
                <img src="static/images/teaser_web.jpg" alt="DeformMaster teaser"
                     style="max-width: 100%; height: auto; ">
            </figure>
            <h2 class="subtitle teaser-description">
                <strong>DeformMaster</strong> turns a phone-captured monocular video of deformable objects
                into an online interactive world model. By recovering both underlying physics and
                high-fidelity appearance, it supports long-horizon rollouts under novel actions,
                material-parameter variation, and novel-view synthesis.
            </h2>
            <h2 class="title is-3 has-text-centered" id="interaction" style="margin-top: 2rem;">Online Interaction</h2>
