{"data":{"id":"10.48550/arxiv.2605.16026","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.16026","prefix":"10.48550","suffix":"arxiv.2605.16026","identifiers":[{"identifier":"2605.16026","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.16026"}],"creators":[{"name":"Pan, Yu","nameType":"Personal","givenName":"Yu","familyName":"Pan","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Tianjiao","nameType":"Personal","givenName":"Tianjiao","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Hou, Yang","nameType":"Personal","givenName":"Yang","familyName":"Hou","affiliation":[],"nameIdentifiers":[]},{"name":"Wu, Xiongfei","nameType":"Personal","givenName":"Xiongfei","familyName":"Wu","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Liang","nameType":"Personal","givenName":"Liang","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Traon, Yves Le","nameType":"Personal","givenName":"Yves Le","familyName":"Traon","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Lei","nameType":"Personal","givenName":"Lei","familyName":"Ma","affiliation":[],"nameIdentifiers":[]},{"name":"Zhao, Jianjun","nameType":"Personal","givenName":"Jianjun","familyName":"Zhao","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Conditioned in Training, Dispensable at Inference: Typological Conditioning for Multilingual Speech Translation"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Computation and Language (cs.CL)","subjectScheme":"arXiv"},{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-15T15:01:45Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-18T00:56:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-11T15:59:33Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-14T01:33:39Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-nd/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-nd-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Multilingual speech translation frontends built on speech large language models typically condition on language identity, as a learned embedding or a prompted language name. Such a signal, however, is learned separately for each language and transfers nothing between typologically related languages. In this paper, we present TypoCast, a frontend that conditions on the typological profile of the source language rather than on its label alone. A typology-informed hierarchical language encoding represents each language by its morphological type, constituent order and family, so that supervision is shared among related languages. A dual-route mixture-of-experts adapter routes inputs through a shared typological route together with a per-language residual, and a typology-aware prompt conveys the same profile to the decoder. Extensive experiments on CVSS-C demonstrate that TypoCast surpasses state-of-the-art speech-to-speech translation systems on French, German and Spanish to English, averaged over the three directions, and outperforms the identity-conditioned S2ST-Omni on every language of a seven-language inventory, with only 228M trainable parameters. Ablation studies further reveal that the conditioning signal acts during training and is dispensable at inference: a model trained without it is consistently worse, whereas removing it from a trained model changes BLEU by less than 0.2, and expert usage is consistent with the signal shaping how adapter capacity is divided among languages.","descriptionType":"Abstract"},{"description":"16 pages, working in progress","descriptionType":"Other"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.16026","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-18T02:03:13.000Z","registered":"2026-05-18T02:03:14.000Z","published":"2026","updated":"2026-10-14T08:33:50.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.16026","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}
