{"data":{"id":"10.48550/arxiv.2605.24830","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.24830","prefix":"10.48550","suffix":"arxiv.2605.24830","identifiers":[{"identifier":"2605.24830","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.24830"}],"creators":[{"name":"Kong, Fancy","nameType":"Personal","givenName":"Fancy","familyName":"Kong","affiliation":[],"nameIdentifiers":[]},{"name":"Zheng, Congjie","nameType":"Personal","givenName":"Congjie","familyName":"Zheng","affiliation":[],"nameIdentifiers":[]},{"name":"Zhuang, Murphy","nameType":"Personal","givenName":"Murphy","familyName":"Zhuang","affiliation":[],"nameIdentifiers":[]},{"name":"Yang, Rio","nameType":"Personal","givenName":"Rio","familyName":"Yang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhang, Sueky","nameType":"Personal","givenName":"Sueky","familyName":"Zhang","affiliation":[],"nameIdentifiers":[]},{"name":"Fu, Hao","nameType":"Personal","givenName":"Hao","familyName":"Fu","affiliation":[],"nameIdentifiers":[]},{"name":"Jin, Gene","nameType":"Personal","givenName":"Gene","familyName":"Jin","affiliation":[],"nameIdentifiers":[]},{"name":"Cao, Song","nameType":"Personal","givenName":"Song","familyName":"Cao","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Kaijie","nameType":"Personal","givenName":"Kaijie","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Chen, Andrew","nameType":"Personal","givenName":"Andrew","familyName":"Chen","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Pony","nameType":"Personal","givenName":"Pony","familyName":"Ma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Macaron-A2UI: A Model for Generative UI in Personal Agents"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Human-Computer Interaction (cs.HC)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"FOS: Computer and information sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-24T02:51:07Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-26T00:51:14Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"},{"date":"2026","dateType":"Issued"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"1","rightsList":[{"rights":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","rightsUri":"https://creativecommons.org/licenses/by-nc-sa/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-nc-sa-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"As personal agents evolve to handle complex, user-centric tasks, static plain-text chat is rapidly becoming a bottleneck. Generative UI emerges as the necessary new interface layer, dynamically synthesizing the right controls, options, and state from the interaction context in real time. We present Macaron-A2UI, a model for Generative UI in personal agents. Our goal is to move beyond text-only interaction by enabling agents to generate natural language together with lightweight, executable UI actions for information collection, preference refinement, confirmation, and multi-goal organization. We build a large-scale Generative UI corpus from heterogeneous dialogue sources, introduce A2UI-Bench for controlled evaluation, and train 30B, 235B and 754B models with parameter-efficient LoRA-based supervised fine-tuning followed by reward-driven reinforcement learning. The best Macaron-A2UI model reaches 75.6 overall on A2UI-Bench without explicit schema hints, surpassing the strongest full-schema frontier baseline. We release the models, benchmark, and evaluation protocol to support future work on Generative UI for personal agents.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.24830","contentUrl":null,"metadataVersion":0,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-26T03:24:22.000Z","registered":"2026-05-26T03:24:22.000Z","published":"2026","updated":"2026-05-26T03:24:22.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.24830","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}