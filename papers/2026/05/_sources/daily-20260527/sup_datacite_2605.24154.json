{"data":{"id":"10.48550/arxiv.2605.24154","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.24154","prefix":"10.48550","suffix":"arxiv.2605.24154","identifiers":[{"identifier":"2605.24154","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.24154"}],"creators":[{"name":"Tan, Qitao","nameType":"Personal","givenName":"Qitao","familyName":"Tan","affiliation":[],"nameIdentifiers":[]},{"name":"Song, Xiaoying","nameType":"Personal","givenName":"Xiaoying","familyName":"Song","affiliation":[],"nameIdentifiers":[]},{"name":"Akbari, Arman","nameType":"Personal","givenName":"Arman","familyName":"Akbari","affiliation":[],"nameIdentifiers":[]},{"name":"Akbari, Arash","nameType":"Personal","givenName":"Arash","familyName":"Akbari","affiliation":[],"nameIdentifiers":[]},{"name":"Wang, Yanzhi","nameType":"Personal","givenName":"Yanzhi","familyName":"Wang","affiliation":[],"nameIdentifiers":[]},{"name":"Zhai, Xiaoming","nameType":"Personal","givenName":"Xiaoming","familyName":"Zhai","affiliation":[],"nameIdentifiers":[]},{"name":"Hong, Lingzi","nameType":"Personal","givenName":"Lingzi","familyName":"Hong","affiliation":[],"nameIdentifiers":[]},{"name":"Xiang, Zhen","nameType":"Personal","givenName":"Zhen","familyName":"Xiang","affiliation":[],"nameIdentifiers":[]},{"name":"Lu, Jin","nameType":"Personal","givenName":"Jin","familyName":"Lu","affiliation":[],"nameIdentifiers":[]},{"name":"Yuan, Geng","nameType":"Personal","givenName":"Geng","familyName":"Yuan","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"Palette: A Modular, Controllable, and Efficient Framework for On-demand Authorized Safety Alignment Relaxation in LLMs"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"lang":"en","subject":"Software Engineering (cs.SE)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-22T19:22:17Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-26T00:07:38Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-10-05T17:57:43Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-10-07T00:05:45Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"2","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Current safety alignment of foundation models largely follows a \\emph{one-size-fits-all} paradigm, applying the same refusal policy across users and contexts. As a result, models may refuse requests that are unsafe for general users but legitimate for authorized professionals, limiting helpfulness in specialized professional settings. Existing approaches either require costly realignment or rely on inference-time steering that suffers from imprecise control and added latency. To this end, we propose \\textsc{Palette}, a modular, controllable, and efficient framework that selectively relaxes refusal behavior on authorized target domains while preserving standard safety elsewhere. Our method identifies a refusal direction via multi-objective search and internalizes it into the model through lightweight adaptation. \\textsc{Palette} further supports modular composition: it learns domain-specific safety controls independently and composes them through parameter merging, enabling on-demand multi-domain authorization without retraining. Experiments across four safety benchmarks, multiple model variants, and both LLMs and VLMs show that \\textsc{Palette} delivers precise safety control without sacrificing general utility, offering a practical path toward foundation models that adapt to diverse professional needs.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.24154","contentUrl":null,"metadataVersion":1,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-26T03:08:09.000Z","registered":"2026-05-26T03:08:10.000Z","published":"2026","updated":"2026-10-07T03:21:11.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.24154","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}