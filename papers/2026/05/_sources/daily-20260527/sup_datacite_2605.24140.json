{"data":{"id":"10.48550/arxiv.2605.24140","type":"dois","attributes":{"doi":"10.48550/arxiv.2605.24140","prefix":"10.48550","suffix":"arxiv.2605.24140","identifiers":[{"identifier":"2605.24140","identifierType":"arXiv"}],"alternateIdentifiers":[{"alternateIdentifierType":"arXiv","alternateIdentifier":"2605.24140"}],"creators":[{"name":"Liu, Yuyu","nameType":"Personal","givenName":"Yuyu","familyName":"Liu","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Haotian","nameType":"Personal","givenName":"Haotian","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"He, Yanan","nameType":"Personal","givenName":"Yanan","familyName":"He","affiliation":[],"nameIdentifiers":[]},{"name":"Patil, Sarang Rajendra","nameType":"Personal","givenName":"Sarang Rajendra","familyName":"Patil","affiliation":[],"nameIdentifiers":[]},{"name":"Xu, Mengjia","nameType":"Personal","givenName":"Mengjia","familyName":"Xu","affiliation":[],"nameIdentifiers":[]},{"name":"Ma, Tengfei","nameType":"Personal","givenName":"Tengfei","familyName":"Ma","affiliation":[],"nameIdentifiers":[]}],"titles":[{"title":"HyperGuide: Hyperbolic Guidance for Efficient Multi-Step Reasoning in Large Language Models"}],"publisher":"arXiv","container":{},"publicationYear":2026,"subjects":[{"lang":"en","subject":"Artificial Intelligence (cs.AI)","subjectScheme":"arXiv"},{"subject":"FOS: Computer and information sciences","subjectScheme":"Fields of Science and Technology (FOS)"}],"contributors":[],"dates":[{"date":"2026-05-22T19:01:25Z","dateType":"Submitted","dateInformation":"v1"},{"date":"2026-05-26T00:06:56Z","dateType":"Updated","dateInformation":"v1"},{"date":"2026-05-27T23:12:50Z","dateType":"Submitted","dateInformation":"v2"},{"date":"2026-05-29T00:17:10Z","dateType":"Updated","dateInformation":"v2"},{"date":"2026-08-02T16:07:48Z","dateType":"Submitted","dateInformation":"v3"},{"date":"2026-08-04T01:12:30Z","dateType":"Updated","dateInformation":"v3"},{"date":"2026-10-01T04:34:36Z","dateType":"Submitted","dateInformation":"v4"},{"date":"2026-10-02T00:42:55Z","dateType":"Updated","dateInformation":"v4"},{"date":"2026-10-02T01:48:49Z","dateType":"Submitted","dateInformation":"v5"},{"date":"2026-10-05T00:23:33Z","dateType":"Updated","dateInformation":"v5"},{"date":"2026-05","dateType":"Available","dateInformation":"v1"}],"language":null,"types":{"ris":"GEN","bibtex":"misc","citeproc":"article","schemaOrg":"CreativeWork","resourceType":"Article","resourceTypeGeneral":"Preprint"},"relatedIdentifiers":[],"relatedItems":[],"sizes":[],"formats":[],"version":"5","rightsList":[{"rights":"Creative Commons Attribution 4.0 International","rightsUri":"https://creativecommons.org/licenses/by/4.0/legalcode","schemeUri":"https://spdx.org/licenses/","rightsIdentifier":"cc-by-4.0","rightsIdentifierScheme":"SPDX"}],"descriptions":[{"description":"Searching over alternative continuations lets large language models (LLMs) compare the downstream consequences of a reasoning step before committing to it, but expanding and evaluating many branches makes inference expensive. Training value models to score intermediate steps does not avoid this cost, as they still rank candidates at inference time. We introduce HyperGuide, a framework that treats reasoning as movement through a tree of states embedded in hyperbolic space. HyperGuide first trains a state encoder on the Poincar'e ball, then trains a guidance head to predict the direction of a minimum-cost transition from the current state. The predicted direction is inserted into the decoder as a virtual token after each reasoning step, so inference follows a single autoregressive trajectory without expanding or reranking candidates. Because the supervision is ordinal rather than binary, it favors continuations that are both reliable and short, which steers generation toward successful, concise solutions. Experiments on competition mathematics and code generation show that HyperGuide matches or exceeds the accuracy of search- and verifier-based baselines while generating substantially fewer tokens than these baselines and about as many as few-shot prompting.","descriptionType":"Abstract"}],"geoLocations":[],"fundingReferences":[],"xml":"","url":"https://arxiv.org/abs/2605.24140","contentUrl":null,"metadataVersion":4,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":0,"viewsOverTime":[],"downloadCount":0,"downloadsOverTime":[],"referenceCount":0,"citationCount":0,"citationsOverTime":[],"partCount":0,"partOfCount":0,"versionCount":0,"versionOfCount":0,"created":"2026-05-26T03:07:50.000Z","registered":"2026-05-26T03:07:50.000Z","published":"2026","updated":"2026-10-05T02:47:06.000Z"},"relationships":{"client":{"data":{"id":"arxiv.content","type":"clients"}},"provider":{"data":{"id":"arxiv","type":"providers"}},"media":{"data":{"id":"10.48550/arxiv.2605.24140","type":"media"}},"references":{"data":[]},"citations":{"data":[]},"parts":{"data":[]},"partOf":{"data":[]},"versions":{"data":[]},"versionOf":{"data":[]}}}}