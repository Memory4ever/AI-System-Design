{
  "schema_version": 1,
  "stages": {
    "sft": {
      "kind": "offline",
      "module": "openrlhf.cli.train_sft",
      "input_artifacts": ["base_model", "sft_train"],
      "output_artifact": "sft",
      "args": {
        "--model.model_name_or_path": "${BASE_MODEL}",
        "--data.dataset": "${DATA_DIR}/sft_train.jsonl",
        "--data.input_key": "prompt",
        "--data.output_key": "response",
        "--data.input_template": "User: {}\nAssistant: ",
        "--data.max_len": "${MAX_LEN}",
        "--train.batch_size": "${OFFLINE_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.max_epochs": "1",
        "--adam.lr": "5e-6",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--ds.attn_implementation": "flash_attention_2",
        "--model.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/sft",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    },
    "reward": {
      "kind": "offline",
      "module": "openrlhf.cli.train_rm",
      "input_artifacts": ["sft", "preference_train"],
      "output_artifact": "reward",
      "args": {
        "--model.model_name_or_path": "${ARTIFACT_ROOT}/sft",
        "--data.dataset": "${DATA_DIR}/preference_train.jsonl",
        "--data.chosen_key": "chosen",
        "--data.rejected_key": "rejected",
        "--data.max_len": "${MAX_LEN}",
        "--train.batch_size": "${OFFLINE_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.max_epochs": "1",
        "--adam.lr": "9e-6",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--ds.attn_implementation": "flash_attention_2",
        "--ds.value_head_prefix": "score",
        "--model.compute_fp32_loss_enable": true,
        "--model.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/reward",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    },
    "dpo": {
      "kind": "offline",
      "module": "openrlhf.cli.train_dpo",
      "input_artifacts": ["sft", "preference_train"],
      "output_artifact": "dpo",
      "args": {
        "--model.model_name_or_path": "${ARTIFACT_ROOT}/sft",
        "--data.dataset": "${DATA_DIR}/preference_train.jsonl",
        "--data.chosen_key": "chosen",
        "--data.rejected_key": "rejected",
        "--data.max_len": "${MAX_LEN}",
        "--train.batch_size": "${OFFLINE_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.max_epochs": "1",
        "--adam.lr": "5e-7",
        "--model.beta": "0.1",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--ds.attn_implementation": "flash_attention_2",
        "--model.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/dpo",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    },
    "ppo": {
      "kind": "online",
      "module": "openrlhf.cli.train_ppo_ray",
      "input_artifacts": ["sft", "reward", "prompts_train"],
      "output_artifact": "ppo",
      "args": {
        "--actor.model_name_or_path": "${ARTIFACT_ROOT}/sft",
        "--critic.model_name_or_path": "${ARTIFACT_ROOT}/reward",
        "--reward.model_name_or_path": "${ARTIFACT_ROOT}/reward",
        "--data.prompt_dataset": "${DATA_DIR}/prompts_train.jsonl",
        "--data.input_key": "prompt",
        "--data.label_key": "answer",
        "--data.input_template": "User: {}\nAssistant: ",
        "--data.max_len": "${MAX_LEN}",
        "--rollout.max_new_tokens": "${ROLLOUT_MAX_NEW_TOKENS}",
        "--rollout.batch_size": "${ROLLOUT_BATCH_SIZE}",
        "--rollout.micro_batch_size": "${ROLLOUT_MICRO_BATCH_SIZE}",
        "--rollout.n_samples_per_prompt": "1",
        "--train.batch_size": "${PPO_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.num_episodes": "1",
        "--actor.num_nodes": "1",
        "--actor.num_gpus_per_node": "${GPU_COUNT}",
        "--critic.num_nodes": "1",
        "--critic.num_gpus_per_node": "${GPU_COUNT}",
        "--ref.num_nodes": "1",
        "--ref.num_gpus_per_node": "${GPU_COUNT}",
        "--reward.num_nodes": "1",
        "--reward.num_gpus_per_node": "${GPU_COUNT}",
        "--vllm.num_engines": "${GPU_COUNT}",
        "--vllm.tensor_parallel_size": "1",
        "--vllm.gpu_memory_utilization": "${VLLM_GPU_MEMORY_UTILIZATION}",
        "--train.colocate_all": true,
        "--vllm.enable_sleep": true,
        "--ds.enable_sleep": true,
        "--algo.advantage.estimator": "gae",
        "--algo.kl.init_coef": "0.01",
        "--algo.kl.estimator": "k1",
        "--actor.adam.lr": "5e-7",
        "--critic.adam.lr": "9e-6",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--actor.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/ppo",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    },
    "rloo": {
      "kind": "online",
      "module": "openrlhf.cli.train_ppo_ray",
      "input_artifacts": ["sft", "prompts_train", "verifier"],
      "output_artifact": "rloo",
      "args": {
        "--actor.model_name_or_path": "${ARTIFACT_ROOT}/sft",
        "--reward.remote_url": "${SUITE_DIR}/scripts/reward_func.py",
        "--data.prompt_dataset": "${DATA_DIR}/prompts_train.jsonl",
        "--data.input_key": "prompt",
        "--data.label_key": "answer",
        "--data.input_template": "User: {}\nAssistant: ",
        "--data.max_len": "${MAX_LEN}",
        "--rollout.max_new_tokens": "${ROLLOUT_MAX_NEW_TOKENS}",
        "--rollout.batch_size": "${ROLLOUT_BATCH_SIZE}",
        "--rollout.micro_batch_size": "${ROLLOUT_MICRO_BATCH_SIZE}",
        "--rollout.n_samples_per_prompt": "${SAMPLES_PER_PROMPT}",
        "--train.batch_size": "${GROUP_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.num_episodes": "1",
        "--actor.num_nodes": "1",
        "--actor.num_gpus_per_node": "${GPU_COUNT}",
        "--ref.num_nodes": "1",
        "--ref.num_gpus_per_node": "${GPU_COUNT}",
        "--vllm.num_engines": "${GPU_COUNT}",
        "--vllm.tensor_parallel_size": "1",
        "--vllm.gpu_memory_utilization": "${VLLM_GPU_MEMORY_UTILIZATION}",
        "--train.colocate_all": true,
        "--vllm.enable_sleep": true,
        "--ds.enable_sleep": true,
        "--algo.advantage.estimator": "rloo",
        "--algo.kl.init_coef": "0.01",
        "--algo.kl.estimator": "k1",
        "--actor.adam.lr": "5e-7",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--actor.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/rloo",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    },
    "grpo": {
      "kind": "online",
      "module": "openrlhf.cli.train_ppo_ray",
      "input_artifacts": ["sft", "prompts_train", "verifier"],
      "output_artifact": "grpo",
      "args": {
        "--actor.model_name_or_path": "${ARTIFACT_ROOT}/sft",
        "--reward.remote_url": "${SUITE_DIR}/scripts/reward_func.py",
        "--data.prompt_dataset": "${DATA_DIR}/prompts_train.jsonl",
        "--data.input_key": "prompt",
        "--data.label_key": "answer",
        "--data.input_template": "User: {}\nAssistant: ",
        "--data.max_len": "${MAX_LEN}",
        "--rollout.max_new_tokens": "${ROLLOUT_MAX_NEW_TOKENS}",
        "--rollout.batch_size": "${ROLLOUT_BATCH_SIZE}",
        "--rollout.micro_batch_size": "${ROLLOUT_MICRO_BATCH_SIZE}",
        "--rollout.n_samples_per_prompt": "${SAMPLES_PER_PROMPT}",
        "--train.batch_size": "${GROUP_TRAIN_BATCH_SIZE}",
        "--train.micro_batch_size": "${TRAIN_MICRO_BATCH_SIZE}",
        "--train.num_episodes": "1",
        "--actor.num_nodes": "1",
        "--actor.num_gpus_per_node": "${GPU_COUNT}",
        "--ref.num_nodes": "1",
        "--ref.num_gpus_per_node": "${GPU_COUNT}",
        "--vllm.num_engines": "${GPU_COUNT}",
        "--vllm.tensor_parallel_size": "1",
        "--vllm.gpu_memory_utilization": "${VLLM_GPU_MEMORY_UTILIZATION}",
        "--train.colocate_all": true,
        "--vllm.enable_sleep": true,
        "--ds.enable_sleep": true,
        "--algo.advantage.estimator": "group_norm",
        "--algo.kl.use_loss": true,
        "--algo.kl.estimator": "k3",
        "--algo.kl.init_coef": "0.001",
        "--actor.adam.lr": "5e-7",
        "--ds.zero_stage": "${ZERO_STAGE}",
        "--ds.param_dtype": "bf16",
        "--actor.gradient_checkpointing_enable": true,
        "--ckpt.output_dir": "${ARTIFACT_ROOT}/grpo",
        "--ckpt.save_steps": "-1",
        "--logger.logging_steps": "1",
        "--eval.steps": "-1"
      }
    }
  }
}
